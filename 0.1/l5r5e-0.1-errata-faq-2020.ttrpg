EXTENSION "L5R5e_Errata_FAQ_2020" EXTENDS "L5R5e_Core_Character" {
    NAME "Legend of the Five Rings 5th Edition - Errata and FAQ (August 2020)"
    VERSION "0.1"
    RELEASE_DATE "2020-08-12"

    # Official errata, FAQ, and GM guidance for L5R 5e Core Rulebook,
    # Shadowlands, and Path of Waves supplements.
    # Dated August 12, 2020. Published by Fantasy Flight Games.
    # SUPERSEDES "L5R5e_Errata_FAQ_2019"
    # All 2019 corrections are included and expanded upon in this file.

    # ===========================
    # CORE RULEBOOK ERRATA
    # ===========================

    ^"Core Rulebook Errata (2020)" DEF {
        APPLIES TO [^"Game Rules"]

        # All corrections from the 2019 errata are included, plus:

        # Chapter 1
        # p. 26, Universal Tiebreaker: Second bullet should read
        # "Adversary NPCs supersede minion NPCs"

        # Chapter 2
        # p. 65, Kakita Duelist (Rank 1): "Iaijutsu Cut: Crossing Cut"
        # should read "Iaijutsu Cut: Crossing Blade."
        # p. 65-85, Curriculum Tables: Redundant technique replacements
        # (same as 2019 errata, six entries)
        # p. 74, Asako Loremaster, School Ability: "...you may treat
        # your ranks in the skill as being equal to your school rank."
        # p. 82, Ide Trader, School Ability: Rarity reduced/increased
        # by school rank.
        # p. 85, Shinjo Outrider: Lady Shinjo's Speed = shuji (shuji).

        # Chapter 4
        # p. 173, Prerequisites: Waiver rules (same as 2019).
        # p. 179, Iaijutsu Cut: Rising Blade activation correction.
        # NEW in 2020: p. 221, Slippery Maneuvers: New Opportunities
        # header should read "(op)" instead of "(op)+" (opportunity does
        # not scale with effect). Already corrected in some printings.

        # Chapter 5
        # p. 230, Improvised Weapons margin note (same as 2019).
        # p. 231, Table 5-1: Weapons:
        #   NEW: Dao entry: DLS should be 6.
        #   NEW: Jian entry: 2-hand grip should grant Razor-Edged
        #         quality in addition to +1 DLS.
        #   Zanbato: DMG 6, DLS 7 (same as 2019).

        # Chapters 6-9 and Appendix: Same corrections as 2019.

        RULES {
            #L5REF01aB2cD4eF6gH8iJ0k: errata_2020_includes_all_2019_corrections
            #L5REF02lM3nO5pQ7rS9tU1v: errata_slippery_maneuvers_op_not_op_plus
            #L5REF03wX4yZ6aB8cD0eF2g: errata_dao_dls_6
            #L5REF04hI5jK7lM9nO1pQ3r: errata_jian_2hand_adds_razor_edged
        }
    }

    # ===========================
    # SHADOWLANDS ERRATA (2020 ADDITIONS)
    # ===========================

    ^"Shadowlands Errata (2020)" DEF {
        APPLIES TO [^"Game Rules"]

        # p. 93, Moto Avenger: Starting outfit includes Unicorn warhorse.
        # (same as 2019)

        # NEW in 2020:
        # p. 119, Commune with Evil, New Opportunities: First opportunity
        # final sentence: "it persists until the end of the next scene"
        # (not "end of the scene"). Third opportunity: "...1 additional
        # scene per (op) spent this way" (not "...1 additional round").

        # p. 119, Fiend's Retreat, New Opportunities: Second opportunity
        # header should read "(op)+" instead of "(op)" (scales with effect).

        # p. 120, Spiritual Shackles, Activation: All instances of
        # "Intrigue action" should read "Scheme action."

        RULES {
            #L5REF05sT6uV8wX0yZ2aB4c: errata_commune_with_evil_duration_next_scene
            #L5REF06dE7fG9hI1jK3lM5n: errata_commune_with_evil_third_op_per_scene
            #L5REF07oP8qR0sT2uV4wX6y: errata_fiends_retreat_op_plus_scales
            #L5REF08zA9bC1dE3fG5hI7j: errata_spiritual_shackles_scheme_action
        }
    }

    # ===========================
    # PATH OF WAVES ERRATA (NEW IN 2020)
    # ===========================

    ^"Path of Waves Errata (2020)" DEF {
        APPLIES TO [^"Game Rules"]

        # Chapter 2
        # p. 52, Voice of the Wilds, Starting Techniques: "Invocations"
        # category should read "Rituals" instead.

        # p. 56, Qamarist Shield Bearer:
        # - Techniques Available: Should read "Shuji" not "Earth Shuji"
        # - Curriculum Rank 2: "Iron Shield Style" -> "Iron Shell Style"
        # - Starting Outfit: Should include "scimitar"

        # p. 98, Summoning Mantra: Activation should read "...make a
        # TN 4 Theology check..." Second sentence: "The ring of the
        # check..." not "The ring and TN of the check..."

        # p. 113, Table 3-1: Weapons: The following should have "Unarmed"
        # skill instead of "Melee": chair, lute, sake bottle and cups,
        # scroll case.
        # Umbrella: Third grip should read "2-hand (stab)" not "1-hand (stab)."

        # p. 130, Reo, the Doshin (Profile): Vigilance should be 2 (not 9).

        # p. 243, Rhinoceros: Furious Charge final sentence: "If they fail,
        # they suffer a critical strike of severity 8 and the Unconscious
        # condition."

        # p. 243, Furiribi: Burns the Soul final sentence: "If the target
        # is already Exhausted, they suffer the Unconscious condition."

        RULES {
            #L5REF09kL0mN2oP4qR6sT8u: errata_voice_of_wilds_rituals_not_invocations
            #L5REF10vW1xY3zA5bC7dE9f: errata_qamarist_shield_bearer_corrections
            #L5REF11gH2iJ4kL6mN8oP0q: errata_summoning_mantra_tn4_ring_only
            #L5REF12rS3tU5vW7xY9zA1b: errata_improvised_weapons_use_unarmed_skill
            #L5REF13cD4eF6gH8iJ0kL2m: errata_umbrella_2hand_stab
            #L5REF14nO5pQ7rS9tU1vW3x: errata_reo_vigilance_2
            #L5REF15yZ6aB8cD0eF2gH4i: errata_rhinoceros_severity_8_unconscious
            #L5REF16jK7lM9nO1pQ3rS5t: errata_furiribi_exhausted_unconscious
        }
    }

    # ===========================
    # FAQ: CORE RULES (NEW IN 2020)
    # ===========================

    ^"FAQ: Core Rules (2020)" DEF {
        APPLIES TO [^"Game Rules"]

        # Q: When two effects (not dice modification) occur at the
        # same time, how is order of resolution decided?
        # A: Follow the order for simultaneous dice modification
        # (see p. 27 of the core rulebook).

        # Q: When a character's advantage is inverted during a check,
        # do they gain 2 Void points if they then fail (or receive
        # strife)? Do they gain 0 if the inverted advantage is
        # canceled by a different advantage?
        # A: Always gains back 1 Void point after the check, regardless
        # of success/failure or cancellation by another advantage.

        # Q: How should NPC Void points be handled?
        # A: Minion NPCs do not have (and cannot spend) Void points.
        # Adversary NPCs have Void points equal to half their Void
        # Ring, rounded up.

        RULES {
            #L5REF17uV8wX0yZ2aB4cD6e: faq_simultaneous_effects_resolution_order
            #L5REF18fG9hI1jK3lM5nO7p: faq_inverted_advantage_always_1_void_point
            #L5REF19qR0sT2uV4wX6yZ8a: faq_npc_void_points_minion_none_adversary_half
        }
    }

    # ===========================
    # FAQ: CHARACTER ADVANCEMENT (SAME AS 2019)
    # ===========================

    ^"FAQ: Character Advancement (2020)" DEF {
        APPLIES TO [^"Game Rules"]

        # Q: Can a character count multiple purchases from a single
        # entry toward their current school rank?
        # A: Yes, any number of purchases count.

        # Q: If a character has = symbol access that they could not
        # normally purchase, can they buy it after completing that rank?
        # A: No. Special access does not persist.

        RULES {
            #L5REF20bC1dE3fG5hI7jK9l: faq_multiple_purchases_count_toward_rank
            #L5REF21mN2oP4qR6sT8uV0w: faq_special_access_does_not_persist
        }
    }

    # ===========================
    # FAQ: SCHOOL ABILITIES
    # ===========================

    ^"FAQ: School Abilities (2020)" DEF {
        APPLIES TO [^"Game Rules"]

        # Asahina Artificer: Applies to invocations that summon
        # illusions, summon objects, augment objects, or awaken objects.

        # Matsu Berserker: Can trigger ability even while already
        # suffering Enraged (only one instance per Persistent Effects).

        RULES {
            #L5REF22xY3zA5bC7dE9fG1h: faq_asahina_artificer_ability_scope
            #L5REF23iJ4kL6mN8oP0qR2s: faq_matsu_berserker_enraged_trigger
        }
    }

    # ===========================
    # FAQ: TECHNIQUES (2020 EXPANDED)
    # ===========================

    ^"FAQ: Techniques (2020)" DEF {
        APPLIES TO [^"Game Rules"]

        # Same as 2019 (Iaijutsu Cut, NPC body weapons, Crimson Leaves,
        # Coiling Serpent) plus new:

        # NEW: Q: Iaijutsu Cut with Razor-Edged weapon with no
        # one-handed grip (naginata, nodachi) or a one-handed grip
        # without Razor-Edged (jian)?
        # A: Cannot be used with weapons that cannot be wielded in a
        # one-handed grip OR lack Razor-Edged for their one-handed grip.
        # (Expanded from 2019 answer to also cover jian case.)

        # NEW: Q: Multi-target action check (e.g. Thunderclap Strike) on
        # targets with TN-increasing effects -- what happens?
        # A: Take the highest TN from among the targets. Air stance
        # bonus not applied multiple times even if multiple targets
        # are in Air stance.

        # NEW: Q: When NPC performs Maho, how many rings count as
        # having Shadowlands Taint for scaling?
        # A: Not Tainted = 0 rings. Tainted (not Otherworldly) = 2 rings.
        # Otherworldly + Tainted = 4 rings. If (combat) threat 10+, may
        # count as 5 at GM's discretion.

        # NEW: Q: When must a character choose to use Fiend's Retreat,
        # Laughing Fox Style, and similar redirect effects?
        # A: After the attacker has chosen kept dice, but before symbols
        # on kept dice are resolved (after Step 5, before Step 6).

        RULES {
            #L5REF24tU5vW7xY9zA1bC3d: faq_iaijutsu_cut_razor_edged_one_hand_required
            #L5REF25eF6gH8iJ0kL2mN4o: faq_multi_target_highest_tn_no_stacking
            #L5REF26pQ7rS9tU1vW3xY5z: faq_maho_npc_tainted_ring_scaling
            #L5REF27aB8cD0eF2gH4iJ6k: faq_redirect_timing_after_kept_before_resolve
        }
    }

    # ===========================
    # FAQ: LORE
    # ===========================

    ^"FAQ: Lore (2020)" DEF {
        APPLIES TO [^"Game Rules"]

        # Kisshoten / Eight Great Fortunes discrepancy (same as 2019).

        RULES {
            #L5REF28lM9nO1pQ3rS5tU7v: faq_kisshoten_discrepancy
        }
    }

    # ===========================
    # FURTHER GM GUIDANCE: TN MODIFIERS
    # ===========================

    ^"GM Guidance: TN Modifiers" DEF {
        APPLIES TO [^"Game Rules"]

        # Guidelines on modifying the TN of a check based on
        # narrative circumstances.

        # TN Penalty Examples:
        # +1: Fresh snow on rooftop, scarce tools, lacking cultural
        #     context, radically different climate, biting insects,
        #     predisposition to distrust from past encounters.
        # +2: Entirely foreign tool, very rushed (half time or less),
        #     life-threateningly hot/cold, weak with hunger/thirst,
        #     significant encumbrance (two silhouette 2+ objects).
        # +3: Not sharing a language, storm winds on open sea,
        #     acting against a celestial being's will in their presence.

        # TN Bonus Examples:
        # -1: Uncommonly good tools, significantly more time (double+),
        #     gentle downhill slope, primary sources, acting per own
        #     giri/ninjo after unmasking, predisposition to trust (few
        #     encounters), appealing to target's giri or ninjo,
        #     favorable winds.
        # -2: Entire library on topic, an attendant for long march,
        #     predisposition to trust (many encounters), deep shadow
        #     for hiding, appealing to both giri and ninjo.
        # -3: Cart for moving heavy objects (silhouette 3+), acting
        #     with blessing of celestial being in their presence.

        RULES {
            #L5REF29wX0yZ2aB4cD6eF8g: gm_guidance_tn_modifier_penalties
            #L5REF30hI1jK3lM5nO7pQ9r: gm_guidance_tn_modifier_bonuses
        }
    }

    # ===========================
    # FURTHER GM GUIDANCE: STAKED SOCIAL ATTRIBUTES
    # ===========================

    ^"GM Guidance: Staked Social Attributes" DEF {
        APPLIES TO [^"Game Rules"]

        # Guidelines on staking honor, glory, and status to convince
        # others or accomplish social goals without checks.

        # Personal oaths to individuals -> stake honor
        # Public statements of intent -> stake glory
        # Guarantees/contracts based on position/finances -> stake status
        # Combined oaths -> stake all invoked attributes (added benefits)

        # If character fails to uphold oath: lose staked points.
        # If opportunity to lose stake passes: staked points returned.
        # Lifetime oaths: GM/player may agree to treat as fulfilled.

        # Honor Stakes:
        # - Honor's Demand: Convince samurai to uphold Bushido aspect.
        #   Stake: honor equal to character's focus.
        # - Trust My Blade: Entrust with task without check.
        #   Stake: honor equal to target's status rank.
        # - I Will Return It: Borrow item without check.
        #   Stake: honor equal to item's rarity.
        # - To Betray Others Betrays Oneself: Gain trust when you
        #   could benefit by betrayal. Stake: honor equal to focus.
        # - The Wise Listen: Accept expertise without check.
        #   Stake: honor equal to target's status.

        # Glory Stakes:
        # - This Oath I Claim: Any of the above done publicly.
        #   Stake: glory instead of (or in addition to) honor.
        #   Lost if it becomes publicly known you failed.

        # Status Stakes:
        # - Trust My Conviction: Back ambitions socially/financially.
        #   Stake: status 1 (single item) to 10 (army backing).

        # Combined:
        # - Hear My Plea: If GM requires checks, stake attribute to
        #   reduce TN. Attribute equal to target's focus for -1 TN,
        #   plus 3 additional per extra -1, maximum -3 total.

        RULES {
            #L5REF31sT2uV4wX6yZ8aB0c: gm_guidance_staked_honor_examples
            #L5REF32dE3fG5hI7jK9lM1n: gm_guidance_staked_glory_examples
            #L5REF33oP4qR6sT8uV0wX2y: gm_guidance_staked_status_examples
            #L5REF34zA5bC7dE9fG1hI3j: gm_guidance_staked_combined_hear_my_plea
        }
    }

    # ===========================
    # FURTHER GM GUIDANCE: USING OPTIONAL RULES
    # ===========================

    ^"GM Guidance: Optional Rules Catalog" DEF {
        APPLIES TO [^"Game Rules"]

        # Complete list of official optional rules in L5R 5e:
        # - Bonds (Courts of Stone p. 136, Path of Waves p. 187)
        # - Cross-Ring Opportunities (core rulebook p. 298)
        # - Grittier Games (core rulebook p. 288)
        # - Experienced PCs (core rulebook p. 305)
        # - One-Roll Duels (core rulebook p. 261)
        # - Range Bands on a Tactical Grid (core rulebook p. 266)
        # - Risky Checks (this document p. 9)
        # - Ronin Honor and Glory (Path of Waves p. 181)
        # - Shoddy Improvised Weapons (this document p. 10)
        # - Subskills (core rulebook p. 143)
        # - Trifling Breaches and Small Sacrifices
        #   (Shadowlands p. 143, Courts of Stone p. 135)
        # - Unmasking for Effect (Courts of Stone p. 135)

        RULES {
            #L5REF35kL6mN8oP0qR2sT4u: gm_guidance_optional_rules_catalog
        }
    }

    # ===========================
    # OPTIONAL RULE PLAYSETS
    # ===========================

    ^"Optional Rule Playset: Blood and Consequences" DEF {
        APPLIES TO [^"Game Rules"]

        # Focus: Emotionally driven drama with high personal stakes.
        # Violence extremely deadly but quick to resolve. Characters
        # die much more easily; transience of life is a core theme.
        # Optional Rules Used: Bonds, Grittier Games, Experienced PCs
        # (+20 starting XP), One-Roll Duels, Ronin Honor and Glory,
        # Trifling Breaches and Small Sacrifices, Unmasking for Effect.

        RULES {
            #L5REF36vW7xY9zA1bC3dE5f: playset_blood_and_consequences
        }
    }

    ^"Optional Rule Playset: Courtly Fantasy" DEF {
        APPLIES TO [^"Game Rules"]

        # Focus: Day-to-day stories, community, relationships.
        # Social roleplaying in a single environment.
        # Useful guidance: Assembling a Court in Seven Steps (Courts of
        # Stone p. 139), Developing NPC Motivations (Courts of Stone p. 140).
        # Optional Rules Used: Bonds, Experienced PCs (+15 starting XP
        # and one starting Bond), Subskills (Artisan, Social, Trade),
        # Unmasking for Effect.

        RULES {
            #L5REF37gH8iJ0kL2mN4oP6q: playset_courtly_fantasy
        }
    }

    ^"Optional Rule Playset: Heroic Action" DEF {
        APPLIES TO [^"Game Rules"]

        # Focus: Daring feats, grand gestures, heroes saving the day.
        # Empowers creative actions and rewards them.
        # Optional Rules Used: Bonds, Cross-Ring Opportunities,
        # Experienced PCs (+20 starting XP), Range Bands on a Tactical
        # Grid, Risky Checks, Shoddy Improvised Weapons, Unmasking
        # for Effect.

        RULES {
            #L5REF38rS9tU1vW3xY5zA7b: playset_heroic_action
        }
    }

    ^"Optional Rule Playset: Intrigue and Mediation" DEF {
        APPLIES TO [^"Game Rules"]

        # Focus: Ambassadors, mediators, peacekeepers. Complex problems
        # requiring compromise, empathy, creative thinking.
        # Optional Rules Used: Bonds, Cross-Ring Opportunities,
        # Experienced PCs (+30 starting XP and Emerald/Clan Magistrate
        # title or similar), Grittier Games, Risky Checks, Ronin Honor
        # and Glory, Shoddy Improvised Weapons, Trifling Breaches and
        # Small Sacrifices, Unmasking for Effect.

        RULES {
            #L5REF39cD0eF2gH4iJ6kL8m: playset_intrigue_and_mediation
        }
    }

    ^"Optional Rule Playset: Politics of Power" DEF {
        APPLIES TO [^"Game Rules"]

        # Focus: Rulers of their domain, exploring what to do with power.
        # Substantial personal power from the outset.
        # Optional Rules Used: Bonds, Cross-Ring Opportunities,
        # Experienced PCs (+50 starting XP and Daimyo or similar title),
        # One-Roll Duels, Risky Checks, Subskills (Scholar and Social),
        # Unmasking for Effect.

        RULES {
            #L5REF40nO1pQ3rS5tU7vW9x: playset_politics_of_power
        }
    }

    ^"Optional Rule Playset: Tactical Engagement" DEF {
        APPLIES TO [^"Game Rules"]

        # Focus: Combat-focused, team-based tactical exercise.
        # Wars between clans, Shadowlands ventures, ruin exploration.
        # Optional Rules Used: Experienced PCs (+30 starting XP),
        # Range Bands on a Tactical Grid, Shoddy Improvised Weapons.

        RULES {
            #L5REF41yZ2aB4cD6eF8gH0i: playset_tactical_engagement
        }
    }

    # ===========================
    # EXTRA OPTIONAL RULES
    # ===========================

    ^"Optional Rule: Risky Checks" DEF {
        APPLIES TO [^"Game Rules"]

        # Circumstances don't make a task easier or harder, but allow
        # more reward for success or worse consequences for failure.
        # Risk Level = additional bonus successes (on success) or
        # additional shortfall (on failure). Default risk level is 0.
        #
        # GM announces risk level with the TN before dice roll.
        # Player may reconsider and propose another path.
        # On success: add bonus successes equal to risk level.
        # On failure: add that amount to shortfall.
        #
        # Risk Level Examples:
        # +1: Charging downhill, flirting with higher status, outfoxing
        #     someone you know personally.
        # +2: Leaping from rafters onto enemy, speaking openly about
        #     emotions before higher status, experimental art technique.
        # +3: Jumping from second story into hay below, obliquely
        #     referencing higher-status person's failure, eschewing
        #     conventional wisdom on etiquette/artistry.

        PROPERTIES {
            ^"Rule Type" STRING "Optional Rule" FIXED
            ^"Recommended For" STRING "Dramatic campaigns with heroic action or large fortune swings"
        }

        RULES {
            #L5REF42jK3lM5nO7pQ9rS1t: optional_risky_checks_mechanic
            #L5REF43uV4wX6yZ8aB0cD2e: optional_risky_checks_examples
        }
    }

    ^"Optional Rule: Shoddy Improvised Weapons" DEF {
        APPLIES TO [^"Game Rules"]

        # Improvised weapons break more easily.
        # Applies to weapons from core p. 230 and Path of Waves p. 113
        # profiles, but NOT those from Improvised Assault (Path of Waves
        # p. 87, already destroyed at end of scene).
        #
        # After an Attack action check with an improvised weapon, it
        # gains the Damaged quality (or Destroyed if already Damaged).
        # Character may spend (op)+ from the Attack check to prevent
        # Damaged. The (op) spent must be >= the number of Attack
        # action checks performed with that weapon this scene.

        PROPERTIES {
            ^"Rule Type" STRING "Optional Rule" FIXED
            ^"Recommended For" STRING "Campaigns valuing proper weapons and unarmed attacks"
        }

        RULES {
            #L5REF44fG5hI7jK9lM1nO3p: optional_shoddy_improvised_weapons_mechanic
        }
    }

    ^"Alternate School Ability: Treasure Hunter" DEF {
        APPLIES TO [^"Samurai"]

        # For campaigns using Risky Checks, the Treasure Hunter school
        # (Path of Waves p. 50) may use this alternate school ability
        # replacing Risk and Reward:
        #
        # Fortune and Folly (School Ability): When you succeed at a
        # risky check or a check to which one of your disadvantages
        # applies, you may add a number of bonus successes up to your
        # school rank.

        PROPERTIES {
            ^"School" STRING "Treasure Hunter (Alternate)" FIXED
            ^"Replaces" STRING "Risk and Reward school ability"
            ^"Requires" STRING "Risky Checks optional rule"
            ^"School Ability" STRING "Fortune and Folly"
        }

        RULES {
            #L5REF45qR6sT8uV0wX2yZ4a: alternate_treasure_hunter_fortune_and_folly
        }
    }
}
