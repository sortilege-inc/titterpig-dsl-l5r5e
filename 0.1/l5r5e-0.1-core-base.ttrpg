BASE "L5R5e_Core_Core" {
    NAME "Legend of the Five Rings 5th Edition - Core mechanics, ACTORs, and fundamental game rules"
    VERSION "0.1"
    RELEASE_DATE "2025-06-01"

    # Core Rulebook: Legend of the Five Rings Roleplaying Game (FFG, 2018)
    # Roll-and-keep system using custom Ring dice (d6) and Skill dice (d12)

    #L5R001aB2cD4eF6gH8iJ0kL ACTOR "Entity" DEF {
        # The root of all actor types in L5R 5e
        # All ACTORs ultimately extend from Entity

        PROPERTIES {
            ^"Name" STRING REQUIRED
            ^"Description" STRING
        }

        RULES {
            #L5R002mN3oP5qR7sT9uV1w: WHEN [^"Entity" CREATED] THEN REQUIRE ^"Name"
        }
    }

    #L5R003xY4zA6bC8dE0fG2hI ACTOR "Samurai" DEF {
        EXTENDS #L5R001aB2cD4eF6gH8iJ0kL ^"Entity"

        # Player characters and significant NPCs in Rokugan
        # Samurai are the primary character type: warriors, courtiers,
        # priests, and monks serving their lords and the Empire

        PROPERTIES {
            ^"Clan" STRING REQUIRED
            ^"Family" STRING REQUIRED
            ^"School" STRING REQUIRED
            ^"School Rank" INTEGER MIN 1 MAX 6 DEFAULT 1
            ^"Rings" DEF {
                ^"Air" INTEGER MIN 1 MAX 5 DEFAULT 1
                ^"Earth" INTEGER MIN 1 MAX 5 DEFAULT 1
                ^"Fire" INTEGER MIN 1 MAX 5 DEFAULT 1
                ^"Water" INTEGER MIN 1 MAX 5 DEFAULT 1
                ^"Void" INTEGER MIN 1 MAX 5 DEFAULT 1
            }
            ^"Skills" LIST OF ^"Skill"
            ^"Techniques" LIST OF ^"Technique"
            ^"Advantages" LIST OF ^"Advantage"
            ^"Disadvantages" LIST OF ^"Disadvantage"
            ^"Honor" INTEGER MIN 0 MAX 100
            ^"Glory" INTEGER MIN 0 MAX 100
            ^"Status" INTEGER MIN 0 MAX 100
            ^"Endurance" INTEGER MIN 0
            ^"Composure" INTEGER MIN 0
            ^"Focus" INTEGER MIN 0
            ^"Vigilance" INTEGER MIN 0
            ^"Fatigue" INTEGER MIN 0 DEFAULT 0
            ^"Strife" INTEGER MIN 0 DEFAULT 0
            ^"Void Points" INTEGER MIN 0
            ^"Ninjo" STRING  # Personal desire
            ^"Giri" STRING   # Sworn duty
            ^"Demeanor" STRING
            ^"Equipment" LIST OF STRING
        }

        RULES {
            #L5R004jK5lM7nO9pQ1rS3t: WHEN [^"Samurai" CREATED] THEN REQUIRE ^"Clan", ^"School"
            #L5R005uV6wX8yZ0aB2cD4e: WHEN [^"Strife" > ^"Composure"] THEN ^"Samurai" IS compromised
            #L5R006fG7hI9jK1lM3nO5p: WHEN [^"Fatigue" >= ^"Endurance"] THEN ^"Samurai" IS incapacitated
        }
    }

    #L5R007qR8sT0uV2wX4yZ6a ACTOR "Peasant" DEF {
        EXTENDS #L5R001aB2cD4eF6gH8iJ0kL ^"Entity"

        # Non-samurai: farmers, merchants, craftspeople, entertainers
        # The vast majority of Rokugan's population

        PROPERTIES {
            ^"Rings" DEF {
                ^"Air" INTEGER MIN 1 MAX 5 DEFAULT 1
                ^"Earth" INTEGER MIN 1 MAX 5 DEFAULT 1
                ^"Fire" INTEGER MIN 1 MAX 5 DEFAULT 1
                ^"Water" INTEGER MIN 1 MAX 5 DEFAULT 1
                ^"Void" INTEGER MIN 1 MAX 5 DEFAULT 1
            }
            ^"Skills" LIST OF ^"Skill"
            ^"Endurance" INTEGER MIN 0
            ^"Composure" INTEGER MIN 0
        }

        RULES {
            #L5R008bC9dE1fG3hI5jK7l: WHEN [^"Peasant" INTERACTS with ^"Samurai"] THEN USE simplified mechanics
        }
    }

    #L5R009mN0oP2qR4sT6uV8w ACTOR "Adversary" DEF {
        EXTENDS #L5R001aB2cD4eF6gH8iJ0kL ^"Entity"

        # NPCs, creatures, and supernatural beings used by the GM
        # Adversary profiles include combat and intrigue conflict ranks

        PROPERTIES {
            ^"Combat Conflict Rank" INTEGER MIN 0 MAX 20
            ^"Intrigue Conflict Rank" INTEGER MIN 0 MAX 20
            ^"Rings" DEF {
                ^"Air" INTEGER MIN 1 MAX 5
                ^"Earth" INTEGER MIN 1 MAX 5
                ^"Fire" INTEGER MIN 1 MAX 5
                ^"Water" INTEGER MIN 1 MAX 5
                ^"Void" INTEGER MIN 1 MAX 5
            }
            ^"Skills" LIST OF ^"Skill"
            ^"Endurance" INTEGER MIN 0
            ^"Composure" INTEGER MIN 0
            ^"Focus" INTEGER MIN 0
            ^"Vigilance" INTEGER MIN 0
            ^"Advantages" LIST OF ^"Advantage"
            ^"Disadvantages" LIST OF ^"Disadvantage"
            ^"Techniques" LIST OF ^"Technique"
            ^"Demeanor" STRING
            ^"Favored Weapons" LIST OF STRING
        }

        RULES {
            #L5R010xY1zA3bC5dE7fG9h: WHEN [^"Adversary" ENTERS conflict] THEN USE ^"Combat Conflict Rank" OR ^"Intrigue Conflict Rank"
        }
    }

    ^"NPC" DEF {
        # Metatype anchor for non-player character definitions
    }

    ^"NPC Template" DEF {
        # Metatype anchor for NPC template overlay definitions
    }

    #L5R011iJ2kL4mN6oP8qR0s ACTOR "Minion" DEF {
        EXTENDS #L5R009mN0oP2qR4sT6uV8w ^"Adversary"

        # Weak adversaries that can be grouped together
        # Multiple minions act as a single entity in conflicts

        PROPERTIES {
            ^"Group Size" INTEGER MIN 1 MAX 20
        }

        RULES {
            #L5R012tU3vW5xY7zA9bC1d: WHEN [^"Minion" IN group] THEN GROUP acts as single entity
        }
    }

    #L5R013eF4gH6iJ8kL0mN2o ACTOR "Party" DEF {
        EXTENDS #L5R001aB2cD4eF6gH8iJ0kL ^"Entity"

        # A group of player characters traveling and adventuring together

        PROPERTIES {
            ^"Members" LIST OF ^"Samurai" REQUIRED
            ^"Shared Resources" LIST OF STRING
            ^"Current Location" STRING
        }

        RULES {
            #L5R014pQ5rS7tU9vW1xY3z: WHEN [^"Party" ESTABLISHED] THEN REQUIRE at least 2 ^"Members"
        }
    }

    # === DICE AND CHECK SYSTEM ===

    ^"Ring Die" DEF {

        # Six-sided custom die representing a character's innate ring aptitude.
        # In text represented as (ring). Provides less potent outcomes than
        # Skill dice but always available based on ring value.

        FACES {
            1 "Blank"
            2 "(op) (st)"
            3 "(op)"
            4 "(su) (st)"
            5 "(su)"
            6 "(ex) (st)"
        }

        RULES {
            #L5R015aB6cD8eF0gH2iJ4k: ring_die_pool_equals_ring_value
            #L5R016lM7nO9pQ1rS3tU5v: ring_die_always_available
        }
    }

    ^"Skill Die" DEF {

        # Twelve-sided custom die representing trained expertise.
        # In text represented as (skill). Provides more potent outcomes
        # including success without strife and clean explosive success.

        FACES {
            1 "Blank"
            2 "Blank"
            3 "(op) (st)"
            4 "(op)"
            5 "(su) (st)"
            6 "(su) (st)"
            7 "(su)"
            8 "(su)"
            9 "(su) (op)"
            10 "(su) (op)"
            11 "(ex) (st)"
            12 "(ex)"
        }

        RULES {
            #L5R017wX8yZ0aB2cD4eF6g: skill_die_pool_equals_skill_ranks
            #L5R018hI9jK1lM3nO5pQ7r: skill_die_provides_cleaner_results
        }
    }

    ^"Dice Symbols" DEF {

        # Four unique symbols appearing on L5R custom dice in various
        # combinations. Resolved in specific order during Step 6 of a check.

        ENUM ["Success", "Explosive Success", "Opportunity", "Strife"]

        SYMBOL_DEFINITIONS {
            ^"Success (su)" "Counts toward meeting or exceeding TN. Each (su) = 1 success."
            ^"Explosive Success (ex)" "Counts as (su) and allows rolling 1 additional die of same type. New die may be kept or dropped."
            ^"Opportunity (op)" "Narrative currency for secondary effects. Does not affect success or failure directly."
            ^"Strife (st)" "Emotional accumulation. Does not affect success or failure but tracks toward Compromised condition."
        }

        RESOLUTION_ORDER ["(ex)", "(st)", "(op)", "(su)"]

        RULES {
            #L5R019sT0uV2wX4yZ6aB8c: symbol_resolution_order
            #L5R020dE1fG3hI5jK7lM9n: explosive_success_chain_rolling
            #L5R021oP2qR4sT6uV8wX0y: opportunity_narrative_effects
            #L5R022zA3bC5dE7fG9hI1j: strife_accumulation_tracking
        }
    }

    ^"Check" DEF {

        # The core resolution mechanic for L5R. Roll and Keep system:
        # 1) Assemble dice pool (Ring dice + Skill dice)
        # 2) Roll all dice
        # 3) Keep dice up to ring value
        # 4) Resolve symbols on kept dice

        STEPS {
            1 "Declare Intention: Player explains what character wants to accomplish"
            2 "Determine Details: GM assigns skill, ring (approach), and TN"
            3 "Assemble and Roll Dice Pool: Ring dice = ring value, Skill dice = skill ranks"
            4 "Modify Rolled Dice: Apply advantages/disadvantages that cause rerolls"
            5 "Choose Kept Dice: Select up to ring value dice to keep"
            6 "Resolve Symbols on Kept Dice: (ex) then (st) then (op) then (su)"
        }

        RULES {
            #L5R023kL4mN6oP8qR0sT2u: dice_pool_assembly
            #L5R024vW5xY7zA9bC1dE3f: keep_limit_equals_ring_value
            #L5R025gH6iJ8kL0mN2oP4q: success_threshold_comparison
            #L5R026rS7tU9vW1xY3zA5b: bonus_successes_quality
            #L5R027cD8eF0gH2iJ4kL6m: shortfall_degree_of_failure
        }
    }

    ^"Target Number" DEF {

        INTEGER MIN 1 MAX 8

        # Number of (su) and (ex) symbols needed for the check to succeed.
        # Set by the GM based on difficulty of the task.

        DIFFICULTY_SCALE {
            1 "Easy (routine task for a trained person)"
            2 "Average (standard difficulty for most checks)"
            3 "Hard (requires significant skill or luck)"
            4 "Very Hard (challenges even experts)"
            5 "Heroic (near the limits of mortal ability)"
            6 "Legendary (requires extraordinary circumstances)"
            7 "Mythic (virtually impossible without supernatural aid)"
            8 "Divine (reserved for feats of cosmic significance)"
        }

        RULES {
            #L5R028nO9pQ1rS3tU5vW7x: gm_sets_target_number
            #L5R029yZ0aB2cD4eF6gH8i: default_tn_is_two
        }
    }

    ^"Approach" DEF {

        ENUM ["Air", "Earth", "Fire", "Water", "Void"]

        # Each ring represents a different approach to any skill check.
        # The GM determines which ring applies based on how the character
        # describes their action. This determines which ring dice to roll
        # and how many dice to keep.
        #
        # Air: Precision, subtlety, grace — speaking carefully, striking precisely
        # Earth: Resilience, patience, thoroughness — enduring, remembering, defending
        # Fire: Passion, invention, ferocity — creating, commanding, attacking aggressively
        # Water: Flexibility, awareness, adaptation — perceiving, persuading, flowing
        # Void: Instinct, mysticism, wisdom — intuiting, sensing the supernatural

        RULES {
            #L5R030jK1lM3nO5pQ7rS9t: approach_determines_ring_used
            #L5R031uV2wX4yZ6aB8cD0e: approach_determines_opportunity_options
        }
    }

    ^"Opportunity" DEF {

        # (op) symbols on kept dice can be spent for additional narrative
        # effects. Available options depend on the ring used for the check.
        # General opportunities are always available regardless of ring.

        GENERAL_OPPORTUNITIES {
            "(op): If performing a check for a scheme, learn if the target's vigilance is higher or lower than your TN on the check."
            "(op)+: Remove 1 strife you gained from this check per (op) spent."
            "(op)(op): Learn the target's demeanor and current strife."
        }

        AIR_OPPORTUNITIES {
            "(op): Add a kept (ring) set to an (op) result."
            "(op)+: Learn something about a target (per GM)."
            "(op)(op): Act subtly to avoid notice."
        }

        EARTH_OPPORTUNITIES {
            "(op): Reassure another character, removing 2 of their strife."
            "(op)+: Act cautiously, gaining +1 resistance per (op) spent."
            "(op)(op): Suddenly recall an important detail."
        }

        FIRE_OPPORTUNITIES {
            "(op): Add a kept (ring) set to an (op) result."
            "(op)+: Inflict additional strife on a target per (op) spent."
            "(op)(op): Provide assistance to another character's next check."
        }

        WATER_OPPORTUNITIES {
            "(op): Remove 1 fatigue."
            "(op)+: Act efficiently, performing the task more quickly."
            "(op)(op): Spot a hidden detail in the environment."
        }

        VOID_OPPORTUNITIES {
            "(op): Choose a ring other than Void. Reduce TN of your next check using that ring by 1."
            "(op)+: Sense the presence of supernatural influence."
            "(op)(op): Gain spiritual insight (per GM)."
        }

        RULES {
            #L5R032fG3hI5jK7lM9nO1p: opportunity_is_optional
            #L5R033qR4sT6uV8wX0yZ2a: ring_determines_options
            #L5R034bC5dE7fG9hI1jK3l: stacking_opportunity_effects
        }
    }

    ^"Void Points" DEF {
        APPLIES TO [^"Samurai"]

        INTEGER MIN 0

        # Spiritual currency representing connection to the Void.
        # Maximum = Void ring value. Recovered slowly.

        STARTING_VALUE "Void ring value / 2 (rounded up)"
        MAXIMUM "Void ring value"

        USES {
            ^"Seize the Moment" "Spend 1 Void point: Roll 1 additional (ring) and keep 1 additional die on a check."
            ^"Shattering Parry" "Spend 1 Void point: Reduce severity of a critical strike targeting you by your school rank."
            ^"Technique Activation" "Some techniques require spending Void points."
        }

        RECOVERY {
            "Gain 1 when adversity disadvantage applies and check fails (1/scene per disadvantage)"
            "Gain 1 when anxiety disadvantage triggers (1/scene per disadvantage)"
            "Gain 1 when affected by a complication and choosing to be moved by it"
            "Gain 1 when GM conceals TN of a check"
        }

        RULES {
            #L5R035mN6oP8qR0sT2uV4w: seize_the_moment_mechanics
            #L5R036xY7zA9bC1dE3fG5h: shattering_parry_reduction
            #L5R037iJ8kL0mN2oP4qR6s: void_point_recovery_triggers
        }
    }

    # === SCENE AND SESSION STRUCTURE ===

    ^"Turn" DEF {

        # The amount of time needed for a character to take one action
        # in a structured scene. Duration is abstract and narrative.

        RULES {
            #L5R038tU9vW1xY3zA5bC7d: turn_duration_variable
            #L5R039eF0gH2iJ4kL6mN8o: action_and_movement_per_turn
        }
    }

    ^"Scene" DEF {

        ENUM ["Narrative", "Downtime", "Conflict"]

        # Basic unit of gameplay. Characters are in a specific location
        # doing something interesting. Strife partially clears between scenes.

        PROPERTIES {
            ^"Scene Type" ENUM ["Narrative", "Downtime", "Conflict"]
            ^"Location" STRING
            ^"Participants" LIST OF ^"Entity"
        }

        RULES {
            #L5R040pQ1rS3tU5vW7xY9z: strife_removal_between_scenes
            #L5R041aB2cD4eF6gH8iJ0k: scene_transition_effects
        }
    }

    ^"Session" DEF {

        # One game session. Experience points are awarded at session end.
        # Some effects reset between sessions.

        RULES {
            #L5R042lM3nO5pQ7rS9tU1v: experience_awards_per_session
            #L5R043wX4yZ6aB8cD0eF2g: session_effects_reset
        }
    }

    ^"Conflict Type" DEF {

        ENUM ["Intrigue", "Duel", "Skirmish", "Mass Battle"]

        # Four types of structured conflict scenes, each with specific rules.
        #
        # Intrigue: Social/political conflicts using social skills
        # Duel: Formal one-on-one combat (iaijutsu or taryu-jiai)
        # Skirmish: Small-scale tactical combat
        # Mass Battle: Army-scale warfare using abstracted mechanics

        RULES {
            #L5R044hI5jK7lM9nO1pQ3r: intrigue_social_combat
            #L5R045sT6uV8wX0yZ2aB4c: duel_formal_one_on_one
            #L5R046dE7fG9hI1jK3lM5n: skirmish_tactical_combat
            #L5R047oP8qR0sT2uV4wX6y: mass_battle_abstracted_warfare
        }
    }

    ^"Stance" DEF {

        ENUM ["Air", "Earth", "Fire", "Water", "Void"]

        # In conflict scenes, each character chooses a stance at the start
        # of their turn. The stance determines their default ring for checks
        # and grants specific benefits.
        #
        # Air Stance: +1 TN for attack checks targeting you at range 1-2
        # Earth Stance: May not receive more strife or fatigue than your Earth ring per check
        # Fire Stance: Bonus success on Attack and Scheme checks if you keep (st)
        # Water Stance: May perform an additional action that does not require a check
        # Void Stance: May not be targeted by Schemes. Treat (op) on kept dice as blank.

        RULES {
            #L5R048zA9bC1dE3fG5hI7j: stance_chosen_at_turn_start
            #L5R049kL0mN2oP4qR6sT8u: air_stance_evasion_bonus
            #L5R050vW1xY3zA5bC7dE9f: earth_stance_endurance_cap
            #L5R051gH2iJ4kL6mN8oP0q: fire_stance_aggressive_bonus
            #L5R052rS3tU5vW7xY9zA1b: water_stance_extra_action
            #L5R053cD4eF6gH8iJ0kL2m: void_stance_scheme_immunity
        }
    }

    ^"Initiative" DEF {

        # Turn order in conflict scenes. Characters make a TN 1 Initiative
        # check (Tactics/Meditation + Void) at the start of each round.
        # Characters act in order of bonus successes (highest first),
        # with ties broken by Focus attribute.

        RULES {
            #L5R054nO5pQ7rS9tU1vW3x: initiative_check_void_ring
            #L5R055yZ6aB8cD0eF2gH4i: bonus_successes_determine_order
            #L5R056jK7lM9nO1pQ3rS5t: focus_breaks_ties
        }
    }

    ^"Action" DEF {

        ENUM ["Attack", "Scheme", "Support", "Guard", "Movement", "Calming Breath", "Prepare", "Wait"]

        # Actions available during conflict turns.
        #
        # Attack: Martial Arts check to deal physical damage
        # Scheme: Social skill check for social/mental effects
        # Support: Assist another character's next check
        # Guard: Protect an ally or position
        # Movement: Move up to Water ring range bands
        # Calming Breath: Remove strife equal to Meditation skill ranks
        # Prepare: Ready a delayed action
        # Wait: Delay your turn

        RULES {
            #L5R057uV8wX0yZ2aB4cD6e: attack_deals_physical_damage
            #L5R058fG9hI1jK3lM5nO7p: scheme_deals_social_damage
            #L5R059qR0sT2uV4wX6yZ8a: support_grants_assistance
            #L5R060bC1dE3fG5hI7jK9l: guard_protects_ally
            #L5R061mN2oP4qR6sT8uV0w: movement_water_ring_range_bands
        }
    }

    ^"Range Band" DEF {

        ENUM ["Range 0", "Range 1", "Range 2", "Range 3", "Range 4", "Range 5", "Range 6+"]

        # Abstract distance measurement in conflict scenes.
        # Range 0: Melee range (within arm's reach)
        # Range 1-2: Close (a few steps to across a room)
        # Range 3-4: Medium (across a courtyard or field)
        # Range 5-6: Long (far end of a battlefield)

        RULES {
            #L5R062xY3zA5bC7dE9fG1h: melee_requires_range_zero
            #L5R063iJ4kL6mN8oP0qR2s: ranged_weapons_have_range_limits
            #L5R064tU5vW7xY9zA1bC3d: movement_in_range_bands
        }
    }

    ^"GM Role" DEF {

        BOOLEAN DEFAULT false

        # The Game Master creates the story framework, portrays NPCs,
        # describes scenes, sets TNs, and arbitrates rules. Primary
        # duty is ensuring all players have fun.

        RULES {
            #L5R065eF6gH8iJ0kL2mN4o: setting_creation_responsibility
            #L5R066pQ7rS9tU1vW3xY5z: npc_control
            #L5R067aB8cD0eF2gH4iJ6k: rule_arbitration_authority
            #L5R068lM9nO1pQ3rS5tU7v: target_number_determination
        }
    }

    ^"Experience Points" DEF {
        APPLIES TO [^"Samurai"]

        INTEGER MIN 0 MAX 999999

        # Points earned through play to improve character abilities.
        # Awarded for session participation, good roleplaying, and
        # story milestones. Spent on skills, rings, techniques, and
        # advantages during downtime.

        ADVANCEMENT_COSTS {
            ^"Skill Rank" COST "new rank × 2 XP (curriculum), new rank × 3 XP (non-curriculum)"
            ^"Ring Increase" COST "new rank × 3 XP (curriculum ring)"
            ^"Technique" COST "3 XP (curriculum), 3 × technique rank XP (non-curriculum)"
            ^"Distinction/Passion" COST "3 XP"
            ^"Adversity/Anxiety" COST "3 XP (gain 1 Void point per scene when triggered)"
            ^"Void Point Max" COST "included with ring increase"
        }

        RULES {
            #L5R069wX0yZ2aB4cD6eF8g: session_awards
            #L5R070hI1jK3lM5nO7pQ9r: milestone_bonus
            #L5R071sT2uV4wX6yZ8aB0c: advancement_spending_rules
        }
    }
}
