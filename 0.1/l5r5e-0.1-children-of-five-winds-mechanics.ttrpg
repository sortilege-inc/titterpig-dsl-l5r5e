    ^"Centered Condition" DEF {
        # Remove up to 2 strife per check.
    }

    ^"Emboldened Condition" DEF {
        # Receive 1 fatigue to keep an additional rolled die.
    }

    ^"Possessed Condition" DEF {
        # Spirit exerts influence; character must pursue spirit's goal
        # or gain 2 strife. Can use spirit's skills/techniques once per
        # scene. Removed via Meditation check or Dispel Possession
        # social objective.
    }

