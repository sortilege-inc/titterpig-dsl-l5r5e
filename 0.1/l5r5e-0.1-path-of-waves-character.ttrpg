            }
            ^"Rank 2" {
                "Scholar" SKILL_GROUP
                "Command" SKILL
                "Labor" SKILL
                "Martial Arts [Ranged]" SKILL
                "Rank 1-2 Shuji (shuji)" TECH_GROUP
                "Fortitude Draught (ritual)" TECHNIQUE
                "Boar's Wrath Style (kata)" TECHNIQUE
            }
            ^"Rank 3" {
                "Scholar" SKILL_GROUP
                "Courtesy" SKILL
                "Martial Arts [Ranged]" SKILL
                "Sentiment" SKILL
                "Rank 1-3 Rituals (ritual)" TECH_GROUP
                "Breath of the Wind Style (kata)" TECHNIQUE
                "Look Out! (shuji)" TECHNIQUE
            }
            ^"Rank 4" {
                "Social" SKILL_GROUP
                "Government" SKILL
                "Medicine" SKILL
                "Theology" SKILL
                "Rank 1-4 Rituals (ritual)" TECH_GROUP
                "Restorative Transmutation (ritual)" TECHNIQUE
