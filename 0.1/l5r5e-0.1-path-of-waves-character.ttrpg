    ^"Ivory Kingdoms Sage Tradition" DEF {
        APPLIES TO [^"Samurai"]

        # Individuals so tuned to their inner energy (lojas) that
        # they can infuse others with it. They go on long
        # pilgrimages seeking truths of the world.

        PROPERTIES {
            ^"School" STRING "Ivory Kingdoms Sage Tradition" FIXED
            ^"School Roles" LIST OF STRING ["Sage", "Bushi"]
            ^"Restricted To" STRING "Ivory Kingdoms culture (or GM exception)"
            ^"Starting Rings" STRING "+1 Void, +1 Earth"
            ^"Starting Skills" STRING "Choose five: Composition, Command, Courtesy, Martial Arts [Melee], Martial Arts [Unarmed], Meditation, Theology"
            ^"Starting Honor" INTEGER DEFAULT 50
            ^"Available Technique Groups" LIST OF STRING ["Kata (kata)", "Kiho (kiho)", "Rituals (ritual)"]
            ^"Starting Techniques" STRING "Kiho (choose two): Cleansing Spirit, Earth Needs No Eyes, Earthen Fist; Rituals: Threshold Barrier"
            ^"School Ability" STRING "Gift of Inner Power"
            ^"Mastery Ability" STRING "Divine Protection"
        }

        ^"Gift of Inner Power" DEF {
            # After you perform a check to activate one of your kiho,
            # you can receive fatigue up to your school rank and choose
            # another character at range 0-1. If you do, that character
            # gains the enhancement effect of your kiho in your stead
            # (you may still resolve the burst effect, if able). This effect
            # persists a number of rounds equal to the amount of fatigue
            # you received plus your ranks in Meditation. Only one
            # character can benefit from your kiho at a time.
        }

        CURRICULUM {
            ^"Rank 1" {
                "Scholar" SKILL_GROUP
                "Command" SKILL
                "Courtesy" SKILL
                "Fitness" SKILL
                "Rank 1 Kiho (kiho)" TECH_GROUP
                "Landslide Strike (kata)" TECHNIQUE
                "Bellow of Resolve (shuji)" TECHNIQUE
            }
            ^"Rank 2" {
                "Martial" SKILL_GROUP
                "Composition" SKILL
                "Government" SKILL
                "Sentiment" SKILL
                "Rank 1-2 Kiho (kiho)" TECH_GROUP
                "Rider's Haste (kata)" TECHNIQUE
                "Lord Hida's Grip (kata)" TECHNIQUE
            }
            ^"Rank 3" {
                "Martial" SKILL_GROUP
                "Courtesy" SKILL
                "Sentiment" SKILL
                "Theology" SKILL
                "Rank 1-3 Kata (kata)" TECH_GROUP
                "Thunderous Hooves Style (kata)" TECHNIQUE
                "Cleansing of Coral and Gold (ritual)" TECHNIQUE
            }
            ^"Rank 4" {
                "Social" SKILL_GROUP
                "Fitness" SKILL
                "Martial Arts [Melee]" SKILL
                "Martial Arts [Unarmed]" SKILL
                "Rank 1-4 Kiho (kiho)" TECH_GROUP
                "Striking as Void (kata)" TECHNIQUE
                "Mentor's Guidance (shuji)" TECHNIQUE
            }
            ^"Rank 5" {
                "Social" SKILL_GROUP
                "Martial Arts [Melee]" SKILL
                "Martial Arts [Unarmed]" SKILL
                "Meditation" SKILL
                "Rank 1-5 Kata (kata)" TECH_GROUP
                "Touch the Void Dragon (kiho)" TECHNIQUE
                "Buoyant Arrival (kata)" TECHNIQUE
            }
            ^"Rank 6" {
                "Divine Protection (Mastery Ability): You can perform the Threshold Barrier ritual as an action. When a Tainted being enters an area you have warded against it with this ritual, it suffers supernatural damage equal to your ranks in Meditation and the Prone condition."
            }
        }

        RULES {
            #L5RPW40nO7pQ9rS1tU3vW5x: ik_sage_gift_kiho_to_ally
        }
    }

    ^"Ivory Kingdoms Dancing Blades Tradition" DEF {
        APPLIES TO [^"Samurai"]

        # Warriors trained to wield astras (implements of the
        # gods). They look as though they are dancing as they
        # fight, taking on multiple enemies at once.

        PROPERTIES {
            ^"School" STRING "Ivory Kingdoms Dancing Blades Tradition" FIXED
            ^"School Roles" LIST OF STRING ["Bushi"]
            ^"Restricted To" STRING "Ivory Kingdoms culture (or GM exception)"
            ^"Starting Rings" STRING "+1 Earth, +1 Fire"
            ^"Starting Skills" STRING "Choose five: Command, Culture, Martial Arts [Melee], Martial Arts [Ranged], Medicine, Performance, Seafaring"
            ^"Starting Honor" INTEGER DEFAULT 45
            ^"Available Technique Groups" LIST OF STRING ["Kata (kata)", "Rituals (ritual)", "Shuji (shuji)"]
            ^"Starting Techniques" STRING "Kata (choose one): Hawk's Precision or Warrior's Resolve; Shuji (choose one): Stirring the Embers or Honest Assessment"
            ^"School Ability" STRING "Flurry of Steel"
            ^"Mastery Ability" STRING "Tower of Ivory"
        }

        ^"Flurry of Steel" DEF {
            # Once per scene when performing an Attack action, you
            # may choose a number of additional enemies up to your
            # school rank in range of your weapon as targets for that
            # Attack action.
        }

        CURRICULUM {
            ^"Rank 1" {
                "Martial" SKILL_GROUP
                "Command" SKILL
                "Culture" SKILL
                "Performance" SKILL
                "Rank 1 Kata (kata)" TECH_GROUP
                "Eyes Up! (shuji)" TECHNIQUE
                "Rider's Haste (kata)" TECHNIQUE
            }
            ^"Rank 2" {
                "Martial" SKILL_GROUP
                "Command" SKILL
                "Government" SKILL
                "Seafaring" SKILL
                "Rank 1-2 Kata (kata)" TECH_GROUP
                "Rushing Ox Style (kata)" TECHNIQUE
                "Summon Mantra: [One Implement] (mantra)" TECHNIQUE
            }
            ^"Rank 3" {
                "Martial" SKILL_GROUP
                "Command" SKILL
                "Culture" SKILL
                "Seafaring" SKILL
                "Rank 1-3 Earth and Fire Shuji (shuji)" TECH_GROUP
                "Daring Swing (kata)" TECHNIQUE
                "Bravado (shuji)" TECHNIQUE
            }
            ^"Rank 4" {
                "Martial" SKILL_GROUP
                "Culture" SKILL
                "Government" SKILL
                "Performance" SKILL
                "Rank 1-4 Kata (kata)" TECH_GROUP
                "Swirling Tempest Style (kata)" TECHNIQUE
                "Roar of Encouragement (shuji)" TECHNIQUE
            }
            ^"Rank 5" {
                "Martial" SKILL_GROUP
                "Command" SKILL
                "Culture" SKILL
                "Seafaring" SKILL
                "Rank 1-5 Kata (kata)" TECH_GROUP
                "Sear the Wound (kata)" TECHNIQUE
                "The Immovable Hand of Peace (shuji)" TECHNIQUE
            }
            ^"Rank 6" {
                "Tower of Ivory (Mastery Ability): After you defend against damage, increase your physical resistance by 1. This effect can stack a number of times equal to your ranks in Meditation and persists until the end of the scene."
            }
        }

        RULES {
            #L5RPW41yZ8aB0cD2eF4gH6i: dancing_blades_flurry_multiple_targets
        }
    }

    # ===========================
    # QUESTION 10: THE PAST
    # (REPLACES GIRI)
    # ===========================

    ^"The Past System" DEF {
        APPLIES TO [^"Samurai"]

        # Ronin do not have the same giri attribute as samurai.
        # Instead, giri is replaced by the character's past.
        # The past represents the character's history and what
        # drove them onto the path of waves. It functions
        # mechanically similar to giri but reflects the character's
        # relationship with their former life rather than duty
        # to a lord.

        RULES {
            #L5RPW42jK9lM1nO3pQ5rS7t: past_replaces_giri_for_ronin
            #L5RPW43uV0wX2yZ4aB6cD8e: past_represents_history_on_path_of_waves
        }
    }

    # ===========================
    # NEW ROLE: SAGE
    # ===========================

    ^"Sage Role" DEF {
        APPLIES TO [^"Samurai"]

        # Like shugenja, sages wield special powers, but theirs
        # are bestowed by other means, usually outside the
        # bounds of what is considered appropriate in Rokugan.
        # A sage may wield powers granted by gods that rule
        # in lands outside the Empire's borders, or they may
        # use techniques such as kiho in unfamiliar ways.

        RULES {
            #L5RPW44fG1hI3jK5lM7nO9p: sage_role_non_rokugani_powers
        }
    }

    # ===========================
    # NEW ADVANTAGES (DISTINCTIONS)
    # ===========================

    ^"Ardent Leader" DEF {
        APPLIES TO [^"Advantage"]
        PROPERTIES {
            ^"Type" STRING "Distinction"
            ^"Ring" STRING "Fire"
            ^"Types" LIST OF STRING ["Interpersonal", "Mental"]
            ^"Effect" STRING "You speak with confidence that most find hard to ignore, and people are more likely to hear what you have to say, even if they are of higher status. When you make a check for which your ardent leadership applies (such as a Tactics [Fire] check to deploy peasants or a Courtesy [Fire] check to excite someone into believing your plan), you may reroll up to two dice."
        }
    }

    ^"Dashing Scar" DEF {
        APPLIES TO [^"Advantage"]
        PROPERTIES {
            ^"Type" STRING "Distinction"
            ^"Ring" STRING "Air"
            ^"Types" LIST OF STRING ["Interpersonal"]
            ^"Effect" STRING "You have a scar or visible mark that adds to your heroic reputation. People who see it nearly always remember you positively. When performing a check for which your scar could act as an asset (such as a Command [Air] check to speak with authority or a Skulduggery [Air] check to accentuate roguish charm), you may reroll up to two dice."
        }
    }

    ^"Lucky Hunter" DEF {
        APPLIES TO [^"Advantage"]
        PROPERTIES {
            ^"Type" STRING "Distinction"
            ^"Ring" STRING "Void"
            ^"Types" LIST OF STRING ["Physical", "Spiritual"]
            ^"Effect" STRING "You are exceptionally fortunate in hunting or fishing and can always identify the best spots. When performing a check related to hunting, trapping, or fishing (such as a Survival [Void] check to locate hiding quarry or a Seafaring [Void] check to determine best fishing time), you may reroll up to two dice."
        }
    }

    ^"Scrappy" DEF {
        APPLIES TO [^"Advantage"]
        PROPERTIES {
            ^"Type" STRING "Distinction"
            ^"Ring" STRING "Fire"
            ^"Types" LIST OF STRING ["Mental", "Physical"]
            ^"Effect" STRING "You have experience street fighting and brawling. You know how to stealthily employ dishonorable tactics. When performing a check during combat to use dishonorable tactics (such as a Sentiment [Fire] check to determine how to offend someone or a Martial Arts [Fire] check to unnerve your foe), you may reroll up to two dice."
        }
    }

    ^"Scrounger" DEF {
        APPLIES TO [^"Advantage"]
        PROPERTIES {
            ^"Type" STRING "Distinction"
            ^"Ring" STRING "Water"
            ^"Types" LIST OF STRING ["Interpersonal", "Mental"]
            ^"Effect" STRING "You are always able to find something to fill your belly and sustain you, though sometimes the only option is repulsive. When performing a check for which your resourceful nature applies (such as a Labor [Water] check to find useful items or an Aesthetics [Water] check to find inspiration), you may reroll up to two dice."
        }
    }

    ^"Urbane and Worldly" DEF {
        APPLIES TO [^"Advantage"]
        PROPERTIES {
            ^"Type" STRING "Distinction"
            ^"Ring" STRING "Void"
            ^"Types" LIST OF STRING ["Interpersonal", "Physical"]
            ^"Effect" STRING "Your experience traveling abroad has prepared you to expertly emulate and adapt to unfamiliar customs. When observing an unfamiliar cultural practice (such as a Performance [Void] check to emulate local customs or a Commerce [Void] check to feign awareness during negotiation), you may reroll up to two dice."
        }
    }

    # ===========================
    # NEW ADVANTAGES (PASSIONS)
    # ===========================

    ^"Attention" DEF {
        APPLIES TO [^"Advantage"]
        PROPERTIES {
            ^"Type" STRING "Passion"
            ^"Ring" STRING "Fire"
            ^"Types" LIST OF STRING ["Mental"]
            ^"Effect" STRING "At start of each scene, you can determine the most effective way to gain attention. After performing a check to capture attention (such as a Performance [Fire] check to entice a merchant or a Games [Fire] check to draw a crowd), you remove 3 strife."
        }
    }

    ^"Honest Work" DEF {
        APPLIES TO [^"Advantage"]
        PROPERTIES {
            ^"Type" STRING "Passion"
            ^"Ring" STRING "Earth"
            ^"Types" LIST OF STRING ["Mental", "Interpersonal"]
            ^"Effect" STRING "You can always determine how much work is needed for a physical task, and your work is always markedly better than others. After performing a check requiring physical labor (such as a Labor [Earth] check to till a field or a Smithing [Earth] check to fix a tool), you remove 3 strife."
        }
    }

    ^"Passion for [Foreign Performing Art Form]" DEF {
        APPLIES TO [^"Advantage"]
        PROPERTIES {
            ^"Type" STRING "Passion"
            ^"Ring" STRING "Air"
            ^"Types" LIST OF STRING ["Fame", "Interpersonal"]
            ^"Effect" STRING "You are skilled in a foreign artistry (puppetry, miming, foreign dance, foreign instrument) and recognize common forms and intricate historical details. After performing a check related to your talent (such as Performance [Air] to impress or Design [Air] to refine craft), you may reroll up to two dice."
        }
    }

    # ===========================
    # NEW DISADVANTAGES (ADVERSITIES)
    # ===========================

    ^"Bullheaded" DEF {
        APPLIES TO [^"Disadvantage"]
        PROPERTIES {
            ^"Type" STRING "Adversity"
            ^"Ring" STRING "Earth"
            ^"Types" LIST OF STRING ["Mental"]
            ^"Effect" STRING "When pursuing a goal related to your ninjo, you have difficulty focusing on anything unrelated. When you make a check related to your goal that requires planning, subtlety, or nuance (such as Culture [Earth] to recall proper introductions or Courtesy [Earth] to reason with a stubborn merchant), you must choose and reroll two dice containing success or explosion. If you failed, gain 1 Void point."
        }
    }

    ^"Debt to [Person or Organization]" DEF {
        APPLIES TO [^"Disadvantage"]
        PROPERTIES {
            ^"Type" STRING "Adversity"
            ^"Ring" STRING "Water"
            ^"Types" LIST OF STRING ["Interpersonal"]
            ^"Effect" STRING "You are in terrible debt. If you fail to make regular payments or fulfill obligations, your debtor will hunt you down. When making a check related to dodging or worsening debt (such as Commerce [Water] to purchase something unnecessary or Courtesy [Water] to get a loan), you must choose and reroll two dice containing success or explosion. If you failed, gain 1 Void point."
        }
    }

    ^"Encompassing Duty" DEF {
        APPLIES TO [^"Disadvantage"]
        PROPERTIES {
            ^"Type" STRING "Adversity"
            ^"Ring" STRING "Earth"
            ^"Types" LIST OF STRING ["Mental"]
            ^"Effect" STRING "You have a duty to something (family, friend, cause). You have difficulty relaxing or focusing on unrelated tasks. When making a check related to overcoming hindrance to your duty (such as Meditation [Earth] to stay calm in ambush or Courtesy [Earth] to reason with stubborn shopkeeper), you must choose and reroll two dice containing success or explosion. If you failed, gain 1 Void point."
        }
    }

    ^"Horrible Scar" DEF {
        APPLIES TO [^"Disadvantage"]
        PROPERTIES {
            ^"Type" STRING "Adversity"
            ^"Ring" STRING "Air"
            ^"Types" LIST OF STRING ["Interpersonal", "Mental"]
            ^"Effect" STRING "You have an awful scar that hinders interactions. People stare, treat you unfairly, and judge you. When performing a check to interact socially with a stranger (such as Courtesy [Air] to request information or Sentiment [Air] to calm someone), you must choose and reroll two dice containing success or explosion. If you failed, gain 1 Void point."
        }
    }

    ^"Many Mouths" DEF {
        APPLIES TO [^"Disadvantage"]
        PROPERTIES {
            ^"Type" STRING "Adversity"
            ^"Ring" STRING "Earth"
            ^"Types" LIST OF STRING ["Interpersonal", "Mental"]
            ^"Effect" STRING "You must provide for many dependents beyond your means. When performing a check related to providing food, money, or care (such as Labor [Earth] to produce food or Sentiment [Earth] to soothe loved ones), you must choose and reroll two dice containing success or explosion. If you failed, gain 1 Void point."
        }
    }

    ^"Pursued by [Individual or Group]" DEF {
        APPLIES TO [^"Disadvantage"]
        PROPERTIES {
            ^"Type" STRING "Adversity"
            ^"Ring" STRING "Water"
            ^"Types" LIST OF STRING ["Interpersonal", "Mental"]
            ^"Effect" STRING "A pursuer wishes to capture or kill you. You have difficulty relaxing in public. When making a check that draws attention in public (such as Commerce [Water] to trade at market or Courtesy [Water] to win favor at court), you must choose and reroll two dice containing success or explosion. If you failed, gain 1 Void point."
        }
    }

    ^"Stained Lineage" DEF {
        APPLIES TO [^"Disadvantage"]
        PROPERTIES {
            ^"Type" STRING "Adversity"
            ^"Ring" STRING "Void"
            ^"Types" LIST OF STRING ["Interpersonal", "Mental"]
            ^"Effect" STRING "Your family has a bad reputation. Most people in your region know and make negative assumptions about you. When making a check to interact with anyone from your home region (such as Commerce [Void] to trade without drawing attention or Courtesy [Void] to warn of danger), you must choose and reroll two dice containing success or explosion. If you failed, gain 1 Void point."
        }
    }

    # ===========================
    # NEW DISADVANTAGES (ANXIETIES)
    # ===========================

    ^"Coming Storm" DEF {
        APPLIES TO [^"Disadvantage"]
        PROPERTIES {
            ^"Type" STRING "Anxiety"
            ^"Ring" STRING "Void"
            ^"Types" LIST OF STRING ["Mental"]
            ^"Effect" STRING "Your family has endured great recurring hardship. You are constantly vigilant for the same type of calamity. When performing a check involving planning for your or your family's well-being (such as Medicine [Void] to sense ailment or Command [Void] to warn of risk), you receive 3 strife. If first time this scene, gain 1 Void point."
        }
    }

    ^"Eyes of Many" DEF {
        APPLIES TO [^"Disadvantage"]
        PROPERTIES {
            ^"Type" STRING "Anxiety"
            ^"Ring" STRING "Air"
            ^"Types" LIST OF STRING ["Mental"]
            ^"Effect" STRING "You constantly worry that others are watching and judging you. Unable to relax in crowded places. After performing a check in a crowded place or where two or more strangers actively listen (such as Courtesy [Air] to lie to employer or Fitness [Air] to avoid notice), you suffer 3 strife. If first time this scene, gain 1 Void point."
        }
    }

    ^"Failure" DEF {
        APPLIES TO [^"Disadvantage"]
        PROPERTIES {
            ^"Type" STRING "Anxiety"
            ^"Ring" STRING "Water"
            ^"Types" LIST OF STRING ["Mental"]
            ^"Effect" STRING "You constantly worry about failing those to whom you have commitments. After performing a check that shirks obligations or works against a promise (such as Courtesy [Water] to socialize pointlessly or Games [Water] to gamble needlessly), you suffer 3 strife. If first time this scene, gain 1 Void point."
        }
    }

    ^"Fear of Stagnation" DEF {
        APPLIES TO [^"Disadvantage"]
        PROPERTIES {
            ^"Type" STRING "Anxiety"
            ^"Ring" STRING "Earth"
            ^"Types" LIST OF STRING ["Mental"]
            ^"Effect" STRING "Staying in one place frustrates you. You fear relational commitments that tie you down. After performing a check to continue a prolonged task (such as Labor [Earth] to work on same project for more than two days or Courtesy [Earth] to arrange yet another night in the same city), you receive 3 strife and gain 1 Void point."
        }
    }

    # ===========================
    # PAST SYSTEM (REPLACES GIRI)
    # ===========================

    # The Past replaces Giri for ronin characters. Sample pasts
    # are provided via a d100 table (Table 2-1).

    TABLE "Sample Pasts" {
        ROLL "d100"
        "01-06" "Spiritual Troubles: Desecrated a shrine, ignored an oath, or crossed the Fortunes. Face curses, misfortune, and distrust."
        "07-14" "Bad Family History: Family was falsely or truly accused. Too many people know and judge you."
        "15-22" "Bad Reputation: Accused of murder, authored inappropriate work, had messy affair, engaged in thievery, or voluntarily left liege."
        "23-30" "Debts to Pay: Owe a vast sum to a person or family. Must make regular payments or face a bounty."
        "31-38" "Desertion: Left your post due to cowardice or admirable reasons. Your commander intends to bring you back."
        "39-46" "Duty: Still adhere to an ideal from clan, monastic vows, government, or family. May optionally use giri rules from core."
        "47-54" "Fallen Family Legacy: Family once had name, land, and title. You have only the name."
        "55-62" "Family in Need: Family needs money, medicine, care, attention, or rescue."
        "63-70" "Forsaken Vows: Expelled from or left a monastery. Cannot return until issues resolved."
        "71-78" "Long Path of Waves: After gempuku you explored the world. Your family seeks to take you back."
        "79-86" "Lifelong Enemy: An individual or family competes against you for the same goals."
        "87-93" "Unearned Heroism: Won a duel or contest by accident or nefarious means. The master seeks you out."
        "94-100" "Witness: You know too much and the spied-upon party wants you silent permanently."
    }

    TABLE "Sample Ninjo" {
        ROLL "d100"
        "01-04" "Achieve Mastery: Seek to be the best at swordplay, art, calligraphy, poetry, or other pursuit."
        "05-08" "Amass Followers: Claim to be a bandit leader, crime lord, or cult head. Need an audience."
        "09-13" "Assist the Spirits: Focus on spiritual welfare of lost or abused spirits."
        "14-18" "Atonement: Did a great wrong and must make up for it through actions."
        "19-23" "Construct a Great Work: Driven to build a masterwork gate, sculpture, painting, text, or shrine."
        "24-28" "Discover a Family Heritage: Find a lost claim to greatness -- lineage scroll, relic, or art."
        "29-33" "Enact Justice: Expose a vicious secret, reveal evidence, or get a criminal to confess."
        "34-38" "Establish a Family: Begin a grand lineage with a partner who shares the goal."
        "39-43" "Find a Lord to Serve: Regain lost status, improve station, or integrate into a foreign society."
        "44-48" "Find a Sensei: Study under great masters to become one yourself."
        "49-53" "Find True Love: Seek rare and precious true love in a world that scoffs at it."
        "54-58" "Gain Mystical Power: Seek power to change reality through study or blood magic."
        "59-63" "Kill Monsters: Destroy demons and spirits of corruption."
        "64-68" "Regain Your Home: Return to or rebuild a destroyed homeland."
        "69-73" "Personal Security: Acquire land, money, or stipend to ensure your family's future."
        "74-78" "Recover a Relic: Find a relic with cultural, monetary, or spiritual power."
        "79-83" "Build a Reputation: Spread your name throughout Rokugan to samurai and heimin alike."
        "84-88" "Tame a Great Beast: Tame terrifying creatures that harass farmers and hunters."
        "89-93" "Uncover a Conspiracy: Reveal a plot to overthrow or murder those in power."
        "94-100" "Wreak Vengeance: A villain has wronged you or someone you care about."
    }

    # ===========================
    # SCHOOL ROLE EXTENSION
    # ===========================

    MODIFY ^"School Role" {
        ENUM EXTEND ["Sage", "Artisan"]
        # Path of Waves introduces two new school roles for gaijin and ronin traditions
    }
}
