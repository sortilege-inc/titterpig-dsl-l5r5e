            ^"Rank 2" {
                "Artisan" SKILL_GROUP
                "Commerce" SKILL
                "Games" SKILL
                "Labor" SKILL
                "Rank 1-2 Air Shuji (shuji)" TECH_GROUP
                "Dazzling Performance (shuji)" TECHNIQUE
                "Improvised Assault (kata)" TECHNIQUE
            }
            ^"Rank 3" {
                "Martial" SKILL_GROUP
                "Culture" SKILL
                "Games" SKILL
                "Sentiment" SKILL
                "Rank 1-3 Earth Shuji (shuji)" TECH_GROUP
                "Bravado (shuji)" TECHNIQUE
                "Wheeling Sweep (kata)" TECHNIQUE
            }
            ^"Rank 4" {
                "Martial" SKILL_GROUP
                "Courtesy" SKILL
                "Culture" SKILL
                "Government" SKILL
                "Rank 1-4 Kata (kata)" TECH_GROUP
                "Mentor's Guidance (shuji)" TECHNIQUE
                "Laughing Fox Style (kata)" TECHNIQUE
            }
            ^"Rank 5" {
                "Artisan" SKILL_GROUP
                "Commerce" SKILL
                "Labor" SKILL
                "Sentiment" SKILL
                "Rank 1-5 Shuji (shuji)" TECH_GROUP
                "Roar of Encouragement (shuji)" TECHNIQUE
                "Rouse the Soul (shuji)" TECHNIQUE
            }
            ^"Rank 6" {
                "Surge of Brilliance (Mastery Ability): When you craft an item, you may increase or decrease its rarity by up to your ranks in the skill you used to craft it. Once per game session when you make a check to create, refine, adapt, restore, or attune to an item, the check takes an action rather than a downtime activity."
            }
        }

        RULES {
            #L5RPW35kL2mN4oP6qR8sT0u: artisan_roads_scavenge_supplies
        }
    }

    ^"Mystic of the Mountain School" DEF {
        APPLIES TO [^"Samurai"]

        # Wandering monks who dole out wisdom and practice
        # unarmed martial arts and storytelling in equal measure.

        PROPERTIES {
            ^"School" STRING "Mystic of the Mountain" FIXED
            ^"School Roles" LIST OF STRING ["Monk", "Courtier"]
            ^"Starting Rings" STRING "+1 Void, +1 Air"
            ^"Starting Skills" STRING "Choose four: Martial Arts [Melee], Martial Arts [Unarmed], Performance, Sentiment, Survival, Theology"
            ^"Starting Honor" INTEGER DEFAULT 40
            ^"Available Technique Groups" LIST OF STRING ["Kata (kata)", "Rituals (ritual)", "Shuji (shuji)"]
            ^"Starting Techniques" STRING "Kiho (choose one): Ki Protection or The Great Silence; Shuji (choose one): Honest Assessment or Stirring the Embers; Rituals: Cleansing Rite; Shuji: Artisan's Appraisal"
            ^"School Ability" STRING "Unexpected Wisdom"
            ^"Mastery Ability" STRING "Stories as Tall as the Mountain"
        }

        ^"Unexpected Wisdom" DEF {
            # You may dispense wisdom a number of times per game
            # session equal to your school rank. On your turn or at any
            # appropriate time during a narrative scene, you may give a
            # small bit of wisdom to a character who can hear you and
            # has not benefitted from this ability this scene. The next
            # time that character employs that wisdom they may reduce
            # the TN of that check by 1 and may negate a number of
            # strife up to your ranks in Sentiment or Theology.
        }

        CURRICULUM {
            ^"Rank 1" {
                "Martial" SKILL_GROUP
                "Performance" SKILL
                "Sentiment" SKILL
                "Theology" SKILL
                "Rank 1 Rituals (ritual)" TECH_GROUP
                "Way of the Earthquake (kiho)" TECHNIQUE
                "Air Fist (kiho)" TECHNIQUE
            }
            ^"Rank 2" {
                "Social" SKILL_GROUP
                "Martial Arts [Unarmed]" SKILL
                "Survival" SKILL
                "Theology" SKILL
                "Rank 1-2 Kata (kata)" TECH_GROUP
                "Way of the Willow (kiho)" TECHNIQUE
                "Channel the Fire Dragon (kiho)" TECHNIQUE
            }
            ^"Rank 3" {
                "Martial" SKILL_GROUP
                "Performance" SKILL
                "Sentiment" SKILL
                "Survival" SKILL
                "Rank 1-3 Shuji (shuji)" TECH_GROUP
                "Way of the Falling Star (kiho)" TECHNIQUE
                "Ride the Water Dragon (kiho)" TECHNIQUE
            }
            ^"Rank 4" {
                "Social" SKILL_GROUP
                "Martial Arts [Unarmed]" SKILL
                "Meditation" SKILL
                "Theology" SKILL
                "Rank 1-4 Kata (kata)" TECH_GROUP
                "Touch the Void Dragon (kiho)" TECHNIQUE
                "Pillar of Calm (shuji)" TECHNIQUE
            }
            ^"Rank 5" {
                "Social" SKILL_GROUP
                "Martial Arts [Unarmed]" SKILL
                "Meditation" SKILL
                "Theology" SKILL
                "Rank 1-5 Kata (kata)" TECH_GROUP
                "Way of the Edgeless Sword (kiho)" TECHNIQUE
                "Bend with the Storm (shuji)" TECHNIQUE
            }
            ^"Rank 6" {
                "Stories as Tall as the Mountain (Mastery Ability): Once per scene as a Scheme action you may make a TN 4 Performance (Air or Earth) check targeting a number of minion NPCs up to your ranks in Performance. If you succeed, each target decides that their actions really are unwise and leaves the scene, if able."
            }
        }

        RULES {
            #L5RPW36vW3xY5zA7bC9dE1f: mystic_mountain_wisdom_reduces_tn
        }
    }

    # ===========================
    # GAIJIN SCHOOLS
    # ===========================

    ^"Ujik Diviner School" DEF {
        APPLIES TO [^"Samurai"]

        # Diviners call upon the wisdom of the Lords of Death,
        # honored ancestors ascended to godhood. The first
        # vision given is their own end.

        PROPERTIES {
            ^"School" STRING "Ujik Diviner" FIXED
            ^"School Roles" LIST OF STRING ["Sage"]
            ^"Restricted To" STRING "Ujik culture (or GM exception)"
            ^"Starting Rings" STRING "+1 Void, +1 Water"
            ^"Starting Skills" STRING "Choose three: Command, Games, Meditation, Performance, Sentiment, Theology"
            ^"Starting Honor" INTEGER DEFAULT 40
            ^"Available Technique Groups" LIST OF STRING ["Earth and Water Invocations (invocation)", "Rituals (ritual)", "Shuji (shuji)"]
            ^"Starting Techniques" STRING "Invocations (choose two): Commune with Spirits, Embrace of Kenro-Ji-Jin, Caress of Earth, Jurojin's Balm, Wall of Earth; Invocations (choose two): Dance of Seasons, Heart of the Water Dragon, Dominion of Suijin, Innari's Blessing, Reflections of P'an Ku; Shuji: Ancestry Unearthed"
            ^"School Ability" STRING "Seer of the Lords of Death"
            ^"Mastery Ability" STRING "A Gift of Fate"
        }

        ^"Seer of the Lords of Death" DEF {
            # You can channel rituals in the same way as invocations.
            # Once per scene, when you channel you may receive
            # fatigue up to your school rank. If you do, you may
            # immediately make another check to perform an invocation
            # of the same element using the reserved dice from your
            # channel. For each fatigue received this way, you may add
            # one kept die set to an (op) result.
        }

        CURRICULUM {
            ^"Rank 1" {
                "Scholar" SKILL_GROUP
                "Games" SKILL
                "Meditation" SKILL
                "Survival" SKILL
                "Rank 1-2 Water Invocations (invocation)" TECH_GROUP
                "Divination (ritual)" TECHNIQUE
                "Fukurokujin's Wit (ritual)" TECHNIQUE
            }
            ^"Rank 2" {
                "Scholar" SKILL_GROUP
                "Fitness" SKILL
                "Meditation" SKILL
                "Performance" SKILL
                "Rank 1-3 Earth Invocations (invocation)" TECH_GROUP
                "Ebb and Flow (kata)" TECHNIQUE
                "Mask of Wind (invocation)" TECHNIQUE
            }
            ^"Rank 3" {
                "Trade" SKILL_GROUP
                "Composition" SKILL
                "Medicine" SKILL
                "Theology" SKILL
                "Rank 1-3 Shuji (shuji)" TECH_GROUP
                "Chaotic Scattering (kata)" TECHNIQUE
                "Vapor of Nightmares (invocation)" TECHNIQUE
            }
            ^"Rank 4" {
                "Scholar" SKILL_GROUP
                "Command" SKILL
                "Games" SKILL
                "Meditation" SKILL
                "Rank 1-5 Earth Invocations (invocation)" TECH_GROUP
                "Laughing Fox Style (kata)" TECHNIQUE
                "Mentor's Guidance (shuji)" TECHNIQUE
            }
            ^"Rank 5" {
                "Scholar" SKILL_GROUP
                "Fitness" SKILL
                "Meditation" SKILL
                "Performance" SKILL
                "Rank 1-5 Water Invocations (invocation)" TECH_GROUP
                "Roar of Encouragement (shuji)" TECHNIQUE
                "Bond of Heroes (shuji)" TECHNIQUE
            }
            ^"Rank 6" {
                "A Gift of Fate (Mastery Ability): Once per game session on your turn, you may choose one ritual for which you meet the prerequisites (does not need to be purchased). You may immediately perform that ritual as a single action instead of a downtime activity."
            }
        }

        RULES {
            #L5RPW37gH4iJ6kL8mN0oP2q: ujik_diviner_channel_rituals_as_invocations
        }
    }

    ^"Qamarist Shield Bearer Tradition" DEF {
        APPLIES TO [^"Samurai"]

        # Proud and formidable guards of the Qamarist Caliphate
        # who use advanced alchemical arts and imposing command
        # of shields, spears, and swords to control the battlefield.

        PROPERTIES {
            ^"School" STRING "Qamarist Shield Bearer Tradition" FIXED
            ^"School Roles" LIST OF STRING ["Bushi", "Sage"]
            ^"Restricted To" STRING "Qamarist culture (or GM exception)"
            ^"Starting Rings" STRING "+1 Earth, +1 Void"
            ^"Starting Skills" STRING "Choose five: Command, Fitness, Martial Arts [Melee], Martial Arts [Unarmed], Meditation, Tactics, Theology"
            ^"Starting Honor" INTEGER DEFAULT 50
            ^"Available Technique Groups" LIST OF STRING ["Close Combat and General Kata (kata)", "Rituals (ritual)", "Earth Shuji (shuji)"]
            ^"Starting Techniques" STRING "Kata: Crescent Moon Style; Shuji: Courtier's Resolve"
            ^"School Ability" STRING "Akilah's Teachings"
            ^"Mastery Ability" STRING "Fortitude of the Cradle"
        }

        ^"Akilah's Teachings" DEF {
            # Once per round after an Attack action check against
            # you fails, if you have a shield readied and the attack
            # is at range 0-1, you may shield bash. If you do, the
            # target suffers physical damage equal to your ranks in
            # Fitness plus your school rank.
        }

        CURRICULUM {
            ^"Rank 1" {
                "Martial" SKILL_GROUP
                "Command" SKILL
                "Government" SKILL
                "Theology" SKILL
                "Rank 1-2 Kata (kata)" TECH_GROUP
                "Divination (ritual)" TECHNIQUE
                "Wanderer's Resolve (shuji)" TECHNIQUE
            }
            ^"Rank 2" {
                "Martial" SKILL_GROUP
                "Command" SKILL
                "Government" SKILL
                "Smithing" SKILL
                "Rank 1-2 Rituals (ritual)" TECH_GROUP
                "Goading Taunt (shuji)" TECHNIQUE
                "Iron Shield Style (kata)" TECHNIQUE
            }
            ^"Rank 3" {
                "Scholar" SKILL_GROUP
                "Meditation" SKILL
                "Smithing" SKILL
                "Tactics" SKILL
                "Rank 1-3 Kata (kata)" TECH_GROUP
                "Deflective Defense (kata)" TECHNIQUE
                "Iron in the Mountains Style (kata)" TECHNIQUE
            }
            ^"Rank 4" {
                "Martial" SKILL_GROUP
                "Command" SKILL
                "Smithing" SKILL
                "Theology" SKILL
                "Rank 1-4 Kata (kata)" TECH_GROUP
                "Bonebreaker Style (kata)" TECHNIQUE
                "Mentor's Guidance (shuji)" TECHNIQUE
            }
            ^"Rank 5" {
                "Scholar" SKILL_GROUP
                "Martial Arts [Melee]" SKILL
                "Meditation" SKILL
                "Theology" SKILL
                "Rank 1-5 Kata (kata)" TECH_GROUP
                "Fortitude Draught (ritual)" TECHNIQUE
                "Bond of Heroes (shuji)" TECHNIQUE
            }
            ^"Rank 6" {
                "Fortitude of the Cradle (Mastery Ability): You may shield bash after you defend against damage, even if the check was successful. After you shield bash, your target must resist with a TN 4 Fitness (Air 3, Water 5) check or suffer the Disoriented and Prone conditions."
            }
        }

        RULES {
            #L5RPW38rS5tU7vW9xY1zA3b: shield_bearer_shield_bash_on_failed_attack
        }
    }

    ^"Qamarist Alchemist Tradition" DEF {
        APPLIES TO [^"Samurai"]

        # Gifted alchemists who research and experiment to
        # unlock secrets of creating elixirs, draughts, and
        # concoctions to enhance the human body.

        PROPERTIES {
            ^"School" STRING "Qamarist Alchemist Tradition" FIXED
            ^"School Roles" LIST OF STRING ["Sage"]
