EXTENSION "L5R5e_Path_of_Waves_Character" EXTENDS "L5R5e_Core_Character" {
    NAME "Legend of the Five Rings 5th Edition - Path of Waves: Character Creation"
    VERSION "0.1"
    RELEASE_DATE "2025-06-01"

    # Path of Waves (Chapter 2): A revised Game of Twenty Questions
    # for ronin, peasant, and gaijin characters. Replaces clan/family
    # with region/upbringing. Replaces giri with "past". Introduces
    # new schools, advantages, disadvantages, and gaijin cultures.
    # This extension supplements and partially overrides the core
    # character creation system to support non-samurai PCs.

    # ===========================
    # REVISED TWENTY QUESTIONS
    # ===========================

    # The Path of Waves twenty questions replace the core
    # rulebook's twenty questions for ronin, peasant, and
    # gaijin characters. Key differences:
    # - Question 1 uses Region instead of Clan
    # - Question 2 uses Upbringing instead of Family
    # - Question 3 uses new school options
    # - Giri is replaced by Past (Question 10)
    # - Ninjo remains but may be reframed
    # - Heritage table is replaced (Question 17)
    # - Status starts lower (ronin 24, peasant 15, gaijin 0)
    # - Glory represents personal reputation, not Bushido adherence

    ^"Path of Waves Character Creation" DEF {
        APPLIES TO [^"Samurai"]

        # Limits: rings and skills have a maximum rank of 3
        # during character creation. Starting values: 1 rank
        # in each ring, 0 ranks in each skill.

        RULES {
            #L5RPW01aB2cD4eF6gH8iJ0k: pow_rings_max_3_during_creation
            #L5RPW02lM3nO5pQ7rS9tU1v: pow_skills_max_3_during_creation
            #L5RPW03wX4yZ6aB8cD0eF2g: pow_ronin_base_status_24
            #L5RPW04hI5jK7lM9nO1pQ3r: pow_peasant_base_status_15
            #L5RPW05sT6uV8wX0yZ2aB4c: pow_gaijin_base_status_0
            #L5RPW06dE7fG9hI1jK3lM5n: pow_giri_replaced_by_past
            #L5RPW07oP8qR0sT2uV4wX6y: pow_glory_represents_personal_reputation
        }
    }

    # ===========================
    # QUESTION 1: REGIONS
    # ===========================

    ^"Urban Region" DEF {
        APPLIES TO [^"Samurai"]

        # Cities are places where trade flourishes, cultures meet,
        # and many different types of people mix and mingle.

        PROPERTIES {
            ^"Region" STRING "Urban" FIXED
            ^"Ring Increase" STRING "+1 Air"
            ^"Skill Increase" STRING "+1 Commerce"
            ^"Glory" INTEGER DEFAULT 29
        }

        RULES {
            #L5RPW08zA9bC1dE3fG5hI7j: urban_political_awareness
            #L5RPW09kL0mN2oP4qR6sT8u: urban_cosmopolitan_connections
        }
    }

    ^"Rural Farmland Region" DEF {
        APPLIES TO [^"Samurai"]

        # Food is the core of any prosperous civilization.
        # Farmers tame the land and carry the weight of
        # civilization on their backs.

        PROPERTIES {
            ^"Region" STRING "Rural Farmland" FIXED
            ^"Ring Increase" STRING "+1 Earth"
            ^"Skill Increase" STRING "+1 Fitness"
            ^"Glory" INTEGER DEFAULT 34
        }

        RULES {
            #L5RPW10vW1xY3zA5bC7dE9f: rural_oral_tradition
            #L5RPW11gH2iJ4kL6mN8oP0q: rural_agricultural_knowledge
        }
    }

    ^"Sea River or Lake Region" DEF {
        APPLIES TO [^"Samurai"]

        # The sea provides and takes away in equal measure.
        # Water has strong ties to trade and travel.

        PROPERTIES {
            ^"Region" STRING "Sea, River, or Lake" FIXED
            ^"Ring Increase" STRING "+1 Water"
            ^"Skill Increase" STRING "+1 Seafaring"
            ^"Glory" INTEGER DEFAULT 32
        }

        RULES {
            #L5RPW12rS3tU5vW7xY9zA1b: sea_trade_route_awareness
            #L5RPW13cD4eF6gH8iJ0kL2m: sea_water_survival_skills
        }
    }

    ^"Forest Region" DEF {
        APPLIES TO [^"Samurai"]

        # Forests are wildernesses with trees more ancient
        # than Rokugan itself. Those who live among the trees
        # absorb a bit of that wildness into themselves.

        PROPERTIES {
            ^"Region" STRING "Forest" FIXED
            ^"Ring Increase" STRING "+1 Earth"
            ^"Skill Increase" STRING "+1 Survival"
            ^"Glory" INTEGER DEFAULT 30
        }

        RULES {
            #L5RPW14nO5pQ7rS9tU1vW3x: forest_navigation_instincts
            #L5RPW15yZ6aB8cD0eF2gH4i: forest_foraging_hunting_knowledge
        }
    }

    ^"Mountain Region" DEF {
        APPLIES TO [^"Samurai"]

        # In the mountains, the peaks reach to the Heavens.
        # This environment is perfect for monks and those
        # seeking Enlightenment.

        PROPERTIES {
            ^"Region" STRING "Mountain" FIXED
            ^"Ring Increase" STRING "+1 Void"
            ^"Skill Increase" STRING "+1 Meditation"
            ^"Glory" INTEGER DEFAULT 33
        }

        RULES {
            #L5RPW16jK7lM9nO1pQ3rS5t: mountain_trail_pilgrimage_knowledge
            #L5RPW17uV8wX0yZ2aB4cD6e: mountain_extreme_survival
        }
    }

    ^"Haunted Region" DEF {
        APPLIES TO [^"Samurai"]

        # Lands affected by the Taint or otherwise desecrated
        # by foul acts. Those who hail from such regions view
        # the world as a much more dangerous place.

        PROPERTIES {
            ^"Region" STRING "Haunted" FIXED
            ^"Ring Increase" STRING "+1 Fire"
            ^"Skill Increase" STRING "+1 Command"
            ^"Glory" INTEGER DEFAULT 28
        }

        RULES {
            #L5RPW18fG9hI1jK3lM5nO7p: haunted_taint_recognition
            #L5RPW19qR0sT2uV4wX6yZ8a: haunted_pragmatism_against_supernatural
        }
    }

    # ===========================
    # GAIJIN REGIONAL OPTIONS
    # ===========================

    # Gaijin begin with status 0 in Rokugan. They also
    # have a second status value reflecting standing in
    # their homeland, determined with GM during creation.

    ^"Ujik of the Plains of Wind and Stone" DEF {
        APPLIES TO [^"Samurai"]

        # The Ujik are a nomadic people living on expansive
        # grassy plains north and west of Rokugan. They are
        # supreme horsemen; Ujik begin play with a Unicorn
        # warhorse.

        PROPERTIES {
            ^"Region" STRING "Ujik (Plains of Wind and Stone)" FIXED
            ^"Culture" STRING "Gaijin - Ujik"
            ^"Ring Increase" STRING "+1 Water"
            ^"Skill Increase" STRING "+1 Survival"
            ^"Glory" INTEGER DEFAULT 30
            ^"Starting Equipment Note" STRING "Ujik begin play with a Unicorn warhorse"
        }

        RULES {
            #L5RPW20bC1dE3fG5hI7jK9l: ujik_expert_horsemen
            #L5RPW21mN2oP4qR6sT8uV0w: ujik_lords_of_death_religion
        }
    }

    ^"Qamarists in the Cradle of the World" DEF {
        APPLIES TO [^"Samurai"]

        # The Qamarist Caliphate is a powerful nation-state
        # far to the west, thriving in fertile land between two
        # great rivers. They practice a monotheistic religion
        # and possess advanced alchemical knowledge.

        PROPERTIES {
            ^"Region" STRING "Qamarist (Cradle of the World)" FIXED
            ^"Culture" STRING "Gaijin - Qamarist"
            ^"Ring Increase" STRING "+1 Fire"
            ^"Skill Increase" STRING "+1 Theology"
            ^"Glory" INTEGER DEFAULT 29
        }

        RULES {
            #L5RPW22xY3zA5bC7dE9fG1h: qamarist_monotheistic_caliphate
            #L5RPW23iJ4kL6mN8oP0qR2s: qamarist_alchemical_knowledge
        }
    }

    ^"Yodha of the Ghostlands" DEF {
        APPLIES TO [^"Samurai"]

        # Warriors from the Ivory Kingdoms who wage a
        # never-ending struggle against evil forces in the
        # Ghostlands (the western Shadowlands). They use
        # gold and coral against Tainted beings.

        PROPERTIES {
            ^"Region" STRING "Yodha (Ghostlands)" FIXED
            ^"Culture" STRING "Gaijin - Ivory Kingdoms"
            ^"Ring Increase" STRING "+1 Earth"
            ^"Skill Increase" STRING "+1 Theology"
            ^"Glory" INTEGER DEFAULT 29
        }

        RULES {
            #L5RPW24tU5vW7xY9zA1bC3d: yodha_ghostlands_shadowlands_fighters
            #L5RPW25eF6gH8iJ0kL2mN4o: yodha_gold_coral_against_taint
        }
    }

    ^"Sheelavaan of Bhavyatapura" DEF {
        APPLIES TO [^"Samurai"]

        # The people of the City of Splendor in the central
        # Ivory Kingdoms. Sophisticated, gregarious, eloquent,
        # and skilled at bargaining through complex economies.

        PROPERTIES {
            ^"Region" STRING "Sheelavaan (Bhavyatapura)" FIXED
            ^"Culture" STRING "Gaijin - Ivory Kingdoms"
            ^"Ring Increase" STRING "+1 Air"
            ^"Skill Increase" STRING "+1 Courtesy"
            ^"Glory" INTEGER DEFAULT 28
        }

        RULES {
            #L5RPW26pQ7rS9tU1vW3xY5z: sheelavaan_urban_sophistication
            #L5RPW27aB8cD0eF2gH4iJ6k: sheelavaan_trade_and_languages
        }
    }

    # ===========================
    # QUESTION 2: UPBRINGINGS
    # ===========================

    ^"Craftsperson Upbringing" DEF {
        APPLIES TO [^"Samurai"]

        PROPERTIES {
            ^"Upbringing" STRING "Craftsperson" FIXED
            ^"Ring Increase" STRING "+1 Earth or +1 Void"
            ^"Skill Increases" STRING "+1 Culture, +1 Design"
            ^"Status Modification" INTEGER -2
            ^"Starting Wealth" STRING "1 koku"
        }
    }

    ^"Fallen Noble Upbringing" DEF {
        APPLIES TO [^"Samurai"]

        # A fallen noble may use ring and skill increases
        # based on their chosen clan, or +1 to any ring and
        # +1 to any two skills. Begins with a wakizashi or
        # gaijin equivalent.

        PROPERTIES {
            ^"Upbringing" STRING "Fallen Noble" FIXED
            ^"Ring Increase" STRING "+1 to any ring, or based on chosen clan"
            ^"Skill Increases" STRING "+1 to any two skills, or based on chosen clan"
            ^"Status Modification" INTEGER 10
            ^"Starting Wealth" STRING "An heirloom worth 3 koku, wakizashi (or gaijin equivalent)"
        }
    }

    ^"Farmer Upbringing" DEF {
        APPLIES TO [^"Samurai"]

        PROPERTIES {
            ^"Upbringing" STRING "Farmer" FIXED
            ^"Ring Increase" STRING "+1 Earth or +1 Water"
            ^"Skill Increases" STRING "+1 Labor, +1 Fitness"
            ^"Status Modification" INTEGER 4
            ^"Starting Wealth" STRING "2 bu"
        }
    }

    ^"Geisha House Upbringing" DEF {
        APPLIES TO [^"Samurai"]

        PROPERTIES {
            ^"Upbringing" STRING "Geisha House" FIXED
            ^"Ring Increase" STRING "+1 Air or +1 Fire"
            ^"Skill Increases" STRING "+1 Aesthetics, +1 Courtesy"
            ^"Status Modification" INTEGER -20
            ^"Starting Wealth" STRING "3 koku"
        }
    }

    ^"Hinin Upbringing" DEF {
        APPLIES TO [^"Samurai"]

        PROPERTIES {
            ^"Upbringing" STRING "Hinin" FIXED
            ^"Ring Increase" STRING "+1 Water or +1 Void"
            ^"Skill Increases" STRING "+2 Labor, +1 Survival"
            ^"Status Modification" INTEGER -20
            ^"Starting Wealth" STRING "5 zeni"
        }
    }

    ^"Hunter or Fisher Upbringing" DEF {
        APPLIES TO [^"Samurai"]

        PROPERTIES {
            ^"Upbringing" STRING "Hunter or Fisher" FIXED
            ^"Ring Increase" STRING "+1 Earth or +1 Water"
            ^"Skill Increases" STRING "+1 Labor, and +1 Seafaring or +1 Survival"
            ^"Status Modification" INTEGER 3
            ^"Starting Wealth" STRING "4 bu"
        }
    }

    ^"Law Enforcement Upbringing" DEF {
        APPLIES TO [^"Samurai"]

        PROPERTIES {
            ^"Upbringing" STRING "Law Enforcement" FIXED
            ^"Ring Increase" STRING "+1 Earth or +1 Air"
            ^"Skill Increases" STRING "+1 Government, +1 Command"
            ^"Status Modification" INTEGER 5
            ^"Starting Wealth" STRING "1 koku"
        }
    }

    ^"Military Upbringing" DEF {
        APPLIES TO [^"Samurai"]

        PROPERTIES {
            ^"Upbringing" STRING "Military" FIXED
            ^"Ring Increase" STRING "+1 Earth or +1 Fire"
            ^"Skill Increases" STRING "+1 Command, +1 Government"
            ^"Status Modification" INTEGER 5
            ^"Starting Wealth" STRING "1 koku"
        }
    }

    ^"Ronin Family Upbringing" DEF {
        APPLIES TO [^"Samurai"]

        PROPERTIES {
            ^"Upbringing" STRING "Ronin Family" FIXED
            ^"Ring Increase" STRING "+1 to any one ring"
            ^"Skill Increases" STRING "+1 Courtesy, +1 Martial Arts [Melee]"
            ^"Status Modification" INTEGER 2
            ^"Starting Wealth" STRING "1 koku"
        }
    }

    ^"Organized Crime Upbringing" DEF {
        APPLIES TO [^"Samurai"]

        PROPERTIES {
            ^"Upbringing" STRING "Organized Crime" FIXED
            ^"Ring Increase" STRING "+1 Air or +1 Water"
            ^"Skill Increases" STRING "+1 Skulduggery, +1 Games"
            ^"Status Modification" INTEGER -8
            ^"Starting Wealth" STRING "3 koku"
        }
    }

    ^"Street Urchin Upbringing" DEF {
        APPLIES TO [^"Samurai"]

        PROPERTIES {
            ^"Upbringing" STRING "Street Urchin" FIXED
            ^"Ring Increase" STRING "+1 Air or +1 Fire"
            ^"Skill Increases" STRING "+2 Skulduggery"
            ^"Status Modification" INTEGER -7
            ^"Starting Wealth" STRING "4 bu"
        }
    }

    ^"Temple Upbringing" DEF {
        APPLIES TO [^"Samurai"]

        PROPERTIES {
            ^"Upbringing" STRING "Temple" FIXED
            ^"Ring Increase" STRING "+1 Void or +1 Air"
            ^"Skill Increases" STRING "+1 Theology, +1 Courtesy"
            ^"Status Modification" INTEGER 11
            ^"Starting Wealth" STRING "One day's rations"
        }
    }

    ^"Tradesperson Upbringing" DEF {
        APPLIES TO [^"Samurai"]

        PROPERTIES {
            ^"Upbringing" STRING "Tradesperson" FIXED
            ^"Ring Increase" STRING "+1 Air or +1 Water"
            ^"Skill Increases" STRING "+1 Commerce, +1 Aesthetics"
            ^"Status Modification" INTEGER -6
            ^"Starting Wealth" STRING "2 koku"
        }
    }

    # ===========================
    # NEW SCHOOLS
    # ===========================

    ^"Wandering Blade School" DEF {
        APPLIES TO [^"Samurai"]

        # Warriors who have honed their skill with a signature
        # weapon. Their power and skill rival the training of
        # even samurai of the Great Clans.

        PROPERTIES {
            ^"School" STRING "Wandering Blade" FIXED
            ^"School Roles" LIST OF STRING ["Bushi"]
            ^"Starting Rings" STRING "+1 Earth, +1 any other ring"
            ^"Starting Skills" STRING "Choose five: Fitness, Martial Arts [Melee], Martial Arts [Ranged], Martial Arts [Unarmed], Meditation, Performance, Smithing"
            ^"Starting Honor" INTEGER DEFAULT 35
            ^"Available Technique Groups" LIST OF STRING ["Kata (kata)", "Rituals (ritual)", "Shuji (shuji)"]
            ^"Starting Techniques" STRING "Kata (choose one): Striking as Air, Striking as Earth, Striking as Water, Striking as Fire; Shuji: Wanderer's Resolve"
            ^"School Ability" STRING "Signature Weapon"
            ^"Mastery Ability" STRING "Unseen Blade"
        }

        ^"Signature Weapon" DEF {
            # Choose a signature weapon category (or unarmed) with
            # GM approval. When using a weapon from this category
            # for an Attack action or Performance check, roll one
            # additional skill die. Additionally, when making such a
            # check you may suffer fatigue up to your school rank to
            # alter that many results of your kept dice to (op) results.
        }

        CURRICULUM {
            ^"Rank 1" {
                "Martial" SKILL_GROUP
                "Commerce" SKILL
                "Medicine" SKILL
                "Sentiment" SKILL
                "Rank 1 Kata (kata)" TECH_GROUP
                "Bellow of Resolve (shuji)" TECHNIQUE
                "Tactical Assessment (shuji)" TECHNIQUE
            }
            ^"Rank 2" {
                "Martial" SKILL_GROUP
                "Courtesy" SKILL
                "Smithing" SKILL
                "Survival" SKILL
                "Rank 1-2 Kata (kata)" TECH_GROUP
                "Rushing Ox Style (kata)" TECHNIQUE
                "Wayfarer's Path (shuji)" TECHNIQUE
            }
            ^"Rank 3" {
                "Trade" SKILL_GROUP
                "Command" SKILL
                "Culture" SKILL
                "Meditation" SKILL
                "Rank 1-3 Kata (kata)" TECH_GROUP
                "Iron in the Mountains Style (kata)" TECHNIQUE
                "Tonight, I Am Your Opponent (shuji)" TECHNIQUE
            }
            ^"Rank 4" {
                "Martial" SKILL_GROUP
                "Games" SKILL
                "Performance" SKILL
                "Seafaring" SKILL
                "Rank 1-4 Kata (kata)" TECH_GROUP
                "Bravado (shuji)" TECHNIQUE
                "Void's Embrace Style (kata)" TECHNIQUE
            }
            ^"Rank 5" {
                "Martial" SKILL_GROUP
                "Command" SKILL
                "Courtesy" SKILL
                "Sentiment" SKILL
                "Rank 1-5 Kata (kata)" TECH_GROUP
                "Bond of Heroes (shuji)" TECHNIQUE
                "Roar of Encouragement (shuji)" TECHNIQUE
            }
            ^"Rank 6" {
                "Unseen Blade (Mastery Ability): When you perform an Attack action, you may spend (op)+ as follows: Choose a character in range of the weapon you used with vigilance lower than your original target. If you succeed, that character suffers physical damage equal to your weapon's base damage plus your ranks in Fitness."
            }
        }

        RULES {
            #L5RPW28lM9nO1pQ3rS5tU7v: wandering_blade_signature_weapon_extra_die
            #L5RPW29wX0yZ2aB4cD6eF8g: wandering_blade_fatigue_for_opportunity
        }
    }

    ^"Student of the Talon School" DEF {
        APPLIES TO [^"Samurai"]

        # Adept at landing critical blows from distance with
        # spears, bows, or other ranged weapons. Precision
        # reminiscent of a viper's bite.

        PROPERTIES {
            ^"School" STRING "Student of the Talon" FIXED
            ^"School Roles" LIST OF STRING ["Bushi", "Shinobi"]
            ^"Starting Rings" STRING "+1 Air, +1 Water"
            ^"Starting Skills" STRING "Choose five: Fitness, Martial Arts [Melee], Martial Arts [Ranged], Meditation, Sentiment, Skulduggery, Survival"
            ^"Starting Honor" INTEGER DEFAULT 30
            ^"Available Technique Groups" LIST OF STRING ["Kata (kata)", "Rituals (ritual)", "Shuji (shuji)"]
            ^"Starting Techniques" STRING "Kata (choose one): Soaring Slice or Hawk's Precision; Ninjutsu: = Skulk"
            ^"School Ability" STRING "Piercing Insight"
            ^"Mastery Ability" STRING "Lesson of the Hawk"
        }

        ^"Piercing Insight" DEF {
            # Once per round, in a skirmish, when you inflict a
            # critical strike on a character at range 2-5 or a character
            # at range 2-5 inflicts a critical strike on you, you may
            # increase or decrease the severity by your school rank.
        }

        CURRICULUM {
            ^"Rank 1" {
                "Martial" SKILL_GROUP
                "Commerce" SKILL
                "Courtesy" SKILL
                "Survival" SKILL
                "Rank 1 Kata (kata)" TECH_GROUP
                "Flowering Deceptions (shuji)" TECHNIQUE
                "Chaotic Scattering (kata)" TECHNIQUE
            }
            ^"Rank 2" {
                "Martial" SKILL_GROUP
                "Medicine" SKILL
                "Sentiment" SKILL
                "Skulduggery" SKILL
                "Rank 1-2 Kata (kata)" TECH_GROUP
                "Heartpiercing Strike (kata)" TECHNIQUE
                "Swirling Viper Style (kata)" TECHNIQUE
            }
            ^"Rank 3" {
                "Social" SKILL_GROUP
                "Martial Arts [Melee]" SKILL
                "Martial Arts [Ranged]" SKILL
                "Skulduggery" SKILL
                "Rank 1-3 Kata (kata)" TECH_GROUP
                "Wasp's Spite Style (kata)" TECHNIQUE
                "Eyeless Sight Shot (kata)" TECHNIQUE
            }
            ^"Rank 4" {
                "Martial" SKILL_GROUP
                "Courtesy" SKILL
                "Medicine" SKILL
                "Sentiment" SKILL
                "Rank 1-4 Kata (kata)" TECH_GROUP
                "Wolf's Proposal (shuji)" TECHNIQUE
                "Falling Heavens Shot (kata)" TECHNIQUE
            }
            ^"Rank 5" {
                "Martial" SKILL_GROUP
                "Command" SKILL
                "Medicine" SKILL
                "Skulduggery" SKILL
                "Rank 1-5 Kata (kata)" TECH_GROUP
                "Deadly Sting (ninjutsu)" TECHNIQUE
                "Watch My Back (shuji)" TECHNIQUE
            }
            ^"Rank 6" {
                "Lesson of the Hawk (Mastery Ability): Once per scene, when performing an Attack action check, you may spend 1 Void Point to have your target treat their physical resistance as 0."
            }
        }

        RULES {
            #L5RPW30hI1jK3lM5nO7pQ9r: talon_critical_strike_severity_control
        }
    }

    ^"Treasure Hunter School" DEF {
        APPLIES TO [^"Samurai"]

        # Roguish smooth talkers adept at dodging dangerous
        # situations. Quick thinking and a discerning eye for
        # untold riches from the ancient past and dangerous present.

        PROPERTIES {
            ^"School" STRING "Treasure Hunter" FIXED
            ^"School Roles" LIST OF STRING ["Courtier", "Bushi"]
            ^"Starting Rings" STRING "+1 Air, +1 Water"
            ^"Starting Skills" STRING "Choose five: Commerce, Courtesy, Fitness, Games, Martial Arts [Melee], Sentiment, Skulduggery"
            ^"Starting Honor" INTEGER DEFAULT 27
            ^"Available Technique Groups" LIST OF STRING ["Kata (kata)", "Rituals (ritual)", "Shuji (shuji)"]
            ^"Starting Techniques" STRING "Kata: = Tactical Assessment; Shuji (choose one): All in Jest or Rustling of Leaves"
            ^"School Ability" STRING "Risk and Reward"
            ^"Mastery Ability" STRING "All Part of the Plan"
        }

        ^"Risk and Reward" DEF {
            # You have an uncanny sense for dangerous situations.
            # Your vigilance and focus are increased by your school
            # rank, unless you are Compromised.
        }

        CURRICULUM {
            ^"Rank 1" {
                "Social" SKILL_GROUP
                "Commerce" SKILL
                "Martial Arts [Melee]" SKILL
                "Skulduggery" SKILL
                "Rank 1 Shuji (shuji)" TECH_GROUP
                "Striking as Air (kata)" TECHNIQUE
                "Chaotic Scattering (kata)" TECHNIQUE
            }
            ^"Rank 2" {
                "Martial" SKILL_GROUP
                "Command" SKILL
                "Courtesy" SKILL
                "Sentiment" SKILL
                "Rank 1-2 Air Shuji (shuji)" TECH_GROUP
                "Daring Swing (kata)" TECHNIQUE
                "Reckless Lunge (kata)" TECHNIQUE
            }
            ^"Rank 3" {
                "Social" SKILL_GROUP
                "Commerce" SKILL
                "Martial Arts [Melee]" SKILL
                "Seafaring" SKILL
                "Rank 1-3 Water Shuji (shuji)" TECH_GROUP
                "Dazzling Performance (shuji)" TECHNIQUE
                "Laughing Fox Style (kata)" TECHNIQUE
            }
            ^"Rank 4" {
                "Trade" SKILL_GROUP
                "Courtesy" SKILL
                "Martial Arts [Melee]" SKILL
                "Sentiment" SKILL
                "Rank 1-4 Kata (kata)" TECH_GROUP
                "Regal Bearing (shuji)" TECHNIQUE
                "Ruse of Moon's Reflection (kata)" TECHNIQUE
            }
            ^"Rank 5" {
                "Martial" SKILL_GROUP
                "Command" SKILL
                "Courtesy" SKILL
                "Skulduggery" SKILL
                "Rank 1-5 Air Shuji (shuji)" TECH_GROUP
                "Watch My Back (shuji)" TECHNIQUE
                "Roar of Encouragement (shuji)" TECHNIQUE
            }
            ^"Rank 6" {
                "All Part of the Plan (Mastery Ability): Once per scene when you make a check to resist, you may spend 1 Void Point to automatically succeed. If you do, you may immediately perform an action."
            }
        }

        RULES {
            #L5RPW31sT2uV4wX6yZ8aB0c: treasure_hunter_vigilance_focus_increase
        }
    }

    ^"School of Leaves" DEF {
        APPLIES TO [^"Samurai"]

        # Outcasts who have become precisely what society
        # deems them: those who slink about the shadows,
        # sowing chaos and striking with blade, bow, or word.

        PROPERTIES {
            ^"School" STRING "School of Leaves" FIXED
            ^"School Roles" LIST OF STRING ["Shinobi", "Courtier"]
            ^"Starting Rings" STRING "+1 Fire, +1 Air"
            ^"Starting Skills" STRING "Choose five: Fitness, Martial Arts [Melee], Martial Arts [Ranged], Performance, Sentiment, Skulduggery, Survival"
            ^"Starting Honor" INTEGER DEFAULT 26
            ^"Available Technique Groups" LIST OF STRING ["Kata (kata)", "Rituals (ritual)", "Shuji (shuji)"]
            ^"Starting Techniques" STRING "Shuji (choose one): Honest Assessment or Whispers of Court; Ninjutsu: = Skulk, = Deadly Sting"
            ^"School Ability" STRING "Tactical Cover"
            ^"Mastery Ability" STRING "Crack Not a Single Twig"
        }

        ^"Tactical Cover" DEF {
            # While you are in Obscuring terrain, you may treat
            # your physical resistance as increased by your school rank.
        }

        CURRICULUM {
            ^"Rank 1" {
                "Martial" SKILL_GROUP
                "Courtesy" SKILL
                "Performance" SKILL
                "Skulduggery" SKILL
                "Rank 1 Kata (kata)" TECH_GROUP
                "Prey on the Weak (ninjutsu)" TECHNIQUE
                "Rustling of Leaves (shuji)" TECHNIQUE
            }
            ^"Rank 2" {
                "Trade" SKILL_GROUP
                "Courtesy" SKILL
                "Games" SKILL
                "Government" SKILL
                "Rank 1-2 Air Shuji (shuji)" TECH_GROUP
                "Staggering Shot (kata)" TECHNIQUE
                "Crimson Leaves Strike (kata)" TECHNIQUE
            }
            ^"Rank 3" {
                "Social" SKILL_GROUP
                "Martial Arts [Melee]" SKILL
                "Martial Arts [Ranged]" SKILL
                "Sentiment" SKILL
                "Rank 1-3 Kata (kata)" TECH_GROUP
                "Noxious Cloud (ninjutsu)" TECHNIQUE
                "Wasp's Spite Style (kata)" TECHNIQUE
            }
            ^"Rank 4" {
                "Martial" SKILL_GROUP
                "Government" SKILL
                "Sentiment" SKILL
                "Skulduggery" SKILL
                "Rank 1-4 Fire Shuji (shuji)" TECH_GROUP
                "Iaijutsu Cut: Reverse Draw (kata)" TECHNIQUE
                "Ruse of Moon's Reflection (kata)" TECHNIQUE
            }
            ^"Rank 5" {
                "Martial" SKILL_GROUP
                "Culture" SKILL
                "Performance" SKILL
                "Sentiment" SKILL
                "Rank 1-5 Kata (kata)" TECH_GROUP
                "Bend with the Storm (shuji)" TECHNIQUE
                "Silencing Stroke (ninjutsu)" TECHNIQUE
            }
            ^"Rank 6" {
                "Crack Not a Single Twig (Mastery Ability): At the start of a scene, you may choose any number of mundane terrain effects. You ignore the effects of these terrain qualities. (Other characters do not ignore them when making checks against you.) This effect persists until the end of the scene."
            }
        }

        RULES {
            #L5RPW32dE3fG5hI7jK9lM1n: school_of_leaves_obscuring_terrain_resistance
        }
    }

    ^"Voice of the Wilds School" DEF {
        APPLIES TO [^"Samurai"]

        # Shugenja who have received no formal training but
        # have developed a knack for building positive
        # relationships with the kami around them.

        PROPERTIES {
            ^"School" STRING "Voice of the Wilds" FIXED
            ^"School Roles" LIST OF STRING ["Shugenja", "Courtier"]
            ^"Starting Rings" STRING "+1 to any two different rings"
            ^"Starting Skills" STRING "Choose three: Composition, Courtesy, Games, Meditation, Sentiment, Theology"
            ^"Starting Honor" INTEGER DEFAULT 35
            ^"Available Technique Groups" LIST OF STRING ["Rituals (ritual)", "Shuji (shuji)"]
            ^"Starting Techniques" STRING "Invocations (choose one): Commune with Spirits or Divination; Shuji (choose two): Well of Desire, Weight of Duty, Rustling of Leaves, Sensational Distraction"
            ^"School Ability" STRING "Naturally Attuned"
            ^"Mastery Ability" STRING "Elemental Charmer"
        }

        ^"Naturally Attuned" DEF {
            # As a downtime activity, you may select any number
            # of invocations with total school rank prerequisites
            # equal to double your school rank. You can perform
            # these invocations as if you knew them.
            # While making a check to activate an invocation, if you
            # become Compromised, you suffer spiritual backlash.
        }

        CURRICULUM {
            ^"Rank 1" {
                "Trade" SKILL_GROUP
                "Composition" SKILL
                "Courtesy" SKILL
                "Medicine" SKILL
                "Rank 1 Shuji (shuji)" TECH_GROUP
                "Nature's Touch (ritual)" TECHNIQUE
                "Threshold Barrier (ritual)" TECHNIQUE
            }
            ^"Rank 2" {
                "Trade" SKILL_GROUP
                "Medicine" SKILL
                "Meditation" SKILL
                "Theology" SKILL
                "Rank 1-2 Shuji (shuji)" TECH_GROUP
                "Earth Becomes Sky (invocation)" TECHNIQUE
                "Tactical Assessment (shuji)" TECHNIQUE
            }
            ^"Rank 3" {
                "Social" SKILL_GROUP
                "Composition" SKILL
                "Sentiment" SKILL
                "Theology" SKILL
                "Rank 1-3 Shuji (shuji)" TECH_GROUP
                "Fury of Osano-wo (invocation)" TECHNIQUE
                "Hands of the Tides (invocation)" TECHNIQUE
            }
            ^"Rank 4" {
                "Social" SKILL_GROUP
                "Sentiment" SKILL
                "Survival" SKILL
                "Theology" SKILL
                "Rank 1-2 Invocations (invocation)" TECH_GROUP
                "Mentor's Guidance (shuji)" TECHNIQUE
                "False Realm of the Fox Spirits (invocation)" TECHNIQUE
            }
            ^"Rank 5" {
                "Scholar" SKILL_GROUP
                "Courtesy" SKILL
                "Meditation" SKILL
                "Performance" SKILL
                "Rank 1-5 Shuji (shuji)" TECH_GROUP
                "Rank 1-3 Invocations (invocation)" TECH_GROUP
                "Ever-Changing Waves (invocation)" TECHNIQUE
            }
            ^"Rank 6" {
                "Elemental Charmer (Mastery Ability): You may importune invocations without making an offering."
            }
        }

        RULES {
            #L5RPW33oP2qR4sT6uV8wX0y: voice_of_wilds_naturally_attuned_downtime
            #L5RPW34zA1bC3dE5fG7hI9j: voice_of_wilds_spiritual_backlash_on_compromised
        }
    }

    ^"Artisan of the Roads School" DEF {
        APPLIES TO [^"Samurai"]

        # Adept at scrounging suitable materials in almost any
        # circumstance, using surroundings as inspiration to
        # create inventive art from everyday items.

        PROPERTIES {
            ^"School" STRING "Artisan of the Roads" FIXED
            ^"School Roles" LIST OF STRING ["Artisan"]
            ^"Starting Rings" STRING "+1 Fire, +1 to any other ring"
            ^"Starting Skills" STRING "Choose five: Aesthetics, Courtesy, Commerce, Composition, Culture, Design, Smithing"
            ^"Starting Honor" INTEGER DEFAULT 30
            ^"Available Technique Groups" LIST OF STRING ["Kata (kata)", "Rituals (ritual)", "Shuji (shuji)"]
            ^"Starting Techniques" STRING "Shuji (choose one): Shallow Waters or Whispers of Court; Shuji: Fanning the Flames"
            ^"School Ability" STRING "Resourceful Artistry"
            ^"Mastery Ability" STRING "Surge of Brilliance"
        }

        ^"Resourceful Artistry" DEF {
            # Once per game session when performing a downtime
            # activity to craft, you may scavenge supplies for your
            # craft worth an amount of koku equal to your school rank.
        }

        CURRICULUM {
