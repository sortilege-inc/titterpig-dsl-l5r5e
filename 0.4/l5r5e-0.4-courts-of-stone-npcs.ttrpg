            ^"Composure" INTEGER 16
            ^"Focus" INTEGER 8
            ^"Vigilance" INTEGER 4
            ^"Honor" INTEGER 65
            ^"Glory" INTEGER 55
            ^"Status" INTEGER 45
            ^"Skills" LIST OF STRING ["Artisan 2", "Martial 0", "Scholar 4", "Social 4", "Trade 0"]
            ^"Advantages" LIST OF STRING ["Incisive Scrutiny (Air) [Social; Mental, Interpersonal]", "Perfect Recollection (Earth) [Scholar; Mental]"]
            ^"Disadvantages" LIST OF STRING ["Easily Scandalized (Earth) [Social; Interpersonal]"]
            ^"Favored Weapons" LIST OF STRING ["Wakizashi: Range 0-1, Damage 3, Deadliness 5/7, Ceremonial, Razor-Edged"]
            ^"Gear" LIST OF STRING ["Sublime robes (Physical 1, Ceremonial, Resplendent)", "Calligraphy set", "Folding fan"]
        }

        ^"Protocol and Procedure" DEF {
            ^"Description" STRING "Once per round, when another character succeeds on a check to pursue a social objective, a Kyuden Doji courtier may receive up to 4 strife to reduce the number of bonus successes on that check by that amount, to a minimum of 0 bonus successes (the check still succeeds)."
        }

        ^"Tactful Recovery" DEF {
            ^"Description" STRING "Once per Intrigue scene, a Kyuden Doji courtier may change their social objective to another social objective they could complete during the scene. They may transfer up to half of their current momentum points to this new social objective."
        }

        RULES {
            #L5RCS09sT9uV1wX3yZ5aB7cD: kyuden_doji_courtier
        }
    }

    # source stat block (page 50)
    ^"Kakita Ryoku, Elder Crane" DEF {
        EXTENDS ^"NPC"

        # Among the most distinguished and dangerous individuals
        # one is likely to meet in Kyuden Doji. Her novel, Winter,
        # has instructed entire generations of courtiers. Former
        # Imperial Advisor to Emperor Hantei XXXVIII. Now returned
        # to Kyuden Doji to continue weaving webs of intrigue,
        # gossip, and influence. Her age has only made her more
        # elegant and dignified.

        PROPERTIES {
            ^"Type" STRING "Adversary" FIXED
            ^"Combat Conflict Rank" INTEGER 3
            ^"Intrigue Conflict Rank" INTEGER 9
            ^"Rings" DEF {
                ^"Air" INTEGER 5
                ^"Earth" INTEGER 2
                ^"Fire" INTEGER 3
                ^"Water" INTEGER 4
                ^"Void" INTEGER 3
            }
            ^"Demeanor" STRING "Intimidating"
            ^"Social Skill Check TN Modifiers" STRING "Fire +2, Air -2"
            ^"Endurance" INTEGER 4
            ^"Composure" INTEGER 19
            ^"Focus" INTEGER 8
            ^"Vigilance" INTEGER 6
            ^"Honor" INTEGER 76
            ^"Glory" INTEGER 85
            ^"Status" INTEGER 70
            ^"Skills" LIST OF STRING ["Artisan 3", "Martial 0", "Scholar 3", "Social 5", "Trade 1"]
            ^"Advantages" LIST OF STRING ["Famously Successful (Water) [Social; Interpersonal, Fame]", "Love of Storytelling (Water) [Artisan; Mental]"]
            ^"Disadvantages" LIST OF STRING ["Broken Hearted (Fire) [Social; Mental]", "Whispers of Treachery (Fire) [Social; Interpersonal, Infamy]"]
            ^"Favored Weapons" LIST OF STRING ["Wakizashi: Range 0-1, Damage 3, Deadliness 5/7, Ceremonial, Razor-Edged"]
            ^"Gear" LIST OF STRING ["Ceremonial Clothes (Physical 1, Ceremonial, Resplendent)", "Personal chop", "Pillow book", "Calligraphy set", "Omamori given to her by Emperor Hantei XXXVII"]
        }

        ^"Ebb and Flow (Shūji)" DEF {
            ^"Description" STRING "Activation: As a Scheme or Support action, Ryoku may make a Courtesy (Water), Command (Water), or Games (Water) check targeting one character. The TN of this check is equal to the target's vigilance. If Ryoku succeeds (and chose Scheme action), choose one of the target's advantages that she knows; whenever it applies, invert it. This effect persists until the end of the scene. If Ryoku succeeds (and chose Support action), choose one of the target's disadvantages she knows; whenever it applies, invert it. This effect persists until the end of the scene."
        }

        ^"I Have Met Your Like Before" DEF {
            ^"Description" STRING "When performing a Scheme action, Ryoku may spend (op) in the following way: (op): Learn the target's ninjō or giri, or one advantage or disadvantage of the GM's choice. (op)(op): Learn the target's current motivation in this scene."
        }

        ^"Speaking in Silence" DEF {
            ^"Description" STRING "Once per scene when making a check to persuade or influence someone, Ryoku may add 5 kept (ring) set to an (op)."
        }

        ^"Everything Tells a Story" DEF {
            ^"Description" STRING "When performing an Artisan skill check, Ryoku may add 1 kept (ring) set to an (op) result."
        }

        # While in Kyuden Doji, Lady Ryoku gains the
        # following additional abilities:

        ^"All Things Find Their Way to Me" DEF {
            ^"Description" STRING "While in Kyuden Doji: When attempting to start or spread a rumor or story in Kyuden Doji, a character may spend (op) equal to Lady Ryoku's Vigilance; if they do not she knows that the character is the source of the rumor or story."
        }

        ^"A Minor Consideration" DEF {
            ^"Description" STRING "While in Kyuden Doji: Once per scene during an intrigue, as a Scheme action, Lady Ryoku may remove 2 momentum points from one side, and add them to another side of the intrigue."
        }

        RULES {
            #L5RCS10eF0gH2iJ4kL6mN8oP: ryoku_elder_crane
        }
    }

    # --- Deer Clan ---

    # source stat block (page 87)
    ^"Shika Tsuneko, First Spear" DEF {
        EXTENDS ^"NPC"

        # Often masquerades as a simple Deer Clan messenger,
        # but holds the title of First Spear — master of the yari
        # and wartime leader of the speardancers. Since the Deer
        # avoid war, she mostly serves daimyo Shika Renji on
        # difficult missions. Affects naive confusion to mask her
        # considerable competence. Genuinely good-hearted.

        PROPERTIES {
            ^"Type" STRING "Adversary" FIXED
            ^"Combat Conflict Rank" INTEGER 6
            ^"Intrigue Conflict Rank" INTEGER 3
            ^"Rings" DEF {
                ^"Air" INTEGER 4
                ^"Earth" INTEGER 3
                ^"Fire" INTEGER 2
                ^"Water" INTEGER 4
                ^"Void" INTEGER 3
            }
            ^"Demeanor" STRING "Shrewd"
            ^"Social Skill Check TN Modifiers" STRING "Air +2, Fire -2"
            ^"Endurance" INTEGER 15
            ^"Composure" INTEGER 14
            ^"Focus" INTEGER 5
            ^"Vigilance" INTEGER 4
            ^"Honor" INTEGER 55
            ^"Glory" INTEGER 35
            ^"Status" INTEGER 40
            ^"Skills" LIST OF STRING ["Artisan 0", "Martial 5", "Scholar 0", "Social 2", "Trade 2"]
            ^"Advantages" LIST OF STRING ["Innocent Appearance (Air) [Social; Interpersonal]"]
            ^"Disadvantages" LIST OF STRING ["Softheartedness (Fire) [Martial; Interpersonal]"]
            ^"Favored Weapons" LIST OF STRING ["Heirloom Kamayari: Range 2, Damage 4, Deadliness 5, Durable, Snaring"]
            ^"Gear" LIST OF STRING ["Concealed armor (Physical 2, Concealable)", "Traveling rations", "Amigasa", "Wakizashi"]
        }

        ^"Slicing Wind Kick" DEF {
            ^"Description" STRING "Activation: As an Attack and Movement action, using one readied polearm, Tsuneko may make a TN 3 Martial Arts [Unarmed] (Air) check with her unarmed kick profile (Range 1, Damage 2, Deadliness 1) targeting one character at range 1-2. Effects: If Tsuneko succeeds, the target suffers 2 physical damage plus additional damage equal to her bonus successes and the Disoriented condition. Air (op): Tsuneko moves 1 range band. Air (op)(op): One of Tsuneko's targets suffers the Prone condition. Air (op)(op)+: Tsuneko may choose an additional target for each (op)(op) spent in this way."
        }

        ^"Beware the Smallest Mouse" DEF {
            ^"Description" STRING "Activation: When Tsuneko makes a Social skill (Water) check targeting one or more characters, she may spend (op) as follows: Water (op)(op)+: While interacting with Tsuneko, the target treats their vigilance as 1 lower per (op)(op) spent this way and decreases the TN of their social checks targeting her by 1. This effect persists until the end of the scene."
        }

        RULES {
            #L5RCS11qR1sT3uV5wX7yZ9aB: tsuneko_first_spear
        }
    }
}
