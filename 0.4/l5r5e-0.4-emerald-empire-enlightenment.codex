# .codex SECTION — Emerald Empire: Paths to Enlightenment (Chapter 5 — Shinsei,
# the Brotherhood, and the monastic orders). Stand-off graph over
# l5r5e-0.4-emerald-empire-enlightenment.lore (spec §25). Part of the L5R5e
# system graph; DEPENDS_ON the shared schema. Covers the three interpretations
# of Shinsei (and Kongōten/the Thunder Dialogue), the well-known orders and their
# temples (Osano-wo's Shinden Kasai/Sandā, the Temple of Listening Ghosts, the
# Four Temples of Kyūden Seppun, the High House of Light, the Silent Ones and
# Plains Wind monasteries), and their Fortunes and people.
#
# Note: the chapter opens by reprinting religion.lore's Forbidden Rituals /
# Fox's Tale (Grand Master of the Elements, the Yogo curse) — those entities are
# already in the religion section and are not duplicated here.

CODEX "L5R5e_Codex_EE_Enlightenment" {
    NAME "Emerald Empire: Paths to Enlightenment — Lore Graph"
    VERSION "0.1"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-09-02"
    FOR EDITION "l5r5e"
    DEPENDS_ON "L5R5e_Codex_Schema" VERSION "0.9"

    # -- The Mystery of Shinsei: the hero and god interpretations ----------------

    ENTITY #L5RcxEEenl01kitemtn ^"Kite Mountain" {
        IS ^"Mountain"
        SOURCE "l5r5e-0.4-emerald-empire-enlightenment.lore" AT "shinsei-the-hero"
    }
    ENTITY #L5RcxEEenl02thundgd ^"Thunder Goddess" {
        IS ^"Deity"
        SOURCE "l5r5e-0.4-emerald-empire-enlightenment.lore" AT "shinsei-the-hero"
    }
    ENTITY #L5RcxEEenl03thundlg ^"Thunder Dialogue" {
        IS ^"Document"
        SOURCE "l5r5e-0.4-emerald-empire-enlightenment.lore" AT "shinsei-the-hero"
    }
    ENTITY #L5RcxEEenl04kongoten ^"Kongōten" {
        IS ^"Fortune"
        SOURCE "l5r5e-0.4-emerald-empire-enlightenment.lore" AT "shinsei-the-god"
    }
    ENTITY #L5RcxEEenl05shjaltan ^"Shinjo Altansarnai" {
        IS ^"Person"
        SOURCE "l5r5e-0.4-emerald-empire-enlightenment.lore" AT "shinsei-the-god"
        RELATIONSHIPS {
            ^"member-of" -> ^"Unicorn Clan" FROM "Shinjo Altansarnai herself has opined that Shinsei's divine persona as Kongōten"
        }
    }

    # -- The well-known monastic orders and their temples -----------------------

    ENTITY #L5RcxEEenl06bishlib ^"Bishamon's Divine Library" {
        IS ^"Building"
        SOURCE "l5r5e-0.4-emerald-empire-enlightenment.lore" AT "bishamon-monks"
        RELATIONSHIPS {
            ^"located-near" -> ^"Otosan Uchi" FROM "Bishamon's Divine Library, in the highlands near Otosan Uchi"
        }
    }
    ENTITY #L5RcxEEenl07order7t ^"Order of the Seven Thunders" {
        IS ^"Organization"
        SOURCE "l5r5e-0.4-emerald-empire-enlightenment.lore" AT "monks-of-the-seven-thunders"
    }
    ENTITY #L5RcxEEenl08tamadora ^"Tamadora" {
        IS ^"Person"
        SOURCE "l5r5e-0.4-emerald-empire-enlightenment.lore" AT "monks-of-osano-wo"
    }
    ENTITY #L5RcxEEenl09tamaryuu ^"Tamadora-ryū" {
        IS ^"School"
        SOURCE "l5r5e-0.4-emerald-empire-enlightenment.lore" AT "monks-of-osano-wo"
    }
    ENTITY #L5RcxEEenl10gisetosh ^"Gisei Toshi" {
        IS ^"City"
        SOURCE "l5r5e-0.4-emerald-empire-enlightenment.lore" AT "temple-life"
        RELATIONSHIPS {
            ^"held-by" -> ^"Phoenix Clan" FROM "the Phoenix's hidden city of Gisei Toshi"
        }
    }

    # -- Osano-wo's temples on the Plains of Thunder ----------------------------

    ENTITY #L5RcxEEenl11plnthund ^"Plains of Thunder" {
        IS ^"Region"
        SOURCE "l5r5e-0.4-emerald-empire-enlightenment.lore" AT "sacred-thresholds"
    }
    ENTITY #L5RcxEEenl12shndkasi ^"Shinden Kasai" {
        IS ^"Temple"
        SOURCE "l5r5e-0.4-emerald-empire-enlightenment.lore" AT "sacred-thresholds"
        RELATIONSHIPS {
            ^"located-in" -> ^"Plains of Thunder" FROM "This temple to Osano-wo... Built by Crab warriors on the Plains of Thunder"
            ^"held-by"    -> ^"Crab Clan"         FROM "Shinden Kasai, was later built by Crab architects on the Plains of Thunder"
        }
    }
    ENTITY #L5RcxEEenl13shndsand ^"Shinden Sandā" {
        IS ^"Temple"
        SOURCE "l5r5e-0.4-emerald-empire-enlightenment.lore" AT "sacred-thresholds"
        RELATIONSHIPS {
            ^"located-in" -> ^"Inazuma Province" FROM "The Mantis built one of the two major temples to Osano-wo, Shinden Sandā in Inazuma Province"
            ^"held-by"    -> ^"Mantis Clan"      FROM "given for safekeeping to Shinden Sandā in Mantis lands"
        }
    }
    ENTITY #L5RcxEEenl14inazuma ^"Inazuma Province" {
        IS ^"Province"
        SOURCE "l5r5e-0.4-emerald-empire-enlightenment.lore" AT "sacred-thresholds"
    }
    ENTITY #L5RcxEEenl15kusuburu ^"Kusuburu" {
