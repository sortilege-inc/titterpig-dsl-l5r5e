        SOURCE "l5r5e-0.4-emerald-empire-enlightenment.lore" AT "sacred-thresholds"
        RELATIONSHIPS {
            ^"member-of" -> ^"Lion Clan" FROM "The master sensei is a retired Lion samurai now known as Kusuburu"
        }
    }
    ENTITY #L5RcxEEenl16kaiutomo ^"Kaiu Tomoki" {
        IS ^"Person"
        SOURCE "l5r5e-0.4-emerald-empire-enlightenment.lore" AT "sacred-thresholds"
        RELATIONSHIPS {
            ^"member-of" -> ^"Crab Clan" FROM "a samurai named Kaiu Tomoki was given the task of building a temple"
        }
    }
    ENTITY #L5RcxEEenl17thsohei ^"Thunder Sōhei" {
        IS ^"Organization"
        SOURCE "l5r5e-0.4-emerald-empire-enlightenment.lore" AT "sacred-thresholds"
    }
    ENTITY #L5RcxEEenl18thdragon ^"Thunder Dragon" {
        IS ^"Spirit"
        SOURCE "l5r5e-0.4-emerald-empire-enlightenment.lore" AT "sacred-thresholds"
    }
    ENTITY #L5RcxEEenl19kenzanzz ^"Kenzan" {
        IS ^"Person"
        SOURCE "l5r5e-0.4-emerald-empire-enlightenment.lore" AT "sacred-thresholds"
        RELATIONSHIPS {
            ^"member-of" -> ^"Crab Clan" FROM "He named one son, Kenzan, his heir, and through him, the Hida family can trace their bloodline back to the Kami"
        }
    }
    ENTITY #L5RcxEEenl20kaimetsu ^"Kaimetsu-Uo" {
        IS ^"Person"
        SOURCE "l5r5e-0.4-emerald-empire-enlightenment.lore" AT "sacred-thresholds"
        RELATIONSHIPS {
            ^"founder-of" -> ^"Mantis Clan" FROM "His other son, Kaimetsu-Uo, left to found the Mantis Clan"
            ^"member-of"  -> ^"Crab Clan"   FROM "the second son of the Kami Hida"
        }
    }
    ENTITY #L5RcxEEenl21takeshi ^"Takeshi" {
        IS ^"Person"
        SOURCE "l5r5e-0.4-emerald-empire-enlightenment.lore" AT "strength-of-thunder"
    }

