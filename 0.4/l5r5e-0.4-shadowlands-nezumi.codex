# .codex SECTION — Shadowlands: The Nezumi. Stand-off graph over
# l5r5e-0.4-shadowlands-nezumi.lore (spec §25). Part of the L5R5e system graph;
# DEPENDS_ON the shared schema. The Nezumi race and their Rememberers are already
# in the graph (defined in the Emerald Empire Wilds section); they are amended
# here with the Shadowlands provenance. New: the named tribes, the Transcendents,
# and two named places/documents.

CODEX "L5R5e_Shl_Nezumi_Codex" {
    NAME "Shadowlands: The Nezumi — Lore Graph"
    VERSION "0.1"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-09-02"
    FOR EDITION "l5r5e"
    DEPENDS_ON "L5R5e_Codex_Schema" VERSION "0.9"

    ENTITY #L5RcxShlnez01thirdwsk ^"Third Whisker" {
        IS ^"Organization"
        SOURCE "l5r5e-0.4-shadowlands-nezumi.lore" AT "the-third-whisker"
    }
    ENTITY #L5RcxShlnez02crackbon ^"Cracked Bone" {
        IS ^"Organization"
        SOURCE "l5r5e-0.4-shadowlands-nezumi.lore" AT "the-cracked-bone"
    }
    ENTITY #L5RcxShlnez03burntpaw ^"Burnt Paws" {
        IS ^"Organization"
        SOURCE "l5r5e-0.4-shadowlands-nezumi.lore" AT "the-burnt-paws"
    }
    ENTITY #L5RcxShlnez04ghostpaw ^"Ghost Paws" {
        IS ^"Organization"
        SOURCE "l5r5e-0.4-shadowlands-nezumi.lore" AT "the-burnt-paws"
    }
    ENTITY #L5RcxShlnez05tattrear ^"Tattered Ear" {
        IS ^"Organization"
        SOURCE "l5r5e-0.4-shadowlands-nezumi.lore" AT "the-burnt-paws"
    }
    ENTITY #L5RcxShlnez06transcnd ^"Transcendents" {
        IS ^"Faction"
        SOURCE "l5r5e-0.4-shadowlands-nezumi.lore" AT "nezumi-magic"
    }
    ENTITY #L5RcxShlnez07fireratv ^"Fire Rat Skin Village" {
        IS ^"Village"
        SOURCE "l5r5e-0.4-shadowlands-nezumi.lore" AT "nezumi-magic"
    }
    ENTITY #L5RcxShlnez08pershist ^"A Personal History of Rokugan" {
        IS ^"Document"
        SOURCE "l5r5e-0.4-shadowlands-nezumi.lore" AT "the-third-whisker"
    }

    # -- Amends (defined in the Emerald Empire Wilds section) -------------------

    ENTITY ^"Nezumi" {
        SOURCE "l5r5e-0.4-shadowlands-nezumi.lore" AT "the-nezumi"
    }
    ENTITY ^"Rememberers" {
        SOURCE "l5r5e-0.4-shadowlands-nezumi.lore" AT "yesterday"
    }
}
