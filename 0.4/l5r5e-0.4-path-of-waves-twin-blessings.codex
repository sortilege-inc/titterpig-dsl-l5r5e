        SOURCE "l5r5e-0.4-path-of-waves-twin-blessings.lore" AT "pearl-shine-river"
        RELATIONSHIPS { ^"married-to" -> ^"Ehana" FROM "Hiroto, the brewer. A hard worker, Ehana's husband" }
