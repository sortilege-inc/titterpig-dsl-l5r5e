BASE "L5R5e_Core_Systems" {
    NAME "Legend of the Five Rings 5th Edition - Game systems: combat, conditions, strife, honor, weapons, armor, and NPCs"
    VERSION "0.4.23"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-03-01"

    # Core Rulebook: Combat resolution, conditions, strife/composure,
    # honor/glory/status mechanics, weapons, armor, critical strikes

    # ===========================
    # METATYPE ANCHORS
    # ===========================

    ^"Game Rules" DEF {
        # Metatype anchor for game rules and errata references
    }

    ^"System" DEF {
        # Metatype anchor for game system and subsystem definitions
    }

    ^"Legend of the Five Rings" DEF {
        APPLIES TO [^"System"]

        # The game itself. The Legend of the Five Rings Roleplaying Game
        # (abbreviated "L5R" or "L5R RPG") is a game of samurai drama set in the
        # fictional land of Rokugan. Its premise, theme, and tone are carried in
        # the GUIDANCE block below (see also ^"Ninjō" and ^"Giri").

        PROPERTIES {
            ^"Abbreviation" STRING "L5R"
            ^"Genre" STRING "Samurai drama"
            ^"Setting" STRING "Rokugan"
        }
    }

    # -----------------------------------------------------------------------
    # GUIDANCE (§22) — the game's premise, theme, and tone (book p.20).
    # -----------------------------------------------------------------------
    GUIDANCE {
        ENTRY ^"what-is-a-roleplaying-game" #L5RG01aB2cD3eF4gH5iJ6k {
            CONCERNS [ ^"Legend of the Five Rings" ]
            TOPICS [ "tone", "rules philosophy" ]
            TEXT "A roleplaying game is a group storytelling exercise that enables groups of people to develop their own characters, stories, and worlds together with their friends. Unlike those in a competitive game, the rules of a roleplaying game are intended first and foremost to help people tell stories and have fun. The rules for the Legend of the Five Rings Roleplaying Game (commonly abbreviated simply as \"L5R\" or \"L5R RPG\") are written with a certain degree of technical precision, but they should be understood as tools to facilitate storytelling rather than as restrictions that must be applied \"correctly\" in all cases. Remember, as long as everyone is having fun, you're playing the game properly!"
        }
        ENTRY ^"a-game-of-samurai-drama" #L5RG02kL3mN4oP5qR6sT7u {
            CONCERNS [ ^"Legend of the Five Rings" ]
            TOPICS [ "premise", "theme", "setting" ]
            TEXT "The Legend of the Five Rings Roleplaying Game is a game of samurai drama. Set in the fictional land of Rokugan, it draws inspiration from real-world literature and history. The primary characters of the game are samurai, who are torn between their personal desires and their sworn duties. They must often contend with cunning court intrigues, deadly armed conflicts, and dangerous supernatural creatures."
        }
        ENTRY ^"miyamoto-musashi-on-mastery" #L5RG33nO4pQ5rS6tU7vW8x {
            CONCERNS [ ^"Legend of the Five Rings" ]
            TOPICS [ "inspiration", "mastery" ]
            TEXT "Legend of the Five Rings owes a great deal to the real world historical writings of Miyamoto Musashi, a famous Japanese sword master. The Book of Five Rings (c. 1645) is his martial and philosophical manual, and offers insights on fighting and how these apply to life more generally. Interestingly, Musashi did not write his account until decades after his legendary career as a duelist. Further, reflecting on his success in youth, he describes how he did not reach the underlying truth of martial arts until late in his life, decades after his last known duel. Despite achieving the height of his demonstrated fighting ability early in his career, he felt that his understanding of martial arts—and, by extension, all other arts he learned—was incomplete until he had spent another twenty years studying and reflecting. In this game, reaching Rank 5 in a skill is akin to Musashi reaching his peak as a practicing duelist in his youth. It is an incredible achievement, but does not yet reflect full understanding of the art or the wider implications of the idea of mastery itself. To achieve their greatest potential, a character must not only advance their skills and rings, but also come to understand themself and their place in the world."
        }
    }

    ^"Item" DEF {
        # Metatype anchor for item definitions
    }

    ^"Item Pattern" DEF {
        # Metatype anchor for crafting and item pattern definitions
    }

    #L5R464yZ6aB8cD0eF2gH4i ^"Table" DEF {
        # Metatype anchor for reference table definitions
    }

    ^"Social Objective" DEF {
        # Metatype anchor for intrigue social objective definitions
    }

    #L5R465jK7lM9nO1pQ3rS5t ^"Optional Rule" DEF {
        # Metatype anchor for optional/variant rule definitions
    }

    ^"Mechanic" DEF {
        # Metatype anchor for GM-facing mechanic and design guidance
    }

    ^"Equipment" DEF {
        # Metatype anchor for general equipment item definitions
    }

    # ===========================
    # STRIFE AND EMOTIONAL STATE
    # ===========================

    ^"Strife" DEF {
        APPLIES TO [^"Samurai", ^"Adversary"]

        INTEGER MIN 0

        # Emotional accumulation from (st) symbols on kept dice,
        # anxieties, opposing ninjō, and narrative effects. When
        # strife exceeds composure, character becomes Compromised.
        # Removed between scenes and by contemplative activity —
        # see ^"Strife Removal".

        RULES {
            #L5R400aB2cD4eF6gH8iJ0k: strife_from_kept_dice
            #L5R401lM3nO5pQ7rS9tU1v: strife_from_anxieties
            #L5R402wX4yZ6aB8cD0eF2g: strife_removal_between_scenes
            #L5R403hI5jK7lM9nO1pQ3r: strife_reduced_to_half_composure
        }
    }

    GUIDANCE {
        ENTRY ^"narrating-strife" #L5RG11gH2iJ3kL4mN5oP6q {
            CONCERNS [ ^"Strife" ]
            TOPICS [ "strife", "roleplaying", "theme" ]
            TEXT "Players should feel free to narrate the emotions their characters are feeling as strife accumulates, as well as how it may affect their characters' mannerisms and behavior. Emotion—both bearing it stoically and expressing it openly—is an important aspect of drama. While samurai drama often revolves around stoic characters, stoicism is at its most compelling when characters are feeling something very deeply inside. Even giving small descriptions of their characters' current emotional states can help players engage with this theme. Of course, not all strife needs to be narrated—it is up to the players to decide when strife feels impactful or important. Strife from checks can represent run-of-the-mill frustration, the joy of a challenge, old pain dredged up by the present situation, fear, shame, rage, passion, hope, the thrill of victory, or any number of other feelings that heighten the character's emotional state."
        }
        ENTRY ^"nervous-habits-and-tells" #L5RG12hI3jK4lM5nO6pQ7r {
            CONCERNS [ ^"Strife", ^"Unmask" ]
            TOPICS [ "strife", "character creation", "tells" ]
            TEXT "During character creation, a player will determine one or more tells that show the character is under stress. These are the sorts of small details that help a character feel vivid, and players can use them to flavor their descriptions when their characters accumulate strife or unmask."
        }
        ENTRY ^"strife-and-samurai-decorum" #L5RG17mN8oP9qR0sT1uV2w {
            CONCERNS [ ^"Strife" ]
            TOPICS [ "strife", "theme", "decorum" ]
            TEXT "Rokugani ideals state that samurai are to maintain proper decorum at all times, keeping their emotions under a tight leash except in specific situations. However, samurai are people, and thus they still experience the challenges, joys, frustrations, and sorrows that make up life. These myriad emotions are represented by strife. Players are responsible for tracking how much strife their characters have accrued. The GM should track strife for NPCs, though many NPCs use simplified rules for strife (see page 309). Even those raised under the strictest standards of emotional self-control or committed to finding spiritual peace risk cracking from time to time under the pressures of rule, courtly life, love, or warfare. In the game, strife can come from many activities."
        }
        ENTRY ^"stoicism-and-its-limits" #L5RG32mN3oP4qR5sT6uV7w {
            CONCERNS [ ^"Strife", ^"Compromised" ]
            TOPICS [ "strife", "theme", "decorum" ]
            TEXT "Although specifics vary by region and tradition, Rokugani culture at large idealizes a samurai who maintains a stoic outward demeanor. Joys and sorrows alike are to be accepted with the same stern affect. However, the truth of the matter is that no human being can uphold this ideal perfectly all the time—without an outlet for their emotions, a character will eventually become unfocused, distracted, and exhausted."
        }
    }

    ^"Strife Removal" DEF {

        # --- REMOVING STRIFE ---
        # Characters naturally remove some strife as time passes. At the
        # end of each scene (a self-contained event or events in an
        # ongoing adventure) each character removes strife until it is
        # equal to half their ^"Composure", rounded up (unless it is
        # already lower).
        #
        # NOTE: this reduces strife TO half composure. It does not halve
        # the character's current strife, and a character already at or
        # below half composure does not change.
        #
        # Strife can be reduced further through restful contemplative
        # activities including the pursuit of one's ^"Ninjō", pursuing a
        # ^"Passion", meditating, or attending a tea ceremony. Such
        # activities can potentially remove all of a character's current
        # strife.
        #
        # Finally, a ^"Compromised" character can remove all of their
        # strife by unmasking, briefly lowering their façade to act upon
        # their emotions openly — see ^"Unmask".

        RULES {
            #L5R403aB4cD6eF8gH0iJ2k: strife_removal_between_scenes
            #L5R403lM5nO7pQ9rS1tU3v: strife_reduced_to_half_composure_rounded_up
            #L5R403wX6yZ8aB0cD2eF4g: strife_removal_contemplative_activities
            #L5R403hI7jK9lM1nO3pQ5r: strife_removal_by_unmasking
        }
    }

    ^"Compromised" DEF {
        APPLIES TO [^"Samurai", ^"Adversary"]

        # Condition when strife exceeds composure. The character's
        # emotions are barely contained and about to boil over.
        #
        # Effects while Compromised:
        # - Vigilance treated as 1 (easier to Scheme against)
        # - Cannot keep dice with (st) symbols
        # - May Unmask once per scene to end Compromised

        RULES {
            #L5R404sT6uV8wX0yZ2aB4c: compromised_when_strife_exceeds_composure
            #L5R405dE7fG9hI1jK3lM5n: vigilance_reduced_to_one
            #L5R406oP8qR0sT2uV4wX6y: cannot_keep_strife_dice
            #L5R407zA9bC1dE3fG5hI7j: may_unmask_once_per_scene
        }
    }

    ^"Unmask" DEF {
        APPLIES TO [^"Samurai"]

        # When Compromised, a character may Unmask — an outward display
        # of raw emotion that ends the Compromised condition. The player
        # chooses how the emotion manifests. All strife is removed, but
        # there are narrative and mechanical consequences.

        # Unmask options are recommendations, not requirements.
        # When forfeiting honor or glory, the general rule of thumb
        # is to lose an amount equal to your rank (the tens digit)
        # of the relevant attribute.
        UNMASK_OPTIONS {
            ^"Bend Principles" "Compromise your beliefs. May forfeit honor."
            ^"Expose an Opening" "Emotional vulnerability reveals weakness. Enemies may gain advantage."
            ^"Honor's Challenge" "Challenge an antagonist to a duel. Must follow through."
            ^"Inappropriate Outburst" "Lose composure publicly. May forfeit glory."
            ^"Panicked Retreat" "Flee the scene. May forfeit honor and/or glory."
            ^"Rage" "Lash out violently. May forfeit honor and/or glory."
        }

        RULES {
            #L5R408kL0mN2oP4qR6sT8u: unmask_removes_all_strife
            #L5R409vW1xY3zA5bC7dE9f: unmask_has_consequences
            #L5R410gH2iJ4kL6mN8oP0q: unmask_once_per_scene
        }
    }

    # -----------------------------------------------------------------------
    # GUIDANCE (§22) — verbatim ways to unmask (book p31); the structured
    # UNMASK_OPTIONS above is the quick-reference, this preserves the exact text.
    # -----------------------------------------------------------------------
    GUIDANCE {
        ENTRY ^"unmask-bend-principles" #L5RG39tU0vW1xY2zA3bC4d {
            CONCERNS [ ^"Unmask" ]
            TOPICS [ "unmask" ]
            TEXT "The character does something that conflicts with their values, oaths, or view of right and wrong to bring about the results they desire. Unmasking this way might well let a character implement a solution to a problem they would normally never consider, but to do so, they must usually forfeit honor equal to their honor rank (a value equal to the tens digit of their total honor attribute), or more, at the GM's discretion."
        }
        ENTRY ^"unmask-expose-opening" #L5RG34oP5qR6sT7uV8wX9y {
            CONCERNS [ ^"Unmask" ]
            TOPICS [ "unmask" ]
            TEXT "The character reveals a vital flaw in their argument, defenses, or position, often related to one of their disadvantages. Unmasking this way allows others to strike at this weakness, reducing TN of the next check by a hostile character (as defined by the GM) that targets the character to 1."
        }
        ENTRY ^"unmask-honors-challenge" #L5RG35pQ6rS7tU8vW9xY0z {
            CONCERNS [ ^"Unmask" ]
            TOPICS [ "unmask", "duel" ]
            TEXT "The character can bear their indignities no longer, and demands satisfaction by way of steel. The character must challenge an antagonist in the scene to a duel (not necessarily to the death). The duel might be fought immediately, or the participants might take the opportunity to prepare for their battle."
        }
        ENTRY ^"unmask-inappropriate-outburst" #L5RG36qR7sT8uV9wX0yZ1a {
            CONCERNS [ ^"Unmask" ]
            TOPICS [ "unmask" ]
            TEXT "The character says something out of line or commits a deep breach of etiquette, shocking onlookers. Unmasking this way might let a character express a vital argument forbidden by propriety or reveal something that society demands they keep within. However, to do so, they must usually forfeit glory equal to their glory rank (a value equal to the tens digit of their Glory attribute), or more, at the GM's discretion."
        }
        ENTRY ^"unmask-panicked-retreat" #L5RG37rS8tU9vW0xY1zA2b {
            CONCERNS [ ^"Unmask" ]
            TOPICS [ "unmask" ]
            TEXT "The character departs the scene immediately, without regard for propriety. Unmasking this way might allow a character to run away from certain defeat and live to fight another day. However, to flee from battle or another scene with similarly high stakes, they must usually forfeit honor equal to their honor rank, glory equal to their glory rank, or both."
        }
        ENTRY ^"unmask-rage" #L5RG38sT9uV0wX1yZ2aB3c {
            CONCERNS [ ^"Unmask" ]
            TOPICS [ "unmask" ]
            TEXT "The character fails to contain their fury, and they lash out at people or objects around them. Unmasking this way might let a character launch a first strike against an unready foe or let them reinforce a threat by destroying a nearby object. However, to act so violently in an inappropriate context, the character must usually forfeit honor equal to their honor rank, glory equal to their glory rank, or both."
        }
        ENTRY ^"using-strife-and-unmasking-for-roleplaying" #L5RG57kL0mN1oP2qR3sT4u {
            CONCERNS [ ^"Unmask", ^"Strife" ]
            TOPICS [ "roleplaying", "strife", "unmask", "tells" ]
            TEXT "Moments when your character unmasks are great opportunities for their personality to shine through, so you should think about how stress affects them. In the Personality, Traits, and Quirks section of the character sheet, record some physiological, verbal, or mental signs they display as their strife rises. Does your character get loud and abrasive when enraged, or does their voice fall to an icy whisper? Do they fall to their knees in prayer when wracked with uncertainty or respond to everything as if it is a violent threat? Perhaps they have a simple mannerism they display as they grow more anxious, such as idly flexing their fingers or shifting subtly to a guarded posture. Do they have a particular turn of phrase they tend to use upon growing excited or frustrated? Come up with one or two examples that help breathe life into your character as they approach their emotional threshold. With the GM's permission, you can even mix and match the narrative and mechanical effects of various ways to unmask, re-flavor the narrative side of an example unmasking to better fit your character, or make up a wholly new way your character unmasks."
        }
    }

    # ===========================
    # FATIGUE AND INCAPACITATION
    # ===========================

    ^"Fatigue" DEF {
        APPLIES TO [^"Samurai", ^"Adversary"]

        INTEGER MIN 0

        # Physical exhaustion and injury tracked as fatigue points.
        # Suffered from damage, exertion, and some technique effects.
        # When fatigue exceeds endurance, character gains the Incapacitated
        # condition (see ^"Condition" DEF).

        RULES {
            #L5R411rS3tU5vW7xY9zA1b: fatigue_from_damage
            #L5R412cD4eF6gH8iJ0kL2m: incapacitated_at_endurance
            #L5R413nO5pQ7rS9tU1vW3x: fatigue_recovery_between_scenes
        }
    }

    # ===========================
    # CONDITIONS
    # ===========================

    ^"Condition" DEF {
        APPLIES TO [^"Samurai", ^"Adversary"]

        ENUM ["Afflicted", "Bleeding", "Burning", "Compromised", "Dazed",
              "Disoriented", "Dying", "Enraged", "Exhausted", "Immobilized",
              "Incapacitated", "Intoxicated", "Prone", "Silenced",
              "Unconscious", "Wounded"]

        # Persistent status effects applied during play. Each condition
        # has specific triggers, effects, and removal conditions.

        CONDITION_DEFINITIONS {

            #0zd6MOW23KjIOb6sNLSgtk ^"Afflicted" DEF {
                DESCRIPTION "The character is possessed or otherwise tormented by an onryō (vengeful ghost), kansen, or other malevolent spiritual entity. Given time, this evil force threatens to plant the seeds of the Shadowlands Taint."
                EFFECTS {
                    "Vigilance counts as 1."
                    "When making a check, after Step 5: Choose Kept Dice, the GM may alter one kept (ring) to a (op)(st) result."
                    "When Compromised, one of the following effects occurs based on the ring last used for a check (or GM's choice):"
                    "Air: Mistakes someone in the scene for a person from their past, accusing them of a half-remembered sin or taunting them over an ancient failure until end of scene."
                    "Water: Health collapses; suffers a critical strike with severity 5."
                    "Fire: Becomes possessed by a desire; also becomes ^\"Enraged\"."
                    "Earth: Flesh becomes pale and shows signs of decay; reduce endurance by 1 until Afflicted is removed. Cumulative; if endurance reaches 0, the character perishes."
                    "Void: Ill fortune follows every move; loses all ^\"Void Points\"."
                }
                REMOVED_WHEN "Rituals such as ^\"Cleansing Rite\" and other abilities can remove this condition. Every two weeks, an Afflicted character must make a TN 4 ^\"Fitness\" or ^\"Meditation\" check using any ring. If they fail, remove ^\"Afflicted\" and assign the ^\"Shadowlands Taint\" disadvantage to the ring used (or another ring if that ring already has it)."
            }

            #sanfTLRNGC5zRTthTnpDGw ^"Bleeding" DEF {
                DESCRIPTION "The character is losing blood, internally or externally."
                EFFECTS {
                    "When making a check, suffer physical damage equal to the (st) symbols on kept dice, ignoring resistances."
                    "Each time damage inflicted this way causes a ^\"Critical Strike\", the severity is treated as equal to the character's current fatigue."
                }
                REMOVED_WHEN "Any character at range 0-1 may make a TN 2 Medicine (Earth) check as a Support action to remove this condition."
            }

            #ePH4wzeFZVUToQI7qk96ki ^"Burning" DEF {
                DESCRIPTION "The character is ablaze."
                EFFECTS {
                    "After performing an action, suffer 3 strife and 3 physical damage that ignores resistance."
                    "Severity of critical strikes caused by this damage is 5."
                    "Each critical strike suffered this way beyond the first before the condition is removed has its severity increased by 5."
                }
                REMOVED_WHEN "A character may attempt to smother flames on themselves or another character at range 0-1 by making a TN 2 Fitness (Water) check as a Movement and Support action."
            }

            #EJSWW92HPvejHQLZakLnjP ^"Compromised" DEF {
                DESCRIPTION "The character is emotionally distraught and distracted."
                EFFECTS {
                    "Cannot keep dice containing (st) symbols (to a possible minimum of 0 kept dice)."
                    "Vigilance counts as 1."
                }
                REMOVED_WHEN "When strife is reduced to a value lower than or equal to composure."
            }

            #SOqJ3aglo4vXc2F5wKZPkX ^"Dazed" DEF {
                DESCRIPTION "The character's vision is obscured or their focus is hampered, putting them on the defensive."
                EFFECTS {
                    "Increase the TN of Attack and Scheme action checks by 2."
                }
                REMOVED_WHEN "At the end of their turn, if the character did not perform an Attack or Scheme action."
            }

            #stB6PGMu0mKxxzuRjX5Cnz ^"Disoriented" DEF {
                DESCRIPTION "The character's senses are scattered, cutting off their options to defend themself."
                EFFECTS {
                    "Increase the TN of Movement and Support action checks by 2."
                }
                REMOVED_WHEN "At the end of their turn, if the character did not perform a Movement or Support action."
            }

            #wg1bbISfXnlZBMfMcV4zJe ^"Dying" DEF {
                DESCRIPTION "The character is on the verge of death due to blood loss, organ failure, or another cause. Duration specified in rounds by the effect that applied it."
                EFFECTS {
                    "Character is hovering on the precipice between life and death for a number of rounds (or narrative time) specified by the applying effect."
                    "Once the allotted time has passed, the character perishes at the end of their next turn (or after completing one task in a narrative scene)."
                    "If the Dying condition is removed before then, the character stabilizes and narrowly survives their close brush with death."
                }
                REMOVED_WHEN "Any character at range 0-1 may make a TN 4 Medicine (Air) check as a Support action. If they fail, reduce the number of rounds remaining by their shortfall."
            }

            #Ia7Sy9d76In7RfuERGmGBR ^"Enraged" DEF {
                DESCRIPTION "The character is consumed with rage and fights with a fury as devastating as it is terrifying."
                EFFECTS {
                    "Increase the severity of all critical strikes inflicted by and upon the character by 2."
                    "The first time an Enraged character kills another character each scene, the Enraged character gains 1 ^\"Void Points\"."
                }
                REMOVED_WHEN "May make a TN 3 Meditation (Void) check as a Support action. Otherwise removed at end of scene."
            }

            #kkHCpNW3nzG6c4fkqDtYU9 ^"Exhausted" DEF {
                DESCRIPTION "The character is physically and mentally exhausted. Characters who go more than twenty-four hours without sleep (or less under trying circumstances, at GM's discretion) suffer this condition."
                EFFECTS {
                    "Does not remove fatigue and strife at the end of each scene as normal."
                }
                REMOVED_WHEN "After sleeping for six or more hours."
            }

            #rbf7BMXMbhSAAf9pJObyPB ^"Immobilized" DEF {
                DESCRIPTION "The character is entangled, pinned down, or otherwise incapable of movement."
                EFFECTS {
                    "Cannot perform Movement actions or otherwise reposition during their turn."
                    "Cannot select a different stance during their turn."
                }
                REMOVED_WHEN "At the end of their turn, if the character did not perform a Movement action."
            }

            #zCKxJDgchAUPs8roZh9fo4 ^"Incapacitated" DEF {
                DESCRIPTION "The character is largely incapable of action due to the scope of the harm they have suffered."
                EFFECTS {
                    "Cannot perform actions that require checks."
                    "Cannot defend against damage."
                    "After suffering a ^\"Critical Strike\", also suffers ^\"Unconscious\" in addition to any other effects."
                }
                REMOVED_WHEN "When fatigue is reduced to a value lower than or equal to endurance."
            }

            #VfidcoqHH8g7NJavTWLril ^"Intoxicated" DEF {
                DESCRIPTION "The character is drunk."
                EFFECTS {
                    "Doubles all strife suffered."
                    "Doubles all strife removed."
                }
                REMOVED_WHEN "At the end of each scene, may attempt to sober up by making a TN 3 Fitness (Water) check. A downtime scene spent resting also removes this condition."
            }

            #yqeYlCfRJuxQtNuD2h8XoQ ^"Prone" DEF {
                DESCRIPTION "The character is flat on the ground. A character may voluntarily become Prone as a Movement action."
                EFFECTS {
                    "Can move a maximum of 1 range band during their turn."
                    "At the GM's discretion, harder to spot at a distance or hit with ranged attack checks (increasing relevant TNs by 1)."
                }
                REMOVED_WHEN "At the end of their turn, if the character did not perform a Movement action."
            }

            #zh4PkfOZ7eeaRhbDireqJ6 ^"Silenced" DEF {
                DESCRIPTION "The character has been rendered temporarily speechless by shock or a swift blow."
                EFFECTS {
                    "Increase the TN of Scheme action checks and checks to activate invocations, ^\"Mahō\", and ^\"Shūji\" by 3."
                }
                REMOVED_WHEN "At the end of the character's turn, if they did not perform a Scheme action or make a check requiring speech."
            }

            #aMXPy0Yck3ayqjxDRRuLKR ^"Unconscious" DEF {
                DESCRIPTION "The character has been knocked out, has fallen asleep, or has otherwise been rendered totally unaware of their surroundings."
                EFFECTS {
                    "Cannot move, perform actions, or otherwise significantly act upon the physical world."
                    "Can still make checks to resist effects, but cannot make checks that represent agency."
                    "Increase the severity of any ^\"Critical Strike\" suffered by 10."
                    "Cannot defend against damage, but generally wakes up from loud noise, harm, or similar stimulus."
                }
                REMOVED_WHEN "May spend 1 ^\"Void Points\" to awaken immediately, their instincts rousing them in time to defend against damage. Characters also generally awaken after several hours."
            }

            #jF1KQRiSmY2lfHHahKsTEt ^"Wounded" DEF {
                DESCRIPTION "A part of the character's body is injured badly enough to hinder their use of it. One of their rings is negatively affected, recorded along with the condition."
                EFFECTS {
                    "Has two forms: Lightly Wounded and Severely Wounded."
                }
                REMOVED_WHEN "Any character can provide treatment by making a TN 4 Medicine (Water) check as a downtime activity. If they succeed, remove Lightly Wounded or reduce Severely Wounded to Lightly Wounded. This check can be attempted once per wounded ring per week. Alternatively, once per week per wounded ring, a character may make a TN 3 Fitness check using that ring (ignoring the condition's TN modifiers); if they succeed, remove Lightly Wounded or reduce Severely Wounded to Lightly Wounded."

                #NiHVc2y7rl81y5wlgZAf0z ^"Lightly Wounded" DEF {
                    EFFECTS {
                        "Increase the TN of checks with the affected ring by 1."
                        "If the character suffers Severely Wounded for the same ring, remove this condition."
                        "If the character would suffer Lightly Wounded again for the same ring, remove it and suffer Severely Wounded for that ring."
                    }
                }

                #d8CsSEbadOAex8oyaufvGF ^"Severely Wounded" DEF {
                    EFFECTS {
                        "Increase the TN of checks with the affected ring by 3."
                        "If the character suffers ^\"Lightly Wounded\" or ^\"Severely Wounded\" for the same ring, remove it and suffer the effects of a severity 8 ^\"Critical Strike\" (Permanent Injury) as if they had failed the check to resist it."
                    }
                }
            }
        }

        RULES {
            #L5R414yZ6aB8cD0eF2gH4i: conditions_have_specific_triggers
            #L5R415jK7lM9nO1pQ3rS5t: conditions_have_removal_methods
            #L5R416uV8wX0yZ2aB4cD6e: multiple_conditions_can_stack
        }
    }

    # ===========================
    # COMBAT: SKIRMISH
    # ===========================

    ^"Skirmish" DEF {
        EXTENDS #L5R072cD4eF6gH8iJ0kL2m ^"Conflict Type"

        # Small-scale tactical combat between individual characters
        # and small groups. The primary combat conflict type.
        # Ideal for bar brawls to dramatic encounters between rival groups.
        # Follows the general Conflict Scene pattern with the following
        # additions and alterations.

        # --- INITIATIVE ---
        # The ^"Initiative" check for a skirmish is a TN 1 ^"Tactics" check
        # to gain a read on battlefield conditions and enemy. Characters
        # may spend (op) from this check to get additional information about
        # surroundings or undertake small tasks such as readying weapons or
        # diving for cover (see ^"Opportunity" INITIATIVE_OPPORTUNITIES).
        # Characters act in descending order of initiative value for the scene.
        # Ties broken by lowest ^"Honor" first, then ascending order of honor.

        # --- TAKING TURNS ---
        # Each character takes one turn each round in initiative order.
        # Skirmishes do not have a fixed round limit. When things are
        # clearly going badly for one side, many combatants will retreat
        # and regroup.

        TURN_SUMMARY {
            1 "Choose a ^\"Stance\", which reflects approach to the fight and grants a passive benefit."
            2 "Move 1 ^\"Range Band\". This can be done before or after performing an action."
            3 "Perform an action, such as guarding, maneuvering, striking a foe, or waiting."
        }

        # --- MOVEMENT AND POSITIONING ---
        # Skirmishes make the most detailed use of ^"Range Band" of all
        # conflict types. Once during their turn, before or after performing
        # an action, a character may move 1 range band. This is not an action.
        # To move further, use the Maneuver action.

        # --- SKIRMISH ACTIONS ---

        ACTIONS {

            #oGGFDIa8RqtJe2NN3Sdnnc ^"Assist" DEF {
                DESCRIPTION "You offer an ally a plan of attack, an insight about the foe, or an encouraging word."
                ACTIVATION "As an Attack, Scheme, and Support action, describe how you are helping one other character at range 0-2 with their next action."
                EFFECTS "If the GM accepts your suggestion, you provide ^\"Assistance\" on the chosen character's next action check."
            }

            #b17XzMFrZez9v2AY0QwXpq ^"Calming Breath" DEF {
                DESCRIPTION "During a conflict, you may inhale deeply before exhaling, drawing upon your inner strength."
                ACTIVATION "As a Support action, you may take a deep breath to calm yourself and recover stamina."
                EFFECTS "If your strife is greater than half your ^\"Composure\", you remove 1 strife. If your fatigue is greater than half your ^\"Endurance\", you remove 1 fatigue."
            }

            #zlGqa6pYmA0S5kBa4rvF3S ^"Challenge" DEF {
                DESCRIPTION "You issue a challenge to a foe, calling for them to face you in single combat."
                ACTIVATION "As a Scheme action, make a TN 1 ^\"Command\" check targeting one character at range 0-5. You must stake 10 ^\"Honor\" and 5 ^\"Glory\" upon the challenge, which you forfeit if you sabotage the clash."
                EFFECTS {
                    "If you succeed, the target must choose whether to accept or decline:"
                    "Accept: Target stakes 10 honor and 5 glory, which they forfeit if they take any Attack or Scheme action before the clash. At the end of the round, the clash begins."
                    "Decline: Target must forfeit glory equal to your ranks in ^\"Command\" plus your bonus successes. Each of their allies with lower glory than you suffers 2 strife. You gain 1 ^\"Void Points\"."
                    "If you win the clash, each of your foe's allies in the skirmish suffers 3 strife. If you lose, each of your allies suffers 3 strife."
                }

                #5c0Hjsw4YvoXhdYJWljtAx ^"Clash" DEF {
                    # A clash embeds a ^"Duel" within another scene. Clashes can
                    # arise from the Challenge action or via narrative events.

                    STRUCTURE {
                        1 "Staredown: Characters receive strife equal to the round of the clash and bid strife to increase their current initiative."
                        2 "Take Turns: Character with higher initiative takes a turn, followed by lower value (tied: lowest ^\"Honor\" acts first)."
                        3 "Determine Winner: If a character inflicts ^\"Incapacitated\", ^\"Unconscious\", or ^\"Dying\" on their enemy (or kills them) without suffering any of these, they win. Otherwise, the clash is inconclusive."
                    }

                    FINISHING_BLOWS "Like duels, clashes use the rules for Finishing Blows when a character becomes ^\"Compromised\" or unmasks."

                    INTERRUPTING "Other characters can interrupt a clash before it begins or during the clash. Using the Challenge action on an enemy involved in a clash allows a character to cut in, exchanging themselves for an ally. Any other form of interruption requires the character to forfeit 10 ^\"Honor\". Any participant they helped must also forfeit their staked honor."

                    EXTENDING "After characters clash inconclusively, they may extend the clash by one round. If both characters choose to continue, they skip their turns in initiative order and do not take actions until the clash resumes at the end of the next round. If either character chooses to withdraw, the clash ends."
                }
            }

            #QrbKwsrQ0dpxgSdF5UjOSr ^"Guard" DEF {
                DESCRIPTION "You focus on warding off foes from yourself or an ally by positioning yourself defensively, taking cover, throwing strategically placed strikes, or firing shots menacingly close to the enemy."
                ACTIVATION "As a Support action using a readied weapon, make a TN 1 ^\"Tactics\" check targeting yourself or one other character within the weapon's range."
                EFFECTS "If you succeed, you guard the target until the beginning of your next turn. Increase the TN of Attack checks against the guarded target by one, plus an additional one per two bonus successes."
            }

            #1FZWnmouYtPNNbpzo9e7qY ^"Maneuver" DEF {
                DESCRIPTION "You shift on the battlefield, moving to a more advantageous position."
                ACTIVATION "As a Movement action, you may reposition for more distance. Optionally, you may make a TN 2 ^\"Fitness\" check as part of this action."
                EFFECTS "Move one ^\"Range Band\". If you choose to make the ^\"Fitness\" check and succeed, you may instead move two range bands, plus one additional range band per two bonus successes."
            }

            #wZJNuB9JVSAL4P0j6OaH2o ^"Prepare Item" DEF {
                DESCRIPTION "You prepare, ready, or stow one weapon or other item."
                ACTIVATION "As a Support action, you may interact with one item."
                EFFECTS "Prepare one item for use, ready a weapon in a grip of your choice, or stow an item."
            }

            #OAXhS4ApmH6n28DSnU7tdB ^"Strike" DEF {
                DESCRIPTION "You make an attack against a single foe."
                ACTIVATION "As an Attack action using one readied weapon, make a TN 2 Martial Arts check using the appropriate skill for the weapon, targeting one character within the weapon's range."
                EFFECTS "If you succeed, deal physical damage to the target equal to the weapon's base damage plus your bonus successes."
                NEW_OPPORTUNITIES "(op)(op): If you succeed, you inflict a ^\"Critical Strike\" on your target with severity equal to your weapon's deadliness."
            }

            #btEQjoK5hhytXmFC4kM432 ^"Unique Action" DEF {
                DESCRIPTION "You make a check using a skill for a mechanical or narrative effect."
                ACTIVATION "As an action, make a skill check to attempt a task you have described to the GM."
                EFFECTS "If you succeed, you may use the skill for its narrative effects, for implementing any sample use that can be completed in a single action, or for pursuing another task that the GM deems appropriate."
            }

            #biJZqPViod3oewTLr17Pa7 ^"Wait" DEF {
                DESCRIPTION "You bide your time, waiting to spring into action."
                ACTIVATION "As an Attack, Scheme, and Support action, declare a non-Movement action you will perform after the occurrence of a specified event before the end of the round."
                EFFECTS "After the specified event occurs before the end of the round, you may perform the action. You must still use the ring matching your ^\"Stance\" for this action. If the specified event does not occur this round, you may perform one action of your choice (other than Wait) at the end of the round."
            }
        }

        # --- RESOLVING A SKIRMISH ---
        # A skirmish continues until only one group of combatants remains
        # standing in the field. The GM should conclude a skirmish when one
        # side has vanquished or driven off all their foes, or when it becomes
        # clear that they will claim victory. If a warrior believes they have
        # a chance to escape and survive, most will not voluntarily choose to
        # fight to the death. Honor forfeited when retreating can be regained,
        # but an ignoble death is more enduring.

        RULES {
            #L5R417fG9hI1jK3lM5nO7p: skirmish_round_structure
            #L5R418qR0sT2uV4wX6yZ8a: stance_selection_each_round
            #L5R419bC1dE3fG5hI7jK9l: initiative_determines_turn_order
            #L5R420mN2oP4qR6sT8uV0w: skirmish_actions
            #L5R421xY3zA5bC7dE9fG1h: clash_embedded_duel
            #L5R422iJ4kL6mN8oP0qR2s: free_movement_one_range_band
        }
    }

    ^"Critical Strike" DEF {

        # Particularly deadly blows that slip past a character's defenses
        # to inflict injuries, permanent scars, or even death. When a
        # character fails to defend against damage, they suffer a critical
        # strike. Additionally, some effects inflict critical strikes directly.

        # --- SUFFERING CRITICAL STRIKES ---
        # A critical strike has a severity value dictated by the method
        # by which it was inflicted:
        # - After failing to defend against damage: severity = deadliness
        #   of the source of damage.
        # - From a direct effect: severity specified by the effect
        #   (otherwise, see Unspecified Deadliness).
        #
        # The character must make a TN 1 ^"Fitness" check to mitigate
        # (using a ring of their choice in narrative, or the ring their
        # ^"Stance" dictates in conflict). If they succeed, reduce severity
        # by 1 plus bonus successes (minimum 0). Then consult the
        # severity table.

        UNSPECIFIED_DEADLINESS {
            "Invocations and ^\"Mahō\": Deadliness equal to the value of the ring used for the Attack action check plus kept (st) symbols on that check."
            "^\"Kihō\": 8."
            "Extreme Temperature (Fire, Frostbite, etc.): 5, but each repeated exposure increases by +2."
            "Falls: Deadliness of 7. Very long falls also inflict critical strikes directly."
            "Sufficiently Heavy Objects: Deadliness equal to three times the object's ^\"Silhouette\"."
        }

        SEVERITY_TABLE {
            "0-2" {
                DESCRIPTION "Close Call: The hit slices the character's hair or clothes but fails to draw blood."
                EFFECT "If the character is wearing armor, the armor gains the Damaged quality."
            }
            "3-4" {
                DESCRIPTION "Flesh Wound: The hit sinks into the character's flesh, slicing shallowly or creating a vicious contusion."
                EFFECT "The character suffers ^\"Lightly Wounded\" for the ring used for their check to resist. If the attack had the Razor-Edged quality, also suffers ^\"Bleeding\"."
            }
            "5-6" {
                DESCRIPTION "Debilitating Gash: The hit is agonizing, cutting a deep furrow in the flesh or splitting muscle and fracturing bone. The character will likely need time to recover fully."
                EFFECT "The character suffers ^\"Severely Wounded\" for the ring used for their check to resist. If the attack had the Razor-Edged quality, also suffers ^\"Bleeding\"."
            }
            "7-8" {
                DESCRIPTION "Permanent Injury: The strike leaves the character permanently injured, bearing a scar that will impact them the rest of their life."
                EFFECT "The character suffers ^\"Bleeding\", then chooses one scar disadvantage for the ring used for their check to resist: Air (Maimed Visage or Nerve Damage), Earth (Damaged Organ or Fractured Spine), Fire (Lost Fingers or Maimed Arm), Water (Lost Eye or Lost Foot), Void (Lost Memories)."
            }
            "9-11" {
                DESCRIPTION "Maiming Blow: The character is gravely hurt by the strike and might never fully recover from it."
                EFFECT "The character suffers ^\"Bleeding\", then chooses one scar disadvantage for the ring used for their check to resist: Air (Deafness or Muteness), Earth (Damaged Heart or Damaged Organ), Fire (Lost Arm or Lost Hand), Water (Blindness or Lost Leg), Void (Cognitive Lapses)."
            }
            "12-13" {
                DESCRIPTION "Agonizing Death: The blow is mortal, and the character knows it."
                EFFECT "The character suffers ^\"Severely Wounded\" for the ring used for their check to resist, as well as ^\"Bleeding\" and ^\"Dying\" (3 rounds)."
            }
            "14-15" {
                DESCRIPTION "Swift Death: The character lives just long enough to realize their demise."
                EFFECT "The character suffers ^\"Severely Wounded\" for the ring used for their check to resist, as well as ^\"Bleeding\" and ^\"Dying\" (1 round)."
            }
            "16+" {
                DESCRIPTION "Instant Death: The character dies without even a last word."
                EFFECT "The character dies immediately."
            }
        }

        RULES {
            #L5R424eF6gH8iJ0kL2mN4o: critical_severity_calculation
            #L5R425pQ7rS9tU1vW3xY5z: fitness_resistance_check
            #L5R426aB8cD0eF2gH4iJ6k: shattering_parry_reduces_severity
            #L5R427lM9nO1pQ3rS5tU7v: permanent_injury_effects
        }
    }

    # ===========================
    # COMBAT: DUELS
    # ===========================

    ^"Duel" DEF {
        EXTENDS #L5R072cD4eF6gH8iJ0kL2m ^"Conflict Type"

        # Stylized one-on-one engagements fought to settle disputes that
        # cannot be put to rest with words alone. A duel is fought by
        # individuals, but the fate of families, clans, or the entire
        # realm might ride on a duel. Follows the general Conflict Scene
        # pattern with the following additions and alterations.

        # --- SETTING THE TERMS ---
        # Characters must agree on:
        # - The objective (to the first strike, to incapacitation, to
        #   the death, or another goal).
        # - The weapons and fighting styles allowed.
        # If belligerents cannot agree, the reigning lord (highest
        # ^"Status" present, or the one on whose lands the duel takes
        # place in case of tie) decides the method and stakes.

        COMMON_FORMS {
            #REAHqu3FTQ2JifeFUkIqEn ^"Iaijutsu Duel (to first strike)" DEF {
                DESCRIPTION "Highly ritualized: ceremonial clothes, only katana and wakizashi permitted, blades must begin sheathed (drawn no earlier than first turn)."
                OBJECTIVE "Inflict a ^\"Critical Strike\" on the opponent."
            }
            #m5tvE4robIpbdlPnbiKPZj ^"Iaijutsu Duel (to first blood)" DEF {
                DESCRIPTION "Same ritual as first strike."
                OBJECTIVE "Inflict a ^\"Critical Strike\" of severity 5 or higher on the foe."
            }
            #VGU7W2xB1IvtI2QcEEJSkl ^"Iaijutsu Duel (to the death)" DEF {
                DESCRIPTION "Same ritual as first strike."
                OBJECTIVE "Kill the opponent or inflict ^\"Dying\" on them."
            }
            #iAuFyNGj8mDyVLcfDFFoFG ^"Sparring Bout (to incapacitation)" DEF {
                DESCRIPTION "Practice duels to sharpen skills. Training weapons or blunted weapons expected. Bushi and monks frequently practice these (monks favoring barehanded strikes)."
                OBJECTIVE "Inflict ^\"Incapacitated\" on the foe."
            }
            #juJNBIdcsnRAOjiitnVqfc ^"Warrior's Duel (to defeat)" DEF {
                DESCRIPTION "A rougher sort of duel favored by many rōnin who wish to prove their skill. Any weapons on hand, few regulations."
                OBJECTIVE "Inflict ^\"Unconscious\", ^\"Dying\", or death on the opponent, or get them to yield."
            }
            #DqlnCR0cqqNnsn3U6qgB5W ^"Taryu-Jiai (to incapacitation)" DEF {
                DESCRIPTION "Shugenja duels fought primarily with invocations. Physical strikes permitted by some clans (Crab, Scorpion), forbidden by others (Phoenix, Crane)."
                OBJECTIVE "Inflict ^\"Incapacitated\" on the foe or demonstrate absolute superiority such that the foe surrenders."
            }
        }

        # --- CONCESSION ---
        # At the start of any round, a character may concede, honorably
        # withdrawing from the contest. They have lost for all intents
        # and purposes and are expected to fulfill the terms of defeat.
        # However, the victor may forswear some or all stakes in the name
        # of Compassion (e.g., telling the vanquished to cut their topknot
        # instead of severing their head).

        # --- INITIATIVE ---
        # The ^"Initiative" check for a duel is a TN 1 ^"Meditation" check
        # to attempt to foresee how the duel will transpire. Each character
        # has an initiative value based on results, as usual. However, each
        # round at the start of Phase 2: Take Turns, characters participate
        # in a staredown that modifies initiative.

        #PjMVv0dpUa2ZZ1E27BTxVQ ^"Staredown" DEF {
            # As tension mounts, even the most stoic samurai feel building
            # pressure. This is a special step at the start of Phase 2
            # each round.
            EFFECTS {
                "Each character receives strife equal to the number of the round (1 for round 1, 2 for round 2, etc.)."
                "After receiving this strife, each character who is not ^\"Compromised\" may bid additional strife to increase their initiative value for that round."
                "To bid: each participating character secretly chooses a number between 0 and their ^\"Focus\" attribute. All simultaneously reveal; each suffers that strife and adds it to their initiative for the round."
            }
        }

        # --- TAKING TURNS ---
        # Each character takes one turn each round in order of initiative.
        # Higher initiative acts first. If tied, lower ^"Honor" acts first.
        # At end of round, each character's initiative value resets to its
        # value before the staredown.
        # No fixed round limit. At end of each round, if either character
        # achieved their objective, the duel ends and proceeds to Resolution.

        #0eBxf9vESEBudf6aVs1rXZ ^"Finishing Blow" DEF {
            # As a combatant makes a move, a gap sometimes opens in their
            # defenses, giving their foe a chance to end the fight.
            TRIGGER "The first time their opponent becomes ^\"Compromised\" or unmasks during a duel, a character may immediately execute a finishing blow. This is a special action that can be performed out of turn."
            EFFECTS {
                "Choose an Attack action and perform it against the opponent, interrupting anything the target is doing (including resolving a check — the finishing blow resolves during Step 6 of the ^\"Check\", after (st) symbols are resolved but before (op) is spent)."
                "One finishing blow can interrupt another."
                "If the finishing blow succeeds, instead of dealing damage, it inflicts a ^\"Critical Strike\" with severity equal to two times the deadliness of the weapon or Attack action used, plus the attacker's bonus successes. Other effects of the Attack action resolve as usual."
                "If two characters trigger finishing blows simultaneously (e.g., from staredown strife), the one with the lower ^\"Honor\" fully executes theirs first, then the other executes theirs (assuming they are still alive)."
                "If the duel's objective is achieved by the finishing blow, the duel ends immediately. Otherwise, the duel picks up where it left off."
            }
        }

        # --- MOVEMENT AND RANGE ---
        # At the start, characters move to range 2 from each other. During
        # the duel, each character is considered to be in range of any
        # effect their opponent resolves. At the end, they move to range 2
        # again. Players should narrate movement as they vie for position.

        # --- DUEL ACTIONS ---

        ACTIONS {

            #uRXxuIVup0yZdujHNzGObu ^"Calming Breath" DEF {
                DESCRIPTION "During a conflict, you may inhale deeply before exhaling, drawing upon your inner strength."
                ACTIVATION "As a Support action, you may take a deep breath to calm yourself and recover stamina."
                EFFECTS "If your strife is greater than half your ^\"Composure\", you remove 1 strife. If your fatigue is greater than half your ^\"Endurance\", you remove 1 fatigue."
            }

            #iTWqjNcXVFjn5sKpxcpahI ^"Center" DEF {
                DESCRIPTION "You let the world around you slow as the Void overtakes your senses. Everything but the moment fades as you instinctively seek victory. Your mind weaves through infinite treacherous possibilities to the outcome you desire."
                ACTIVATION "As a Support action in Void ^\"Stance\", you may focus your energy inward, envisioning your action and seeking the perfect moment. You must name a skill when you use Center."
                EFFECTS "Roll a number of Skill dice up to your ranks in the chosen skill and reserve any number of those dice. The next time you make a check using the chosen skill (or use Center) this scene, after rolling dice, you may replace any number of rolled dice with the reserved dice (set to the results they were showing when reserved). You cannot reserve more dice than your ranks in the skill this way."
            }

            #PuqMMyQ2q80ByVO2NRVMRB ^"Predict" DEF {
                DESCRIPTION "You shift subtly to draw a reaction out of your foe by repositioning or signaling a strike you never intend to throw. By predicting your foe's reaction, you aim to win the battle in the mind."
                ACTIVATION "As an Attack and Scheme action, you may secretly select Air, Earth, Fire, or Water and record it."
                EFFECTS "The next time your opponent chooses their ^\"Stance\", you may reveal your selection; if it matches the stance they chose, your opponent receives 4 strife and must choose a different stance. This effect persists until the end of your next turn."
            }

            #BFZnlr0KrIKmbJgZJRZQ15 ^"Prepare Item" DEF {
                DESCRIPTION "You prepare, ready, or stow one weapon or other item."
                ACTIVATION "As a Support action, you may interact with one item."
                EFFECTS "Prepare one item for use, ready a weapon in a grip of your choice, or stow an item."
            }

            #AeneeacnZ3vFmNv2JQI6TB ^"Strike" DEF {
                DESCRIPTION "You make an attack against a single foe."
                ACTIVATION "As an Attack action using one readied weapon, make a TN 2 Martial Arts check using the appropriate skill for the weapon, targeting one character within the weapon's range."
                EFFECTS "If you succeed, deal physical damage to the target equal to the weapon's base damage plus your bonus successes."
                NEW_OPPORTUNITIES "(op)(op): If you succeed, inflict a ^\"Critical Strike\" on your target with severity equal to your weapon's deadliness."
            }
        }

        # --- RESOLVING A DUEL ---
        # A duel ends at the end of any round in which one or more
        # characters achieve their objectives. During Phase 3: Resolution,
        # each participant tallies their score.

        SCORING {
            "Achieved your objective: +6 points"
            "Struck the enemy first: +3 points"
            "Inflicted fatigue on the enemy: +1 point per fatigue"
            "Inflicted one or more critical strikes on the enemy: + points equal to severity of the highest critical strike (after reductions)"
            "Killed the enemy (in a duel to the death only): +14 points"
            "Unmasked: -2 points"
            "Was witnessed cheating: Automatic loss"
        }

        SCORE_RESULTS {
            "0" "No Winner: The duel is a draw. The characters might repeat the duel or retire to tend to wounds."
            "1" "Narrow Victory: The winner seizes the thin margin of victory."
            "2" "Clear Victory: The character who won claims victory definitively."
            "3-6" "Absolute Victory: The character who won gives a clear demonstration of mastery. If the winner receives a glory award, increase it by +3."
            "7+" "No Contest: The character who won demonstrates it was never a contest. If the winner receives a glory award, increase it by +5."
        }

        # --- ONE-ROLL DUELS (OPTIONAL RULE) ---
        ^"One-Roll Duel" DEF {
            EXTENDS #L5R465jK7lM9nO1pQ3rS5t ^"Optional Rule"

            # Fast resolution for groups that don't want tactical duels.
            # Setup: Each combatant describes their intended action, detailing
            # relevant advantages, disadvantages, terrain, and circumstances.
            # Check: Each combatant chooses weapon(s) and makes a competitive
            # check using the appropriate skill and the ring their description
            # dictates. Base TN 1 (adjustable by GM). Treated as an Attack
            # action check targeting the opponent for ability purposes.
            # Resolution: Character with more bonus successes wins.
            # In live-weapon duels, victor inflicts a ^"Critical Strike" with
            # severity = 2× weapon's deadliness + bonus successes. Foe resists
            # as usual. If neither succeeds, the one with lower shortfall wins
            # (inelegantly) and inflicts critical strike at 2× deadliness.
            # If tied, both are considered victorious and defeated; higher
            # severity critical (after resistance) wins. If tied or no
            # criticals, the outcome is inconclusive.
        }

        RULES {
            #L5R428wX0yZ2aB4cD6eF8g: duel_formal_structure
            #L5R429hI1jK3lM5nO7pQ9r: setting_terms_and_concession
            #L5R430sT2uV4wX6yZ8aB0c: staredown_initiative_modification
            #L5R431dE3fG5hI7jK9lM1n: finishing_blow_mechanics
            #L5R432oP4qR6sT8uV0wX2y: duel_scoring_and_resolution
        }
    }

    # ===========================
    # COMBAT: INTRIGUE
    # ===========================

    ^"Intrigue" DEF {
        EXTENDS #L5R072cD4eF6gH8iJ0kL2m ^"Conflict Type"

        # Social engagements: persuading the opposition, gathering favor
        # from superiors, sowing the seeds of plots, or subtly besmirching
        # rivals' reputations. How the fortunes of clans rise and fall.
        # Follows the general Conflict Scene pattern with the following
        # additions and alterations.

        # --- SOCIAL OBJECTIVES ---
        # Overarching goals that give an intrigue structure and tell the
        # GM when the intrigue should draw to a close. Use momentum
        # points to track progress toward goals.
        #
        # At the start of Phase 1: Initiative, each participating character
        # may choose a social objective. Any number of characters can
        # pursue the same objective. PCs may confer, then each decides
        # and informs the GM. The GM decides objectives for adversary
        # NPCs (but does not reveal them). Minion NPCs generally do not
        # need objectives.

        SOCIAL_OBJECTIVES {

            #Slhl2C3zdGZbUeI9trUCvl ^"Appeal to a Person or Group" DEF {
                DESCRIPTION "Convince someone to behave in a certain way — backing a claim, coming to terms, swaying a judge, or winning wide support. State target and desired outcome at outset."
                COMPLETION "Accumulate momentum points equal to or exceeding the difficulty value on successful Social skill checks against the target. The GM sets the difficulty (target's ^\"Focus\" is a good starting value, adjustable for stubbornness or innate resistance)."
                ACHIEVED "At end of any round with sufficient momentum, the target is persuaded. If another character has more momentum at that time, their perspective wins instead. Ties broken by highest ^\"Status\"."
                FAILURE "Cannot be completed if: target retires from scene before completion, certain unmask events occur, grave offense is given, or significant interruptions make it impossible."
            }

            #iw1meZrdllTxY36NzxjFQL ^"Discern Someone's Qualities" DEF {
                DESCRIPTION "Ferret out strengths, weaknesses, or loyalties of another character. Goes deeper than understanding their social objective. State target and which features you want to uncover."
                COMPLETION "Accumulate momentum points equal to or exceeding the difficulty value on appropriate Social skill checks against the target (or other skills like ^\"Culture\" or ^\"Sentiment\"). The GM sets the difficulty (target's ^\"Vigilance\" is a good starting value, adjustable for wariness)."
                ACHIEVED "Learn up to three of the following about the target: social objective, ^\"Ninjō\", giri, ^\"Composure\", ^\"Endurance\", one advantage, one disadvantage. The same option cannot be selected multiple times."
                FAILURE "Cannot be completed if target retires from scene before completion."
            }

            #VHomrwGcfHnrCECehpNTZ5 ^"Discredit Someone" DEF {
                DESCRIPTION "Provoking enemies to force them into positions where they must accept a loss lest their reputation suffer. State target at outset."
                COMPLETION "Cause the target to become ^\"Compromised\" (by inflicting strife via (op) spends and techniques)."
                ACHIEVED "When the target unmasks, they must forfeit ^\"Glory\" equal to their glory rank (humiliated or shamed) unless they retire from the intrigue, and the objective is considered complete."
                FAILURE "Cannot be completed if target retires before completion. Note: provocation makes it hard to get the target's support, and many samurai respond to this humiliation with a demand for a ^\"Duel\" — or a dagger in the night."
            }

            #hX6bXtH52IJAxkFzVCJI4E ^"Spread a Rumor" DEF {
                DESCRIPTION "Place a rumor in a group to lay groundwork for future victories or lead foes astray. State the rumor at outset."
                COMPLETION "Accumulate momentum points equal to or exceeding the difficulty value on appropriate Social skill checks. No two checks can target the same character (the rumor must appear to come from multiple sources). The GM sets the difficulty (^\"Vigilance\" of the highest-^\"Status\" character in the scene is a good starting value, adjustable for disposition toward the rumor)."
                ACHIEVED "The rumor becomes self-sustaining within the group. Not everyone necessarily believes it, but they discuss it — it is too reputable or intriguing to fully ignore."
                FAILURE "If the character fails at two consecutive checks to spread the rumor, it fails to take root and cannot be completed this scene."
            }
        }

        # --- INITIATIVE ---
        # The ^"Initiative" check for an intrigue is a TN 1 ^"Sentiment"
        # check to politely probe other characters' strengths, weaknesses,
        # and objectives.
        #
        # Intrigues are relatively freeflowing: each character takes one
        # turn when they see fit during each round, rather than at an
        # appointed time. Initiative values come into play when two or more
        # characters wish to act simultaneously — highest initiative acts
        # first. A character must forfeit 1 ^"Honor" and 1 ^"Glory" to
        # preempt characters of higher ^"Status" (and may suffer further
        # narrative ramifications).

        # --- TAKING TURNS ---
        # Each character takes one turn each round whenever they see fit.
        # A character who does not wish to take a turn may pass. Once each
        # character has taken a turn or passed, play proceeds to the next
        # round. No fixed round limit; moves to Resolution once all
        # objectives have been achieved or clearly cannot be achieved.

        TURN_SUMMARY {
            1 "Choose a ^\"Stance\", which reflects physical posture, tone, and rhetorical approach."
            2 "Move a short distance within the scene, before or after performing an action."
            3 "Perform an action, such as convincing someone or spreading a rumor to achieve a social objective."
        }

        # --- MOVEMENT AND POSITIONING ---
        # Characters can generally be assumed to be within range to resolve
        # effects. Movement need not be closely tracked unless relevant.
        # If it becomes relevant, the GM adjudicates distances in
        # ^"Range Band" units.

        # --- INTRIGUE ACTIONS ---

        ACTIONS {

            #nbio9K0V7z8QlYQ0sh3tec ^"Assist" DEF {
                DESCRIPTION "You offer an ally an argument they might use, an insight about the opposition, or a novel idea."
                ACTIVATION "As an Attack, Scheme, and Support action, describe how you are helping one other character at range 0-2 with their next action."
                EFFECTS "If the GM accepts your suggestion, you provide ^\"Assistance\" on the chosen character's next action check."
            }

            #JFUWXAUWYwHeSVhCJTVCqs ^"Calming Breath" DEF {
                DESCRIPTION "During a conflict, you may inhale deeply before exhaling, drawing upon your inner strength."
                ACTIVATION "As a Support action, you may take a deep breath to calm yourself and recover stamina."
                EFFECTS "If your strife is greater than half your ^\"Composure\", you remove 1 strife. If your fatigue is greater than half your ^\"Endurance\", you remove 1 fatigue."
            }

            #kgMVpEHjbu9a25Gsi9gKpI ^"Persuade" DEF {
                DESCRIPTION "You attempt to foster or quell an idea, emotion, or desire in a person."
                ACTIVATION "As a Scheme action, make a Social skill check targeting one or more characters who can hear you. The TN equals the highest ^\"Vigilance\" among your targets."
                TN_MODIFICATIONS {
                    "^\"Command\": Present a plan with authority. If each target's status rank is lower than yours, decrease TN by 1."
                    "^\"Courtesy\": Present a proposal with honeyed words and clever implications. If each target's status rank is higher than yours, decrease TN by 1."
                    "^\"Games\"/^\"Performance\"/Other Skills: Offer a diversion from affairs at hand. If each target's status rank is equal to yours, decrease TN by 1."
                }
                EFFECTS "If you succeed, add one momentum point toward an appropriate social objective, plus one additional momentum point for every two bonus successes. Any narrative ramifications of the check also resolve."
            }

            #jca7tLFPQEaChegGnvOk88 ^"Unique Action" DEF {
                DESCRIPTION "You make a check using a skill for a mechanical or narrative effect."
                ACTIVATION "As an action, make a skill check to attempt a task you have described to the GM."
                EFFECTS "If you succeed, you may use the skill for its narrative effects, for implementing any sample use that can be completed in a single action, or for pursuing another task that the GM deems appropriate."
            }
        }

        # --- RESOLVING AN INTRIGUE ---
        # The GM should end an intrigue once all characters' social
        # objectives have been achieved or clearly failed, or the
        # characters pursuing them decide to let them drop for narrative
        # reasons. Then proceeds to Phase 3: Resolution.

        RULES {
            #L5R433zA5bC7dE9fG1hI3j: intrigue_social_conflict
            #L5R434kL6mN8oP0qR2sT4u: social_objectives_and_momentum
            #L5R435vW7xY9zA1bC3dE5f: vigilance_is_persuade_tn
            #L5R436gH8iJ0kL2mN4oP6q: freeflowing_initiative_order
        }
    }

    # ===========================
    # COMBAT: MASS BATTLE
    # ===========================

    ^"Mass Battle" DEF {
        EXTENDS #L5R072cD4eF6gH8iJ0kL2m ^"Conflict Type"

        # Large-scale warfare with abstracted armies. Characters contribute
        # as commanders and leaders directing cohorts. Follows the general
        # Conflict Scene pattern with the following additions and alterations.

        # --- ARMIES ---
        # Abstracted representations of large groups of warriors including
        # general acumen, training, and equipment. Like characters, armies
        # possess attributes and abilities.

        ARMY_ATTRIBUTES {
            #zehJFGxzccIYSucB441pIv ^"Strength" DEF {
                DESCRIPTION "Abstraction of the army's ability to absorb casualties without ceasing to function. Measured against casualties (which function like fatigue for a character). Attacks deal attrition, from which casualties are applied after reductions."
                RANGE "1-100"
                COLLAPSE "At end of each round, if casualties exceed strength, the army is routed."
            }
            #01eFIKLjptJBdnKWwJfXT9 ^"Discipline" DEF {
                DESCRIPTION "Reflection of the army's psychological state and ability of troops to remain in the field. Measured against panic (which accumulates like strife for an individual)."
                RANGE "1-100"
                COLLAPSE "At end of each round, if panic exceeds discipline, the army suffers a morale collapse."
            }
        }

        # --- COMMANDERS ---
        # Each army has one commander who directs the entire army.
        # Selected during Phase 1: Initiative. Characters with lower
        # ^"Status" are expected to defer to those with higher status.
        # At the beginning of each round, the commander selects the
        # army's strategic objective for the round.
        # If a commander is killed, the army suffers 10 panic. Then the
        # character with highest ^"Status" assumes command (or appoints
        # someone else).

        # --- LEADERS AND COHORTS ---
        # Each leader commands a relatively independent chunk of the army
        # called a cohort. The commander chooses leaders during Phase 1.
        # Generally each PC should be a leader. Each cohort is defined by
        # its leader for targeting and effects. Cohorts do not usually
        # suffer casualties directly; casualties apply to overall army
        # strength. Terrain qualities affect cohorts that occupy them
        # (damage becomes attrition).

        # --- STRATEGIC OBJECTIVES ---
        # At the beginning of each round, each commander chooses one
        # strategic objective. Leaders must take actions to accrue
        # momentum points toward the goal. Once fulfilled, that objective
        # cannot be chosen again for three rounds. If not completed, it
        # may be selected again with progress continuing.
        # When a leader's action completes an objective, that leader is
        # awarded 3 ^"Glory".

        STRATEGIC_OBJECTIVES {

            #8QkTIG9G90Lz3fPtW8s6dL ^"Capture a Position" DEF {
                DESCRIPTION "Uproot the enemy from a specific fortification or piece of terrain they occupy."
                MOMENTUM "After a leader performs an Assault action against the enemy cohort occupying the fortification, the army accrues 1 momentum point per casualty the enemy army suffered."
                FULFILLED "After accruing momentum points equal to or exceeding the fortification's difficulty value. Alternatively, if the enemy vacates and a friendly leader successfully performs Reinforce there."
                COMPLETION "The enemy cohort is driven out. The completing leader may have their cohort occupy the fortification immediately."
            }

            #EzxTLyBzXrB1MdnmreQP1L ^"Cut Off the Head" DEF {
                DESCRIPTION "Corner and kill a particular enemy leader. Difficulty value equals the target's ^\"Focus\" attribute."
                MOMENTUM "After a leader performs an Assault action against the enemy leader's cohort, the army accrues 3 momentum points."
                FULFILLED "When momentum equals or exceeds the difficulty value, the completing leader may perform a ^\"Finishing Blow\" on the target as if fighting a ^\"Duel\". Alternatively, fulfilled if one of the army's leaders kills the target in a ^\"Clash\" via Challenge."
                COMPLETION "Against an enemy leader: enemy army suffers 10 panic. Against the enemy commander: enemy army suffers 20 panic."
            }

            #lvscZubgLeRhGKGORlde04 ^"Draw Them In" DEF {
                DESCRIPTION "Draw the foe into attacking a hardened position, preparing for a counterattack."
                MOMENTUM "After an enemy leader attacks a friendly cohort and it suffers 3 or fewer casualties: 1 momentum point. After an enemy leader Challenges or accepts a Challenge from a friendly leader: 1 momentum point."
                FULFILLED "After accruing momentum points equal to or exceeding the enemy commander's ^\"Vigilance\"."
                COMPLETION "Enemy army suffers 5 panic. During the next round, double all attrition the army's leaders inflict."
            }

            #rWMU2PvoDdd8q2T5gmNtIj ^"Grind Them Down" DEF {
                DESCRIPTION "Focus on inflicting harm to weaken enemy forces and break their resolve."
                MOMENTUM "After a leader performs an Assault action against any enemy cohort, the army accrues 1 momentum point per casualty the enemy army suffered."
                FULFILLED "After accruing momentum points equal to the enemy commander's ^\"Glory\" rank plus ranks in ^\"Command\"."
                COMPLETION "Enemy army suffers 10 panic."
            }

            #sdsk9GuNedsoXmAzVhl9il ^"Seize Victory!" DEF {
                DESCRIPTION "Deliver a final blow to the enemy army. Can only be declared after a number of other strategic objectives have been fulfilled during the battle (GM sets number; 3 recommended)."
                MOMENTUM "After a leader performs an Assault action against any enemy cohort, the army accrues 1 momentum point per casualty the enemy army suffered."
                FULFILLED "After accruing momentum points equal to or exceeding the enemy commander's ^\"Focus\" plus ranks in ^\"Tactics\"."
                COMPLETION "The enemy army is driven back and must retreat from the field. While not completely destroyed, it can no longer achieve meaningful victory."
            }
        }

        # --- INITIATIVE ---
        # 1. Choose Commander: Each army selects its commander.
        # 2. Initiative Check: Commander makes a TN 1 ^"Command" check
        #    to marshal and organize forces.
        # 3. Select Leaders: Commander chooses leaders (may personally
        #    be one). Must choose at least one leader.

        # --- TAKING TURNS ---
        # At start of Phase 2, the commander with the higher initiative
        # decides if their army moves first or waits. If tied, lower
        # ^"Honor" must move first. Then, starting with the first army,
        # each commander alternates nominating one leader who has not
        # acted yet to act.
        # At the beginning of each round, each commander selects the
        # strategic objective. A PC commander unsure what to do may make
        # a ^"Tactics" check with TN equal to enemy commander's ^"Vigilance"
        # for insight.

        # --- MASS BATTLE ACTIONS ---

        ACTIONS {

            #AvtB1o0w96jOWlZ87XtXW6 ^"Assault" DEF {
                DESCRIPTION "You move your cohort to a particular position, attacking the cohort of a chosen enemy leader."
                ACTIVATION "As an Attack and Movement action, make a TN 2 ^\"Tactics\" check targeting one enemy leader's cohort."
                EFFECTS "If you succeed, deal attrition to the enemy army equal to your ranks in ^\"Command\" plus your bonus successes."
            }

            #RSxYviCSnIiIrJ89BM8aX9 ^"Challenge" DEF {
                DESCRIPTION "You stride to the forefront of your force, bellowing a challenge to the enemy leader."
                ACTIVATION "As a Movement and Scheme action, make a TN 1 ^\"Command\" check targeting one enemy leader."
                EFFECTS {
                    "If you succeed, stake 10 ^\"Honor\" and 5 ^\"Glory\" (forfeit if you sabotage the clash). Target must accept or decline:"
                    "Accept: Target stakes 10 honor and 5 glory (forfeit if they take Attack or Scheme before the clash). At end of round, enter a ^\"Clash\"."
                    "Decline: Target forfeits glory equal to your ranks in ^\"Command\" plus bonus successes. Their army suffers 3 panic. You gain 1 ^\"Void Points\"."
                    "If you win the clash, enemy army suffers 5 panic. If you lose, your army suffers 5 panic."
                }
            }

            #oNjP0yTkNc0ulghfrlWoDP ^"Rally" DEF {
                DESCRIPTION "You command your troops to regroup and support an allied contingent."
                ACTIVATION "As a Support action, make a TN 1 ^\"Command\" check targeting one friendly leader's cohort."
                EFFECTS "If you succeed, your army removes 1 panic, plus 1 additional panic per bonus success. Whether you succeed or fail, the target counts as having ^\"Assistance\" on their next check before end of scene."
            }

            #v0Qtnt9o44hDqZ6rEGOPtv ^"Reinforce" DEF {
                DESCRIPTION "You call for your troops to dig in and hold a position at all costs."
                ACTIVATION "As a Movement and Support action, make a TN 2 ^\"Tactics\" check to have your cohort dig in at one chosen position."
                EFFECTS "If you succeed, increase the TN of Attack action checks targeting your cohort by 1, plus an additional 1 per two bonus successes. Persists for one round. If you choose an unoccupied fortification or terrain, you are considered occupying it until you narratively leave or perform an action other than Challenge or Reinforce."
            }
        }

        # --- RETREATING ---
        # As an action, a character can retreat from a mass battle.
        # Must forfeit 10 ^"Honor". Must also forfeit 10 ^"Glory" if
        # anyone knows they willingly retreated. If they leave their
        # cohort leaderless, the army suffers 10 panic.
        # If ordered to retreat by their lord, must stake 10 honor and
        # 10 glory on completing whatever other task their lord assigned.

        # --- READIED WEAPONS ---
        # At the start of each round, each character may choose one
        # (or two, if both are used one-handed) weapons to count as
        # readied for the round.

        # --- ANNIHILATING A COHORT ---
        # At GM's discretion, if a cohort suffers casualties greater
        # than a quarter of the army's total strength from a single
        # action, it is wiped out. Its leader suffers a ^"Critical Strike"
        # with severity 12, and the cohort ceases to exist.

        # --- RESOLVING A MASS BATTLE ---

        RESOLUTION {
            ^"Rout" "If casualties exceed strength at end of round: all minion NPCs killed or scattered. Each PC and adversary NPC suffers a ^\"Critical Strike\" with severity 12. At GM's discretion, PCs may be captured or left for dead."
            ^"Morale Collapse" "If panic exceeds discipline: the army breaks apart. Each PC and adversary NPC can escape in the confusion."
            ^"Strategic Victory" "If an army achieves the Seize Victory! objective, it wins at end of round. Other armies that did not suffer rout or morale collapse withdraw relatively intact."
        }

        # --- BATTLE LENGTH AND FATIGUE ---
        # Mass battle rounds are long in fictional time; six rounds cover
        # a full day of fighting. After six rounds, armies generally
        # withdraw to camps. If a commander decides to remain in the field,
        # during Phase 1 of the seventh round and each subsequent round,
        # the commander must make a TN 4 ^"Command" check. If they fail,
        # the army suffers 10 panic plus panic equal to the commander's
        # shortfall.

        # --- FORTIFICATIONS ---

        FORTIFICATIONS {
            "Woods or Defensive Terrain" "Reduce attrition suffered by 1. Difficulty Value 4."
            "Outpost" "Reduce attrition suffered by 2. Difficulty Value 6."
            "Fortress" "Reduce attrition suffered by 3. Difficulty Value 8."
            "Castle" "Reduce attrition suffered by 4. Difficulty Value 12."
        }

        # --- EXAMPLE ARMIES ---

        EXAMPLE_ARMIES {

            #6wiDT3WlyH7aY9jLDbvNW1 ^"Peasant Levy" DEF {
                STRENGTH 35
                DISCIPLINE 20
                ABILITY "Conscripted: Each leader in this army increases the TN of their Attack actions by 1."
            }

            #RmyxnwpM0zXMKC5FUEi3Mo ^"Ashigaru Army" DEF {
                STRENGTH 55
                DISCIPLINE 30
                ABILITY "Rank Formation: When a leader performs the Reinforce action, they may spend (op)+: After an enemy cohort attacks this leader's cohort, the enemy army suffers attrition equal to (op) spent this way."
            }

            #a3JPzu8bRlfbfAugWXxfew ^"Elite Samurai Army" DEF {
                STRENGTH 50
                DISCIPLINE 45
                ABILITY "Hardened Veterans: When this army would remove 1 or more panic, it may remove an amount equal to the ^\"Glory\" rank of its commander instead."
                ABILITY "Elite Training: Each cohort confers one ability upon its leader: Cavalry (after Assault success, enemy suffers panic equal to ^\"Survival\" ranks), Siege Specialists (Rally success adds bonus successes equal to ^\"Labor\" ranks), Infantry (Assault success adds bonus successes equal to ^\"Command\" ranks), Archers (after Reinforce success, enemy suffers panic equal to ^\"Tactics\" ranks), Mystics (after Rally or Reinforce success, remove casualties or panic equal to ^\"Theology\" ranks)."
            }

            #w4fJD0jjCGKFjkqtzxeQek ^"Shadowlands Horde" DEF {
                STRENGTH 65
                DISCIPLINE 40
                ABILITY "Relentless: This army does not suffer the effects of battle fatigue."
                ABILITY "Monstrous Enemies: At end of each round, each opposing army suffers panic equal to this army's leader's ranks in ^\"Command\"."
                ABILITY "Wake of the Shadowlands: After a mass battle against this army, the battlefield becomes Defiled terrain."
            }
        }

        RULES {
            #L5R437rS9tU1vW3xY5zA7b: mass_battle_round_structure
            #L5R438cD0eF2gH4iJ6kL8m: commanders_and_leaders
            #L5R439nO1pQ3rS5tU7vW9x: strategic_objectives_and_momentum
        }
    }

    # ===========================
    # ITEM QUALITIES
    # ===========================

    ^"Item Quality" DEF {
        APPLIES TO [^"Item", ^"Weapon", ^"Armor", ^"Equipment"]

        ENUM ["Ceremonial", "Concealable", "Cumbersome", "Damaged",
              "Destroyed", "Durable", "Forbidden", "Mundane", "Prepare",
              "Razor-Edged", "Resplendent", "Sacred", "Snaring", "Subtle",
              "Unholy", "Wargear"]

        # Qualities common to weapons, armor, and other items.

        QUALITY_DEFINITIONS {

            #uIRgHk0etPyar1cQv5kz1S ^"Ceremonial" DEF {
                DESCRIPTION "Ceremonial equipment is indicative of the wearer's rank. It can be brought into many contexts in which similar items might not be allowed. Rarely, a character might be loaned a Ceremonial item to provide them with authority during a task."
                EFFECTS {
                    "While wearing one or more Ceremonial items openly, reduce TN of checks to convince others of your real or assumed identity as the known owner of that item (or one of their allies) by 1."
                    "At the end of any scene in which you use a Ceremonial item of a character with higher ^\"Status\" without their permission, you must forfeit 3 ^\"Honor\"."
                }
            }

            #e4W84znBgK7VUbxbSXoBx8 ^"Concealable" DEF {
                DESCRIPTION "Some weapons and armor are easy to hide on one's person, due to size or deliberate design."
                EFFECTS {
                    "Unless explicitly worn openly or revealed for use, a Concealable item is assumed to be hidden."
                    "When observing the wearer of a hidden item, a character must succeed at a TN 3 Design (Air) or Smithing (Air) check to discern that the wearer is armed or armored. If the onlooker succeeds with two or more bonus successes, they also determine the type of the hidden item."
                    "Concealable armor can be worn under loose-fitting clothes, but you can only benefit from the resistance and qualities of one set of armor at a time."
                    "Concealable weapons can be drawn more quickly in combat. As part of an Attack action, you may ready or sheathe one Concealable weapon."
                }
            }

            #tDEtlFKC5GFWbnq93X3jBZ ^"Cumbersome" DEF {
                DESCRIPTION "This item is heavy or unwieldy, and impossible to conceal on one's person."
                EFFECTS {
                    "While wearing Cumbersome armor, increase the TN of your checks to maneuver in your environment (such as Movement action checks) by 1."
                    "If you moved this turn, increase the TN of Attack action checks using a Cumbersome weapon by 1."
                }
            }

            #xa4pq0CCokYeQWs7xH39Lx ^"Damaged" DEF {
                DESCRIPTION "Samurai must carefully maintain their kit in the field, for routine wear and tear will eventually ruin nearly any tool."
                EFFECTS {
                    "If a weapon or tool becomes Damaged, increase the TN of checks to use it by 1."
                    "If armor becomes Damaged, reduce all resistances it provides by 2 (to a minimum of 0)."
                    "If a Damaged item becomes Damaged again, it loses Damaged and becomes ^\"Destroyed\" instead. If it becomes Destroyed for any other reason, it also loses Damaged."
                }
            }

            #rAdUwjlydMfeaxcD1E7vJU ^"Destroyed" DEF {
                DESCRIPTION "Extreme events or long use without maintenance can shatter, tear, or otherwise render an item nonfunctional."
                EFFECTS {
                    "A Destroyed item is broken and cannot be used for its intended function. It might still be usable as an improvised weapon or tool, at the GM's discretion."
                }
            }

            #BDhaomnuWyyyG3qqTPzQOX ^"Durable" DEF {
                DESCRIPTION "Items crafted to last can endure damage that would destroy less well-made works."
                EFFECTS {
                    "If a Durable item would become ^\"Damaged\", it loses Durable instead."
                    "If a Durable item would be ^\"Destroyed\", it loses Durable and becomes Damaged instead."
                }
            }

            #WRayrO85CqxgWksVR2blpi ^"Forbidden" DEF {
                DESCRIPTION "Rokugani laws are unforgiving, and many things are contraband. This includes many illicit substances, heretical art or literature, and foreign items that have not been transported through strictly regulated trade routes."
                EFFECTS {
                    "At the end of any scene in which you used a Forbidden item openly in public, you must forfeit 3 ^\"Glory\"."
                }
            }

            #W5tVWRWS2e8RBJU0e9oiNb ^"Mundane" DEF {
                DESCRIPTION "Mundane items are objects found in all contexts of daily life, and are permitted to anyone in most social contexts (within reason). People in many walks of life need tools like knives, walking sticks, and wheat threshers, even if these items can be utilized to deadly effect by someone sufficiently determined."
                EFFECTS {
                    "Wearing a Mundane item openly has no additional effects, though onlookers still take note of the fact that you are armed if the item could be used as a weapon."
                }
            }

            #EzinEGvOCVbBoRJT8Y9Ags ^"Prepare" DEF {
                DESCRIPTION "This item must be reloaded, reset, or otherwise prepared after use."
                EFFECTS {
                    "After you use this item, you cannot use it again until it has been prepared. As a Support action, while it is readied, you may prepare this item for use."
                }
            }

            #Gx20jNeMz0SksUV5ZU3jlM ^"Razor-Edged" DEF {
                DESCRIPTION "Some weapons are particularly sharp, and thus brittle, and must be carefully honed to keep functioning at their best. The traditional Rokugani katana is one such weapon — its keen edge lets it hew off limbs more easily than other swords, but it is also more susceptible to damage if swung carelessly at armored foes."
                EFFECTS {
                    "When you succeed at an Attack action check that deals damage to a target using a Razor-Edged item, if the damage dealt is reduced to 0 before they defend, this item becomes ^\"Damaged\"."
                    "When you make an Attack action check with a Razor-Edged weapon, you may spend (op) as follows: +(op): Treat the deadliness of this weapon as 1 higher per (op) spent this way."
                }
            }

            #f6OKAuw99JteJoAXUVidE5 ^"Resplendent" DEF {
                DESCRIPTION "An item with the Resplendent quality is embellished to attract attention to its presenter or wearer."
                EFFECTS {
                    "While wearing one or more Resplendent items, if you would be awarded 1 or more ^\"Glory\", you receive that amount of glory plus 1 instead."
                }
            }

            #uD3feLPnnJ68NIp81mUXrj ^"Sacred" DEF {
                DESCRIPTION "Items with the Sacred quality are imbued with purifying power — often in the form of jade, the mystical stone said to be the tears shed by Amaterasu, the goddess of the sun and protector against the terror of the night. Such items are anathema to the denizens of the Shadowlands and other horrors that prey upon humanity."
                EFFECTS {
                    "When an Otherworldly being makes an Attack or Intrigue action check targeting the wearer of one or more Sacred items, increase the TN by 1."
                    "While you are carrying one or more Sacred items, if you would gain the ^\"Afflicted\" condition, you must choose one of those items to become ^\"Damaged\" instead."
                    "Sacred weapons ignore all resistances possessed by Otherworldly and Tainted beings."
                }
            }

            #GkS87nbmG2EApz8kZh3T19 ^"Snaring" DEF {
                DESCRIPTION "Flexible or, in some cases, harshly curved weapons are excellent for snaring, grabbing, and disarming."
                EFFECTS {
                    "When performing an Attack action with a Snaring weapon, you may spend (op) as follows: +(op): One target of the attack with vigilance lower than or equal to the (op) spent this way suffers the ^\"Immobilized\" condition."
                }
            }

            #NCBD8IJ4o2jolp4giQwaqm ^"Subtle" DEF {
                DESCRIPTION "An item with the Subtle quality is made to not stand out, and people tend to overlook it."
                EFFECTS {
                    "Increase the TN of checks to ascertain information about the item by 1. At the GM's discretion, this also applies to checks to discern what the creator or wearer of the piece intends by presenting it, or to learn anything of value about that person from it."
                }
            }

            #XPOnz4Cx1qn8O01uM3HaGg ^"Unholy" DEF {
                DESCRIPTION "Some physical artifacts carry a dreadful miasma. They may have been tainted by direct exposure to the power of the Shadowlands or by foul rituals, but some are made with obsidian, said to be the shed blood of Onnotangu, the god of the moon and ancient foe of the Kami."
                EFFECTS {
                    "After a character suffers a ^\"Critical Strike\" from an Unholy weapon, they suffer the ^\"Afflicted\" condition."
                    "At the end of each scene in which you use an Unholy item, you suffer the ^\"Afflicted\" condition."
                    "Unholy weapons ignore all resistances possessed by Otherworldly beings."
                }
            }

            #Ep67JqOjQzM2Vfltk9vTzw ^"Wargear" DEF {
                DESCRIPTION "Implements seen in battle and few other contexts — items with the Wargear quality — are decidedly inappropriate for most social contexts. Wargear makes people nervous, which impedes efforts at diplomacy."
                EFFECTS {
                    "Whenever another character suffers 1 or more strife due to the actions of someone wearing one or more Wargear items, they suffer that amount plus 1 instead."
                }
            }
        }

        # --- CANCELLING ITEM QUALITIES ---
        # Multiple instances of the same item quality do not stack.
        # If an item would gain one quality, it loses the other instead.
        CANCELLING_PAIRS {
            "Concealable and Cumbersome"
            "Ceremonial and Mundane"
            "Damaged and Durable"
            "Resplendent and Subtle"
            "Subtle and Wargear"
            "Sacred and Unholy"
        }
        # Removing the new quality and restoring the old one requires
        # a TN 2 Artisan (Earth) check using an appropriate skill.

        RULES {
            #L5R440aY2aB4cD6eF8gH0i: item_quality_definitions
            #L5R440bZ3bC5dE7fG9hI1j: cancelling_item_qualities
        }
    }

    # ===========================
    # WEAPONS
    # ===========================

    ^"Weapon" DEF {
        APPLIES TO [^"Samurai", ^"Adversary"]

        # It is said that the sword is "the soul of the samurai." On the
        # field, a samurai might wield numerous different armaments — a bow
        # to hit targets from afar, a spear to strike from horseback, or a
        # katana to cut down foes in the bloody fray.

        # --- ATTRIBUTES OF A WEAPON ---
        # Category: The archetype (swords, polearms, bows, etc.). Some
        #   techniques require specific categories.
        # Name: The name of the weapon.
        # Skill: The specific skill used to wield the weapon, usually one
        #   of: Martial Arts [Melee], [Ranged], or [Unarmed].
        # Range (RNG): The distance in range bands at which an attacker
        #   can hit a target. A single number or range of values. Range is
        #   both a maximum AND a minimum; a target closer than the lowest
        #   value is not considered in range.
        # Base Damage (DMG): How quickly blows wear a defender down.
        #   Attack actions frequently reference this value.
        # Deadliness (DLS): The lethality of the weapon. High deadliness
        #   more easily inflicts gruesome injuries or death (see ^"Critical Strike").
        # Grips: The ways to wield the weapon. If multiple grips are listed,
        #   each shows any alterations to base attributes for that grip.
        # Qualities: Any additional effects (see ^"Item Quality").
        # Rarity: How difficult the item is to find (1 = common, 9 = legendary).
        # Price: The cost to acquire.

        PROPERTIES {
            ^"Name" STRING REQUIRED
            ^"Category" STRING  # Swords, Axes, Blunt Weapons, Hand Weapons, Polearms, Bows, Crossbows, Specialist Weapons
            ^"Skill" STRING  # Martial Arts [Melee], [Ranged], or [Unarmed]
            ^"Range" STRING  # Range band(s), e.g. "1" or "0-1" or "2-5"
            ^"Base Damage" INTEGER MIN 0 MAX 10
            ^"Deadliness" INTEGER MIN 0 MAX 10
            ^"Grips" STRING  # Grip options and attribute modifications per grip
            ^"Qualities" LIST OF STRING  # References ^"Item Quality" values
            ^"Rarity" INTEGER MIN 1 MAX 9
            ^"Price" STRING
            ^"Description" STRING  # Verbatim narrative flavor (no mechanical effect)
        }

        # --- READIED WEAPONS ---
        # A weapon is readied if a character is physically prepared to use
        # it offensively and defensively. A character may ready a weapon at
        # will during narrative time, or as an action during a conflict scene.
        # When readying weapons, a character may choose any number of
        # weapons at range 0-1 they can hold at once. Maximum: one pair of
        # 1-handed grip weapons (one in each hand) or a single 2-handed
        # grip weapon. Readied weapons remain readied until the character
        # sheathes, relinquishes, or drops them.
        # When readying a weapon, the character must choose one of its
        # grips; they may switch grips whenever they have the chance to
        # ready a weapon.

        # --- SHEATHED WEAPONS ---
        # A weapon is sheathed if it is on a character's person, properly
        # stowed for access but not yet readied. A character can sheathe
        # a weapon at will during narrative time, or as an action during
        # a conflict scene.

        # ==================
        # MELEE WEAPONS
        # ==================

        # Format: Name, Skill, Range, Damage, Deadliness, Grips, Qualities, Rarity, Price

        # --- SWORDS ---
        SWORDS {
            #SYqNiaIsD00qkid7tdRJmK ^"Bokken" DEF {
                PROPERTIES {
                    ^"Category" STRING "Swords"
                    ^"Skill" STRING "Martial Arts [Melee]"
                    ^"Range" STRING "1"
                    ^"Base Damage" INTEGER 3
                    ^"Deadliness" INTEGER 3
                    ^"Grips" STRING "1-hand: –; 2-hand: Damage +2"
                    ^"Qualities" LIST OF STRING ["Mundane"]
                    ^"Rarity" INTEGER 3
                    ^"Price" STRING "1 bu"
                    ^"Description" STRING "Bokken are swords carved of wood rather than forged of metal. Generally used as a training weapon, a bokken still can be deadly in a skilled warrior’s hands. A properly shaped bokken can be used for Iaijutsu Cut techniques despite lacking the Razor-Edged quality."
                }
            }

            #Eoye9VrL2Q0OOqBu3W8aU0 ^"Chokutō" DEF {
                PROPERTIES {
                    ^"Category" STRING "Swords"
                    ^"Skill" STRING "Martial Arts [Melee]"
                    ^"Range" STRING "0-1"
                    ^"Base Damage" INTEGER 4
                    ^"Deadliness" INTEGER 5
                    ^"Grips" STRING "1-hand: –"
                    ^"Qualities" LIST OF STRING ["Ceremonial", "Razor-Edged"]
                    ^"Rarity" INTEGER 7
                    ^"Price" STRING "20 koku"
                    ^"Description" STRING "The chokutō is an ancient design that predates the advent of the katana. Hung from a belt rather than tucked into a sash, a chokutō is roughly three feet long and has a straight, single-edged blade instead of the gentle curve found in newer Rokugani swords. Many of the clans’ most powerful nemuranai—weapons that were wielded by their founding Kami—have this shape, as do the blades used by the Yobanjin of the northern mountains."
                }
            }

            #ajpYUslN9HicBSIUDHeobO ^"Dao" DEF {
                PROPERTIES {
                    ^"Category" STRING "Swords"
                    ^"Skill" STRING "Martial Arts [Melee]"
                    ^"Range" STRING "1"
                    ^"Base Damage" INTEGER 3
                    ^"Deadliness" INTEGER 5
                    ^"Grips" STRING "1-hand: –"
                    ^"Qualities" LIST OF STRING []
                    ^"Rarity" INTEGER 6
                    ^"Price" STRING "15 koku"
                    ^"Description" STRING "Dao are weapons that look like a cross between a scimitar, a saber, and a peasant’s machete. They are one-handed swords two to three feet in length with a broad-bellied, single-edged blade designed for slashing and chopping, and are generally wielded in pairs."
                }
            }

            #f6FulQvXet32tLKy1GQqE5 ^"Gao" DEF {
                PROPERTIES {
                    ^"Category" STRING "Swords"
                    ^"Skill" STRING "Martial Arts [Melee]"
                    ^"Range" STRING "1"
                    ^"Base Damage" INTEGER 4
                    ^"Deadliness" INTEGER 3
                    ^"Grips" STRING "1-hand: –"
                    ^"Qualities" LIST OF STRING ["Snaring"]
                    ^"Rarity" INTEGER 7
                    ^"Price" STRING "15 koku"
                    ^"Description" STRING "Known colloquially as “tiger hook swords” or “Heaven and Earth, Sun and Moon swords,” gao are curious weapons. Usually wielded in pairs, gao are flat, solid iron or steel blades roughly three feet long with several unique features. Their main blade has a hook at one end and a sharpened spike at the other. The grip is protected by a crescent-shaped hand guard with its points facing outward. Gao can be used to slash, capture, and stab, making them appealing to certain Mirumoto duelists."
                }
            }

            #DWdCgWDuBB2CJ31FEXXdgU ^"Jian" DEF {
                PROPERTIES {
                    ^"Category" STRING "Swords"
                    ^"Skill" STRING "Martial Arts [Melee]"
                    ^"Range" STRING "0-1"
                    ^"Base Damage" INTEGER 4
                    ^"Deadliness" INTEGER 4
                    ^"Grips" STRING "1-hand: –; 2-hand: Deadliness +1"
                    ^"Qualities" LIST OF STRING []
                    ^"Rarity" INTEGER 7
                    ^"Price" STRING "15 koku"
                    ^"Description" STRING "Known primarily as a duelist’s weapon, the jian is an ancient and elegant sword that has changed very little in design since Rokugan’s misty past yet remains deadly to this day. About the same size as a chokutō, a typical jian has a straight, double-edged blade that tapers to a point; a small, thick, horizontal hand guard; and a heavy pommel with a tassel. Only slightly more common than the chokutō, it is used by some Mirumoto, Kitsuki, or Shiba swordmasters who favor its versatility."
                }
            }

            #IZg8huIOQgClnGOCMEtUM8 ^"Katana" DEF {
                PROPERTIES {
                    ^"Category" STRING "Swords"
                    ^"Skill" STRING "Martial Arts [Melee]"
                    ^"Range" STRING "1"
                    ^"Base Damage" INTEGER 4
                    ^"Deadliness" INTEGER 5
                    ^"Grips" STRING "1-hand: –; 2-hand: Deadliness +2"
                    ^"Qualities" LIST OF STRING ["Ceremonial", "Razor-Edged"]
                    ^"Rarity" INTEGER 7
                    ^"Price" STRING "20 koku"
                    ^"Description" STRING "As much a work of art as it is a weapon, the katana is perhaps the most revered weapon in Rokugan. It has an elegant, slightly curved blade between three and four feet long, made of steel that is specially folded during its creation. This unique forging style ensures that the inner part of the blade remains springy and soft while the outside is as hard as tempered steel. Each sword likely has a history and legacy, and it is a constant reminder of the weight that destiny has placed upon its bearer’s shoulders as a samurai of Rokugan."
                }
            }

            #EFbgvF2ZQH2ro2KIMiT1vY ^"Nodachi" DEF {
                PROPERTIES {
                    ^"Category" STRING "Swords"
                    ^"Skill" STRING "Martial Arts [Melee]"
                    ^"Range" STRING "1-2"
                    ^"Base Damage" INTEGER 5
                    ^"Deadliness" INTEGER 6
                    ^"Grips" STRING "2-hand: –"
                    ^"Qualities" LIST OF STRING ["Ceremonial", "Razor-Edged"]
                    ^"Rarity" INTEGER 8
                    ^"Price" STRING "20 koku"
                    ^"Description" STRING "Larger than katana, nodachi are long and lethal swords more at home on the battlefield than in a city or at court. Roughly six feet long, these blades are relatively rare due to the skill and strength needed to wield them effectively. There are those who prize the raw force of these blades, however, such as members of the Matsu school. Too large to be worn at the waist, nodachi are normally worn on the back and drawn over the shoulder or even carried into battle by a samurai’s attendant."
                }
            }

            #ZnWIsLyVMnScLLYhO465HR ^"Scimitar" DEF {
                PROPERTIES {
                    ^"Category" STRING "Swords"
                    ^"Skill" STRING "Martial Arts [Melee]"
                    ^"Range" STRING "1"
                    ^"Base Damage" INTEGER 4
                    ^"Deadliness" INTEGER 5
                    ^"Grips" STRING "1-hand: –"
                    ^"Qualities" LIST OF STRING ["Durable", "Razor-Edged"]
                    ^"Rarity" INTEGER 8
                    ^"Price" STRING "20 koku"
                    ^"Description" STRING "Perhaps the most common among foreign-designed swords found in Rokugan, scimitars were brought from the Burning Sands to the Emerald Empire by the Unicorn Clan. Often carried in place of the katana by those warriors, scimitars are heavy swords with a long, broad, curving blade. They possess a deadly cutting edge thanks to the extra surface area provided by their curvature."
                }
            }

            #tOj1hA6M3SVrEwG4dqbf9I ^"Wakizashi" DEF {
                PROPERTIES {
                    ^"Category" STRING "Swords"
                    ^"Skill" STRING "Martial Arts [Melee]"
                    ^"Range" STRING "0-1"
                    ^"Base Damage" INTEGER 3
                    ^"Deadliness" INTEGER 5
                    ^"Grips" STRING "1-hand: –; 2-hand: Deadliness +2"
                    ^"Qualities" LIST OF STRING ["Ceremonial", "Razor-Edged"]
                    ^"Rarity" INTEGER 7
                    ^"Price" STRING "15 koku"
                    ^"Description" STRING "Whereas the katana represents a samurai’s status as a warrior, the wakizashi represents their place in Rokugan’s social order and strict caste system. The wakizashi is a small, katana-like sword usually two to three feet in length, with the same flexible blade and lethal edge. It is often made as part of a pair, with the same decorations as its matched katana. The wakizashi also fills another role: it clearly signals that its wearer is a samurai, and a person of honor who will make the ultimate sacrifice for their ideals and their master. It is the tool with which a samurai commits seppuku: ritual suicide, the last protest of an aggrieved and honorable samurai."
                }
            }

            #WwPkXXi4dAl9cYpp5BVJOO ^"Zanbatō" DEF {
                PROPERTIES {
                    ^"Category" STRING "Swords"
                    ^"Skill" STRING "Martial Arts [Melee]"
                    ^"Range" STRING "1-2"
                    ^"Base Damage" INTEGER 6
                    ^"Deadliness" INTEGER 7
                    ^"Grips" STRING "2-hand: –"
                    ^"Qualities" LIST OF STRING ["Cumbersome", "Wargear"]
                    ^"Rarity" INTEGER 8
                    ^"Price" STRING "40 koku"
                    ^"Description" STRING "Larger even than mighty nodachi, zanbatō are swords with the reach of a spear. Zanbatō have a long, thick, katana-like blade roughly six feet in length attached to a two-handed hilt. They are dedicated anticavalry weapons—indeed, their name means “horse-chopping sword.” The Matsu school is famous for adopting them into the curriculum after their ill-fated encounter with the Utaku cavalry at the Battle of Plum Blossom Pass."
                }
            }
        }

        # --- AXES ---
        AXES {
            #vTqqx4tdb1zj2F5OrR0gOL ^"Masakari" DEF {
                PROPERTIES {
                    ^"Category" STRING "Axes"
                    ^"Skill" STRING "Martial Arts [Melee]"
                    ^"Range" STRING "0-1"
                    ^"Base Damage" INTEGER 3
                    ^"Deadliness" INTEGER 4
                    ^"Grips" STRING "1-hand: –; 2-hand: Deadliness +2"
                    ^"Qualities" LIST OF STRING ["Mundane"]
                    ^"Rarity" INTEGER 5
                    ^"Price" STRING "3 bu"
                    ^"Description" STRING "Similar in size and shape to the humble hatchet, a masakari is a one-handed ax with a single-sided ax-head affixed to one end of a short wooden haft. Such axes are an ordinary sight among peasant militia and rōnin who cannot afford a more prestigious weapon."
                }
            }

            #aJVZQteJXvkX1RcGkpgu3h ^"Ono" DEF {
                PROPERTIES {
                    ^"Category" STRING "Axes"
                    ^"Skill" STRING "Martial Arts [Melee]"
                    ^"Range" STRING "1-2"
                    ^"Base Damage" INTEGER 5
                    ^"Deadliness" INTEGER 6
                    ^"Grips" STRING "2-hand: –"
                    ^"Qualities" LIST OF STRING ["Wargear"]
                    ^"Rarity" INTEGER 7
                    ^"Price" STRING "5 koku"
                    ^"Description" STRING "The ono is a dedicated, two-handed military ax, a rarity on Rokugan’s battlefields, at least outside of Crab lands. The ono consists of a broad, deeply curved ax-head mounted to a haft nearly as tall as a human. Opposite the ax-head is normally either an ornate peen or a long spike, which can pierce armor or monstrous hide."
                }
            }
        }

        # --- BLUNT WEAPONS ---
        BLUNT_WEAPONS {
            #TZMIArth1RErFC2jRCfBSe ^"Club" DEF {
                PROPERTIES {
                    ^"Category" STRING "Blunt Weapons"
                    ^"Skill" STRING "Martial Arts [Melee]"
                    ^"Range" STRING "0-1"
                    ^"Base Damage" INTEGER 5
                    ^"Deadliness" INTEGER 2
                    ^"Grips" STRING "1-hand: –; 2-hand: Damage +1"
                    ^"Qualities" LIST OF STRING ["Mundane"]
                    ^"Rarity" INTEGER 1
                    ^"Price" STRING "1 bu"
                    ^"Description" STRING "The humble club is perhaps the oldest weapon in Rokugan—at least among humans. Often little more than a length of stout wood or shaped stone, a club can be fashioned with available materials by nearly anyone. While a club can certainly be used to kill, doing so takes some work on the part of the wielder."
                }
            }

            #QWvxWGV9MAbdPWVMxSHmfi ^"Hammer" DEF {
                PROPERTIES {
                    ^"Category" STRING "Blunt Weapons"
                    ^"Skill" STRING "Martial Arts [Melee]"
                    ^"Range" STRING "0-1"
                    ^"Base Damage" INTEGER 5
                    ^"Deadliness" INTEGER 2
                    ^"Grips" STRING "1-hand: –; 2-hand: Damage +2"
                    ^"Qualities" LIST OF STRING ["Mundane"]
                    ^"Rarity" INTEGER 4
                    ^"Price" STRING "2 bu"
                    ^"Description" STRING "The simple hammer is used for driving nails and spikes and for other construction work. Throughout most of Rokugan, the hammer is only occasionally used as a weapon—typically in brawls or spur of the moment skirmishes when no other weapon is available."
                }
            }

            #ap5kzPH5roAYEKAm60mIyF ^"Kiseru" DEF {
                PROPERTIES {
                    ^"Category" STRING "Blunt Weapons"
                    ^"Skill" STRING "Martial Arts [Melee]"
                    ^"Range" STRING "0"
                    ^"Base Damage" INTEGER 2
                    ^"Deadliness" INTEGER 2
                    ^"Grips" STRING "1-hand: –"
                    ^"Qualities" LIST OF STRING ["Concealable", "Mundane"]
                    ^"Rarity" INTEGER 5
                    ^"Price" STRING "1 koku"
                    ^"Description" STRING "Kiseru are pipes used to smoke various herbs found throughout Rokugan. They consist of a metal mouthpiece and a metal bowl connected by a hollow wood or bamboo tube. Kiseru range in quality from a peasant’s rough-hewn pipe to a courtier or noble’s ivory-and-gold inlaid piece of art. Further, they can function as clandestine weapons. Since kiseru are not formally considered arms, it is easy to get them into places that forbid weapons."
                }
            }

            #DKuvTbdd4xuTJRdEO8mbPN ^"Ōtsuchi" DEF {
                PROPERTIES {
                    ^"Category" STRING "Blunt Weapons"
                    ^"Skill" STRING "Martial Arts [Melee]"
                    ^"Range" STRING "1"
                    ^"Base Damage" INTEGER 8
                    ^"Deadliness" INTEGER 3
                    ^"Grips" STRING "2-hand: –"
                    ^"Qualities" LIST OF STRING ["Cumbersome", "Wargear"]
                    ^"Rarity" INTEGER 8
                    ^"Price" STRING "30 koku"
                    ^"Description" STRING "The ōtsuchi is to the carpenter’s hammer what the ono is to the woodcutter’s ax: larger, deadlier, and obviously designed with lethal purpose. With a shaft roughly six feet long topped by a huge, barrel-shaped mallet head, it is built to breach doors and smash walls—but it also works quite well on monsters with rock-like hides, as the warriors of the Hida school often demonstrate."
                }
            }

            #vXHvOYdxXd2UsIzKnVDtbR ^"Tetsubō" DEF {
                PROPERTIES {
                    ^"Category" STRING "Blunt Weapons"
                    ^"Skill" STRING "Martial Arts [Melee]"
                    ^"Range" STRING "1-2"
                    ^"Base Damage" INTEGER 7
                    ^"Deadliness" INTEGER 3
                    ^"Grips" STRING "2-hand: –"
                    ^"Qualities" LIST OF STRING ["Cumbersome", "Durable", "Wargear"]
                    ^"Rarity" INTEGER 5
                    ^"Price" STRING "20 koku"
                    ^"Description" STRING "Long and narrow, a tetsubō can be as tall as a human and normally is constructed of iron or hardwood. Above its grip, a tetsubō is covered in steel, iron, or even jade spikes or studs that add to the weapon’s lethality and crush armor or plated carapace with ease."
                }
            }
        }

        # --- HAND WEAPONS ---
        HAND_WEAPONS {
            #bzlBFGx4DS2NIkWR6VfWU9 ^"Jitte" DEF {
                PROPERTIES {
                    ^"Category" STRING "Hand Weapons"
                    ^"Skill" STRING "Martial Arts [Melee]"
                    ^"Range" STRING "0"
                    ^"Base Damage" INTEGER 3
                    ^"Deadliness" INTEGER 2
                    ^"Grips" STRING "1-hand: –"
                    ^"Qualities" LIST OF STRING ["Concealable", "Snaring"]
                    ^"Rarity" INTEGER 5
                    ^"Price" STRING "5 bu"
                    ^"Description" STRING "Typically just over a foot long, the jitte consists of a short steel or iron rod attached to a wooden handle. The rod tapers to a blunt point and has a single prong that extends from one side. This simple weapon is designed to disarm and subdue targets rather than to kill them. It is carried by law enforcement officers at all levels, from low-ranking town constables to high-ranking magistrates, as a symbol of their office."
                }
            }

            #eD2ZlSUdmgzgKHVHxTqfKu ^"Knife" DEF {
                PROPERTIES {
                    ^"Category" STRING "Hand Weapons"
                    ^"Skill" STRING "Martial Arts [Melee]"
                    ^"Range" STRING "0"
                    ^"Base Damage" INTEGER 2
                    ^"Deadliness" INTEGER 4
                    ^"Grips" STRING "1-hand: –; 2-hand: Deadliness +2"
                    ^"Qualities" LIST OF STRING ["Concealable", "Mundane", "Razor-Edged"]
                    ^"Rarity" INTEGER 1
                    ^"Price" STRING "1 koku"
                    ^"Description" STRING "Knives come in a dizzying array of types and styles, from the familiar crudely constructed knife in a peasant’s kitchen to the deadly combat knives samurai take into battle. Those particularly designed for combat—like the aiguchi—are often equipped with small hand guards to make them more useful in the field."
                }
            }

            #BBBkaqskhH9RIDJaICPiKK ^"Nunchaku" DEF {
                PROPERTIES {
                    ^"Category" STRING "Hand Weapons"
                    ^"Skill" STRING "Martial Arts [Melee]"
                    ^"Range" STRING "0-1"
                    ^"Base Damage" INTEGER 4
                    ^"Deadliness" INTEGER 2
                    ^"Grips" STRING "1-hand: –; 2-hand: Snaring"
                    ^"Qualities" LIST OF STRING []
                    ^"Rarity" INTEGER 6
                    ^"Price" STRING "1 koku"
                    ^"Description" STRING "Originally hailing from the Islands of Spice and Silk, nunchaku have been used in certain Rokugani martial arts schools for centuries. Adapted from a simple threshing tool, nunchaku consist of two wood or iron rods connected by a short length of chain or rope."
                }
            }

            #Xw8Ulobk0XdHzne6e6bLJV ^"Tessen" DEF {
                PROPERTIES {
                    ^"Category" STRING "Hand Weapons"
                    ^"Skill" STRING "Martial Arts [Melee]"
                    ^"Range" STRING "0-1"
                    ^"Base Damage" INTEGER 4
                    ^"Deadliness" INTEGER 3
                    ^"Grips" STRING "1-hand: –"
                    ^"Qualities" LIST OF STRING ["Ceremonial", "Concealable"]
                    ^"Rarity" INTEGER 7
                    ^"Price" STRING "15 koku"
                    ^"Description" STRING "Carried by courtiers and military leaders alike, tessen are fans specially built for fighting. However, they are not commonly viewed as weapons, and can be openly carried even into formal court chambers or negotiations. Usually made of wood with steel tines, they generally serve as defensive weapons, but wielders can also use them to deliver clubbing blows or to reinforce a punch."
                }
            }
        }

        # --- POLEARMS ---
        POLEARMS {
            #vYx8e5OmmSm48EyVJjeUnW ^"Bisentō" DEF {
                PROPERTIES {
                    ^"Category" STRING "Polearms"
                    ^"Skill" STRING "Martial Arts [Melee]"
                    ^"Range" STRING "2"
                    ^"Base Damage" INTEGER 4
                    ^"Deadliness" INTEGER 6
                    ^"Grips" STRING "1-hand: Range 1; 2-hand: Damage +2"
                    ^"Qualities" LIST OF STRING ["Cumbersome", "Durable", "Wargear"]
                    ^"Rarity" INTEGER 8
                    ^"Price" STRING "15 koku"
                    ^"Description" STRING "The bisentō is a strange weapon not regularly seen on Rokugan’s battlefields. Essentially a scimitar with an extremely long hilt, the bisentō has a long, yari-like wooden shaft topped by a broad and heavy curved blade. Though it seems awkward and top-heavy, the bisentō is exceptionally dangerous in the right hands. The length of the shaft gives the wielder incredible leverage, allowing them to deliver great chopping blows that can slice a person in half or cleave through heavy armor. Typically seen among the more militant orders of monks, such as the Perfect Land Sect, the bisentō is sometimes used by heavy infantry units, like those of the Daidoji family."
                }
            }

            #KrTFIj92yMAizxbiJi5gjN ^"Bō" DEF {
                PROPERTIES {
                    ^"Category" STRING "Polearms"
                    ^"Skill" STRING "Martial Arts [Melee]"
                    ^"Range" STRING "1-2"
                    ^"Base Damage" INTEGER 6
                    ^"Deadliness" INTEGER 2
                    ^"Grips" STRING "2-hand: –"
                    ^"Qualities" LIST OF STRING ["Mundane"]
                    ^"Rarity" INTEGER 2
                    ^"Price" STRING "2 bu"
                    ^"Description" STRING "The bō, a humble staff, is a versatile weapon found throughout Rokugan. Roughly six feet long and made from sturdy hardwood, it is carried by travelers who need both a walking stick and an inconspicuous weapon."
                }
            }

            #rI8gCIEgyKvjxqrkq0bOY2 ^"Ji" DEF {
                PROPERTIES {
                    ^"Category" STRING "Polearms"
                    ^"Skill" STRING "Martial Arts [Melee]"
                    ^"Range" STRING "2"
                    ^"Base Damage" INTEGER 5
                    ^"Deadliness" INTEGER 2
                    ^"Grips" STRING "2-hand: –"
                    ^"Qualities" LIST OF STRING ["Snaring", "Wargear"]
                    ^"Rarity" INTEGER 6
                    ^"Price" STRING "7 koku"
                    ^"Description" STRING "Also known as the “dagger-spear,” the ji is a long polearm designed more for catching and controlling weapons than for direct attacks. Commonly used by the Dragon and Phoenix Clans, and a specialty of the Shiba Guardian School, the standard ji consists of a long wooden shaft topped by a hooked or crescent-shaped blade. Other ji have a head consisting of a single long, double-edged blade with one or two smaller crescent-shaped blades mounted to the sides."
                }
            }

            #XNd3DuKiqOelEYKeG3hnU5 ^"Naginata" DEF {
                PROPERTIES {
                    ^"Category" STRING "Polearms"
                    ^"Skill" STRING "Martial Arts [Melee]"
                    ^"Range" STRING "2"
                    ^"Base Damage" INTEGER 6
                    ^"Deadliness" INTEGER 6
                    ^"Grips" STRING "2-hand: –"
                    ^"Qualities" LIST OF STRING ["Cumbersome", "Razor-Edged", "Wargear"]
                    ^"Rarity" INTEGER 8
                    ^"Price" STRING "10 koku"
                    ^"Description" STRING "Most samurai’s preferred polearm, the naginata is highly regarded. It has a long, flexible shaft made of bamboo or springy wood with a large, lightweight, slightly curved blade at the top. A naginata’s blade is forged with the same ceremony and meticulous craftsmanship as a katana’s, and commands the same reverence as the daishō. It is carried in elite units such as the Heaven’s Wing Brotherhood and the Utaku Battle Maidens."
                }
            }

            #EWDoKQZrEFszhejCZJqcUP ^"Trident" DEF {
                PROPERTIES {
                    ^"Category" STRING "Polearms"
                    ^"Skill" STRING "Martial Arts [Melee]"
                    ^"Range" STRING "2"
                    ^"Base Damage" INTEGER 4
                    ^"Deadliness" INTEGER 4
                    ^"Grips" STRING "2-hand: –"
                    ^"Qualities" LIST OF STRING ["Snaring", "Wargear"]
                    ^"Rarity" INTEGER 7
                    ^"Price" STRING "10 koku"
                    ^"Description" STRING "The trident is a long, triple-headed spear generally associated with fishermen and the sea. On land, the trident is a formidable polearm with exceptional reach that can pierce, trap, and control opponents."
                }
            }

            #lDpCbgNfyQZ4V3Yyg35o1A ^"Yari" DEF {
                PROPERTIES {
                    ^"Category" STRING "Polearms"
                    ^"Skill" STRING "Martial Arts [Melee]"
                    ^"Range" STRING "2"
                    ^"Base Damage" INTEGER 5
                    ^"Deadliness" INTEGER 3
                    ^"Grips" STRING "2-hand: –"
                    ^"Qualities" LIST OF STRING ["Wargear"]
                    ^"Rarity" INTEGER 3
                    ^"Price" STRING "5 koku"
                    ^"Description" STRING "A long-shafted spear, the yari is one of the most common weapons in Rokugan. Between six and eight feet long, its shaft is made of hardwood and topped with a leaf-shaped spearhead. Since it is easy to make, the yari is a customary weapon of ashigaru, but also elite clan samurai such as the Daidoji heavy infantry."
                }
            }
        }

        # ==================
        # RANGED WEAPONS
        # ==================

        # --- BOWS ---
        BOWS {
            #RvqO8EJ8zzS3Nd8zxoB6C6 ^"Daikyū" DEF {
                PROPERTIES {
                    ^"Category" STRING "Bows"
                    ^"Skill" STRING "Martial Arts [Ranged]"
                    ^"Range" STRING "3-5"
                    ^"Base Damage" INTEGER 6
                    ^"Deadliness" INTEGER 4
                    ^"Grips" STRING "2-hand: –"
                    ^"Qualities" LIST OF STRING ["Wargear"]
                    ^"Rarity" INTEGER 6
                    ^"Price" STRING "6 koku"
                    ^"Description" STRING "Daikyū are large composite bows designed to be fired from horseback. Conventionally around six feet long, these elegant weapons are constructed by gluing thin layers of wood, horn, leather, and sinew together. Daikyū differ from other bows in that they have an asymmetric shape. Their grip is about two-thirds of the way from the top, making the top curve longer than the bottom. This allows the bows to be fired easily from horseback in either direction. Each daikyū is made for a custom fit for a specific user."
                }
            }

            #UlmaiMKUe534lv6vWAJplC ^"Shinjo Horsebow" DEF {
                PROPERTIES {
                    ^"Category" STRING "Bows"
                    ^"Skill" STRING "Martial Arts [Ranged]"
                    ^"Range" STRING "2-4"
                    ^"Base Damage" INTEGER 4
                    ^"Deadliness" INTEGER 5
                    ^"Grips" STRING "2-hand: –"
                    ^"Qualities" LIST OF STRING ["Wargear"]
                    ^"Rarity" INTEGER 4
                    ^"Price" STRING "6 koku"
                    ^"Description" STRING "Among the Unicorn Clan’s many adopted weapons is a small, sturdy bow used by the nomadic peoples of the steppes far to the west. Called the Shinjo horsebow in Rokugan, this weapon is a compact bow designed to be fired from the back of a moving horse. It is a short-range weapon intended for raiding and cavalry attacks."
                }
            }

            #MpmOChBTherbTTCTXeYNYE ^"Yumi" DEF {
                PROPERTIES {
                    ^"Category" STRING "Bows"
                    ^"Skill" STRING "Martial Arts [Ranged]"
                    ^"Range" STRING "2-5"
                    ^"Base Damage" INTEGER 5
                    ^"Deadliness" INTEGER 3
                    ^"Grips" STRING "2-hand: –"
                    ^"Qualities" LIST OF STRING []
                    ^"Rarity" INTEGER 3
                    ^"Price" STRING "3 koku"
                    ^"Description" STRING "The yumi is perhaps the most common bow used by Rokugani samurai. Similar to the daikyū, it is a long, graceful bow made from a composite of horn, sinew, leather, and wood. Smaller than the daikyū, but only just, the yumi has an asymmetric grip, general shape, and long-range killing power similar to those of its larger cousin. Where the daikyū is a cavalry bow, however, the yumi is designed to be fired while standing."
                }
            }
        }

        # --- CROSSBOWS ---
        CROSSBOWS {
            #pTmyjr7us0ukulQRIMGqhG ^"Oyumi" DEF {
                PROPERTIES {
                    ^"Category" STRING "Crossbows"
                    ^"Skill" STRING "Martial Arts [Ranged]"
                    ^"Range" STRING "2-5"
                    ^"Base Damage" INTEGER 7
                    ^"Deadliness" INTEGER 3
                    ^"Grips" STRING "2-hand: –"
                    ^"Qualities" LIST OF STRING ["Prepare", "Wargear"]
                    ^"Rarity" INTEGER 8
                    ^"Price" STRING "40 koku"
                    ^"Description" STRING "Developed out of necessity to fight the deadly forces of the Shadowlands, this weapon consists of a recurve or traditional bow laid horizontally on a long, stout stock. Held to the shoulder, the oyumi is fired by squeezing a long lever on the bottom of the stock. It fires short, arrow-like projectiles called quarrels. Its existence is a matter of some consternation among the other clans, but the Crab maintain that its use—even in the hands of ashigaru and peasants in times of crisis—has been vital to the preservation of the Empire."
                }
            }
        }

        # --- ARROWS ---
        # When used with a bow, these arrows modify the weapon's profile:
        ARROWS {
            # Arrows are not weapon profiles — they modify the bow that fires them —
            # so they carry an Effect rather than the Range/Damage/Deadliness set.
            #pRnUJJ6PNgdQYEQ576HWQ5 ^"Willow-Leaf" DEF {
                PROPERTIES {
                    ^"Category" STRING "Arrows"
                    ^"Effect" STRING "Standard Rokugani arrows. As long as a character has a quiver, they do not need to track willow-leaf arrows individually."
                    ^"Description" STRING "Willow-leaf arrows are broadhead arrows used for both hunting and warfare. These are “typical” arrows."
                }
            }

            #VWMmGU7rJTMbq2XqLsxACv ^"Armor-Piercing" DEF {
                PROPERTIES {
                    ^"Category" STRING "Arrows"
                    ^"Effect" STRING "Ignore up to 2 points of the target's physical resistance."
                    ^"Description" STRING "Armor-piercing arrows end in a long, hardened spike. These arrows can pierce even the toughest armor to strike at the flesh beneath."
                }
            }

            #IyWFDxHuB71EAuiEZsG6ih ^"Flesh-Cutter" DEF {
                PROPERTIES {
                    ^"Category" STRING "Arrows"
                    ^"Effect" STRING "Deadliness +2."
                    ^"Description" STRING "Flesh-cutters have especially broad, multibladed, and often barbed heads designed to tear through unprotected flesh."
                }
            }

            #pH0RPy0N6GovEWoVBwfBK6 ^"Humming-Bulb" DEF {
                PROPERTIES {
                    ^"Category" STRING "Arrows"
                    ^"Effect" STRING "Damage -2, Deadliness -2. These arrows produce a loud noise audible at range 0-4 of the archer and of the path the arrow travels."
                    ^"Description" STRING "Humming-Bulbs have an egg-shaped, hollow head with slots cut into its surface. As the arrow flies, the bulb emits a sharp whistling sound. These arrows are good for signaling and creating a distraction."
                }
            }
        }

        # ==================
        # SPECIALIST WEAPONS
        # ==================

        # Weapons used by assassins and spies — a mix of improvised tools,
        # modified agricultural implements, and bespoke weapons. They emphasize
        # stealth and accessibility over sheer killing power.

        SPECIALIST_WEAPONS {
            #buUp7YEHyHKzE5o5rOHXD6 ^"Blowgun" DEF {
                PROPERTIES {
                    ^"Category" STRING "Specialist Weapons"
                    ^"Skill" STRING "Martial Arts [Ranged]"
                    ^"Range" STRING "2-3"
                    ^"Base Damage" INTEGER 1
                    ^"Deadliness" INTEGER 2
                    ^"Grips" STRING "1-hand: –"
                    ^"Qualities" LIST OF STRING ["Concealable"]
                    ^"Rarity" INTEGER 7
                    ^"Price" STRING "5 bu"
                    ^"Description" STRING "Made from a length of hollow bamboo or river reed, the blowgun is one of the simplest weapons that ninja use in their work. The blowgun’s primary use is as a ranged weapon, usually to deliver poison (see the Poisoned Weapons sidebar, page 244). In addition to darts, the blowgun can also be loaded with sand, dust, or other powders to blind or disorient foes, and it can even serve to let its user breathe while underwater."
                }
            }

            #JUt3gmhc4m6P3vPhEsNcxQ ^"Kama" DEF {
                PROPERTIES {
                    ^"Category" STRING "Specialist Weapons"
                    ^"Skill" STRING "Martial Arts [Melee]"
                    ^"Range" STRING "0-1"
                    ^"Base Damage" INTEGER 3
                    ^"Deadliness" INTEGER 3
                    ^"Grips" STRING "1-hand: –"
                    ^"Qualities" LIST OF STRING ["Concealable"]
                    ^"Rarity" INTEGER 4
                    ^"Price" STRING "1 koku"
                    ^"Description" STRING "The kama is another weapon adapted from an agricultural implement: in this case, a standard sickle used for harvesting rice. It consists of a short, roughly foot-long wooden haft topped by a long, curved sickle blade. Kama are often used in pairs, sometimes linked at the handles by a length of chain."
                }
            }

            #XUAkQlVjM7bEsAhug1nmvT ^"Kusari-Gama" DEF {
                PROPERTIES {
                    ^"Category" STRING "Specialist Weapons"
                    ^"Skill" STRING "Martial Arts [Melee]"
                    ^"Range" STRING "0"
                    ^"Base Damage" INTEGER 3
                    ^"Deadliness" INTEGER 3
                    ^"Grips" STRING "1-hand: –; 2-hand: Range 2-3"
                    ^"Qualities" LIST OF STRING ["Concealable", "Snaring", "Wargear"]
                    ^"Rarity" INTEGER 6
                    ^"Price" STRING "5 koku"
                    ^"Description" STRING "Extremely versatile and deadly, the kusari-gama is one of the more difficult ninja weapons to master. It is a hybrid weapon consisting of a long-hafted kama with a lengthy chain attached to either the back of the blade or the bottom of the haft. A heavy iron weight called a fundo is mounted at the end of the chain. In combat, a wielder typically spins the chain over their head with one hand while holding the kama in the other. They whip the chain forward, entangling an opponent’s weapon or limbs, then rush in for the killing blow with the kama. A wielder can also attack with the weighted end of the chain, striking opponents at range and keeping them at bay."
                }
            }

            #yaAf7lxpRju0StUrU5nQo6 ^"Shuriken" DEF {
                PROPERTIES {
                    ^"Category" STRING "Specialist Weapons"
                    ^"Skill" STRING "Martial Arts [Melee]"
                    ^"Range" STRING "0"
                    ^"Base Damage" INTEGER 2
                    ^"Deadliness" INTEGER 4
                    ^"Grips" STRING "1-hand (stab or slash): –; 1-hand (thrown): Martial Arts [Ranged], Range 1-3"
                    ^"Qualities" LIST OF STRING ["Concealable"]
                    ^"Rarity" INTEGER 6
                    ^"Price" STRING "1 koku"
                    ^"Description" STRING "Favored by shinobi, shuriken are small metal discs with a sharpened edge that come in a dizzying array of sizes and styles. They are designed mainly to distract, but shuriken can also be coated with toxins for lethality, and any cutting edge can kill if used properly."
                }
            }
        }

        # ==================
        # UNARMED PROFILES
        # ==================

        # A character always counts as having these Martial Arts [Unarmed]
        # profiles readied, provided the relevant body parts are not occupied
        # (such as with a weapon) or bound.

        UNARMED {
            # A character always counts as having these readied, provided the
            # relevant body parts are not occupied or bound (p. 237). The book's
            # table names the body part alongside each profile.
            #BEUiHiz89myUcFkHavaizC ^"Punch" DEF {
                PROPERTIES {
                    ^"Category" STRING "Unarmed"
                    ^"Skill" STRING "Martial Arts [Unarmed]"
                    ^"Body Part" STRING "hand"
                    ^"Range" STRING "0"
                    ^"Base Damage" INTEGER 1
                    ^"Deadliness" INTEGER 2
                    ^"Qualities" LIST OF STRING ["Snaring"]
                }
            }

            #AVFRp4rQxz5VX2tdcejlu0 ^"Kick" DEF {
                PROPERTIES {
                    ^"Category" STRING "Unarmed"
                    ^"Skill" STRING "Martial Arts [Unarmed]"
                    ^"Body Part" STRING "leg"
                    ^"Range" STRING "1"
                    ^"Base Damage" INTEGER 2
                    ^"Deadliness" INTEGER 1
                    ^"Qualities" LIST OF STRING []
                }
            }

            #m1wR7vTglJXHOVwFbmlb6g ^"Bite" DEF {
                PROPERTIES {
                    ^"Category" STRING "Unarmed"
                    ^"Skill" STRING "Martial Arts [Unarmed]"
                    ^"Body Part" STRING "mouth"
                    ^"Range" STRING "0"
                    ^"Base Damage" INTEGER 0
                    ^"Deadliness" INTEGER 3
                    ^"Qualities" LIST OF STRING []
                }
            }
        }

        RULES {
            #L5R440yZ2aB4cD6eF8gH0i: weapon_attributes_and_categories
            #L5R441jK3lM5nO7pQ9rS1t: readied_and_sheathed_weapons
            #L5R442uV4wX6yZ8aB0cD2e: grip_selection_and_switching
        }
    }

    # A weapon type improvised from an object at hand. The core rulebook (p. 230)
    # references improvised weapons but supplies no profile; the profile rule was
    # added by errata. This stub establishes the entity so the errata (and the
    # Shoddy Improvised Weapons variant) have a canonical target to extend.
    #L5R444improvisedweapons01 ^"Improvised Weapons" DEF {
        EXTENDS ^"Weapon"
        PROPERTIES {
            ^"Name"     STRING "Improvised Weapon"
            ^"Category" STRING "Improvised"
        }
        RULES {
            #L5R443iW5xY7zA9bC1dE3f: improvised_weapons
        }
    }

    # ===========================
    # ARMOR
    # ===========================

    ^"Armor" DEF {
        APPLIES TO [^"Samurai", ^"Adversary"]

        # Samurai armor themselves with a wide variety of garments, suiting
        # their choices to their needs. Whether lacquered plates to protect
        # against swords or fashionable clothes to bolster reputation at
        # court, a samurai's garb serves many important purposes.

        # --- ATTRIBUTES OF ARMOR ---
        # Name: The name of the armor.
        # Resistance Values (R. Values): Most armor provides defense against
        #   one or more categories of damage. While equipped, the character
        #   gains the indicated amounts of resistance. Common categories:
        #   - Physical: Resistance against physical harm in its many forms.
        #   - Supernatural: Resistance against invocations, ^"Mahō", and
        #     other mystical effects.
        # Qualities: Any nonstandard effects (see ^"Item Quality").
        # Rarity: How difficult the item is to find (1 = common, 9 = legendary).
        # Price: The cost to acquire.

        PROPERTIES {
            ^"Name" STRING REQUIRED
            ^"Physical Resistance" INTEGER MIN 0 MAX 6
            ^"Supernatural Resistance" INTEGER MIN 0 MAX 6
            ^"Qualities" LIST OF STRING  # References ^"Item Quality" values
            ^"Rarity" INTEGER MIN 1 MAX 9
            ^"Price" STRING
            ^"Description" STRING  # Verbatim narrative flavor (no mechanical effect)
        }

        # --- WEARING ARMOR ---
        # While wearing armor, a character benefits from its resistance
        # values and applicable qualities.
        #
        # If a character dons a second set of armor (e.g., concealed armor
        # under sleeping garb, or ashigaru armor pulled over ceremonial
        # clothes), they must choose one to count as equipped. The other
        # does not provide its resistances or qualities until one set is
        # removed.
        #
        # Exception: The GM may decide that unequipped armor's qualities
        # still hamper the character (e.g., lacquered armor under common
        # clothing may still impose the ^"Cumbersome" quality). This is
        # solely at the GM's discretion.
        #
        # A character can benefit from one set of armor and one effect that
        # increases their resistance at a time, combining these benefits.
        # If a character would benefit from more than one such effect, the
        # character chooses which increase applies.

        # Format: Name, Resistance Values, Qualities, Rarity, Price

        ARMOR {
            #oAmMyus6GKQAeQskQUqMAu ^"Sleeping Garb" DEF {
                PROPERTIES {
                    ^"Rarity" INTEGER 2
                    ^"Price" STRING "1 koku"
                    ^"Description" STRING "Most Rokugani possess no dedicated sleeping clothes, but those of sufficient wealth or status (such as samurai) often wear a loose robe, a shift, or a jinbei when sleeping. A jinbei set consists of a short, loose, short-sleeved jacket that belts at the waist and matching short trousers. Jinbei sets are reserved for sleeping and private lounging, and are most often worn by men. Many women instead choose shifts or gowns that cover the wearer from shoulder to midcalf, though some prefer jinbei."
                }
            }

            #ScyaKoEAQem0GmQMeae0oY ^"Common Clothes" DEF {
                PROPERTIES {
                    ^"Physical Resistance" INTEGER 1
                    ^"Qualities" LIST OF STRING ["Mundane"]
                    ^"Rarity" INTEGER 1
                    ^"Price" STRING "1 bu"
                    ^"Description" STRING "Rokugani clothing runs the gamut from the simple trousers and smocks worn by peasants, to the broad-shouldered haori worn by traditionalist samurai, to the noble’s embroidered silk kimono."
                }
            }

            #2GeQkig86E64CMeiWoW6A6 ^"Ceremonial Clothes" DEF {
                PROPERTIES {
                    ^"Physical Resistance" INTEGER 1
                    ^"Qualities" LIST OF STRING ["Ceremonial", "Resplendent"]
                    ^"Rarity" INTEGER 4
                    ^"Price" STRING "1 koku"
                    ^"Description" STRING "Ceremonial clothing is any garment worn during an official ceremony, from a samurai’s court kimono to the accoutrement of the Imperial family. Ceremonial clothing is often richly decorated and offers little protection."
                }
            }

            #YM0KwQCWUMqqUi2KsqYMKE ^"Sanctified Robes" DEF {
                PROPERTIES {
                    ^"Physical Resistance" INTEGER 1
                    ^"Supernatural Resistance" INTEGER 3
                    ^"Qualities" LIST OF STRING ["Ceremonial"]
                    ^"Rarity" INTEGER 7
                    ^"Price" STRING "4 koku"
                    ^"Description" STRING "The vestments of shugenja, shrine keepers, and other religious figures are blessed by kami and thus grant mystical protection. Traditionally, such robes consist of a white garment called jōe (literally, “pure cloth”) and a peaked hat, but they can be simpler, such as a white haori top and red hakama bottoms, or even an elaborate kimono."
                }
            }

            #CoCYG4sku0kqAeM4iSoyCA ^"Traveling Clothes" DEF {
                PROPERTIES {
                    ^"Physical Resistance" INTEGER 2
                    ^"Qualities" LIST OF STRING ["Durable", "Mundane", "Subtle"]
                    ^"Rarity" INTEGER 2
                    ^"Price" STRING "2 bu"
                    ^"Description" STRING "Traveling clothes ordinarily consist of roughspun garments designed to resist wear and tear. They can be anything from robes to a kimono or jacket and leggings and are often accentuated with a hat or cloak."
                }
            }

            #esiiQGc8Sc8SO0qeImukYi ^"Concealed Armor" DEF {
                PROPERTIES {
                    ^"Physical Resistance" INTEGER 2
                    ^"Qualities" LIST OF STRING ["Concealable"]
                    ^"Rarity" INTEGER 4
                    ^"Price" STRING "5 koku"
                    ^"Description" STRING "Used by cautious courtiers, shinobi, and anyone else who fears assassination, concealed armor is a kimono, keikogi, or other garment with thin bamboo or metal plates sewn inside to turn an unexpected blade or arrow."
                }
            }

            #Q2oaya82yYCMUuEqyO0MAS ^"Ashigaru Armor" DEF {
                PROPERTIES {
                    ^"Physical Resistance" INTEGER 3
                    ^"Qualities" LIST OF STRING ["Wargear"]
                    ^"Rarity" INTEGER 3
                    ^"Price" STRING "5 koku"
                    ^"Description" STRING "Cheap, lightweight, and easy to acquire, ashigaru armor is issued to the peasant soldiery. Possessing neither the beauty nor the fine craftsmanship of lacquered or plated armor, ashigaru armor consists of light plates sewn together to protect the head, torso, and upper legs. It is occasionally paired with a light helmet. Although it does not protect as well as heavier armor, it is lightweight, flexible, and inexpensive as armor goes."
                }
            }

            #w4MWAoKYqEyEi0Ec8y2S8i ^"Lacquered Armor" DEF {
                PROPERTIES {
                    ^"Physical Resistance" INTEGER 4
                    ^"Qualities" LIST OF STRING ["Ceremonial", "Cumbersome", "Wargear"]
                    ^"Rarity" INTEGER 6
                    ^"Price" STRING "25 koku"
                    ^"Description" STRING "Heavier than ashigaru armor, lacquered armor is worn by samurai who desire a good mix of protection and grandeur, and is just at home at war as at a martial ceremony. These suits are made of thick leather or steel plates stitched or riveted to a leather backing. They protect the torso, head, upper arms, and groin, and the legs above the knee. They can also include a helmet and mask, though these are not considered integral."
                }
            }

            #iWiGEuyEyQ0w0ekAmWUEmc ^"Plated Armor" DEF {
                PROPERTIES {
                    ^"Physical Resistance" INTEGER 5
                    ^"Qualities" LIST OF STRING ["Cumbersome", "Durable", "Wargear"]
                    ^"Rarity" INTEGER 8
                    ^"Price" STRING "40 koku"
                    ^"Description" STRING "Also known as great armor, suits of plated armor are among the heaviest worn by samurai. Not as ornate as lacquered armor and somewhat more restrictive but also notably more protective, plated armor is composed of numerous small steel and leather plates connected by rivets, woven silk cords, leather straps, or chains. The plates are attached to a leather or cloth backing and worn over silk clothing, which provides added protection from piercing attacks thanks to its tensile strength."
                }
            }
        }

        RULES {
            #L5R443fG5hI7jK9lM1nO3p: armor_resistance_values
            #L5R444qR6sT8uV0wX2yZ4a: wearing_multiple_armor_sets
            #L5R444bR7sT9uV1wX3yZ5b: resistance_stacking_limit
        }
    }

    ^"Personal Effect" DEF {
        APPLIES TO [^"Samurai", ^"Adversary"]

        # Core Rulebook Ch5: everyday tools, provisions, and personal items.
        # Referenced by school starting outfits. Rarity/Price are STRING to
        # allow ranges (e.g. "2-6", "1–5 bu per small bottle").

        PROPERTIES {
            ^"Name" STRING REQUIRED
            ^"Qualities" LIST OF STRING  # References ^"Item Quality" values
            ^"Rarity" STRING  # 1 (common) .. 9 (legendary); may be a range
            ^"Price" STRING  # Cost to acquire
            ^"Description" STRING  # Verbatim narrative flavor (no mechanical effect)
        }

        ITEMS {
            #kAwUUOgoK42g0OG26AyGsU ^"Bottle of Sake" DEF {
                PROPERTIES {
                    ^"Rarity" STRING "1"
                    ^"Price" STRING "1 bu"
                    ^"Description" STRING "Sake, a wine made from fermented rice, is popular throughout Rokugan and is readily available at any inn. The quality of sake varies widely depending on the maker and the seller."
                }
            }

            #u88o0UeM4Saauya8WEEK6c ^"Bowyer's Kit" DEF {
                PROPERTIES {
                    ^"Rarity" STRING "1"
                    ^"Price" STRING "2 bu"
                    ^"Description" STRING "A bowyer’s kit is a small tool kit used to maintain bows and arrows. It typically includes a selection of small hand tools, spare string, some feathers, wax, bamboo fibers, arrowheads, and other items needed to keep a bow and arrows in working order."
                }
            }

            #46I6WSWKYgsMMaKQoW0Gyo ^"Calligraphy Set" DEF {
                PROPERTIES {
                    ^"Rarity" STRING "3"
                    ^"Price" STRING "1 bu"
                    ^"Description" STRING "These ornate boxes contain items a practiced callig- rapher needs to craft books, letters, scrolls, and other written communications. It consists of a small wooden box that contains a variety of brushes, inkstones, and pigments; a small bowl for water; and a small bag of sand for drying. Calligraphers and scribes customari- ly carry a calligraphy set, as so do some samurai and courtiers who prefer to write their own correspon- dence."
                }
            }

            #26AcYSMY4AuQ2mYS6Wa0M8 ^"Chopsticks" DEF {
                PROPERTIES {
                    ^"Rarity" STRING "1"
                    ^"Price" STRING "1 zeni"
                    ^"Description" STRING "Chopsticks are the primary Rokugani eating utensils. Sold in pairs, these slender utensils are normally made of wood or bamboo, although some wealthy individ- uals use chopsticks of ivory, bone, or metal instead."
                }
            }

            #C4OqyG4YUsC0uIC28oUQAa ^"Daishō Stand" DEF {
                PROPERTIES {
                    ^"Rarity" STRING "4"
                    ^"Price" STRING "1 koku"
                    ^"Description" STRING "This is a small, collapsible wooden stand used to dis- play a samurai’s daishō. There is a particular etiquette to displaying the daishō on a rack that speaks to an individual’s ease or readiness to fight. If the swords are displayed with their pommels facing right, this means that the individual is ready to fight, as they can easily draw the swords from the rack with their right hand. If they are displayed with the pommels facing left, this means that the individual is less ready to fight but still guarded. If the pommels are facing left and the tsuba are on the inside of the rack arm, making drawing the swords impossible in one motion, this means that the individual is completely at ease."
                }
            }

            #EWoWekCk0uG8uyoKEysWsQ ^"Dice and Cup" DEF {
                PROPERTIES {
                    ^"Rarity" STRING "2"
                    ^"Price" STRING "25 zeni"
                    ^"Description" STRING "These are used to play a variety of dice games through- out Rokugan. Gambling is extremely popular in the Emerald Empire, but it is largely frowned upon by samu- rai. Organized gambling is controlled largely by various criminal syndicates and is often a source of corruption among local officials."
                }
            }

            #KyQgSIaYkagMaMI0UkOsMU ^"Divination Kit" DEF {
                PROPERTIES {
                    ^"Rarity" STRING "4"
                    ^"Price" STRING "1 bu"
                    ^"Description" STRING "Popular among both superstitious peasants and the mystical shugenja, divination kits are used to tell the future or otherwise commune with the Spirit Realms. A divination kit may contain special coins, sticks, bones, or other small items with metaphysical import. Diviners use these kits by casting their coins or sticks on the ground and reading the patterns they create for any omens or portents."
                }
            }

            #MOuIWs2ywMaWMm8MKeIIIi ^"Finger of Jade" DEF {
                PROPERTIES {
                    ^"Qualities" LIST OF STRING ["Sacred"]
                    ^"Rarity" STRING "6"
                    ^"Price" STRING "1 koku"
                    ^"Description" STRING "A finger of jade is a length of the precious green stone worn about the neck on a thong to ward off the cor- rupting effects of the Taint. Bit by bit, the finger of jade is consumed by this process."
                }
            }

            #SsWOso64KQC2sE4EUe4WYG ^"Games" DEF {
                PROPERTIES {
                    ^"Rarity" STRING "3"
                    ^"Price" STRING "1 bu"
                    ^"Description" STRING "These are small, portable, sturdy versions of games made to be taken on long journeys. Go, shōgi, and other games popular among bushi and courtiers are the ones most likely to be found in a travel-sized set, but there are as many different types of travel games as there are full-sized versions."
                }
            }

            #UM2IyOoeoiswEUGssCUwKi ^"Kubi Bukuro" DEF {
                PROPERTIES {
                    ^"Qualities" LIST OF STRING ["Wargear"]
                    ^"Rarity" STRING "2"
                    ^"Price" STRING "2 zeni"
                    ^"Description" STRING "These are simple net bags used to carry the severed head of an enemy, which is considered both a trophy and a good omen. Lion Clan samurai use them to carry their trophies without touching dead flesh, but the Kuni family uses them for collecting samples of Shadowlands crea- tures for study."
                }
            }

            #WmeAckaoYyAU6K28S6YWoY ^"Lucky Cricket" DEF {
                PROPERTIES {
                    ^"Rarity" STRING "4"
                    ^"Price" STRING "4 bu"
                    ^"Description" STRING "Very popular among the Mantis Clan, a small live crick- et in an ornate metal cage is thought to bring good fortune to whomever carries it."
                }
            }

            #cG84WYOCoEwmYGukM4Wicg ^"Medicine Kit" DEF {
                PROPERTIES {
                    ^"Rarity" STRING "3"
                    ^"Price" STRING "1 bu"
                    ^"Description" STRING "This is a simple first aid kit that contains all the nec- essary items to treat many kinds of injuries. A typical kit contains needle and thread, cloth bandages, herbal disinfectants, various balms and tinctures, and other healing items."
                }
            }

            #Y0Ak84MOoMuAegcMkyUiKm ^"Musical Instrument" DEF {
                PROPERTIES {
                    ^"Rarity" STRING "2–6"
                    ^"Price" STRING "1–5 bu"
                    ^"Description" STRING "Rokugani musical traditions are rich and varied. Many people in the Empire can at least pick out a simple tune on a flute or drum. Instruments also include the sham- isen, biwa, and koto. Many courtiers carry an instru- ment to display their talents, and drums are popular among the samurai class for signaling troops and send- ing messages."
                }
            }

            #wUmOmcoakkugCLmaqAUug4 ^"Omamori" DEF {
                PROPERTIES {
                    ^"Rarity" STRING "2"
                    ^"Price" STRING "5 bu"
                    ^"Description" STRING "Omamori are protective charms, sold at many shrines across the Emerald Empire, often in the form of a small envelope or bag containing a written or inscribed prayer to a particular kami (often one of the great Fortunes, but occasionally others). Most examples provide protection against ill fortune of a specific variety such as illness or accidents, or encourage good luck in some sphere, such as farming, travel, or marriage, but are never put to the test in any rigorous manner—the kami move by paths unseen by mortal eyes, after all, and it is hard to determine if a talisman was truly responsible for one’s safety. Shugenja and other powerful servants of the kami are capable of creating especially efficacious protective charms. These frequently contain appeals to the seven Great Fortunes (such as the three listed here), but can also offer other protections by appealing to different powers."
                }
            }

            #EGe42yQCWgcQGmYc4wwQKS ^"Personal Seal or Chop" DEF {
                PROPERTIES {
                    ^"Qualities" LIST OF STRING ["Ceremonial"]
                    ^"Rarity" STRING "6"
                    ^"Price" STRING "4 bu"
                    ^"Description" STRING "A personal chop is used by samurai to verify their iden- tity and sign documents, among other official business. Each one is a unique design that is registered with the Miya family. Using another samurai’s chop is consid- ered both an insult and a serious crime."
                }
            }

            #4Mqq8OIYO6gy0iAwsAUc4G ^"Pillow Book" DEF {
                PROPERTIES {
                    ^"Rarity" STRING "2"
                    ^"Price" STRING "3 zeni"
                    ^"Description" STRING "This is a small, loosely bound, cheap- ly made book written in a genre some samurai consid- er insufficiently serious, such as romance, adventure, or poetry. A pillow book can also be an account of a famous person’s life or an adaptation of a diary. Occa- sionally, important literary or academic works are con- verted to pillow books to make them more portable."
                }
            }

            #eKiiO8oUu8KC2MMCkmQasE ^"Poison (One Vial)" DEF {
                PROPERTIES {
                    ^"Qualities" LIST OF STRING ["Forbidden"]
                    ^"Rarity" STRING "5"
                    ^"Price" STRING "30 zeni for one dose"
                    ^"Description" STRING "In the courts of the Emerald Empire, the wheels of politics are sometimes turned by unsavory means. Members of the Scorpion Clan are certainly not above using poison to weaken or eliminate political rivals—not that one could ever prove their culpability—and many samurai turn to such measures in times of desperation or fear."
                }
            }

            #CKCs8au2cUYMeCkaeoa4ee ^"Quiver of Arrows" DEF {
                PROPERTIES {
                    ^"Rarity" STRING "1"
                    ^"Price" STRING "20 zeni"
                    ^"Description" STRING "A quiver is a cloth or leather container used to carry arrows. Worn at the waist or slung over the shoulder, a standard quiver can hold sixty or more arrows. There are also quivers or equivalent carrying pouches for crossbow quarrels, blowgun darts, stones, and other ammunition, and they function in the same manner."
                }
            }

            #Gi0I6AIqo80WiM6wAI6Agu ^"Rope (By the Foot)" DEF {
                PROPERTIES {
                    ^"Rarity" STRING "1"
                    ^"Price" STRING "5-20 zeni per foot"
                    ^"Description" STRING "Rope is made from a variety of materials and is used for tasks as varied as binding enemies, restraining live- stock, climbing, and rigging sailing vessels. Low-quality ropes are made of hemp and tend to be both rough and stiff. Higher-quality ropes are made of hair, silk, or more exotic fibers."
                }
            }

            #KEyO06moCO6y0iCGiCyW88 ^"Sake Cup" DEF {
                PROPERTIES {
                    ^"Rarity" STRING "2"
                    ^"Price" STRING "1 bu"
                    ^"Description" STRING "These are small wood, porcelain, or metal cups used for drinking sake. In many areas of the Empire, it is customary for a guest to bring their own cup to gath- erings and official functions. Wealthy or influential peo- ple tend to carry ornately decorated cups made from expensive materials to better impress fellow drinkers."
                }
            }

            #wuWuUMQwCgSgqyGEkiKmkk ^"Spices" DEF {
                PROPERTIES {
                    ^"Rarity" STRING "5–7"
                    ^"Price" STRING "1–5 bu per small bottle"
                    ^"Description" STRING "Spices are important both for flavoring food and as a trade commodity throughout Rokugan. While some important varieties are native to the Emerald Empire, such as wasabi and sanshō pepper, many are import- ed from abroad. Depending on their provenance and rarity, spices can be extremely expensive. Much blood has been spilled by various factions in attempts to control the spice trade."
                }
            }

            #S84CSqK2Am6yCUG8MEoimw ^"Sweets (Four Servings)" DEF {
                PROPERTIES {
                    ^"Rarity" STRING "1"
                    ^"Price" STRING "1 bu"
                    ^"Description" STRING "These are candies, small cakes, and other confections that are popular during the Empire’s many festival sea- sons. Typical Rokugani sweets are made from bean curd or honeyed rice, but a few gaijin treats made from exotic and foreign ingredients are produced here and there throughout Rokugan. This is especially true in the Unicorn lands."
                }
            }

            #cMW0AKQI2O2yMAA2iWkUkS ^"Tattoo Needles" DEF {
                PROPERTIES {
                    ^"Rarity" STRING "4"
                    ^"Price" STRING "1 bu per set"
                    ^"Description" STRING "Extremely popular among the Dragon Clan, these are steel or bamboo needles used to apply tattoos. Tattoo needles are ordinarily part of a kit that includes nee- dles, various pigments, and other tools used by tattoo artists in their work. Widespread not only in the Drag- on Clan, tattoos are also prevalent among the Empire’s numerous criminal cartels, which use them both to identify members of specific cartels and to record indi- viduals’ criminal exploits."
                }
            }

            #W2CiyCSA8gk0k8KyY08eeO ^"Tea Set (Portable)" DEF {
                PROPERTIES {
                    ^"Rarity" STRING "6"
                    ^"Price" STRING "1 koku"
                    ^"Description" STRING "The tea ceremony is exceptionally important in Rokugani society. These small, portable tea sets are designed to withstand rough handling and travel. They allow samurai to enjoy the harmony and relaxation of the tea ceremony even when they are far from home."
                }
            }

            #m2cIGyyGoo0oQG6SAyaq4e ^"Tent (Chomchong)" DEF {
                PROPERTIES {
                    ^"Rarity" STRING "7"
                    ^"Price" STRING "20 koku"
                    ^"Description" STRING "Chomchong are large, elaborate, portable homes popular with the Unicorn Clan. Sturdy and well protected from the elements, these tents can accommodate up to a dozen people in relative comfort. They are also used to house small noble families in as much luxury as can be afforded in the field. Chomchong take quite a bit of time to set up and tear down, and carrying them requires several oxen and a large wagon."
                }
            }

            #uEm22seUoUMkwqC2m6CUuI ^"Tent (Small)" DEF {
                PROPERTIES {
                    ^"Rarity" STRING "3"
                    ^"Price" STRING "1 koku"
                    ^"Description" STRING "These basic shelters are just big enough to keep two individuals warm and dry in the wilderness. They are extremely easy to set up and take down, pack down relatively small, and can be carried on a person’s back, in a cart, or slung over a horse."
                }
            }

            #uoc4okWOGEgYSwKYc4K6W6 ^"Tent (Yurt)" DEF {
                PROPERTIES {
                    ^"Rarity" STRING "5"
                    ^"Price" STRING "10 koku"
                    ^"Description" STRING "Bigger than basic tents but not as big or luxurious as chomchong, yurts were brought to Rokugan from the far-off steppes by the Unicorn Clan. Made from thick leather or canvas with a felt floor, a yurt can house a group of four indefinitely in relative comfort. They are heavy and awkward to build or take down, and require either a horse or oxen dedicated to carting them around."
                }
            }

            #2CsmUcCioiW0WYyIOq4SO2 ^"Traveling Rations" DEF {
                PROPERTIES {
                    ^"Rarity" STRING "1"
                    ^"Price" STRING "5 zeni per meal"
                    ^"Description" STRING "Traveling rations consist of a mix of preserved foods sufficient to keep an individual fed and healthy while on the road. They typically consist of a mix of dried fish, rice balls wrapped in paper, water or tea, pickled vege- tables, and other hardy foods that can withstand expo- sure to the elements."
                }
            }

            #4cOegYo02eUgku26QSgemY ^"Umbrella" DEF {
                PROPERTIES {
                    ^"Rarity" STRING "4"
                    ^"Price" STRING "2 bu"
                    ^"Description" STRING "Normally made of wicker and silk, umbrellas keep both the sun and the rain off of those who carry them. Sto- ries tell of umbrellas being used as improvised weap- ons by masters of the sword, though such fantastical feats would prove difficult for most to replicate."
                }
            }

            #A6uWwQg0gy0ki6wGAI4Y8o ^"Whetstone" DEF {
                PROPERTIES {
                    ^"Rarity" STRING "1"
                    ^"Price" STRING "1 zeni"
                    ^"Description" STRING "Whetstones are portable grinding stones used to sharpen most bladed weapons, save for a samurai’s katana and wakizashi, which must be sharpened by an accomplished weaponsmith or professional polisher."
                }
            }
        }
    }


    # ===========================
    # HONOR/GLORY/STATUS MECHANICS
    # ===========================

    # Honor, glory, and status are important aspects of a character.
    # They help players roleplay and give clear indicators of costs
    # their choices might incur and the standing of others. It usually
    # falls to the GM to bring these attributes into the game.
    #
    # Players can make checks to determine an NPC's honor, glory, or
    # status to predict their behavior. The GM can have NPCs do the
    # same to the PCs, giving different reactions based on these values.

    # --- FORFEIT AND AWARD SCALE ---
    # When a player chooses to forfeit or stake honor or glory, or
    # when the GM awards honor or glory, consult this scale:
    ^"Honor and Glory Forfeit and Award Scale" DEF {
        EXTENDS #L5R464yZ6aB8cD0eF2gH4i ^"Table"

        SCALE {
            "Trifling" "Forfeit: 1, Award: 1"
            "Minor" "Forfeit: Attribute Rank, Award: 3"
            "Major" "Forfeit: Attribute Rank x 2, Award: 6"
            "Massive" "Forfeit: Attribute Rank x 4, Award: 9"
        }
        # "Attribute Rank" is the tens digit of the relevant attribute
        # (honor or glory). A trifling breach or sacrifice is any the GM
        # deems too small to be minor but too large to fully ignore.
    }

    # ===========================
    # HONOR
    # ===========================

    ^"Honor in Play" DEF {
        APPLIES TO [^"Samurai"]

        # Bushidō ("way of the warrior") is the code by which nearly all
        # samurai strive to live. Samurai are taught to reach for these
        # ideals at the expense of personal gain. The "breaking point"
        # when one abandons Bushidō makes for rich story material, as
        # does when tenets inevitably conflict with each other.
        #
        # Honor does not align exactly with Rokugan's legal system. Some
        # things are dishonorable but not criminal — killing someone of
        # lower station without just cause may be within legal rights but
        # is a severe violation of Compassion (Jin).

        # --- FORFEITING AND STAKING HONOR ---
        # Characters must forfeit honor to breach the tenets of their code,
        # and are awarded honor when they make sacrifices in the name of
        # those tenets. Because honor is internal to the character, this
        # occurs regardless of how few witnesses there are.
        #
        # Honor cannot be gained without adversity. The GM should award
        # honor for deeds that put the code above immediate needs or desires.
        # Characters generally should not be awarded honor for things that
        # cost them nothing or are not accompanied by risks.

        # --- THE TENETS OF BUSHIDŌ ---

        TENETS {

            #P7ouQUyTbMQiMVoYrs1sX0 ^"Compassion (Jin)" DEF {
                DESCRIPTION "Just as the farmer does not grow crops merely to fill their own belly, the warrior does not fight for just their own sake. A samurai must be constantly aware of their duty to protect others."
                BREACHES {
                    "Minor: Verbal cruelty to a foe or stranger, allowing easily prevented suffering, tormenting animals."
                    "Major: Verbal cruelty to a friend, physically harming someone for revenge alone, letting an ally die without trying to save them."
                    "Massive: Murdering someone of lower status in cold blood, physically harming someone for fun."
                }
                SACRIFICES {
                    "Minor: Giving someone a common useful item, spending two or more downtime scenes helping a friend, treating a foe's wounds after a battle."
                    "Major: Giving up your chance to be awarded 6 or more ^\"Glory\" for someone else, saving someone's life despite knowing they may trouble you later."
                    "Massive: Giving away an irreplaceable item, completing a dangerous heroic task for someone else who cannot repay you."
                }
            }

            #66h0uQN3ONMz3NY22rmHgN ^"Courage (Yū)" DEF {
                DESCRIPTION "Only fear of death can destroy life; the samurai replaces it with an understanding of danger. Common folk allow fear to swallow their hearts. An extraordinary soul is one with the courage to live as if each moment were the last."
                BREACHES {
                    "Minor: Allowing fear for yourself to influence your actions, leaving a lost battle to protect your lord."
                    "Major: Allowing fear to prevent you from acting entirely, fleeing to save your own skin."
                    "Massive: Committing a despicable act out of fear, sacrificing someone else to save yourself."
                }
                SACRIFICES {
                    "Minor: Refusing to back down from an armed enemy while unarmed, accepting a challenge from a foe you know to be a superior warrior."
                    "Major: Facing an inhuman foe such as an oni alone, preventing a comrade's massive breach, suffering a severity 8 or lower ^\"Critical Strike\" for your lord."
                    "Massive: Preventing your lord's major or massive breach, suffering a severity 8 or higher critical strike for your lord."
                }
            }

            #1y4baop3cFRDrPLyuAlPcH ^"Courtesy (Rei)" DEF {
                DESCRIPTION "A samurai is neither a bully nor a brute killer. Samurai must treat their enemies with Courtesy."
                BREACHES {
                    "Minor: Drunkenness or coarse language in the presence of someone of higher ^\"Status\", letting an insult to your clan or family pass without remark."
                    "Major: Directly insulting someone of equal or higher status, letting an insult to your ancestors, sensei, or lord pass without remark."
                    "Massive: Directly insulting your lord."
                }
                SACRIFICES {
                    "Minor: Paying a sincere compliment to a foe, allowing a tired foe a moment's respite, letting someone of higher status receive aid first."
                    "Major: Giving an unarmed foe a weapon or setting aside your own weapons to fight fairly."
                    "Massive: Taking an enemy of higher status captive without killing or maiming them."
                }
            }

            #kO1Tm2mJYywaLpT6BQXbgm ^"Duty and Loyalty (Chūgi)" DEF {
                DESCRIPTION "Actions and their consequences define those who take them. The samurai's Loyalty to their charge is unshakable."
                BREACHES {
                    "Minor: Refusing an order to protect your lord's interests, intentionally misinterpreting an order."
                    "Major: Refusing an order from your lord."
                    "Massive: Forsaking your post for another lord."
                }
                SACRIFICES {
                    "Minor: Refusing to commit an act of disloyalty to your lord despite personal feelings."
                    "Major: Refusing to obey an unjust order from someone who is not your lord."
                    "Massive: Dying in your lord's service."
                }
            }

            #PRpUhsBhyr36NAyiHRrArs ^"Honor (Meiyo)" DEF {
                DESCRIPTION "Praises and curses are not what defines Honor; the samurai reserves their own judgment."
                BREACHES {
                    "Minor: Touching dead flesh anywhere other than at war, persuading another to act dishonorably."
                    "Major: Neglecting your duty to pursue your earthly desires, killing in an unjustified duel."
                    "Massive: Refusing seppuku when required."
                }
                SACRIFICES {
                    "Minor: Persuading someone to abandon a dishonorable plan to help you."
                    "Major: Negotiating to avoid an unjustified duel."
                    "Massive: Offering to commit seppuku for failure."
                }
            }

            #zoVoPia0hYHe9WL4wjCD3F ^"Righteousness (Gi)" DEF {
                DESCRIPTION "Set lies aside. A samurai does not make Righteousness a matter for debate; they know that there is only truth and falsehood, justice and injustice."
                BREACHES {
                    "Minor: Abetting or covering for a comrade's major breach of honor, lying to someone of equal or lower status for personal gain."
                    "Major: Abetting or covering for a comrade's massive breach of honor, lying to someone of higher status for personal gain."
                    "Massive: Murdering someone of equal or higher status, lying to your lord for selfish gain."
                }
                SACRIFICES {
                    "Minor: Delivering bad news to your lord without deflecting blame, taking responsibility for the failure of a subordinate."
                    "Major: Retiring from a post you can no longer fulfill, relinquishing a claim or large gift to your lord."
                    "Massive: Refusing to deny true allegations of a failure requiring you to forfeit 9+ ^\"Glory\" or ^\"Status\"."
                }
            }

            #VHwEsyaKyS0oCk6HzByhTO ^"Sincerity (Makoto)" DEF {
                DESCRIPTION "Sincerity is more complex than mere Honesty; it is the ability to speak earnestly without giving offense or compromising one's family's interests. To be truthful without causing embarrassment — to maintain one's integrity while eliding unpleasant realities."
                BREACHES {
                    "Minor: Breaking your word to someone of equal or lower status, misleading a friend."
                    "Major: Breaking your word to someone of higher status, manipulating someone for fun."
                    "Massive: Deceiving or manipulating your lord."
                }
                SACRIFICES {
                    "Minor: Publicly revealing a truth that damages your reputation (a forfeit of 3 or more ^\"Glory\")."
                    "Major: Giving (honest) testimony against a political ally that jeopardizes future relations."
                    "Massive: Forfeiting 6 or more glory to claim responsibility for your lord's mistake."
                }
            }
        }

        # --- CLAN VIEWS OF BUSHIDŌ ---
        # Each clan has paramount tenets (double forfeit AND double award)
        # and lesser tenets (halve forfeit AND halve award, rounded up, min 1).

        CLAN_PARAMOUNT_TENETS {
            "Crab" "^\"Courage (Yū)\""
            "Crane" "^\"Courtesy (Rei)\""
            "Dragon" "^\"Sincerity (Makoto)\""
            "Lion" "^\"Honor (Meiyo)\""
            "Phoenix" "^\"Righteousness (Gi)\""
            "Scorpion" "^\"Duty and Loyalty (Chūgi)\""
            "Unicorn" "^\"Compassion (Jin)\""
        }

        CLAN_LESSER_TENETS {
            "Crab" "^\"Courtesy (Rei)\""
            "Crane" "^\"Courage (Yū)\""
            "Dragon" "^\"Duty and Loyalty (Chūgi)\""
            "Lion" "^\"Compassion (Jin)\""
            "Phoenix" "^\"Sincerity (Makoto)\""
            "Scorpion" "^\"Honor (Meiyo)\" and ^\"Righteousness (Gi)\""
            "Unicorn" "^\"Courtesy (Rei)\""
        }

        # --- HONOR SCORES ---
        HONOR_SCORES {
            "100" "Honor Is Stronger than Steel: Bushidō is worth upholding at any cost, even unto death. Virtues/Flaws: 3 virtue advantages."
            "80-99" "Never Stray from the Way: Has given up much to embody Bushidō and shall continue. Would rather forfeit personal desires than fail their own expectations. Virtues/Flaws: 2 virtue advantages."
            "65-79" "My Honor Is My Life: Strengthened by Bushidō, can endure its hardships. May rarely slip, but cannot easily forgive themselves. Virtues/Flaws: 1 virtue advantage."
            "30-64" "Honor Is the Ideal: Brought up to believe in Bushidō and strive to embody it. Still human and periodically succumbs to temptation, but feels guilt over betraying ideals. Virtues/Flaws: none."
            "20-29" "Honor Is about Appearances: Does not reliably uphold Bushidō but recognizes its importance to society and plays the part. Virtues/Flaws: 1 flaw disadvantage."
            "1-19" "Honor Is a Nicety: Believes most tenets get in the way. Reality no longer aligns with samurai ideals. Virtues/Flaws: 2 flaw disadvantages."
            "0" "I Make My Own Code: Has completely lost faith in Bushidō and adheres to another code — or none at all. Virtues/Flaws: 3 flaw disadvantages."
        }

        RULES {
            #L5R445bC7dE9fG1hI3jK5l: honor_forfeiting_and_awarding
            #L5R446mN8oP0qR2sT4uV6w: bushido_tenets_and_breaches
            #L5R446aN8oP0qR2sT4uV7x: clan_paramount_and_lesser_tenets
            #L5R447xY9zA1bC3dE5fG7h: honor_score_thresholds
        }
    }

    # ===========================
    # GLORY
    # ===========================

    ^"Glory in Play" DEF {
        APPLIES TO [^"Samurai"]

        # Glory is the external measure of a character's outward success
        # as a samurai. The higher a character's glory, the more widely
        # they are recognized as a paragon; the lower, the more others
        # believe they are unworthy of the name.

        # --- FORFEITING GLORY ---
        # A character must forfeit glory to undertake certain actions
        # publicly. Unlike honor, glory relies upon external perception,
        # so actions taken clandestinely do not require forfeiting glory
        # (though sometimes they require staking it upon avoiding discovery).

        GLORY_FORFEITS {
            "Minor: Ignoring an insult to your person, choosing to share credit for a deed, admitting a lie publicly, declining a gift from someone of higher ^\"Status\", losing an ancestral weapon."
            "Major: Murdering someone of lower status, choosing to leave the public eye for months, not arriving to a duel, attacking a surrendering foe."
            "Massive: Murdering someone of equal or higher status, ordering a retreat in a ^\"Mass Battle\", refusing seppuku when required."
        }

        # --- AWARDING GLORY ---
        # When a character is recognized for a notable deed (real or
        # fabricated), the GM should award glory based on the degree
        # of acclaim it represents.

        GLORY_AWARDS {
            "Minor: Receiving a gift from someone of higher ^\"Status\", beating a foe with glory 40+ in a duel or public contest, marrying or arranging a family marriage to someone of higher glory."
            "Major: Commanding your side to victory in a ^\"Mass Battle\", defeating a foe with glory 60+ in a duel or public contest, defeating an oni or similar monster with a group, marrying or arranging a marriage to someone of higher status."
            "Massive: Defeating a foe with glory 80+, defeating an oni alone, winning a war, marrying or arranging a marriage into the Imperial family."
        }

        # --- GLORY SCORES ---
        GLORY_SCORES {
            "100" "Undying Legend: A legendary hero worthy of poetry and song, known even among peasants and foreigners. Fame/Infamy: 3 fame advantages."
            "90-99" "Renowned Hero: Counted among the greatest in their clan, exploits spread to far corners of the Empire. Fame/Infamy: 2 fame advantages."
            "80-89" "Exceptional Samurai: Impressive deeds have garnered attention in the courts of other clans."
            "65-79" "Respected Adept: Great accomplishment, name known outside their family. Fame/Infamy: 1 fame advantage."
            "60-64" "Worthy Retainer: An extremely competent and valued samurai."
            "45-59" "Reputable Samurai: Known for effectiveness and reliability."
            "40-44" "Unremarkable Retainer: An ordinary samurai."
            "30-39" "Samurai of No Renown: Reputation marred by failure, disappointment, or ill omen."
            "20-29" "Disappointment: Considered incompetent or untrustworthy."
            "10-19" "Renegade: Known for misdeeds across several provinces. Fame/Infamy: 1 infamy disadvantage."
            "1-9" "Villain: Heinous acts known across the land. Fame/Infamy: 2 infamy disadvantages."
            "0" "Figure of Dread: One of the most vile or scandalous individuals in the Empire. Fame/Infamy: 3 infamy disadvantages."
        }

        RULES {
            #L5R448iJ0kL2mN4oP6qR8s: glory_forfeiting_and_awarding
            #L5R449tU1vW3xY5zA7bC9d: glory_score_thresholds
        }
    }

    # ===========================
    # STATUS
    # ===========================

    ^"Status in Play" DEF {
        APPLIES TO [^"Samurai"]

        # Status is much more static than honor and glory: rarely do
        # characters need to forfeit it, and generally they only receive
        # it upon receiving a new title. If a character does need to
        # forfeit status, they often reset it to a specific value (e.g.,
        # retiring to a monastery sets status to 25). Rarely, characters
        # can be stripped of status. To willfully endanger status, a
        # character must stake an amount determined by the GM on covering
        # up their actions.

        # --- COMPARING STATUS ---
        # Status is most often used to know which of two characters stands
        # higher in the Celestial Order. The Social skills reference
        # interacting with characters of lower, higher, or equal status,
        # as do many examples of honor and glory forfeits/awards.
        # Most NPCs defer to those of higher status and expect obedience
        # from people of lower status — how they express this can hint
        # at their true nature.

        STATUS_SCORES {
            "100" "The ruling Emperor."
            "90-99" "The Imperial Spouse, Voice of the Emperor, Emperor's children, daimyō of Imperial families, Emerald Champion, Jade Champion, Imperial Advisor, Imperial Chancellor."
            "80-89" "Great Clan Champion."
            "70-79" "Minor Clan Champion, Imperial Herald, Imperial Treasurer, Great Clan family daimyō, a great general."
            "60-69" "A hatamoto, a provincial governor, a commander of multiple companies."
            "50-59" "A city governor, a captain of a military company, a vassal family daimyō."
            "40-49" "Darō, Emerald/Jade Magistrate, revered sensei, clan magistrate, lieutenant."
            "30-39" "Abbot of the Brotherhood, average Great Clan samurai."
            "25-29" "Average Minor Clan or vassal family samurai, monk of the Brotherhood."
            "20-24" "Village officer, disgraced samurai, rōnin."
            "10-19" "Ashigaru, artisan, laborer."
            "1-9" "Merchant, bandit."
            "0" "Burakumin (entertainer, geisha, leatherworker, butcher, torturer, or gravedigger), one outside the Celestial Order."
        }

        RULES {
            #L5R450eF2gH4iJ6kL8mN0o: status_comparison_and_forfeiting
            #L5R450aF3gH5iJ7kL9mN1p: status_score_examples
        }
    }

    # ===========================
    # TITLES
    # ===========================

    #L5R463nO5pQ7rS9tU1vW3x ^"Title" DEF {
        APPLIES TO [^"Samurai"]

        # A title is assigned as a result of narrative events. It functions
        # much like a school curriculum: a character can spend experience
        # to deepen their understanding of how to fulfill its functions,
        # and eventually unlock a special ability after spending the listed XP.
        #
        # When assigned a title, a character's ^"Status" might change based
        # on the Status Award listed in the title.
        #
        # A title exists in parallel to a character's ^"School". A character
        # can only have one incomplete title at a time.
        #
        # Each time a character purchases an advancement, the character may
        # allocate the XP spent to completing their title (with full value
        # for listed advancements and half value for non-listed advancements,
        # as with a curriculum). XP allocated to a title does NOT count
        # toward the character's current school rank (and vice-versa).
        #
        # Once a character has allocated the completion cost in XP, they
        # acquire the title ability. The title is then considered complete
        # (though narratively the character retains it), and they may be
        # assigned a new title as narrative events permit.

        PROPERTIES {
            ^"Assigned By" STRING  # Who can grant this title
            ^"Status Award" STRING  # Status change on assignment (e.g. "+15 to max 40")
            ^"XP to Completion" INTEGER  # Total XP that must be allocated
            ^"Title Ability" STRING  # Special ability gained on completion
            ^"Curriculum" LIST OF STRING  # Listed advancements (full XP value)
        }

        RULES {
            #L5R450bG4hI6jK8lM0nO2p: title_assignment_and_completion
            #L5R450cH5iJ7kL9mN1oP3q: title_xp_allocation_parallel_to_school
        }
    }

    ^"Emerald Magistrate" DEF {
        EXTENDS #L5R463nO5pQ7rS9tU1vW3x ^"Title"

        # Emerald Magistrates are agents of the Emperor's Law,
        # warrior-sages who dispense wisdom and justice.

        ASSIGNED_BY "The Emerald Champion, the Emperor, and other high-ranking officials in the office of the Emerald Champion can appoint Emerald Magistrates, and do so when a samurai proves worthy of the post or when the need arises for more arbiters of the Emperor's Justice."
        STATUS_AWARD "+15 (to a maximum of 40)"
        XP_TO_COMPLETION 30

        TITLE_ABILITY {
            ^"Voice of Authority" "Once per game session when making a Scheme or Support action check using a Social skill, you may choose additional targets equal to your ^\"Glory\" rank. You cannot choose any additional target with vigilance higher than the highest among your initial targets."
        }

        CURRICULUM {
            "Trade Skills" "Skill Group"
            "Fitness" "Skill"
            "Martial Arts [Choose One]" "Skill"
            "Performance" "Skill"
            "Rank 1-2 Kata" "Technique Group"
            "Open-Hand Style" "Technique (Kata)"
            "Shallow Waters" "Technique (Shūji)"
        }
    }

    # ===========================
    # ADDITIONAL RULES FOR CHECKS
    # ===========================

    ^"Assistance" DEF {

        # When one character dedicates significant effort to helping
        # another (rather than accomplishing a separate goal).

        # Step 3 (Assemble and Roll Dice Pool): The character making
        # the check rolls one additional (skill) per assisting character
        # who has 1+ ranks in the skill in use, and one additional (ring)
        # per assisting character who has 0 ranks. Each assisting player
        # must describe how they are helping; the GM decides if they
        # can contribute.
        #
        # Step 4 (Modify Rolled Dice): At GM's discretion, up to one
        # advantage from one assisting character can be applied.
        #
        # Step 5 (Choose Kept Dice): The character making the check
        # may keep up to 1 additional die per assisting character.
        #
        # Step 6 (Resolve Symbols): Each assisting character may choose
        # to suffer 1 strife to negate 1 (st) symbol on the check.

        # --- LIMITS ON ASSISTANCE ---
        # The GM is the final arbiter of whether a character's attempt
        # to help is actually useful enough to grant this benefit, as
        # well as whether there is a maximum number of characters who
        # can feasibly assist. GMs should feel free to allow only one
        # character to assist in many circumstances.

        RULES {
            #L5R451pQ3rS5tU7vW9xY1z: helper_rolls_skill_or_ring_die
            #L5R452aB4cD6eF8gH0iJ2k: main_keeps_plus_one_per_helper
            #L5R453lM5nO7pQ9rS1tU3v: one_advantage_from_one_helper
            #L5R454wX6yZ8aB0cD2eF4g: helper_spends_strife_to_negate
        }
    }

    ^"Bonus Successes and Shortfall" DEF {

        # Sometimes the degree of success or failure matters.

        # Bonus Successes: If a character succeeds on a check, their
        # bonus successes are the number of (su) and (ex) symbols in
        # excess of the target number.
        #
        # Shortfall: If a character fails, their shortfall is the TN
        # minus the sum of their (su) and (ex) symbols.

        RULES {
            #L5R454aX6yZ8aB0cD2eF5h: bonus_successes_calculation
            #L5R454bY7zA9bC1dE3fG6i: shortfall_calculation
        }
    }

    ^"Checks to Resist Effects" DEF {

        # Sometimes the target of a check can make their own check to
        # resist. When a character succeeds at a check to resist an
        # effect, they avoid some or all ill effects they would
        # otherwise have suffered.
        #
        # When setting the TN to resist another check's effects, if
        # no TN is listed, the GM sets one. If they want to account
        # for the acting character's effort, they can use the acting
        # character's bonus successes to modify the resisting TN.

        RULES {
            #L5R454cZ8aB0cD2eF4gH7j: resist_check_mechanics
        }
    }

    ^"Competitive Checks" DEF {

        # When the GM needs to compare performance of two or more
        # characters on similar checks where neither is clearly
        # resisting the other. The character with the most bonus
        # successes (or smallest shortfall, if all failed) performs
        # the task best, most quickly, or most efficiently.

        RULES {
            #L5R454dA9bC1dE3fG5hI8k: competitive_check_comparison
        }
    }

    ^"Minimum TN" DEF {

        # The TN of a check cannot be reduced below 1 by modifiers.
        # A TN 0 check would be trivial (carrying quarter of one's
        # weight, remembering a cousin's name) and should not normally
        # require a check. However, if circumstances make it hard
        # enough or it is important to know bonus successes, the GM
        # could call for a TN 0 check.

        RULES {
            #L5R454eB0cD2eF4gH6iJ9l: minimum_tn_is_one
        }
    }

    ^"Modifying the Dice Pool" DEF {

        # Any effect that changes the contents of the dice pool (dice,
        # results, or symbols) after it has been rolled. A die can be
        # modified multiple times if multiple different effects instruct
        # it. Each effect is fully resolved before resolving a different
        # effect.

        TERMINOLOGY {
            "Specific Results: A die set to or showing a specific result refers to a face with exactly the specified symbols (e.g. 'add a (ring) set to an (op)(st) result')."
            "Results Containing Symbols: A die result containing a specified symbol refers to any result that includes at least one instance of that symbol (e.g. 'reroll a die containing (su)')."
            "Maximum Modification: If a single effect instructs modifying two or more dice, a single die cannot be selected multiple times. If the number exceeds eligible dice, modify as many as possible."
        }

        ADDING_AND_CANCELLING {
            "Add a Rolled Die: During Step 4, place one die of the noted type set to the specified result. It is a rolled die."
            "Cancel a Rolled Die: During Step 4, choose one die as instructed. It becomes a dropped die."
            "Add a Kept Die: After Step 5, place one die of the noted type set to the specified result. It is a kept die."
            "Cancel a Kept Die: After Step 5, choose one die as instructed. It becomes a dropped die."
        }

        OTHER_MODIFICATIONS {
            "Alter: Pick up a die and set it to a different result as instructed."
            "Negate: Ignore that symbol when resolving the check (but not other symbols from the same result)."
            "Reroll: Roll a die again and use the new result."
            "Reserve: Remove a die from the roll, set it aside or record its result. Used for a future roll as described by the effect."
        }

        # --- SIMULTANEOUS DICE MODIFICATION ---
        # If two or more effects would modify a die, the player who
        # made the check resolves them in order:
        # 1. NPCs' effects (and other effects the GM controls)
        # 2. Other player characters' effects
        # 3. Their own character's effects
        # If a single player controls multiple effects, that player
        # chooses the order.

        RULES {
            #L5R454fC1dE3fG5hI7jK0m: dice_modification_rules
            #L5R454gD2eF4gH6iJ8kL1n: simultaneous_modification_order
        }
    }

    ^"Targeting and Checks" DEF {

        # Some checks directly affect one or more other characters.
        # These characters are considered targets of that check. If
        # an effect specifies it, objects and positions in space can
        # also be the target of a check.

        RULES {
            #L5R454hE3fG5hI7jK9lM2o: targeting_rules
        }
    }

    ^"Universal Tiebreaker" DEF {

        # When effects that break ties still result in a stalemate:
        # - PCs supersede NPCs
        # - Adversary NPCs supersede minion NPCs
        # If there is still a tie, the GM should use a randomized
        # means (coin flip, rock-paper-scissors, etc.).

        RULES {
            #L5R454iF4gH6iJ8kL0mN3p: universal_tiebreaker
        }
    }

    # ===========================
    # DOWNTIME AND RECOVERY
    # ===========================

    ^"Downtime" DEF {

        # Downtime scenes encompass the passage of time — as short as a
        # few hours of rest or as long as a journey from Otosan Uchi to
        # the Kaiu Wall. Generally low dramatic stakes, though still
        # important to character arcs and narrative.
        #
        # Time is not formally regimented; the GM and players roleplay
        # only the moments that matter, treating anecdotes as narrative
        # scenes interspersed within the downtime scene. A journey might
        # last weeks but contain only a few roleplayed interactions.
        #
        # Characters can be called upon to make checks during downtime
        # based on desired activities or circumstances the GM introduces.
        # If the order and economy of actions becomes important, the GM
        # should switch to a conflict scene. If a player wishes to jump
        # into interpersonal interaction, the GM should briefly shift to
        # a narrative scene.

        # --- DOWNTIME ACTIVITIES ---
        # At the start of each downtime scene, each player chooses the
        # downtime activity their character is pursuing. Not all activities
        # are suitable to all downtime scenes — the GM is the final arbiter
        # of whether an activity can reasonably be completed during a
        # particular downtime scene.

        # --- LONG DOWNTIME SCENES ---
        # During especially lengthy downtime scenes (longer than two days),
        # each PC may pursue multiple activities sequentially. As a rule of
        # thumb, the GM should allow one downtime activity per two days of
        # downtime. At GM's discretion, a character might squeeze in an
        # extra activity by sacrificing sleep and other necessities.
        # Downtime scenes dedicated to arduous activities such as travel
        # might not give PCs any opportunity for downtime activities besides
        # traveling itself, or at least limit their options.

        # --- EXTREMELY LONG NARRATIVE GAPS ---
        # For time-skips of a month or more, the GM should stipulate the
        # time passes, let players describe what their characters do, and
        # allocate a small amount of XP to reflect growth. Such gaps are
        # good opportunities for PCs to pursue societal obligations, return
        # to their dōjō for training, or undertake individual endeavors
        # that do not involve the larger group.

        RULES {
            #L5R455hI7jK9lM1nO3pQ5r: downtime_activities_per_scene
            #L5R456sT8uV0wX2yZ4aB6c: long_downtime_one_per_two_days
            #L5R457dE9fG1hI3jK5lM7n: extremely_long_narrative_gaps
        }
    }

    # ===========================
    # HARM AND HEALING
    # ===========================

    ^"Damage" DEF {

        # When a character is in peril of suffering bodily harm, this
        # is represented through damage — a numerical abstraction of
        # the harm a character could suffer from a blow, fall, or mishap.

        # --- DEALING DAMAGE ---
        # When an effect deals damage, three possible outcomes:
        # 1. The character reduces the damage to 0 with armor or
        #    similar protection.
        # 2. The character defends against the damage by receiving
        #    fatigue equal to any remaining damage.
        # 3. If the character does not reduce to 0 or defend, they
        #    suffer a ^"Critical Strike" with severity based on the
        #    damage source.

        # --- INCREASING AND REDUCING DAMAGE ---
        # Before dealing damage, first apply increases, then reductions
        # (to a minimum of 0). If reduced to 0, the character does not
        # need to defend. Resistance from armor and other effects is
        # one way to reduce damage.

        # --- DEFENDING AGAINST DAMAGE ---
        # When damage remains after reductions, the character must
        # defend by receiving fatigue equal to the remaining damage.
        # If they cannot defend, they suffer a ^"Critical Strike".
        # Defending is not normally optional — instinctive reactions
        # cause dodging and rolling away. However, a character who is
        # not ^"Incapacitated" may spend 1 ^"Void Points" to voluntarily
        # suffer a critical strike instead of defending, seizing a
        # tactical advantage.
        # An ^"Incapacitated" character cannot defend and thus suffers
        # a critical strike whenever they take damage.
        # Note: A character CAN defend even if fatigue would exceed
        # ^"Endurance", but this renders them ^"Incapacitated".

        DAMAGE_TYPES {
            "Physical Damage: Dealt by punches, cuts, falls, and other physical phenomena."
            "Supernatural Damage: Dealt by invocations, ^\"Mahō\", and other mystical phenomena."
        }

        # Damage Source: determined by the effect that deals it.
        # Weapon → that weapon is the source. Supernatural power → that
        # power. Physical phenomenon (gravity, fire) → that phenomenon.

        RULES {
            #L5R458oP0qR2sT4uV6wX8y: damage_dealing_and_defense
            #L5R459zA1bC3dE5fG7hI9j: damage_types_physical_supernatural
        }
    }

    ^"Fatigue Recovery" DEF {

        # --- RECOVERING FROM FATIGUE ---
        # At the end of each scene, characters catch their breath.
        # Each character reduces their fatigue to half their ^"Endurance"
        # (rounded up) if it is over half their endurance.
        # After a full night's rest, a character heals fatigue equal to
        # two times their ^"Water" ring.

        RULES {
            #L5R460kL2mN4oP6qR8sT0u: fatigue_recovery_between_scenes
            #L5R460aL2mN4oP6qR8sT1v: fatigue_recovery_full_rest
        }
    }

    ^"Falling" DEF {

        # The length of a fall is measured in ^"Range Band" and determines
        # the ill effects. When a character lands, they must resist with
        # a TN 3 ^"Fitness" (Air 1, Earth 5) check. If they succeed,
        # reduce the number of range bands they count as having fallen
        # by 1 plus bonus successes (minimum range 0 fall).

        RULES {
            #L5R460bM3nO5pQ7rS9tU2w: falling_damage_by_range_band
        }
    }

    ^"Suffocation" DEF {

        # At the beginning of each of their turns, a suffocating
        # character receives 2 fatigue and 2 strife. The character does
        # not suffer ^"Critical Strike" for wounds suffered this way.
        # At the beginning of each turn while suffocating, if the
        # character is suffering ^"Unconscious", they must resist with
        # a TN 3 ^"Fitness" (Earth) check. If they fail, they perish.

        RULES {
            #L5R460cN4oP6qR8sT0uV3x: suffocation_fatigue_and_strife
        }
    }

    ^"Death" DEF {

        # Player characters are the main characters of the story.
        # Death at a particular juncture is not always the most
        # interesting outcome. It is a classic trope for a samurai to
        # survive defeat and bear shame while seeking to restore honor.
        # However, L5R is meant to evoke a setting where characters
        # stand to lose their lives in pursuit of duties and passions.
        # The rules are calibrated to balance dramatic tension, story
        # flow, and fun for everyone at the table.

        RULES {
            #L5R460dO5pQ7rS9tU1vW4y: death_narrative_considerations
        }
    }

    # ===========================
    # TERRAIN AND ENVIRONMENT
    # ===========================

    ^"Terrain" DEF {

        ENUM ["Dangerous", "Defiled", "Entangling", "Hallowed", "Imbalanced", "Obscuring"]

        # Terrain features occupy a number of ^"Range Band" around a
        # particular position, as determined by the GM. A terrain feature
        # can be as small as range 0 or much larger, and can stretch
        # unevenly in different directions. At the outset of a conflict,
        # the GM establishes relevant terrain features, identifiable by
        # checks or by spending (op) from ^"Initiative" checks.
        # In mass battles, terrain qualities affect cohorts that occupy them.

        TERRAIN_QUALITIES {

            #K6eIrXpIRqbDTlWS4Dtjp6 ^"Dangerous" DEF {
                DESCRIPTION "Physically hazardous to enter or linger in. Mundane terrain found in most regions."
                EFFECTS "Whenever a character performs a check while within Dangerous terrain, the character suffers physical damage equal to the (st) symbols on their kept dice."
                EXAMPLES "Fire, intense cold, thawing ice, steep inclines, jagged rocks, an uncovered foundation, rubble."
            }

            #tu27jZEi2iZS99eymRg4Vf ^"Defiled" DEF {
                DESCRIPTION "Afflicted by the vile touch of the Shadowlands. Even the uneducated feel a pervasive sense of wrongness. Supernatural terrain found in especially unhallowed places."
                EFFECTS "At the end of the scene, each character who was within Defiled terrain must make a TN 2 ^\"Fitness\" or ^\"Meditation\" check. Each character who fails suffers ^\"Afflicted\". Tainted beings reduce the TNs of their checks to resist effects by 1 while in Defiled terrain."
                EXAMPLES "An oni's lair, a battlefield filled with unburned dead, a haunted castle, the secret hideout of a mahō-tsukai."
            }

            #cDjJizDWCLOvXE7Gf2NzQ6 ^"Entangling" DEF {
                DESCRIPTION "Ground that seriously hampers mobility. Mundane terrain found in most regions."
                EFFECTS "While within Entangling terrain, a character increases the TN of all their checks to move and for Movement actions by 2."
                EXAMPLES "Sucking mud, brier patches, deep snow, icy ground, moving water."
            }

            #9Zew9cYErF5yoDzZjiZhhk ^"Hallowed" DEF {
                DESCRIPTION "Close to one or more of the Spirit Realms; invocations are easier to perform. Supernatural terrain found where kami dwell or miracles have occurred. Associated with one or more elements."
                EFFECTS "While within Hallowed terrain, a character reduces the TN of their ^\"Meditation\" and ^\"Theology\" checks using the specified ring(s) by 1. Tainted beings increase the TN of their checks to resist effects by 1, or 2 if using the specified ring."
                EXAMPLES "A shrine to a kami, a particular place of natural beauty, a location where a powerful spirit resides."
            }

            #osCh9ZWextM97DosA4uoFI ^"Imbalanced" DEF {
                DESCRIPTION "Marked by a distinct absence or disquiet of kami of a certain element; invocations are harder to perform. Supernatural terrain found in regions affected by elemental imbalance. Associated with one or more elements."
                EFFECTS "While within Imbalanced terrain, a character increases the TN of their ^\"Meditation\" and ^\"Theology\" checks using the terrain's specified ring by 1. Otherworldly beings increase the TN of their checks to resist effects by 1, or 2 if using the specified ring."
                EXAMPLES "A forest mysteriously missing its leaves, a barren farm field, an out-of-control river."
            }

            #EVvsUwUGlgz6IPEzHnO0yf ^"Obscuring" DEF {
                DESCRIPTION "Limits the visibility of and to anyone within, making it very difficult to land strikes. Mundane terrain found in most regions."
                EFFECTS "Increase the TN of all Attack checks targeting characters within Obscuring terrain by 1. A character within Obscuring terrain generally cannot see beyond range 2 of their current position into the Obscuring terrain (though they can generally see out of it within range 2 of an edge). A character outside cannot see into it beyond range 2 of the edge."
                EXAMPLES "Dense foliage, darkness, cramped indoor quarters, heavy rain or snow, choking smoke."
            }
        }

        RULES {
            #L5R461vW3xY5zA7bC9dE1f: terrain_modifies_combat
            #L5R462gH4iJ6kL8mN0oP2q: terrain_modifies_movement
        }
    }

    ^"Tactical Grid" DEF {
        EXTENDS #L5R465jK7lM9nO1pQ3rS5t ^"Optional Rule"

        # Using ^"Range Band" on a tactical grid adds granularity.
        # Note that some distances are adjusted slightly to fit on
        # commonly sized tactical maps.

        GRID_DISTANCES {
            "Range 0: The square the character occupies."
            "Range 1: The squares adjacent to range 0."
            "Range 2: The next row of squares adjacent to range 1."
            "Range 3: The next row of squares after range 2."
            "Range 4: The next 4 rows of squares after range 3."
            "Range 5: The next 5 rows of squares after range 4."
            "Range 6: Any squares on the grid beyond range 5."
        }

        ADJACENCY "Two squares are adjacent if they share an edge or a corner."

        MOVEMENT {
            "When an effect instructs a character to move 1 or more range bands, the character moves up to 3 squares per range band."
            "Diagonal Squares: Moving into a diagonally adjacent square counts as moving 1 additional square."
            "Difficult Squares: Exiting a square occupied by an enemy or obstacle (Entangling terrain, vertical distance, etc.) counts as moving 1 additional square (up to 3 total if also diagonal)."
            "Resolving Movement: Each move from one square to the next is resolved sequentially. If a character cannot complete a proposed move with remaining movement, they must stop or move to a different reachable square."
            "Combining Movement: At GM's discretion, multiple effects allowing movement can be combined (total squares = sum of range bands × 3)."
        }
    }

    # ===========================
    # CONFLICT: ACTION TYPES
    # ===========================

    # Core Rulebook, Chapter 6: Scenes and Conflicts, "Action Types"
    # (pp. 252-253). Most actions have one or more types ascribed to
    # them or assigned by the GM. Common types are listed below.

    ^"Action Type" DEF {
        # Metatype anchor for conflict action type definitions

        ENUM ["Attack", "Movement", "Scheme", "Support"]
    }

    #TTI4pBnX6buLAo1ORQ8lvw ^"Attack Action" DEF {
        EXTENDS ^"Action Type"

        PROPERTIES {
            ^"Action Type Name" STRING "Attack" FIXED
            ^"Source Page" INTEGER 252
            ^"Description" STRING "Attack actions are actions that a character can use to inflict harm on another character. An Attack action usually specifies at least one target, who suffers any relevant effects."
            ^"Requirement" STRING "To affect another character with an Attack action, a character must generally have line of sight and an unobstructed path to that target."
        }
    }

    #mIJj8QYgYLcg6fxSHIzeMn ^"Movement Action" DEF {
        EXTENDS ^"Action Type"

        PROPERTIES {
            ^"Action Type Name" STRING "Movement" FIXED
            ^"Source Page" INTEGER 252
            ^"Description" STRING "Movement actions are actions that allow a character to reposition in their environment."
            ^"Requirement" STRING "To perform a Movement action, a character must usually have a path to the point they are trying to reach. Characters who can fly or scale sheer surfaces (via invocations or other supernatural abilities) are naturally more able to reach places earthbound characters cannot."
        }
    }

    #IZsfIQRVLozVRXG7nXCO4R ^"Scheme Action" DEF {
        EXTENDS ^"Action Type"

        PROPERTIES {
            ^"Action Type Name" STRING "Scheme" FIXED
            ^"Source Page" INTEGER 253
            ^"Description" STRING "Scheme actions allow a character to attempt to influence targets with whom they can communicate—manipulating them, wearing them down, or bringing them around to a different point of view. A Scheme action usually specifies at least one target who suffers any relevant effects."
            ^"Requirement" STRING "To affect another character with a Scheme action, a character must generally be able to communicate with that character, verbally or otherwise."
        }
    }

    #TJ87SnmxEGpkbkFpc0iZWR ^"Support Action" DEF {
        EXTENDS ^"Action Type"

        PROPERTIES {
            ^"Action Type Name" STRING "Support" FIXED
            ^"Source Page" INTEGER 253
            ^"Description" STRING "Support actions build up the character's position or help others, protecting them or aiding them to set up for their own actions."
            ^"Requirement" STRING "To affect another character with a Support action, a character must generally be able to communicate with that character, verbally or otherwise."
        }
    }

    # Note: Shadowlands Taint is not a standalone mechanic; it is a
    # type of disadvantage (adversity). It is defined in the traits
    # and disadvantages files, not here. The ^"Afflicted" condition
    # and ^"Defiled" terrain interact with it.
    GUIDANCE {
        ENTRY ^"equipment-and-wealth" #OcqIa8CQCE4m6KQimY8AE6 {
            CONCERNS [ ^"Item" ]
            TOPICS [ "equipment", "wealth" ]
            TEXT "Samurai must rely on more than merely their own wits and prowess to secure their lord's interests on the battlefields or in the courts. Countless arms, armor, and implements of war have been devised to suit any and every combat situation, while the courtier has an arsenal of their own to maintain, including clothing and jewelry, art and artist's tools, and other signifiers of status. More important than the tools themselves, however, are the hands that have wielded them—the most precious items aren't the most expensive to create, but rather the ones that have figured in the lives and legends of great samurai. When a character wishes to acquire an item, they can buy it, requisition it, or find another means to obtain it, at the GM's discretion. Every item has a rarity, which affects how difficult it is for a samurai to acquire the item through requisition (see below), as well as a price, which is the going market rate for such an item, if it can be purchased at all."
        }
        ENTRY ^"samurai-and-commerce" #8iMASgw8O6m8CoiQKaq8yy {
            CONCERNS [ ^"Item" ]
            TOPICS [ "equipment", "commerce" ]
            TEXT "In theory, Rokugani samurai should not often need to interact with currency. They are retainers to their lord, who should provide them with the things they need to serve to the best of their abilities. Some samurai—particularly traditionalists—see money as unclean, or at least uncouth, and generally beneath their station. In practice, however, currency is tremendously useful. Whether one is a daimyō attempting to wage a war or a low-ranking samurai tasked with an arduous journey to deliver a letter to a local ally, there are many occasions when having money makes life much easier. While a daimyō can call upon alliances and oaths to rally troops, levying soldiers goes far faster if one offers immediate compensation. While even the lowest samurai can order peasants in their lord’s lands to support them on their journeys and then to appeal to the local magistrates for compensation, said peasants will be much more helpful if they feel they are being treated fairly—and money goes a long way towards that. And, of course, criminals and mercenaries often refuse to deal in anything but a bag of koku and bu. While most samurai prefer not to personally engage in commerce, they generally aren’t forbidden from handling money or buying and selling items—it is simply seen as beneath their societal station."
        }
        ENTRY ^"acquiring-items" #waMaoKym8EIcy2ke0aMw4i {
            CONCERNS [ ^"Item" ]
            TOPICS [ "equipment", "commerce", "downtime" ]
            TEXT "As a downtime activity or during a narrative scene in which a character has access to a market, the character may make a Commerce (Water) check with a TN equal to the rarity of an item to find that item for sale. They can then purchase the item for its listed price, attempt to get the merchant to give them the item and seek restitution from their lord’s local representative, or otherwise try to acquire the item. The GM should feel free to adjust the TN of any check to acquire any particular item not common to a region based on the markets available. After all, it is easier to get rare items in a prosperous city like Ryokō Owari than in a minor village in the far-flung provinces. A few examples are as follows:"
        }
        ENTRY ^"items-from-your-lord" #gCOagmiW2S26CQEMCyUOue {
            CONCERNS [ ^"Item" ]
            TOPICS [ "equipment", "commerce" ]
            TEXT "Generally speaking, when a character’s lord gives them a task, the lord equips the character appropriately, as befits their station. When sending a bushi to war, a daimyō equips them with at least ashigaru armor, various weapons suited to their fighting style, and perhaps a Rokugani pony, depending on the field of battle. To do otherwise would be a death sentence, and would send a very clear message about the lord’s opinion of their underling. Similarly, when sending someone on a journey to court, to collect taxes, or to complete other work, any responsible lord outfits their servants with the equipment they will need to complete their task. Of course, sometimes a character might think of an item their lord has not provided to them. Broaching this subject is not easy, but it can be necessary to success. As a downtime activity or during a narrative scene in which the character has access to their lord (or a representative thereof), a character may make a Courtesy check to request the use of an item they need to perform their work. At the GM’s discretion, the character might have to make a check with a different skill (such as Culture, Government, or Tactics) to convince their lord of the importance of the matter instead. The TN of the check is equal to the rarity of the item minus the character’s glory rank (to a minimum of 1). If the character succeeds, their lord (or the lord’s representative) sees to getting the item for them. This process might take some time, however, as some items are not easily acquired, even by powerful samurai. As always, at the GM’s discretion, the TN of this check might be adjusted based on region, the likelihood of the item being available, the fear of scandals that might arise from the item’s acquisition, and other factors."
        }
        ENTRY ^"currency-of-rokugan" #Qcww2SmumwSuggcuegUySy {
            CONCERNS [ ^"Item" ]
            TOPICS [ "equipment", "currency" ]
            TEXT "When barter does not suffice, the currency Rokugan uses is a coinage known as koku, which theoretically represents the amount of rice needed to feed a peasant for a year (five bushels). However, each clan mints its own coins, whose value is dependent on the harvest that year. The end result is a booming but scandalous currency exchange market among city merchants, as well as regional and yearly variances in items' prices. Generally speaking, koku are gold coins minted in the form of a circle with a hole in the middle to be strung on ropes. One koku can be exchanged for five silver bu (short for ichibuban) coins. One bu can be exchanged for ten copper zeni pennies—meaning there are fifty zeni in a koku."
        }
        ENTRY ^"prices-and-game-mechanics" #EggGKk8YUMKM2WuAYE8Yoo {
            CONCERNS [ ^"Item" ]
            TOPICS [ "equipment", "currency", "game master" ]
            TEXT "For the purposes of the game mechanics, the prices listed in this chapter are the baseline or “average” prices for a given item. The group should determine whether they want to have prices fluctuate while traveling or when advancing the campaign’s timeline. In such cases, player characters’ starting koku is considered to have been minted by their home clan. But clearly, the banalities of currency exchange are below noble Great Clan samurai…excepting, perhaps, the Yasuki and Ide families."
        }
        ENTRY ^"tool-or-weapon" #2gEI26cygwqeig28Maa6SO {
            CONCERNS [ ^"Weapon" ]
            TOPICS [ "equipment", "weapons" ]
            TEXT "For the average Rokugani, the line between a tool and a weapon is murky; most will never need anything more lethal than a knife or a fishing spear, and while these can be dangerous, they were not forged for killing humans. Professional warriors outside the samurai class, such as militia members, guards, and ashigaru, know the value of their weapons, but many consider them without a great degree of sentiment. Weapons have a further degree of significance to samurai, however, as the symbol of their place in society, and some arms are considered nobler than others. While many bushi schools differ on specifics of preferred weapon, Akodo’s Leadership declares the six great weapons of the samurai to be the long sword, knife, short sword, great sword, spear, and bow."
        }
        ENTRY ^"weapons-overview" #qcEiQaKI8UQceio6QcqW8w {
            CONCERNS [ ^"Weapon" ]
            TOPICS [ "equipment", "weapons", "swords" ]
            TEXT "While the spear and the bow are perhaps used just as often by samurai in the field, the sword is the symbol of the Emerald Empire’s warrior caste. Most Rokugani weaponsmiths hold the sword to be the most sacred and honorable of weapons, and its creation is an intricate process—part art, part science, and part religious rite."
        }
        ENTRY ^"the-daisho" #eYI8k42ga20Waga0YaCEue {
            CONCERNS [ ^"Weapon" ]
            TOPICS [ "equipment", "weapons", "swords" ]
            TEXT "Though the katana and wakizashi are two of the most well known, swords take a variety of forms in the Emerald Empire. From the ancient chokutō, to the powerful nodachi, to highly specialized creations like the gao (hook sword), there is a blade for every fighting style."
        }
        ENTRY ^"wearing-the-katana" #Ka4iEQEKmAueSkaSuigUAi {
            CONCERNS [ ^"Weapon" ]
            TOPICS [ "equipment", "weapons", "status" ]
            TEXT "Only samurai are allowed to wear the katana, and further, only dedicated warriors commonly do so in Rokugan—most courtiers do not bother to keep their katana on their person at all times, their lighter and more convenient wakizashi proving their status as samurai. Thus, openly displaying the long sword tells the world at large that the wielder is a dangerous individual who knows their way around a swordfight. Such a sword is often passed down through generations within a family, and some gain their own fame and reputation outside of their owners'. When not being carried for ceremonial use or war, a katana traditionally is displayed in a place of honor within its owner's home."
        }
        ENTRY ^"a-legendary-blade" #8WoQyIo8GEWYC8y6c0YcOU {
            CONCERNS [ ^"Weapon" ]
            TOPICS [ "equipment", "weapons", "legendary" ]
            TEXT "The renowned Crane warrior Doji Kuwanan holds the resplendent blade Omeka, which bears the mark of Ashidaka Sora, who forged it three centuries ago as a gift to one of Kuwanan’s forebears. Doji Kuwanan added renown to the blade’s legend when he used it to defeat the pirate Umitaka in the defense of Cold Wind City, cleaving through his foe’s blade to deliver the deathblow. Omeka is a unique katana with the Durable and Resplendent qualities and Deadliness 10 (or 12 if used 2-handed). When Shattering Parry is used against it (see page 270), the parrying weapon gains the Destroyed condition."
        }
        ENTRY ^"the-kakita-swordsmiths" #waMUiuOAymw6skAuswCEAY {
            CONCERNS [ ^"Weapon" ]
            TOPICS [ "equipment", "weapons", "crane" ]
            TEXT "Since the days of old, the Kakita have been the most renowned swordsmiths of the Emerald Empire, and their finest blades are said to be physical manifestations of the ideal upon which other swords are based. Each Kakita blade possesses unique characteristics and a legacy that elevates it above other arms. A Kakita blade is a katana forged in an elaborate, secretive ritual, that results in a weapon that is lighter and more resilient than a standard blade—and far deadlier. The steel, mined in Crab lands and purified at great length in a crucible, takes on a pattern like freeflowing water. Each blade is forged in absolute silence, that it not be marred by a single word, and tested on a great stone at Kyūden Doji. Blades that fail to carve a chunk from the stone are said to be destroyed."
        }
        ENTRY ^"axes-overview" #gYOiCIQqeYaWqGg0umC6Kk {
            CONCERNS [ ^"Weapon" ]
            TOPICS [ "equipment", "weapons", "axes" ]
            TEXT "Rokugani warriors do not routinely use axes. Developed from farming implements, these weapons are menacing despite their origins as tools of agriculture, and can deliver vicious cuts and crushing blows."
        }
        ENTRY ^"creating-legendary-weapons" #UQIyOskwgIGS68AUq2Kwmk {
            CONCERNS [ ^"Weapon" ]
            TOPICS [ "equipment", "weapons", "game master" ]
            TEXT "GMs can create their own legendary weapons for their PCs. Remember, every weapon has a history and a legacy to which its wielder—including the PC—adds!"
        }
        ENTRY ^"blunt-weapons-overview" #E0WSeA4Cq0aqMWMOY8yQGw {
            CONCERNS [ ^"Weapon" ]
            TOPICS [ "equipment", "weapons", "blunt" ]
            TEXT "Clubs, hammers, and similar weapons all fall under the blunt weapons category. Blunt weapons are often extremely effective at smashing through heavy armor, crushing powerful monsters, and otherwise inflicting substantial damage on the battlefield."
        }
        ENTRY ^"polearms-overview" #2UwCuwiwMw0yE6mukwoW6o {
            CONCERNS [ ^"Weapon" ]
            TOPICS [ "equipment", "weapons", "polearms" ]
            TEXT "Polearms are a broad class of weapons that includes simple spears, sturdy staves, and a variety of other weapons. Polearms are excellent for keeping opponents at bay and striking from beyond reach."
        }
        ENTRY ^"war-fans-gunsen" #qUguy0umsqS4aKeYiyY0yg {
            CONCERNS [ ^"Weapon" ]
            TOPICS [ "equipment", "weapons" ]
            TEXT "Special war fans called gunsen are decorated with military symbols and used by battlefield commanders to signal troops and send messages."
        }
        ENTRY ^"crossbows-overview" #eMmMaeOIOIgGAa4som8GiU {
            CONCERNS [ ^"Weapon" ]
            TOPICS [ "equipment", "weapons", "crossbows" ]
            TEXT "Most samurai who are not members of the Crab Clan view crossbows with equal parts disdain and distrust. The disdain is due to a crossbow’s reliance on mechanical principles rather than their wielder’s skill and training to fire their projectiles, and distrust because the weapon’s proliferation would put a powerful weapon capable of killing samurai into the hands of rebels and malcontents. Crossbows are rarely seen outside the lands protected by the Crab, where they are sometimes temporarily issued to peasants levied to protect the Kaiu Wall."
        }
        ENTRY ^"armor-overview" #SYyKyegmSaAGOSYQWCmi8a {
            CONCERNS [ ^"Armor" ]
            TOPICS [ "equipment", "armor" ]
            TEXT "Armor varies widely in style and function, from utilitarian traveling clothes to ornate plated samurai armor. The look and construction of a set of clothes or suit of armor is dictated by many factors—its intended use, along with the wearer’s clan, social status, and taste."
        }
        ENTRY ^"textiles-in-rokugan" #8IYYkCMkUKOaYUQoEEKCeO {
            CONCERNS [ ^"Armor" ]
            TOPICS [ "equipment", "armor", "textiles" ]
            TEXT "Silk and linen are the most common textiles for Rokugani clothing, but cotton, satin, and more exotic imported fabrics are used to make clothing for wealthy and important individuals."
        }
        ENTRY ^"footwear-and-accessories" #sQ2EeYWCYq4IKgs84WCYA2 {
            CONCERNS [ ^"Armor" ]
            TOPICS [ "equipment", "armor" ]
            TEXT "People of the upper classes often wear sandals and tabi on the feet, while most peasants go barefoot. A wide range of styles of hats, gloves, cloaks, and other accessories are popular in various locales across the Empire."
        }
        ENTRY ^"armor-masks" #gMsw6wA0mYaIwCWm28oWAm {
            CONCERNS [ ^"Armor" ]
            TOPICS [ "equipment", "armor" ]
            TEXT "Plated armor frequently includes a detachable face mask often made to resemble a demon or other fantastic creature, giving its wearer an intimidating presence on the battlefield."
        }
        ENTRY ^"artifacts-and-treasures" #UIqO8Iwoo8MEE6wwMWS4ac {
            CONCERNS [ ^"Item" ]
            TOPICS [ "equipment", "artifacts" ]
            TEXT "Countless artifacts can be found in Rokugan, from ancestral arms and armor to mundane tools. This section explains the qualities common to many of these items."
        }
        ENTRY ^"ceremonial-items-as-tokens" #IU8KoS0UCWC2aIEiUslukk {
            CONCERNS [ ^"Item Quality" ]
            TOPICS [ "equipment", "ceremonial" ]
            TEXT "Ceremonial items often serve as identifying tokens; thus, making off with one would make impersonating someone much easier—though no upstanding samurai would dream of such deception."
        }
        ENTRY ^"obsidian-and-the-taint" #6Q8k8ycc8i6YEeYcoiKmus {
            CONCERNS [ ^"Item Quality" ]
            TOPICS [ "equipment", "obsidian", "shadowlands" ]
            TEXT "Obsidian did not always bear the corruption of Jigoku, but this mystical stone draws negative emotions and powers to it, absorbing and amplifying them. This includes the boundless hatred of Fu Leng and his countless dread servitors—so virtually all obsidian in the Emerald Empire now contains the essence of the Shadowlands."
        }
        ENTRY ^"personal-effects-intro" #qU4qAQo42II0iAwmWkKU08 {
            CONCERNS [ ^"Personal Effect" ]
            TOPICS [ "equipment", "personal effects" ]
            TEXT "These are used to play a variety of dice games throughout Rokugan. Gambling is extremely popular in the Emerald Empire, but it is largely frowned upon by samurai. Organized gambling is controlled largely by various criminal syndicates and is often a source of corruption among local officials."
        }
        ENTRY ^"omamori-blessings" #WECcwskWicuEaymYC0kmk2 {
            CONCERNS [ ^"Omamori" ]
            TOPICS [ "equipment", "omamori", "kami" ]
            TEXT "An omamori might contain one of the following blessings: Boon of Fukurokujin: Fukurokujin, Fortune of Wisdom, illuminates the truth even when tricksters seek to obscure it. Once per game session, the wearer may spend 1 Void point to remove a condition or persistent effect caused by a Scheme action. Boon of Bishamon: Bishamon promises glory at arms to the bold, and draws the eyes of the powerful to those who prove their strength. Once per game session, when the wearer receives a glory award, the wearer may spend 1 Void point to increase that award by 3. Boon of Benten: Benten watches over artists and lovers, guiding them in their endeavors. Once per game session, after rolling dice, the wearer may spend 1 Void point to add a kept (ring) set to an (op) result to an Artisan or Social check. The kami can be a bit jealous in their stewardship, however. While a character can theoretically wear multiple protective charms at once, they cannot benefit from any of these blessings while they are wearing more than one omamori."
        }
        ENTRY ^"poisoned-weapons" #KE0Oy6GWU8E8gGkas06YwO {
            CONCERNS [ ^"Poison (One Vial)" ]
            TOPICS [ "equipment", "poison" ]
            TEXT "Poisons can be applied to melee and missile weapons to make sure that even minor wounds cause injury—though obviously, poisons are the tool of shady assassins and figures of ill repute rather than upstanding samurai. Unsurprisingly (given its namesake), the Scorpion Clan favors such methods. As an action, a character may make a TN 1 Medicine (Earth) check to properly (and safely) apply a poison to a weapon. Only a single poison can be applied to a weapon at a time. The effects of a poison applied to a weapon persist until the weapon is used to perform a successful Attack action check."
        }
        ENTRY ^"poison-types" #8A0oMqCQEM6quiYMmMsuQq {
            CONCERNS [ ^"Poison (One Vial)" ]
            TOPICS [ "equipment", "poison" ]
            TEXT "Noxious Poison: A catchall term for a wide variety of deadly compounds (many of which have perfectly legitimate uses in medicine and other trades), these sorts of poisons often act by attacking the heart, organs, or brain directly. - When a character ingests noxious poison, the character suffers a critical strike with severity 10. The poisoner may spend 󰄀 on their check to deliver the poison to increase the severity by 1 per 󰄀 spent this way. - When noxious poison is applied to a weapon, increase that weapon’s deadliness by +4. Fire Biter: A poison that wracks victims with searing pain, fire biter is easily identified by its bitter taste, which makes it difficult to disguise its presence in food or drink. - When a character ingests fire biter, the character suffers 5 strife and the Dazed and Exhausted conditions. - When fire biter is applied to a weapon, after a target suffers a critical strike from the weapon, they suffer the Dazed and Exhausted conditions. Night Milk: A favorite of the Shosuro family, night milk is a dizzying concoction that must be injected or otherwise delivered directly into the bloodstream. - When night milk is introduced into a character’s bloodstream, the character suffers 5 fatigue and the Disoriented and Prone conditions. - When night milk is applied to a weapon, after a target suffers a critical strike from the weapon, they suffer the Disoriented and Prone conditions."
        }
        ENTRY ^"quiver-ammunition" #wIIkyk2WO6eaaKaSc6KA26 {
            CONCERNS [ ^"Quiver of Arrows" ]
            TOPICS [ "equipment", "ammunition" ]
            TEXT "As long as a character has a quiver of arrows available, they are assumed not to run out of standard ammunition. Further, the character is assumed to refill the quiver at reasonable opportunities, such as when visiting a guard outpost or a castle with an armory. If a character goes an especially long time without having a reasonable opportunity to refill their quiver, the GM may state that the quiver is running low, with only 3 standard pieces of ammunition remaining; the character then gains 1 Void point. The character still possesses any special arrows they had prior to this point. A depleted quiver can be refilled by visiting a location where the character can acquire ammunition, or by making ammunition using the Survival skill if the character has the proper supplies (see page 169)."
        }
        ENTRY ^"the-traveling-pack" #kEIAMEkuqeEUWMMMg8QKqG {
            CONCERNS [ ^"Personal Effect" ]
            TOPICS [ "equipment", "personal effects", "outfit" ]
            TEXT "When a character’s starting outfit refers to a traveling pack, it refers to an assortment of items carried within a furoshiki, or decorative wrapping cloth. Traveling packs consist of the following: Blanket, bowl, chopsticks, four days of travel rations, flint and tinder, and any three other items of the player’s choice that are rarity 4 or lower."
        }
        ENTRY ^"settlement-purchase-modifiers" #Yoamka4m4gCcs4qSskWMcc {
            CONCERNS [ ^"Item" ]
            TOPICS [ "equipment", "commerce", "game master" ]
            TEXT "Adjust the TN to acquire an item by the availability of the settlement: Impoverished mountain town: +3; Small farming village: +2; Village on a major road: +1; Average Rokugani city: +0; City on a large river: –1; Sizable port: –2; Major city: –3."
        }
    }
    GUIDANCE {
        ENTRY ^"conflict-and-the-samurai" #0Io0Qc8OqQOkOwKEAkG2IO {
            CONCERNS [ ^"Scene" ]
            TOPICS [ "scenes", "conflict" ]
            TEXT "When samurai rise for the day, they never know whether this sunrise may be their last. Weeks might pass in peace, allowing the individual to indulge in their own pursuits, or a single day may be fraught with confrontations in grand palaces or muddy battlefields. This chapter covers the rules to model the passage of time in the game, as well as how to frame scenes and adjudicate the conflicts that arise when duties and desires clash."
        }
        ENTRY ^"the-game-session" #oUcCI00KYs8U8Myq2gUc0C {
            CONCERNS [ ^"Scene" ]
            TOPICS [ "scenes", "conflict" ]
            TEXT "In the Legend of the Five Rings Roleplaying Game, a game session is a period of time during which the GM and players gather to venture into the imaginary realm of Rokugan to pursue stories of adventure, intrigue, and drama together. Each session can be broken down into one or more scenes, which are the anecdotes within the group’s shared story during which players have their characters explore the world, overcome obstacles, deepen their relationships with each other, or simply experience existence."
        }
        ENTRY ^"gm-decides-scene-boundaries" #UaWUM4K6AIs46I8cimssmM {
            CONCERNS [ ^"Scene" ]
            TOPICS [ "scenes", "conflict" ]
            TEXT "If you’re the GM, then it’s up to you to decide when one scene ends and a new one begins, based on both narrative-time and real-time considerations. Individual scenes should usually last from half an hour to three hours, though you can end a scene at any time you see fit or extend one as needed. Remember, PCs regain the use of certain abilities and remove strife and fatigue at the end of a scene. If a scene is resolved extremely quickly, you should feel free to say that it does not count as the end of a scene for the purposes of effects that trigger at the end of a scene (such as removal of strife and fatigue). If a scene transitions to another type of scene it generally does not count as ending. Similarly, some abilities can be used “once per game session,” and some effects apply “until the end of the game session.” Such abilities and effects are written assuming a session that lasts from two to four hours. As the GM, you might find yourself running much shorter or longer game sessions (assuming player attention and the supply of snacks hold out). If you do, you may want to consider refreshing such abilities more or less frequently. You should always feel free to use real-time hours to define a “game session,” as long as you communicate these divisions clearly to the players."
        }
        ENTRY ^"choosing-downtime-activities" #AYoWUgAGM0Weg2WOSGGW0S {
            CONCERNS [ ^"Downtime" ]
            TOPICS [ "downtime", "conflict" ]
            TEXT "Not all activities are suitable to all downtime scenes. For example, a downtime scene that consists of an hour or two before the player characters storm a castle to rescue a friend would accommodate one PC gathering necessary supplies for the break-in (a ladder, rope, and disguises) or another's efforts to gather local malcontents to assist in the effort. However, that same downtime scene would likely not be long enough for another PC's effort to forge a sword, as this is an extremely lengthy process. As in all matters, the GM is the final arbiter of whether an activity can reasonably be completed during a particular downtime scene."
        }
        ENTRY ^"when-a-conflict-is-warranted" #qia0csySeaM6us4QScqcYi {
            CONCERNS [ ^"Conflict Type" ]
            TOPICS [ "conflict", "conflict" ]
            TEXT "Not every dramatic interaction between characters calls for a full conflict. If a contest can be resolved with a brief interaction, then it should instead be resolved with a check and a check to resist (see page 26), or with a competitive check (see page 26)."
        }
        ENTRY ^"initiative-order" #awEAeQ8aeU6cM6cOGAg2Os {
            CONCERNS [ ^"Initiative" ]
            TOPICS [ "conflict", "conflict" ]
            TEXT "In most conflicts, the characters' order of action (called initiative) is important, and initiative is determined during this phase."
        }
        ENTRY ^"changing-initiative-mid-conflict" #KseuWUIeQMkc4aA6qgQaCc {
            CONCERNS [ ^"Initiative" ]
            TOPICS [ "conflict", "conflict" ]
            TEXT "If a character's initiative value changes during Phase 2: Take Turns, apply the change at the time specified (generally, \"at the end of the round\"). At the beginning of each round, adjust the initiative order to reflect any altered values."
        }
        ENTRY ^"spending-opportunity-on-initiative" #02WAKWw0CIMG0KEsqky2Qk {
            CONCERNS [ ^"Initiative" ]
            TOPICS [ "conflict", "conflict" ]
            TEXT "Characters can spend [Opportunity] on Initiative checks in the normal manner, and also in several special ways denoted in the table on page 328."
        }
        ENTRY ^"arriving-late-to-a-conflict" #g8QOQcUqmAC0uKgOeAyKA0 {
            CONCERNS [ ^"Initiative" ]
            TOPICS [ "conflict", "conflict" ]
            TEXT "If a character arrives late to a conflict, they do not act until the next round. At the beginning of the next round, the character makes an Initiative check as described below. Intrigue: As there is no fixed order in an intrigue, a character can join at any time. Upon their arrival, the character makes an Initiative check as normal. Duel: Arriving to a duel late simply results in the duel's starting after the appointed time (to the likely ire of the opponent who was forced to wait). Skirmish: Combatants joining a skirmish make a TN 2 Tactics check. Mass Battle: Any commanders arriving late make a TN 2 Command check."
        }
        ENTRY ^"speaking-during-actions" #QkICEa4O8io24kwo4SAWUC {
            CONCERNS [ ^"Action Type" ]
            TOPICS [ "conflict", "conflict" ]
            TEXT "Some actions allow a character to speak or otherwise communicate. When performing such actions, a character can say as much as the GM deems reasonable in that time. However, as a part of any action, a character may always convey up to five words (or six words, as long as the last word is “fool” or a similarly dismissive form of address)."
        }
        ENTRY ^"checks-within-actions" #AEiO6iKACM4i0gEug2Cws2 {
            CONCERNS [ ^"Action Type" ]
            TOPICS [ "conflict", "conflict" ]
            TEXT "In the language of the system, a check made as part of an action is described as a “[type] action check.” For example, the check to smite a wretched goblin with one’s katana would be described as “an Attack action check using the katana targeting the goblin.”"
        }
        ENTRY ^"measuring-distance-in-conflict" #qKYW2csOKgEAMqSsiUcsEm {
            CONCERNS [ ^"Range Band" ]
            TOPICS [ "conflict", "conflict" ]
            TEXT "In some types of conflicts (skirmishes, for example), distances between characters and objects are tracked. Many actions intended for use in these conflicts have a specified range at which they can be used (see Range Bands on page 265, for more details). However, characters can attempt to perform actions against people or objects that are outside of the specified range or are otherwise ineligible to be targeted. During Step 1: Declare Action, a character is allowed to choose a target upon whom they normally would not be able to act due to the target’s being out of range, a lack of visibility, or some other obstacle. Usually this is not prudent, but during Step 2: Make Check, some uses of [Opportunity] allow a character to extend the range of an action or otherwise overcome barriers. When resolving an effect, such as during Step 3: Resolve Effects, if the target is not in range or the character does not meet some other requirement of the action, the character cannot resolve that effect of the action. As the GM, you are also the arbiter of whether certain uses of [Opportunity] (particularly those that would bodily affect the target) can or cannot be resolved against targets who are not in range of the action’s effects."
        }
        ENTRY ^"intrigues-overview" #WUi6mg8Sac4OOYOuCCOo4I {
            CONCERNS [ ^"Intrigue" ]
            TOPICS [ "intrigue", "conflict" ]
            TEXT "Intrigues are social engagements, chances to persuade the opposition to adopt one's viewpoint, gather favor from superiors, sow the seeds of one's plots, or subtly besmirch the reputation of hated rivals. Intrigues are how the fortunes of clans rise and fall. The power and influence of all ruling families rest in no small part on the skill of the courtiers who excel in this arena. Intrigues follow the general pattern described in Conflict Scenes on page 249, with the following minor additions and alterations:"
        }
        ENTRY ^"provoking-your-enemies" #CcOMW0gAqwic4GAaYKSSso {
            CONCERNS [ ^"Intrigue" ]
            TOPICS [ "intrigue", "conflict" ]
            TEXT "Provoking one’s enemies directly is a dangerous art, but it can put them in positions where they must accept a loss lest their reputation suffer harm. Applying this pressure subtly, without exposing oneself to criticism, is no easy task. A character who chooses this objective should state their target at the outset."
        }
        ENTRY ^"when-to-use-intrigues" #wgGKKsQa02gaoUooCQ6G0a {
            CONCERNS [ ^"Intrigue" ]
            TOPICS [ "intrigue", "conflict" ]
            TEXT "Intrigues are most useful when a large number of characters are going to be participating in a social exchange, and managing that many active participants requires a greater degree of structure than a narrative scene accommodates. Examples include complex court scenes with multiple factions, large social events, and formal negotiations. For a conversation between only two participants, a full intrigue is often unnecessary, though the rules for persuading NPCs described in this section offer helpful guidelines for determining how much effort it usually takes to win someone to a cause."
        }
        ENTRY ^"declaring-intrigue-objectives" #cqAWaGISWek0yyKsis8ESs {
            CONCERNS [ ^"Intrigue" ]
            TOPICS [ "intrigue", "conflict" ]
            TEXT "Players are required to inform the GM of their characters’ objectives. This helps the GM set the scene and build a story around what the characters want to accomplish. However, players aren’t obligated to inform their fellow players of their objectives. Passing notes or communicating electronically can let players inform the GM of their goals without telling their compatriots, if secrecy is of the essence!"
        }
        ENTRY ^"rumors-in-court" #Q0o0IwMgQwuO4iC0isaaGq {
            CONCERNS [ ^"Intrigue" ]
            TOPICS [ "intrigue", "conflict" ]
            TEXT "Rumors are among the courtier's greatest weapons, and a well-placed rumor can lay the groundwork for future victories. Spies often place rumors in enemy courts as well, to lead foes astray or into cunningly laid traps. A character who chooses this objective should state the rumor they wish to spread at the outset."
        }
        ENTRY ^"speaking-in-character" #62ywiSY6I6gIiSA4Eaq4GW {
            CONCERNS [ ^"Intrigue" ]
            TOPICS [ "intrigue", "conflict" ]
            TEXT "Some groups often have players speak in their characters' voices, and use this to determine most social interactions. Other groups prefer to enable a character being more (or less) eloquent than their player, and have the player summarize the point they want their PC to make and the manner in which they want them to say it, with the roll determining how successfully this occurs. Some groups even use both methods, depending on the individual player. Use the method that makes you most comfortable and seems the most fun for your group!"
        }
        ENTRY ^"gm-adjusting-tn-and-awards" #q88oAoOEAsWGy88qyMgu0o {
            CONCERNS [ ^"Intrigue" ]
            TOPICS [ "intrigue", "conflict" ]
            TEXT "At their discretion, the GM can alter the TN of any check or award extra momentum points for especially cogent arguments or good roleplaying efforts."
        }
        ENTRY ^"how-duels-begin" #WE26E4IMkAOEM2smY2eGgi {
            CONCERNS [ ^"Duel" ]
            TOPICS [ "duel", "conflict" ]
            TEXT "Duels almost invariably result from one character challenging another, who accepts the challenge in the hope of humbling or even killing their foe (or who finds himself in a position where they cannot afford to refuse). Duels should be used for one-on-one martial contests. Keep in mind that duels are not likely to engage all of the players at once, and that you can use the Clash rules on page 263 to embed a duel in another scene so that all PCs can do something interesting at the same time."
        }
        ENTRY ^"lethal-and-nonlethal-duels" #CCG0iWqs0UK4cKIqOwcmAC {
            CONCERNS [ ^"Duel" ]
            TOPICS [ "duel", "conflict" ]
            TEXT "Killing one's foe is the goal of some duels and unacceptable in others, based on circumstances and prior agreements. Killing a foe in a duel to the first strike or incapacitation is a tragic accident at best and possible murder at worst. Killing one's foe in a duel to first blood is unusual and frowned upon, but not strictly dishonorable. Obviously, killing one's foe is the point of a duel to the death. Sparing one's foe can be seen as extremely disrespectful unless done very deftly."
        }
        ENTRY ^"clan-dueling-traditions" #KGAoOoyS64uACS2iwSccc2 {
            CONCERNS [ ^"Duel" ]
            TOPICS [ "duel", "conflict" ]
            TEXT "Different clans have different practices when it comes to dueling, but characters can define their own duels as long as they agree on the terms, which include: The Crane Clan reveres the iaijutsu duel as a high art, but warriors of the Crab Clan scoff at the notion of removing their armor for battle—and rarely allow lethal duels, for samurai are in short supply on the Kaiu Wall. The Unicorn Clan often wrestle or fight duels with bows. If the belligerent parties cannot agree to terms for the duel, it falls to the reigning lord (the individual with the highest status present, or the one on whose lands the duel is taking place, in the case of a tie) to decide the method of battle and stakes of victory."
        }
        ENTRY ^"optional-one-roll-dueling" #cKSCEkkgmAmAY20UUa2yE4 {
            CONCERNS [ ^"Duel" ]
            TOPICS [ "duel", "conflict" ]
            TEXT "The advantage of one-roll dueling is that it resolves very quickly. The downside is much the same: participants have a chance to set up and describe their action, but they have little tactical input afterward. From there on, the dice decide which characters live and which ones die. GMs should pick the best for their individual game, or even for a given duel, based on the sort of story they are telling and their group’s preferences."
        }
        ENTRY ^"withdrawing-from-a-skirmish" #QcqcssKEWWEWkuCaKCIgc0 {
            CONCERNS [ ^"Skirmish" ]
            TOPICS [ "skirmish", "conflict" ]
            TEXT "Withdrawing from a clash on the battlefield after one or more rounds is not viewed as dishonorable by most, as a warrior has answered the call and tested their resolve against the foe’s steel. However, canny fighters might be able to sting their opponent’s pride with words to keep the enemy in a clash they are losing, or to prevent them from accomplishing other important goals during the battle!"
        }
        ENTRY ^"carrying-capacity" #6mkqyyy6OY68Co4WsOQ6eA {
            CONCERNS [ ^"Range Band" ]
            TOPICS [ "range", "conflict" ]
            TEXT "At maximum, most creatures can carry a set of things with a sum silhouette value equal to their own silhouette. The GM should apply common sense when it comes to matters of carrying capacity. For example, an adult human (2) can pick up one child (1) and one large dog (1), or one other adult human (2), without exceptional effort, but they cannot carry a horse (3). Nor can they carry 30 cats (0), because this would defy common sense. Characters can sometimes make checks to temporarily exceed these limits, with TNs based on the examples on page 24."
        }
        ENTRY ^"tracking-position-without-a-grid" #moum8GUCIAeWWMKMg2OYs4 {
            CONCERNS [ ^"Range Band" ]
            TOPICS [ "range", "conflict" ]
            TEXT "Even without using a tactical grid, there are a few ways to track range bands as the GM. You can mentally track them, note them on scratch paper, or use figures, tokens, or other markers to track the distances between characters, objects, and terrain. By placing tokens closer together or farther from each other to indicate relative range, you can use them to give the players a clearer picture of the scene. Using this method, you and the players can usually “eyeball it,” remembering that a few inches on the table is range 2, while range 1 is touching the other token and range 0 is overlapping it. A slightly more precise method is to place a number of marker tokens between characters and objects indicating the distances between them. This can help the GM and players keep an especially consistent picture, particularly when there are numerous combatants."
        }
        ENTRY ^"terrain-in-battle" #WyaKSM2OcEkyQMaqi2uiqC {
            CONCERNS [ ^"Terrain" ]
            TOPICS [ "terrain", "conflict" ]
            TEXT "Battles are often decided by the ground on which they are fought; knowing when to attack and when to reposition for more favorable conditions is a key part of strategy. At the outset of a duel, skirmish, or mass battle, the GM should establish any relevant terrain features, which the characters can identify with checks or by spending [opportunity] from their Initiative checks (see page 250). Each terrain feature occupies a number of range bands around a particular position, as determined by the GM. A terrain feature can be as small as extending to range 0 (arm's length) in all directions from that point, or it can be much larger; it can even stretch unevenly in different directions. In addition to affecting characters in various scenes, terrain qualities affect the cohorts that occupy them in mass battles, as described on page 276."
        }
        ENTRY ^"combining-terrain-qualities" #CsA0yiIQmEcuWiCu6EWEeW {
            CONCERNS [ ^"Terrain" ]
            TOPICS [ "terrain", "conflict" ]
            TEXT "An area can have multiple terrain qualities. For instance, a burning building would likely possess both the Dangerous and Obscuring terrain qualities, while a thick forest would have the Entangling and Obscuring terrain qualities."
        }
        ENTRY ^"scenes-without-terrain-features" #s6gWaKSE2KKY6KeGAQYgIy {
            CONCERNS [ ^"Terrain" ]
            TOPICS [ "terrain", "conflict" ]
            TEXT "A meeting in an open field might have no terrain features, but such encounters tend to be less interesting than ones that take place in a more varied environment. Snowy forests, jagged cliffsides, and city rooftops under the waning light of the moon are all much more dramatic locales! Keep in mind, however, that combat in Legend of the Five Rings is meant to be narrative and quick—the presence or absence of terrain features is more important than their exact positions down to the inch. They should generally be positioned such that they can be exploited by PCs and NPCs alike, to create scenes with many opportunities for clever ambushes and turnabouts using the battlefield itself."
        }
        ENTRY ^"wounds-and-the-warrior" #Y8oWUMis4gggyY0mCS8mY2 {
            CONCERNS [ ^"Critical Strike" ]
            TOPICS [ "wounds", "conflict" ]
            TEXT "All samurai are members of a warrior caste, at least nominally, and the wise know well that war is a grave matter indeed. Killing is not something that most enjoy—and neither is dying—but both are realities of a warrior’s life. Battlefield leaders, yōjimbō, and other samurai who unsheathe their blades on a regular basis can expect to suffer some number of battle wounds, and they are likely familiar with all manner of injuries."
        }
        ENTRY ^"defending-into-fatigue" #IEsgG440SyGMcWcEY4WgmO {
            CONCERNS [ ^"Fatigue" ]
            TOPICS [ "wounds", "conflict" ]
            TEXT "A character can still defend if defending would cause their fatigue to exceed their endurance. However, having fatigue in excess of their endurance does render a character Incapacitated (see page 272), leaving them unable to defend against future damage!"
        }
        ENTRY ^"player-characters-are-exceptional" #yKmuMAgq4gssS84kqsoGWs {
            CONCERNS [ ^"Critical Strike" ]
            TOPICS [ "wounds", "conflict" ]
            TEXT "Player characters are not ordinary people. They are, after all, the main characters of the story the group has gathered to tell together. Often, death at a particular juncture is not the most interesting outcome for one of these characters. It is a classic trope for a samurai to survive defeat and bear the shame of that loss while seeking to restore their honor or find some other solace besides the Code of Bushidō. However, Legend of the Five Rings is also meant to evoke a setting where characters stand to lose their lives in the pursuit of their duties and passions. Thus, the rules presented in this chapter are calibrated to a particular balance of dramatic tension, story flow, and fun for everyone at the table."
        }
        ENTRY ^"the-sword-is-the-soul" #mUau4GsYqWwaAso4q4wSYU {
            CONCERNS [ ^"Critical Strike" ]
            TOPICS [ "wounds", "conflict" ]
            TEXT "The sword is said to be the soul of the samurai, and thus it is not some blunt instrument. Rokugani sword technique generally does not encourage blade-to-blade parrying, as a katana's razor edge is quickly degraded or even ruined by such techniques. While a skilled warrior uses the flat of their blade to ward off cuts, their primary defense is usually positioning and evasion. However, when the choice is between losing one's blade and losing one's life, a samurai might dramatically intercept a blow with a readied weapon, as described in the Shattering Parry sidebar on page 270."
        }
        ENTRY ^"resisting-a-critical-strike" #SaaKUIuSM4MOGYAAm2SSYS {
            CONCERNS [ ^"Critical Strike" ]
            TOPICS [ "wounds", "conflict" ]
            TEXT "Once per game session, after a player character rolls dice to resist a critical strike, they may parry the blow directly, putting the brunt of the impact on one of their readied weapons. They may reroll all of their dice for the check, and the weapon they used for the shattering parry gains the Damaged quality as its edge chips or cracks. At the GM's discretion, a character could instead use an unarmed profile this way, but this might cause them to lose the body part involved, receiving the appropriate scar type disadvantage."
        }
        ENTRY ^"gm-discretion-on-wounds" #CcgEoMIsI8mWSwgSiu4igU {
            CONCERNS [ ^"Critical Strike" ]
            TOPICS [ "wounds", "conflict" ]
            TEXT "At the GM’s discretion, if a character would otherwise be assigned a second instance of a disadvantage with the scar type due to recurring harm, the character is struck with a mortal blow. Instead of being assigned a new scar disadvantage, the character suffers the Dying (5 rounds) condition."
        }
        ENTRY ^"wound-conditions-and-defense" #smaSyWUym26kAwy86OIwIS {
            CONCERNS [ ^"Critical Strike" ]
            TOPICS [ "wounds", "conflict" ]
            TEXT "The Lightly Wounded and Severely Wounded conditions do not include specific descriptions or gory details of the harm the character has suffered for the purposes of expedience during battle, but that does not mean that the GM should not describe the harm the character has suffered or factor it into the narrative if it makes sense to do so (and isn't overly disturbing to anyone at the table). Below are a number of suggested parts of the body that might be nicked, sliced, smashed, or stabbed as part of the Lightly Wounded or Severely Wounded condition, together with their associated ring: Fire: Hand, arm, fingers, nose Air: Face, neck, ears Earth: Back, torso, thigh Water: Foot, leg, eyes Void: Head, skull, brain"
        }
        ENTRY ^"when-to-use-mass-battles" #YsUi64GcO2wQqG6O46kyuG {
            CONCERNS [ ^"Mass Battle" ]
            TOPICS [ "mass battle", "conflict" ]
            TEXT "The rules for mass battles are best for simulating large-scale conflicts in which the PCs play a major role. If a group of PCs is thrust into a larger battle that they can't influence strategically, the GM would likely be better served by using rules for a skirmish and narrating the chaos swirling around them. Similarly, if the PCs have a single, specific role to fulfill within a larger conflict, the GM might want to use the skirmish rules or shift from a mass battle to a skirmish as needed."
        }
        ENTRY ^"mass-battles-overview" #EuaqAoeMoysmaaiMga8Y8A {
            CONCERNS [ ^"Mass Battle" ]
            TOPICS [ "mass battle", "conflict" ]
            TEXT "Though they fulfill many societal functions, serving as everything from bureaucrats to courtiers to guards, samurai stem from lineages of martial distinction, and their most fundamental duty centers on the battlefield. As such, any samurai might occasionally be called by their lord to serve in battle—though some jump at the task more readily than others. If the situation grows dire enough, even a samurai unready for command might be tasked with leading an army, and the PCs are no exception. Even when samurai are not in command of a unit, ashigaru and other troops look to them for leadership."
        }
        ENTRY ^"how-battles-end" #ys4a0e44Y0SiWm8U24Wew2 {
            CONCERNS [ ^"Mass Battle" ]
            TOPICS [ "mass battle", "conflict" ]
            TEXT "Few battles end in an absolute rout. Most battles are won when one side accomplishes the goals it came to achieve via the completion of strategic objectives by leaders. There is considerable renown to be gained in being the one to carry out the commander’s orders, and in some armies, battlefield leaders compete against one another as fervently as they do against the enemy."
        }
        ENTRY ^"abstract-battlefields" #mAS0emgaaUucIwCcueIO6c {
            CONCERNS [ ^"Mass Battle" ]
            TOPICS [ "mass battle", "conflict" ]
            TEXT "Battlefields are handled abstractly in the rules for mass battles. Ranges are not tracked concretely, and a cohort is expected to be able to reach any location on the battlefield to perform its action there in the span of a round. This does not mean that terrain, including fortresses and other structures, has no role to play in the battle. These features should be something that the PCs can use against their foes—and vice versa! At the outset of a battle, the GM should define several terrain features relevant to the combat to the PCs, describing their relative locations and distances to help set the scene."
        }
    }
    GUIDANCE {
        ENTRY ^"game-mastering-rokugan" #MY4KQimSIe2o8KcaAecgyC {
            CONCERNS [ ^"GM Role" ]
            TOPICS [ "gm", "setting" ]
            TEXT "Rokugan is a world of choice and consequence. The players make decisions on behalf of their characters, choosing between desire and duty, honor and loyalty, and power and justice. Yet, the world will not react by itself. One player, called the game master (GM), brings the world to life for the rest of players by describing the environments of Rokugan and representing the people who live there. The GM is the one who devises the scenarios in which the samurai characters’ adherence to the Code of Bushidō is tested, and the players and GMs co-author the tales of those characters’ victory or defeat, pride or shame, glory or disgrace, survival or death. Beyond this creative role as storyteller, the GM is responsible for running the game and adjudicating the rules of the system. Finally, the GM is the group leader and helps to organize the group and mediate conflicts between the players."
        }
        ENTRY ^"running-a-game-session" #kOQW8QieaUMWSY6GWgSUE6 {
            CONCERNS [ ^"GM Role" ]
            TOPICS [ "gm", "sessions" ]
            TEXT "The first part of this chapter focuses on the basics of being a game master for Legend of the Five Rings. It addresses matters such as the role of the GM, how to organize and manage a group of players, how to evoke the setting, and how to set up story scenarios. The rest of this chapter introduces GMs to their role and provides them with the tools they need to run a smooth, fun, and exciting game, along with extra options such as alternate campaign styles. Many roleplaying games rest on the general conceit that “what the game master says goes,” and Legend of the Five Rings is no exception. This is mostly for expe-dience: the story will flow better if the players general-ly accept the facts that the GM is establishing. If they don’t, the game tends to bog down in arguments. The roleplaying game social contract thus revolves around the idea that the players give the game master the benefit of the doubt on most matters of setting the scene and story. This isn’t to say that there can never be any discussion, but if the GM shoots down an idea or wants to stick to a point, the players should accept it and move on. In turn, the GM should give the play-ers’ ideas fair consideration, and only disallow those ideas if they create implausible situations or disrupt the GM’s plans. That said, cool, exciting, or dramatic ideas should be encouraged, as long as everyone gets their turn in the spotlight. Remember, everyone (including the GM) is there to have fun. If someone isn’t comfortable with something going on in the story, that’s another matter entirely. Players should tell the GM if something in the story is mak-ing them uncomfortable, and vice versa. It is a good idea to establish a set of signals beforehand to clear-ly indicate when such concerns arise. Many excellent resources about establishing and respecting boundar-ies in one’s roleplaying games can be found in a list of reading materials at www.FantasyFlightGames.com. Roleplaying games are a group activity, with one GM and one to six additional players. The GM is typically the person who invites players to the game and determines when the group has hit its size limit. If you are the GM and you don’t know any other L5R RPG players near-by, you can reach out to the greater roleplaying game community in your area or online. Hobby stores, social media groups, and online play communities are all ave-nues for recruiting players. You can even teach yourself and your non-gamer friends how to play RPGs by pur-chasing the Legend of the Five Rings Beginner Game, which introduces the concepts and mechanics of role-playing games through a short adventure, and comes with a set of the custom dice needed to play the game. As noted, the first step is to invite a group of players to the game. For new GMs, a range of two to five players is a recommended range—though if you’re comfortable with it, you can always run a game for more (or few-er) players. Once you have your group, you’ll need to decide where, when, and how frequently you want to play. One player might decide to host the game at their house or apartment in the evening, or perhaps the group could make use of open gaming space at a local hobby store. Another option is to play without meeting in person on a dedicated virtual tabletop platform (VTT), in a text or voice channel, or via web forums. After the group has been formed, the next step is to create the player characters. Usually this is done togeth-er as a group as part of the first meeting. This lets players collaborate on their character concepts and backstories, and it helps them avoid duplicating or neglecting cer-tain roles in the game. At this stage, you should ask the group about the structure of the campaign they enjoy, the sorts of challenges they want to face, and how com-fortable they are with coming into conflict with other players’ characters. This helps you weave the story and make the best use of the tools throughout this chapter. A game session is a chunk of time dedicated to playing a roleplaying game, and as the GM, you have a great deal of influence over what the players do with this time. While they likely have their own ideas about what they want to do, you are their window to the world of Rokugan, so the things you choose to present to them help to direct their activities. Once people begin arriving, players usually want to spend some time chatting, catching up on each oth-er’s lives, and socializing. Between this and the time it takes for everyone to settle in, GMs should plan on a thirty-minute buffer between the time they ask people to arrive and when they begin play. Once everyone is ready, the GM can politely draw their friends’ attention away from socializing and to the game at hand. This cue also heralds the next part of the session, which is the recap. The GM catches players up to speed on what happened the last time they played, reminding them of unfinished business or unanswered questions. Alternatively, the GM can engage the group by asking players to recap what they remember. This also gives the GM a chance to see what the players are focusing on; if they emphasize interactions with a particular NPC, for example, the GM can give that NPC a more promi-nent role in future sessions. If the GM likes, they can wrap up the recap with a dramatic question about the players’ intentions. “Will your characters be quick enough to save the daimyō?” or “Have you discovered enough to know the magis-trate’s real intentions?” can raise the tension and help the group dive back into the adventure. This cue also heralds the next part of the session, which is the recap. The GM catches players up to speed on what happened the last time they played, reminding them of unfinished business or unanswered questions. Alternatively, the GM can engage the group by asking players to recap what they remember. This also gives the GM a chance to see what the players are focusing on; if they emphasize interactions with a particular NPC, for example, the GM can give that NPC a more prominent role in future sessions. If the GM likes, they can wrap up the recap with a dramatic question about the players’ intentions. “Will your characters be quick enough to save the daimyō?” or “Have you discovered enough to know the magistrate’s real intentions?” can raise the tension and help the group dive back into the adventure. A scene is, at its core, a period of conflict at a par-ticular time and place. The GM describes the setting where the scene transpires, serving as the characters’ eyes, ears, and other senses. The GM also takes on the role of any NPCs included in the scene, narrating their actions and speaking their dialogue (which usually entails making up lines on the fly!). Besides the basics like “who,” “what,” “when,” where,” and “why,” three key ingredients are needed to create the conflict in a scene: a goal or a desire, one or more obstacles to the goal, and stakes for success or failure. Without a concrete goal, players may flail or drift. Without real obstacles, there is no conflict—meaning no dramatic tension—and the players may become bored. Without stakes for success or failure, both the goal and the obstacle have no meaning. The GM’s job is to zero in on scenes with all three ingredients and use the various rules of the game to adjudicate whether the characters overcome their obstacles. This, fundamentally, is what pacing is about: slowing down and zooming in on the action—that is to say, on the conflicts—and speeding up or summarizing moments in game-world time when there isn’t anything dramatic happening. For an intense moment of inner conflict, however, it makes sense to play through the moment as if it were happening in real time. There is one major exception to this in the Legend of the Five Rings Roleplaying Game, which is the “slice of life” or characterization scene. These scenes could include conversations between PCs and NPCs, cultural events, or simple moments of experiencing some part of existence like a morning routine or a yearly festival. Though these scenes seem mundane, they can serve to build the world, characterize its inhabitants, and empha-size unique elements of Rokugani culture that may be novel or interesting to your players. These scenes also help your players get immersed in the setting. After all, playing a character who is a part of the imaginary world around them, rather than a spectator, is what roleplaying games are all about. How do you decide when to end a session? Sometimes a good stopping point is when a major question just got answered or a challenge was overcome, so the players can leave on a note of satisfaction. At other times, it’s important to stop because the next scene is likely to be complicated, and it will be best if everyone is fresh to play through it together another day. It can also be fun to leave off on a cliffhanger (such as when the play-ers are about to do battle or discover the identity of a dreaded foe). This leaves players looking forward to the next session. Be sure to award experience points (see page 299) and answer questions that arose during play. To reinforce the idea of choice and consequence, it’s very helpful to write down key events and the decisions that the PCs made as each session winds down. This way, the GM can incorporate natural ramifications to the PCs’ actions into the story, which further helps reinforce player immersion in the setting. The Campaign Sheet (found at www.FantasyFlightGames.com) provides spac-es for recording key information about each PC. In addition to running the campaign itself, a GM is usually the group’s leader and helps resolve disputes between players about the game. People play role-playing games in order to have fun and relax, but it can be difficult to achieve that when certain players’ fun comes at the expense of other players, or when personalities and expectations between players clash. Rokugan is a world with as many complexities as our own, so mature topics and themes may arise during play. Its society comes with inherent injustices, including the caste system, Rokugan’s repressive Code of Bushidō, the use of torture, and xenophobia. It’s up to the group to determine what social issues and levels of violence or sexuality they’re comfortable featuring as part of the story. Groups should change whatever makes them uncomfortable, whether that means modifying the set-ting or avoiding some topics. Once these expectations have been discussed, it’s everybody’s responsibility to ensure that these expectations are upheld and everyone in the group feels comfortable and welcome."
        }
        ENTRY ^"managing-your-group" #8AmimAYS2SamIIW2yMeww4 {
            CONCERNS [ ^"GM Role" ]
            TOPICS [ "gm", "group" ]
            TEXT "The beginning of a new campaign is a good time for the GM to offer some background context: “The border dispute between the Lion and the Crane has been ramping up since the death of Akodo Arasou,” or “The creatures of the Shadowlands have been abnormally quiet this month...” It is best if these help foreshadow the conflict you’re about to introduce, and raise new questions in the players’ minds. Once a week or once every other week is the standard rate of play, which gives you time to prepare adventures between sessions, as well as giving your group some flexibility to reschedule a session if other events conflict with it. For a player brand new to the game system, it can be useful to let them play a character starting out of the gate to get a feel for the rules, and then catch them up in terms of experience points after a session or two. In such cases, the GM should adjust the TNs for their checks to help them succeed with the same frequency as the rest of the group. While ideally, everyone should be interested in the ongoing story, sometimes players tune out from events or start distracting side conversations. A certain amount of this is to be expected, but if a player constantly disrupts the game, the GM may need to do something about it. The GM should consider taking some time outside the game to speak to that player privately. Not only can the GM let the player know that their disruptions may be spoiling the game for others, they can also take the time to ask the player what the GM can do to make the game more engaging and interesting for them. Clear and honest communication where both sides can be heard resolves most disruptions, and doing so privately makes sure the player doesn't feel shamed in front of the rest of the group. Often, players need to skip a session, and groups should agree on what to do when this happens. One option is that the GM or another player can take temporary control of the character as an NPC. Another is the characters can be absent from adventures while they deal with some task off-screen. Sometimes, a player has to drop out of the group or a new player asks to join. If the group has advance notice, the GM can make plans to have a last session focus on resolving some or all of their character's story. If life causes this to happen without warning, however, the GM may need to come up with a reason for the character's absence that makes sense to the ongoing events. Some groups might be comfortable with a different player picking up the retired character, depending on the needs of the story and their openness to changes in depiction. New players should be able to begin the game with a character who has the same experience points as the rest of the characters in the group. This also applies when players make characters to replace ones who have died or retired during their adventures. Finally, there is often a gap between what a character in the setting knows and what a player of the game knows, since the player is often able to witness scenes their character isn’t included in. Players might even be able to predict the story in ways their characters could not—after all, to the characters, the roleplaying game is not a story that follows certain narrative conventions! Using one’s knowledge as a player to drive a character’s decisions is known as “metagaming,” and it has negative connotations in some groups. If overused, it can break other players’ immersion in the world, which can be frustrating. On the other hand, a player might use their knowledge of the story to nudge their characters in a certain direction and create more tense and interesting situations. A player might even let their PC fall into a bad situation that the player foresaw because it’s fun to see the PC try to get out of it! This is “metagaming” being used to facilitate storytelling. It’s up to the group to determine what their stance on metagaming is, and whether they want a stricter separation of player and character knowledge, or if it’s more fun to blur the line for dramatic effect. By openly communicating about expectations on appropriate uses of metagaming, GMs and players can avoid hurt feelings due to confusion or perceptions of disrespect. As with other disruptions, a clear (and potentially private) conversation can often resolve issues to everyone’s satisfaction. However, if a player has expectations that are truly incompatible with those of the rest of the group, a GM might need ask that player to find another gaming group that better fits their playstyle. Different players come to the Legend of the Five Rings RPG for different reasons. Perhaps they have heard of or played the associated card games. Some may be drawn due to their love for samurai fiction and cinema, such as the Akira Kurosawa films and the books by Eiji Yoshikawa and James Clavell. Many L5R fans began as students of Japanese history or culture, as fans of anime and manga, or both. Others are general fans of science fiction and fantasy, from romantic stories with political intrigues to epic tales of good and evil or shades of moral gray. Often, the source material that the GM is most familiar with will color the types of stories and tone of the game, and that's absolutely normal (and encouraged—run what you love!). Besides differences in dramatic taste, different groups will play the game differently. You may find yourself absorbed in the narrative and the relationships between characters. Other groups focus on fine-tuning their characters' abilities and exploring the tactical side of combat. This game is designed to support numerous styles of play and, as GM, you are empowered to jettison, rework, or simplify rules as you desire. Throughout this chapter, there are several margin notes addressing how to tailor your game to a particular archetype of group (though you'll need to find the right balance for your own unique group of players). fun to see the PC try to get out of it! This is “metagaming” being used to facilitate storytelling. It’s up to the group to determine what their stance on metagaming is, and whether they want a stricter separation of player and character knowledge, or if it’s more fun to blur the line for dramatic effect. By openly communicating about expectations on appropriate uses of metagaming, GMs and players can avoid hurt feelings due to confusion or perceptions of disrespect. As with other disruptions, a clear (and potentially private) conversation can often resolve issues to everyone’s satisfaction. However, if a player has expectations that are truly incompatible with those of the rest of the group, a GM might need ask that player to find another gaming group that better fits their playstyle."
        }
        ENTRY ^"portraying-rokugan" #WsKsOC40OQMc8G42i8uGsA {
            CONCERNS [ ^"GM Role" ]
            TOPICS [ "gm", "setting", "npcs" ]
            TEXT "The Legend of the Five Rings RPG is different compared to many other roleplaying games, not only for its unique setting elements inspired by real East Asian cultures, but also because of its thematic focus on personal drama, court intrigue, and folkloric magic and mythology. The following considerations can help GMs bring the emerald lands of Rokugan to life and showcase the unique elements of the game and setting. From bamboo forests to sheer cliffs, the geography of Rokugan is as beautiful as it can be dangerous. Arguably, the landscape inspired an entire religion with a focus on honoring nature, and a typical Rokugani samurai will also see wonder in the natural world around them. When describing the characters’ surroundings, keep in mind all six of their senses: what they see, hear, smell, taste, feel, and sense on a spiritual level. You can tailor your description to a particular character based on their advantages and disadvantages: a samurai with a passion for sake will notice sake carts and houses first, while a samurai with an anxiety about dogs will perceive canines to be more vicious and aggressive. Another tip is to add what could be called “texture” to your descriptions by using a few pointed specifics instead of generalities: compare the mental picture you get and emotions you feel when you think of a “forest in a valley” compared with “a rocky hillside covered in gnarled black pines, their branches all twisted to point toward the mountain’s peak.” One way to come up with pieces of texture is to look in books and online for photography depicting East Asian landscapes and art and record interesting details from those pictures. Take the time to research the flora and fauna endemic to the region, and learn their names and what they look like. Better yet, experience as much of East Asian culture as you can personally. This can be accomplished in ways far less expensive than traveling in those countries, such as by visiting museum exhibitions and attending cultural festivals and presentations held at libraries and universities or in cities and towns with East Asian communities. You may be surprised to discover a cherry blossom festival in your area, or visiting speakers, musicians, and artists. Many of the same principles used for describing locations can be applied to non-player characters as well, including giving texture to their appearance and mannerisms. What is their style of dress, hair, and facial hair? What colors, fabrics, accessories, and perfumes do they wear? Do they maintain perfect posture, do they slouch, or do they have a limp or a nervous tick? Where can they usually be found, and what do their surroundings say about their personality? What player character personality traits might cause PCs to scrutinize qualities of an NPC or see them in a more favorable light? When planning an adventure, you should be sure to include a variety of conflicts and challenges to evoke alternating emotions. If a story is all excitement and hope, the audience can begin to feel exhausted. If a story is all despair and fear, the audience may feel drained. Most stories switch back and forth between showing the protagonists’ successes and failures, to build toward even more powerful emotional moments. By including a variety of conflicts and challenges, the GM also ensures that all the characters get to contribute and share in the limelight, which keeps them engaged. NPCs have another dimension to consider, which is their dialogue. GMs can always narrate an NPC’s words, but many find it extremely rewarding to speak as though they were that character. Some of the most basic ways to vary a character’s voice are to give them different emotions or levels of energy. A GM who feels comfortable portraying accents might give peasants and sailors a more freewheeling style of pronunciation, but players should steer clear of accents that invoke stereotypes or caricatures of East Asian cultures. Beyond varying the pitch, tone, and speed of NPCs’ speech, GMs can do a lot to differentiate characters with diction, word choice, and poetic flourishes. A literary and refined character will use more polysyllabic words and complex sentence structure. For groups that speak English for their games, the GM might use words with Latin and Greek roots to characterize nobility, reserving shorter and simpler words of Anglo-Saxon origin for more practical characters. Samurai besides those of the Crab Clan are much more apt to speak in simile and metaphor, use personification, or make allusions to nature. A wealth of East Asian poetry is available in translation online and in libraries, which can inspire and delight GMs who are interested in the aesthetics and ethos of these cultures and historical periods. Adhering to the tenets of Bushidō can sometimes be even more limiting than a character’s capabilities. It doesn’t matter whether the character can sneak into and out of the shed—it matters whether they believe such an action is compatible with Righteousness and Honor. The GM should keep the tenets of Bushidō at the forefront of the players’ minds by choosing a particular tenet to feature or test as part of a hurdle at least once per session. When creating the obstacles for a story, look at the lists of possible breaches and sacrifices in the The Tenets of Bushidō, on page 301, to see if any of those actions might be possible avenues for overcoming or bypassing obstacles. Rokugan’s rigid social structure is another limiting factor on the characters’ actions. The characters are usually subordinates to one or more non-player characters, to whom they are expected to show proper deference and respect. Even when characters are placed in a position of authority, they are expected to serve as role models for their own subordinates and follow certain customs to reinforce the status differentials between parties. These cultural elements represent a significant departure from the emphasis on forthright and individualistic expression found across many contemporary real-world industrialized countries, with their reduced emphasis on class divisions and increasingly informal modes of address compared to those of ancient times. If players are interested in exploring these facets of Rokugani culture as opposed to glossing over them, the protocols and honorifics of this social dance can become additional levers for the GM to use in awarding honor and glory, or in forcing players to stake honor and glory to momentarily ignore social custom. More specifics about status and hierarchy may be found in further supplements detailing the world of Rokugan. For some groups, playing the game is secondary to exploring their characters’ motivations and fates, and the thrill of “what happens next?” trumps the thrill of using particular combinations of techniques to defeat enemies. If your group falls into this category, you might consider one or more of the following: Techniques are reduced to purely narrative effects. Combat-related conflicts are mediated with a single roll, such as using the rules in One-Roll Duels (see page 261). Intrigues are handled purely as roleplay, with the GM determining who prevails based only on what players say (or describe their characters to be saying)."
        }
        ENTRY ^"spirits-and-the-supernatural-in-play" #mSOSMUE0qIIIKI0YsCmii2 {
            CONCERNS [ ^"GM Role" ]
            TOPICS [ "gm", "spirits" ]
            TEXT "Excepting those from Tengoku and Jigoku, spirits don’t operate on a continuum of good and evil. They act according to their nature, which is governed by its own, inscrutable rules. These creatures have no consideration for the welfare or desires of the samurai they encounter. The exception to this is ancestor spirits, who are intrinsically invested in seeing their descendants succeed and act in ways that reflect well on their ancestors. Thus, you should strive to make an otherworldly being’s motives mysterious, as well as use doublespeak, riddles, or illusions to trick your PCs. The very same spirits who help the PCs on a lark may turn on the party for their own amusement later. Adding supernatural elements to investigations or exploratory scenes can be especially effective at making the characters approach obstacles with fresh eyes and a sense of wonder—and usually, by the end, a new wariness about dealing with spirits and monsters. That monsters, spirits, and gods walk beside mortals in Rokugan is a tremendous consideration when portraying the world of Legend of the Five Rings. These beings are based on the folklore and mythology of real-world cultures and religions, and while that means that GMs can lean on these tales and legends to provide inspiration for their stories and game, it’s also important to avoid trivializing or being disrespectful of the source material. This can be done by researching and developing the spirits and monsters with the same level of care lavished on locations and non-player characters, as well as by portraying them as beings of power who are not to be taken lightly or ignored by the players. Such beings might be found anywhere, but they are typically informed by the nature of their surroundings. Creatures and beings dwelling in water tend to take on aquatic or amphibious traits, while mountain spirits have more rugged and stark personalities and appearances. In Rokugan, benevolent spirits are generally beings of beauty, cleanliness, and radiance, while evil spirits embody their corruption through ugliness, filth, and darkness. Ancestor spirits retain the appearance they had in life, while lost souls may appear as flickering lights and ghostly apparitions. Many spirits have the power to shapeshift or cloak their true appearance in order to move among mortals without being detected, so one never truly knows if one is unwittingly speaking to a god or a fox-wife. Using the supernatural in Rokugan is a way to challenge the players’ way of thinking and methodology. Supernatural phenomena tend to place constraints on the senses that mortals rely on most, since spirits cannot typically be seen, touched, heard, or felt, except by shugenja and those with the sixth sense. Supernatural beings also place constraints on player logic, because these spirits and creatures may well violate laws of nature and physics through their actions. Finally, the supernatural impedes players’ ability to problem solve, as there are limited options for dealing with the metaphysical, and PC groups may need to rely on experts or to complete research in order to understand, placate, or withstand supernatural beings and effects."
        }
        ENTRY ^"running-rokugan-and-lethality" #EA4W0e0ASO66YYY0AQY2Gm {
            CONCERNS [ ^"GM Role" ]
            TOPICS [ "gm", "lethality" ]
            TEXT "If we were to offer GMs only one piece of advice for running Rokugan, it would come down to this: remember that Rokugan is a world of choice and consequence. The ninjō, giri, honor, glory, and status systems all exist to force characters to make choices and to track how those characters evolve over the course of a campaign. Players should have agency to make real decisions on behalf of their characters—that is to say, to choose the way their character wants to confront or resolve a situation—and their characters should experience the fallout of those choices, both personally and in the world around them, based on what is at stake (see Raising the Stakes, on page 292). The GM should strive to create choice points in their campaigns by pitting two desires against one another (see also Devising Goals later in this section). This typically takes the form of the conflict between a character’s ninjō and giri, but it may also be a matter of a character’s needing to choose whether to stake honor or glory to accomplish a particular task. Other choice points stem from deciding which problem to tackle first, which possible solution to pursue, or who benefits or loses from the resolution of the problem. When designing these choice points, the GM should plan for the immediate or short-term ramifications as part of the prep, but long-term consequences can be thought out during the preparation stage between sessions. Often, choices will come up organically during play without the GM’s having devised them first, so the GM will need to use their best judgment to determine what short-term ramifications make sense given the circumstances, building off of what was previously established instead of introducing completely new concepts. Honor and glory rewards (see pages 300 and 304) should also be taken into account in the resolution of choice points. Providing choices between right and wrong, or good and evil, promotes a more heroic narrative and epic scale. Campaigns in which bad choices are pitted against worse choices foster a darker and grittier feel. The default mode for the Legend of the Five Rings setting exists in a middle ground, one in which players are offered different choices whose outcomes may not always be what they seem. None of these modes is particularly better or worse than any other, but each leads the player characters down a vastly different path. If your group wants an extremely lethal experience for their PCs, you could apply one or more of the following to make the game substantially more likely to result in death and dismemberment: Increase the Deadliness of all weapons by +4. If a character has the Bleeding condition at the end of the scene, they perish unless they spend a Void point. The Lightly Wounded and Severely Wounded condition can fester. Each time a character fails a Fitness check to remove this condition, the conditions worsen (from Lightly Wounded to Severely Wounded, or Severely Wounded to dead)."
        }
        ENTRY ^"scene-goals" #cwQekEq40WOCIOA4AQEi8E {
            CONCERNS [ ^"Scene" ]
            TOPICS [ "gm", "scenes", "goals" ]
            TEXT "Earlier, we discussed how scenes require three ingredients to be worth slowing down and running in real time: goals, obstacles, and stakes. On a small scale, these three things form an encounter or scene in the story, one of many in a given roleplaying game session. String together a series of scenes with multiple goals and obstacles, with evolving stakes, and you have the nuts and bolts of an adventure—in writing terms, a narrative arc, or scenario. However, roleplaying games differ from novels or movies, because the “audience” (the players) get a say regarding which goals their characters want to pursue, how their characters try to overcome those hurdles, and whether their characters can affect the stakes! The goal, or motivating desire, is the most basic element of narrative. In forms of media as ancient as medieval poetry and as modern as video games, goals are often framed as quests. In roleplaying games, goals might also be called quests, but in Rokugan, they are more often framed as aims. These aims are necessary because if a character doesn’t want anything—or doesn’t want to accomplish anything—then the events of the story simply happen to them. If a character moves through a story unaffected emotionally, they are static, and do not really change, for good or for ill. Given that goals are so important, how does the GM come up with goals for the characters to pursue in the game? In the L5R RPG, two goals are built into every character at character creation: their personal goal, or ninjō, as well as their duty to their lord, or giri. Ninjō is fairly straightforward: the character wants this thing, and they will be pursuing it during the campaign, sometimes even through pivotal scenes. Giri should also contain an actionable goal, and GMs can create adventures by creating obstacles that make those goals harder to achieve. Sometimes these obstacles may even be a lord acting against their own best interests, forcing a character to decide whether to disobey their lord to better serve them! Although these goals don’t have to be mutually exclusive, some conflict between ninjō and giri can make for great roleplaying inspiration. Choosing between one’s desires and one’s duty can make for a thrilling story. Tactically minded players tend to prioritize understanding and exploiting the rules of the game. They might not be as invested in the backstories of their own characters, much less those of non-player characters, and may see combat as its own end, because it's a chance to test out a cool combination of techniques and abilities. If your group has some of these traits, consider the following alterations to the rules: Encourage roleplaying, but make mechanics a major focus during conflicts like intrigues. Make all rolls open, and tell the players the TN of all checks they make. Instead of just describing their narrative effects, fully explain NPC abilities in mechanical terms, so your players can understand and take advantage of how these interact with their characters' own techniques and abilities. Given that goals are so important, how does the GM come up with goals for the characters to pursue in the game? In the L5R RPG, two goals are built into every character at character creation: their personal goal, or ninjō, as well as their duty to their lord, or giri. Ninjō is fairly straightforward: the character wants this thing, and they will be pursuing it during the campaign, sometimes even through pivotal scenes. Giri should also contain an actionable goal, and GMs can create adventures by creating obstacles that make those goals harder to achieve. Sometimes these obstacles may even be a lord acting against their own best interests, forcing a character to decide whether to disobey their lord to better serve them! Although these goals don't have to be mutually exclusive, some conflict between ninjō and giri can make for great roleplaying inspiration. Choosing between one's desires and one's duty can make for a thrilling story. Goals wouldn't be interesting if they weren't difficult to achieve. Completing a goal may only require a character to do one thing, or they may need to break down their goal into many smaller tasks, or sub-objectives. Both the original goal and sub-objectives must have hurdles, or obstacles, that the PCs must overcome. You should consider giving your players some leeway to determine how their PCs try to get what they want (choosing between types of hurdles and their approach to overcoming them). If there's only one \"correct way\" to solve problems, players usually feel that their agency to exert influence over the story has been taken away. \"One correct way\" also goes against the spirit of the mechanics themselves, as elemental approaches showcase the idea of solving a challenge through different methods. GMs can brainstorm a list of steps needed for PCs to achieve a goal and work backward from there, or they can also use the different types of hurdles to help them brainstorm the steps. That way, the GM can plan to have their socially focused group be met with NPC adversaries, while their martially inclined group gets to enter into combat in order to accomplish their goals. The different types of goals are explained broadly below—it's up to the GM to translate the general ideas into specifics for their campaign depending on the exact characters, places, and objects included in their story. The GM should also remember to incorporate specific Bushidō tenets into at least one hurdle per session to keep the constraints of the warrior's code at the forefront of the players' concerns (see also Dramatizing Bushidō, on page 286)."
        }
        ENTRY ^"types-of-hurdles" #0mmqQ2ymi8so04SY4O8wQ0 {
            CONCERNS [ ^"Scene" ]
            TOPICS [ "gm", "scenes", "hurdles" ]
            TEXT "In RPGs, hurdles typically take one of these forms: Martial Hurdle: Do they need to fight someone or something to achieve it? Social Hurdle: Do they need to talk to someone to achieve it? Investigative Hurdle: Do they need to find out more information to achieve it? Explorative Hurdle: Do they need to go somewhere to achieve it? Logistical Hurdle: Do they need to get something to achieve it? Emotional Hurdle: Do they need to change their beliefs or personality to achieve it? In RPGs, hurdles typically take one of these forms: Martial hurdles result when two or more entities have competing interests, and only one group can achieve them. This means that the other entity must be eliminated or incapacitated long enough for the competing party to prevail. In Rokugan, creatures, supernatural powers, and especially other characters can all form martial hurdles. Perhaps some guards have been tasked with protecting a valuable item or important person, or a wild beast is preying on the local populace. Martial hurdles can only be overcome through violence, although not all confrontations need to be lethal. Often, injuring or subduing an opponent is all that is needed, but in cases where use of force would be illegal or shameful, characters may be forced to leave no witnesses or tackle the martial hurdle from another angle. In game terms, these confrontations can be modeled using duels, skirmishes, and mass combats. When breaking down an objective into sub-objectives, it may be tempting to force the PCs to complete them one after another in a linear fashion. Not only can this remove some of the players' agency, it's not always how the real world works. The GM is essentially telling the players what they have to do, which ultimately feels boring. Instead, the players should be able to pursue different sub-objectives in the order of their choosing, resulting in a more freeform style of play. In such cases, the GM asks the players what they want to achieve next, and then the group frames a scene that showcases them pursuing that sub-objective and attempting to overcome an appropriate hurdle. person, or a wild beast is preying on the local populace. Martial hurdles can only be overcome through violence, although not all confrontations need to be lethal. Often, injuring or subduing an opponent is all that is needed, but in cases where use of force would be illegal or shameful, characters may be forced to leave no witnesses or tackle the martial hurdle from another angle. In game terms, these confrontations can be modeled using duels, skirmishes, and mass combats. Evidence gained from spirits is inadmissible in most courts, especially those that follow a strict reading of Imperial law. Further, the vagaries of spiritual insight make many lords skeptical of it—after all, the cryptic words of the kami have famously been misinterpreted on several occasions. The PCs can use it to establish facts for themselves, but will need to find stronger evidence (or, ideally, testimony) to prove points they wish to formally make. If you want to know if the PCs notice something without a roll to investigate the area, saying that all characters with vigilance of a certain value or higher notice a clue is one easy route to use. Just remember the vigilance values of your characters (which you can record on the GM's sheet) before asking, lest they all miss something important! Social hurdles result when characters have competing interests and must be persuaded to abandon those interests or yield to the characters competing with them. Persuasion, intimidation, negotiation, and begging are the weapons wielded in these types of hurdles, with parties extracting promises or trading threats to achieve their aims. Intrigues are a more complex way to model these types of interactions in the game; otherwise, roleplaying can yield the same result if the players can figure out sufficient motivation or leverage to sway the opposing characters. Investigative hurdles result from missing or withheld information. Who or what did this thing? How did they do it? Where and when? Why? For characters who have been trained in the Kitsuki Method, an investigative hurdle could entail investigating a room for physical evidence, whereas shugenja could lean on their relationships with the spirits to catch a glimpse of supernatural clues. Characters may also have to consult certain sources of written information, such as a character's pillow book or scrolls in an exclusive library. In most cases, testimony is also required to piece together the missing details. In this way, investigative hurdles intersect social hurdles when a character has the desired information and must be persuaded to give it up. Logistical hurdles result when the characters do not have the tool, skill, or guide they need to complete a task. It's the physical version of the investigative hurdle. The characters may need to figure out where they can get the required item (resulting in an investigative hurdle) and then figure out how to get it. In Rokugan, common methods of acquisition include barter, payment, and even doing errands or tasks in return. Sometimes getting to the needed item is the hurdle, which can make the hurdle martial, social, or explorative as well. What limitations does the environment impose on the characters’ senses or capabilities? Can they use their advantages to overcome them? How dangerous is the terrain? Are there any areas that are especially dangerous or potentially safer, and what are those effects? What are some ways players can spend [Opportunity] on their checks, and what sensory details can you provide to clue players into these possibilities? Do you want to explore a particular subset of the rules in the encounter, such as a specific terrain type or condition? Who or what inhabits the area? Are there animals, people, or spirits, and are there NPC stat blocks you can use to represent them? When the setting or environment itself is the barrier, the group is met with an explorative hurdle. Maybe the area is difficult to navigate or hard to traverse due to its physical characteristics, requiring that characters be fast, strong, or agile to overcome barriers. Environments may also serve as a barrier when the characters don’t know the route to their destination and must blaze new trails to find what they are looking for. Explorative hurdles intersect with logistical hurdles if the characters need to outfit an expedition, and they can become martial hurdles if the terrain includes hostile inhabitants. provide to clue players into these possibilities? The last hurdle is the most difficult one to dramatize (that is to say, illustrate in the fiction of the game as opposed to explaining outright), as it takes place inside a character’s mind. In the emotional hurdle, the character must change their own behaviors in order to succeed. Perhaps they have refused to give up on a certain goal or way of thinking and have become obsessed, and so they must let go in order to move on with their life and find mental peace. Or maybe they have refused to take a certain path or try a certain activity because of their prejudices, and they must learn to let go of their bias in order to grow and improve themselves. Disadvantages are especially well suited to becoming emotional hurdles, as they are stumbling blocks the player has already singled out as things they want to engage with during play. Note, since emotional hurdles happen in a character’s mind, players and GMs may need to get in the habit of describing what their character is thinking to interact with them."
        }
        ENTRY ^"scene-stakes" #OY828k0wcww8eUimICcEqo {
            CONCERNS [ ^"Scene" ]
            TOPICS [ "gm", "scenes", "stakes" ]
            TEXT "The final component to crafting scenarios is the stakes: what will or won’t happen if the characters succeed at their goal or fail to accomplish it. Put another way, these are the risks the character could incur as consequences to their actions, and the rewards that they might reap as a result. Risks and rewards can take the shape of various physical, social, mental/emotional, and spiritual effects. Players are great resources for coming up with potential risks and rewards, since they usually know what they want their character to get, and what would feel like a punishment. And often risks and rewards are the very things that shape a character’s desires in the first place. GMs should remember that failure, too, must be interesting. If the characters don’t achieve their goal, the story should still proceed—there’s no “game over” screen in roleplaying games. What happens next? Certainly, the PCs might be put into a bad spot or have to sacrifice more resources in order to get what they need, but even in rare cases in which the entire group gets killed (such as in a skirmish or mass battle), the river of time still flows in Rokugan, and their deaths will have an impact on the fortunes of their lord and their families."
        }
        ENTRY ^"single-and-multi-lord-campaigns" #mKks6uKKsicSKGqKM6y26O {
            CONCERNS [ ^"GM Role" ]
            TOPICS [ "gm", "campaign" ]
            TEXT "In the Game of Twenty Questions, players are asked to work with the GM to create a lord to whom they have a sworn duty. If a group of players is brand new to Rokugan, you can use this section to design a lord for them. If the group consists of veterans of the L5R setting, you may let the group create their own lords. The game can be easier to run if all the characters are serving a single lord, as this means they all have the same broad objectives: those of their lord. In this style, all of the characters serve one clan, and usually a single family. In a single-lord campaign, the GM develops adventures that hinge on the fortunes of that lord and their secrets—secrets hidden from outsiders due to the potential for shame or controversy. The single-lord campaign style highlights interpersonal connections between the characters, who are likely related through blood or marriage, have trained and served together for some time, or grew up in the same region and share memories of the same places and festivals. The GM should provide the group with a central “home base,” such as a castle, magistrate’s manor, town, or religious site; there, the characters can receive their lord’s orders, gather resources, and recuperate between excursions. GMs should encourage players to personalize this home base to make it a memorable part of the game. This can also make the base a prime target for rival forces, escalating the drama. Although the single-lord game is easier on a GM, players often gravitate toward the multi-lord campaign because each player has a favorite clan they want to represent. This is by far the most common way to play L5R, but it requires the GM to create a context in which it makes sense for the characters to come together and stay together over the course of several scenarios. Two good ways to tie the group together are to create shared goals or circumstances. The GM can use both in tandem to glue the party together even more firmly. See Conflicting Duties on page 294 for more on games where the PCs might be pursuing different ends. When characters all want the same thing, they share the same goal. Because they each have their own lord’s goals to consider, this shared goal must supersede any individual lord’s objectives. In Rokugan, this is done through the Celestial Order: If the competing lords are from the same clan, it’s the clan’s interests that take precedence. If the competing lords are from different clans, it’s the Emperor’s interests that supersede all others. In a game dealing with supernatural threats, the will of Heaven or the kami can unify the group. Sometimes, groups find it enjoyable to play characters who want different things and compete with each other. In these cases, it isn’t shared objectives that bind them together, but their circumstances. These circumstances may be external ones, such as an assignment from their lord or a natural disaster, that compel the characters to stay in close proximity to one another for a set amount of time. The characters appear in each other’s stories because they are so close to one another. After some time, the shared circumstances typically evolve into shared goals as the samurai from different clans work together to overcome their situation. Alternatively, these circumstances may come from within, such as through interpersonal bonds. One character might be a hostage or ward of another character’s family; two other characters might be married, betrothed, or in-laws; additional characters might be linked as siblings, cousins, or even adopted kin. This presents a shared goal to protect one’s family (even if family members don’t like one another, blood ties often prove strong enough to bind characters together). Despite the need for secrecy, it isn't unheard of for a lord to have members of other families from the same clan in their service if those samurai's area of expertise is outside the purview of the lord's family's specialty. Because samurai from the same clan have pledged fealty to the clan champion, they are honor bound to work together to further the interests of the clan. Alternatively, these circumstances may come from within, such as through interpersonal bonds. One character might be a hostage or ward of another character's family; two other characters might be married, betrothed, or in-laws; additional characters might be linked as siblings, cousins, or even adopted kin. This presents a shared goal to protect one's family (even if family members don't like one another, blood ties often prove strong enough to bind characters together). To create a lord, the GM or players should determine their concerns, what complications might arise to make managing their concerns difficult (and cause them to rely on the PCs), their retinue and servants, and finally, their personal agendas and qualities. A lord's concerns are informed by the type of position they hold as lord and comprise the duties for which they're responsible. This is analogous to a player character's giri. Complications are the typical things that conspire to make the lord's duties more difficult to achieve. These usually come from external forces. For the purposes of creating scenarios, complications can be translated into hurdles (see page 289) as well as stakes (see page 292). A lord's retinue sets the resources they have available to solve their problems. The larger their retinue, the less reliant they will be on the PCs for logistical support. A lord's personal agenda is the thing that they'll pursue if left to their own devices. This is analogous to a player character's ninjō. A lord's personal agenda may also serve as an internal force of complication to make their job more difficult. When creating scenarios, these can be translated into goals (see page 288). A lord's personal qualities include their demeanor, passions and anxieties, and distinctions and adversities, as well as appearance: what they look like, dress like, sound like, and so on. Personal qualities can be any of the things that help them do their job well or, at times, prevent them from effectively administering their duties. Concerns, complications, and retinue can be determined by a lord's general role (examples below). After selecting a role, decide on the lord's personal qualities and how these fit in with their role or clash against it. Ministers are officials tasked with overseeing a single aspect of a castle, town, or Empire-wide bureaucracy. These lords form the basis for very narrowly focused campaigns, such as those revolving around politics, war, criminal investigation, or mysticism. Ministers include clan magistrates, castle ministers, and spiritual advisors such as abbots and priests, as well as bureaucrats from Imperial administrations. Nomenclature varies somewhat among clans. In particular, the Unicorn Clan has absorbed organizational traditions from other cultures. One step up in prestige from ministers are the city governors, who are appointed to oversee the administration of a city. A campaign featuring a city governor as lord allows a group to focus on the fortunes of a single location, with the occasional excursion for outside threats. Governors' complications and concerns tend to be larger, including taxation and environmental concerns, and their retinues include various ministers in addition to lesser functionaries. Whenever the GM runs a multi-lord campaign, there is some inherent conflict between the characters' giri as each lord pursues their objectives. This can and should be embraced as part of the fun of the game. Drama arises when there is conflict—when characters struggle to choose between betraying the group to benefit their clan, or betraying the clan in favor of their newfound friends. As the players create characters, the group should decide whether they are comfortable with this sort of drama. If not, then the GM should ensure that the characters' giri are compatible, but for campaigns with split loyalties, there are two ways to handle intrigue between PCs: open and closed. In the open manner, which is recommended for most groups, players have fun knowing things their characters don't, and pushing their characters into uncomfortable positions and revelations. It can help to have out-of-character discussion about how that story unfolds just to make sure everyone is on the same page. This mode also encourages more collaborative storytelling between the players and GM. In the closed manner, which is recommended only for experienced groups, players may pass notes to the GM or send messages in between sessions to describe what their character is up to. Part of the game becomes trying to unravel the other players' secrets. Trust is key for this mode, and it's important to discuss boundaries and expectations beforehand, such as whether it's okay for characters to try to kill, steal from, or disgrace other characters."
        }
        ENTRY ^"adjudicating-checks" #AMEkYSgQQUMymQG2M0gu44 {
            CONCERNS [ ^"Game Rules" ]
            TOPICS [ "gm", "checks" ]
            TEXT "The game works best if neither the GM nor the players attempt to create “gotcha” moments, or use the rules to entrap the other party in a contradiction. It is fundamentally not a competition between the GM and the players (if for no other reason than that the GM wields final authority over the rules), and it operates most harmoniously when the rules are used to collaborate and tell a good story that everyone enjoys! The GM is the players’ guide to Rokugan, helping their characters maneuver and act within the story. The rules of the game are tools for the GM and players to help give structure and a sense of order to these interactions. The following section provides guidance on how best to use many of these rules to enrich the narrative and keep the game running smoothly, along with some additional details for social attributes (see page 300). While the GM and players are collaborating to tell a story, the GM is ultimately the arbiter of all rules matters. The GM should attempt to keep the pace moving during a game session and not get too bogged down in looking up details at the table—they can always reference the relevant sections later to clarify the correct way things should be resolved in the future. The players should endeavor to support the GM rather than undermining them. Players should feel free to offer their interpretations of a rule when it becomes relevant, or if the GM asks, but they should let the ruling stand once the GM has made it. Discussing the rules after a session can be one way to untangle unclear issues or apparent contradictions. The text for a check sometimes indicates a variable difficulty by ring by including the alternative difficulties for specific rings in brackets after the check. This is expressed in the text with a description such as “a TN 3 Fitness check (Earth 1, Fire 4) to keep their footing on the swaying deck of the ship.” This means that the check has a TN of 4 if the character uses their Fire Ring (an aggressive and hasty approach that is disadvantageous for staying balanced), but a TN of only 1 if the character uses their Earth Ring (an approach defined by patience and caution), and a TN of 3 for any other ring. Sometimes, multiple elemental approaches are viable for the same task. In these cases, the GM should offer the player a choice of which approach they want to use. For instance, to get support for an idea, a character could use their Fire Ring with a Social skill to incite interest in their idea, or they could use their Air Ring to trick someone into supporting it. These have very similar outcomes, at least in terms of getting support in the short term. However, the target number to succeed (hereafter referred to as the difficulty) for these two tasks can and should vary—some people are easily excited but hard to mislead, while others are calm but gullible. If you’re letting the player choose their approach, it’s helpful to tell them which ring will make the check easier and which will make it harder, so that they can make an informed choice. Additionally, it’s a good idea to remind them that different approaches can have different consequences for success or failure, and to give them a hint of what these might be. Many problems have numerous possible solutions, so a character might be able to choose between two or more different elemental approaches for the same skill or even different skills from different skill groups to solve the problem. For instance, when attempting to get to the other side of a river (the Fitness skill, from the Martial skill group), a character might leap over it (Overwhelm, the Fire approach to a Martial skill) or swim across it (Shift, the Water approach to a Martial skill). A character might even use another skill entirely (such as Labor, to build a bridge, or Theology, to persuade the water kami to grant passage). See Chapter 3: Skills (page 140) for more on various methods they enable. This does not mean that a character’s chosen method is unimportant. Even if multiple solutions exist, some are usually easier to implement than others. For instance, in social circumstances, some people are extremely receptive to flattery (Charm, the Water approach to a Social skill) but respond to provocation (Incite, the Fire approach to a Social skill) with matched hostility; others are easily browbeaten into doing something honorable (Reason, the Earth approach to a Social skill) but see through even skillful attempts to deceive them (Trick, the Air approach to a Social skill). The TN of a task can vary based on the skill and approach determined by the character’s intended results and method. If a character is walking into a task with only cursory information, they might not know which approach will be the hardest until the GM announces the TN. If the character has foreknowledge of the task, on the other hand, the GM might want to hint—or even state outright—that an approach is easier or harder. If a skill or one of its approaches is ill-suited to a situation, the GM should increase the TN of the check by 1–3. If a skill or one of its approaches is particularly well-suited to the circumstances, the GM should reduce the TN by 1–3 (to a minimum of 0). The TN of a task can vary based on the skill and approach determined by the character’s intended results and method. If a character is walking into a task with only cursory information, they might not know which approach will be the hardest until the GM announces the TN. If the character has foreknowledge of the task, on the other hand, the GM might want to hint—or even state outright—that an approach is easier or harder. If a skill or one of its approaches is ill-suited to a situation, the GM should increase the TN of the check by 1–3. If a skill or one of its approaches is particularly well-suited to the circumstances, the GM should reduce the TN by 1–3 (to a minimum of 0)."
        }
        ENTRY ^"revealing-target-numbers" #UoiQeumq6AkkG8YWe2G8UM {
            CONCERNS [ ^"Game Rules" ]
            TOPICS [ "gm", "target number" ]
            TEXT "Much of the drama (and strategy) of choosing which dice to keep on a check derives from how much strife a character is willing to suffer in order to succeed, as well as whether they are able to activate other abilities as part of the check using [Opportunity] symbols. If the player knows the TN they are trying to achieve, they will have the agency to choose interesting dice combinations. In contrast, if the player does not know the TN, the choice of which dice to keep has a “push your luck” incentive to avoid accidentally keeping too few [Success] and [Opportunity] symbols. While this can heighten tension at the table, many players will favor taking as many [Success] as possible to reduce the risk of accidentally failing, ignoring chances to use [Opportunity] to enhance the narrative. For the majority of checks, we recommend the GM tell the players the TN. However, there are some rare occasions when the difficulty of a task would not be something the characters could accurately assess. Hidden TNs emphasize the mystery of a check, and can thus be good for showing that the PCs are out of their depth, such as when dealing with very powerful foes, supernatural beings, or unforeseen circumstances For instance, if a check to look for subtle tells in someone’s countenance is a TN 3 Sentiment (Air) check, the GM might inform the player that they can get additional details with two bonus success. The GM can inform the player of this before or after they choose kept dice, but remember that informing them beforehand makes their choice much more interesting."
        }
        ENTRY ^"advantages-and-disadvantages-in-play" #sa4cMci0YWoQYyKcY48CMG {
            CONCERNS [ ^"Game Rules" ]
            TOPICS [ "gm", "advantages" ]
            TEXT "Advantages and disadvantages can add a great deal of flavor to a scene. Conflicts in samurai stories are often determined by the slightest differences between combatants, or one warrior’s unique qualities. The GM and players should make full use of these descriptive traits at appropriate moments, shaping the story based on their characters’ individual qualities. The GM can record each character’s advantages and disadvantages on the Campaign Sheet for ease of reference. While advantages and disadvantages can be applied to any check for which they make sense, a good rule of thumb is to use them only when it might be decisive. For instance, if a character has already failed, there is no good reason to apply their disadvantage unless the amount by which they fall short matters. Similarly, if a character is already successful, it might not be worth spending much time applying advantages unless bonus successes or removing strife are very important. While each character starts with advantages and disadvantages, characters can also end up acquiring more in the course of play (see Gaining Advantages and Disadvantages, on page 99). Critical strikes can permanently wound characters, leaving them with a scar disadvantage, while the Shadowlands Taint can infect a character’s very soul. Honor and glory can give characters advantages that represent their good reputation and personal convictions (or infamy and doubts). A character’s social circumstances can be represented with advantages and disadvantages. A powerful alliance might earn a character the Support of [One Group] distinction. In contrast, spurning a group or coming into conflict with them might cause a character to be assigned the Scorn of [One Group] adversity. These advantages and disadvantages should generally take significant effort on the part of the players to obtain. If you notice your players aren't making full use of their advantages, after a player fails a roll, ask them if they have any advantages that might apply. If they can't think of one, see if one of the other players has an idea. If nobody can think of anything, move on—the idea is to remind them that advantages exist and encourage them to be creative in their use. When a player applies an advantage or disadvantage to a check, they should describe how it factors into the scene. Does the bushi’s rippling physique help them to cast aside the heavy stone in the group’s path? Does a courtier’s passion for tea mean that the scent of an exquisite cup dispels their worries after a stinging exchange with a rival? Filling in these details can help bring the story to life and reinforce that the characters are more than the numerical values of their rings and skills."
        }
        ENTRY ^"spending-opportunity-in-play" #GIw6eAoGeOkm4My8Wayu4Q {
            CONCERNS [ ^"Game Rules" ]
            TOPICS [ "gm", "opportunity" ]
            TEXT "At your discretion, you can allow PCs to activate [opportunity] from other rings listed in Table 8–1: Example [opportunity] on page 328 at double the cost. This option vastly increases the number of ways to spend [opportunity], but also dilutes the uniqueness of each ring. If you wanted to impose a small limit, cross-ring [opportunity] could be allowed only as follows: Air to Fire or Water Earth to Fire or Water Fire to Air or Earth Water to Air or Earth Void to any Opportunity gives GMs and players a chance to add narrative flair to their checks and activate additional abilities. However, it can also create a feeling that one needs to examine every possible option for [opportunity] on a check. It can be a lot of pressure to be creative on the spot—but it doesn’t need to be. Remember that the default options from Table 8–1: Spending [opportunity] (see page 328) are always available. Assisting another character on a similar subsequent check (for [opportunity] if the first character fails their check or [opportunity][opportunity] if the first character succeeds on their check), for instance, is always useful. More importantly, it can make for a simple but effective narrative moment of two characters working in concert to overcome a challenge before them that fits in nearly any context. Maybe one character calls out a warning to the other, letting them cut down a foe they wouldn’t have seen. Perhaps it is as simple as the two exchanging a reassuring glance before going into a challenging negotiation. While long descriptions can bog down play, even a short aside about how a character is helping a comrade can enrich the story by underscoring the bond (or tensions) between them. These little moments can help to reinforce their relationship, and they are sometimes more memorable in the long run than even the more narratively pivotal scenes when taken as a whole. A player or the GM can even poll the group for ideas for using [opportunity], asking if anyone else has an idea for how to spend it, narratively or mechanically. Sometimes, the GM or another player will have a good idea already in mind. Above all, whether you’re a player or GM, try not to stress out over [opportunity]. If you can think of a good use for [opportunity] from one of your abilities or a relevant table, use it. If you have a great, creative idea to use [opportunity], pitch it to the group. And if you can’t think of anything, use one of the basic options from Table 8–1: Spending [opportunity] (see page 328) or let it go unused (in the case of minion NPCs especially)."
        }
        ENTRY ^"ninjo-giri-and-discord" #e0Ii60ea60s6AmgYkg6cCc {
            CONCERNS [ ^"Ninjō" ]
            TOPICS [ "gm", "ninjo", "discord" ]
            TEXT "Ninjō and giri inform the players and GM about a character’s relationship with their desires and their duty. In many works of fiction about samurai, a character strives to maintain their personal values while achieving glory in the eyes of their lord. During this process, the character’s perspectives on honor and glory are often challenged, and these perspectives frequently evolve as the character develops. Alternatively, a conflict between one’s personal beliefs and the needs of a sworn lord might drive a character’s development over the course of a story. The twin motivations of ninjō (a character’s internal feelings, tied to their belief in Bushidō) and giri (the oaths to their lord that they must uphold to advance in the world) are levers that the GM can use to create interesting, dramatic confrontations between characters, or even within a single character. Complications, as described on page 39, are a way that both GMs and players can pull these motives into the story. GMs can choose to use the rules for discord to create conflicting complications for the PCs. Discord functions in a simple manner: choose one PC’s giri and another’s ninjō, then simultaneously introduce complications for each that set the two motivations at odds with each other through the use of a pair of complications introduced at the same time. The discord tracks allows the GM to determine these in a randomized manner for a more procedural approach, but planning in advance is equally valid. Once all characters have chosen their ninjō and giri, the GM should fill in the discord tracks on the Campaign Sheet (found at www.FantasyFlightGames.com). One track is for giri, and the other is for ninjō. The GM writes each character’s name outside of the tracks as indicated, and then each character’s giri on the inner track and ninjō on the outer track. Above all, whether you’re a player or GM, try not to stress out over [Opportunity]. If you can think of a good use for [Opportunity] from one of your abilities or a relevant table, use it. If you have a great, creative idea to use [Opportunity], pitch it to the group. And if you can’t think of anything, use one of the basic options from Table 8–1: Spending [Opportunity] (see page 328) or let it go unused (in the case of minion NPCs especially)."
        }
        ENTRY ^"character-growth-and-discord" #2MAYsgqS2IgqUC0yEe2EwA {
            CONCERNS [ ^"Ninjō" ]
            TOPICS [ "gm", "growth", "discord" ]
            TEXT "For the first session, the GM should begin at Spoke 1 for both tracks. For future sessions, the GM should begin at the spokes that contributed to the last session's discord for each of the two tracks. To determine a session's discord, roll and keep a number of (Ring Die) equal to the number of players (resolving (Strife) as usual). Total the number of (Success) and (Exploding Success), and then count that many spokes counterclockwise on the giri track, skipping any blank spaces. The final spoke indicates the character whose giri is part of the session's discord. The GM should start thinking about a complication they can introduce that stems from this PC's giri. Next, total the number of (Opportunity) and (Exploding Success), and then count that many spokes clockwise on the ninjō track, skipping any blank spaces. The final spoke indicates the character whose ninjō is part of the session's discord. The GM should start thinking about a complication related to this players' ninjō, and how it might clash with the prior complication. The GM may inform the player whether it was their character's giri or ninjō that was rolled if they want to let the player start thinking about ways to work it into the story—or not, if that builds tension more effectively. Character growth is an important theme of Legend of the Five Rings, as each character pursues mastery within their domain while expanding their knowledge of the wider world. The recommended rate of experience point gain is 1 XP per hour of play, with an additional 3–5 XP awarded to each character in the group at the GM's discretion whenever the party overcomes a significant milestone or obstacle. Increasing the base value to 2 XP per hour will make for a more heroic-feeling game, and is often a good idea to help keep tactically oriented groups engaged. GMs should feel free to adjust these numbers as they see fit. At their discretion, GMs can also give bonus XP for particularly strong moments of roleplaying among the group. Standardized XP across the group makes it easier for everyone to track and helps keep the characters at a roughly equivalent level of competency, but GMs should also feel free to award XP on a per-player basis if that is their group's preference. Player characters in Legend of the Five Rings live three feet from death at all times, so one or more PCs might well meet their end during the story. Alternatively, a character might be retired from play because they have completed their duty, because they have been stripped of their status as a samurai, or because they have simply become too old for such adventures and wish to spend their final years in contemplation at a monastery. It is recommended that GMs allow a player whose character has perished or otherwise been retired to create a new PC with the same amount of experience as their late character. The possibility of character death can be an important part of Legend of the Five Rings, but it should always be an occurrence that serves to show the stakes of the narrative and makes the story more interesting rather than a \"punishment\" for a player's decisions. Additionally, the GM should keep in mind that death is often the least interesting way a character's story can end. If the PCs are vanquished in battle, for instance, instead of simply dying, they might be taken hostage (hostages are valuable, after all) and need to escape. If a PC falls into a river from an incredible height, they could die—or they could awaken downstream, gravely injured but alive. Even a lethal blow from a critical strike can often be healed to stabilize a character before the Dying condition causes them to expire, and if no PC is trained in Medicine, an NPC might be able to step in to save their life (likely with an expectation of a significant favor down the road, of course). Sometimes, the dice decide that a PC's time is up, but frequently, the GM has some leeway to interpret the results as best serves the story. Creating satisfying discord doesn't mean \"trapping\" your PCs in an unsolvable problem where one has to \"defeat\" the other. Conflicts between characters are often best when they are a matter of give and take, with each character winning on some accounts and losing on others. Alternately, you can prepare a common enemy—perhaps underlying cause of both complications—who the PCs can rally against at the end, diffusing the tension."
        }
        ENTRY ^"more-starting-options" #UYGkqq6UI0wcgQ4waIaUWy {
            CONCERNS [ ^"GM Role" ]
            TOPICS [ "gm", "character creation" ]
            TEXT "GMs who want to give their players more options to start can always have their PCs begin with XP and even titles based on the sorts of characters they want them to be able to build at the outset. A few potential starting points are: Young Heroes: +10 XP Seasoned Retainers: +30 XP Veteran Samurai: +50 XP, one appropriate title such as Emerald Magistrate"
        }
        ENTRY ^"alternate-playstyles" #sOcwUa4wsCcQUwYcoEgyM8 {
            CONCERNS [ ^"GM Role" ]
            TOPICS [ "gm", "playstyle" ]
            TEXT "The land of Rokugan is fertile imaginative ground in which GMs and players can grow vivid stories, and not all of these tales are focused exclusively on noble samurai torn between the sworn duty their role demands and their inner desires. From desperate rōnin and outlaws inspired by literature such as Water Margin and the films of Akira Kurosawa, to groups of elite warriors protecting the whole of the Emerald Empire from supernatural threats, there are numerous other stories worth telling in the lands of the Legend of the Five Rings. This section describes a few alternate campaign styles you might want to explore, how to create characters for those games, and how these games can differ from our default playstyle and conventions. In this playstyle, samurai are potentially one of the largest dangers to the PCs. They might be allies during a given story, for many samurai have use of characters like the PCs. However, most samurai will be unlikely to risk their lives for the PCs, and often view them as disposable. Instead of the samurai of the Great Clans and their intrigues and struggles, this playstyle focuses on the forgotten heroes and villains who live on the outskirts of society and struggle to survive in a dangerous world. While defending a village from bandits, fleeing the consequences of one’s actions, or scraping together a few bu for one’s next meal may not be the stuff of epic poems, it is just as harrowing for those who live it. This sort of story hinges on the idea that the player characters are outsiders in the broad scope of society. They are not notable political actors as the default playstyle assumes, and they are not likely to be given any political power they do not seize with their own hands. If they are samurai, they have likely forsaken or lost their titles and become rōnin, but they may also be merchants, ashigaru, peasants, and burakumin. As a result, the company is often much rougher than the high courts of the Emerald Empire—courtesy is still important to some people, but being discourteous is only as dangerous as the person you have chosen to insult. Apply the following alterations to the Game of Twenty Questions (see page 41) for each character: Question 1: Which clan’s lands did your character grow up in? The mechanical choice is the same, except that your status is a value of your choice from 20 to 24. After all, the peasants and samurai of a given region share many cultural values (even if most samurai are loathe to admit it). Question 2: Who is your family? Unless you are a fallen samurai, your family falls far beneath the notice of the Great Clans—you might have no family but the comrades you choose for yourself. Use the Rokugani peasant family above unless you are a fallen samurai, in which case choose a family as normal. Question 3: Where did you learn their skills? Unless you are a fallen samurai, use the Worldly Rōnin school on page 87. If you are a fallen samurai, use a school package as normal, but your starting honor is 30. All characters use the following starting outfit: Traveling clothes, any 1 weapon of rarity 7 or lower, traveling pack, any 1 item of rarity 5 or lower. Question 5: What is your past? Instead of selecting a giri, select a past. A past is the set of circumstances that led you to life on the fringes of society. Your past might be a grim reputation as a warrior that you seek to outrun, circumstances of birth that forced you to be a rōnin, or the enemies who pursue you. Your past should meet the same rough criteria as giri—something that can clash with your desires, and can create drama for your character that you will enjoy during the campaign. To attain glory, you must overcome your past, but the more glory you acquire, the more likely your past is to come crashing down upon you. Question 7: Skip this question. Question 18: Who was your character named after? Unless you are a fallen samurai, instead of rolling on Table 2–1: Samurai Heritage (see page 96), choose 1 additional item of rarity 5 or lower that you inherited from the family member, friend, or mentor who gave you your name or outlook on life."
        }
    }
    GUIDANCE {
        ENTRY ^"bushido-in-rokugan" #OMqcMCkk0UqmIMQ00eO4iw {
            CONCERNS [ ^"Honor" ]
            TOPICS [ "bushido", "honor" ]
            TEXT "Rokugani Bushidō is quite different from anything that existed historically in Japan. While historical samurai had deeply held convictions that they lived and died for, there is no single text that defined Bushidō for all samurai. Outside of Japan, cultural understanding of Bushidō comes in large part from retrospective efforts to understand the past. Inazo Nitobe’s Bushido: The Soul of Japan (1900) is one text written by a Japanese scholar to explain Bushidō to English speakers. Nitobe offers “Military-Knight-Ways” as a translation of Bushidō, and expands it to the “Precepts of Knighthood,” the noblesse oblige of the warrior class.” Much as the code of chivalry in Europe has been romanticized to fit with the values of later writers, Nitobe’s account of Bushidō is a product of its own time (after the era of samurai), and it can help readers understand the history of Western views on Bushidō. Honor is a code of behavior meant to guide the members of the samurai caste, but it does not align exactly in all places with Rokugan's complex legal system, which imposes different standards upon people at the different levels of society. Some things are dishonorable but not considered crimes for samurai—killing someone of lower station without just cause might be within a samurai's legal rights (provided that person is not considered another samurai's charge), but it is still a severe violation of the Bushidō tenet of Compassion (Jin), which dictates that a samurai should have regard for even these lives. Almost all criminal activities are on some level dishonorable, though occasionally, breaking the law is less dishonorable than the alternative. Table 7–2: Honor Scores offers concrete examples of what a character's honor attribute says about their moral fiber. As detailed in that table, if a character's honor enters a certain range, the character receives one or more virtue-type distinctions or flaw-type adversities. These are chosen by the player, based on the parts of the code their character holds dearest or spurns. These are removed if the character's honor rises or falls outside of the specified range.. Literally meaning “way of the warrior” in Japanese, Bushidō is the code by which nearly all samurai in Rokugan strive to live. Samurai are taught to reach for these ideals at the expense of their own personal gain. Of course, samurai are also human, so the “breaking point” when one abandons Bushidō out of self-interest or the need for self-preservation makes for rich story and roleplaying material. The other rich story opportunity associated with Bushidō occurs when its tenets inevitably come into conflict with each other. What does a samurai do when their lord commands them to do something dishonorable? What does a samurai do when Honesty clashes with Courtesy? When Justice calls for blood but Compassion counsels mercy? Honor is a code of behavior meant to guide the members of the samurai caste, but it does not align exactly in all places with Rokugan’s complex legal system, which imposes different standards upon people at the different levels of society. Some things are dishonorable but not considered crimes for samurai—killing someone of lower station without just cause might be within a samurai’s legal rights (provided that person is not considered another samurai’s charge), but it is still a severe violation of the Bushidō tenet of Compassion (Jin), which dictates that a samurai should have regard for even these lives. Almost all criminal activities are on some level dishonorable, though occasionally, breaking the law is less dishonorable than the alternative. Table 7–2: Honor Scores offers concrete examples of what a character’s honor attribute says about their moral fiber. As detailed in that table, if a character’s honor enters a certain range, the character receives one or more virtue-type distinctions or flaw-type adversities. These are chosen by the player, based on the parts of the code their character holds dearest or spurns. These are removed if the character’s honor rises or falls outside of the specified range.. Within the fictional world of Rokugan, honor is believed to be more objective than it is subjective. The Rokugani code of honor does vary somewhat in interpretation, but samurai mostly agree on what the perfect samurai should believe, live for, and die for. It is a harsh code, and it values some lives above others. Unlike in historical Japan, the bulk of Rokugani Bushidō's demands are spelled out in a single text—Akodo's Leadership. There is little room for shades of gray, and even those samurai who do not hold themselves to every demand of Bushidō generally believe in the code's value. Where they disagree is on which tenets of Bushidō can be allowed to slide with the least consequence, and which must be upheld no matter what."
        }
        ENTRY ^"honor-glory-and-status" #qSS6C06y0SCUaeAEAYcqG4 {
            CONCERNS [ ^"Honor" ]
            TOPICS [ "bushido", "honor", "glory", "status" ]
            TEXT "Honor, glory, and status are important aspects of a character in Legend of the Five Rings. Not only can knowing these values for their characters help players roleplay these individuals more aptly, but the GM can also use honor, glory, and status as tools to help players engage with the setting. The PCs are immersed Rokugani even if the players are not. Honor, glory, and status exist to help bridge that gap, giving players clear indicators of costs their choices might incur and the standing of others in the world. It usually falls to the GM to bring these attributes into the game, although players can certainly make use of them actively as well. Reminding a player that they must choose to have their character forfeit 1 honor if they wish to make that snide remark to someone of higher status reinforces the importance of courtesy in Rokugan. Similarly, noting that a character must stake glory if they wish to boast that they will be the first into the enemy’s castle the next day can be an excellent way to help bring the society the characters live in to the forefront of the players’ minds. Knowing one’s status relative to that of another character is often vital to properly interacting with them. Players can make checks to determine an NPC’s honor, glory, or status to predict their behavior (see The Art of Investigation on page 170). The GM can have NPCs do the same to the PCs, and should have them give different reactions based on these values and what the NPCs know about the PCs. When a player chooses to forfeit or stake their character’s honor or glory, consult Table 7–1: Honor and Glory Forfeits/Awards and the relevant section of this chapter for guidance on how much honor they must give up to perform the deed."
        }
        ENTRY ^"the-seven-tenets" #EEoIui2AMau8KsQum0CIwO {
            CONCERNS [ ^"Honor" ]
            TOPICS [ "bushido", "tenets" ]
            TEXT "Each of the seven tenets listed below is accompanied by a number of examples of situations when a character might have to forfeit honor to disobey it, need to stake honor on upholding it, or receive an honor reward for giving something up to pursue it. The GM can use these as guidelines for honor losses and awards."
        }
        ENTRY ^"compassion-breaches-and-sacrifices" #cwgqCG8OYeMuYi6MWmiKwQ {
            CONCERNS [ ^"Compassion (Jin)" ]
            TOPICS [ "bushido", "compassion" ]
            TEXT "Example breaches of Compassion include: (Minor) Verbal cruelty to a foe or stranger, allowing easily prevented suffering, tormenting animals; (Major) Verbal cruelty to a friend, physically harming someone for revenge alone, letting an ally die without trying to save them; (Massive) Murdering someone of lower status in cold blood, physically harming someone for fun. Example sacrifices for Compassion include: (Minor) Giving someone a common useful item, spending two or more downtime scenes helping a friend, treating a foe's wounds after a battle; (Major) Giving up your chance to be awarded 6 or more glory for someone else, saving someone's life despite knowing they may trouble you later; (Massive) Giving away an irreplaceable item, completing a dangerous heroic task for someone else who cannot repay you."
        }
        ENTRY ^"courage-breaches-and-sacrifices" #0eyIUuy2ei4iuqOQUsM2EG {
            CONCERNS [ ^"Courage (Yū)" ]
            TOPICS [ "bushido", "courage" ]
            TEXT "Example breaches of Courage include: (Minor) Allowing fear for yourself to influence your actions, leaving a lost battle to protect your lord; (Major) Allowing fear to prevent you from acting entirely, fleeing to save your own skin; (Massive) Committing a despicable act out of fear, sacrificing someone else to save yourself. Example sacrifices for Courage include: (Minor) Refusing to back down from an armed enemy while unarmed, accepting a challenge from a foe you know to be a superior warrior; (Major) Facing an inhuman foe such as an oni alone, preventing a comrade's massive breach, suffering a severity 8 or lower critical strike for your lord; (Massive) Preventing your lord's major or massive breach, suffering a severity 8 or higher critical strike for your lord."
        }
        ENTRY ^"courtesy-breaches-and-sacrifices" #OyswIqeAyg40ISYM4cGGIk {
            CONCERNS [ ^"Courtesy (Rei)" ]
            TOPICS [ "bushido", "courtesy" ]
            TEXT "Example breaches of Courtesy include: (Minor) Drunkenness or coarse language in the presence of someone of higher status, letting an insult to your clan or family pass without remark; (Major) Directly insulting someone of equal or higher status, letting an insult to your ancestors, sensei, or lord pass without remark; (Massive) Directly insulting your lord. Example sacrifices for Courtesy include: (Minor) Paying a sincere compliment to a foe, allowing a tired foe a moment's respite, letting someone of higher status receive aid first; (Major) Giving an unarmed foe a weapon or setting aside your own weapons to fight fairly; (Massive) Taking an enemy of higher status captive without killing or maiming them."
        }
        ENTRY ^"duty-and-loyalty-breaches-and-sacrifices" #qCwQOsWaYMWy8YsyQYWKSS {
            CONCERNS [ ^"Duty and Loyalty (Chūgi)" ]
            TOPICS [ "bushido", "duty" ]
            TEXT "Example breaches of Duty and Loyalty include: (Minor) Refusing an order to protect your lord's interests, intentionally misinterpreting an order; (Major) Refusing an order from your lord; (Massive) Forsaking your post for another lord. Example sacrifices for Duty and Loyalty include: (Minor) Refusing to commit an act of disloyalty to your lord despite personal feelings; (Major) Refusing to obey an unjust order from someone who is not your lord; (Massive) Dying in your lord's service."
        }
        ENTRY ^"honor-breaches-and-sacrifices" #E2Ic2cKGgOkI0Sq0qcuqyo {
            CONCERNS [ ^"Honor (Meiyo)" ]
            TOPICS [ "bushido", "honor" ]
            TEXT "Example breaches of Honor include: (Minor) Touching dead flesh anywhere other than at war, persuading another to act dishonorably; (Major) Neglecting your duty to pursue your earthly desires, killing in an unjustified duel; (Massive) Refusing seppuku when required. Example sacrifices for Honor include: (Minor) Persuading someone to abandon a dishonorable plan to help you; (Major) Negotiating to avoid an unjustified duel; (Massive) Offering to commit seppuku for failure."
        }
        ENTRY ^"righteousness-breaches-and-sacrifices" #ksWY4E4CsOcEWyesMUEOYC {
            CONCERNS [ ^"Righteousness (Gi)" ]
            TOPICS [ "bushido", "righteousness" ]
            TEXT "Example breaches of Righteousness include: (Minor) Abetting or covering for a comrade's major breach of honor, lying to someone of equal or lower status for personal gain; (Major) Abetting or covering for a comrade's massive breach of honor, lying to someone of higher status for personal gain; (Massive) Murdering someone of equal or higher status, lying to your lord for selfish gain. Example sacrifices for Righteousness include: (Minor) Delivering bad news to your lord without deflecting blame, taking responsibility for the failure of a subordinate; (Major) Retiring from a post you can no longer fulfill, relinquishing a claim or large gift to your lord; (Massive) Refusing to deny true allegations of a failure requiring you to forfeit 9+ glory or status."
        }
        ENTRY ^"sincerity-breaches-and-sacrifices" #8aGYiMwY0ouGoIgOiyucW8 {
            CONCERNS [ ^"Sincerity (Makoto)" ]
            TOPICS [ "bushido", "sincerity" ]
            TEXT "Example breaches of Sincerity include: (Minor) Breaking your word to someone of equal or lower status, misleading a friend; (Major) Breaking your word to someone of higher status, manipulating someone for fun; (Massive) Deceiving or manipulating your lord. Example sacrifices for Sincerity include: (Minor) Publicly revealing a truth that damages your reputation (a forfeit of 3 or more glory); (Major) Giving (honest) testimony against a political ally that jeopardizes future relations; (Massive) Forfeiting 6 or more glory to claim responsibility for your lord's mistake."
        }
        ENTRY ^"scorpion-and-perceived-honor" #WOSQMuiwcCwcyo6OK4awSe {
            CONCERNS [ ^"Honor" ]
            TOPICS [ "bushido", "honor", "scorpion" ]
            TEXT "The Scorpion Clan is particularly illustrative of the perceived objectivity of honor: its members do not debate the definitions of honor or attempt to rationalize their actions as honorable through twisted logic, but they also do not believe that honor is worthless. They accept that members of Bayushi’s clan cannot behave according to Bushidō precepts, but they do not actually disagree with what these precepts are or even that they are valuable. Honor is for oth-er samurai, and they can be honorable only because the Scorpion are willing to do the dirty work that a society demands."
        }
        ENTRY ^"glory-versus-fame" #io0cymmQksoUcsiyWwIyUC {
            CONCERNS [ ^"Glory" ]
            TOPICS [ "glory" ]
            TEXT "Glory is not exactly a character's fame; a character who is known for deeds both good and ill might have a modest glory value due to the conflicting accounts of their actions. It does, though, confer advantages that reflect fame (or disadvantages that represent infamy) if it reaches certain highs (or lows). Glory is best described as how much the outside world (with a particular emphasis on the character's sworn lord) believes the character is a proper samurai."
        }
        ENTRY ^"connecting-giri-to-a-lord" #6aMogYkkOkIoKequciw2UM {
            CONCERNS [ ^"Ninjō" ]
            TOPICS [ "giri", "gm" ]
            TEXT "CONNECTING GIRI TO A LORD A lord’s retinue and servants may include any number of player characters as well as all the other non-player characters whom the lord relies on to execute their duties. These supporting characters can be a source of allies or rivals (sometimes at the same time) for the PCs. A specific task that would fall to a member of a lord’s retinue is a good example of a giri for a player character."
        }
    }
    GUIDANCE {
        ENTRY ^"clans-views-of-bushido" #QaeOeQSAykgCmCkcw6EKyk {
            CONCERNS [ ^"Honor" ]
            TOPICS [ "bushido", "honor", "clans" ]
            TEXT "Each clan has one or more tenets it views as paramount, even above the others. When a character chooses to forfeit honor due to defying one of their own clan's paramount tenets, they double the amount of honor they must forfeit. When a character is awarded honor as a result of making a personal sacrifice for this tenet, the GM should double the honor they are awarded. • Crab: Courage • Crane: Courtesy • Dragon: Sincerity • Lion: Honor • Phoenix: Righteousness • Scorpion: Duty and Loyalty • Unicorn: Compassion Each clan has one or more tenets of Bushidō it views as less significant than the others. When a character chooses to forfeit honor due to defy this tenet, halve the amount of honor they must forfeit (rounded up, to a minimum of 1). When a character is awarded honor for making a personal sacrifice in the name of this tenet, halve the honor they are awarded (rounded up, to a minimum of 1). • Crab: Courtesy • Crane: Courage • Dragon: Duty and Loyalty • Lion: Compassion • Phoenix: Sincerity • Scorpion: Honor and Righteousness • Unicorn: Courtesy"
        }
        ENTRY ^"provincial-daimyo-and-campaigns" #oIOGcieEwgs68yykU0gAcY {
            CONCERNS [ ^"GM Role" ]
            TOPICS [ "gm", "campaign", "daimyo" ]
            TEXT "Provincial daimyō make up the backbone of the Empire’s feudal system and are the lowest ranking daimyō. They oversee a province, a collection of cities, towns, and the land between them. Campaigns featuring provincial lords focus on a single area but encompass a wider variety of locations, including castles, towns, villages, rural shrines, and wilderness locations. Each province is known for particular cultural and specialty items, from festivals to foods and arts to geographical features. GMs should determine the primary means by which the province feeds itself, whether farming, fishing, hunting and gathering, or even imports. Most provinces border three to four other provinces, but those in the far-flung regions of the Empire may be relatively isolated, with only one or two neighbors huddling on the frontier alongside them. Unlike city governors and ministers, provincial daimyō are not appointed but inherit their titles through a predetermined line of succession. There are usually three or four provincial daimyō reporting to a single family daimyō. The family daimyō oversees the daimyō of all their provinces from their ancestral castle, which may also serve as the capital of a province. In each clan, there is one leading family whose daimyō also serves as champion, to whom all others swear loyalty. A clan champion is technically in charge of their own province as well as overseeing the affairs of several provincial daimyō and all of their clan’s family daimyō, but in reality it simply means that their ministers do more work on the champion’s behalf. The families and clans are those listed in the Game of Twenty Questions, but this template can also be used to model the daimyō of vassal families and champions of Minor Clans, albeit on a smaller scale."
        }
        ENTRY ^"office-roles-in-campaigns" #CiG060omI2yswIGMUmiYC2 {
            CONCERNS [ ^"GM Role" ]
            TOPICS [ "gm", "campaign", "offices" ]
            TEXT "Concerns: Executing the responsibilities such as upholding laws and norms, overseeing rites and ceremonies, investigating lawbreakers and heretics, overseeing development projects, and ensuring stability and productivity. Complications: Expectations from superiors, unclear divisions of power (who is ultimately responsible for a particular thing?), unclear chains of command (who outranks whom?), rivals for promotions, rivals of intent, scandals and cover-ups, lack of resources, and changing laws. Retinue and Servants: Counterparts overseeing related spheres, deputy ministers, secretaries, shrine keepers, monks, apprentices, bodyguards, household members (such as spouse, children, and parents), household servants."
        }
    }
    GUIDANCE {
        ENTRY ^"npcs-minions-and-adversaries" #ksku0qAKkSMgC8AwMsIkUK {
            CONCERNS [ ^"NPC" ]
            TOPICS [ "npc", "minion", "adversary" ]
            TEXT "Non-player characters are the other inhabitants of the world, with whom the player characters interact. In story terms, the PCs are the main protagonists, and NPCs can be thought of as the supporting cast: bit characters, friends and allies, rivals, and antagonists. Although they can be extremely important to the arc of the narrative (the call to aid from an old friend or the diabolical scheme of a villain might be the sorts of events that initiate a story), in most scenes, these characters are not in focus. The majority of the time, the story that the group tells flows best if it is framed around the player characters and their perspectives, decisions, and actions. Like other elements of the world outside of the PCs, NPCs are controlled and portrayed by the GM. Portraying a wide variety of characters can be a challenge, but it can also be one of the best parts of sitting in the GM's seat. GMs can, of course, invent their own NPCs, but many printed materials provide premade NPCs, along with the various rules needed to make the most of them in play. An NPC profile consists of the following elements: PCs can often engage more than one minion at a time, though some are more powerful than others. Being a minion doesn't necessarily mean that a character is weak, simply that their expected role in the story doesn't require more complex rules. Minions behave like other characters, with the following exceptions: There are two types of NPCs: minions and adversaries. Minions are characters of lesser importance in the scope of the story: they might be minor characters in a town or village, or they might be foes with little dramatic weight. Because they have a smaller role in the story, they have simplified character profiles. PCs can often engage more than one minion at a time, though some are more powerful than others. Being a minion doesn't necessarily mean that a character is weak, simply that their expected role in the story doesn't require more complex rules. Minions behave like other characters, with the following exceptions: Adversaries are NPCs of substantial narrative significance. These might be rivals or powerful allies to the PCs, and they stand on the same footing as player characters. Their profiles are organized differently than a PC's profile for the GM's convenience, but each adversary is a match for one or more PCs in its arena of expertise. Adversaries behave like standard characters."
        }
        ENTRY ^"running-npcs" #ImAwa04aucG4Y0aCEsM8U8 {
            CONCERNS [ ^"GM Role" ]
            TOPICS [ "npc", "gm" ]
            TEXT "NPCs accumulate strife in the normal manner (see page 29), but the GM need only track their strife if it is actually likely to become important. Otherwise, strife they generate can simply be used as a general indicator for how to portray the character. If an NPC's strife is being tracked and exceeds their composure, they should generally unmask at the start of their next turn unless they are an exceptionally disciplined individual. For guidance on dealing with strife with large groups of NPCs, see NPC Squads on page 317. GMs should keep the following advice in mind when rolling dice for NPCs. Rolling Dice: Keep the resolution of NPC rolls quick, using a bit of narration as needed to help the players understand what is going on. Spending [Opportunity]: Don't overthink it. [Opportunity] can inspire memorable moments, but not every check needs a cinematic turnabout. If it's taking more than a few seconds, take a look at the NPC's profile, which often contains abilities for [Opportunity]—or just let it go unspent. Remember that NPCs are more than just a set of rules and statistics! They are supporting characters, and can have interests, quirks, and desires on a narrative level beyond the statistics detailed in their profile. Such flourishes will help make them feel realized and compelling. Advantages and disadvantages add flavor to NPC profiles, and they also let cunning PCs exploit the weaknesses (and strengths) of their rivals and foes!"
        }
        ENTRY ^"npc-demeanors" #6wqkmwQ6kky0K8W0eIQUw8 {
            CONCERNS [ ^"NPC" ]
            TOPICS [ "npc", "demeanor" ]
            TEXT "Each NPC profile includes a demeanor. A demeanor is a common personality type for characters of that sort, and it makes some Social skill checks easier while making others harder. Each demeanor lists an increase to the TN of Social skill checks with certain rings (“+1” or “+2”) and a decrease to the TN of Social skill checks with other rings (“–1” or “–2”), to reflect the fact that some characters are much more resistant to particular avenues than others, and prone to certain outbursts. GMs are also encouraged to give NPCs unusual demeanors (or invent new ones, with modifiers and ways to unmask as they see fit) to keep the PCs on their toes! This character pursues power whenever possible and is extremely resistant to giving it up. However, they jump to support appeals that line up with their own desires. Social Skill Check TN Modifiers: Fire +2, Water –2 Common Way of Unmasking: Bend Principles This person is used to being in charge, and does not like being told what they can or cannot to do. They are most pliant when they think they are getting their way. Social Skill Check TN Modifiers: Earth +2, Air –2 Common Way of Unmasking: Rage This individual is extremely meditative, spiritual, enlightened, or simply uninterested in other people. Social Skill Check TN Modifiers: Earth +1, Fire +1, Void –2 Common Way of Unmasking: Expose an Opening With a rough exterior and a no-nonsense attitude, this person has little tolerance for frivolity, niceties, or trickery. A direct, honest approach works best. Social Skill Check TN Modifiers: Water +2, Earth –2 Common Way of Unmasking: Inappropriate Outburst This individual is used to maneuvering around powerful people, and tends to avoid direct conflict. They are also very wary of such efforts on the part of others. Social Skill Check TN Modifiers: Air +2, Fire –2 Common Way of Unmasking: Panicked Retreat"
        }
        ENTRY ^"building-encounters" #u4U0YsCgQY4K0GgMcsyokm {
            CONCERNS [ ^"GM Role" ]
            TOPICS [ "npc", "encounter", "gm" ]
            TEXT "The open-ended nature of character advancement in Legend of the Five Rings makes it difficult to generalize exactly how much of a challenge a given NPC will be as an opponent. A highly trained courtier might be no better at fighting than they were at the time of character creation, because they have focused on intrigue instead of martial arts. Meanwhile, with the same amount of XP, a character from the same school could have invested their experience in becoming knowledgeable, well-spoken, and skilled at arms, and have reached modest proficiency in all spheres without excelling in any. However, when assessed together, a group’s power is somewhat more predictable based on the PCs’ overall school rank. To give GMs a rough idea of an NPC’s efficacy, each sample NPC profile has a conflict rank for both combat and intrigue, to provide a rough guideline for deciding how many foes to hurl at the PCs. To estimate the Group Rank (the rough power of the PCs), take the sum of the group’s school ranks. To estimate the Encounter Rank (how challenging the NPCs in a conflict scene will be) for a scene, take the sum of the combat ⚔⚔ (for battles) or intrigue 🌲 (for social scenes) conflict ranks of all NPCs opposing the PCs. Compare the group rank to the encounter rank and consult the following: However, when assessed together, a group's power is somewhat more predictable based on the PCs' overall school rank. To give GMs a rough idea of an NPC's efficacy, each sample NPC profile has a conflict rank for both combat and intrigue, to provide a rough guideline for deciding how many foes to hurl at the PCs."
        }
        ENTRY ^"adding-npc-templates" #W44CwU8siu2aWsGSSAwM64 {
            CONCERNS [ ^"NPC Template" ]
            TOPICS [ "npc", "template", "gm" ]
            TEXT "When putting together NPCs, GMs can change, add, remove, and replace any aspects they desire, from rings and skills to demeanors and techniques. The templates in this section can help a GM quickly transform a generic profile into a more specialized character. As the GM, you can add templates to NPCs to build other types of characters your PCs might encounter. Examples include: Veteran Yōjimbō: Loyal Bushi with Investigator template, Choose Iaijutsu Cut: Crossing Blade (⚔) and Battle in the Mind (⚔). Secret Cultist: Seasoned Courtier with Sage template, choose Incite Haunting (🪶) and Sinful Whispers (🪶). Militant Monk: Loyal Bushi with Spiritualist template, choose Earth Needs No Eyes (☯) and Flame Fist (☯). Novice Geisha: Humble Peasant with Artist template, choose Fanning the Flames (🩲), Pillar of Calm (🩲), and Shallow Waters (🩲). Goblin Chieftain: Shadowlands Goblin with the Warrior template, choose Striking as Fire (⚔) and Tactical Assessment (⚔). It is an adversary. As the GM, you can always make alterations as you see fit to NPCs' attributes, equipment, and abilities."
        }
        ENTRY ^"subjects-of-rokugan" #KQSekko4CyCAkY4SAKIYOE {
            CONCERNS [ ^"NPC" ]
            TOPICS [ "npc", "commoners", "samurai" ]
            TEXT "The following profiles are intended to provide GMs with a basic set of options for the non-player characters in their Legend of the Five Rings games. The population of the Emerald Empire includes nobility and daimyō, samurai of all types, and the commoners (peasants, ashigaru, merchants, entertainers, traders, and others) who make up the majority of society. As the GM, it's your choice whether you want to make a given roll for an NPC open (in sight of the players) or closed (behind a screen or otherwise obscured). It's a good idea to make most rolls openly, because of abilities that allow PCs to alter enemy rolls, but this isn't a hard-and-fast rule. If a player wishes to use an ability that alters an enemy roll, you can perform the alteration for them on the NPC's dice pool (in an optimal manner for the player's desired outcome). If for some reason even this would give away too much information, you can give that character 1 Void point (and they do not count as having used the ability), but this is an option you probably shouldn't exercise too often. There are two broad types of commoners in Rokugan: the heimin, or “half-persons,” who make up the caste of laborers known as the bonge and do much of the fundamental labor required to allow the Empire to function; and the hinin, or so-called “nonpeople,” who perform many of the most base and demeaning jobs. Within the category of heimin, there is further stratification. In order of social importance, the first are farmers, then artisans and craftspeople, and finally merchants, who make nothing themselves and only deal in trade and commerce. Hinin include criminals, many entertainers, and those considered “untouchables” because they handle dead flesh and refuse. Hinin are considered “nonpeople” and treated as little more than property. An NPC samurai who is out and about is likely conducting business for their lord. A samurai encountered on the road might be making a routine patrol, serving as an escort for important people or cargoes, or acting as a courier. They are generally busy, and give formal but brief greetings to other samurai. If they are encountered in another location, such as an inn, shrine, or temple, however, they may be more open to interactions with the player characters. Heimin should be politely deferential toward the PCs in most encounters. However, they are vassals of a clan, so making unreasonable demands or being wantonly abusive to them will likely rouse the ire of their lord. Ashigaru will defer to the PCs, but with a degree of practiced ease that most farmers lack—they are used to encountering and dealing with samurai."
        }
        ENTRY ^"outlaws-and-ronin" #sKsmKAUAqiWE6K2uscmEaA {
            CONCERNS [ ^"NPC" ]
            TOPICS [ "npc", "outlaws", "ronin" ]
            TEXT "Like any society, Rokugan has its share of antisocial types who flout its norms and laws in pursuit of personal gain. While most of these miscreants are simply lawless individuals or members of loose gangs, some have come together in organized bands. While the involvement in such illegal undertakings is dishonorable in the extreme, samurai still can fall prey to greed as well. Beyond outlaws, there are the samurai known as rōnin, or “wave men,” as they come and go like the waves of the ocean. Rōnin are generally considered disreputable, often being treated with scorn and contempt by clan samurai. Moreover, without a lord, samurai have no access to the things a lord normally provides to vassals, such as food, equipment, and lodging. The life of a rōnin is, therefore, a hard one, as they are forced to fend for themselves as mercenaries and criminals in an Empire often hostile to them. With the permission of their daimyō, a clan samurai could undertake a musha shugyō, or “warrior’s pilgrimage.” A samurai on a musha shugyō becomes a rōnin, temporarily casting aside their loyalties and wandering the Empire to learn as much as possible while perfecting their skills as a warrior. It is essential that the erstwhile samurai make no reference to their clan during the pilgrimage. Once the requirements of the musha shugyō are fulfilled, the rōnin returns to their clan as a samurai. As the GM, there are times when it is not narratively satisfying for a villain to just die. To avoid this, you can apply a twist of fate—an unpreventable outcome that saves the NPC, but also compensates the players. First, tell the players about the twist of fate and narrate how the NPC escapes. At the end of the session, each PC receives 1 extra XP, as they come to terms with fortune's turns and grow stronger in anticipation of their eventual clash with their foe."
        }
        ENTRY ^"large-npc-groups-in-conflict" #g0AMmsw2Aesm6sw2oAua6U {
            CONCERNS [ ^"GM Role" ]
            TOPICS [ "npc", "conflict", "gm" ]
            TEXT "Having a large number of NPCs in a conflict can make it chaotic for any GM, especially if each one has an initiative value. To streamline handling a group of NPCs of the same type, treat them as a squad. A squad consists of two or more NPCs with the same name and profile, and functions as follows: Initiative: They generate a single initiative value, and take turns in any order you choose at their initiative value each round. Group Actions: If you want to reduce the number of rolls the squad makes, simply have all members of the squad but one take the Assist action targeting the one member who performs a different action. Having more than six NPCs in a squad is not advised, simply due to the size of the dice pools involved. Group Stances: All members of a squad should assume the same stance each round. Group Strife: Assign the squad a squad strife value equal to 3 times an individual member’s composure. This can be helpful as a means to determine the point at which undisciplined foes likely break and run. Generally, you’ll want to make squads of minion NPCs like ashigaru and bandits, since they’ll be the bulk of unnamed participants in a skirmish, but there’s no mechanical reason you couldn’t have a squad of adversaries—they’d just be more complex to manage and likely more dangerous to the PCs."
        }
        ENTRY ^"spirits-and-otherworldly-beings" #IagCU8ayQ6MU8as8cOa2Ma {
            CONCERNS [ ^"NPC" ]
            TOPICS [ "npc", "spirits", "shadowlands" ]
            TEXT "In a land as steeped in mysticism and the otherworldly as the Emerald Empire, it should come as no surprise that a wide range of spiritual beliefs have developed among the people. For the vast majority, spirituality revolves around the teachings of Shinsei, reverence for their honored ancestors, and the worship of the Fortunes and the Kami. There are, however, groups in Rokugan that adhere to other beliefs. Labeled “cults,” these are generally considered at best to be fringe elements, and at worst blasphemies deserving of eradication. Because they are rejected by mainstream Rokugani society, and most are considered to be in violation of Imperial laws dealing with blasphemy, cults of any type tend to be secretive in the extreme. Clandestine cultists can operate at all levels of society, however, and might be the foes of the PCs. Onnotangu, or Lord Moon, figures prominently in the prehistory of Rokugan. Because of his wrath, fear, and jealousy, the Kami were cast out of Heaven and fell into Ningen-dō at the dawn of the Empire. Twelve centuries later, there are still those in the Empire who consider Lord Moon to be the preeminent divine figure, devoting themselves to him in clandestine ceremonies. For the Moon Cultist profile, use the Wicked Mahō-tsukai but replace their mahō with these invocations (📜): By the Light of the Lord Moon, Summon Fog, Tempest of Air, and Vapor of Nightmares. Some beings are described as Otherworldly (ethereal beings beyond the ken of humans), Tainted (beings under the sway of Fu Leng), or both. These classifications do not have any intrinsic rules, but many abilities and some item qualities refer to them. From the Empire's inception, Jigoku, the Realm of Evil, has spilled forth monstrosities that seek to snuff out the works of mortals. This is because Jigoku is a jealous realm, absolutely intolerant of Ningen-dō, and particularly of the reverence mortals tend to have for Tengoku, the Celestial Heavens. When the Kami fell, one of them—Fu Leng—was pulled into Jigoku, smashing open a rift between Jigoku and the Mortal Realm in the process. Known as the Festering Pit of Fu Leng, this vile opening contaminated the lands south of the Empire, turning them into the evil region known as the Shadowlands. Dwelling on the edges of civilization or hidden in transcendental groves are many wondrous creatures and kami. Most of the time, PCs can't fight ghosts with force of arms—instead, ghosts often work best as narrative obstacles. The PCs might need to determine the cause of their unrest or their agenda and then help to resolve it or purify the spirit. If a ghost needs to make a check, they can use their profile in life, with the following alterations: They are an Otherworldly being. They have Physical Resistance 10. They are incorporeal, and can perform ghostly phenomena. At the GM's discretion, they have 1 or more Air invocations to represent their spiritual powers."
        }
        ENTRY ^"animals-as-npcs" #6cq2qamCW0o4qwEYScG2km {
            CONCERNS [ ^"NPC" ]
            TOPICS [ "npc", "animals" ]
            TEXT "Rokugan is home to a wide variety of animals, both wild and domesticated. Wild animals are often the target of Rokugani hunts, which samurai undertake for sport in some regions and for sustenance in others."
        }
        ENTRY ^"inspirational-media" #eesOsuiwW0qgY2CIsqa0uW {
            CONCERNS [ ^"System" ]
            TOPICS [ "inspiration", "media", "appendix" ]
            TEXT "The Art of War by Sun Tzu The Book of Five Rings by Musashi Miyamoto Code of the Samurai by Yuzan Daidōji Hagakure by Tsunetomo Yamamoto The Life-Giving Sword by Munenori Yagyu The Pillow Book of Sei Shōnagon The Tale of Genji by Murasaki Shikibu The Tale of the Heike, author unknown The Three Kingdoms by Guanzhong Luo The Book of Yōkai by Dylan Michael Foster Bushido: The Soul of Japan by Inazō Nitobe The Chrysanthemum and the Sword by Ruth Benedict Everyday Life in Traditional Japan by Charles J. Dunn and Laurence Broderick Japanese Tea Ceremony: Cha-No-Yu by A. L. Sadler Legends of the Samurai by Hiroaki Sato The Samurai Sword by Stephen Turnbull Samurai: The World of the Warrior by Stephen Turnbull Samurai and Ninja by Antony Cummins Shinto: The Kami Way by Sokyo Ono Tales of Old Japan by A. B. Mitford True Path of the Ninja by Antony Cummins The World of the Shining Prince by Ivan Morris The Yokai series by Matthew Meyer The Heike Story by Eiji Yoshikawa Legends of the Condor Heroes by Jin Yong Musashi by Eiji Yoshikawa The Moribito series by Nahoko Uehashi The Snow Fox by Susan Fromberg Schaeffer Taiko by Eiji Yoshikawa The Tale of Murasaki by Liza Dalby Tale of the Shikanoko quartet by Lian Hearn Tales of the Magatama series by Noriko Ogiwara Tales of the Otori series by Lian Hearn The Twelve Kingdoms series by Fuyumi Ono 13 Assassins 47 Ronin Chūshingura Crouching Tiger, Hidden Dragon Empress Ki Fūshigi Yūgi by Yuu Watase Gate of Hell The Great Wall Hero The Hidden Fortress Kagemusha Kwaidan InuYasha by Rumiko Takahashi Lone Wolf and Cub by Kazuo Koike and Goseki Kojima Marco Polo Princess Mononoke Ran Rashomon Samurai Fiction Sanjuro Seven Samurai Throne of Blood Thunderbolt Fantasy Usagi Yojimbo by Stan Sakai Yojimbo"
        }
    }
    GUIDANCE {
        ENTRY ^"sample-armies" #268W2a42UMWsWqWWSKIOCa {
            CONCERNS [ ^"Mass Battle" ]
            TOPICS [ "mass battle", "armies", "gm" ]
            TEXT "The sample armies provided here are for entire armies, not single cohorts, which do not have individualized profiles. In most mass battles, there are only two armies. GMs are encouraged to adjust the strength, discipline, and abilities of these armies to reflect the circumstances of the story, or to build new armies of their own using these as models. Farmers and townsfolk generally want to live their lives in tranquility, with minimal interference from their overlords and peace across the lands. After all, war is a scourge most of all upon the common people, even if they are never drawn directly into the fighting. Taxes rise, resources are drained, and vital goods become scarce. Crops are destroyed or confiscated, and starvation spreads. Banditry flourishes as order collapses. In such circumstances, even untrained citizens often find the resolve to fight. At other times, soldiers sweep in to conscript anyone able to hold a spear. Conscripted (Army Ability): Each leader in this army increases the TN of their Attack actions by 1. The solid core of most fighting forces in the Emerald Empire, ashigaru are career soldiers. Though they are not of the samurai class and lack the elite training and equipment that birth into the warrior caste entails, many are veteran campaigners with more practical battlefield experience than the majority of Rokugani samurai. Rank Formation (Army Ability): When a leader in this army performs the Reinforce action, they may spend (Opportunity) as follows: (Opportunity)+: After an enemy cohort attacks this leader’s cohort, the enemy army suffers attrition equal to (Opportunity) spent this way. Goblins, oni, undead monstrosities, and other horrors rarely march to war in anything resembling an organized fashion. On the rare occasions they are rallied by a dread leader strong and cunning enough to control them, they are a truly horrifying foe to behold. Relentless (Army Ability): The creatures of the Shadowlands live for battle, and their rage does not gutter out so easily as that of human soldiers. This army does not suffer the effects of battle fatigue. Monstrous Enemies (Army Ability): At the end of each round, each opposing army suffers panic equal to this army’s leader’s ranks in Command. Wake of the Shadowlands (Army Ability): After a mass battle against this army, the battlefield becomes Defiled terrain (see Terrain, on page 267)."
        }
        ENTRY ^"supernatural-playstyle" #qKm0kCAEuSEKYe22M2gGg4 {
            CONCERNS [ ^"GM Role" ]
            TOPICS [ "gm", "playstyle", "supernatural" ]
            TEXT "Rokugan is a land where supernatural powers run rampant and, sometimes, provincial intrigues are truly not the greatest threat in a story. GMs and players who wish to explore stories about champions banding together to save cities, provinces, or even the world itself can certainly do so in the Emerald Empire, as the setting is rich with cosmological threats. This playstyle assumes that the player characters are samurai who are tasked with dealing with a suitably epic problem—or series of problems—that threaten multiple clans, and perhaps even the Empire itself. Dangers such as massive Shadowlands armies, bloodspeaker sects, lunar cultists, and other, more insidious threats create story opportunities for characters to undertake epic quests to protect their homes and loved ones. This playstyle mirrors more “classic” fantasy adventures of great deeds, mighty heroes, and dire foes to be vanquished. There are numerous locations in Rokugan where this sort of campaign fits most naturally. The Shadowlands encompass a vast realm surrounding the Festering Pit of Fu Leng, and this region is the grave to countless heroes. The Shinomen Forest is an untamed wildland within the Empire itself, to which no clan lays claim and in which primal beings still stir. Even within smaller patches of wilds, there are strange and dangerous beings. Not all spirits are friendly to humans, and some see the expansion of towns into the wild lands as an affront to nature. The PCs might need to find compromise between ancient forces and humanity so that both can survive and thrive."
        }
        ENTRY ^"nemuranai" #SMwyEmImaAK0SoKIkw4QMm {
            CONCERNS [ ^"Item" ]
            TOPICS [ "items", "nemuranai", "artifacts" ]
            TEXT "Nemuranai, meaning “unsleeping” in reference to the object’s kami, are miraculous artifacts of spiritual power. They are items that, through centuries of use, miraculous origins, or other incredible events, have attained power and even a degree of awareness. While they can appear in any campaign, they are usually vanishingly rare, accessible to PCs only under exceptional circumstances. In this campaign style, however, each PC chooses one nemuranai with an appropriate sealed invocation of their choice that they possess as their quest begins. They must also determine how the item relates to their quest: After being used to bring justice to count-less mahō-tsukai, Shiba Seinaru's blade awak-ened to its purpose of cleansing evil and bringing light to the darkness. At the end of a crisis, it vanished—along with its owner. Keiji is a katana with the The Fires from Within invocation. Quirk: Tasked to slay mahō-tsukai, the blade ignites and flickers with orange flames when-ever the evil magic of these wicked sorcerers stirs nearby. Said to have been one of the wonders woven by the legendary Asahi-na Setsuna and given to a lover in hostile lands so they might visit when they pleased, this item lay forgotten in a Lion Clan storehouse for generations before being rediscovered. Harukaze is a set of traveling clothes with the Cloak of Night invocation. Quirk: The pattern on Harukaze shifts with its surroundings, subtly mirroring the fashions and colors of the clothes around it."
        }
    }
}
