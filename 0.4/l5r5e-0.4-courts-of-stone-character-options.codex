# .codex SECTION — Courts of Stone: New Character Options. Stand-off graph over
# l5r5e-0.4-courts-of-stone-character-options.lore (spec §25). Part of the L5R5e
# system graph; DEPENDS_ON the shared schema.
#
# This chapter is almost entirely MECHANICAL — new advantages/disadvantages,
# court and shinobi gear, shinobi weapons/armor, and new techniques (kata,
# ninjutsu, shūji). Those are DEFs, not lore entities, and are not reproduced.
# What IS captured: the illustrative vignette characters used to flavor those
# rules. They are scattered through the mechanical examples with no clean section
# of their own, so each is bound at file level (SOURCE with no AT).

CODEX "L5R5e_CoS_CharOptions_Codex" {
    NAME "Courts of Stone: New Character Options — Lore Graph"
    VERSION "0.1"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-09-02"
    FOR EDITION "l5r5e"
    DEPENDS_ON "L5R5e_Codex_Schema" VERSION "0.9"

    ENTITY #L5RcxCoSchr01kasumi ^"Shika Kasumi" {
        IS ^"Person"
        SOURCE "l5r5e-0.4-courts-of-stone-character-options.lore"
        RELATIONSHIPS {
            ^"member-of" -> ^"Deer Clan" FROM "Shika Kasumi sputtered, a deep blush on her cheeks"
        }
    }
    ENTITY #L5RcxCoSchr02nanako ^"Akodo Nanako" {
        IS ^"Person"
        SOURCE "l5r5e-0.4-courts-of-stone-character-options.lore"
        RELATIONSHIPS {
            ^"member-of" -> ^"Lion Clan" FROM "\"Calm yourself, Deer,\" Akodo Nanako said with a smile"
        }
    }
    ENTITY #L5RcxCoSchr03yori ^"Daidoji Yori" {
        IS ^"Person"
        SOURCE "l5r5e-0.4-courts-of-stone-character-options.lore"
        RELATIONSHIPS {
            ^"member-of" -> ^"Crane Clan" FROM "\"I can arrange that,\" Daidoji Yori calmly replied"
        }
    }
    ENTITY #L5RcxCoSchr04noa ^"Doji Noa" {
        IS ^"Person"
        SOURCE "l5r5e-0.4-courts-of-stone-character-options.lore"
        RELATIONSHIPS {
            ^"member-of" -> ^"Crane Clan" FROM "Shocked, Doji Noa asked, \"Really?\""
        }
    }
    ENTITY #L5RcxCoSchr05masaru ^"Yasuki Masaru" {
        IS ^"Person"
        SOURCE "l5r5e-0.4-courts-of-stone-character-options.lore"
        RELATIONSHIPS {
            ^"member-of" -> ^"Crab Clan" FROM "Yasuki Masaru explained, gesturing"
        }
    }
    ENTITY #L5RcxCoSchr06kotone ^"Hida Kotone" {
        IS ^"Person"
        SOURCE "l5r5e-0.4-courts-of-stone-character-options.lore"
        RELATIONSHIPS {
            ^"member-of" -> ^"Crab Clan" FROM "\"What?\" Hida Kotone grunted"
        }
    }
    ENTITY #L5RcxCoSchr07rikuto ^"Ikoma Rikuto" {
        IS ^"Person"
        SOURCE "l5r5e-0.4-courts-of-stone-character-options.lore"
        RELATIONSHIPS {
            ^"member-of" -> ^"Lion Clan" FROM "\"I am Ikoma Rikuto, the greatest singer you have never heard!\""
        }
    }
    ENTITY #L5RcxCoSchr08eiko ^"Doji Eiko" {
        IS ^"Person"
        SOURCE "l5r5e-0.4-courts-of-stone-character-options.lore"
        RELATIONSHIPS {
            ^"member-of" -> ^"Crane Clan" FROM "Doji Eiko stared at the young poet"
        }
    }
    ENTITY #L5RcxCoSchr09kei ^"Kei" {
        IS ^"Person"
        SOURCE "l5r5e-0.4-courts-of-stone-character-options.lore"
    }
    ENTITY #L5RcxCoSchr10hisa ^"Kakita Hisa" {
        IS ^"Person"
        SOURCE "l5r5e-0.4-courts-of-stone-character-options.lore"
        RELATIONSHIPS {
            ^"member-of" -> ^"Crane Clan" FROM "Kakita Hisa walked quietly into the courtyard"
        }
    }
    ENTITY #L5RcxCoSchr11kado ^"Shika Kado" {
        IS ^"Person"
        SOURCE "l5r5e-0.4-courts-of-stone-character-options.lore"
        RELATIONSHIPS {
            ^"member-of" -> ^"Deer Clan" FROM "Shika Kado felt his breath hitch in his throat"
        }
    }
    ENTITY #L5RcxCoSchr12hoshi ^"Akodo Hoshi" {
        IS ^"Person"
        SOURCE "l5r5e-0.4-courts-of-stone-character-options.lore"
        RELATIONSHIPS {
            ^"member-of" -> ^"Lion Clan" FROM "To his left was Akodo Hoshi, the man Kado had told to mistrust the Matsu family"
        }
    }
    ENTITY #L5RcxCoSchr13kagami ^"Matsu Kagami" {
        IS ^"Person"
        SOURCE "l5r5e-0.4-courts-of-stone-character-options.lore"
        RELATIONSHIPS {
