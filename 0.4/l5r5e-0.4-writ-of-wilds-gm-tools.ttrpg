            ^"Combat Conflict Rank" INTEGER 5
            ^"Intrigue Conflict Rank" INTEGER 2
            ^"Rings" DEF {
                ^"Air" INTEGER 4
                ^"Earth" INTEGER 5
                ^"Fire" INTEGER 2
                ^"Water" INTEGER 2
