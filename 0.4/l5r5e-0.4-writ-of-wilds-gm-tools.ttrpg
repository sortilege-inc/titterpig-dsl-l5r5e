            ^"Honor" INTEGER 55
            ^"Glory" INTEGER 62
            ^"Status" INTEGER 47
            ^"Skills" LIST OF STRING ["Artisan 0", "Martial 3", "Scholar 4", "Social 4", "Trade 2"]
