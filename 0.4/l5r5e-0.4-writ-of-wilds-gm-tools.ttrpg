            ^"Endurance" INTEGER 14
            ^"Composure" INTEGER 14
            ^"Focus" INTEGER 6
            ^"Vigilance" INTEGER 3
            ^"Honor" INTEGER 25
            ^"Glory" INTEGER 21
            ^"Status" INTEGER 23
            ^"Skills" LIST OF STRING ["Artisan 0", "Martial 3", "Scholar 3", "Social 3", "Trade 4"]
            ^"Advantages" LIST OF STRING ["Observant (Water) [Social, Martial; Interpersonal, Mental]"]
            ^"Disadvantages" LIST OF STRING ["Mahō-Touched (Earth) [Scholar, Social; Interpersonal, Mental]", "Fugitive (Void) [Social; Interpersonal, Mental]"]
            ^"Favored Weapons" LIST OF STRING ["Bo (staff): Range 1-2, Damage 6, Deadliness 2, Mundane"]
            ^"Gear" LIST OF STRING ["Simple robes (Physical 1, Mundane)", "Religious texts", "Tattoo ink and needles"]
        }

        ^"Forbidden Outburst" DEF {
            ^"Description" STRING "When Gen'ichiro's strife exceeds composure, every character at range 0-2 must make TN 4 Theology (Earth 3, Void 3) check. Success: receive 2 strife. Failure: receive 4 strife and 2 supernatural damage, become cursed (increase TN of Social and Scholar checks by 2) until end of scene."
        }

        RULES {
            #L5RWW78oP8qR0sT2uV4wX6yZ: genichiro_maho_outcast
