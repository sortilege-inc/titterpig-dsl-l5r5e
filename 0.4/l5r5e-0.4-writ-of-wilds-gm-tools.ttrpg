    # source stat block (page 76)
    ^"Togashi Koma, Militant Adept" DEF {
        EXTENDS ^"NPC"

        # Militant adept of the Furthest Fortress. An imposing
        # monk whose combat abilities border on the supernatural
        # due to Blood of the Kami.

        PROPERTIES {
            ^"Type" STRING "Adversary" FIXED
            ^"Combat Conflict Rank" INTEGER 6
            ^"Intrigue Conflict Rank" INTEGER 4
            ^"Rings" DEF {
                ^"Air" INTEGER 2
                ^"Earth" INTEGER 3
                ^"Fire" INTEGER 4
                ^"Water" INTEGER 4
                ^"Void" INTEGER 3
            }
            ^"Demeanor" STRING "Imposing"
            ^"Social Skill Check TN Modifiers" STRING "Fire +2, Void -2"
            ^"Endurance" INTEGER 14
            ^"Composure" INTEGER 14
            ^"Focus" INTEGER 6
            ^"Vigilance" INTEGER 3
            ^"Honor" INTEGER 55
            ^"Glory" INTEGER 42
            ^"Status" INTEGER 33
            ^"Skills" LIST OF STRING ["Artisan 0", "Martial 4", "Scholar 2", "Social 3", "Trade 0"]
            ^"Advantages" LIST OF STRING ["Martial Excellence (Fire) [Martial; Mental]"]
            ^"Disadvantages" LIST OF STRING ["Uncompromising (Water) [Social; Mental]"]
            ^"Favored Weapons" LIST OF STRING ["Punch: Range 0, Damage 1, Deadliness 2, Snaring", "Kick: Range 1, Damage 2, Deadliness 1", "Nunchaku: Range 0-1, Damage 4, Deadliness 2, 2-hand: Snaring"]
            ^"Gear" LIST OF STRING ["Traveling Clothes (Physical 2, Durable, Mundane, Subtle)", "Travel rations", "Memory bracelet made of twine"]
        }

        ^"Blood of the Kami (Koma)" DEF {
            ^"Description" STRING "When Koma successfully uses a kihō, they are considered to have three bonus successes."
        }

        ^"Harnessing Ki" DEF {
            ^"Description" STRING "Knows the following kihō: Earthen Fist, Air Fist, Flame Fist, Water Fist (each linked to an appropriate tattoo)."
        }

        ^"Martial Acumen" DEF {
            ^"Description" STRING "When making Strike action with nunchaku, may also attack with Kick or Punch."
        }

        RULES {
            #L5RWW73gH3iJ5kL7mN9oP1qR: koma_militant_adept
            #L5RWW74sT4uV6wX8yZ0aB2cD: koma_adventure_dark_dreams
