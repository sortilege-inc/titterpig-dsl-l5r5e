EXTENSION "L5R5e_Writ_of_Wilds_GM_Tools" EXTENDS "L5R5e_Writ_of_Wilds" {
    NAME "Legend of the Five Rings 5th Edition - Writ of the Wilds: GM Tools"
    VERSION "0.4.1"
    SPEC_VERSION "0.4.1"
    RELEASE_DATE "2026-03-01"

    # Writ of the Wilds (Chapters 1-3): NPCs/Adversaries, new titles,
    # new conditions (illnesses), new terrain qualities (imbalanced variants),
    # adventure seeds, elemental imbalance mechanics, destiny rules.

    # ===========================
    # NPCs / ADVERSARIES
    # ===========================

    # source stat block (page 55)
    ^"Togashi Remmu, Sociable Wanderer" DEF {
        EXTENDS ^"NPC"

        # An atypical ise zumi who happily travels the Empire
        # after a day and night in discussion with Togashi Yokuni.
        # Senses they will be called upon for some great task.

        PROPERTIES {
            ^"Type" STRING "Adversary" FIXED
            ^"Combat Conflict Rank" INTEGER 4
            ^"Intrigue Conflict Rank" INTEGER 4
            ^"Rings" DEF {
                ^"Air" INTEGER 3
                ^"Earth" INTEGER 3
                ^"Fire" INTEGER 3
                ^"Water" INTEGER 4
                ^"Void" INTEGER 4
            }
            ^"Demeanor" STRING "Outgoing"
            ^"Social Skill Check TN Modifiers" STRING "Water +2, Earth -2"
            ^"Endurance" INTEGER 12
            ^"Composure" INTEGER 14
            ^"Focus" INTEGER 6
            ^"Vigilance" INTEGER 4
            ^"Honor" INTEGER 60
            ^"Glory" INTEGER 72
            ^"Status" INTEGER 35
            ^"Skills" LIST OF STRING ["Artisan 2", "Martial 3", "Scholar 3", "Social 3", "Trade 1"]
            ^"Advantages" LIST OF STRING ["Higher Purpose (Air) [Scholar; Mental]"]
            ^"Disadvantages" LIST OF STRING ["Conciliatory (Fire) [Social; Mental]"]
            ^"Favored Weapons" LIST OF STRING ["Bo (staff): Range 1-2, Damage 6, Deadliness 2, Mundane"]
            ^"Gear" LIST OF STRING ["Traveling Clothes (Physical 2, Durable, Mundane, Subtle)", "Wicker satchel", "Journal of personal poetry"]
        }

        ^"Blood of the Kami (Remmu)" DEF {
            ^"Description" STRING "When Remmu successfully uses a kihō, they are considered to have three bonus successes for the purposes of resolving the effects of that kihō."
        }

        ^"Drawing From Within" DEF {
            ^"Description" STRING "Choose four kihō from those listed beginning on page 182 of the Core Rulebook, which Remmu can use. Each is linked to an appropriate tattoo, so they benefit from Blood of the Kami."
        }

        RULES {
            #L5RWW64cD4eF6gH8iJ0kL2mN: remmu_sociable_wanderer
        }
    }

    # source stat block (page 58)
    ^"Mirumoto Kichiru, Thwarted Duelist" DEF {
        EXTENDS ^"NPC"

        # Supreme niten duelist who has bested every opponent
        # except the Kakita. Suspects collusion between Dragon
        # and Crane to prevent the ultimate duel.

        PROPERTIES {
            ^"Type" STRING "Adversary" FIXED
            ^"Combat Conflict Rank" INTEGER 5
            ^"Intrigue Conflict Rank" INTEGER 3
            ^"Rings" DEF {
                ^"Air" INTEGER 3
                ^"Earth" INTEGER 4
                ^"Fire" INTEGER 5
                ^"Water" INTEGER 4
                ^"Void" INTEGER 2
            }
            ^"Demeanor" STRING "Calculating"
            ^"Social Skill Check TN Modifiers" STRING "Water +2, Fire -2"
            ^"Endurance" INTEGER 18
            ^"Composure" INTEGER 16
            ^"Focus" INTEGER 8
            ^"Vigilance" INTEGER 4
            ^"Honor" INTEGER 45
            ^"Glory" INTEGER 80
            ^"Status" INTEGER 39
            ^"Skills" LIST OF STRING ["Artisan 0", "Martial 4", "Scholar 2", "Social 3", "Trade 0"]
            ^"Advantages" LIST OF STRING ["Duelist's Instincts (Void) [Martial; Mental]"]
            ^"Disadvantages" LIST OF STRING ["Arrogance (Water) [Social; Mental]"]
            ^"Favored Weapons" LIST OF STRING ["Katana: Range 1, Damage 4, Deadliness 5/7, Ceremonial, Razor-Edged", "Wakizashi: Range 0-1, Damage 3, Deadliness 5/7, Ceremonial, Razor-Edged"]
            ^"Gear" LIST OF STRING ["Lacquered Armor (Physical 4, Ceremonial, Cumbersome, Wargear)", "Fine kimono (Physical 1, Ceremonial, Resplendent)"]
        }

        ^"Two Heavens Style" DEF {
            ^"Description" STRING "Once per round, when performing an Attack action, Kichiru may spend (op) as follows: (op): Perform a Strike Action with a readied weapon she has not used for an Attack action this turn."
        }

        RULES {
            #L5RWW65oP5qR7sT9uV1wX3yZ: kichiru_thwarted_duelist
            #L5RWW66aB6cD8eF0gH2iJ4kL: kichiru_adventure_forbidden_duel
        }
    }

