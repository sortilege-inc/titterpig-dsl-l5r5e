    # ===========================
    # ELEMENTAL IMBALANCE MECHANICS
    # ===========================

    ^"Elemental Imbalance Rules" DEF {
        APPLIES TO [^"Mechanic"]

        # Uncertainty: At start of each scene in an imbalanced
        # area, all NPCs experience strife based on severity:
        # Minor: 2 strife, Moderate: 3, Major: 4, Catastrophic: 5.
        # Scarcity: TN of checks to acquire goods increases:
        # Minor: +1, Moderate: +2, Major: +3, Catastrophic: unavailable.
        # Identifying: Accrue momentum points (1 per success,
        # +1 per 2 bonus successes). 5-10 points to identify root.
        # Solving: Intrigue with spirits; Calm a Spirit social
        # objective (difficulty 10, base TN 4 Persuade, TN 2 if
        # using Theology). If all spirits calmed, imbalance ceases.

        RULES {
            #L5RWW94yZ4aB6cD8eF0gH2iJ: elemental_imbalance_uncertainty_scarcity
            #L5RWW95kL5mN7oP9qR1sT3uV: elemental_imbalance_identification
            #L5RWW96wX6yZ8aB0cD2eF4gH: elemental_imbalance_resolution
        }
    }

    # ===========================
    # DESTINY RULES
    # ===========================

    # source stat block (page 137)
    ^"Destiny (Alternative to Giri)" DEF {
        APPLIES TO [^"Mechanic"]

        # For characters who do not fit the typical giri/duty
        # dynamic: monks who remember past lives, tengu who
        # live centuries, nezumi who live a fleeting few years.
        # Destiny represents a character's place in the cosmos.
        # It is discovered within, not placed by a lord. A destiny
        # remains whether a character would prefer it or not.
        # It can be ignored but never abandoned.
        # Resolving destiny retires the character from play.
        # Destiny and ninjō should be made to clash.

        RULES {
            #L5RWW97iJ7kL9mN1oP3qR5sT: destiny_alternative_to_giri
            #L5RWW98uV8wX0yZ2aB4cD6eF: destiny_resolution_retires_character
        }
    }

    # ===========================
    # SINCERITY BUSHIDO RULES
    # ===========================

    # source stat block (page 144)
    ^"Bushido Sincerity Guidance" DEF {
        APPLIES TO [^"Mechanic"]

        # Optional trifling breaches and small sacrifices for
        # Sincerity tenet. Trifling Breach (forfeit 1 honor):
        # propagating false rumors, impersonating lower status,
        # remaining silent while someone makes false statements.
        # Small Sacrifice (gain 1 honor): getting equal/higher
        # status to accept constructive criticism, correcting
        # faulty statement without impugning sincerity, claiming
        # responsibility for subordinate's failing (forfeit 1+ glory).

        RULES {
            #L5RWW99gH9iJ1kL3mN5oP7qR: sincerity_trifling_breaches_sacrifices
        }
    }
}
