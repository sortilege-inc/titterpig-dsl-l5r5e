    # ===========================
    # NEW TITLES
    # ===========================

    # source stat block (page 142)
    ^"Awakened Soul" DEF {
        APPLIES TO [^"Title"]

        # Some people can connect with past lives as an
        # extension of their own being. The Togashi Tattooed
        # Order is one organization dedicated to such beings.

        PROPERTIES {
            ^"Assigned By" STRING "The GM. Only available if narratively appropriate."
            ^"Status Award" STRING "+0"
            ^"XP to Completion" INTEGER DEFAULT 44
            ^"Title Ability" STRING "Wisdom of Countless Lifetimes"
        }

        ^"Wisdom of Countless Lifetimes" DEF {
            ^"Description" STRING "When making a skill check, you may spend 1 Void point to treat your skill rank as 1 higher, to a maximum of 6. If you fail the check, gain 1 Void point."
        }

        CURRICULUM {
            #UCVvItoSJegiHlJMnwjlX8 ^"Title Curriculum" DEF {
                "Social" SKILL_GROUP
                "Scholar" SKILL_GROUP
                "Culture" SKILL
                "Meditation" SKILL
                "Survival" SKILL
                "Theology" SKILL
                "Eternal Mind's Gate (kiho)" TECHNIQUE
                "Trance of Lives Past (ritual)" TECHNIQUE
            }
        }

        RULES {
            #L5RWW80mN0oP2qR4sT6uV8wX: awakened_soul_past_lives_title
        }
    }

    # source stat block (page 142)
    ^"Forester" DEF {
        APPLIES TO [^"Title"]

        # Sanctioned foresters carefully maintain the natural
        # order of forests, marking trees that are not home to
        # spirits and planting two trees for every one cut.

        PROPERTIES {
            ^"Assigned By" STRING "A daimyo or another sanctioned forester."
            ^"Status Award" STRING "+5 (to a minimum of 20)"
            ^"XP to Completion" INTEGER DEFAULT 24
            ^"Title Ability" STRING "Blessing of the Trees"
        }

        ^"Blessing of the Trees" DEF {
            ^"Description" STRING "Once per scene when interacting with positive intentions towards a kami or other nature spirit, you may turn one kept die to the (ex) symbol."
        }

        CURRICULUM {
            #nXJ2PZeI0jyHSasDGh0GQq ^"Title Curriculum" DEF {
                "Social" SKILL_GROUP
                "Scholar" SKILL_GROUP
                "Courtesy" SKILL
                "Sentiment" SKILL
                "Survival" SKILL
                "Theology" SKILL
                "Rank 1-2 Earth and Water Invocations (invocation)" TECH_GROUP
                "Rank 1-3 Shūji (shuji)" TECH_GROUP
            }
        }

        RULES {
            #L5RWW81yZ1aB3cD5eF7gH9iJ: forester_nature_steward_title
        }
    }

    # source stat block (page 143)
    ^"Temple Abbot" DEF {
        APPLIES TO [^"Title"]

        # Those who preside over a monastery, revered as wise
        # and deeply committed to their faith and traditions.

        PROPERTIES {
            ^"Assigned By" STRING "A monastic order or by an abbot who is passing down the responsibility."
            ^"Status Award" STRING "+10 (to a minimum of 30)"
            ^"XP to Completion" INTEGER DEFAULT 36
            ^"Title Ability" STRING "Soothing Cadence"
        }

        ^"Soothing Cadence" DEF {
            ^"Description" STRING "When making a skill check to communicate with a group of three or more people, you may keep up to one extra die. If your check succeeds, each other character in the scene removes strife equal to your bonus successes."
        }

        CURRICULUM {
            #JW8WBKzYIBBHR9F8DVwypl ^"Title Curriculum" DEF {
                "Social" SKILL_GROUP
                "Scholar" SKILL_GROUP
                "Culture" SKILL
                "Meditation" SKILL
                "Theology" SKILL
                "Cleansing Rite (ritual)" TECHNIQUE
                "Rejuvenating Breath (kiho)" TECHNIQUE
                "Touchstone of Courage (shuji)" TECHNIQUE
            }
        }

        RULES {
            #L5RWW82kL2mN4oP6qR8sT0uV: temple_abbot_monastic_leader
        }
    }

    # source stat block (page 143)
    ^"Yokai Hunter" DEF {
        APPLIES TO [^"Title"]

        # Monks who shed the tradition of pacifism and seek out
        # malevolent or hazardous yokai and other supernatural
        # entities to eliminate or free them.

        PROPERTIES {
            ^"Assigned By" STRING "By another Yokai Hunter."
            ^"Status Award" STRING "+5"
            ^"XP to Completion" INTEGER DEFAULT 36
            ^"Title Ability" STRING "Commune with the Changed"
        }

        ^"Commune with the Changed" DEF {
            ^"Description" STRING "Once per scene, make TN 3 Sentiment or Survival (Water 2) check to peer into the soul of a yokai you can perceive. If you succeed, identify two of: - The yokai's greatest current need - One of the yokai's weaknesses - The yokai's greatest strength - Whether the yokai is alone or in a group - Whether the yokai could be parlayed with Additionally, TN of checks to interact with yokai socially are reduced by 1 (minimum 1)."
        }

        CURRICULUM {
            #fi3bXW2JH4BoxnzFt3lJZK ^"Title Curriculum" DEF {
                "Scholar" SKILL_GROUP
                "Martial" SKILL_GROUP
                "Command" SKILL
                "Courtesy" SKILL
                "Survival" SKILL
                "Blistering Retribution (kiho)" TECHNIQUE
                "Swallow's Dart Style (kata)" TECHNIQUE
                "Tiger's Lunge Style (kata)" TECHNIQUE
            }
        }

        RULES {
            #L5RWW83wX3yZ5aB7cD9eF1gH: yokai_hunter_supernatural_tracker
        }
    }

    # ===========================
    # NEW CONDITIONS (ILLNESSES)
    # ===========================

    # source stat block (page 140)
    ^"Illness: Oozing Sore Disease" DEF {
        APPLIES TO [^"Condition"]

        # A disease causing fever, intense vomiting, then painful
        # oozing sores that scab and leave horrible scars.
        # Children are much more susceptible.

        PROPERTIES {
            ^"Effects" STRING "Maximum Endurance reduced by half. If character touches another person, that person must make TN 4 Fitness (Earth) check or contract the disease (symptoms appear after 10 days)."
            ^"Removed When" STRING "Roll d10; disease runs its course after 10 + die result days from symptom onset with rest. Each Martial check adds one day. Once per day, Medicine or Theology (Earth 3, Fire 2) TN 4 check reduces recovery by 1 day (minimum 10 total days)."
        }

        RULES {
            #L5RWW84iJ4kL6mN8oP0qR2sT: oozing_sore_disease
        }
    }

    # source stat block (page 141)
    ^"Illness: Gut Sickness" DEF {
        APPLIES TO [^"Condition"]

        # Illness characterized by stomach pain, frequent need
        # to defecate, blood in feces, dehydration, and tiredness.
        # Contracted from impure food or drink.

        PROPERTIES {
            ^"Effects" STRING "When character fails a check during a scene, must make TN 3 Fitness check (Earth 2). If failed, overcome with abdominal pain for rest of scene; TNs of all subsequent Social and Scholar checks increased by 1."
            ^"Removed When" STRING "Naturally resolves after one week. Once per day Medicine or Theology (Water 2) TN 3 check reduces recovery days by bonus successes (minimum one day)."
        }

        RULES {
            #L5RWW85uV5wX7yZ9aB1cD3eF: gut_sickness
        }
    }

    # source stat block (page 141)
    ^"Illness: Coughing Illness" DEF {
        APPLIES TO [^"Condition"]

        # Illness characterized by chest pain and intense fits
        # of bloody coughing. Contracted through contact with
        # bodily fluids of infected individuals.

        PROPERTIES {
            ^"Effects" STRING "Character gains Damaged Heart or Organ adversity for lungs (core rulebook page 119) until healed."
            ^"Removed When" STRING "Once per day Medicine or Theology (Water 3, Void 3) TN 4 check. If check succeeds three days in a row, character recovers. If check fails three days in a row, loses Damaged Heart or Organ and gains Incurable Illness adversity instead."
        }

        RULES {
            #L5RWW86gH6iJ8kL0mN2oP4qR: coughing_illness
        }
    }

    # source stat block (page 141)
    ^"Illness: Unsteady Illness" DEF {
        APPLIES TO [^"Condition"]

        # Illness causing unsteadiness, confusion, speech
        # difficulties, pain, muscle stiffness, blurry vision,
        # and inhibited reflexes. Caused by nutritional deficiency.

        PROPERTIES {
            ^"Effects" STRING "At start of each day, roll d10: 1-2 Social skills, 3-4 Martial skills, 5-6 Scholar skills, 7-8 Artisan skills, 9 Trade skills TN increased by 2 until 6+ hours rest. On 10, character becomes Disoriented at start of each scene until 6+ hours rest."
            ^"Removed When" STRING "TN 5 Medicine or Theology check. If succeed, realize character needs three days of rest and good varied meals. After three days of rest and good food, illness is removed."
        }

        RULES {
            #L5RWW87sT7uV9wX1yZ3aB5cD: unsteady_illness
        }
    }

    # source stat block (page 141)
    ^"Illness: Fire Rash" DEF {
        APPLIES TO [^"Condition"]

        # Illness beginning with fever, coughing, head fullness,
        # red eyes, then angry red itchy rash covering entire body.
        # Spreads quickly through physical contact.

        PROPERTIES {
            ^"Effects" STRING "Contact requires TN 4 Fitness check (Earth 3) or contract illness. Glory temporarily decreased by 10 (minimum 10). Character gains Discomfiting Countenance disadvantage for duration."
            ^"Removed When" STRING "Naturally removed after 10 days. Recovery expedited with TN 4 Medicine or Theology check; on success, recover in 8 days instead."
        }

        RULES {
            #L5RWW88eF8gH0iJ2kL4mN6oP: fire_rash
        }
    }

