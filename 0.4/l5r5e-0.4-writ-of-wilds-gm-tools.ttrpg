        }

        ^"Moroko's Blessing" DEF {
            ^"Description" STRING "As Support action, make TN 3 Courtesy (Water) check targeting any number of characters. If successful, each target removes up to 3 fatigue plus bonus successes, and gains Thoughtful Arbiter distinction until end of scene."
        }

