# ============================================================================
# .codex PARENT — the single L5R5e system lore knowledge graph (spec §25).
#
# One derived graph for the WHOLE edition. It is stand-off over the .lore prose
# (SOURCE "<file>" AT "<heading-slug>") and never edits it. Physically it is
# SPLIT into lightweight section files (l5r5e-0.4-codex-<book>[-<section>].codex),
# each its own CODEX block that DEPENDS_ON the shared schema; together with this
# parent they form one logical graph over a single entity namespace. Entities are
# first-class caret targets, so any section resolves ^"Name" to any other; and a
# later-loaded section may RE-STATE an ENTITY #hash to ADD sources/relationships
# to it (the §13 amend-by-load-order mechanism) — multiple books contributing to
# the same entry is expected and correct.
#
# The header SOURCES block records which prose files, at which versions, this
# graph is derived from — grown per section as each book is folded in, in build
# order (core first, errata last). COMPLETE — the entire L5R5e lore corpus is
# folded: Emerald Empire, Courts of Stone, Shadowlands, Fields of Victory,
# Legacies of War, the standalone Mantis Clan essay, Celestial Realms, Path of
# Waves, Writ of the Wilds, Children of the Five Winds, and the Errata & FAQ
# (Kisshōten). Purely mechanical .lore files (ronin/player-options/campaigns in
# Path of Waves; gifts-of-the-world in Children of the Five Winds) carry no
# lore-native named entities and are recorded as reviewed in the SOURCES notes.
# ============================================================================

CODEX "L5R5e_Codex" {
    NAME "Legend of the Five Rings 5e — System Lore Knowledge Graph"
    VERSION "0.1"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-09-02"
    FOR EDITION "l5r5e"
    DEPENDS_ON "L5R5e_Codex_Schema" VERSION "0.9"   # shared CATEGORIES + RELATIONS

    SOURCES {
        # Emerald Empire
        "l5r5e-0.4-emerald-empire-introduction.lore" VERSION "0.4"
        "l5r5e-0.4-emerald-empire-history.lore"      VERSION "0.4.1"
        "l5r5e-0.4-emerald-empire-heart.lore"        VERSION "0.4"
        "l5r5e-0.4-emerald-empire-governance.lore"   VERSION "0.4.1"
        "l5r5e-0.4-emerald-empire-trade.lore"        VERSION "0.4"
        "l5r5e-0.4-emerald-empire-religion.lore"     VERSION "0.4.1"
        "l5r5e-0.4-emerald-empire-enlightenment.lore" VERSION "0.4"
        "l5r5e-0.4-emerald-empire-wilds.lore"        VERSION "0.4.1"
        "l5r5e-0.4-emerald-empire-new-player-options.lore" VERSION "0.4"
        # Courts of Stone
        "l5r5e-0.4-courts-of-stone-crane-clan.lore"  VERSION "0.4.1"
        "l5r5e-0.4-courts-of-stone-castles.lore"     VERSION "0.4"
        "l5r5e-0.4-courts-of-stone-deer-clan.lore"   VERSION "0.4.1"
        "l5r5e-0.4-courts-of-stone-courts.lore"      VERSION "0.4"
        "l5r5e-0.4-courts-of-stone-character-options.lore" VERSION "0.4"
        # Shadowlands
        "l5r5e-0.4-shadowlands-introduction.lore"        VERSION "0.4.1"
        "l5r5e-0.4-shadowlands-crab-clan.lore"           VERSION "0.4.1"
        "l5r5e-0.4-shadowlands-falcon-clan.lore"         VERSION "0.4.1"
        "l5r5e-0.4-shadowlands-geography.lore"           VERSION "0.4.1"
        "l5r5e-0.4-shadowlands-nezumi.lore"              VERSION "0.4.1"
        "l5r5e-0.4-shadowlands-the-wall.lore"            VERSION "0.4.1"
        "l5r5e-0.4-shadowlands-honor-against-demons.lore" VERSION "0.4"
        "l5r5e-0.4-shadowlands-out-of-the-shadows.lore"  VERSION "0.4"
        # Fields of Victory
        "l5r5e-0.4-fields-of-victory-introduction.lore"    VERSION "0.4.1"
        "l5r5e-0.4-fields-of-victory-lion-clan.lore"       VERSION "0.4.1"
        "l5r5e-0.4-fields-of-victory-badger-clan.lore"     VERSION "0.4.1"
        "l5r5e-0.4-fields-of-victory-armies.lore"          VERSION "0.4"
        "l5r5e-0.4-fields-of-victory-warfare.lore"         VERSION "0.4"
        "l5r5e-0.4-fields-of-victory-character-options.lore" VERSION "0.4"
        # Legacies of War
        "l5r5e-0.4-legacies-of-war-lore.lore"            VERSION "0.4"
        # The Mantis Clan (standalone)
        "l5r5e-0.4-mantis-clan.lore"                     VERSION "0.4"
        # Celestial Realms
        "l5r5e-0.4-celestial-realms-cosmology.lore"        VERSION "0.4"
        "l5r5e-0.4-celestial-realms-phoenix-clan.lore"     VERSION "0.4"
        "l5r5e-0.4-celestial-realms-centipede-clan.lore"   VERSION "0.4"
        "l5r5e-0.4-celestial-realms-character-options.lore" VERSION "0.4"
        # Path of Waves (ronin.lore, player-options.lore, campaigns.lore are
        # reviewed but purely mechanical — no lore-native named entities)
        "l5r5e-0.4-path-of-waves-hirosaka.lore"            VERSION "0.4"
        "l5r5e-0.4-path-of-waves-gaijin.lore"              VERSION "0.4"
        "l5r5e-0.4-path-of-waves-twin-blessings.lore"      VERSION "0.4"
        "l5r5e-0.4-path-of-waves-character-creation.lore"  VERSION "0.4"
        "l5r5e-0.4-path-of-waves-chapter7-npcs.lore"       VERSION "0.4"
        # Writ of the Wilds
        "l5r5e-0.4-writ-of-wilds-dragon-clan.lore"         VERSION "0.4"
        "l5r5e-0.4-writ-of-wilds-temples.lore"             VERSION "0.4"
        "l5r5e-0.4-writ-of-wilds-peoples.lore"             VERSION "0.4"
        "l5r5e-0.4-writ-of-wilds-wilderness.lore"          VERSION "0.4"
        "l5r5e-0.4-writ-of-wilds-finding-balance.lore"     VERSION "0.4"
        "l5r5e-0.4-writ-of-wilds-character-options.lore"   VERSION "0.4"
        # Children of the Five Winds (gifts-of-the-world.lore is reviewed but
        # purely mechanical — currency, language, the otherworldly-encounter &
        # spirit-pact subsystems, conditions, titles, NPC templates; no lore-
        # native named entities)
        "l5r5e-0.4-children-of-five-winds-unicorn-clan.lore"      VERSION "0.4"
        "l5r5e-0.4-children-of-five-winds-fox-clan.lore"         VERSION "0.4.1"
        "l5r5e-0.4-children-of-five-winds-sand-road.lore"        VERSION "0.4.1"
        "l5r5e-0.4-children-of-five-winds-qamarist.lore"         VERSION "0.4.1"
        "l5r5e-0.4-children-of-five-winds-adventure.lore"        VERSION "0.4"
        "l5r5e-0.4-children-of-five-winds-character-options.lore" VERSION "0.4"
        # Errata & FAQ
        "l5r5e-0.4-errata-faq-kisshoten.lore"        VERSION "0.4.1"
        # Adventures (adventure prose folded from .arc/.actor/.lore sets)
        "l5r5e-0.4-wedding-kyotei.lore"              VERSION "0.4"
        "l5r5e-0.4-highwayman.lore"                  VERSION "0.4"
        "l5r5e-0.4-scroll-or-blade.lore"             VERSION "0.4"
        "l5r5e-0.4-knotted-tails.lore"               VERSION "0.4"
        "l5r5e-0.4-sins-of-regret.lore"              VERSION "0.4"
        "l5r5e-0.4-winters-embrace.lore"             VERSION "0.4"
        "l5r5e-0.4-emerald-champion.lore"            VERSION "0.4"
        "l5r5e-0.4-cresting-waves.lore"              VERSION "0.4"
        "l5r5e-0.4-imperfect-land.lore"              VERSION "0.4"
        "l5r5e-0.4-mask-of-the-oni.lore"             VERSION "0.4"
    }

    # This parent holds only the manifest + edition-spanning anchor entities that
    # many books reference. Book-specific nodes live in the section files.
}
