    MODIFY ^"Scheme Action" {
        EXTENDS ^"Action Type"

        PROPERTIES {
            ^"Action Type Name" STRING "Scheme" FIXED
            ^"Source Page" INTEGER 253
            ^"Description" STRING "Scheme actions allow a character to attempt to influence targets with whom they can communicate—manipulating them, wearing them down, or bringing them around to a different point of view. A Scheme action usually specifies at least one target who suffers any relevant effects."
            ^"Requirement" STRING "To affect another character with a Scheme action, a character must generally be able to communicate with that character, verbally or otherwise."
        }

        GUIDANCE {
            ENTRY ^"errata-scheme-action-0" #L5RERG1gkQQUHLUxguBYzS {
                CONCERNS [ ^"Scheme Action" ]
                TOPICS [ "errata" ]
                TEXT "All instances of 'Intrigue action' should read 'Scheme action.'"
            }
        }
    }

    MODIFY ^"Wait" {
                DESCRIPTION "You bide your time, waiting to spring into action."
                ACTIVATION "As an Attack, Scheme, and Support action, declare a non-Movement action you will perform after the occurrence of a specified event before the end of the round."
                EFFECTS "After the specified event occurs before the end of the round, you may perform the action. You must still use the ring matching your ^\"Stance\" for this action. If the specified event does not occur this round, you may perform one action of your choice (other than Wait) at the end of the round."

        GUIDANCE {
            ENTRY ^"errata-wait-0" #L5RERGx2z5H32RPu3X5UOW {
                CONCERNS [ ^"Wait" ]
                TOPICS [ "errata" ]
                TEXT "p. 264, Wait (Action), Activation: The first clause should read 'As an Attack, Scheme, and Support action'"
            }
        }
    }

    MODIFY ^"Target Number" {

        INTEGER MIN 1 MAX 8

        # Number of (su) and (ex) symbols needed for the check to succeed.
        # Set by the GM based on difficulty of the task.

        DIFFICULTY_SCALE {
            1 "An easy task for most people, such as carrying half one's weight or finding a misplaced item."
            2 "An average task, such as jumping a ten-foot ditch or recognizing someone in disguise."
            3 "A difficult task, such as scaling a cliff without rope or finding a well-hidden object."
            4 "A very hard task, such as diving safely from the top of a waterfall or recalling someone's exact words years later."
            5 "An extremely hard task, such as stirring a demoralized army to action or hurling someone using only one hand."
            6 "An extraordinary task, such as discerning someone's whereabouts from the mud on their sandals or felling a tree with a single ax blow."
            7 "A heroic task, such as outwrestling a troll or naming all of one's ancestors in order."
            8 "A legendary task, such as shattering stone with one's bare hands or outwitting a Fortune."
        }

        GUIDANCE {
            ENTRY ^"errata-target-number-0" #L5RERGBK2Dw1bl6XhEaf3G {
                CONCERNS [ ^"Target Number" ]
                TOPICS [ "errata" ]
                TEXT "p. 296, 'Varying Difficulty in Text,' Example: When discussing the TN 3 Fitness Check (Earth 1, Fire 4), the example should list the Fire approach's TN as 4 (not 3)."
            }
        }
    }

    MODIFY ^"Emerald Magistrate" {
        EXTENDS #L5R463nO5pQ7rS9tU1vW3x ^"Title"

        # Emerald Magistrates are agents of the Emperor's Law,
        # warrior-sages who dispense wisdom and justice.

        ASSIGNED_BY "The Emerald Champion, the Emperor, and other high-ranking officials in the office of the Emerald Champion can appoint Emerald Magistrates, and do so when a samurai proves worthy of the post or when the need arises for more arbiters of the Emperor's Justice."
        STATUS_AWARD "+15 (to a maximum of 40)"
        XP_TO_COMPLETION 30

        TITLE_ABILITY {
            ^"Voice of Authority" "Once per game session when making a Scheme or Support action check using a Social skill, you may choose additional targets equal to your ^\"Glory\" rank. You cannot choose any additional target with vigilance higher than the highest among your initial targets."
        }

        CURRICULUM {
            "Trade Skills" "Skill Group"
            "Fitness" "Skill"
            "Martial Arts [Choose One]" "Skill"
            "Performance" "Skill"
            "Rank 1-2 Kata" "Technique Group"
            "Open-Hand Style" "Technique (Kata)"
            "Shallow Waters" "Technique (Shūji)"
        }

        GUIDANCE {
            ENTRY ^"errata-emerald-magistrate-0" #L5RERG1cx5zrdop96NHbTA {
                CONCERNS [ ^"Emerald Magistrate" ]
                TOPICS [ "errata" ]
                TEXT "p. 305: Emerald Magistrate: The title ability should be included, reading: Voice of Authority (Title Ability): Once per game session when making a Scheme or Support action check using a Social skill, you may choose additional targets equal to your Glory rank. You cannot choose any additional target with vigilance higher than the highest among your initial targets."
            }
            ENTRY ^"errata-emerald-magistrate-1" #L5RERGPCcqhSmNpi7ZJlOd {
                CONCERNS [ ^"Emerald Magistrate" ]
                TOPICS [ "errata" ]
                TEXT "p. 305, Emerald Magistrate: The Status Award should be listed as, 'Status Award: +15 (to a minimum of 40)'"
            }
        }
    }

    MODIFY ^"Peasant Family" {
        EXTENDS #L5R251lM3nO5pQ7rS9tU1v ^"Family"
        APPLIES TO [^"Samurai"]

        PROPERTIES {
            ^"Family Name"     STRING "Peasant" FIXED
            ^"Ring Increase" DEF { CHOOSE 1 [^"Air", ^"Earth", ^"Fire", ^"Water", ^"Void"] INTEGER 1 }
            ^"Skill Increases" DEF {
                CHOOSE 2 [^"Commerce", ^"Labor", ^"Seafaring", ^"Skulduggery", ^"Survival"] INTEGER 1
            }
            ^"Glory"           INTEGER 25
            ^"Starting Wealth" DEF { ^"Zeni" INTEGER 10 }
        }

        GUIDANCE {
            ENTRY ^"errata-peasant-family-0" #L5RERG2V4LfHpztqbTzK6O {
                CONCERNS [ ^"Peasant Family" ]
                TOPICS [ "errata" ]
                TEXT "p. 306, Peasant Family, Skill Increase: This should read '+1 to any two Trade skills of your choice.'"
            }
        }
    }

    MODIFY ^"Manifest Fire Kami" {
        EXTENDS ^"NPC"

        PROPERTIES {
            ^"Type" STRING "Adversary" FIXED
            ^"Category" STRING "Kami"
            ^"Combat Conflict Rank" INTEGER 9
            ^"Intrigue Conflict Rank" INTEGER 2
            ^"Source Page" INTEGER 324
            ^"Description" STRING "Energy given form, a manifest fire kami usually appears as a humanoid shape. Clothed in a robe of smoke and with blazing skin, it is the harbinger of destruction but also of renewal. While they are intelligent and knowledgeable, fire kami are notoriously single-minded once they have taken form, seeking only to consume everything within their reach before sputtering out."
            ^"Rings" DEF {
                ^"Air" INTEGER 1
                ^"Earth" INTEGER 2
                ^"Fire" INTEGER 6
                ^"Water" INTEGER 2
                ^"Void" INTEGER 1
            }
            ^"Endurance" INTEGER 12
            ^"Composure" INTEGER 3
            ^"Focus" INTEGER 4
            ^"Vigilance" INTEGER 1
            ^"Demeanor" STRING "Intense"
            ^"Skills" LIST OF STRING ["Artisan 0", "Martial 3", "Scholar 3", "Social 2", "Trade 3"]
            ^"Advantages" LIST OF STRING ["Primal Terror: (fire) Martial, Social; Interpersonal"]
            ^"Disadvantages" LIST OF STRING ["Endless Hunger: (water) Artisan, Scholar; Mental"]
            ^"Favored Weapons" LIST OF STRING ["Blazing Touch: Range 1–3, Damage 6, Deadliness 6, Razor-Edged, deals supernatural damage"]
            ^"Gear" LIST OF STRING ["Corona of Flames (Physical 3)"]
        }

        GUIDANCE {
            ENTRY ^"errata-manifest-fire-kami-0" #L5RERGqu7nRCarqm9mVyam {
                CONCERNS [ ^"Manifest Fire Kami" ]
                TOPICS [ "errata" ]
                TEXT "p. 324, Manifest Fire Kami: This NPC's Earth Ring should be 2 and its Fire Ring should be 6."
            }
        }
    }

    MODIFY ^"Opportunity" {

        # (op) symbols on kept dice can be spent for additional narrative
        # effects. Available options depend on the ring used for the check
        # and the context (general, conflict, initiative, skill group, downtime).
        # General opportunities are always available regardless of context.

        # -----------------------------------------------
        # GENERAL EXAMPLES OF (op)
        # Available on any check regardless of context.
        # -----------------------------------------------

        GENERAL_OPPORTUNITIES {
            ANY {
                "(op): If you failed, determine the easiest way to accomplish the task you were attempting (skill and approach)."
                "(op)+: Remove 1 strife you gained from this check per (op) spent this way."
                "(op)(op): Provide assistance to the next character to attempt a check to accomplish something similar."
            }
            AIR {
                "(op): Learn another character in the scene's demeanor (if an NPC) and current strife."
                "(op)+: Act subtly to attract minimal attention in your efforts. Extra (op) makes the attempt even subtler."
                "(op)(op): Notice an interesting detail about a character in the scene, such as an advantage or disadvantage. At the GM's discretion, you may establish a new detail for an NPC."
            }
            EARTH {
                "(op): Reassure another character in the scene with your presence, allowing them to remove 2 strife."
                "(op)+: Act carefully to minimize consequences of failure or other dangers that could arise from the task. Extra (op) makes the attempt even safer."
                "(op)(op): Suddenly recall an important piece of information not directly related to the task. At the GM's discretion, you may establish a small preparatory action you took earlier, such as bringing along a common useful item."
            }
            FIRE {
                "(op): Inflame another character in the scene with your presence, causing them to receive 2 strife."
                "(op)+: Perform the task in a flashy way, drawing attention to yourself. Extra (op) attracts even more notice."
                "(op)(op): Notice something missing or out of place in the vicinity that is not directly related to the task. At the GM's discretion, you may establish an absence, such as a lack of shoes outside indicating the occupant's absence."
            }
            WATER {
                "(op): Remove 2 strife from yourself."
                "(op)+: Perform the task efficiently, completing it more quickly or saving supplies. Extra (op) further reduces the time or materials expended."
                "(op)(op): Spot an interesting physical detail present in your environment not directly related to your check. At the GM's discretion, you may establish a piece of terrain or a mundane object nearby."
            }
            VOID {
                "(op): Choose a ring other than Void. Reduce the TN of your next check by 1 if it uses that ring."
                "(op)+: Feel a chill down your spine, notice a sudden silence, or detect another sign of the supernatural if there is a spiritual disturbance in the scene. Extra (op) gives an increasingly precise location for the supernatural occurrence."
                "(op)(op): Gain spiritual insight into the nature of the universe or your own heart. At the GM's discretion, you may establish a fact about your character that has not been previously revealed but relates to the situation."
            }
        }

        # -----------------------------------------------
        # CONFLICT AND MARTIAL SKILL EXAMPLES OF (op)
        # Available during conflict scenes on Martial skill checks.
        # -----------------------------------------------

        CONFLICT_OPPORTUNITIES {
            AIR {
                "(op): Add a kept (ring) set to an (op) result to your next Martial skill check."
                "(op)+: During a Movement action check, up to 1 range band of any distance you move per (op) spent this way may be along a vertical surface."
                "(op)(op): Increase the TN of the next Martial Arts [Ranged] check targeting you before the start of your next turn by 2."
            }
            EARTH {
                "(op): During a Movement action, ignore one terrain quality of your choice."
                "(op)+: Reduce the severity of the next critical strike you suffer before the start of your next turn by 1 per (op) spent this way."
                "(op)(op): Do not apply one of your disadvantages to checks until the end of your next turn."
            }
            FIRE {
                "(op): Choose another character in the scene; increase the TN of the next check they make before the end of their next turn by 1 if it does not include you as a target."
                "(op)+: During an Attack action check, increase the TN of the next check the target makes to resist a critical strike they suffer before the start of your next turn by 1 per (op) spent this way."
                "(op)(op): Other characters must receive 2 strife to choose you as the target of their Attack and Scheme actions until the start of your next turn."
            }
            WATER {
                "(op): Remove 1 fatigue."
                "(op)+: During an Attack action check, ignore 1 point of target's physical resistance per (op) spent this way."
                "(op)(op): Move 1 range band."
            }
            VOID {
                "(op): During the next Attack action check you make before the end of your next turn, ignore one terrain quality of your choice."
                "(op)+: During a Support action check, increase your Initiative value by 1 per (op) spent this way."
                "(op)(op): Ignore the effects of one condition you are suffering until the end of your next turn."
            }
        }

        # -----------------------------------------------
        # INITIATIVE CHECK EXAMPLES OF (op)
        # Available when making Initiative checks.
        # -----------------------------------------------

        INITIATIVE_OPPORTUNITIES {
            AIR {
                "(op): Assess one foe's weakness. Learn one of their disadvantages of that foe's choice."
            }
            EARTH {
                "(op): Choose another character's disadvantage you know. They do not apply that disadvantage to their checks this scene."
            }
            FIRE {
                "(op): Use your focus instead of your vigilance for your initiative when surprised."
            }
            WATER {
                "(op): Assess the qualities of all terrain in the scene."
            }
            VOID {
                "(op): Sense if there is an Otherworldly being in the scene."
            }
        }

        # -----------------------------------------------
        # OTHER SKILL EXAMPLES OF (op)
        # Available on non-Martial skill checks by skill group.
        # -----------------------------------------------

        SKILL_OPPORTUNITIES {
            AIR {
                ARTISAN "(op): If you succeed, add the Resplendent or Subtle quality to an item that you are refining."
                SCHOLAR "(op): Learn something about a character who created or used the item you are studying (such as one of their advantages or disadvantages of the GM's choice that affected their creation or use of the item)."
                SOCIAL "(op): Learn if the honor, glory, or status attribute of a character in the scene is higher, lower, or equal to yours."
                TRADE "(op): Convince a buyer to pay an additional 10% for an item you are selling."
            }
            EARTH {
                ARTISAN "(op): If you succeed, add the Durable quality to an item that you are restoring."
                SCHOLAR "(op): Remember a place where you can research or study the topic you were attempting to recall."
                SOCIAL "(op): Increase the TN of the next Social check another character makes before the end of the scene by 1."
                TRADE "(op): Reduce the TN of the next check another character makes with the same skill before the end of the scene by 1."
            }
            FIRE {
                ARTISAN "(op): If you succeed, make one additional copy of the item you are creating."
                SCHOLAR "(op): Extrapolate the motivations or desires of another character in the scene or wider situation."
                SOCIAL "(op): Reduce the TN of the next Social check another character makes before the end of the scene by 1."
                TRADE "(op): Unusual inspiration strikes; add a kept (ring) set to an (op) result to the next check you make with another skill."
            }
            WATER {
                ARTISAN "(op): Add a kept (ring) set to an (op) result to the next Artisan skill check you make before the end of the game session."
                SCHOLAR "(op): Spot a unique or identifying quality, aspect, or ability of something that you are identifying."
                SOCIAL "(op): Add a kept (ring) set to an (op) result to your next Social check before the end of the scene."
                TRADE "(op): Convince a seller to give you an additional 10% discount for an item you are buying."
            }
            VOID {
                ARTISAN "(op): Reduce the TN of the next check you make using the item you are attuning yourself to by 1."
                SCHOLAR "(op): Intuit whether you can learn anything of value from your current course of inquiry."
                SOCIAL "(op): Discern the objective of another character in the scene."
                TRADE "(op): Reduce any effect you have on your environment (and physical traces of your efforts) to a minimum."
            }
        }

        # -----------------------------------------------
        # DOWNTIME CHECK EXAMPLES OF (op)
        # Available during downtime scene checks.
        # -----------------------------------------------

        DOWNTIME_OPPORTUNITIES {
            AIR {
                "(op)+: Learn a detail about one person in your company (such as an advantage or disadvantage of their choice) per (op) spent this way. You can learn only one detail about each person this way in a single downtime scene."
                "(op)(op): Perform your downtime activity without letting one or more others of your choice know that you did."
            }
            EARTH {
                "(op)+: Another character in your company may remove 1 strife or fatigue per (op) spent this way."
                "(op)(op): Memorize a small but vital detail from your activity; you can recall it later without a check."
            }
            FIRE {
                "(op)+: Assist one other character per (op) spent this way with their next downtime activity check this session."
                "(op)(op): Energize another character in your company with your efforts; they may perform 1 additional downtime action this downtime (to a maximum of 2)."
            }
            WATER {
                "(op)+: Remove 1 strife or fatigue per (op) spent this way."
                "(op)(op): Make a new friend while undertaking your downtime activity."
            }
            VOID {
                "(op)+: Reserve 1 dropped die from your check, to a maximum of your ranks in the skill you used. Add that die to your next check with the same skill as a kept die instead of rolling it."
                "(op)(op): Have a brief premonition of a possible future event while undertaking your downtime activity."
            }
        }

        GUIDANCE {
            ENTRY ^"errata-opportunity-0" #L5RERGRUazh9AVRT8ulf7b {
                CONCERNS [ ^"Opportunity" ]
                TOPICS [ "errata" ]
                TEXT "p. 328, Table 8–1: Opportunities, Conflict and Martial Skill Examples of ⚔, Fire, Entry 1: This entry should read: 'Choose another character in the scene; increase the TN of the next check they make before the start of your next turn if it does not include you as a target.'"
            }
        }
    }

    MODIFY ^"Moto Avenger" {
        EXTENDS #L5R252wX4yZ6aB8cD0eF2g ^"School"
        APPLIES TO [^"Samurai"]
        DESCRIPTION "The Moto revere life, death, and the passage between the two. Life comes from the meeting of earth and sky as the rain falls to the plains; at death, the two are divided, for the body returns to the soil while the spirit returns to the sky. Moto spiritualists work to guide spirits to their proper place, that they may return to the eternal cycle, keeping the cosmos in balance. However, some beings defy the cycle through heresies such as undeath—and Moto Avengers are specialists trained to rectify such perversions of the natural order. The many Moto who have became Tainted within the Shadowlands have drawn Avengers from the distant corners of the Moto lands, that they might destroy these abominations and free the spirits of their fallen comrades."

        # Moto spiritualists guide spirits to their proper place.
        # Avengers specialize in rectifying perversions of the
        # natural order such as undeath. Many Moto fallen to
        # the Taint have drawn Avengers from distant corners.

        PROPERTIES {
            ^"School Name" STRING "Moto Avenger" FIXED
            ^"Clan" STRING "Unicorn"
            ^"Roles" LIST ["Shugenja"]
            ^"Ring Increase" DEF {
                ^"Air" INTEGER 1
                ^"Earth" INTEGER 1
            }
            ^"Starting Skills" DEF { CHOOSE 3 [^"Courtesy", ^"Culture", ^"Martial Arts [Melee]", ^"Sentiment", ^"Survival", ^"Theology"] INTEGER 1 }
            ^"Starting Honor" INTEGER DEFAULT 44
            ^"Techniques Available" LIST ["Air and Earth Invocations", "Rituals", "Shūji"]
        }


        STARTING_TECHNIQUES {
            INVOCATION ^"Grasp of Earth"
            INVOCATION ^"Tempest of Air"
            SHUJI ^"Ancestry Unearthed"
            SHUJI ^"Honest Assessment"
        }

        SCHOOL_ABILITY "Hands of Earth and Sky" {
            "When you perform an invocation that targets at least one other character, if you succeed, you may nourish or drain: Nourish: receive fatigue up to your school rank. One target removes fatigue equal to amount received. Drain: remove fatigue up to your school rank. One target receives fatigue equal to amount removed."
        }

        MASTERY_ABILITY ^"Empathic Transfer" {
            "When you nourish, you may remove one condition the target is suffering by transferring it to yourself. When you drain, you may remove one condition you are suffering by transferring it to one of your targets."
        }
        STARTING_OUTFIT [
            "traveling clothes", "ashigaru armor",
            "wakizashi", "scroll satchel",
            "finger of jade", "traveling pack",
            "Unicorn warhorse"
        ]

        CURRICULUM {
            RANK 1 {
                SKILL_GROUP "Scholar Skills"
                SKILL "Command"
                SKILL "Martial Arts [Melee]"
                SKILL "Survival"
                TECHNIQUE_GROUP "Rank 1 Rituals"
                ^"Bind the Shadow" [invocation]
                ^"Caress of Earth" [invocation]
            }
            RANK 2 {
                SKILL_GROUP "Martial Skills"
                SKILL "Culture"
                SKILL "Medicine"
                SKILL "Theology"
                TECHNIQUE_GROUP "Rank 1-2 Air Invocations"
                ^"Essence of Jade" [invocation]
                ^"Touchstone of Courage" [shuji]
            }
            RANK 3 {
                SKILL_GROUP "Trade Skills"
                SKILL "Courtesy"
                SKILL "Martial Arts [Melee]"
                SKILL "Tactics"
                TECHNIQUE_GROUP "Rank 1-3 Earth Shūji"
                ^"Earthquake" [invocation]
                ^"Earth Becomes Sky" [invocation]
            }
            RANK 4 {
                SKILL_GROUP "Social Skills"
                SKILL "Medicine"
                SKILL "Sentiment"
                SKILL "Theology"
                TECHNIQUE_GROUP "Rank 1-4 Earth Invocations"
                ^"Rise, Air" [invocation]
                ^"Wolf's Proposal" [shuji]
            }
            RANK 5 {
                SKILL_GROUP "Scholar Skills"
                SKILL "Martial Arts [Melee]"
                SKILL "Performance"
                SKILL "Survival"
                TECHNIQUE_GROUP "Rank 1-5 Air Invocations"
                ^"Rouse the Soul" [shuji]
                ^"Tomb of Jade" [invocation]
            }
            RANK 6 {
                ^"Empathic Transfer"
            }
        }

        GUIDANCE {
            ENTRY ^"errata-moto-avenger-0" #L5RERGKb4Jje2xMz4zyuZM {
                CONCERNS [ ^"Moto Avenger" ]
                TOPICS [ "errata" ]
                TEXT "p. 93, Moto Avenger School: In the Avenger's starting outfit, the following should be added, 'Unicorn warhorse (see page 326 of the core rulebook).'"
            }
        }
    }

    MODIFY ^"School" {
        APPLIES TO [^"Samurai"]

        # Generic school type. School definitions EXTENDS this type.
        # A school defines the character's role, ring and skill
        # bonuses, starting honor, technique access, school ability,
        # curriculum, and mastery ability.

        PROPERTIES {
            ^"School Name" STRING REQUIRED FIXED
            ^"Clan" STRING REQUIRED
            ^"Roles" LIST REQUIRED                   # ["Bushi"], ["Courtier", "Shugenja"], etc.
            ^"Ring Increase" STRING REQUIRED          # "+1 [Ring], +1 [Ring]"
            ^"Starting Skills" STRING REQUIRED        # "choose N: +1 [Skill], +1 [Skill], ..."
            ^"Starting Honor" INTEGER MIN 0 MAX 100 REQUIRED
            ^"Techniques Available" LIST REQUIRED     # ["Kata", "Rituals", "Shūji"]
        }

        GUIDANCE {
            ENTRY ^"faq-school-0" #L5RERGneAUxHfehA6NpuUz {
                CONCERNS [ ^"School" ]
                TOPICS [ "faq" ]
                TEXT "Q: Can a character count multiple purchases from a single entry on the current school rank of their curriculum toward their current school rank? A: Yes. A character can count any number of purchases of ranks of a skill or skill group or techniques from a listed category (e.g., 'Kata Rank 1-2') toward their current school rank."
            }
            ENTRY ^"faq-school-1" #L5RERGr02CkV99Ra57qnpn {
                CONCERNS [ ^"School" ]
                TOPICS [ "faq" ]
                TEXT "Q: If a character has access to an advancement with the = symbol that they could not normally purchase at a specific school rank or via a specific title, can they purchase it after completing that rank or title? A: No. The special access to purchase that advancement does not persist once the rank is completed."
            }
        }
    }

    MODIFY ^"Asahina Artificer" {
        EXTENDS #L5R252wX4yZ6aB8cD0eF2g ^"School"
        APPLIES TO [^"Samurai"]

        # Art and religion intertwine for the Asahina, for to them, faith,
        # beauty, and peace are all aspects of the same truth. The Asahina
        # take any opportunity to teach their philosophy and try to improve
        # harmony in the Empire.

        PROPERTIES {
            ^"School Name" STRING "Asahina Artificer" FIXED
            ^"Clan" STRING "Crane"
            ^"Roles" LIST ["Shugenja", "Artisan"]
            ^"Ring Increase" DEF {
                ^"Air" INTEGER 1
                ^"Fire" INTEGER 1
            }
            ^"Starting Skills" DEF { CHOOSE 3 [^"Aesthetics", ^"Courtesy", ^"Culture", ^"Design", ^"Games", ^"Theology"] INTEGER 1 }
            ^"Starting Honor" INTEGER DEFAULT 50
            ^"Techniques Available" LIST ["Invocations", "Rituals", "Shūji"]
        }

        STARTING_TECHNIQUES {
            INVOCATION CHOOSE 3 [^"Blessed Wind", ^"Armor of Radiance", ^"Inari's Blessing", ^"Reflections of P'an Ku", ^"Token of Memory"]
            RITUAL ^"Commune with the Spirits"
            RITUAL ^"Cleansing Rite"
        }

        SCHOOL_ABILITY "Spiritual Artisan" {
            "When making a check to mystically summon an illusion or to summon, augment, or awaken an object, you may add a number of kept (ring) set to (op) results equal to your school rank."
        }

        MASTERY_ABILITY ^"Stir the Slumbering Spirit" {
            "Once per game session as a downtime activity, you may make a TN 4 Artisan (Void) check to awaken an item's spirit. If you succeed, until the end of the game session, it becomes a nemuranai (see page 307) with a sealed invocation of your choice based on the item's history. The GM is the final arbiter of the appropriateness of any invocation selected this way."
        }

        STARTING_OUTFIT [
            "Sanctified robes",
            "wakizashi (short sword)", "knife",
            "yumi (bow)", "quiver of arrows",
            "scroll satchel", "traveling pack"
        ]

        # The Asahina Artificer School teaches its students invocations by
        # Elemental names, for they continue the traditions passed down from
        # Isawa Asahina, their founder.
        # (See ^"Invocation Names and Traditions")

        CURRICULUM {
            RANK 1 {
                SKILL_GROUP "Artisan Skills"
                SKILL "Courtesy"
                SKILL "Culture"
                SKILL "Theology"
                TECHNIQUE_GROUP "Rank 1 Air Invocations"
                ^"Path to Inner Peace" [invocation]
                ^"Artisan's Appraisal" [shuji]
            }
            RANK 2 {
                SKILL_GROUP "Scholar Skills"
                SKILL "Aesthetics"
                SKILL "Design"
                SKILL "Performance"
                TECHNIQUE_GROUP "Rank 1-2 Water Invocations"
                ^"Grasp of the Air Dragon" [invocation]
                ^"Tea Ceremony" [ritual]
            }
            RANK 3 {
                SKILL_GROUP "Social Skills"
                SKILL "Aesthetics"
                SKILL "Design"
                SKILL "Theology"
                TECHNIQUE_GROUP "Rank 1-3 Fire Invocations"
                ^"Wings of the Phoenix" [invocation]
                ^"Vapor of Nightmare" [invocation]
            }
            RANK 4 {
                SKILL_GROUP "Artisan Skills"
                SKILL "Fitness"
                SKILL "Performance"
                SKILL "Theology"
                TECHNIQUE_GROUP "Rank 1-4 Water Invocations"
                ^"Bend with the Storm" [shuji]
                ^"Rise, Air" [invocation]
            }
            RANK 5 {
                SKILL_GROUP "Scholar Skills"
                SKILL "Aesthetics"
                SKILL "Design"
                SKILL "Performance"
                TECHNIQUE_GROUP "Rank 1-5 Air Invocations"
                ^"Ever-Changing Waves" [invocation]
                ^"Buoyant Arrival" [shuji]
            }
            RANK 6 {
                ^"Stir the Slumbering Spirit"
            }
        }

        GUIDANCE {
            ENTRY ^"faq-asahina-artificer-0" #L5RERGYUsd6AYBGKboJWeU {
                CONCERNS [ ^"Asahina Artificer" ]
                TOPICS [ "faq" ]
                TEXT "Q: When does the Asahina Artificer's school ability apply? A: It applies to invocations using the listed keywords to: summon an illusion (e.g., Token of Memory, Matsu's Battlecry); summon an object (any manifestation of an element that is not a being like a Manifest Kami, e.g., Blessed Wind, Katana of Fire, Earthquake); augment an object (e.g., Cloak of Night, Armor of Radiance); awaken an object (e.g., the school's Mastery Ability)."
            }
        }
    }

    MODIFY ^"Matsu Berserker" {
        EXTENDS #L5R252wX4yZ6aB8cD0eF2g ^"School"
        APPLIES TO [^"Samurai"]

        # The Matsu's soldiers are the front line and main strength of the
        # Lion armies. Their bravery and zeal for battle are unquestioned.
        # The Matsu warrior dōjō teaches the primacy of offense and the
        # necessity of seizing the initiative in all things. Aggression is the
        # hallmark of the Matsu style; direct action is their watchword.
        # This bellicose attitude often puts them at odds with the careful
        # strategies of the Akodo, but the Matsu serve the Lion and the
        # Empire with unquestioned loyalty.

        PROPERTIES {
            ^"School Name" STRING "Matsu Berserker" FIXED
            ^"Clan" STRING "Lion"
            ^"Roles" LIST ["Bushi"]
            ^"Ring Increase" DEF {
                ^"Earth" INTEGER 1
                ^"Fire" INTEGER 1
            }
            ^"Starting Skills" DEF { CHOOSE 5 [^"Command", ^"Fitness", ^"Labor", ^"Martial Arts [Melee]", ^"Martial Arts [Ranged]", ^"Martial Arts [Unarmed]", ^"Survival"] INTEGER 1 }
            ^"Starting Honor" INTEGER DEFAULT 55
            ^"Techniques Available" LIST ["Kata", "Rituals", "Shūji"]
        }

        STARTING_TECHNIQUES {
            KATA CHOOSE 1 [^"Rushing Avalanche Style", ^"Spinning Blades Style"]
            SHUJI ^"Stirring the Embers"
        }

        SCHOOL_ABILITY "Matsu's Fury" {
            "After you suffer a critical strike or unmask, you may suffer the Enraged condition to remove an amount of fatigue from yourself equal to your school rank."
        }

        MASTERY_ABILITY ^"Rending Jaws of the Lion" {
            "Once per round, when performing an Attack action check while Enraged, you may spend 1 Void point to alter each kept die containing (su) to a result containing (ex)."
        }

        STARTING_OUTFIT [
            "Ashigaru armor", "traveling clothes",
            "daishō (katana and wakizashi)",
            "nodachi (greatsword) or tessen (war fan)",
            "knife", "yumi (bow)", "quiver of arrows",
            "traveling pack"
        ]

        CURRICULUM {
            RANK 1 {
                SKILL_GROUP "Martial Skills"
                SKILL "Command"
                SKILL "Labor"
                SKILL "Survival"
                TECHNIQUE_GROUP "Rank 1 Kata"
                ^"Lord Akodo's Roar" [shuji]
                ^"Stonewall Tactics" [shuji]
            }
            RANK 2 {
                SKILL_GROUP "Martial Skills"
                SKILL "Command"
                SKILL "Medicine"
                SKILL "Smithing"
                TECHNIQUE_GROUP "Rank 1-2 Kata"
                ^"Heartpiercing Strike" [kata]
                ^"Fanning the Flames" [shuji]
            }
            RANK 3 {
                SKILL_GROUP "Martial Skills"
                SKILL "Composition"
                SKILL "Government"
                SKILL "Theology"
                TECHNIQUE_GROUP "Rank 1-3 Kata"
                ^"Disappearing World Style" [kata]
                ^"Rallying Cry" [shuji]
            }
            RANK 4 {
                SKILL_GROUP "Martial Skills"
                SKILL "Command"
                SKILL "Courtesy"
                SKILL "Culture"
                TECHNIQUE_GROUP "Rank 1-4 Kata"
                ^"Striking as Void" [kata]
                ^"Bravado" [shuji]
            }
            RANK 5 {
                SKILL_GROUP "Martial Skills"
                SKILL "Labor"
                SKILL "Medicine"
                SKILL "Smithing"
                TECHNIQUE_GROUP "Rank 1-5 Kata"
                ^"Rouse the Soul" [shuji]
                ^"Sear the Wound" [shuji]
            }
            RANK 6 {
                ^"Rending Jaws of the Lion"
            }
        }

        GUIDANCE {
            ENTRY ^"faq-matsu-berserker-0" #L5RERGJgdGZ49gvKqnrCr9 {
                CONCERNS [ ^"Matsu Berserker" ]
                TOPICS [ "faq" ]
                TEXT "Q: Can a Matsu Berserker's school ability (p. 73) trigger even if already suffering the Enraged condition? A: Yes. May suffer Enraged to trigger ability even while already Enraged (only one instance per Persistent Effects, p. 174)."
            }
        }
    }

    MODIFY ^"NPC" {
        # Metatype anchor for non-player character definitions

        GUIDANCE {
            ENTRY ^"faq-npc-0" #L5RERG3d9X5uMSdOhtGB7Z {
                CONCERNS [ ^"NPC" ]
                TOPICS [ "faq" ]
                TEXT "Q: Can a character pick up and wield a weapon profile that is part of an NPC's body? A: No. It only has that profile as part of the NPC's body. A severed limb or broken tusk counts as an improvised weapon (club/knife)."
            }
            ENTRY ^"faq-npc-1" #L5RERGY9YYYxs8gzk8bFg2 {
                CONCERNS [ ^"NPC" ]
                TOPICS [ "faq" ]
                TEXT "Q: Can Crimson Leaves Strike or Coiling Serpent Style be used to disarm or restrain unarmed attack profiles? A: No. Unarmed profiles function like weapons for many things but are not strictly considered weapons (per p. 237)."
            }
            ENTRY ^"faq-npc-2" #L5RERGrRoTm9mHI58kJVvA {
                CONCERNS [ ^"NPC" ]
                TOPICS [ "faq" ]
                TEXT "Q: Can Crimson Leaves Strike and Coiling Serpent Style be used to disarm or restrain an NPC's weapon profile that is part of its body? A: No. These are treated as unarmed profiles and cannot be affected by those techniques."
            }
        }
    }

    MODIFY ^"Boon of Kisshoten" {
        APPLIES TO [^"Item"]
        PROPERTIES {
            ^"Item Type" STRING "Omamori" FIXED
            ^"Cost" STRING "5 bu"
            ^"Rarity" INTEGER DEFAULT 2
            ^"Effect" STRING "Once per session, spend 1 Void point to count as having Dangerous Allure or Kisshoten's Blessing (your choice) until end of scene"
        }

        GUIDANCE {
            ENTRY ^"faq-boon-of-kisshoten-0" #L5RERGTQk0f5bKuY2dru00 {
                CONCERNS [ ^"Boon of Kisshoten" ]
                TOPICS [ "faq" ]
                TEXT "Q: Why is Kisshōten noted as one of the Eight Great Fortunes in the core rulebook, but isn't in Emerald Empire? A: Kisshōten is widely considered one of the Eight Great Fortunes, though some in Rokugan disagree. Those dissenters managed to remove Kisshōten's entry from Emerald Empire."
            }
        }
    }

    MODIFY ^"Weapon" {
        APPLIES TO [^"Samurai", ^"Adversary"]

        # It is said that the sword is "the soul of the samurai." On the
        # field, a samurai might wield numerous different armaments — a bow
        # to hit targets from afar, a spear to strike from horseback, or a
        # katana to cut down foes in the bloody fray.

        # --- ATTRIBUTES OF A WEAPON ---
        # Category: The archetype (swords, polearms, bows, etc.). Some
        #   techniques require specific categories.
        # Name: The name of the weapon.
        # Skill: The specific skill used to wield the weapon, usually one
        #   of: Martial Arts [Melee], [Ranged], or [Unarmed].
        # Range (RNG): The distance in range bands at which an attacker
        #   can hit a target. A single number or range of values. Range is
        #   both a maximum AND a minimum; a target closer than the lowest
        #   value is not considered in range.
        # Base Damage (DMG): How quickly blows wear a defender down.
        #   Attack actions frequently reference this value.
        # Deadliness (DLS): The lethality of the weapon. High deadliness
        #   more easily inflicts gruesome injuries or death (see ^"Critical Strike").
        # Grips: The ways to wield the weapon. If multiple grips are listed,
        #   each shows any alterations to base attributes for that grip.
        # Qualities: Any additional effects (see ^"Item Quality").
        # Rarity: How difficult the item is to find (1 = common, 9 = legendary).
        # Price: The cost to acquire.

        PROPERTIES {
            ^"Name" STRING REQUIRED
            ^"Category" STRING  # Swords, Axes, Blunt Weapons, Hand Weapons, Polearms, Bows, Crossbows, Specialist Weapons
            ^"Skill" STRING  # Martial Arts [Melee], [Ranged], or [Unarmed]
            ^"Range" STRING  # Range band(s), e.g. "1" or "0-1" or "2-5"
            ^"Base Damage" INTEGER MIN 0 MAX 10
            ^"Deadliness" INTEGER MIN 0 MAX 10
            ^"Grips" STRING  # Grip options and attribute modifications per grip
            ^"Qualities" LIST OF STRING  # References ^"Item Quality" values
            ^"Rarity" INTEGER MIN 1 MAX 9
            ^"Price" STRING
            ^"Description" STRING  # Verbatim narrative flavor (no mechanical effect)
        }

        # --- READIED WEAPONS ---
        # A weapon is readied if a character is physically prepared to use
        # it offensively and defensively. A character may ready a weapon at
        # will during narrative time, or as an action during a conflict scene.
        # When readying weapons, a character may choose any number of
        # weapons at range 0-1 they can hold at once. Maximum: one pair of
        # 1-handed grip weapons (one in each hand) or a single 2-handed
        # grip weapon. Readied weapons remain readied until the character
        # sheathes, relinquishes, or drops them.
        # When readying a weapon, the character must choose one of its
        # grips; they may switch grips whenever they have the chance to
        # ready a weapon.

        # --- SHEATHED WEAPONS ---
        # A weapon is sheathed if it is on a character's person, properly
        # stowed for access but not yet readied. A character can sheathe
        # a weapon at will during narrative time, or as an action during
        # a conflict scene.

        # ==================
        # MELEE WEAPONS
        # ==================

        # Format: Name, Skill, Range, Damage, Deadliness, Grips, Qualities, Rarity, Price

        # --- SWORDS ---
        SWORDS {
            ^"Bokken" DEF {
                PROPERTIES {
                    ^"Category" STRING "Swords"
                    ^"Skill" STRING "Martial Arts [Melee]"
                    ^"Range" STRING "1"
                    ^"Base Damage" INTEGER 3
                    ^"Deadliness" INTEGER 3
                    ^"Grips" STRING "1-hand: –; 2-hand: Damage +2"
                    ^"Qualities" LIST OF STRING ["Mundane"]
                    ^"Rarity" INTEGER 3
                    ^"Price" STRING "1 bu"
                    ^"Description" STRING "Bokken are swords carved of wood rather than forged of metal. Generally used as a training weapon, a bokken still can be deadly in a skilled warrior’s hands. A properly shaped bokken can be used for Iaijutsu Cut techniques despite lacking the Razor-Edged quality."
                }
            }

            ^"Chokutō" DEF {
                PROPERTIES {
                    ^"Category" STRING "Swords"
                    ^"Skill" STRING "Martial Arts [Melee]"
                    ^"Range" STRING "0-1"
                    ^"Base Damage" INTEGER 4
                    ^"Deadliness" INTEGER 5
                    ^"Grips" STRING "1-hand: –"
                    ^"Qualities" LIST OF STRING ["Ceremonial", "Razor-Edged"]
                    ^"Rarity" INTEGER 7
                    ^"Price" STRING "20 koku"
                    ^"Description" STRING "The chokutō is an ancient design that predates the advent of the katana. Hung from a belt rather than tucked into a sash, a chokutō is roughly three feet long and has a straight, single-edged blade instead of the gentle curve found in newer Rokugani swords. Many of the clans’ most powerful nemuranai—weapons that were wielded by their founding Kami—have this shape, as do the blades used by the Yobanjin of the northern mountains."
                }
            }

            ^"Dao" DEF {
                PROPERTIES {
                    ^"Category" STRING "Swords"
                    ^"Skill" STRING "Martial Arts [Melee]"
                    ^"Range" STRING "1"
                    ^"Base Damage" INTEGER 3
                    ^"Deadliness" INTEGER 5
                    ^"Grips" STRING "1-hand: –"
                    ^"Qualities" LIST OF STRING []
                    ^"Rarity" INTEGER 6
                    ^"Price" STRING "15 koku"
                    ^"Description" STRING "Dao are weapons that look like a cross between a scimitar, a saber, and a peasant’s machete. They are one-handed swords two to three feet in length with a broad-bellied, single-edged blade designed for slashing and chopping, and are generally wielded in pairs."
                }
            }

            ^"Gao" DEF {
                PROPERTIES {
                    ^"Category" STRING "Swords"
                    ^"Skill" STRING "Martial Arts [Melee]"
                    ^"Range" STRING "1"
                    ^"Base Damage" INTEGER 4
                    ^"Deadliness" INTEGER 3
                    ^"Grips" STRING "1-hand: –"
                    ^"Qualities" LIST OF STRING ["Snaring"]
                    ^"Rarity" INTEGER 7
                    ^"Price" STRING "15 koku"
                    ^"Description" STRING "Known colloquially as “tiger hook swords” or “Heaven and Earth, Sun and Moon swords,” gao are curious weapons. Usually wielded in pairs, gao are flat, solid iron or steel blades roughly three feet long with several unique features. Their main blade has a hook at one end and a sharpened spike at the other. The grip is protected by a crescent-shaped hand guard with its points facing outward. Gao can be used to slash, capture, and stab, making them appealing to certain Mirumoto duelists."
                }
            }

            ^"Jian" DEF {
                PROPERTIES {
                    ^"Category" STRING "Swords"
                    ^"Skill" STRING "Martial Arts [Melee]"
                    ^"Range" STRING "0-1"
                    ^"Base Damage" INTEGER 4
                    ^"Deadliness" INTEGER 4
                    ^"Grips" STRING "1-hand: –; 2-hand: Deadliness +1"
                    ^"Qualities" LIST OF STRING []
                    ^"Rarity" INTEGER 7
                    ^"Price" STRING "15 koku"
                    ^"Description" STRING "Known primarily as a duelist’s weapon, the jian is an ancient and elegant sword that has changed very little in design since Rokugan’s misty past yet remains deadly to this day. About the same size as a chokutō, a typical jian has a straight, double-edged blade that tapers to a point; a small, thick, horizontal hand guard; and a heavy pommel with a tassel. Only slightly more common than the chokutō, it is used by some Mirumoto, Kitsuki, or Shiba swordmasters who favor its versatility."
                }
            }

            ^"Katana" DEF {
                PROPERTIES {
                    ^"Category" STRING "Swords"
                    ^"Skill" STRING "Martial Arts [Melee]"
                    ^"Range" STRING "1"
                    ^"Base Damage" INTEGER 4
                    ^"Deadliness" INTEGER 5
                    ^"Grips" STRING "1-hand: –; 2-hand: Deadliness +2"
                    ^"Qualities" LIST OF STRING ["Ceremonial", "Razor-Edged"]
                    ^"Rarity" INTEGER 7
                    ^"Price" STRING "20 koku"
                    ^"Description" STRING "As much a work of art as it is a weapon, the katana is perhaps the most revered weapon in Rokugan. It has an elegant, slightly curved blade between three and four feet long, made of steel that is specially folded during its creation. This unique forging style ensures that the inner part of the blade remains springy and soft while the outside is as hard as tempered steel. Each sword likely has a history and legacy, and it is a constant reminder of the weight that destiny has placed upon its bearer’s shoulders as a samurai of Rokugan."
                }
            }

            ^"Nodachi" DEF {
                PROPERTIES {
                    ^"Category" STRING "Swords"
                    ^"Skill" STRING "Martial Arts [Melee]"
                    ^"Range" STRING "1-2"
                    ^"Base Damage" INTEGER 5
                    ^"Deadliness" INTEGER 6
                    ^"Grips" STRING "2-hand: –"
                    ^"Qualities" LIST OF STRING ["Ceremonial", "Razor-Edged"]
                    ^"Rarity" INTEGER 8
                    ^"Price" STRING "20 koku"
                    ^"Description" STRING "Larger than katana, nodachi are long and lethal swords more at home on the battlefield than in a city or at court. Roughly six feet long, these blades are relatively rare due to the skill and strength needed to wield them effectively. There are those who prize the raw force of these blades, however, such as members of the Matsu school. Too large to be worn at the waist, nodachi are normally worn on the back and drawn over the shoulder or even carried into battle by a samurai’s attendant."
                }
            }

            ^"Scimitar" DEF {
                PROPERTIES {
                    ^"Category" STRING "Swords"
                    ^"Skill" STRING "Martial Arts [Melee]"
                    ^"Range" STRING "1"
                    ^"Base Damage" INTEGER 4
                    ^"Deadliness" INTEGER 5
                    ^"Grips" STRING "1-hand: –"
                    ^"Qualities" LIST OF STRING ["Durable", "Razor-Edged"]
                    ^"Rarity" INTEGER 8
                    ^"Price" STRING "20 koku"
                    ^"Description" STRING "Perhaps the most common among foreign-designed swords found in Rokugan, scimitars were brought from the Burning Sands to the Emerald Empire by the Unicorn Clan. Often carried in place of the katana by those warriors, scimitars are heavy swords with a long, broad, curving blade. They possess a deadly cutting edge thanks to the extra surface area provided by their curvature."
                }
            }

            ^"Wakizashi" DEF {
                PROPERTIES {
                    ^"Category" STRING "Swords"
                    ^"Skill" STRING "Martial Arts [Melee]"
                    ^"Range" STRING "0-1"
                    ^"Base Damage" INTEGER 3
                    ^"Deadliness" INTEGER 5
                    ^"Grips" STRING "1-hand: –; 2-hand: Deadliness +2"
                    ^"Qualities" LIST OF STRING ["Ceremonial", "Razor-Edged"]
                    ^"Rarity" INTEGER 7
                    ^"Price" STRING "15 koku"
                    ^"Description" STRING "Whereas the katana represents a samurai’s status as a warrior, the wakizashi represents their place in Rokugan’s social order and strict caste system. The wakizashi is a small, katana-like sword usually two to three feet in length, with the same flexible blade and lethal edge. It is often made as part of a pair, with the same decorations as its matched katana. The wakizashi also fills another role: it clearly signals that its wearer is a samurai, and a person of honor who will make the ultimate sacrifice for their ideals and their master. It is the tool with which a samurai commits seppuku: ritual suicide, the last protest of an aggrieved and honorable samurai."
                }
            }

            ^"Zanbatō" DEF {
                PROPERTIES {
                    ^"Category" STRING "Swords"
                    ^"Skill" STRING "Martial Arts [Melee]"
                    ^"Range" STRING "1-2"
                    ^"Base Damage" INTEGER 6
                    ^"Deadliness" INTEGER 7
                    ^"Grips" STRING "2-hand: –"
                    ^"Qualities" LIST OF STRING ["Cumbersome", "Wargear"]
                    ^"Rarity" INTEGER 8
                    ^"Price" STRING "40 koku"
                    ^"Description" STRING "Larger even than mighty nodachi, zanbatō are swords with the reach of a spear. Zanbatō have a long, thick, katana-like blade roughly six feet in length attached to a two-handed hilt. They are dedicated anticavalry weapons—indeed, their name means “horse-chopping sword.” The Matsu school is famous for adopting them into the curriculum after their ill-fated encounter with the Utaku cavalry at the Battle of Plum Blossom Pass."
                }
            }
        }

        # --- AXES ---
        AXES {
            ^"Masakari" DEF {
                PROPERTIES {
                    ^"Category" STRING "Axes"
                    ^"Skill" STRING "Martial Arts [Melee]"
                    ^"Range" STRING "0-1"
                    ^"Base Damage" INTEGER 3
                    ^"Deadliness" INTEGER 4
                    ^"Grips" STRING "1-hand: –; 2-hand: Deadliness +2"
                    ^"Qualities" LIST OF STRING ["Mundane"]
                    ^"Rarity" INTEGER 5
                    ^"Price" STRING "3 bu"
                    ^"Description" STRING "Similar in size and shape to the humble hatchet, a masakari is a one-handed ax with a single-sided ax-head affixed to one end of a short wooden haft. Such axes are an ordinary sight among peasant militia and rōnin who cannot afford a more prestigious weapon."
                }
            }

            ^"Ono" DEF {
                PROPERTIES {
                    ^"Category" STRING "Axes"
                    ^"Skill" STRING "Martial Arts [Melee]"
                    ^"Range" STRING "1-2"
                    ^"Base Damage" INTEGER 5
                    ^"Deadliness" INTEGER 6
                    ^"Grips" STRING "2-hand: –"
                    ^"Qualities" LIST OF STRING ["Wargear"]
                    ^"Rarity" INTEGER 7
                    ^"Price" STRING "5 koku"
                    ^"Description" STRING "The ono is a dedicated, two-handed military ax, a rarity on Rokugan’s battlefields, at least outside of Crab lands. The ono consists of a broad, deeply curved ax-head mounted to a haft nearly as tall as a human. Opposite the ax-head is normally either an ornate peen or a long spike, which can pierce armor or monstrous hide."
                }
            }
        }

        # --- BLUNT WEAPONS ---
        BLUNT_WEAPONS {
            ^"Club" DEF {
                PROPERTIES {
                    ^"Category" STRING "Blunt Weapons"
                    ^"Skill" STRING "Martial Arts [Melee]"
                    ^"Range" STRING "0-1"
                    ^"Base Damage" INTEGER 5
                    ^"Deadliness" INTEGER 2
                    ^"Grips" STRING "1-hand: –; 2-hand: Damage +1"
                    ^"Qualities" LIST OF STRING ["Mundane"]
                    ^"Rarity" INTEGER 1
                    ^"Price" STRING "1 bu"
                    ^"Description" STRING "The humble club is perhaps the oldest weapon in Rokugan—at least among humans. Often little more than a length of stout wood or shaped stone, a club can be fashioned with available materials by nearly anyone. While a club can certainly be used to kill, doing so takes some work on the part of the wielder."
                }
            }

            ^"Hammer" DEF {
                PROPERTIES {
                    ^"Category" STRING "Blunt Weapons"
                    ^"Skill" STRING "Martial Arts [Melee]"
                    ^"Range" STRING "0-1"
                    ^"Base Damage" INTEGER 5
                    ^"Deadliness" INTEGER 2
                    ^"Grips" STRING "1-hand: –; 2-hand: Damage +2"
                    ^"Qualities" LIST OF STRING ["Mundane"]
                    ^"Rarity" INTEGER 4
                    ^"Price" STRING "2 bu"
                    ^"Description" STRING "The simple hammer is used for driving nails and spikes and for other construction work. Throughout most of Rokugan, the hammer is only occasionally used as a weapon—typically in brawls or spur of the moment skirmishes when no other weapon is available."
                }
            }

            ^"Kiseru" DEF {
                PROPERTIES {
                    ^"Category" STRING "Blunt Weapons"
                    ^"Skill" STRING "Martial Arts [Melee]"
                    ^"Range" STRING "0"
                    ^"Base Damage" INTEGER 2
                    ^"Deadliness" INTEGER 2
                    ^"Grips" STRING "1-hand: –"
                    ^"Qualities" LIST OF STRING ["Concealable", "Mundane"]
                    ^"Rarity" INTEGER 5
                    ^"Price" STRING "1 koku"
                    ^"Description" STRING "Kiseru are pipes used to smoke various herbs found throughout Rokugan. They consist of a metal mouthpiece and a metal bowl connected by a hollow wood or bamboo tube. Kiseru range in quality from a peasant’s rough-hewn pipe to a courtier or noble’s ivory-and-gold inlaid piece of art. Further, they can function as clandestine weapons. Since kiseru are not formally considered arms, it is easy to get them into places that forbid weapons."
                }
            }

            ^"Ōtsuchi" DEF {
                PROPERTIES {
                    ^"Category" STRING "Blunt Weapons"
                    ^"Skill" STRING "Martial Arts [Melee]"
                    ^"Range" STRING "1"
                    ^"Base Damage" INTEGER 8
                    ^"Deadliness" INTEGER 3
                    ^"Grips" STRING "2-hand: –"
                    ^"Qualities" LIST OF STRING ["Cumbersome", "Wargear"]
                    ^"Rarity" INTEGER 8
                    ^"Price" STRING "30 koku"
                    ^"Description" STRING "The ōtsuchi is to the carpenter’s hammer what the ono is to the woodcutter’s ax: larger, deadlier, and obviously designed with lethal purpose. With a shaft roughly six feet long topped by a huge, barrel-shaped mallet head, it is built to breach doors and smash walls—but it also works quite well on monsters with rock-like hides, as the warriors of the Hida school often demonstrate."
                }
            }

            ^"Tetsubō" DEF {
                PROPERTIES {
                    ^"Category" STRING "Blunt Weapons"
                    ^"Skill" STRING "Martial Arts [Melee]"
                    ^"Range" STRING "1-2"
                    ^"Base Damage" INTEGER 7
                    ^"Deadliness" INTEGER 3
                    ^"Grips" STRING "2-hand: –"
                    ^"Qualities" LIST OF STRING ["Cumbersome", "Durable", "Wargear"]
                    ^"Rarity" INTEGER 5
                    ^"Price" STRING "20 koku"
                    ^"Description" STRING "Long and narrow, a tetsubō can be as tall as a human and normally is constructed of iron or hardwood. Above its grip, a tetsubō is covered in steel, iron, or even jade spikes or studs that add to the weapon’s lethality and crush armor or plated carapace with ease."
                }
            }
        }

        # --- HAND WEAPONS ---
        HAND_WEAPONS {
            ^"Jitte" DEF {
                PROPERTIES {
                    ^"Category" STRING "Hand Weapons"
                    ^"Skill" STRING "Martial Arts [Melee]"
                    ^"Range" STRING "0"
                    ^"Base Damage" INTEGER 3
                    ^"Deadliness" INTEGER 2
                    ^"Grips" STRING "1-hand: –"
                    ^"Qualities" LIST OF STRING ["Concealable", "Snaring"]
                    ^"Rarity" INTEGER 5
                    ^"Price" STRING "5 bu"
                    ^"Description" STRING "Typically just over a foot long, the jitte consists of a short steel or iron rod attached to a wooden handle. The rod tapers to a blunt point and has a single prong that extends from one side. This simple weapon is designed to disarm and subdue targets rather than to kill them. It is carried by law enforcement officers at all levels, from low-ranking town constables to high-ranking magistrates, as a symbol of their office."
                }
            }

            ^"Knife" DEF {
                PROPERTIES {
                    ^"Category" STRING "Hand Weapons"
                    ^"Skill" STRING "Martial Arts [Melee]"
                    ^"Range" STRING "0"
                    ^"Base Damage" INTEGER 2
                    ^"Deadliness" INTEGER 4
                    ^"Grips" STRING "1-hand: –; 2-hand: Deadliness +2"
                    ^"Qualities" LIST OF STRING ["Concealable", "Mundane", "Razor-Edged"]
                    ^"Rarity" INTEGER 1
                    ^"Price" STRING "1 koku"
                    ^"Description" STRING "Knives come in a dizzying array of types and styles, from the familiar crudely constructed knife in a peasant’s kitchen to the deadly combat knives samurai take into battle. Those particularly designed for combat—like the aiguchi—are often equipped with small hand guards to make them more useful in the field."
                }
            }

            ^"Nunchaku" DEF {
                PROPERTIES {
                    ^"Category" STRING "Hand Weapons"
                    ^"Skill" STRING "Martial Arts [Melee]"
                    ^"Range" STRING "0-1"
                    ^"Base Damage" INTEGER 4
                    ^"Deadliness" INTEGER 2
                    ^"Grips" STRING "1-hand: –; 2-hand: Snaring"
                    ^"Qualities" LIST OF STRING []
                    ^"Rarity" INTEGER 6
                    ^"Price" STRING "1 koku"
                    ^"Description" STRING "Originally hailing from the Islands of Spice and Silk, nunchaku have been used in certain Rokugani martial arts schools for centuries. Adapted from a simple threshing tool, nunchaku consist of two wood or iron rods connected by a short length of chain or rope."
                }
            }

            ^"Tessen" DEF {
                PROPERTIES {
                    ^"Category" STRING "Hand Weapons"
                    ^"Skill" STRING "Martial Arts [Melee]"
                    ^"Range" STRING "0-1"
                    ^"Base Damage" INTEGER 4
                    ^"Deadliness" INTEGER 3
                    ^"Grips" STRING "1-hand: –"
                    ^"Qualities" LIST OF STRING ["Ceremonial", "Concealable"]
                    ^"Rarity" INTEGER 7
                    ^"Price" STRING "15 koku"
                    ^"Description" STRING "Carried by courtiers and military leaders alike, tessen are fans specially built for fighting. However, they are not commonly viewed as weapons, and can be openly carried even into formal court chambers or negotiations. Usually made of wood with steel tines, they generally serve as defensive weapons, but wielders can also use them to deliver clubbing blows or to reinforce a punch."
                }
            }
        }

        # --- POLEARMS ---
        POLEARMS {
            ^"Bisentō" DEF {
                PROPERTIES {
                    ^"Category" STRING "Polearms"
                    ^"Skill" STRING "Martial Arts [Melee]"
                    ^"Range" STRING "2"
                    ^"Base Damage" INTEGER 4
                    ^"Deadliness" INTEGER 6
                    ^"Grips" STRING "1-hand: Range 1; 2-hand: Damage +2"
                    ^"Qualities" LIST OF STRING ["Cumbersome", "Durable", "Wargear"]
                    ^"Rarity" INTEGER 8
                    ^"Price" STRING "15 koku"
                    ^"Description" STRING "The bisentō is a strange weapon not regularly seen on Rokugan’s battlefields. Essentially a scimitar with an extremely long hilt, the bisentō has a long, yari-like wooden shaft topped by a broad and heavy curved blade. Though it seems awkward and top-heavy, the bisentō is exceptionally dangerous in the right hands. The length of the shaft gives the wielder incredible leverage, allowing them to deliver great chopping blows that can slice a person in half or cleave through heavy armor. Typically seen among the more militant orders of monks, such as the Perfect Land Sect, the bisentō is sometimes used by heavy infantry units, like those of the Daidoji family."
                }
            }

            ^"Bō" DEF {
                PROPERTIES {
                    ^"Category" STRING "Polearms"
                    ^"Skill" STRING "Martial Arts [Melee]"
                    ^"Range" STRING "1-2"
                    ^"Base Damage" INTEGER 6
                    ^"Deadliness" INTEGER 2
                    ^"Grips" STRING "2-hand: –"
                    ^"Qualities" LIST OF STRING ["Mundane"]
                    ^"Rarity" INTEGER 2
                    ^"Price" STRING "2 bu"
                    ^"Description" STRING "The bō, a humble staff, is a versatile weapon found throughout Rokugan. Roughly six feet long and made from sturdy hardwood, it is carried by travelers who need both a walking stick and an inconspicuous weapon."
                }
            }

            ^"Ji" DEF {
                PROPERTIES {
                    ^"Category" STRING "Polearms"
                    ^"Skill" STRING "Martial Arts [Melee]"
                    ^"Range" STRING "2"
                    ^"Base Damage" INTEGER 5
                    ^"Deadliness" INTEGER 2
                    ^"Grips" STRING "2-hand: –"
                    ^"Qualities" LIST OF STRING ["Snaring", "Wargear"]
                    ^"Rarity" INTEGER 6
                    ^"Price" STRING "7 koku"
                    ^"Description" STRING "Also known as the “dagger-spear,” the ji is a long polearm designed more for catching and controlling weapons than for direct attacks. Commonly used by the Dragon and Phoenix Clans, and a specialty of the Shiba Guardian School, the standard ji consists of a long wooden shaft topped by a hooked or crescent-shaped blade. Other ji have a head consisting of a single long, double-edged blade with one or two smaller crescent-shaped blades mounted to the sides."
                }
            }

            ^"Naginata" DEF {
                PROPERTIES {
                    ^"Category" STRING "Polearms"
                    ^"Skill" STRING "Martial Arts [Melee]"
                    ^"Range" STRING "2"
                    ^"Base Damage" INTEGER 6
                    ^"Deadliness" INTEGER 6
                    ^"Grips" STRING "2-hand: –"
                    ^"Qualities" LIST OF STRING ["Cumbersome", "Razor-Edged", "Wargear"]
                    ^"Rarity" INTEGER 8
                    ^"Price" STRING "10 koku"
                    ^"Description" STRING "Most samurai’s preferred polearm, the naginata is highly regarded. It has a long, flexible shaft made of bamboo or springy wood with a large, lightweight, slightly curved blade at the top. A naginata’s blade is forged with the same ceremony and meticulous craftsmanship as a katana’s, and commands the same reverence as the daishō. It is carried in elite units such as the Heaven’s Wing Brotherhood and the Utaku Battle Maidens."
                }
            }

            ^"Trident" DEF {
                PROPERTIES {
                    ^"Category" STRING "Polearms"
                    ^"Skill" STRING "Martial Arts [Melee]"
                    ^"Range" STRING "2"
                    ^"Base Damage" INTEGER 4
                    ^"Deadliness" INTEGER 4
                    ^"Grips" STRING "2-hand: –"
                    ^"Qualities" LIST OF STRING ["Snaring", "Wargear"]
                    ^"Rarity" INTEGER 7
                    ^"Price" STRING "10 koku"
                    ^"Description" STRING "The trident is a long, triple-headed spear generally associated with fishermen and the sea. On land, the trident is a formidable polearm with exceptional reach that can pierce, trap, and control opponents."
                }
            }

            ^"Yari" DEF {
                PROPERTIES {
                    ^"Category" STRING "Polearms"
                    ^"Skill" STRING "Martial Arts [Melee]"
                    ^"Range" STRING "2"
                    ^"Base Damage" INTEGER 5
                    ^"Deadliness" INTEGER 3
                    ^"Grips" STRING "2-hand: –"
                    ^"Qualities" LIST OF STRING ["Wargear"]
                    ^"Rarity" INTEGER 3
                    ^"Price" STRING "5 koku"
                    ^"Description" STRING "A long-shafted spear, the yari is one of the most common weapons in Rokugan. Between six and eight feet long, its shaft is made of hardwood and topped with a leaf-shaped spearhead. Since it is easy to make, the yari is a customary weapon of ashigaru, but also elite clan samurai such as the Daidoji heavy infantry."
                }
            }
        }

        # ==================
        # RANGED WEAPONS
        # ==================

        # --- BOWS ---
        BOWS {
            ^"Daikyū" DEF {
                PROPERTIES {
                    ^"Category" STRING "Bows"
                    ^"Skill" STRING "Martial Arts [Ranged]"
                    ^"Range" STRING "3-5"
                    ^"Base Damage" INTEGER 6
                    ^"Deadliness" INTEGER 4
                    ^"Grips" STRING "2-hand: –"
                    ^"Qualities" LIST OF STRING ["Wargear"]
                    ^"Rarity" INTEGER 6
                    ^"Price" STRING "6 koku"
                    ^"Description" STRING "Daikyū are large composite bows designed to be fired from horseback. Conventionally around six feet long, these elegant weapons are constructed by gluing thin layers of wood, horn, leather, and sinew together. Daikyū differ from other bows in that they have an asymmetric shape. Their grip is about two-thirds of the way from the top, making the top curve longer than the bottom. This allows the bows to be fired easily from horseback in either direction. Each daikyū is made for a custom fit for a specific user."
                }
            }

            ^"Shinjo Horsebow" DEF {
                PROPERTIES {
                    ^"Category" STRING "Bows"
                    ^"Skill" STRING "Martial Arts [Ranged]"
                    ^"Range" STRING "2-4"
                    ^"Base Damage" INTEGER 4
                    ^"Deadliness" INTEGER 5
                    ^"Grips" STRING "2-hand: –"
                    ^"Qualities" LIST OF STRING ["Wargear"]
                    ^"Rarity" INTEGER 4
                    ^"Price" STRING "6 koku"
                    ^"Description" STRING "Among the Unicorn Clan’s many adopted weapons is a small, sturdy bow used by the nomadic peoples of the steppes far to the west. Called the Shinjo horsebow in Rokugan, this weapon is a compact bow designed to be fired from the back of a moving horse. It is a short-range weapon intended for raiding and cavalry attacks."
                }
            }

            ^"Yumi" DEF {
                PROPERTIES {
                    ^"Category" STRING "Bows"
                    ^"Skill" STRING "Martial Arts [Ranged]"
                    ^"Range" STRING "2-5"
                    ^"Base Damage" INTEGER 5
                    ^"Deadliness" INTEGER 3
                    ^"Grips" STRING "2-hand: –"
                    ^"Qualities" LIST OF STRING []
                    ^"Rarity" INTEGER 3
                    ^"Price" STRING "3 koku"
                    ^"Description" STRING "The yumi is perhaps the most common bow used by Rokugani samurai. Similar to the daikyū, it is a long, graceful bow made from a composite of horn, sinew, leather, and wood. Smaller than the daikyū, but only just, the yumi has an asymmetric grip, general shape, and long-range killing power similar to those of its larger cousin. Where the daikyū is a cavalry bow, however, the yumi is designed to be fired while standing."
                }
            }
        }

        # --- CROSSBOWS ---
        CROSSBOWS {
            ^"Oyumi" DEF {
                PROPERTIES {
                    ^"Category" STRING "Crossbows"
                    ^"Skill" STRING "Martial Arts [Ranged]"
                    ^"Range" STRING "2-5"
                    ^"Base Damage" INTEGER 7
                    ^"Deadliness" INTEGER 3
                    ^"Grips" STRING "2-hand: –"
                    ^"Qualities" LIST OF STRING ["Prepare", "Wargear"]
                    ^"Rarity" INTEGER 8
                    ^"Price" STRING "40 koku"
                    ^"Description" STRING "Developed out of necessity to fight the deadly forces of the Shadowlands, this weapon consists of a recurve or traditional bow laid horizontally on a long, stout stock. Held to the shoulder, the oyumi is fired by squeezing a long lever on the bottom of the stock. It fires short, arrow-like projectiles called quarrels. Its existence is a matter of some consternation among the other clans, but the Crab maintain that its use—even in the hands of ashigaru and peasants in times of crisis—has been vital to the preservation of the Empire."
                }
            }
        }

        # --- ARROWS ---
        # When used with a bow, these arrows modify the weapon's profile:
        ARROWS {
            # Arrows are not weapon profiles — they modify the bow that fires them —
            # so they carry an Effect rather than the Range/Damage/Deadliness set.
            ^"Willow-Leaf" DEF {
                PROPERTIES {
                    ^"Category" STRING "Arrows"
                    ^"Effect" STRING "Standard Rokugani arrows. As long as a character has a quiver, they do not need to track willow-leaf arrows individually."
                    ^"Description" STRING "Willow-leaf arrows are broadhead arrows used for both hunting and warfare. These are “typical” arrows."
                }
            }

            ^"Armor-Piercing" DEF {
                PROPERTIES {
                    ^"Category" STRING "Arrows"
                    ^"Effect" STRING "Ignore up to 2 points of the target's physical resistance."
                    ^"Description" STRING "Armor-piercing arrows end in a long, hardened spike. These arrows can pierce even the toughest armor to strike at the flesh beneath."
                }
            }

            ^"Flesh-Cutter" DEF {
                PROPERTIES {
                    ^"Category" STRING "Arrows"
                    ^"Effect" STRING "Deadliness +2."
                    ^"Description" STRING "Flesh-cutters have especially broad, multibladed, and often barbed heads designed to tear through unprotected flesh."
                }
            }

            ^"Humming-Bulb" DEF {
                PROPERTIES {
                    ^"Category" STRING "Arrows"
                    ^"Effect" STRING "Damage -2, Deadliness -2. These arrows produce a loud noise audible at range 0-4 of the archer and of the path the arrow travels."
                    ^"Description" STRING "Humming-Bulbs have an egg-shaped, hollow head with slots cut into its surface. As the arrow flies, the bulb emits a sharp whistling sound. These arrows are good for signaling and creating a distraction."
                }
            }
        }

        # ==================
        # SPECIALIST WEAPONS
        # ==================

        # Weapons used by assassins and spies — a mix of improvised tools,
        # modified agricultural implements, and bespoke weapons. They emphasize
        # stealth and accessibility over sheer killing power.

        SPECIALIST_WEAPONS {
            ^"Blowgun" DEF {
                PROPERTIES {
                    ^"Category" STRING "Specialist Weapons"
                    ^"Skill" STRING "Martial Arts [Ranged]"
                    ^"Range" STRING "2-3"
                    ^"Base Damage" INTEGER 1
                    ^"Deadliness" INTEGER 2
                    ^"Grips" STRING "1-hand: –"
                    ^"Qualities" LIST OF STRING ["Concealable"]
                    ^"Rarity" INTEGER 7
                    ^"Price" STRING "5 bu"
                    ^"Description" STRING "Made from a length of hollow bamboo or river reed, the blowgun is one of the simplest weapons that ninja use in their work. The blowgun’s primary use is as a ranged weapon, usually to deliver poison (see the Poisoned Weapons sidebar, page 244). In addition to darts, the blowgun can also be loaded with sand, dust, or other powders to blind or disorient foes, and it can even serve to let its user breathe while underwater."
                }
            }

            ^"Kama" DEF {
                PROPERTIES {
                    ^"Category" STRING "Specialist Weapons"
                    ^"Skill" STRING "Martial Arts [Melee]"
                    ^"Range" STRING "0-1"
                    ^"Base Damage" INTEGER 3
                    ^"Deadliness" INTEGER 3
                    ^"Grips" STRING "1-hand: –"
                    ^"Qualities" LIST OF STRING ["Concealable"]
                    ^"Rarity" INTEGER 4
                    ^"Price" STRING "1 koku"
                    ^"Description" STRING "The kama is another weapon adapted from an agricultural implement: in this case, a standard sickle used for harvesting rice. It consists of a short, roughly foot-long wooden haft topped by a long, curved sickle blade. Kama are often used in pairs, sometimes linked at the handles by a length of chain."
                }
            }

            ^"Kusari-Gama" DEF {
                PROPERTIES {
                    ^"Category" STRING "Specialist Weapons"
                    ^"Skill" STRING "Martial Arts [Melee]"
                    ^"Range" STRING "0"
                    ^"Base Damage" INTEGER 3
                    ^"Deadliness" INTEGER 3
                    ^"Grips" STRING "1-hand: –; 2-hand: Range 2-3"
                    ^"Qualities" LIST OF STRING ["Concealable", "Snaring", "Wargear"]
                    ^"Rarity" INTEGER 6
                    ^"Price" STRING "5 koku"
                    ^"Description" STRING "Extremely versatile and deadly, the kusari-gama is one of the more difficult ninja weapons to master. It is a hybrid weapon consisting of a long-hafted kama with a lengthy chain attached to either the back of the blade or the bottom of the haft. A heavy iron weight called a fundo is mounted at the end of the chain. In combat, a wielder typically spins the chain over their head with one hand while holding the kama in the other. They whip the chain forward, entangling an opponent’s weapon or limbs, then rush in for the killing blow with the kama. A wielder can also attack with the weighted end of the chain, striking opponents at range and keeping them at bay."
                }
            }

            ^"Shuriken" DEF {
                PROPERTIES {
                    ^"Category" STRING "Specialist Weapons"
                    ^"Skill" STRING "Martial Arts [Melee]"
                    ^"Range" STRING "0"
                    ^"Base Damage" INTEGER 2
                    ^"Deadliness" INTEGER 4
                    ^"Grips" STRING "1-hand (stab or slash): –; 1-hand (thrown): Martial Arts [Ranged], Range 1-3"
                    ^"Qualities" LIST OF STRING ["Concealable"]
                    ^"Rarity" INTEGER 6
                    ^"Price" STRING "1 koku"
                    ^"Description" STRING "Favored by shinobi, shuriken are small metal discs with a sharpened edge that come in a dizzying array of sizes and styles. They are designed mainly to distract, but shuriken can also be coated with toxins for lethality, and any cutting edge can kill if used properly."
                }
            }
        }

        # ==================
        # UNARMED PROFILES
        # ==================

        # A character always counts as having these Martial Arts [Unarmed]
        # profiles readied, provided the relevant body parts are not occupied
        # (such as with a weapon) or bound.

        UNARMED {
            # A character always counts as having these readied, provided the
            # relevant body parts are not occupied or bound (p. 237). The book's
            # table names the body part alongside each profile.
            ^"Punch" DEF {
                PROPERTIES {
                    ^"Category" STRING "Unarmed"
                    ^"Skill" STRING "Martial Arts [Unarmed]"
                    ^"Body Part" STRING "hand"
                    ^"Range" STRING "0"
                    ^"Base Damage" INTEGER 1
                    ^"Deadliness" INTEGER 2
                    ^"Qualities" LIST OF STRING ["Snaring"]
                }
            }

            ^"Kick" DEF {
                PROPERTIES {
                    ^"Category" STRING "Unarmed"
                    ^"Skill" STRING "Martial Arts [Unarmed]"
                    ^"Body Part" STRING "leg"
                    ^"Range" STRING "1"
                    ^"Base Damage" INTEGER 2
                    ^"Deadliness" INTEGER 1
                    ^"Qualities" LIST OF STRING []
                }
            }

            ^"Bite" DEF {
                PROPERTIES {
                    ^"Category" STRING "Unarmed"
                    ^"Skill" STRING "Martial Arts [Unarmed]"
                    ^"Body Part" STRING "mouth"
                    ^"Range" STRING "0"
                    ^"Base Damage" INTEGER 0
                    ^"Deadliness" INTEGER 3
                    ^"Qualities" LIST OF STRING []
                }
            }
        }

        GUIDANCE {
            ENTRY ^"errata-weapon-improvised-margin-note" #L5RERGvnEOKpQvOud77777 {
                CONCERNS [ ^"Weapon" ]
                TOPICS [ "errata" ]
                TEXT "p. 230: The following margin note should be added: An improvised weapon uses the most similar weapon profile (often a club or a knife), with DMG and DLS reduced by 1, or more at the GM's discretion. They are wielded with Martial Arts [Unarmed]."
            }
        }
    }
}
