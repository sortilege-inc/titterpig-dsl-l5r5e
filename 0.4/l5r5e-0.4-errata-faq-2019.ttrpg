EXTENSION "L5R5e_Errata_FAQ_2019" EXTENDS "L5R5e_Core_Character" {
    NAME "Legend of the Five Rings 5th Edition - Errata and FAQ (September 2019)"
    VERSION "0.4.2"
    SPEC_VERSION "0.4"
    RELEASE_DATE "2026-03-01"

    # Official errata and FAQ for the L5R 5e Core Rulebook and
    # Shadowlands supplement, dated September 25, 2019.
    # Published by Fantasy Flight Games.
    #
    # This extension is a corrections LAYER: each MODIFY block
    # points to the entity it overrides in core/sourcebook data
    # and supplies the corrected value itself under a "# --- correction ---"
    # marker, so the fix applies whether or not the base file was
    # ever hand-patched. FAQ
    # entries are added as new clarification DEFs that reference
    # the rule they clarify. Consumers apply this layer on top
    # of the base content; the underlying files are NOT edited.

    # =================================================================
    # CORE RULEBOOK ERRATA
    # =================================================================

    # ---- Chapter 1 ----

    MODIFY ^"Universal Tiebreaker" {
        PROPERTIES {
            # --- correction ---
            ^"Second Bullet" STRING "Adversary NPCs supersede minion NPCs."

            ^"Source Book"    STRING "Core Rulebook"
            ^"Source Chapter" STRING "Chapter 1"
            ^"Source Page"    STRING "p. 26"
            ^"Errata Note"    STRING "Second bullet should read \"Adversary NPCs supersede minion NPCs.\""
        }
        RULES {
            #L5RER01aB2cD4eF6gH8iJ0k: errata_universal_tiebreaker_adversary_supersedes_minion
        }
    }

    # ---- Chapter 2: Schools ----

    MODIFY ^"Kakita Duelist" {
        PROPERTIES {
            ^"Source Book"    STRING "Core Rulebook"
            ^"Source Chapter" STRING "Chapter 2"
            ^"Source Page"    STRING "p. 65"
            ^"Errata Note"    STRING "Rank 1: \"Iaijutsu Cut: Crossing Cut\" should read \"Iaijutsu Cut: Crossing Blade.\" Also, Curriculum Rank 1 \"Striking as Air\" (kata) should be replaced with \"Cadence\" (shūji)."
        }
        RULES {
            #L5RER02lM3nO5pQ7rS9tU1v: errata_kakita_duelist_crossing_blade
            #L5RER03aX4yZ6aB8cD0eF2g: errata_kakita_duelist_rank_1_cadence_replaces_striking_as_air
        }
    }

    MODIFY ^"Asako Loremaster" {
        PROPERTIES {
            ^"Source Book"    STRING "Core Rulebook"
            ^"Source Chapter" STRING "Chapter 2"
            ^"Source Page"    STRING "p. 74"
            ^"Errata Note"    STRING "Curriculum Rank 2: \"Civility Foremost\" (shūji) should be replaced with \"Tea Ceremony\" (ritual). School Ability first sentence should read: \"...you may treat your ranks in the skill as being equal to your school rank.\""
        }
        RULES {
            #L5RER04bX4yZ6aB8cD0eF2g: errata_asako_loremaster_rank_2_tea_ceremony_replaces_civility_foremost
            #L5RER05hI5jK7lM9nO1pQ3r: errata_asako_loremaster_school_ability_wording
        }
    }

    MODIFY ^"Shiba Guardian" {
        PROPERTIES {
            ^"Source Book"    STRING "Core Rulebook"
            ^"Source Chapter" STRING "Chapter 2"
            ^"Source Page"    STRING "p. 76"
            ^"Errata Note"    STRING "Curriculum Rank 2: \"Iron Forest Style\" (kata) should be replaced with \"Slippery Maneuvers\" (shūji)."
        }
        RULES {
            #L5RER06dE7fG9hI1jK3lM5n: errata_shiba_guardian_rank_2_slippery_maneuvers_replaces_iron_forest_style
        }
    }

    MODIFY ^"Kaito Shrine Keeper" {
        PROPERTIES {
            ^"Source Book"    STRING "Core Rulebook"
            ^"Source Chapter" STRING "Chapter 2"
            ^"Source Page"    STRING "p. 76"
            ^"Errata Note"    STRING "Curriculum Rank 2: \"Pelting Hail Style\" (kata) should be replaced with \"Divination\" (ritual)."
        }
        RULES {
            #L5RER07cD7fG9hI1jK3lM5n: errata_kaito_shrine_keeper_rank_2_divination_replaces_pelting_hail_style
        }
    }

    MODIFY ^"Akodo Commander" {
        PROPERTIES {
            ^"Source Book"    STRING "Core Rulebook"
            ^"Source Chapter" STRING "Chapter 2"
            ^"Source Page"    STRING "p. 79"
            ^"Errata Note"    STRING "Curriculum Rank 1: \"Warrior's Resolve\" (kata) should be replaced with \"Honest Assessment\" (shūji)."
        }
        RULES {
            #L5RER08sT6uV8wX0yZ2aB4c: errata_akodo_commander_rank_1_honest_assessment_replaces_warriors_resolve
        }
    }

    MODIFY ^"Ide Trader" {
        PROPERTIES {
            # --- correction ---
            ^"School Ability Text" STRING "When acquiring, selling, or gifting an item, you may treat its rarity as reduced or increased by your school rank."

            ^"Source Book"    STRING "Core Rulebook"
            ^"Source Chapter" STRING "Chapter 2"
            ^"Source Page"    STRING "p. 82"
            ^"Errata Note"    STRING "School Ability should read: \"When acquiring, selling, or gifting an item, you may treat its rarity as reduced or increased by your school rank.\""
        }
        RULES {
            #L5RER09sT6uV8wX0yZ2aB4c: errata_ide_trader_school_ability_rarity
        }
    }

    MODIFY ^"Shinjo Outrider" {
        PROPERTIES {
            # --- correction ---
            ^"Starting Technique Category Correction" STRING "Lady Shinjo's Speed is a shūji, not a kata"

            ^"Source Book"    STRING "Core Rulebook"
            ^"Source Chapter" STRING "Chapter 2"
            ^"Source Page"    STRING "p. 85"
            ^"Errata Note"    STRING "Starting Techniques: \"Lady Shinjo's Speed\" should be listed as a shūji (not a kata)."
        }
        RULES {
            #L5RER10dE7fG9hI1jK3lM5n: errata_shinjo_outrider_lady_shinjos_speed_is_shuji
        }
    }

    MODIFY ^"Utaku Battle Maiden" {
        PROPERTIES {
            ^"Source Book"    STRING "Core Rulebook"
            ^"Source Chapter" STRING "Chapter 2"
            ^"Source Page"    STRING "p. 86"
            ^"Errata Note"    STRING "Curriculum Rank 1: \"Striking as Air\" (kata) should be replaced with \"Courtier's Resolve\" (shūji)."
        }
        RULES {
            #L5RER11eE7fG9hI1jK3lM5n: errata_utaku_battle_maiden_rank_1_courtiers_resolve_replaces_striking_as_air
        }
    }

    # ---- Chapter 4: Techniques ----

    MODIFY ^"Technique" {
        PROPERTIES {
            ^"Source Book"    STRING "Core Rulebook"
            ^"Source Chapter" STRING "Chapter 4"
            ^"Source Page"    STRING "p. 173"
            ^"Errata Note"    STRING "Second paragraph, first sentence should be replaced with: \"Note that all prerequisites are waived if a character is granted a technique directly during character creation (or at another time), or if the technique appears by name on their curriculum. If a technique is part of a listed group (e.g. \"=Rank 1-3 Kata\"), the character ignores school rank prerequisites, but not other prerequisites (clan, etc.).\" Example: Emerald Magistrate title (p. 305) grants Rank 1-2 Kata, waiving rank (2) and technique group (kata) prereqs, but does NOT grant access to clan-specific techniques like Lord Hida's Grip (p. 176, Crab only) unless named specifically."
        }
        RULES {
            #L5RER12oP8qR0sT2uV4wX6y: errata_prerequisites_waiver_rules
        }
    }

    MODIFY ^"Iaijutsu Cut: Rising Blade" {
        PROPERTIES {
            ^"Source Book"    STRING "Core Rulebook"
            ^"Source Chapter" STRING "Chapter 4"
            ^"Source Page"    STRING "p. 179"
            ^"Errata Note"    STRING "Activation should read: \"As an Attack action using one sheathed Razor-Edged weapon, you may make a Martial Arts [Melee] check targeting one character at range 0-1. The TN of this check is equal to the target's vigilance.\""
        }
        RULES {
            #L5RER13zA9bC1dE3fG5hI7j: errata_iaijutsu_cut_rising_blade_activation
        }
    }

    # ---- Chapter 5: Equipment ----

    # p. 230 adds a margin note that the core book does not have, so this is an
    # ADD of new content (S13), not a MODIFY of a section. Description is the
    # margin note verbatim.
    ADD #b1P4dsDwvusQq8XKsbVaGJ ^"Improvised Weapons" DEF {
        APPLIES TO [^"Game Rules"]
        PROPERTIES {
            ^"Source Book"    STRING "Core Rulebook"
            ^"Source Chapter" STRING "Chapter 5"
            ^"Source Page"    STRING "p. 230"
            ^"Rule Type"      STRING "Margin Note" FIXED
            ^"Description"    STRING "An improvised weapon uses the most similar weapon profile (often a club or a knife), with DMG and DLS reduced by 1, or more at the GM's discretion. They are wielded with Martial Arts [Unarmed]."
        }
        RULES {
            #L5RER14kL0mN2oP4qR6sT8u: errata_improvised_weapons_margin_note
        }
    }

    MODIFY ^"Zanbatō" {
        PROPERTIES {
            # --- correction ---
            ^"Base Damage" INTEGER 6
            ^"Deadliness" INTEGER 7

            ^"Source Book"    STRING "Core Rulebook"
            ^"Source Chapter" STRING "Chapter 5"
            ^"Source Page"    STRING "p. 231"
            ^"Errata Note"    STRING "Table 5-1: Weapons, Zanbatō entry: DMG should be 6, DLS should be 7."
            ^"Corrected Damage"     INTEGER 6
            ^"Corrected Deadliness" INTEGER 7
        }
        RULES {
            #L5RER15vW1xY3zA5bC7dE9f: errata_zanbato_dmg6_dls7
        }
    }

    # ---- Chapter 6: Conflict ----

    MODIFY ^"Scheme Action" {
        PROPERTIES {
            # --- correction ---
            ^"Action Name" STRING "Scheme action"

            ^"Source Book"    STRING "Core Rulebook"
            ^"Source Chapter" STRING "Chapter 6"
            ^"Source Pages"   STRING "p. 241, 257, 263, 273"
            ^"Errata Note"    STRING "All instances of \"Intrigue action\" should read \"Scheme action.\""
        }
        RULES {
            #L5RER16gH2iJ4kL6mN8oP0q: errata_intrigue_action_to_scheme_action
        }
    }

    MODIFY ^"Wait" {
        PROPERTIES {
            ^"Source Book"    STRING "Core Rulebook"
            ^"Source Chapter" STRING "Chapter 6"
            ^"Source Page"    STRING "p. 264"
            ^"Errata Note"    STRING "Wait (Action), Activation: First clause should read \"As an Attack, Scheme, and Support action.\""
        }
        RULES {
            #L5RER17rS3tU5vW7xY9zA1b: errata_wait_action_activation
        }
    }

    # ---- Chapter 7: Adventuring ----

    MODIFY ^"Target Number" {
        PROPERTIES {
            # --- correction ---
            ^"Example" STRING "TN 3 Fitness Check (Earth 1, Fire 4)"

            ^"Source Book"    STRING "Core Rulebook"
            ^"Source Chapter" STRING "Chapter 7"
            ^"Source Page"    STRING "p. 296"
            ^"Errata Note"    STRING "Example: \"TN 3 Fitness Check (Earth 1, Fire 4)\" — Fire approach TN should be 4 (not 3)."
        }
        RULES {
            #L5RER18cD4eF6gH8iJ0kL2m: errata_varying_difficulty_fire_tn4
        }
    }

    MODIFY ^"Emerald Magistrate" {
        PROPERTIES {
            # --- correction ---
            ^"Title Ability" STRING "Voice of Authority"
            ^"Status Award" STRING "+15 (to a maximum of 40)"

            ^"Source Book"    STRING "Core Rulebook"
            ^"Source Chapter" STRING "Chapter 7"
            ^"Source Page"    STRING "p. 305"
            ^"Errata Note"    STRING "Title ability should be included: \"Voice of Authority (Title Ability): Once per game session when making a Scheme or Support action check using a Social skill, you may choose additional targets equal to your Glory rank. You cannot choose any additional target with vigilance higher than the highest among your initial targets.\" Also, Status Award: +15 (to a minimum of 40)."
            ^"Title Ability Name"  STRING "Voice of Authority"
            ^"Status Award"        INTEGER 15
            ^"Status Award Floor"  INTEGER 40
        }
        RULES {
            #L5RER19nO5pQ7rS9tU1vW3x: errata_emerald_magistrate_voice_of_authority
        }
    }

    # ---- Chapter 8: Origins ----

    MODIFY ^"Peasant Family" {
        PROPERTIES {
            # --- correction ---
            ^"Skill Increases" STRING "+1 to any two Trade skills of your choice"

            ^"Source Book"    STRING "Core Rulebook"
            ^"Source Chapter" STRING "Chapter 8"
            ^"Source Page"    STRING "p. 306"
            ^"Errata Note"    STRING "Skill Increase should read: \"+1 to any two Trade skills of your choice.\""
        }
        RULES {
            #L5RER20yZ6aB8cD0eF2gH4i: errata_peasant_family_two_trade_skills
        }
    }

    # ---- Chapter 9: Adversaries ----

    MODIFY ^"Manifest Fire Kami" {
        PROPERTIES {
            ^"Source Book"    STRING "Core Rulebook"
            ^"Source Chapter" STRING "Chapter 9"
            ^"Source Page"    STRING "p. 324"
            ^"Errata Note"    STRING "Earth Ring should be 2, Fire Ring should be 6."
            ^"Corrected Earth Ring" INTEGER 2
            ^"Corrected Fire Ring"  INTEGER 6
        }
        RULES {
            #L5RER21jK7lM9nO1pQ3rS5t: errata_manifest_fire_kami_earth2_fire6
        }
    }

    # ---- Appendix ----

    MODIFY ^"Opportunity" {
        PROPERTIES {
            ^"Source Book"    STRING "Core Rulebook"
            ^"Source Chapter" STRING "Appendix"
            ^"Source Page"    STRING "p. 328"
            ^"Errata Note"    STRING "Table 8-1: Opportunities, Conflict and Martial Skill Examples of (op), Fire, Entry 1: Should read \"Choose another character in the scene; increase the TN of the next check they make before the start of your next turn if it does not include you as a target.\""
        }
        RULES {
            #L5RER22uV8wX0yZ2aB4cD6e: errata_fire_opportunity_target_exclusion
        }
    }

    # =================================================================
    # SHADOWLANDS ERRATA
    # =================================================================

    MODIFY ^"Moto Avenger" {
        PROPERTIES {
            ^"Source Book"    STRING "Shadowlands"
            ^"Source Chapter" STRING "Chapter 2"
            ^"Source Page"    STRING "p. 93"
            ^"Errata Note"    STRING "Starting outfit should include \"Unicorn warhorse (see page 326 of the core rulebook).\""
        }
        RULES {
            #L5RER23fG9hI1jK3lM5nO7p: errata_moto_avenger_starting_warhorse
        }
    }

    # =================================================================
    # FAQ: CHARACTER ADVANCEMENT
    # =================================================================

    ^"FAQ: Multiple Purchases Toward Rank (2019)" DEF {
        APPLIES TO [^"Game Rules"]
        PROPERTIES {
            ^"Source Document" STRING "L5R5e FAQ September 2019"
            ^"Clarifies"       STRING "Curriculum: Counting purchases toward school rank"
            ^"Question"        STRING "Can a character count multiple purchases from a single entry on the current school rank of their curriculum toward their current school rank?"
            ^"Answer"          STRING "Yes. A character can count any number of purchases of ranks of a skill or skill group or techniques from a listed category (e.g., \"Kata Rank 1-2\") toward their current school rank."
        }
        RULES {
            #L5RER24qR0sT2uV4wX6yZ8a: faq_multiple_purchases_count_toward_rank
        }
    }

    ^"FAQ: Special Access Does Not Persist (2019)" DEF {
        APPLIES TO [^"Game Rules"]
        PROPERTIES {
            ^"Source Document" STRING "L5R5e FAQ September 2019"
            ^"Clarifies"       STRING "Curriculum: '=' symbol special-access scope"
            ^"Question"        STRING "If a character has access to an advancement with the = symbol that they could not normally purchase at a specific school rank or via a specific title, can they purchase it after completing that rank or title?"
            ^"Answer"          STRING "No. The special access to purchase that advancement does not persist once the rank is completed."
        }
        RULES {
            #L5RER25bC1dE3fG5hI7jK9l: faq_special_access_does_not_persist
        }
    }

    # =================================================================
    # FAQ: SCHOOL ABILITIES
    # =================================================================

    ^"FAQ: Asahina Artificer Ability Scope (2019)" DEF {
        APPLIES TO [^"Game Rules"]
        PROPERTIES {
            ^"Source Document" STRING "L5R5e FAQ September 2019"
            ^"Clarifies"       STRING "Asahina Artificer school ability scope"
            ^"Question"        STRING "When does the Asahina Artificer's school ability apply?"
            ^"Answer"          STRING "It applies to invocations using the listed keywords to: summon an illusion (e.g., Token of Memory, Matsu's Battlecry); summon an object (any manifestation of an element that is not a being like a Manifest Kami, e.g., Blessed Wind, Katana of Fire, Earthquake); augment an object (e.g., Cloak of Night, Armor of Radiance); awaken an object (e.g., the school's Mastery Ability)."
        }
        RULES {
            #L5RER26mN2oP4qR6sT8uV0w: faq_asahina_artificer_ability_applies_to
        }
    }

    ^"FAQ: Matsu Berserker Enraged Trigger (2019)" DEF {
        APPLIES TO [^"Game Rules"]
        PROPERTIES {
            ^"Source Document" STRING "L5R5e FAQ September 2019"
            ^"Clarifies"       STRING "Matsu Berserker school ability and Enraged condition"
            ^"Source Page"     STRING "p. 73"
            ^"Question"        STRING "Can a Matsu Berserker's school ability (p. 73) trigger even if already suffering the Enraged condition?"
            ^"Answer"          STRING "Yes. May suffer Enraged to trigger ability even while already Enraged (only one instance per Persistent Effects, p. 174)."
        }
        RULES {
            #L5RER27pQ7rS9tU1vW3xY5z: faq_matsu_berserker_enraged_stacking
        }
    }

    # =================================================================
    # FAQ: TECHNIQUES
    # =================================================================

    ^"FAQ: Iaijutsu Cut Requires One-Handed Grip (2019)" DEF {
        APPLIES TO [^"Game Rules"]
        PROPERTIES {
            ^"Source Document" STRING "L5R5e FAQ September 2019"
            ^"Clarifies"       STRING "Iaijutsu Cut techniques and weapon grip requirements"
            ^"Source Page"     STRING "p. 179"
            ^"Question"        STRING "Can Iaijutsu Cut techniques (p. 179) be performed with a weapon that has no one-handed grip (naginata, nodachi)?"
            ^"Answer"          STRING "No. These techniques instruct readying in one-handed grip. If the weapon has no one-handed grip, it is drawn but not readied, producing no base damage/deadliness/properties."
        }
        RULES {
            #L5RER28xY3zA5bC7dE9fG1h: faq_iaijutsu_cut_requires_one_handed_grip
        }
    }

    ^"FAQ: NPC Body Weapon Not Pickupable (2019)" DEF {
        APPLIES TO [^"Game Rules"]
        PROPERTIES {
            ^"Source Document" STRING "L5R5e FAQ September 2019"
            ^"Clarifies"       STRING "NPC body-weapon profiles and item interaction"
            ^"Question"        STRING "Can a character pick up and wield a weapon profile that is part of an NPC's body?"
            ^"Answer"          STRING "No. It only has that profile as part of the NPC's body. A severed limb or broken tusk counts as an improvised weapon (club/knife)."
        }
        RULES {
            #L5RER29iJ4kL6mN8oP0qR2s: faq_npc_body_weapon_not_pickupable
        }
    }

    ^"FAQ: Crimson Leaves / Coiling Serpent vs Unarmed (2019)" DEF {
        APPLIES TO [^"Game Rules"]
        PROPERTIES {
            ^"Source Document" STRING "L5R5e FAQ September 2019"
            ^"Clarifies"       STRING "Disarm/restrain techniques vs unarmed attack profiles"
            ^"Source Page"     STRING "p. 237"
            ^"Question"        STRING "Can Crimson Leaves Strike or Coiling Serpent Style be used to disarm or restrain unarmed attack profiles?"
            ^"Answer"          STRING "No. Unarmed profiles function like weapons for many things but are not strictly considered weapons (per p. 237)."
        }
        RULES {
            #L5RER30tU5vW7xY9zA1bC3d: faq_crimson_leaves_coiling_serpent_not_vs_unarmed
        }
    }

    ^"FAQ: NPC Body Weapons Treated as Unarmed (2019)" DEF {
        APPLIES TO [^"Game Rules"]
        PROPERTIES {
            ^"Source Document" STRING "L5R5e FAQ September 2019"
            ^"Clarifies"       STRING "NPC body-weapon profiles + disarm/restrain interaction"
            ^"Question"        STRING "Can Crimson Leaves Strike and Coiling Serpent Style be used to disarm or restrain an NPC's weapon profile that is part of its body?"
            ^"Answer"          STRING "No. These are treated as unarmed profiles and cannot be affected by those techniques."
        }
        RULES {
            #L5RER31eF6gH8iJ0kL2mN4o: faq_npc_body_weapons_treated_as_unarmed
        }
    }

    # =================================================================
    # FAQ: LORE
    # =================================================================

    ^"FAQ: Kisshoten Eight Great Fortunes Discrepancy (2019)" DEF {
        APPLIES TO [^"Game Rules"]
        PROPERTIES {
            ^"Source Document" STRING "L5R5e FAQ September 2019"
            ^"Clarifies"       STRING "Discrepancy between Core Rulebook and Emerald Empire on the Eight Great Fortunes"
            ^"Question"        STRING "Why is Kisshōten noted as one of the Eight Great Fortunes in the core rulebook, but isn't in Emerald Empire?"
            ^"Answer"          STRING "Kisshōten is widely considered one of the Eight Great Fortunes, though some in Rokugan disagree. Those dissenters managed to remove Kisshōten's entry from Emerald Empire."
        }
        RULES {
            #L5RER32aB8cD0eF2gH4iJ6k: faq_kisshoten_eight_great_fortunes_discrepancy
        }
    }
}
