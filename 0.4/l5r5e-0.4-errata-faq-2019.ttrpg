EXTENSION "L5R5e_Errata_FAQ_2019" EXTENDS "L5R5e_Core_Character" {
    NAME "Legend of the Five Rings 5th Edition - Errata and FAQ (September 2019)"
    VERSION "0.4.4"
    SPEC_VERSION "0.4"
    RELEASE_DATE "2026-03-01"

    # Official errata and FAQ for the L5R 5e Core Rulebook and
    # Shadowlands supplement, dated September 25, 2019.
    # Published by Fantasy Flight Games.
    #
    # This extension is a corrections LAYER: each MODIFY block
    # points to the entity it overrides in core/sourcebook data
    # and supplies the corrected value itself under a "# --- correction ---"
    # marker, so the fix applies whether or not the base file was
    # ever hand-patched. FAQ
    # entries are added as new clarification DEFs that reference
    # the rule they clarify. Consumers apply this layer on top
    # of the base content; the underlying files are NOT edited.

    # =================================================================
    # CORE RULEBOOK ERRATA
    # =================================================================

    # ---- Chapter 1 ----

    MODIFY ^"Universal Tiebreaker" {

        # When effects that break ties still result in a stalemate:
        # - PCs supersede NPCs
        # - Adversary NPCs supersede minion NPCs
        # If there is still a tie, the GM should use a randomized
        # means (coin flip, rock-paper-scissors, etc.).

        GUIDANCE {
            ENTRY ^"errata-universal-tiebreaker-0" #L5RERG0TplpshcZa3oDYQ3 {
                CONCERNS [ ^"Universal Tiebreaker" ]
                TOPICS [ "errata" ]
                TEXT "p. 26, Margin Note 'Universal Tiebreaker': The second bullet should read 'Adversary NPCs supersede minion NPCs'"
            }
        }
    }

    MODIFY ^"Kakita Duelist" {
        EXTENDS #L5R252wX4yZ6aB8cD0eF2g ^"School"
        APPLIES TO [^"Samurai"]

        # The Kakita Duelist School emphasizes "one strike, one kill,"
        # seeking for its students to master the one perfect strike performed
        # in an iaijutsu duel. For the Kakita Duelists, such is the pinnacle
        # of all martial skills.

        PROPERTIES {
            ^"School Name" STRING "Kakita Duelist" FIXED
            ^"Clan" STRING "Crane"
            ^"Roles" LIST ["Bushi", "Artisan"]
            ^"Ring Increase" DEF {
                ^"Air" INTEGER 1
                ^"Earth" INTEGER 1
            }
            ^"Starting Skills" DEF { CHOOSE 5 [^"Courtesy", ^"Design", ^"Fitness", ^"Martial Arts [Melee]", ^"Meditation", ^"Sentiment", ^"Smithing"] INTEGER 1 }
            ^"Starting Honor" INTEGER DEFAULT 50
            ^"Techniques Available" LIST ["Kata", "Rituals", "Shūji"]
        }

        STARTING_TECHNIQUES {
            KATA ^"Iaijutsu Cut: Rising Blade"
            SHUJI CHOOSE 1 [^"Shallow Waters", ^"Weight of Duty"]
        }

        SCHOOL_ABILITY "Way of the Crane" {
            "Once per round, you may increase or decrease the severity of a critical strike you inflict by an amount up to your school rank."
        }

        MASTERY_ABILITY ^"Strike with No Thought" {
            # "Strike with No Thought" has opportunity effects:
            # (op)+: One character of your choice at range 0-2 of your target
            #   per (op) spent this way suffers the Dazed and Disoriented conditions.
            # (op)(op)+: Treat the maximum range of this technique as 1 higher
            #   per (op)(op) spent this way.
            "Once per scene, as an Attack and Movement action, you may make a Martial Arts [Melee] (Void) check targeting one character at range 2-3 using a sheathed katana or wakizashi. The TN of this check is equal to your target's vigilance. You immediately move to range 1 of your target and draw the weapon you used. If you succeed, your target suffers a critical strike with severity equal to the deadliness of your weapon plus your bonus successes. (op)+: One character of your choice at range 0-2 of your target per (op) spent this way suffers the Dazed and Disoriented conditions. (op)(op)+: Treat the maximum range of this technique as 1 higher per (op)(op) spent this way."
        }

        STARTING_OUTFIT [
            "Traveling clothes", "ceremonial clothes",
            "daishō (katana and wakizashi)",
            "yari (spear) or yumi (bow)", "quiver of arrows",
            "traveling pack",
            "an attendant or Rokugani pony"
        ]

        CURRICULUM {
            RANK 1 {
                SKILL_GROUP "Martial Skills"
                SKILL "Aesthetics"
                SKILL "Courtesy"
                SKILL "Sentiment"
                TECHNIQUE_GROUP "Rank 1 Kata"
                ^"Iaijutsu Cut: Crossing Blade" [kata]
                ^"Cadence" [shuji]
            }
            RANK 2 {
                SKILL_GROUP "Scholar Skills"
                SKILL "Martial Arts [Melee]"
                SKILL "Martial Arts [Ranged]"
                SKILL "Smithing"
                TECHNIQUE_GROUP "Rank 1-2 Kata"
                ^"All Arts Are One" [shuji]
                ^"Thunderclap Strike" [kata]
            }
            RANK 3 {
                SKILL_GROUP "Artisan Skills"
                SKILL "Martial Arts [Melee]"
                SKILL "Meditation"
                SKILL "Survival"
                TECHNIQUE_GROUP "Rank 1-3 Air Shūji"
                ^"A Samurai's Fate" [shuji]
                ^"Heartpiercing Strike" [kata]
            }
            RANK 4 {
                SKILL_GROUP "Social Skills"
                SKILL "Fitness"
                SKILL "Tactics"
                SKILL "Martial Arts [Melee]"
                TECHNIQUE_GROUP "Rank 1-4 Kata"
                ^"Striking as Void" [kata]
                ^"Pillar of Calm" [shuji]
            }
            RANK 5 {
                SKILL_GROUP "Martial Skills"
                SKILL "Aesthetics"
                SKILL "Survival"
                SKILL "Theology"
                TECHNIQUE_GROUP "Rank 1-5 Fire Shūji"
                ^"Soul Sunder" [kata]
                ^"Rouse the Soul" [shuji]
            }
            RANK 6 {
                ^"Strike with No Thought"
            }
        }

        GUIDANCE {
            ENTRY ^"errata-kakita-duelist-0" #L5RERGPxLe6TAbQob4wQuY {
                CONCERNS [ ^"Kakita Duelist" ]
                TOPICS [ "errata" ]
                TEXT "p. 65, Kakita Duelist (Rank 1): Replace Striking as Air ⤵ with Cadence ⟲ p. 74, Asako Loremaster (Rank 2): Replace Civility Foremost ⟲ with Tea Ceremony ⚗ p. 76, Shiba Guardian (Rank 2): Replace Iron Forest Style ⤵ with Slippery Maneuvers ⟲ p. 76, Kaito Shrine Keeper (Rank 2): Replace Pelting Hail Style ⤵ with Divination ⚗ p. 79, Akodo Commander (Rank 1): Replace Warrior's Resolve ⤵ with Honest Assessment ⟲ p. 86, Utaku Battle Maiden (Rank 1): Replace Striking as Air ⤵ with Courtier's Resolve ⟲"
            }
            ENTRY ^"errata-kakita-duelist-1" #L5RERG3Aax2pkALF383eUR {
                CONCERNS [ ^"Kakita Duelist" ]
                TOPICS [ "errata" ]
                TEXT "p. 65, Kakita Duelist (Rank 1): 'Iaijutsu Cut: Crossing Cut' should read 'Iaijutsu Cut: Crossing Blade.'"
            }
        }
    }

    MODIFY ^"Asako Loremaster" {
        EXTENDS #L5R252wX4yZ6aB8cD0eF2g ^"School"
        APPLIES TO [^"Samurai"]

        # The Asako Loremasters study widely, and from that broad and firm base,
        # they develop their specialties. It is rare for a Loremaster not to have
        # at least passing knowledge of a subject, no matter how obscure. Acting
        # as the courtiers of the Phoenix, the Asako Loremasters marshal arguments
        # based on their expertise in the revered knowledge of the past. One should
        # look for an Asako first in the library and then in court, usually deep in
        # discussion. Few care to challenge an Asako Loremaster on the field of
        # knowledge, but such disputations are often one of the highlights of court.

        PROPERTIES {
            ^"School Name" STRING "Asako Loremaster" FIXED
            ^"Clan" STRING "Phoenix"
            ^"Roles" LIST ["Courtier"]
            ^"Ring Increase" DEF {
                ^"Air" INTEGER 1
                ^"Earth" INTEGER 1
            }
            ^"Starting Skills" DEF { CHOOSE 5 [^"Culture", ^"Government", ^"Martial Arts [Unarmed]", ^"Medicine", ^"Performance", ^"Sentiment", ^"Theology"] INTEGER 1 }
            ^"Starting Honor" INTEGER DEFAULT 45
            ^"Techniques Available" LIST ["Kata", "Rituals", "Shūji"]
        }

        STARTING_TECHNIQUES {
            SHUJI ^"Civility Foremost"
            SHUJI CHOOSE 1 [^"Ancestry Unearthed", ^"Cadence"]
        }

        SCHOOL_ABILITY "Wisdom of the Ages" {
            "When performing a Scholar skill check, you may treat your ranks in the skill as being equal to your school rank. If your ranks in that Scholar skill are equal to or higher than your school rank, or if you have 5 ranks in the skill, you may add one kept (ring) set to an (op) result instead."
        }

        MASTERY_ABILITY ^"Insufferable Genius" {
            "After you succeed at a check to acquire or remember information, you may spend 1 Void point and choose any number of characters with whom you can communicate. You must describe how the knowledge you acquired helps each character you choose. Each of those characters reduces the TN of their next check by 1 (to a minimum of 1) and suffers 1 strife."
        }

        STARTING_OUTFIT [
            "Ceremonial robes", "sanctified robes",
            "traveling clothes",
            "wakizashi (short sword)", "knife",
            "scroll satchel", "calligraphy set", "traveling pack"
        ]

        CURRICULUM {
            RANK 1 {
                SKILL_GROUP "Scholar Skills"
                SKILL "Courtesy"
                SKILL "Games"
                SKILL "Martial Arts [Unarmed]"
                TECHNIQUE_GROUP "Rank 1 Earth Shūji"
                ^"Open-Hand Style" [kata]
                ^"Divination" [ritual]
            }
            RANK 2 {
                SKILL_GROUP "Social Skills"
                SKILL "Government"
                SKILL "Medicine"
                SKILL "Sentiment"
                TECHNIQUE_GROUP "Rank 1-2 Air Shūji"
                ^"All Arts are One" [shuji]
                ^"Tea Ceremony" [ritual]
            }
            RANK 3 {
                SKILL_GROUP "Scholar Skills"
                SKILL "Courtesy"
                SKILL "Performance"
                SKILL "Meditation"
                TECHNIQUE_GROUP "Rank 1-3 Fire Shūji"
                ^"Pillar of Calm" [shuji]
                ^"Ebb and Flow" [shuji]
            }
            RANK 4 {
                SKILL_GROUP "Social Skills"
                SKILL "Culture"
                SKILL "Medicine"
                SKILL "Theology"
                TECHNIQUE_GROUP "Rank 1-4 Earth Shūji"
                ^"Cleansing Spirit" [kiho]
                ^"Wolf's Proposal" [shuji]
            }
            RANK 5 {
                SKILL_GROUP "Scholar Skills"
                SKILL "Courtesy"
                SKILL "Performance"
                SKILL "Meditation"
                TECHNIQUE_GROUP "Rank 1-5 Water Shūji"
                ^"Still the Elements" [kiho]
                ^"Bend with the Storm" [shuji]
            }
            RANK 6 {
                ^"Insufferable Genius"
            }
        }

        GUIDANCE {
            ENTRY ^"errata-asako-loremaster-0" #L5RERGIu8I2BEElbbx0jSc {
                CONCERNS [ ^"Asako Loremaster" ]
                TOPICS [ "errata" ]
                TEXT "p. 65, Kakita Duelist (Rank 1): Replace Striking as Air ⤵ with Cadence ⟲ p. 74, Asako Loremaster (Rank 2): Replace Civility Foremost ⟲ with Tea Ceremony ⚗ p. 76, Shiba Guardian (Rank 2): Replace Iron Forest Style ⤵ with Slippery Maneuvers ⟲ p. 76, Kaito Shrine Keeper (Rank 2): Replace Pelting Hail Style ⤵ with Divination ⚗ p. 79, Akodo Commander (Rank 1): Replace Warrior's Resolve ⤵ with Honest Assessment ⟲ p. 86, Utaku Battle Maiden (Rank 1): Replace Striking as Air ⤵ with Courtier's Resolve ⟲"
            }
            ENTRY ^"errata-asako-loremaster-1" #L5RERGNIJOHelWSMlrD7GI {
                CONCERNS [ ^"Asako Loremaster" ]
                TOPICS [ "errata" ]
                TEXT "p. 74, Asako Loremaster, School Ability: The first sentence should read: '...you may treat your ranks in the skill as being equal to your school rank.'"
            }
        }
    }

    MODIFY ^"Shiba Guardian" {
        EXTENDS #L5R252wX4yZ6aB8cD0eF2g ^"School"
        APPLIES TO [^"Samurai"]

        # As Shiba swore to protect Isawa, so the Shiba Guardian School emphasizes
        # the defense of and cooperation with the Isawa; its members complement
        # and protect priests, shrine keepers, and shugenja. The Shiba Guardians
        # are broadly trained, often as much scholars as warriors, and they approach
        # conflict as a problem to be solved without bloodshed if possible. Those
        # who underestimate them due to their reluctance to take a life usually only
        # do so once: the Shiba Guardians are as devoted to the perfection of the
        # martial arts as any samurai. Their commitment to theological study and
        # long hours of meditation have taught the Shiba Guardians how to dance
        # in harmony with elemental kami called forth by the invocations of the
        # shugenja.

        PROPERTIES {
            ^"School Name" STRING "Shiba Guardian" FIXED
            ^"Clan" STRING "Phoenix"
            ^"Roles" LIST ["Bushi", "Courtier"]
            ^"Ring Increase" DEF {
                ^"Earth" INTEGER 1
                ^"Water" INTEGER 1
            }
            ^"Starting Skills" DEF { CHOOSE 5 [^"Courtesy", ^"Fitness", ^"Martial Arts [Melee]", ^"Meditation", ^"Survival", ^"Tactics", ^"Theology"] INTEGER 1 }
            ^"Starting Honor" INTEGER DEFAULT 45
            ^"Techniques Available" LIST ["Kata", "Rituals", "Shūji"]
        }

        STARTING_TECHNIQUES {
            KATA ^"Lord Shiba's Valor"
            KATA CHOOSE 1 [^"Striking as Earth", ^"Striking as Water"]
        }

        SCHOOL_ABILITY "Way of the Phoenix" {
            "Once per scene, when a character at range 0-3 makes a check that contains 1 or more (st) symbols, you may negate all of those (st) symbols. Then, that character removes strife and fatigue equal to your school rank."
        }

        MASTERY_ABILITY ^"Stand of Honor" {
            "At the end of your turn, you may spend 1 Void point to prepare to fend off advancing foes; this effect persists until the start of your next turn. When an enemy enters the range of one of your readied weapons, you may immediately make a Strike action using that weapon and targeting that enemy; if you succeed, the target suffers the Immobilized condition in addition to any other effects."
        }

        STARTING_OUTFIT [
            "Ashigaru armor", "traveling clothes",
            "daishō (katana and wakizashi)",
            "naginata (polearm) or yari (spear)",
            "traveling pack"
        ]

        CURRICULUM {
            RANK 1 {
                SKILL_GROUP "Martial Skills"
                SKILL "Courtesy"
                SKILL "Sentiment"
                SKILL "Survival"
                TECHNIQUE_GROUP "Rank 1 Kata"
                ^"Civility Foremost" [shuji]
                ^"Stirring the Embers" [shuji]
            }
            RANK 2 {
                SKILL_GROUP "Scholar Skills"
                SKILL "Fitness"
                SKILL "Meditation"
                SKILL "Martial Arts [Melee]"
                TECHNIQUE_GROUP "Rank 1-2 Kata"
                ^"Rallying Cry" [shuji]
                ^"Slippery Maneuvers" [shuji]
            }
            RANK 3 {
                SKILL_GROUP "Social Skills"
                SKILL "Culture"
                SKILL "Meditation"
                SKILL "Martial Arts [Melee]"
                TECHNIQUE_GROUP "Rank 1-3 Water Shūji"
                ^"A Samurai's Fate" [shuji]
                ^"Touchstone of Courage" [shuji]
            }
            RANK 4 {
                SKILL_GROUP "Scholar Skills"
                SKILL "Command"
                SKILL "Martial Arts [Melee]"
                SKILL "Tactics"
                TECHNIQUE_GROUP "Rank 1-4 Kata"
                ^"The Immovable Hand of Peace" [shuji]
                ^"Touch the Void Dragon" [kiho]
            }
            RANK 5 {
                SKILL_GROUP "Martial Skills"
                SKILL "Sentiment"
                SKILL "Survival"
                SKILL "Theology"
                TECHNIQUE_GROUP "Rank 1-5 Earth Shūji"
                ^"Way of the Edgeless Sword" [kiho]
                ^"Rouse the Soul" [shuji]
            }
            RANK 6 {
                ^"Stand of Honor"
            }
        }

        GUIDANCE {
            ENTRY ^"errata-shiba-guardian-0" #L5RERGd9hGMuCQBrlA0gZ3 {
                CONCERNS [ ^"Shiba Guardian" ]
                TOPICS [ "errata" ]
                TEXT "p. 65, Kakita Duelist (Rank 1): Replace Striking as Air ⤵ with Cadence ⟲ p. 74, Asako Loremaster (Rank 2): Replace Civility Foremost ⟲ with Tea Ceremony ⚗ p. 76, Shiba Guardian (Rank 2): Replace Iron Forest Style ⤵ with Slippery Maneuvers ⟲ p. 76, Kaito Shrine Keeper (Rank 2): Replace Pelting Hail Style ⤵ with Divination ⚗ p. 79, Akodo Commander (Rank 1): Replace Warrior's Resolve ⤵ with Honest Assessment ⟲ p. 86, Utaku Battle Maiden (Rank 1): Replace Striking as Air ⤵ with Courtier's Resolve ⟲"
            }
        }
    }

    MODIFY ^"Kaito Shrine Keeper" {
        EXTENDS #L5R252wX4yZ6aB8cD0eF2g ^"School"
        APPLIES TO [^"Samurai"]

        # Kaito Shrine Keepers work alongside priests to protect temples across
        # Phoenix lands, or keep smaller shrines on their own. The Kaito learn
        # mystical arts to propitiate the kami -- sometimes even serving as vessels
        # for them -- and practical ones to maintain the shrines. Shrine Keepers
        # make use of protective magic -- such as ofuda, paper charms -- and
        # spiritually enhanced archery to defend shrines against threats both
        # mystical and mundane.

        PROPERTIES {
            ^"School Name" STRING "Kaito Shrine Keeper" FIXED
            ^"Clan" STRING "Phoenix"
            ^"Roles" LIST ["Monk"]
            ^"Ring Increase" DEF {
                ^"Air" INTEGER 1
                ^"Water" INTEGER 1
            }
            ^"Starting Skills" DEF { CHOOSE 4 [^"Fitness", ^"Martial Arts [Ranged]", ^"Meditation", ^"Performance", ^"Smithing", ^"Theology"] INTEGER 1 }
            ^"Starting Honor" INTEGER DEFAULT 45
            ^"Techniques Available" LIST ["Kata", "Rituals", "Shūji"]
        }

        STARTING_TECHNIQUES {
            KATA ^"Hawk's Precision"
            INVOCATION ^"Tempest of Air"
            RITUAL CHOOSE 2 [^"Cleansing Rite", ^"Commune with the Spirits", ^"Threshold Barrier"]
        }

        SCHOOL_ABILITY "Sacred Arrows" {
            "As an action, you may augment one of your arrows with a prayer to the kami. Make the check to perform one invocation you know, reducing the TN by your school rank, and record the result. The arrow gains the Sacred quality, and remains infused with the invocation until the end of the scene. After you perform an Attack action using the arrow (or fire it at a location, at the GM's discretion), you may resolve the effects of the invocation from the place the arrow landed. You may spend (op)+ to delay resolving the effects of the invocation for 1 round per (op) spent this way, and may spend (op) (op) from a failed check to affect one target of the attack that you missed."
        }

        MASTERY_ABILITY ^"Demon, Begone!" {
            "As an action, you may make a TN 3 Meditation (Void) check by plucking the string of a bow you are wielding, targeting each Otherworldly being within a number of range bands equal to your ranks in Meditation. If you succeed, each target suffers strife equal to your ranks in Meditation plus your bonus successes. (op): Each target must resist with a TN 3 Meditation (Void) check or treat its physical and supernatural resistances as 0. This effect persists until the end of the scene."
        }

        STARTING_OUTFIT [
            "Sanctified robes",
            "wakizashi (short sword)",
            "yumi (bow)", "quiver of arrows",
            "bō (staff) or knife",
            "scroll satchel", "traveling pack"
        ]

        # The Kaito Shrine Keepers make themselves vessels in which kami may
        # dwell, and so they know their invocations by the Fortunist name of the
        # spirit they are invoking.
        # (See ^"Invocation Names and Traditions")

        CURRICULUM {
            RANK 1 {
                SKILL_GROUP "Scholar Skills"
                SKILL "Fitness"
                SKILL "Martial Arts [Ranged]"
                SKILL "Meditation"
                TECHNIQUE_GROUP "Rank 1 Air Invocations"
                ^"Bind the Shadow" [invocation]
                ^"Striking as Air" [kata]
            }
            RANK 2 {
                SKILL_GROUP "Martial Skills"
                SKILL "Performance"
                SKILL "Theology"
                SKILL "Smithing"
                TECHNIQUE_GROUP "Rank 1-2 Kata"
                ^"Grasp of the Air Dragon" [invocation]
                ^"Divination" [ritual]
            }
            RANK 3 {
                SKILL_GROUP "Social Skills"
                SKILL "Labor"
                SKILL "Medicine"
                SKILL "Survival"
                TECHNIQUE_GROUP "Rank 1-3 Water Invocations"
                ^"Breath of Wind Style" [kata]
                ^"Flowing Water Strike" [kata]
            }
            RANK 4 {
                SKILL_GROUP "Scholar Skills"
                SKILL "Fitness"
                SKILL "Martial Arts [Ranged]"
                SKILL "Meditation"
                TECHNIQUE_GROUP "Rank 1-4 Kata"
                ^"Rise, Air" [invocation]
                ^"Soul Sunder" [kata]
            }
            RANK 5 {
                SKILL_GROUP "Martial Skills"
                SKILL "Command"
                SKILL "Sentiment"
                SKILL "Theology"
                TECHNIQUE_GROUP "Rank 1-5 Fire Invocations"
                ^"Tomb of Jade" [invocation]
                ^"Pin the Fan" [kata]
            }
            RANK 6 {
                ^"Demon, Begone!"
            }
        }

        GUIDANCE {
            ENTRY ^"errata-kaito-shrine-keeper-0" #L5RERGBYXxgEZx2LkMH274 {
                CONCERNS [ ^"Kaito Shrine Keeper" ]
                TOPICS [ "errata" ]
                TEXT "p. 65, Kakita Duelist (Rank 1): Replace Striking as Air ⤵ with Cadence ⟲ p. 74, Asako Loremaster (Rank 2): Replace Civility Foremost ⟲ with Tea Ceremony ⚗ p. 76, Shiba Guardian (Rank 2): Replace Iron Forest Style ⤵ with Slippery Maneuvers ⟲ p. 76, Kaito Shrine Keeper (Rank 2): Replace Pelting Hail Style ⤵ with Divination ⚗ p. 79, Akodo Commander (Rank 1): Replace Warrior's Resolve ⤵ with Honest Assessment ⟲ p. 86, Utaku Battle Maiden (Rank 1): Replace Striking as Air ⤵ with Courtier's Resolve ⟲"
            }
        }
    }

    MODIFY ^"Akodo Commander" {
        EXTENDS #L5R252wX4yZ6aB8cD0eF2g ^"School"
        APPLIES TO [^"Samurai"]

        # The Akodo War College's curriculum is focused on control: of one's
        # weapons, of the battlefield, over the flow of conflict, and ultimately,
        # over oneself. Its students study the advice of Akodo's Leadership,
        # which was written by the Lion Clan Kami himself. In addition to
        # training as warriors, Akodo Commanders are educated to be
        # battlefield leaders. They often treat war as a game of Go, to be
        # decided by exact moves. Akodo Commanders strike precisely and
        # without hesitation with sword and army alike. Their goal is the
        # pinnacle of the art of war: to minimize losses while achieving
        # their objectives.

        PROPERTIES {
            ^"School Name" STRING "Akodo Commander" FIXED
            ^"Clan" STRING "Lion"
            ^"Roles" LIST ["Bushi"]
            ^"Ring Increase" DEF {
                ^"Earth" INTEGER 1
                ^"Water" INTEGER 1
            }
            ^"Starting Skills" DEF { CHOOSE 5 [^"Command", ^"Fitness", ^"Government", ^"Martial Arts [Melee]", ^"Martial Arts [Ranged]", ^"Meditation", ^"Tactics"] INTEGER 1 }
            ^"Starting Honor" INTEGER DEFAULT 50
            ^"Techniques Available" LIST ["Kata", "Rituals", "Shūji"]
        }

        STARTING_TECHNIQUES {
            KATA CHOOSE 1 [^"Striking as Earth", ^"Striking as Water"]
            SHUJI ^"Lord Akodo's Roar"
        }

        SCHOOL_ABILITY "Way of the Lion" {
            "When you succeed at an Attack or Support action check, you may remove an amount of strife from yourself up to your school rank. For each strife you remove this way, add that one bonus success to the check and receive 1 fatigue."
        }

        MASTERY_ABILITY ^"Akodo's Final Lesson" {
            "Once per game session during a skirmish or mass battle, after you fail a check, you may attempt the check again, treating the TN as 1."
        }

        STARTING_OUTFIT [
            "Ashigaru armor", "traveling clothes",
            "daishō (katana and wakizashi)", "yari (spear)",
            "any one weapon of rarity 6 or lower", "two knives",
            "yumi (bow)", "quiver of arrows", "traveling pack"
        ]

        CURRICULUM {
            RANK 1 {
                SKILL_GROUP "Martial Skills"
                SKILL "Government"
                SKILL "Command"
                SKILL "Performance"
                TECHNIQUE_GROUP "Rank 1 Kata"
                ^"Iron Forest Style" [kata]
                ^"Honest Assessment" [shuji]
            }
            RANK 2 {
                SKILL_GROUP "Martial Skills"
                SKILL "Command"
                SKILL "Medicine"
                SKILL "Survival"
                TECHNIQUE_GROUP "Rank 1-2 Kata"
                ^"Rallying Cry" [shuji]
                ^"Lightning Raid" [shuji]
            }
            RANK 3 {
                SKILL_GROUP "Martial Skills"
                SKILL "Government"
                SKILL "Composition"
                SKILL "Sentiment"
                TECHNIQUE_GROUP "Rank 1-3 Kata"
                ^"A Samurai's Fate" [shuji]
                ^"Touchstone of Courage" [shuji]
            }
            RANK 4 {
                SKILL_GROUP "Social Skills"
                SKILL "Government"
                SKILL "Martial Arts [Melee]"
                SKILL "Tactics"
                TECHNIQUE_GROUP "Rank 1-4 Fire Shūji"
                ^"Rouse the Soul" [shuji]
                ^"Disappearing World Style" [kata]
            }
            RANK 5 {
                SKILL_GROUP "Scholar Skills"
                SKILL "Martial Arts [Melee]"
                SKILL "Meditation"
                SKILL "Tactics"
                TECHNIQUE_GROUP "Rank 1-5 Earth Shūji"
                ^"Bend with the Storm" [shuji]
                ^"Striking as Void" [kata]
            }
            RANK 6 {
                ^"Akodo's Final Lesson"
            }
        }

        GUIDANCE {
            ENTRY ^"errata-akodo-commander-0" #L5RERGvN822tQXcN3NVP5m {
                CONCERNS [ ^"Akodo Commander" ]
                TOPICS [ "errata" ]
                TEXT "p. 65, Kakita Duelist (Rank 1): Replace Striking as Air ⤵ with Cadence ⟲ p. 74, Asako Loremaster (Rank 2): Replace Civility Foremost ⟲ with Tea Ceremony ⚗ p. 76, Shiba Guardian (Rank 2): Replace Iron Forest Style ⤵ with Slippery Maneuvers ⟲ p. 76, Kaito Shrine Keeper (Rank 2): Replace Pelting Hail Style ⤵ with Divination ⚗ p. 79, Akodo Commander (Rank 1): Replace Warrior's Resolve ⤵ with Honest Assessment ⟲ p. 86, Utaku Battle Maiden (Rank 1): Replace Striking as Air ⤵ with Courtier's Resolve ⟲"
            }
        }
    }

    MODIFY ^"Ide Trader" {
        EXTENDS #L5R252wX4yZ6aB8cD0eF2g ^"School"
        APPLIES TO [^"Samurai"]

        # The ever-friendly face of the Unicorn is the Ide. Ide Traders always
        # attempt to solve problems with negotiation first and foremost, as
        # they know any business dealings between friends and equals forge
        # bonds as strong as steel. While some of the other clans think of
        # the Ide as soft, none can point to when they were able to take
        # advantage of this perceived weakness. The Ide Traders ignore
        # insults and politely welcome compliments in equal measure. They
        # have a vast knowledge of cultures, both Rokugani and foreign,
        # which allows them to tailor their dealings with precision.

        PROPERTIES {
            ^"School Name" STRING "Ide Trader" FIXED
            ^"Clan" STRING "Unicorn"
            ^"Roles" LIST ["Courtier"]
            ^"Ring Increase" DEF {
                ^"Air" INTEGER 1
                ^"Water" INTEGER 1
            }
            ^"Starting Skills" DEF { CHOOSE 5 [^"Commerce", ^"Courtesy", ^"Games", ^"Labor", ^"Martial Arts [Ranged]", ^"Medicine", ^"Survival"] INTEGER 1 }
            ^"Starting Honor" INTEGER DEFAULT 45
            ^"Techniques Available" LIST ["Kata", "Rituals", "Shūji"]
        }

        STARTING_TECHNIQUES {
            SHUJI ^"Tributaries of Trade"
            SHUJI CHOOSE 1 [^"Cadence", ^"Shallow Waters"]
        }

        SCHOOL_ABILITY "Vendor of Strange Wares" {
            "Ignore the Forbidden quality when acquiring and handling items."
            "When acquiring, selling, or gifting an item, you may treat its rarity as reduced or increased by your school rank."
        }

        MASTERY_ABILITY ^"A Friend in Every City" {
            "As a downtime activity in any place of human habitation, you may make a TN 4 Commerce (Water) check to find a merchant with whom you (or your relatives) have done business. If you succeed, you find this individual and gain the Ally advantage for them (see page 101), which predisposes them to assist you in various ways."
        }

        STARTING_OUTFIT [
            "Traveling clothes",
            "wakizashi (short sword)", "yumi (bow)", "quiver of arrows",
            "calligraphy set", "traveling pack",
            "Unicorn warhorse", "journal"
        ]

        CURRICULUM {
            RANK 1 {
                SKILL_GROUP "Trade Skills"
                SKILL "Courtesy"
                SKILL "Fitness"
                SKILL "Martial Arts [Ranged]"
                TECHNIQUE_GROUP "Rank 1 Air Shūji"
                ^"Feigned Opening" [shuji]
                ^"Hawk's Precision" [kata]
            }
            RANK 2 {
                SKILL_GROUP "Social Skills"
                SKILL "Commerce"
                SKILL "Martial Arts [Ranged]"
                SKILL "Survival"
                TECHNIQUE_GROUP "Rank 1-2 Water Shūji"
                ^"Ebb and Flow" [shuji]
                ^"Lady Shinjo's Speed" [shuji]
            }
            RANK 3 {
                SKILL_GROUP "Martial Skills"
                SKILL "Aesthetics"
                SKILL "Commerce"
                SKILL "Games"
                TECHNIQUE_GROUP "Rank 1-3 Earth Shūji"
                ^"Pillar of Calm" [shuji]
                ^"All Arts are One" [shuji]
            }
            RANK 4 {
                SKILL_GROUP "Social Skills"
                SKILL "Aesthetics"
                SKILL "Martial Arts [Ranged]"
                SKILL "Sentiment"
                TECHNIQUE_GROUP "Rank 1-4 Fire Shūji"
                ^"Sear the Wound" [shuji]
                ^"Regal Bearing" [shuji]
            }
            RANK 5 {
                SKILL_GROUP "Trade Skills"
                SKILL "Command"
                SKILL "Fitness"
                SKILL "Games"
                TECHNIQUE_GROUP "Rank 1-5 Void Shūji"
                ^"Bend with the Storm" [shuji]
                ^"The Immovable Hand of Peace" [shuji]
            }
            RANK 6 {
                ^"A Friend in Every City"
            }
        }

        GUIDANCE {
            ENTRY ^"errata-ide-trader-0" #L5RERGsIiKeIjDE0fs00NK {
                CONCERNS [ ^"Ide Trader" ]
                TOPICS [ "errata" ]
                TEXT "p. 82, Ide Trader, School Ability: This should read: 'When acquiring, selling, or gifting an item, you may treat its rarity as reduced or increased by your school rank.'"
            }
        }
    }

    MODIFY ^"Shinjo Outrider" {
        EXTENDS #L5R252wX4yZ6aB8cD0eF2g ^"School"
        APPLIES TO [^"Samurai"]

        # The core of the Unicorn military, the Shinjo Outriders emphasize
        # speed and flexibility. All Shinjo Outriders learn the art of
        # reconnaissance and how to get the most out of their horses. No
        # samurai is more mobile than a mounted Shinjo Outrider. Their
        # preferred weapon is the Shinjo horsebow, which they use with
        # great accuracy even while riding at a gallop. Trained to live off
        # the land, the Shinjo Outriders thoroughly learn the terrain of each
        # potential battlefield before having to fight over it.

        PROPERTIES {
            ^"School Name" STRING "Shinjo Outrider" FIXED
            ^"Clan" STRING "Unicorn"
            ^"Roles" LIST ["Bushi", "Courtier"]
            ^"Ring Increase" DEF {
                ^"Earth" INTEGER 1
                ^"Fire" INTEGER 1
            }
            ^"Starting Skills" DEF { CHOOSE 5 [^"Commerce", ^"Martial Arts [Melee]", ^"Martial Arts [Ranged]", ^"Medicine", ^"Skulduggery", ^"Survival", ^"Tactics"] INTEGER 1 }
            ^"Starting Honor" INTEGER DEFAULT 40
            ^"Techniques Available" LIST ["Kata", "Rituals", "Shūji"]
        }

        STARTING_TECHNIQUES {
            KATA CHOOSE 1 [^"Striking as Fire", ^"Striking as Water"]
            KATA ^"Lady Shinjo's Speed"
        }

        SCHOOL_ABILITY "Born in the Saddle" {
            "Once per scene, before rolling dice, you may declare that you are directing your horse (who must be present) to aid in a task and describe how its efforts help in those circumstances. Reduce the TN of the check by your school rank."
        }

        MASTERY_ABILITY ^"I Will Always Return" {
            "Once per game session, you may call out for your steed. At the beginning of the following round, your horse arrives, regardless of any barriers that might normally have prevented it from reaching your location. If your steed has recently been slain, its spirit will possess the closest horse to you and come to your aid regardless, such is its loyalty to you."
        }

        STARTING_OUTFIT [
            "Ashigaru armor", "traveling clothes",
            "daishō (katana or scimitar, wakizashi)",
            "yumi (bow)", "quiver of arrows",
            "knife", "traveling pack",
            "Unicorn warhorse"
        ]

        CURRICULUM {
            RANK 1 {
                SKILL_GROUP "Martial Skills"
                SKILL "Commerce"
                SKILL "Courtesy"
                SKILL "Survival"
                TECHNIQUE_GROUP "Rank 1 Earth Shūji"
                ^"Pelting Hail Style" [kata]
                ^"Cadence" [shuji]
            }
            RANK 2 {
                SKILL_GROUP "Trade Skills"
                SKILL "Courtesy"
                SKILL "Martial Arts [Melee]"
                SKILL "Martial Arts [Ranged]"
                TECHNIQUE_GROUP "Rank 1-2 Kata"
                ^"Flowing Water Strike" [kata]
                ^"Dazzling Performance" [shuji]
            }
            RANK 3 {
                SKILL_GROUP "Scholar Skills"
                SKILL "Martial Arts [Ranged]"
                SKILL "Performance"
                SKILL "Survival"
                TECHNIQUE_GROUP "Rank 1-3 Water Shūji"
                ^"Crashing Wave Style" [kata]
                ^"Crimson Leaves Strike" [kata]
            }
            RANK 4 {
                SKILL_GROUP "Martial Skills"
                SKILL "Command"
                SKILL "Skulduggery"
                SKILL "Survival"
                TECHNIQUE_GROUP "Rank 1-4 Kata"
                ^"Bend with the Storm" [shuji]
                ^"Bravado" [shuji]
            }
            RANK 5 {
                SKILL_GROUP "Social Skills"
                SKILL "Government"
                SKILL "Meditation"
                SKILL "Survival"
                TECHNIQUE_GROUP "Rank 1-5 Fire Shūji"
                ^"Pin the Fan" [kata]
                ^"Rouse the Soul" [shuji]
            }
            RANK 6 {
                ^"I Will Always Return"
            }
        }

        GUIDANCE {
            ENTRY ^"errata-shinjo-outrider-0" #L5RERGZ3ttNkp6HsifM58L {
                CONCERNS [ ^"Shinjo Outrider" ]
                TOPICS [ "errata" ]
                TEXT "p. 85, Shinjo Outrider, Starting Techniques: Lady Shinjo's Speed should be listed as a shūji (⟲) ."
            }
        }
    }

    MODIFY ^"Utaku Battle Maiden" {
        EXTENDS #L5R252wX4yZ6aB8cD0eF2g ^"School"
        APPLIES TO [^"Samurai"]

        # The most traditional and prestigious of the Unicorn Clan's
        # schools, the Shiotome, or "Battle Maidens," are revered as
        # legendary cavalry. The dōjō only accepts women who carry the
        # Utaku name, and even then prospective students must meet
        # stringent standards of prowess and honor. This is the only
        # school in the Empire that teaches the secrets required to tame
        # the powerful Utaku steeds, massive warhorses that refuse all
        # other riders. In battle, graceful, continuous movements mark
        # their style, as does their unnerving serenity. Even when
        # charging into the fray, Battle Maidens often move in utter silence.

        PROPERTIES {
            ^"School Name" STRING "Utaku Battle Maiden" FIXED
            ^"Clan" STRING "Unicorn"
            ^"Roles" LIST ["Bushi"]
            ^"Ring Increase" DEF {
                ^"Air" INTEGER 1
                ^"Earth" INTEGER 1
            }
            ^"Starting Skills" DEF { CHOOSE 5 [^"Command", ^"Fitness", ^"Government", ^"Martial Arts [Melee]", ^"Meditation", ^"Smithing", ^"Survival"] INTEGER 1 }
            ^"Starting Honor" INTEGER DEFAULT 50
            ^"Techniques Available" LIST ["Kata", "Rituals", "Shūji"]
        }

        STARTING_TECHNIQUES {
            KATA CHOOSE 1 [^"Crescent Moon Style", ^"Iron Forest Style"]
            KATA ^"Warrior's Resolve"
        }

        SCHOOL_ABILITY "Heroic Charge" {
            "When you succeed at an Attack action check, add bonus successes equal to the number of range bands you have moved this round, to a maximum of your school rank."
            "During a duel or mass battle, if you are mounted on your steed, you always count as having moved a number of range bands equal to your school rank this turn."
        }

        MASTERY_ABILITY ^"Sensing the Breeze" {
            "Once per round, after you defend against damage, you may move 1 range band and you may switch to a different stance."
        }

        STARTING_OUTFIT [
            "Lacquered armor", "ceremonial clothes",
            "daishō (katana or scimitar, wakizashi)",
            "yari (spear)", "yumi (bow)", "quiver of arrows",
            "knife", "traveling pack",
            "Utaku steed"
        ]

        CURRICULUM {
            RANK 1 {
                SKILL_GROUP "Martial Skills"
                SKILL "Command"
                SKILL "Smithing"
                SKILL "Survival"
                TECHNIQUE_GROUP "Rank 1 Kata"
                ^"Lady Shinjo's Speed" [shuji]
                # Errata FAQ v2.0 (2020-08-12), core rulebook p. 86: rank 1
                # "Striking as Air" (kata) is replaced with "Courtier's Resolve" (shūji).
                ^"Courtier's Resolve" [shuji]
            }
            RANK 2 {
                SKILL_GROUP "Artisan Skills"
                SKILL "Fitness"
                SKILL "Martial Arts [Melee]"
                SKILL "Tactics"
                TECHNIQUE_GROUP "Rank 1-2 Earth Shūji"
                ^"Thunderclap Strike" [kata]
                ^"Rushing Avalanche Style" [kata]
            }
            RANK 3 {
                SKILL_GROUP "Martial Skills"
                SKILL "Medicine"
                SKILL "Survival"
                SKILL "Theology"
                TECHNIQUE_GROUP "Rank 1-3 Kata"
                ^"Pillar of Calm" [shuji]
                ^"Touchstone of Courage" [shuji]
            }
            RANK 4 {
                SKILL_GROUP "Scholar Skills"
                SKILL "Command"
                SKILL "Fitness"
                SKILL "Martial Arts [Melee]"
                TECHNIQUE_GROUP "Rank 1-4 Air Shūji"
                ^"Soul Sunder" [kata]
                ^"Breath of Wind Style" [kata]
            }
            RANK 5 {
                SKILL_GROUP "Martial Skills"
                SKILL "Command"
                SKILL "Culture"
                SKILL "Survival"
                TECHNIQUE_GROUP "Rank 1-5 Kata"
                ^"Rouse the Soul" [shuji]
                ^"Bend with the Storm" [shuji]
            }
            RANK 6 {
                ^"Sensing the Breeze"
            }
        }

        GUIDANCE {
            ENTRY ^"errata-utaku-battle-maiden-0" #L5RERGuTqv7R0dQMeXWutj {
                CONCERNS [ ^"Utaku Battle Maiden" ]
                TOPICS [ "errata" ]
                TEXT "p. 65, Kakita Duelist (Rank 1): Replace Striking as Air ⤵ with Cadence ⟲ p. 74, Asako Loremaster (Rank 2): Replace Civility Foremost ⟲ with Tea Ceremony ⚗ p. 76, Shiba Guardian (Rank 2): Replace Iron Forest Style ⤵ with Slippery Maneuvers ⟲ p. 76, Kaito Shrine Keeper (Rank 2): Replace Pelting Hail Style ⤵ with Divination ⚗ p. 79, Akodo Commander (Rank 1): Replace Warrior's Resolve ⤵ with Honest Assessment ⟲ p. 86, Utaku Battle Maiden (Rank 1): Replace Striking as Air ⤵ with Courtier's Resolve ⟲"
            }
        }
    }

    MODIFY ^"Technique" {
        APPLIES TO [^"Samurai", ^"Adversary"]

        # Techniques are special abilities that represent advanced training.
        # They enable a character to perform feats more quickly or in a
        # unique way, or to exploit opportunities others would overlook.

        # --- CATEGORY ---
        # Each character is granted access to technique categories by their
        # ^"School". The categories are:

        CATEGORY ENUM ["Kata", "Kihō", "Invocation", "Ritual", "Shūji", "Mahō", "Ninjutsu"]
        # Additional categories from sourcebooks: Inversion, Mantra

        # --- NAME ---
        # Each technique has a name, though different schools may describe
        # similar tactics differently. Some techniques (especially invocations)
        # have an "Other Names" field. Players are encouraged to use them
        # to underscore the unique traditions of individual schools.

        # --- PREREQUISITES ---
        # School ranks, clan affiliations, role/schools, ring values, skill
        # ranks, other techniques, or other qualifiers required to purchase
        # a technique with experience.
        #
        # Prerequisites are WAIVED if:
        # - A character is directly granted a technique during character
        #   creation (or at another time), OR
        # - The technique appears on the character's curriculum by name or
        #   as part of a listed group (e.g. "Rank 1-3 Kata").
        #
        # Such techniques and groups are marked with = to denote their
        # special status. If a character does not choose a technique to
        # which they have special access, or advances past the school rank
        # that enables them to buy it without purchasing it, they LOSE
        # their special access and can no longer purchase it at reduced cost.

        # --- XP COST ---
        # All techniques cost 3 XP to purchase. If a technique costs a
        # different amount, it is listed in the entry.

        # --- ACTIVATION ---
        # Each technique specifies when and how it can be used. The
        # activation generally includes some or all of the following:
        ACTIVATION_COMPONENTS {
            ^"Use" DEF {
                "As an Action: Character must perform an action during a conflict scene. If the action lists one or more types, it possesses each of those types."
                "As a Downtime Activity: Character must spend a downtime scene to attempt the task."
                "When Making a Check: Character can activate only during checks using the specified skill, skill group, ring, or combination. Usually requires spending (op)."
            }
            ^"Check" "If activation requires an action or downtime scene, it generally requires a separate check with a specified TN. If no ring is specified, any ring may be used (e.g. the one matching current stance in conflict). If a skill group is listed, the character chooses any skill from that group."
            ^"Targets" "Characters, positions, or objects affected. When a character has a choice of multiple possible targets, they must choose from among the valid targets."
            ^"Range" "Specified as 'at range [number]', 'at range [number]-[number]', 'in range of your weapon', or similar. Targets beyond the specified range are not affected."
            ^"Other Requirements" "Circumstantial requirements such as 'using a readied weapon', 'under the full moon', or 'while on ^\"Hallowed\" ground'."
        }

        # --- EFFECTS ---
        # Each technique lists effects that occur after activation. Each
        # paragraph represents a distinct effect.
        #
        # - "If you succeed" effects only resolve on successful check.
        # - "If you fail" effects only resolve on failed check.
        # - Effects with alternate conditions resolve under stated conditions.
        # - Effects with no conditions always resolve.
        #
        # Persistent Effects: Some effects persist for a set duration
        # (e.g. "until the beginning of your next turn", "for one round
        # plus additional rounds equal to your bonus successes", "until
        # the end of the scene"). A character cannot benefit (or suffer)
        # from more than one instance of the same persistent effect, even
        # from multiple sources. If overlapping: player chooses if beneficial,
        # GM chooses if harmful.

        # --- NEW OPPORTUNITIES ---
        # Many techniques list one or more uses of (op) specific to the
        # check. Some are preceded by a ring requirement (e.g. "Air (op)")
        # meaning the character can only spend (op) this way if they used
        # that ring for the check.

        PROPERTIES {
            ^"Name" STRING REQUIRED
            ^"Category" STRING  # References category ENUM above
            ^"Rank" INTEGER MIN 1 MAX 5
            ^"Prerequisites" STRING  # School rank, ring values, clan, etc.
            ^"XP Cost" INTEGER DEFAULT 3
            ^"Activation" STRING  # Use, Check, Targets, Range, Other Requirements
            ^"Description" STRING  # Narrative description (no mechanical effect)
            ^"Effects" STRING  # Mechanical effects with conditional resolution
            ^"New Opportunities" STRING  # Technique-specific (op) spends
        }

        GUIDANCE {
            ENTRY ^"errata-technique-0" #L5RERGJPDSVtRQ5l9Sn3xM {
                CONCERNS [ ^"Technique" ]
                TOPICS [ "errata" ]
                TEXT "p. 173, Prerequisites, second paragraph, first sentence should be replaced with: 'Note that all prerequisites are waived if a character is granted a technique directly during character creation (or at another time), or if the technique appears by name on their curriculum. If a technique is part of a listed group (e.g. '⚘ Rank 1–3 Kata'), the character ignores school rank prerequisites, but not other prerequisites (clan, etc).'"
            }
        }
    }

    MODIFY ^"Iaijutsu Cut: Rising Blade" {
            RANK 2
            DESCRIPTION "The bushi grips their scabbard against their hip and draws, cutting upward to catch an advancing foe without being cut themself."
            ACTIVATION "As an Attack action using one sheathed ^\"Razor-Edged\" weapon, make a TN 3 Martial Arts [Melee] check targeting one character at range 0-1."
            EFFECTS {
                "You draw and ready the sheathed weapon in a one-handed grip."
                "If you succeed, deal physical damage equal to the weapon's deadliness. Target cannot defend against this damage if they are ^\"Compromised\"."
            }
            OPPORTUNITIES {
                "(op): Ready one other sheathed Razor-Edged weapon."
            }

        GUIDANCE {
            ENTRY ^"errata-iaijutsu-cut-rising-blade-0" #L5RERG04cPpnQQo9l21uhb {
                CONCERNS [ ^"Iaijutsu Cut: Rising Blade" ]
                TOPICS [ "errata" ]
                TEXT "p. 179, Iaijutsu Cut: Rising Blade, Activation: This should read 'As an Attack action using one sheathed Razor-Edged weapon, you may make a Martial Arts [Melee] check targeting one character at range 0–1. The TN of this check is equal to the target's vigilance.'"
            }
            ENTRY ^"faq-iaijutsu-cut-rising-blade-1" #L5RERGuIqYoGnCQwhHxHRA {
                CONCERNS [ ^"Iaijutsu Cut: Rising Blade" ]
                TOPICS [ "faq" ]
                TEXT "Q: Can Iaijutsu Cut techniques (p. 179) be performed with a weapon that has no one-handed grip (naginata, nodachi)? A: No. These techniques instruct readying in one-handed grip. If the weapon has no one-handed grip, it is drawn but not readied, producing no base damage/deadliness/properties."
            }
        }
    }

    MODIFY ^"Zanbatō" {
                PROPERTIES {
                    ^"Category" STRING "Swords"
                    ^"Skill" STRING "Martial Arts [Melee]"
                    ^"Range" STRING "1-2"
                    ^"Base Damage" INTEGER 6
                    ^"Deadliness" INTEGER 7
                    ^"Grips" STRING "2-hand: –"
                    ^"Qualities" LIST OF STRING ["Cumbersome", "Wargear"]
                    ^"Rarity" INTEGER 8
                    ^"Price" STRING "40 koku"
                    ^"Description" STRING "Larger even than mighty nodachi, zanbatō are swords with the reach of a spear. Zanbatō have a long, thick, katana-like blade roughly six feet in length attached to a two-handed hilt. They are dedicated anticavalry weapons—indeed, their name means “horse-chopping sword.” The Matsu school is famous for adopting them into the curriculum after their ill-fated encounter with the Utaku cavalry at the Battle of Plum Blossom Pass."
                }

        GUIDANCE {
