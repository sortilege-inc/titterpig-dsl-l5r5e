EXTENSION "L5R5e_Errata_FAQ_2019" EXTENDS "L5R5e_Core_Character" {
    NAME "Legend of the Five Rings 5th Edition - Errata and FAQ (September 2019)"
    VERSION "0.4.6"
    SPEC_VERSION "0.4"
    RELEASE_DATE "2026-03-01"

    # Official errata and FAQ for the L5R 5e Core Rulebook and
    # Shadowlands supplement, dated September 25, 2019.
    # Published by Fantasy Flight Games.
    #
    # This extension is a corrections LAYER: each MODIFY block
    # points to the entity it overrides in core/sourcebook data
    # and supplies the corrected value itself under a "# --- correction ---"
    # marker, so the fix applies whether or not the base file was
    # ever hand-patched. FAQ
    # entries are added as new clarification DEFs that reference
    # the rule they clarify. Consumers apply this layer on top
    # of the base content; the underlying files are NOT edited.

    # =================================================================
    # CORE RULEBOOK ERRATA
    # =================================================================

    # ---- Chapter 1 ----

    MODIFY ^"Universal Tiebreaker" {
        GUIDANCE {
            ENTRY ^"errata-universal-tiebreaker-0" #L5RERG0TplpshcZa3oDYQ3 {
                CONCERNS [ ^"Universal Tiebreaker" ]
                TOPICS [ "errata" ]
                TEXT "p. 26, Margin Note 'Universal Tiebreaker': The second bullet should read 'Adversary NPCs supersede minion NPCs'"
            }
        }
    }

    MODIFY ^"Kakita Duelist" {
        CURRICULUM {
            RANK 1 {
                SKILL_GROUP "Martial Skills"
                SKILL "Aesthetics"
                SKILL "Courtesy"
                SKILL "Sentiment"
                TECHNIQUE_GROUP "Rank 1 Kata"
                ^"Iaijutsu Cut: Crossing Blade" [kata]
                ^"Cadence" [shuji]
            }
        }

        GUIDANCE {
            ENTRY ^"errata-kakita-duelist-0" #L5RERGPxLe6TAbQob4wQuY {
                CONCERNS [ ^"Kakita Duelist" ]
                TOPICS [ "errata" ]
                TEXT "p. 65, Kakita Duelist (Rank 1): Replace Striking as Air ⤵ with Cadence ⟲ p. 74, Asako Loremaster (Rank 2): Replace Civility Foremost ⟲ with Tea Ceremony ⚗ p. 76, Shiba Guardian (Rank 2): Replace Iron Forest Style ⤵ with Slippery Maneuvers ⟲ p. 76, Kaito Shrine Keeper (Rank 2): Replace Pelting Hail Style ⤵ with Divination ⚗ p. 79, Akodo Commander (Rank 1): Replace Warrior's Resolve ⤵ with Honest Assessment ⟲ p. 86, Utaku Battle Maiden (Rank 1): Replace Striking as Air ⤵ with Courtier's Resolve ⟲"
            }
            ENTRY ^"errata-kakita-duelist-1" #L5RERG3Aax2pkALF383eUR {
                CONCERNS [ ^"Kakita Duelist" ]
                TOPICS [ "errata" ]
                TEXT "p. 65, Kakita Duelist (Rank 1): 'Iaijutsu Cut: Crossing Cut' should read 'Iaijutsu Cut: Crossing Blade.'"
            }
        }
    }

    MODIFY ^"Asako Loremaster" {
        CURRICULUM {
            RANK 2 {
                SKILL_GROUP "Social Skills"
                SKILL "Government"
                SKILL "Medicine"
                SKILL "Sentiment"
                TECHNIQUE_GROUP "Rank 1-2 Air Shūji"
                ^"All Arts are One" [shuji]
                ^"Tea Ceremony" [ritual]
            }
        }
        SCHOOL_ABILITY "Wisdom of the Ages" {
            "When performing a Scholar skill check, you may treat your ranks in the skill as being equal to your school rank. If your ranks in that Scholar skill are equal to or higher than your school rank, or if you have 5 ranks in the skill, you may add one kept (ring) set to an (op) result instead."
        }

        GUIDANCE {
            ENTRY ^"errata-asako-loremaster-0" #L5RERGIu8I2BEElbbx0jSc {
                CONCERNS [ ^"Asako Loremaster" ]
                TOPICS [ "errata" ]
                TEXT "p. 65, Kakita Duelist (Rank 1): Replace Striking as Air ⤵ with Cadence ⟲ p. 74, Asako Loremaster (Rank 2): Replace Civility Foremost ⟲ with Tea Ceremony ⚗ p. 76, Shiba Guardian (Rank 2): Replace Iron Forest Style ⤵ with Slippery Maneuvers ⟲ p. 76, Kaito Shrine Keeper (Rank 2): Replace Pelting Hail Style ⤵ with Divination ⚗ p. 79, Akodo Commander (Rank 1): Replace Warrior's Resolve ⤵ with Honest Assessment ⟲ p. 86, Utaku Battle Maiden (Rank 1): Replace Striking as Air ⤵ with Courtier's Resolve ⟲"
            }
            ENTRY ^"errata-asako-loremaster-1" #L5RERGNIJOHelWSMlrD7GI {
                CONCERNS [ ^"Asako Loremaster" ]
                TOPICS [ "errata" ]
                TEXT "p. 74, Asako Loremaster, School Ability: The first sentence should read: '...you may treat your ranks in the skill as being equal to your school rank.'"
            }
        }
    }

    MODIFY ^"Shiba Guardian" {
        CURRICULUM {
            RANK 2 {
                SKILL_GROUP "Scholar Skills"
                SKILL "Fitness"
                SKILL "Meditation"
                SKILL "Martial Arts [Melee]"
                TECHNIQUE_GROUP "Rank 1-2 Kata"
                ^"Rallying Cry" [shuji]
                ^"Slippery Maneuvers" [shuji]
            }
        }

        GUIDANCE {
            ENTRY ^"errata-shiba-guardian-0" #L5RERGd9hGMuCQBrlA0gZ3 {
                CONCERNS [ ^"Shiba Guardian" ]
                TOPICS [ "errata" ]
                TEXT "p. 65, Kakita Duelist (Rank 1): Replace Striking as Air ⤵ with Cadence ⟲ p. 74, Asako Loremaster (Rank 2): Replace Civility Foremost ⟲ with Tea Ceremony ⚗ p. 76, Shiba Guardian (Rank 2): Replace Iron Forest Style ⤵ with Slippery Maneuvers ⟲ p. 76, Kaito Shrine Keeper (Rank 2): Replace Pelting Hail Style ⤵ with Divination ⚗ p. 79, Akodo Commander (Rank 1): Replace Warrior's Resolve ⤵ with Honest Assessment ⟲ p. 86, Utaku Battle Maiden (Rank 1): Replace Striking as Air ⤵ with Courtier's Resolve ⟲"
            }
        }
    }

    MODIFY ^"Kaito Shrine Keeper" {
        CURRICULUM {
            RANK 2 {
                SKILL_GROUP "Martial Skills"
                SKILL "Performance"
                SKILL "Theology"
                SKILL "Smithing"
                TECHNIQUE_GROUP "Rank 1-2 Kata"
                ^"Grasp of the Air Dragon" [invocation]
                ^"Divination" [ritual]
            }
        }

        GUIDANCE {
            ENTRY ^"errata-kaito-shrine-keeper-0" #L5RERGBYXxgEZx2LkMH274 {
                CONCERNS [ ^"Kaito Shrine Keeper" ]
                TOPICS [ "errata" ]
                TEXT "p. 65, Kakita Duelist (Rank 1): Replace Striking as Air ⤵ with Cadence ⟲ p. 74, Asako Loremaster (Rank 2): Replace Civility Foremost ⟲ with Tea Ceremony ⚗ p. 76, Shiba Guardian (Rank 2): Replace Iron Forest Style ⤵ with Slippery Maneuvers ⟲ p. 76, Kaito Shrine Keeper (Rank 2): Replace Pelting Hail Style ⤵ with Divination ⚗ p. 79, Akodo Commander (Rank 1): Replace Warrior's Resolve ⤵ with Honest Assessment ⟲ p. 86, Utaku Battle Maiden (Rank 1): Replace Striking as Air ⤵ with Courtier's Resolve ⟲"
            }
        }
    }

    MODIFY ^"Akodo Commander" {
        CURRICULUM {
            RANK 1 {
                SKILL_GROUP "Martial Skills"
                SKILL "Government"
                SKILL "Command"
                SKILL "Performance"
                TECHNIQUE_GROUP "Rank 1 Kata"
                ^"Iron Forest Style" [kata]
                ^"Honest Assessment" [shuji]
            }
        }

        GUIDANCE {
            ENTRY ^"errata-akodo-commander-0" #L5RERGvN822tQXcN3NVP5m {
                CONCERNS [ ^"Akodo Commander" ]
                TOPICS [ "errata" ]
                TEXT "p. 65, Kakita Duelist (Rank 1): Replace Striking as Air ⤵ with Cadence ⟲ p. 74, Asako Loremaster (Rank 2): Replace Civility Foremost ⟲ with Tea Ceremony ⚗ p. 76, Shiba Guardian (Rank 2): Replace Iron Forest Style ⤵ with Slippery Maneuvers ⟲ p. 76, Kaito Shrine Keeper (Rank 2): Replace Pelting Hail Style ⤵ with Divination ⚗ p. 79, Akodo Commander (Rank 1): Replace Warrior's Resolve ⤵ with Honest Assessment ⟲ p. 86, Utaku Battle Maiden (Rank 1): Replace Striking as Air ⤵ with Courtier's Resolve ⟲"
            }
        }
    }

    MODIFY ^"Ide Trader" {
        SCHOOL_ABILITY "Vendor of Strange Wares" {
            "Ignore the Forbidden quality when acquiring and handling items."
            "When acquiring, selling, or gifting an item, you may treat its rarity as reduced or increased by your school rank."
        }

        GUIDANCE {
            ENTRY ^"errata-ide-trader-0" #L5RERGsIiKeIjDE0fs00NK {
                CONCERNS [ ^"Ide Trader" ]
                TOPICS [ "errata" ]
                TEXT "p. 82, Ide Trader, School Ability: This should read: 'When acquiring, selling, or gifting an item, you may treat its rarity as reduced or increased by your school rank.'"
            }
        }
    }

    MODIFY ^"Shinjo Outrider" {
        STARTING_TECHNIQUES {
            KATA CHOOSE 1 [^"Striking as Fire", ^"Striking as Water"]
            SHUJI ^"Lady Shinjo's Speed"
        }

        GUIDANCE {
            ENTRY ^"errata-shinjo-outrider-0" #L5RERGZ3ttNkp6HsifM58L {
                CONCERNS [ ^"Shinjo Outrider" ]
                TOPICS [ "errata" ]
                TEXT "p. 85, Shinjo Outrider, Starting Techniques: Lady Shinjo's Speed should be listed as a shūji (⟲) ."
            }
        }
    }

    MODIFY ^"Utaku Battle Maiden" {
        CURRICULUM {
            RANK 1 {
                SKILL_GROUP "Martial Skills"
                SKILL "Command"
                SKILL "Smithing"
                SKILL "Survival"
                TECHNIQUE_GROUP "Rank 1 Kata"
                ^"Lady Shinjo's Speed" [shuji]
                # Errata FAQ v2.0 (2020-08-12), core rulebook p. 86: rank 1
                # "Striking as Air" (kata) is replaced with "Courtier's Resolve" (shūji).
                ^"Courtier's Resolve" [shuji]
            }
        }

        GUIDANCE {
            ENTRY ^"errata-utaku-battle-maiden-0" #L5RERGuTqv7R0dQMeXWutj {
                CONCERNS [ ^"Utaku Battle Maiden" ]
                TOPICS [ "errata" ]
                TEXT "p. 65, Kakita Duelist (Rank 1): Replace Striking as Air ⤵ with Cadence ⟲ p. 74, Asako Loremaster (Rank 2): Replace Civility Foremost ⟲ with Tea Ceremony ⚗ p. 76, Shiba Guardian (Rank 2): Replace Iron Forest Style ⤵ with Slippery Maneuvers ⟲ p. 76, Kaito Shrine Keeper (Rank 2): Replace Pelting Hail Style ⤵ with Divination ⚗ p. 79, Akodo Commander (Rank 1): Replace Warrior's Resolve ⤵ with Honest Assessment ⟲ p. 86, Utaku Battle Maiden (Rank 1): Replace Striking as Air ⤵ with Courtier's Resolve ⟲"
            }
        }
    }

    MODIFY ^"Technique" {
        GUIDANCE {
            ENTRY ^"errata-technique-0" #L5RERGJPDSVtRQ5l9Sn3xM {
                CONCERNS [ ^"Technique" ]
                TOPICS [ "errata" ]
                TEXT "p. 173, Prerequisites, second paragraph, first sentence should be replaced with: 'Note that all prerequisites are waived if a character is granted a technique directly during character creation (or at another time), or if the technique appears by name on their curriculum. If a technique is part of a listed group (e.g. '⚘ Rank 1–3 Kata'), the character ignores school rank prerequisites, but not other prerequisites (clan, etc).'"
            }
        }
    }

    MODIFY ^"Iaijutsu Cut: Rising Blade" {
        ACTIVATION "As an Attack action using one sheathed ^\"Razor-Edged\" weapon, you may make a Martial Arts [Melee] check targeting one character at range 0-1. The TN of this check is equal to the target's vigilance."

        GUIDANCE {
            ENTRY ^"errata-iaijutsu-cut-rising-blade-0" #L5RERG04cPpnQQo9l21uhb {
                CONCERNS [ ^"Iaijutsu Cut: Rising Blade" ]
                TOPICS [ "errata" ]
                TEXT "p. 179, Iaijutsu Cut: Rising Blade, Activation: This should read 'As an Attack action using one sheathed Razor-Edged weapon, you may make a Martial Arts [Melee] check targeting one character at range 0–1. The TN of this check is equal to the target's vigilance.'"
            }
            ENTRY ^"faq-iaijutsu-cut-rising-blade-1" #L5RERGuIqYoGnCQwhHxHRA {
                CONCERNS [ ^"Iaijutsu Cut: Rising Blade" ]
                TOPICS [ "faq" ]
                TEXT "Q: Can Iaijutsu Cut techniques (p. 179) be performed with a weapon that has no one-handed grip (naginata, nodachi)? A: No. These techniques instruct readying in one-handed grip. If the weapon has no one-handed grip, it is drawn but not readied, producing no base damage/deadliness/properties."
            }
        }
    }

    MODIFY ^"Zanbatō" {
        SET ^"Base Damage" INTEGER 6
        SET ^"Deadliness" INTEGER 7

        GUIDANCE {
            ENTRY ^"errata-zanbat-0" #L5RERGGiLB3S4OVnaE8YAU {
                CONCERNS [ ^"Zanbatō" ]
                TOPICS [ "errata" ]
                TEXT "p. 231, Table 5–1: Weapons, Zanbato entry: The damage (DMG) of this weapon should be 6. The deadliness (DLS) of this weapon should be 7."
            }
        }
    }

    MODIFY ^"Scheme Action" {
        GUIDANCE {
            ENTRY ^"errata-scheme-action-0" #L5RERG1gkQQUHLUxguBYzS {
                CONCERNS [ ^"Scheme Action" ]
                TOPICS [ "errata" ]
                TEXT "All instances of 'Intrigue action' should read 'Scheme action.'"
            }
        }
    }

    MODIFY ^"Wait" {
        ACTIVATION "As an Attack, Scheme, and Support action, declare a non-Movement action you will perform after the occurrence of a specified event before the end of the round."

        GUIDANCE {
            ENTRY ^"errata-wait-0" #L5RERGx2z5H32RPu3X5UOW {
                CONCERNS [ ^"Wait" ]
                TOPICS [ "errata" ]
                TEXT "p. 264, Wait (Action), Activation: The first clause should read 'As an Attack, Scheme, and Support action'"
            }
        }
    }

    MODIFY ^"Target Number" {
        GUIDANCE {
            ENTRY ^"errata-target-number-0" #L5RERGBK2Dw1bl6XhEaf3G {
                CONCERNS [ ^"Target Number" ]
                TOPICS [ "errata" ]
                TEXT "p. 296, 'Varying Difficulty in Text,' Example: When discussing the TN 3 Fitness Check (Earth 1, Fire 4), the example should list the Fire approach's TN as 4 (not 3)."
            }
        }
    }

    MODIFY ^"Emerald Magistrate" {
        STATUS_AWARD "+15 (to a minimum of 40)"

        GUIDANCE {
            ENTRY ^"errata-emerald-magistrate-0" #L5RERG1cx5zrdop96NHbTA {
                CONCERNS [ ^"Emerald Magistrate" ]
                TOPICS [ "errata" ]
                TEXT "p. 305: Emerald Magistrate: The title ability should be included, reading: Voice of Authority (Title Ability): Once per game session when making a Scheme or Support action check using a Social skill, you may choose additional targets equal to your Glory rank. You cannot choose any additional target with vigilance higher than the highest among your initial targets."
            }
            ENTRY ^"errata-emerald-magistrate-1" #L5RERGPCcqhSmNpi7ZJlOd {
                CONCERNS [ ^"Emerald Magistrate" ]
                TOPICS [ "errata" ]
                TEXT "p. 305, Emerald Magistrate: The Status Award should be listed as, 'Status Award: +15 (to a minimum of 40)'"
            }
        }
    }

    MODIFY ^"Peasant Family" {
        PROPERTIES {
            ^"Skill Increases" DEF {
                CHOOSE 2 [^"Commerce", ^"Labor", ^"Seafaring", ^"Skulduggery", ^"Survival"] INTEGER 1
            }
        }

        GUIDANCE {
            ENTRY ^"errata-peasant-family-0" #L5RERG2V4LfHpztqbTzK6O {
                CONCERNS [ ^"Peasant Family" ]
                TOPICS [ "errata" ]
                TEXT "p. 306, Peasant Family, Skill Increase: This should read '+1 to any two Trade skills of your choice.'"
            }
        }
    }

    MODIFY ^"Manifest Fire Kami" {
        PROPERTIES {
            ^"Rings" DEF {
                ^"Air" INTEGER 1
                ^"Earth" INTEGER 2
                ^"Fire" INTEGER 6
                ^"Water" INTEGER 2
                ^"Void" INTEGER 1
            }
        }

        GUIDANCE {
            ENTRY ^"errata-manifest-fire-kami-0" #L5RERGqu7nRCarqm9mVyam {
                CONCERNS [ ^"Manifest Fire Kami" ]
                TOPICS [ "errata" ]
                TEXT "p. 324, Manifest Fire Kami: This NPC's Earth Ring should be 2 and its Fire Ring should be 6."
            }
        }
    }

    MODIFY ^"Opportunity" {
        GUIDANCE {
            ENTRY ^"errata-opportunity-0" #L5RERGRUazh9AVRT8ulf7b {
                CONCERNS [ ^"Opportunity" ]
                TOPICS [ "errata" ]
                TEXT "p. 328, Table 8–1: Opportunities, Conflict and Martial Skill Examples of ⚔, Fire, Entry 1: This entry should read: 'Choose another character in the scene; increase the TN of the next check they make before the start of your next turn if it does not include you as a target.'"
            }
        }
    }

    MODIFY ^"Moto Avenger" {
        STARTING_OUTFIT [
            "traveling clothes", "ashigaru armor",
            "wakizashi", "scroll satchel",
            "finger of jade", "traveling pack",
            "Unicorn warhorse"
        ]

        GUIDANCE {
            ENTRY ^"errata-moto-avenger-0" #L5RERGKb4Jje2xMz4zyuZM {
                CONCERNS [ ^"Moto Avenger" ]
                TOPICS [ "errata" ]
                TEXT "p. 93, Moto Avenger School: In the Avenger's starting outfit, the following should be added, 'Unicorn warhorse (see page 326 of the core rulebook).'"
            }
        }
    }

    MODIFY ^"School" {
        GUIDANCE {
            ENTRY ^"faq-school-0" #L5RERGneAUxHfehA6NpuUz {
                CONCERNS [ ^"School" ]
                TOPICS [ "faq" ]
                TEXT "Q: Can a character count multiple purchases from a single entry on the current school rank of their curriculum toward their current school rank? A: Yes. A character can count any number of purchases of ranks of a skill or skill group or techniques from a listed category (e.g., 'Kata Rank 1-2') toward their current school rank."
            }
            ENTRY ^"faq-school-1" #L5RERGr02CkV99Ra57qnpn {
                CONCERNS [ ^"School" ]
                TOPICS [ "faq" ]
                TEXT "Q: If a character has access to an advancement with the = symbol that they could not normally purchase at a specific school rank or via a specific title, can they purchase it after completing that rank or title? A: No. The special access to purchase that advancement does not persist once the rank is completed."
            }
        }
    }

    MODIFY ^"Asahina Artificer" {
        GUIDANCE {
            ENTRY ^"faq-asahina-artificer-0" #L5RERGYUsd6AYBGKboJWeU {
                CONCERNS [ ^"Asahina Artificer" ]
                TOPICS [ "faq" ]
                TEXT "Q: When does the Asahina Artificer's school ability apply? A: It applies to invocations using the listed keywords to: summon an illusion (e.g., Token of Memory, Matsu's Battlecry); summon an object (any manifestation of an element that is not a being like a Manifest Kami, e.g., Blessed Wind, Katana of Fire, Earthquake); augment an object (e.g., Cloak of Night, Armor of Radiance); awaken an object (e.g., the school's Mastery Ability)."
            }
        }
    }

    MODIFY ^"Matsu Berserker" {
        GUIDANCE {
            ENTRY ^"faq-matsu-berserker-0" #L5RERGJgdGZ49gvKqnrCr9 {
                CONCERNS [ ^"Matsu Berserker" ]
                TOPICS [ "faq" ]
                TEXT "Q: Can a Matsu Berserker's school ability (p. 73) trigger even if already suffering the Enraged condition? A: Yes. May suffer Enraged to trigger ability even while already Enraged (only one instance per Persistent Effects, p. 174)."
            }
        }
    }

    MODIFY ^"NPC" {
        GUIDANCE {
            ENTRY ^"faq-npc-0" #L5RERG3d9X5uMSdOhtGB7Z {
                CONCERNS [ ^"NPC" ]
                TOPICS [ "faq" ]
                TEXT "Q: Can a character pick up and wield a weapon profile that is part of an NPC's body? A: No. It only has that profile as part of the NPC's body. A severed limb or broken tusk counts as an improvised weapon (club/knife)."
            }
            ENTRY ^"faq-npc-1" #L5RERGY9YYYxs8gzk8bFg2 {
                CONCERNS [ ^"NPC" ]
                TOPICS [ "faq" ]
                TEXT "Q: Can Crimson Leaves Strike or Coiling Serpent Style be used to disarm or restrain unarmed attack profiles? A: No. Unarmed profiles function like weapons for many things but are not strictly considered weapons (per p. 237)."
            }
            ENTRY ^"faq-npc-2" #L5RERGrRoTm9mHI58kJVvA {
                CONCERNS [ ^"NPC" ]
                TOPICS [ "faq" ]
                TEXT "Q: Can Crimson Leaves Strike and Coiling Serpent Style be used to disarm or restrain an NPC's weapon profile that is part of its body? A: No. These are treated as unarmed profiles and cannot be affected by those techniques."
            }
        }
    }

    MODIFY ^"Improvised Weapons" {
        GUIDANCE {
            ENTRY ^"errata-improvised-weapons-margin-note" #L5RERGimprvwpn2019aaaa {
                CONCERNS [ ^"Improvised Weapons" ]
                TOPICS [ "errata" ]
                TEXT "p. 230: The following margin note should be added: An improvised weapon uses the most similar weapon profile (often a club or a knife), with DMG and DLS reduced by 1, or more at the GM's discretion. They are wielded with Martial Arts [Unarmed]."
            }
        }
    }

}
