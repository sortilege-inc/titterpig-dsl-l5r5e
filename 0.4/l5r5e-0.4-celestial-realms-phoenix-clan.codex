# .codex SECTION — Celestial Realms: The Soul of the Empire (Amaterasu Seidō and
# the Centipede founder). Stand-off graph over
# l5r5e-0.4-celestial-realms-phoenix-clan.lore (spec §25). Part of the L5R5e
# system graph; DEPENDS_ON the shared schema. Despite the filename, the essay
# concerns Moshi Azami, Amaterasu Seidō, and the Centipede/Moshi tradition. The
# Centipede Clan Faction is defined in the Centipede Clan section.

CODEX "L5R5e_CR_PhoenixClan_Codex" {
    NAME "Celestial Realms: The Soul of the Empire — Lore Graph"
    VERSION "0.1"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-09-02"
    FOR EDITION "l5r5e"
    DEPENDS_ON "L5R5e_Codex_Schema" VERSION "0.9"

    ENTITY #L5RcxCRphx01amatseid ^"Amaterasu Seidō" {
        IS ^"Temple"
        SOURCE "l5r5e-0.4-celestial-realms-phoenix-clan.lore" AT "the-soul-of-the-empire"
    }
    ENTITY #L5RcxCRphx02elevdaug ^"Eleven Daughters" {
        IS ^"Landmark"
        SOURCE "l5r5e-0.4-celestial-realms-phoenix-clan.lore" AT "the-soul-of-the-empire"
        RELATIONSHIPS { ^"located-near" -> ^"Amaterasu Seidō" FROM "these pillars are known as the Eleven Daughters and are believed to house their spirits as they keep watch over the shrine" }
    }
    ENTITY #L5RcxCRphx03moshazam ^"Moshi Azami" {
        IS ^"Person"
        SOURCE "l5r5e-0.4-celestial-realms-phoenix-clan.lore" AT "the-soul-of-the-empire"
        RELATIONSHIPS {
            ^"member-of"  -> ^"Phoenix Clan"   FROM "dating from long before Isawa Azami stepped foot into the valley"
            ^"founder-of" -> ^"Centipede Clan" FROM "Amaterasu taught Moshi Azami these invocations"
        }
    }
    ENTITY #L5RcxCRphx04lightdoj ^"Light of the Lady Sun Dōjō" {
        IS ^"School"
        SOURCE "l5r5e-0.4-celestial-realms-phoenix-clan.lore" AT "the-soul-of-the-empire"
        RELATIONSHIPS {
            ^"operated-by" -> ^"Centipede Clan"  FROM "Many Moshi, as well as students from other clans, go there to learn the Fire and Air invocations the Centipede are known for"
            ^"located-near" -> ^"Amaterasu Seidō" FROM "The shrine's accompanying school sits farther down the mountain"
        }
    }
}
