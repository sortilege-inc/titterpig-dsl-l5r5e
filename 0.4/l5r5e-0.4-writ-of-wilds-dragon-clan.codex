# .codex SECTION — Writ of the Wilds: The Dragon Clan (and the Dragonfly).
# Stand-off graph over l5r5e-0.4-writ-of-wilds-dragon-clan.lore (spec §25). Part
# of the L5R5e system graph; DEPENDS_ON the shared schema. The Dragon families
# (Togashi/Mirumoto/Agasha/Kitsuki) and Dragonfly (Tonbo) are DEFs; Shiro
# Mirumoto, Nanashi Mura, Kyūden Tonbo, Serpent's Tail Mine, Wrath of the Kami,
# Isawa Moroko, Mirumoto Ashijin, Akodo Yokutsu, and Togashi Yokuni are already
# in the graph (referenced/amended).

CODEX "L5R5e_WoW_DragonClan_Codex" {
    NAME "Writ of the Wilds: The Dragon Clan — Lore Graph"
    VERSION "0.1"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-09-02"
    FOR EDITION "l5r5e"
    DEPENDS_ON "L5R5e_Codex_Schema" VERSION "0.9"

    # -- Mirumoto lands ---------------------------------------------------------

    ENTITY #L5RcxWoWdra01heibesu ^"Heibesu" {
        IS ^"City"
        SOURCE "l5r5e-0.4-writ-of-wilds-dragon-clan.lore" AT "heibesu"
        RELATIONSHIPS { ^"held-by" -> ^"Dragon Clan" FROM "Heibesu is a major commercial hub for the Dragon" }
    }
    ENTITY #L5RcxWoWdra02izakulib ^"Izaku Library" {
        IS ^"Building"
        SOURCE "l5r5e-0.4-writ-of-wilds-dragon-clan.lore" AT "heibesu"
        RELATIONSHIPS { ^"located-in" -> ^"Heibesu" FROM "The Izaku Library, named after a Dragon vassal family, is located here" }
    }
    ENTITY #L5RcxWoWdra03ironmtdj ^"Iron Mountain Dōjō" {
        IS ^"School"
        SOURCE "l5r5e-0.4-writ-of-wilds-dragon-clan.lore" AT "iron-mountain-dōjō"
        RELATIONSHIPS { ^"operated-by" -> ^"Dragon Clan" FROM "this Dōjō has functioned as the training academy for most Dragon bushi" }
    }
    ENTITY #L5RcxWoWdra04pathhoja ^"Path of Hojatsu" {
        IS ^"School"
        SOURCE "l5r5e-0.4-writ-of-wilds-dragon-clan.lore" AT "shiro-mirumoto"
        RELATIONSHIPS { ^"located-in" -> ^"Shiro Mirumoto" FROM "Shiro Mirumoto is also home to the Path of Hojatsu dōjō" }
    }
    ENTITY #L5RcxWoWdra05kichiru ^"Mirumoto Kichiru" {
        IS ^"Person"
        SOURCE "l5r5e-0.4-writ-of-wilds-dragon-clan.lore"
        RELATIONSHIPS { ^"member-of" -> ^"Dragon Clan" FROM "a Mirumoto yōjimbō named Kichiru" }
    }
    ENTITY #L5RcxWoWdra06hideharu ^"Kitsuki Hideharu" {
        IS ^"Person"
        SOURCE "l5r5e-0.4-writ-of-wilds-dragon-clan.lore"
        RELATIONSHIPS { ^"member-of" -> ^"Dragon Clan" FROM "the head of the Dragon delegation, a wizened, older samurai named Kitsuki Hideharu" }
    }
    ENTITY #L5RcxWoWdra07chiyeko ^"Kakita Chiyeko" {
        IS ^"Person"
        SOURCE "l5r5e-0.4-writ-of-wilds-dragon-clan.lore"
        RELATIONSHIPS { ^"member-of" -> ^"Crane Clan" FROM "a renowned duelist present in the court, a woman named Kakita Chiyeko" }
    }

    # -- Agasha lands -----------------------------------------------------------

    ENTITY #L5RcxWoWdra08twistlab ^"The Twisting Labyrinth" {
        IS ^"Region"
        SOURCE "l5r5e-0.4-writ-of-wilds-dragon-clan.lore" AT "lands-of-the-agasha"
        RELATIONSHIPS { ^"held-by" -> ^"Dragon Clan" FROM "The lands of the Agasha, known as The Twisting Labyrinth" }
    }
    ENTITY #L5RcxWoWdra09shiragas ^"Shiro Agasha" {
        IS ^"Castle"
        SOURCE "l5r5e-0.4-writ-of-wilds-dragon-clan.lore" AT "shiro-agasha"
        RELATIONSHIPS {
            ^"held-by"    -> ^"Dragon Clan"        FROM "The ancestral home of the Agasha"
            ^"located-in" -> ^"Fire Tooth Mountain" FROM "looming on the peak of a dormant volcano known as Fire Tooth Mountain"
        }
    }
    ENTITY #L5RcxWoWdra10firetoth ^"Fire Tooth Mountain" {
        IS ^"Mountain"
        SOURCE "l5r5e-0.4-writ-of-wilds-dragon-clan.lore" AT "shiro-agasha"
    }
    ENTITY #L5RcxWoWdra11saclibag ^"Sacred Library of the Agasha" {
        IS ^"Building"
        SOURCE "l5r5e-0.4-writ-of-wilds-dragon-clan.lore" AT "shiro-agasha"
        RELATIONSHIPS { ^"located-in" -> ^"Shiro Agasha" FROM "Shiro Agasha is home to the Sacred Library of the Agasha" }
    }
    ENTITY #L5RcxWoWdra12mysteryls ^"The Mysteries of Leaf and Stone" {
        IS ^"Document"
