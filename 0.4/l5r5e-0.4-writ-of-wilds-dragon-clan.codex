    }
    ENTITY #L5RcxWoWdra13waterhmr ^"Water Hammer City" {
        IS ^"City"
        SOURCE "l5r5e-0.4-writ-of-wilds-dragon-clan.lore" AT "serpents-tail-mine"
        RELATIONSHIPS { ^"held-by" -> ^"Dragon Clan" FROM "endeavors they hone in the forges and furnaces of their holding, Water Hammer City" }
    }
    ENTITY #L5RcxWoWdra14cavecrys ^"Cave of Crystal" {
        IS ^"Landmark"
        SOURCE "l5r5e-0.4-writ-of-wilds-dragon-clan.lore" AT "the-cave-of-crystal"
    }
    ENTITY #L5RcxWoWdra15kesshokm ^"Kesshō no Kami" {
        IS ^"Spirit"
        SOURCE "l5r5e-0.4-writ-of-wilds-dragon-clan.lore" AT "the-cave-of-crystal"
    }
    ENTITY #L5RcxWoWdra16agashinj ^"Agasha Shinji" {
        IS ^"Person"
        SOURCE "l5r5e-0.4-writ-of-wilds-dragon-clan.lore" AT "agasha-shinji-zealous-naturalist"
        RELATIONSHIPS { ^"member-of" -> ^"Dragon Clan" FROM "an intense young man named Agasha Shinji" }
    }

    # -- Kitsuki lands ----------------------------------------------------------

    ENTITY #L5RcxWoWdra17agakitsu ^"Agasha Kitsuki" {
        IS ^"Person"
        SOURCE "l5r5e-0.4-writ-of-wilds-dragon-clan.lore"
        RELATIONSHIPS {
            ^"member-of"  -> ^"Dragon Clan" FROM "a brilliant young Dragon Clan magistrate, Agasha Kitsuki"
            ^"founder-of" -> ^"Kitsuki"     FROM "Kitsuki was granted the enormous honor of founding his own family"
        }
    }
    ENTITY #L5RcxWoWdra18fukuseid ^"Fukurokujin Seidō" {
        IS ^"Temple"
        SOURCE "l5r5e-0.4-writ-of-wilds-dragon-clan.lore" AT "current-concerns"
        RELATIONSHIPS { ^"dedicated-to" -> ^"Fukurokujin" FROM "making a pilgrimage to Fukurokujin Seidō in the Togashi lands" }
    }
    ENTITY #L5RcxWoWdra19saibankn ^"Saibankan" {
        IS ^"Fortune"
        SOURCE "l5r5e-0.4-writ-of-wilds-dragon-clan.lore" AT "current-concerns"
    }
    ENTITY #L5RcxWoWdra20keeneyes ^"Keen Eyes Strike Village" {
