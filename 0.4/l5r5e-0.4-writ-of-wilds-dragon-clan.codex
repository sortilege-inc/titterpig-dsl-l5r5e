    }
    ENTITY #L5RcxWoWdra21distpady ^"Distant Paddy Village" {
        IS ^"Village"
        SOURCE "l5r5e-0.4-writ-of-wilds-dragon-clan.lore" AT "distant-paddy-village"
        RELATIONSHIPS { ^"held-by" -> ^"Dragon Clan" FROM "Distant Paddy Village is the major trade and commercial interface between the Dragon and the rest of the Empire" }
    }
    ENTITY #L5RcxWoWdra22kitnorik ^"Kitsuki Noriko" {
        IS ^"Person"
        SOURCE "l5r5e-0.4-writ-of-wilds-dragon-clan.lore" AT "kitsuki-noriko-conflicted-magistrate"
        RELATIONSHIPS { ^"member-of" -> ^"Dragon Clan" FROM "a magistrate, Kitsuki Noriko" }
    }

    # -- The Dragonfly Clan -----------------------------------------------------

    ENTITY #L5RcxWoWdra23shirtonb ^"Shiro Tonbo" {
        IS ^"Castle"
        SOURCE "l5r5e-0.4-writ-of-wilds-dragon-clan.lore" AT "dragonfly-lands"
        RELATIONSHIPS { ^"held-by" -> ^"Dragonfly Clan" FROM "the Castle of the Dragonfly, also known as Shiro Tonbo" }
    }
    ENTITY #L5RcxWoWdra24mirtomo ^"Mirumoto Tomo" {
        IS ^"Person"
        SOURCE "l5r5e-0.4-writ-of-wilds-dragon-clan.lore" AT "the-rise-to-minor-clan"
        RELATIONSHIPS { ^"member-of" -> ^"Dragon Clan" FROM "his daimyō, Mirumoto Tomo" }
    }
    ENTITY #L5RcxWoWdra25miryuwa ^"Mirumoto Yuwa" {
        IS ^"Person"
        SOURCE "l5r5e-0.4-writ-of-wilds-dragon-clan.lore" AT "the-rise-to-minor-clan"
        RELATIONSHIPS {
            ^"member-of"  -> ^"Dragon Clan"      FROM "his beloved wife, Mirumoto Yuwa, died while giving birth"
            ^"married-to" -> ^"Mirumoto Ashijin" FROM "Ashijin suffered a terrible tragedy when his beloved wife, Mirumoto Yuwa, died"
        }
    }
    ENTITY #L5RcxWoWdra26isaejuko ^"Isawa Ejuko" {
        IS ^"Person"
        SOURCE "l5r5e-0.4-writ-of-wilds-dragon-clan.lore" AT "unrequited-love"
        RELATIONSHIPS { ^"member-of" -> ^"Phoenix Clan" FROM "her teacher, Isawa Ejuko, who was the Master of Water at the time" }
    }
    ENTITY #L5RcxWoWdra27tonbsada ^"Tonbo Sadao" {
        IS ^"Person"
        SOURCE "l5r5e-0.4-writ-of-wilds-dragon-clan.lore"
        RELATIONSHIPS { ^"member-of" -> ^"Dragonfly Clan" FROM "\"Matsu Danuja-sama,\" Sadao smiled beatifically" }
    }
    ENTITY #L5RcxWoWdra28matdanuj ^"Matsu Danuja" {
        IS ^"Person"
        SOURCE "l5r5e-0.4-writ-of-wilds-dragon-clan.lore"
        RELATIONSHIPS { ^"member-of" -> ^"Lion Clan" FROM "\"Matsu Danuja-sama,\" Sadao smiled" }
    }
    ENTITY #L5RcxWoWdra29hallwait ^"Halls of Waiting" {
        IS ^"Landmark"
