    }

    ENTITY ^"Shiro Mirumoto" {
        SOURCE "l5r5e-0.4-writ-of-wilds-dragon-clan.lore" AT "shiro-mirumoto"
        RELATIONSHIPS { ^"held-by" -> ^"Dragon Clan" FROM "The ancestral home of the Mirumoto daimyō" }
    }
    ENTITY ^"Mirumoto Ashijin" {
        SOURCE "l5r5e-0.4-writ-of-wilds-dragon-clan.lore" AT "the-rise-to-minor-clan"
