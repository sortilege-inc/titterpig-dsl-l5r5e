            ^"Advantages" LIST OF STRING ["Determined Nature (Void) [Social; Interpersonal, Mental]"]
            ^"Disadvantages" LIST OF STRING ["Youthful Ignorance (Fire) [Social; Interpersonal, Mental]"]
            ^"Favored Weapons" LIST OF STRING ["Katana: Range 1, Damage 4, Deadliness 5/7, Ceremonial, Razor-Edged"]
            ^"Gear" LIST OF STRING ["Traveling clothes (Physical 2, Durable, Mundane, Subtle)", "wakizashi", "journal of incoherent dream-related notes"]
