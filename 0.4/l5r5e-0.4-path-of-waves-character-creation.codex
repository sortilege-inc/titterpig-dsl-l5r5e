# .codex SECTION — Path of Waves: Creating a Character. Stand-off graph over
# l5r5e-0.4-path-of-waves-character-creation.lore (spec §25). Mechanical — the
# revised Game of Twenty Questions for outcasts (regions, upbringings). Most
# regional/gaijin options reference entities defined elsewhere (Ujik, Yodha +
# Ghostlands, Sheelavaan + Bhavyatapura, Plains of Wind and Stone). New here: the
# Qamarists and their homeland, the Cradle of the World (folded further in the
# Children of the Five Winds Qamarist essay).

CODEX "L5R5e_PoW_CharCreation_Codex" {
    NAME "Path of Waves: Creating a Character — Lore Graph"
    VERSION "0.1"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-09-02"
    FOR EDITION "l5r5e"
    DEPENDS_ON "L5R5e_Codex_Schema" VERSION "0.9"

    ENTITY #L5RcxPoWcc01qamarist ^"Qamarists" {
        IS ^"Faction"
        SOURCE "l5r5e-0.4-path-of-waves-character-creation.lore" AT "qamarists-in-the-cradle-of-the-world"
    }
    ENTITY #L5RcxPoWcc02cradlewd ^"Cradle of the World" {
        IS ^"Region"
        SOURCE "l5r5e-0.4-path-of-waves-character-creation.lore" AT "qamarists-in-the-cradle-of-the-world"
    }
}
