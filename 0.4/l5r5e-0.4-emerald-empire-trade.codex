# .codex SECTION — Emerald Empire: Centers of Trade (Chapter 2 — cities, towns,
# harbors, and the judicial system). Stand-off graph over
# l5r5e-0.4-emerald-empire-trade.lore (spec §25). Part of the L5R5e system graph;
# DEPENDS_ON the shared schema. Covers Otosan Uchi's structure and the Enchanted
# Wall, Ryokō Owari Toshi (the City of Lies), Khanbulak and the Sand Road, Red
# Horn Village and the Kolat, the harbor Fortunes, Gotei City, the City of the
# Rich Frog, and the Emerald/Jade magistracy.

CODEX "L5R5e_Codex_EE_Trade" {
    NAME "Emerald Empire: Centers of Trade — Lore Graph"
    VERSION "0.1"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-09-02"
    FOR EDITION "l5r5e"
    DEPENDS_ON "L5R5e_Codex_Schema" VERSION "0.9"

