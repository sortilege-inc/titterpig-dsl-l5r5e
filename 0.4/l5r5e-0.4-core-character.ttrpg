BASE "L5R5e_Core_Character" {
    NAME "Legend of the Five Rings 5th Edition - Character creation, clans, schools, advantages, and advancement"
    VERSION "0.4.1"
    SPEC_VERSION "0.4"
    RELEASE_DATE "2026-03-01"

    # Core Rulebook: Character creation (Twenty Questions), clans, families,
    # schools, advantages/disadvantages, and advancement system

    # ===========================
    # CHARACTER CREATION: TWENTY QUESTIONS
    # ===========================

    ^"Twenty Questions" DEF {
        APPLIES TO [^"Samurai"]

        # The character creation process is structured as twenty questions
        # answered collaboratively between player and GM. The process
        # determines clan, family, school, rings, skills, advantages,
        # disadvantages, ninjō, giri, and starting equipment.

        PHASES {
            ^"Part I: Core Identity (Clan, Family, School)" DEF {
                1 "What clan does your character belong to? (Sets starting ring, skill, status, glory)"
                2 "What family does your character belong to? (Sets +1 ring, +1 skill, glory modifier)"
                3 "What is your character's school, and what roles does that school fall into? (+1 ring, technique groups, starting techniques, school ability)"
                4 "How does your character stand out within their school? (Choose a unique advantage or disadvantage)"
            }
            ^"Part II: Personality and Behavior" DEF {
                5 "Who is your character's lord? And what is their duty to that lord? (Sets giri)"
                6 "What does your character long for? And how might this be achieved? (Sets ninjō)"
                7 "What is your character's relationship with their clan? (Determines advantages)"
                8 "What does your character think of Bushido? (Sets starting honor)"
                9 "What is your character's greatest accomplishment so far? (Determines skill)"
                10 "What holds your character back most in life? (Determines anxiety or adversity)"
                11 "What activity makes your character feel at peace? (Determines skill)"
                12 "What concern, stake, or obligation makes your character feel stressed? (Determines disadvantage)"
                13 "Who has your character learned the most from during their life? (Determines advantage and ring or skill)"
            }
            ^"Part III: Final Details" DEF {
                14 "What do people notice first upon meeting your character? (Advantage or disadvantage)"
                15 "How does your character react to stressful situations? (Determines anxiety)"
                16 "What are your character's preexisting relationships with other characters?"
                17 "How does your character feel about their position in the Celestial Order?"
                18 "What does your character's name mean? (Choose or create name)"
                19 "How should the other players or GM expect your character to act?"
                20 "What is your character's personal truth? (Final narrative detail)"
            }
        }

        RULES {
            #L5R200aB2cD4eF6gH8iJ0k: twenty_questions_complete_character
            #L5R201lM3nO5pQ7rS9tU1v: questions_are_collaborative
        }
    }

    # ===========================
    # GENERIC TYPES
    # ===========================

    #L5R250aB2cD4eF6gH8iJ0k ^"Clan" DEF {
        APPLIES TO [^"Samurai"]

        # Generic clan type. All clan definitions EXTENDS this type.
        # A clan grants one ring increase, one skill increase, and
        # a starting status value. Each clan contains a FAMILIES block.

        PROPERTIES {
            ^"Clan Name" STRING REQUIRED FIXED
            ^"Clan Ring Bonus" STRING REQUIRED     # "+1 [Ring]"
            ^"Clan Skill Bonus" STRING REQUIRED    # "+1 [Skill]"
            ^"Clan Status" INTEGER MIN 0 MAX 100 REQUIRED
        }

        RULES {
            #L5R202wX4yZ6aB8cD0eF2g: clan_determines_starting_ring
            #L5R203hI5jK7lM9nO1pQ3r: clan_determines_starting_skill
            #L5R204sT6uV8wX0yZ2aB4c: clan_determines_starting_status
        }
    }

    #L5R251lM3nO5pQ7rS9tU1v ^"Family" DEF {
        APPLIES TO [^"Samurai"]

        # Generic family type. Family definitions EXTENDS this type.
        # A family grants a choice between two rings, two skill
        # increases, starting glory, and starting wealth.

        PROPERTIES {
            ^"Family Name" STRING REQUIRED FIXED
            ^"Ring Increase" STRING REQUIRED        # "+1 [Ring] or [Ring]"
            ^"Skill Increases" STRING REQUIRED      # "+1 [Skill], +1 [Skill]"
            ^"Glory" INTEGER MIN 0 MAX 100 REQUIRED
            ^"Starting Wealth" STRING REQUIRED      # "N koku"
        }

        RULES {
            #L5R253aB2cD4eF6gH8iJ0k: family_determines_ring_choice
            #L5R254lM3nO5pQ7rS9tU1v: family_determines_skill_increases
            #L5R255wX4yZ6aB8cD0eF2g: family_determines_starting_glory
            #L5R256hI5jK7lM9nO1pQ3r: family_determines_starting_wealth
        }
    }

    #L5R252wX4yZ6aB8cD0eF2g ^"School" DEF {
        APPLIES TO [^"Samurai"]

        # Generic school type. School definitions EXTENDS this type.
        # A school defines the character's role, ring and skill
        # bonuses, starting honor, technique access, school ability,
        # curriculum, and mastery ability.

        PROPERTIES {
            ^"School Name" STRING REQUIRED FIXED
            ^"Clan" STRING REQUIRED
            ^"Roles" LIST REQUIRED                   # ["Bushi"], ["Courtier", "Shugenja"], etc.
            ^"Ring Increase" STRING REQUIRED          # "+1 [Ring], +1 [Ring]"
            ^"Starting Skills" STRING REQUIRED        # "choose N: +1 [Skill], +1 [Skill], ..."
            ^"Starting Honor" INTEGER MIN 0 MAX 100 REQUIRED
            ^"Techniques Available" LIST REQUIRED     # ["Kata", "Rituals", "Shūji"]
        }

        RULES {
            #L5R219bC1dE3fG5hI7jK9l: school_determines_technique_access
            #L5R220mN2oP4qR6sT8uV0w: school_rank_advancement
            #L5R221xY3zA5bC7dE9fG1h: mastery_ability_at_rank_six
        }
    }

    # ===========================
    # GREAT CLANS
    # ===========================

    ^"Crab Clan" DEF {
        EXTENDS #L5R250aB2cD4eF6gH8iJ0k ^"Clan"
        APPLIES TO [^"Samurai"]

        # The Defenders of the Wall. The Crab protect the Empire from
        # the horrors of the Shadowlands. They value strength, duty,
        # and practical skill above courtly refinement.

        PROPERTIES {
            ^"Clan Name" STRING "Crab" FIXED
            ^"Clan Ring Bonus" DEF { ^"Earth" INTEGER 1 }
            ^"Clan Skill Bonus" DEF { ^"Fitness" INTEGER 1 }
            ^"Clan Status" INTEGER DEFAULT 30
        }

        FAMILIES {
            ^"Hida"
            ^"Hiruma"
            ^"Kaiu"
            ^"Kuni"
            ^"Yasuki"
        }

        RULES {
            #L5R205dE7fG9hI1jK3lM5n: crab_wall_defenders
            #L5R206oP8qR0sT2uV4wX6y: crab_practical_warriors
        }
    }


