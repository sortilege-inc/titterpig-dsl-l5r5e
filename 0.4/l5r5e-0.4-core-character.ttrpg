BASE "L5R5e_Core_Character" {
    NAME "Legend of the Five Rings 5th Edition - Character creation, clans, schools, advantages, and advancement"
    VERSION "0.4.8"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-03-01"

    # Core Rulebook: Character creation (Twenty Questions), clans, families,
    # schools, advantages/disadvantages, and advancement system

    # ===========================
    # CHARACTER CREATION: TWENTY QUESTIONS
    # ===========================

    ^"Twenty Questions" DEF {
        APPLIES TO [^"Samurai"]

        # The character creation process is structured as twenty questions
        # answered collaboratively between player and GM. The process
        # determines clan, family, school, rings, skills, advantages,
        # disadvantages, ninjō, giri, and starting equipment.

        PHASES {
            ^"Part I: Core Identity (Clan and Family)" DEF {
                1 "What clan does your character belong to? (+1 ring, +1 skill, sets status)"
                2 "What family does your character belong to? (+1 ring of two, +1 rank in each of two skills, sets glory and starting koku)"
            }
            ^"Part II: Role and School" DEF {
                3 "What is your character's school, and what roles does that school fall into? (Ring and skill increases, starting techniques, school ability, outfit, technique groups, sets honor)"
                4 "How does your character stand out within their school? (Choose one ring and gain +1 rank)"
            }
            ^"Part III: Honor and Glory" DEF {
                5 "Who is your lord, and what is your character's duty to them? (Sets giri)"
                6 "What does your character long for, and how might this impede their duty? (Sets ninjo)"
                7 "What is your character's relationship with their clan? (Either +5 glory, or +1 rank in a skill at rank 0)"
                8 "What does your character think of Bushido? (Sets paramount and less significant tenets)"
            }
            ^"Part IV: Strengths and Weaknesses" DEF {
                9 "What is your character's greatest accomplishment so far? (Gain a distinction)"
                10 "What holds your character back the most in life? (Gain an adversity)"
                11 "What activity most makes your character feel at peace? (Gain a passion)"
                12 "What concern, fear, or foible troubles your character the most? (Gain an anxiety)"
                13 "Who has your character learned the most from during their life? (Either an advantage, or a disadvantage plus +1 rank in a skill)"
            }
            ^"Part V: Personality and Behavior" DEF {
                14 "What do people notice first upon encountering your character? (Choose an aesthetic accoutrement)"
                15 "How does your character react to stressful situations? (Narrative only)"
                16 "What are your character's preexisting relationships with other clans, families, organizations, and traditions? (Gain one item of rarity 7 or lower)"
                17 "How would your character's parents describe them? (+1 rank in a skill at rank 0)"
                18 "Who was your character named to honor? (Roll on the Samurai Heritage table)"
                19 "What is your character's personal name? (Narrative only)"
                20 "How should your character die? (Narrative only)"
            }
        }

        RULES {
            #L5R200aB2cD4eF6gH8iJ0k: twenty_questions_complete_character
            #L5R201lM3nO5pQ7rS9tU1v: questions_are_collaborative
        }
    }

    # -----------------------------------------------------------------------
    # GUIDANCE (§22) — chargen-chapter advice sidebars (book pp.42, 57).
    # -----------------------------------------------------------------------
    GUIDANCE {
        ENTRY ^"creating-npcs" #L5RG54hI7jK8lM9nO0pQ1r {
            CONCERNS [ ^"Twenty Questions" ]
            TOPICS [ "character creation", "npcs", "game master" ]
            TEXT "While GMs certainly can use the rules in this chapter to create NPCs (non-player characters) if they wish, these rules are more suited to the creation of PCs (player characters). While this chapter contains many useful ideas that could shape the desires and motivations of NPCs, NPCs created in this manner would be more mechanically detailed than most of the examples that can be found in Chapter 8: Non-Player Characters."
        }
        ENTRY ^"elements-of-your-school" #L5RG55iJ8kL9mN0oP1qR2s {
            CONCERNS [ ^"School" ]
            TOPICS [ "schools", "character creation" ]
            TEXT "Each of the schools presented here follows a certain mold. Let's take a moment and go over the different elements that go into each school, and how that modifies your character."
        }
        ENTRY ^"curriculums-and-divergences-in-rokugan" #L5RG58lM1nO2pQ3rS4tU5v {
            CONCERNS [ ^"School" ]
            TOPICS [ "schools", "curriculum", "advancement" ]
            TEXT "Not all samurai agree with the requirements laid down by their sensei, which is why some leave to develop their own schools. Samurai are, of course, permitted to pursue other studies as they see fit, but in the school's eyes, these extracurricular pursuits are extraneous and do not count toward advancement. By contrast, samurai might focus solely on their school's curriculum and advance through the school ranks more quickly, but in doing so, they will not have time to pursue their own interests and studies. Most samurai take a balanced approach, following the path of their school and supplementing their studies with their own hobbies and interests."
        }
    }

    # ===========================
    # GENERIC TYPES
    # ===========================

    #L5R250aB2cD4eF6gH8iJ0k ^"Clan" DEF {
        APPLIES TO [^"Samurai"]

        # Generic clan type. All clan definitions EXTENDS this type.
        # A clan grants one ring increase, one skill increase, and
        # a starting status value. Each clan contains a FAMILIES block.

        PROPERTIES {
            ^"Clan Name" STRING REQUIRED FIXED
            ^"Clan Ring Bonus" STRING REQUIRED     # "+1 [Ring]"
            ^"Clan Skill Bonus" STRING REQUIRED    # "+1 [Skill]"
            ^"Clan Status" INTEGER MIN 0 MAX 100 REQUIRED
        }

        RULES {
            #L5R202wX4yZ6aB8cD0eF2g: clan_determines_starting_ring
            #L5R203hI5jK7lM9nO1pQ3r: clan_determines_starting_skill
            #L5R204sT6uV8wX0yZ2aB4c: clan_determines_starting_status
        }
    }

    #L5R251lM3nO5pQ7rS9tU1v ^"Family" DEF {
        APPLIES TO [^"Samurai"]

        # Generic family type. Family definitions EXTENDS this type.
        # A family grants a choice between two rings, two skill
        # increases, starting glory, and starting wealth.

        PROPERTIES {
            ^"Family Name" STRING REQUIRED FIXED
            ^"Ring Increase" STRING REQUIRED        # "+1 [Ring] or [Ring]"
            ^"Skill Increases" STRING REQUIRED      # "+1 [Skill], +1 [Skill]"
            ^"Glory" INTEGER MIN 0 MAX 100 REQUIRED
            ^"Starting Wealth" STRING REQUIRED      # "N koku"
        }

        RULES {
            #L5R253aB2cD4eF6gH8iJ0k: family_determines_ring_choice
            #L5R254lM3nO5pQ7rS9tU1v: family_determines_skill_increases
            #L5R255wX4yZ6aB8cD0eF2g: family_determines_starting_glory
            #L5R256hI5jK7lM9nO1pQ3r: family_determines_starting_wealth
        }
    }

    #L5R252wX4yZ6aB8cD0eF2g ^"School" DEF {
        APPLIES TO [^"Samurai"]

        # Generic school type. School definitions EXTENDS this type.
        # A school defines the character's role, ring and skill
        # bonuses, starting honor, technique access, school ability,
        # curriculum, and mastery ability.

        PROPERTIES {
            ^"School Name" STRING REQUIRED FIXED
            ^"Clan" STRING REQUIRED
            ^"Roles" LIST REQUIRED                   # ["Bushi"], ["Courtier", "Shugenja"], etc.
            ^"Ring Increase" STRING REQUIRED          # "+1 [Ring], +1 [Ring]"
            ^"Starting Skills" STRING REQUIRED        # "choose N: +1 [Skill], +1 [Skill], ..."
            ^"Starting Honor" INTEGER MIN 0 MAX 100 REQUIRED
            ^"Techniques Available" LIST REQUIRED     # ["Kata", "Rituals", "Shūji"]
        }

        RULES {
            #L5R219bC1dE3fG5hI7jK9l: school_determines_technique_access
            #L5R220mN2oP4qR6sT8uV0w: school_rank_advancement
            #L5R221xY3zA5bC7dE9fG1h: mastery_ability_at_rank_six
        }
    }

    # ===========================
    # GREAT CLANS
    # ===========================

    # -----------------------------------------------------------------------
    # GUIDANCE (§22) — per-clan "What does your character know?" (book pp.42-48):
    # the setting knowledge a character of each Great Clan possesses.
    # -----------------------------------------------------------------------
    GUIDANCE {
        ENTRY ^"crab-character-knowledge" #L5RG40aB1cD2eF3gH4iJ5k {
            CONCERNS [ ^"Crab Clan" ]
            TOPICS [ "clan knowledge", "crab" ]
            TEXT "All Crab Clan characters have a greater awareness of the following topics: • You have a general awareness of the politics within Crab lands. You can name major family heads and other leaders, and you know their respective positions and allegiances. • You can identify common Shadowlands creatures such as goblins, ogres, and zombies, and you know how to dispatch them. • You grew up hearing stories and songs of heroes who faced greater evils still, such as oni, but you likely have not encountered such horrors personally. • You know all too well the befouling Taint of the Shadowlands and how best to avoid it, and you can recognize the advanced stages of this unnatural corruption."
        }
        ENTRY ^"crane-character-knowledge" #L5RG41bC2dE3fG4hI5jK6l {
            CONCERNS [ ^"Crane Clan" ]
            TOPICS [ "clan knowledge", "crane" ]
            TEXT "All Crane Clan characters have a greater awareness of the following topics: • You have a strong awareness of the politics within Crane lands. You can name major family heads and other leaders, and you know their respective positions and allegiances. • You know about the general state of political affairs between the clans. • You know proper etiquette and protocol in the Imperial Capital. • You have a working knowledge of the high arts and the great masters of old (at least, among the Crane, for who else truly warrants note?)."
        }
        ENTRY ^"dragon-character-knowledge" #L5RG42cD3eF4gH5iJ6kL7m {
            CONCERNS [ ^"Dragon Clan" ]
            TOPICS [ "clan knowledge", "dragon" ]
            TEXT "All Dragon Clan characters have a greater awareness of the following topics: • You have a general awareness of the politics within Dragon lands. You can name major family heads and other leaders, and you know their respective positions and allegiances. • You know more about monastic life and traditions than most other clans, having likely interacted with the Togashi Order throughout your life. • Due to the rugged nature of your homeland, you know how to properly prepare mountain flora and wildlife for human consumption. • You have a working understanding of many physical phenomena of the natural world, which others dismiss as uninteresting or beneath their station."
        }
        ENTRY ^"lion-character-knowledge" #L5RG43dE4fG5hI6jK7lM8n {
            CONCERNS [ ^"Lion Clan" ]
            TOPICS [ "clan knowledge", "lion" ]
            TEXT "All Lion Clan characters have a greater awareness of the following topics: • You have a general awareness of the politics within Lion lands. You can name major family heads and other leaders, and you know their respective positions and allegiances. • You know military history quite well, especially as it pertains to the glorious deeds of your forebears. • You can identify and know the proper purpose of all Rokugani battlefield weapons, even if you are not personally proficient in their use. • You know about most common military maneuvers and engagements, such as feigned retreats, flank attacks, raids, and sieges."
        }
        ENTRY ^"phoenix-character-knowledge" #L5RG44eF5gH6iJ7kL8mN9o {
            CONCERNS [ ^"Phoenix Clan" ]
            TOPICS [ "clan knowledge", "phoenix" ]
            TEXT "All Phoenix Clan characters have a greater awareness of the following topics: • You have a general awareness of the politics within Phoenix lands. You can name major family heads and other leaders, and you know their respective positions and allegiances. • You are familiar with the religious practices of Rokugan, such as the rites practiced by various priesthoods, the invocations of shugenja, the Tao of Shinsei, and even the traditions that existed before the Kami, such as the Fortunist traditions of the Isawa and the animist practices of the Yobanjin who dwell in the Great Wall of the North Mountains. • You know some of the most significant kami who reside in Phoenix lands by name from stories or perhaps even personal interaction. • You know the names and locations of all major shrines in Rokugan."
        }
        ENTRY ^"scorpion-character-knowledge" #L5RG45fG6hI7jK8lM9nO0p {
            CONCERNS [ ^"Scorpion Clan" ]
            TOPICS [ "clan knowledge", "scorpion" ]
            TEXT "All Scorpion Clan characters have a greater awareness of the following topics: • You have a strong awareness of the politics within Scorpion lands. You can name major family heads and other leaders, and you know their respective positions and allegiances. • You know about the general state of political affairs between the clans. • You are aware of the most substantial criminal cartels in the Emerald Empire, especially as their interests overlap or conflict with those of the Scorpion Clan. • You know the state of court matters in the Imperial Capital."
        }
        ENTRY ^"unicorn-character-knowledge" #L5RG46gH7iJ8kL9mN0oP1q {
            CONCERNS [ ^"Unicorn Clan" ]
            TOPICS [ "clan knowledge", "unicorn" ]
            TEXT "All Unicorn Clan characters have a greater awareness of the following topics: • You have a general awareness of the politics within Unicorn lands. You can name major family heads and other leaders, and you know their respective positions and allegiances. • You know many basic facts of life about foreign lands, particularly the Burning Sands, the Ivory Kingdoms, and beyond, even if you have not journeyed there yourself. • You know at least some foreign words from numerous languages, such as Nehiri, Ivindi, Myantu, and Portuga, and might fluently speak one of these or even a language wholly unknown in the Emerald Empire. • You know the basics of mounted combat tactics, along with various other aspects of the proper handling and care of horses."
        }
    }

    # -----------------------------------------------------------------------
    # GUIDANCE (§22) — per-clan "What does Bushidō mean to your clan?"
    # (book pp.42-48): each Great Clan's interpretation of the virtues.
    # -----------------------------------------------------------------------
    GUIDANCE {
        ENTRY ^"crab-bushido-meaning" #L5RG47aB1cD2eF3gH4i {
            CONCERNS [ ^"Crab Clan" ]
            TOPICS [ "bushido", "crab" ]
            TEXT "Courage is the greatest virtue in Crab lands, for the Kami Hida placed an especially grave task on the shoulders of his descendants. The Crab safeguard the most perilous border of the Emerald Empire, warding it against the terrible hordes of Fu Leng. The consequences of failure are obvious and dreadful to contemplate. Rough and warlike, the Crab have never truly adopted the strict social refinement the other clans have come to demand of their constituents, and so Courtesy is defined somewhat more loosely for the Crab. See page 301 for more information on how these can affect your honor and glory."
        }
        ENTRY ^"crane-bushido-meaning" #L5RG48bC2dE3fG4hI5j {
            CONCERNS [ ^"Crane Clan" ]
            TOPICS [ "bushido", "crane" ]
            TEXT "Courtesy is of deep importance to you, as your clan’s political power rests upon propriety and the idea of others respecting their proper place—and your own. While many members of the Crane Clan are deeply brave, Courage in excess can lead to foolhardiness. Cool heads must prevail, and sometimes that means avoiding a fight altogether. See page 301 for more information on how these can affect your honor and glory."
        }
        ENTRY ^"dragon-bushido-meaning" #L5RG49cD3eF4gH5iJ6k {
            CONCERNS [ ^"Dragon Clan" ]
            TOPICS [ "bushido", "dragon" ]
            TEXT "Sincerity—aligning one’s words and deeds with one’s intentions—is the greatest virtue to the Dragon Clan. In this way, its samurai may remain true to themselves even if they should fail. While members of the Dragon Clan take their obligations seriously, they define Duty and Loyalty somewhat differently than most other samurai. To a Dragon, unquestioning loyalty is not loyalty at all, and Dragon Clan lords have been known to tolerate and even value criticism that others would see as grave insubordination. See page 301 for more information on how these can affect your honor and glory."
        }
        ENTRY ^"lion-bushido-meaning" #L5RG50dE4fG5hI6jK7l {
            CONCERNS [ ^"Lion Clan" ]
            TOPICS [ "bushido", "lion" ]
            TEXT "Honor is at the center of the Lion Clan’s view of Bushidō, especially in the context of martial virtue. Its samurai learn to be the harshest judges of themselves and their actions, for without honor, the other virtues ring hollow. This emphasis on Honor colors the clan’s perception of Compassion, for only those who comport themselves with Honor are worthy of the Lion Clan’s benevolence. See page 301 for more information on how these can affect your honor and glory."
        }
        ENTRY ^"phoenix-bushido-meaning" #L5RG51eF5gH6iJ7kL8m {
            CONCERNS [ ^"Phoenix Clan" ]
            TOPICS [ "bushido", "phoenix" ]
            TEXT "Righteousness drives the samurai of the Phoenix Clan in their pursuits, and they are willing to sacrifice themselves to ensure the right thing is done. They know that when samurai do not govern their lands justly, the Heavens themselves will voice their displeasure. At the same time, some truths must not be revealed to the world, and some mysteries are not meant even for the other samurai clans. The Phoenix Clan takes a selective view of Sincerity, certain in their belief that they are the best equipped to protect and wield certain knowledge. See page 301 for more information on how these can affect your honor and glory."
        }
        ENTRY ^"scorpion-bushido-meaning" #L5RG52fG6hI7jK8lM9n {
            CONCERNS [ ^"Scorpion Clan" ]
            TOPICS [ "bushido", "scorpion" ]
            TEXT "Duty and Loyalty is the core tenet of the Scorpion Clan. They must be prepared to do— and sacrifice—anything and everything in the service of the Empire. Honor and Righteousness fall by the wayside for most Scorpion. While they are not wholly unimportant, obsessing over such matters would make many vital tasks impossible. See page 301 for more information on how these can affect your honor and glory."
        }
        ENTRY ^"unicorn-bushido-meaning" #L5RG53gH7iJ8kL9mN0o {
            CONCERNS [ ^"Unicorn Clan" ]
            TOPICS [ "bushido", "unicorn" ]
            TEXT "Compassion is the most significant tenet of Bushidō to the Unicorn Clan, for mutual understanding and cooperation was the key to the clan’s survival during its long journey across the wider world. On this journey, members of the Unicorn Clan met many people with a wide variety of beliefs, cultures, and values, and they became far more accustomed to coexistence with strange outsiders than are most Great Clan samurai. The Unicorn Clan has had several centuries to acclimate to the Emerald Empire, to which it has returned, but the customs and culture they adopted during their travels remain a powerful force within the clan. These customs often clash with the Rokugani concept of Courtesy, and the Unicorn’s seeming dismissal of Rokugani politeness is one of the most contentious ways in which Shinjo’s clan differs from those of her siblings. See page 301 for more information on how these can affect your honor and glory."
        }
    }

    ^"Crab Clan" DEF {
        EXTENDS #L5R250aB2cD4eF6gH8iJ0k ^"Clan"
        APPLIES TO [^"Samurai"]

        # The Defenders of the Wall. The Crab protect the Empire from
        # the horrors of the Shadowlands. They value strength, duty,
        # and practical skill above courtly refinement.

        PROPERTIES {
            ^"Clan Name" STRING "Crab" FIXED
            ^"Clan Ring Bonus" DEF { ^"Earth" INTEGER 1 }
            ^"Clan Skill Bonus" DEF { ^"Fitness" INTEGER 1 }
            ^"Clan Status" INTEGER DEFAULT 30
        }

        FAMILIES {
            ^"Hida"
            ^"Hiruma"
            ^"Kaiu"
            ^"Kuni"
            ^"Yasuki"
        }

        RULES {
            #L5R205dE7fG9hI1jK3lM5n: crab_wall_defenders
            #L5R206oP8qR0sT2uV4wX6y: crab_practical_warriors
        }
    }


    # ===========================
    # CRAB FAMILIES
    # ===========================

    #L5R270aB2cD4eF6gH8iJ0k ^"Hida" DEF {
        EXTENDS #L5R251lM3nO5pQ7rS9tU1v ^"Family"
        APPLIES TO [^"Samurai"]

        PROPERTIES {
            ^"Family Name"     STRING "Hida" FIXED
            ^"Clan"            STRING "Crab"
            ^"Ring Increase" DEF { CHOOSE 1 [^"Earth", ^"Fire"] INTEGER 1 }
            ^"Skill Increases" DEF {
                ^"Command" INTEGER 1
                ^"Tactics" INTEGER 1
            }
            ^"Glory"           INTEGER 44
            ^"Starting Wealth" INTEGER 4
        }
    }

    #L5R271lM3nO5pQ7rS9tU1v ^"Hiruma" DEF {
        EXTENDS #L5R251lM3nO5pQ7rS9tU1v ^"Family"
        APPLIES TO [^"Samurai"]

        PROPERTIES {
            ^"Family Name"     STRING "Hiruma" FIXED
            ^"Clan"            STRING "Crab"
            ^"Ring Increase" DEF { CHOOSE 1 [^"Air", ^"Water"] INTEGER 1 }
            ^"Skill Increases" DEF {
                ^"Skulduggery" INTEGER 1
                ^"Survival" INTEGER 1
            }
            ^"Glory"           INTEGER 39
            ^"Starting Wealth" INTEGER 3
        }
    }

    #L5R272wX4yZ6aB8cD0eF2g ^"Kaiu" DEF {
        EXTENDS #L5R251lM3nO5pQ7rS9tU1v ^"Family"
        APPLIES TO [^"Samurai"]

        PROPERTIES {
            ^"Family Name"     STRING "Kaiu" FIXED
            ^"Clan"            STRING "Crab"
            ^"Ring Increase" DEF { CHOOSE 1 [^"Earth", ^"Fire"] INTEGER 1 }
            ^"Skill Increases" DEF {
                ^"Smithing" INTEGER 1
                ^"Labor" INTEGER 1
            }
            ^"Glory"           INTEGER 40
            ^"Starting Wealth" INTEGER 5
        }
    }

    #L5R273hI5jK7lM9nO1pQ3r ^"Kuni" DEF {
        EXTENDS #L5R251lM3nO5pQ7rS9tU1v ^"Family"
        APPLIES TO [^"Samurai"]

        PROPERTIES {
            ^"Family Name"     STRING "Kuni" FIXED
            ^"Clan"            STRING "Crab"
            ^"Ring Increase" DEF { CHOOSE 1 [^"Earth", ^"Void"] INTEGER 1 }
            ^"Skill Increases" DEF {
                ^"Medicine" INTEGER 1
                ^"Theology" INTEGER 1
            }
            ^"Glory"           INTEGER 40
            ^"Starting Wealth" INTEGER 4
        }
    }

    #L5R274sT6uV8wX0yZ2aB4c ^"Yasuki" DEF {
        EXTENDS #L5R251lM3nO5pQ7rS9tU1v ^"Family"
        APPLIES TO [^"Samurai"]

        PROPERTIES {
            ^"Family Name"     STRING "Yasuki" FIXED
            ^"Clan"            STRING "Crab"
            ^"Ring Increase" DEF { CHOOSE 1 [^"Air", ^"Water"] INTEGER 1 }
            ^"Skill Increases" DEF {
                ^"Commerce" INTEGER 1
                ^"Design" INTEGER 1
            }
            ^"Glory"           INTEGER 39
            ^"Starting Wealth" INTEGER 10
        }
    }


    ^"Crane Clan" DEF {
        EXTENDS #L5R250aB2cD4eF6gH8iJ0k ^"Clan"
        APPLIES TO [^"Samurai"]

        # The Left Hand of the Emperor. The Crane are the undisputed
        # masters of politics and culture, setting the standard for
        # art, fashion, and courtly behavior.

        PROPERTIES {
            ^"Clan Name" STRING "Crane" FIXED
            ^"Clan Ring Bonus" DEF { ^"Air" INTEGER 1 }
            ^"Clan Skill Bonus" DEF { ^"Culture" INTEGER 1 }
            ^"Clan Status" INTEGER DEFAULT 35
        }

        FAMILIES {
            ^"Asahina"
            ^"Daidoji"
            ^"Doji"
            ^"Kakita"
        }

        RULES {
            #L5R207zA9bC1dE3fG5hI7j: crane_political_masters
            #L5R208kL0mN2oP4qR6sT8u: crane_cultural_arbiters
        }
    }


    # ===========================
    # CRANE FAMILIES
    # ===========================

    #L5R275dE7fG9hI1jK3lM5n ^"Asahina" DEF {
        EXTENDS #L5R251lM3nO5pQ7rS9tU1v ^"Family"
        APPLIES TO [^"Samurai"]

        PROPERTIES {
            ^"Family Name"     STRING "Asahina" FIXED
            ^"Clan"            STRING "Crane"
            ^"Ring Increase" DEF { CHOOSE 1 [^"Water", ^"Void"] INTEGER 1 }
            ^"Skill Increases" DEF {
                ^"Aesthetics" INTEGER 1
                ^"Theology" INTEGER 1
            }
            ^"Glory"           INTEGER 40
            ^"Starting Wealth" INTEGER 6
        }
    }

    #L5R276oP8qR0sT2uV4wX6y ^"Daidoji" DEF {
        EXTENDS #L5R251lM3nO5pQ7rS9tU1v ^"Family"
        APPLIES TO [^"Samurai"]

        PROPERTIES {
            ^"Family Name"     STRING "Daidoji" FIXED
            ^"Clan"            STRING "Crane"
            ^"Ring Increase" DEF { CHOOSE 1 [^"Earth", ^"Water"] INTEGER 1 }
            ^"Skill Increases" DEF {
                ^"Fitness" INTEGER 1
                ^"Tactics" INTEGER 1
            }
            ^"Glory"           INTEGER 40
            ^"Starting Wealth" INTEGER 7
        }
    }

    #L5R277zA9bC1dE3fG5hI7j ^"Doji" DEF {
        EXTENDS #L5R251lM3nO5pQ7rS9tU1v ^"Family"
        APPLIES TO [^"Samurai"]

        PROPERTIES {
            ^"Family Name"     STRING "Doji" FIXED
            ^"Clan"            STRING "Crane"
            ^"Ring Increase" DEF { CHOOSE 1 [^"Air", ^"Water"] INTEGER 1 }
            ^"Skill Increases" DEF {
                ^"Courtesy" INTEGER 1
                ^"Design" INTEGER 1
            }
            ^"Glory"           INTEGER 44
            ^"Starting Wealth" INTEGER 8
        }
    }

    #L5R278kL0mN2oP4qR6sT8u ^"Kakita" DEF {
        EXTENDS #L5R251lM3nO5pQ7rS9tU1v ^"Family"
        APPLIES TO [^"Samurai"]

        PROPERTIES {
            ^"Family Name"     STRING "Kakita" FIXED
            ^"Clan"            STRING "Crane"
            ^"Ring Increase" DEF { CHOOSE 1 [^"Air", ^"Fire"] INTEGER 1 }
            ^"Skill Increases" DEF {
                ^"Aesthetics" INTEGER 1
                ^"Meditation" INTEGER 1
            }
            ^"Glory"           INTEGER 44
            ^"Starting Wealth" INTEGER 7
        }
    }


    ^"Dragon Clan" DEF {
        EXTENDS #L5R250aB2cD4eF6gH8iJ0k ^"Clan"
        APPLIES TO [^"Samurai"]

        # The seekers of Enlightenment. Isolated in their mountain
