    # ===========================
    # NON-CLAN FAMILIES
    # ===========================

    # Core Rulebook, Chapter 7: The Game Master, "Rise from the Dust"
    # alternate playstyle (p. 306). Used by characters who are not
    # samurai of a Great Clan (peasants, ashigaru, merchants,
    # burakumin, and rōnin who are not fallen samurai).

    #dQzGwI2RcFzv6ZAdl7V76g ^"Peasant Family" DEF {
        EXTENDS #L5R251lM3nO5pQ7rS9tU1v ^"Family"
        APPLIES TO [^"Samurai"]

        PROPERTIES {
            ^"Family Name"     STRING "Peasant" FIXED
            ^"Ring Increase" DEF { CHOOSE 1 [^"Air", ^"Earth", ^"Fire", ^"Water", ^"Void"] INTEGER 1 }
            ^"Skill Increases" DEF {
                CHOOSE 2 [^"Commerce", ^"Labor", ^"Seafaring", ^"Skulduggery", ^"Survival"] INTEGER 1
            }
            ^"Glory"           INTEGER 25
            ^"Starting Wealth" DEF { ^"Zeni" INTEGER 10 }
        }

        RULES {
            #Vn9Za1awCH9APjrRNFRyAw: peasant_family_default_for_non_samurai "Question 2: Who is your family? Unless you are a fallen samurai, your family falls far beneath the notice of the Great Clans—you might have no family but the comrades you choose for yourself. Use the Rokugani peasant family above unless you are a fallen samurai, in which case choose a family as normal."
        }
    }


    # ===========================
    # SCHOOL ROLES
    # ===========================

    #L5R260aB2cD4eF6gH8iJ0k ^"School Role" DEF {
        APPLIES TO [^"Samurai"]

        ENUM ["Bushi", "Courtier", "Shugenja", "Monk", "Shinobi"]

        # The five primary school roles. A school may have one or
        # more roles. Individual schools EXTENDS #L5R252wX4yZ6aB8cD0eF2g ^"School" (defined
        # in the Generic Types section above).
        #
        # Bushi: Warriors trained in martial arts and battlefield tactics
        # Courtier: Politicians trained in social skills and court intrigue
        # Shugenja: Priests who commune with the elemental kami
        # Monk: Ascetics who pursue enlightenment through discipline
        # Shinobi: Spies and assassins (typically Scorpion)
    }

    #L5R261lM3nO5pQ7rS9tU1v ^"School Rank" DEF {
        APPLIES TO [^"Samurai"]

        INTEGER MIN 1 MAX 6

        # Characters advance through school ranks by completing their
        # curriculum. Each rank unlocks new techniques, skills, and rings.
        # Rank 6 grants the school's Mastery Ability.
        #
        # Advancement requires completing enough curriculum entries
        # at each rank before advancing to the next.

        RULES {
            #L5R222iJ4kL6mN8oP0qR2s: curriculum_completion_required
            #L5R223tU5vW7xY9zA1bC3d: rank_unlocks_technique_access
            #L5R224eF6gH8iJ0kL2mN4o: rank_six_mastery_ability
        }
    }

    # ===========================
    # METATYPE ANCHORS
    # ===========================

    #L5R262wX4yZ6aB8cD0eF2g ^"Bond" DEF {
        # Metatype anchor for character bond definitions
    }

    # ===========================
    # ADVANTAGES AND DISADVANTAGES
    # ===========================

    #L5R263hI5jK7lM9nO1pQ3r ^"Advantage" DEF {
        APPLIES TO [^"Samurai", ^"Adversary"]

        # Positive traits that benefit a character. Two types:
        # Distinctions and Passions.

        TYPES {
            ^"Distinction" "Innate or trained positive qualities. When applicable, reroll up to 2 dice."
            ^"Passion" "Emotional drives that energize. When applicable, remove 3 strife after resolving check."
        }

        PROPERTIES {
            ^"Type" ENUM ["Distinction", "Passion"]
            ^"Category" LIST OF STRING  # e.g., ["Physical", "Mental"]
            ^"Ring" STRING      # Associated ring
            ^"Description" STRING
        }

        RULES {
            #L5R225pQ7rS9tU1vW3xY5z: distinction_reroll_two_dice
            #L5R226aB8cD0eF2gH4iJ6k: passion_remove_three_strife
            #L5R227lM9nO1pQ3rS5tU7v: gm_and_player_agree_on_applicability
            #L5R228wX0yZ2aB4cD6eF8g: each_applies_once_per_check
        }
    }

    #L5R264sT6uV8wX0yZ2aB4c ^"Disadvantage" DEF {
        APPLIES TO [^"Samurai", ^"Adversary"]

        # Negative traits that challenge a character. Two types:
        # Adversities and Anxieties.

        TYPES {
            ^"Adversity" "Physical, mental, or social burdens. When applicable, must reroll 2 dice showing (su) or (ex). If check fails, gain 1 Void point."
            ^"Anxiety" "Emotional triggers that cause distress. When applicable, receive 3 strife after resolving check. First time per scene, gain 1 Void point."
        }

        PROPERTIES {
            ^"Type" ENUM ["Adversity", "Anxiety"]
            ^"Category" LIST OF STRING
            ^"Ring" STRING
            ^"Description" STRING
        }

        RULES {
            #L5R229hI1jK3lM5nO7pQ9r: adversity_reroll_successes
            #L5R230sT2uV4wX6yZ8aB0c: adversity_void_point_on_failure
            #L5R231dE3fG5hI7jK9lM1n: anxiety_receive_three_strife
            #L5R232oP4qR6sT8uV0wX2y: anxiety_void_point_first_per_scene
            #L5R233zA5bC7dE9fG1hI3j: advantages_cancel_disadvantages
        }
    }

    #L5R265dE7fG9hI1jK3lM5n ^"Advantage Interaction" DEF {

        # Advantages and disadvantages interact during checks.
        # Applied distinctions cancel applied adversities (and vice versa).
        # Applied passions cancel applied anxieties (and vice versa).
        # Canceled advantages/disadvantages have no effect.

        INTERACTIONS {
            "Inverting Your Advantage: Convert own advantage to disadvantage if creates logical vulnerability. Gain 1 Void point."
            "Seizing a Target's Advantage: Spend 1 Void point to use target's advantage against them."
            "Leveraging Your Disadvantage: Spend 1 Void point to use own disadvantage as advantage."
            "Exploiting a Target's Disadvantage: Spend 1 Void point to use target's disadvantage against them."
        }

        RULES {
            #L5R234kL6mN8oP0qR2sT4u: distinction_cancels_adversity
            #L5R235vW7xY9zA1bC3dE5f: passion_cancels_anxiety
            #L5R236gH8iJ0kL2mN4oP6q: void_point_interaction_cost
        }
    }

    # ===========================
    # ADVANTAGE AND DISADVANTAGE SUBTYPES
    # ===========================

    #L5R266oP8qR0sT2uV4wX6y ^"Distinction" DEF {
        EXTENDS #L5R263hI5jK7lM9nO1pQ3r ^"Advantage"
        APPLIES TO [^"Samurai", ^"Adversary"]

        # A character's natural aptitudes of body, mind, or character.
        # Each distinction has a unique narrative effect and the standardized
        # mechanical effect: reroll up to two dice when applicable.
        # Distinctions cancel adversities when both apply to the same check.

        PROPERTIES {
            ^"Ring" STRING REQUIRED          # Associated ring
            ^"Types" LIST OF STRING REQUIRED # e.g., ["Physical", "Mental"]
        }
    }

    #L5R267zA9bC1dE3fG5hI7j ^"Passion" DEF {
        EXTENDS #L5R263hI5jK7lM9nO1pQ3r ^"Advantage"
        APPLIES TO [^"Samurai", ^"Adversary"]

        # Interests unrelated to a character's purpose in life — the little
        # things that bring them solace. Each passion has a unique narrative
        # effect and the standardized mechanical effect: remove 3 strife
        # after performing an applicable check.
        # Passions cancel anxieties when both apply to the same check.
        # A character can have up to three passions.
        # A new passion can be developed by spending 3 XP (GM discretion).

        PROPERTIES {
            ^"Ring" STRING REQUIRED
            ^"Types" LIST OF STRING REQUIRED
        }
    }

    #L5R268kL0mN2oP4qR6sT8u ^"Adversity" DEF {
        EXTENDS #L5R264sT6uV8wX0yZ2aB4c ^"Disadvantage"
        APPLIES TO [^"Samurai", ^"Adversary"]

        # Factors that make performing the duties of a samurai more difficult.
        # Each adversity has a unique narrative effect and the standardized
        # mechanical effect: must reroll two dice containing success or
        # explosive success symbols. If the check fails, gain 1 Void point.
        # Adversities cancel distinctions when both apply to the same check.
        # A character can have any number of adversities.

        PROPERTIES {
            ^"Ring" STRING REQUIRED
            ^"Types" LIST OF STRING REQUIRED
        }
    }

    #L5R269vW1xY3zA5bC7dE9f ^"Anxiety" DEF {
        EXTENDS #L5R264sT6uV8wX0yZ2aB4c ^"Disadvantage"
        APPLIES TO [^"Samurai", ^"Adversary"]

        # Notable emotional vulnerabilities — fears, hatreds, or things the
        # character would prefer not to deal with. Each anxiety has a unique
        # narrative effect and the standardized mechanical effect: receive 3
        # strife after performing an applicable check. The first time per
        # scene this occurs, gain 1 Void point.
        # Anxieties cancel passions when both apply to the same check.
        # A character can have up to three anxieties.

        PROPERTIES {
            ^"Ring" STRING REQUIRED
            ^"Types" LIST OF STRING REQUIRED
        }
    }

    # ===========================
    # NINJO AND GIRI
    # ===========================

    ^"Ninjō" DEF {
        ALIAS "Ninjo"
        APPLIES TO [^"Samurai"]

        STRING

        # Personal desire — the character's deepest longing or
        # personal question. The tension between ninjō and giri
        # is the core dramatic engine of L5R.
        #
        # Acting against ninjō: Receive 3 strife
        # Pursuing ninjō: May remove all strife after downtime

        RULES {
            #L5R237rS9tU1vW3xY5zA7b: opposing_ninjo_causes_strife
            #L5R238cD0eF2gH4iJ6kL8m: pursuing_ninjo_removes_strife
            #L5R239nO1pQ3rS5tU7vW9x: ninjo_can_evolve
        }
    }

    ^"Giri" DEF {
        APPLIES TO [^"Samurai"]

        STRING

        # Sworn duty — the character's primary obligation to their
        # lord, clan, or the Empire. Typically a concrete, achievable
        # goal or ongoing responsibility.
        #
        # Success: Receive 10+ glory from lord
        # Failure/Abandonment: Forfeit 10+ glory, receive new giri

        RULES {
            #L5R240yZ2aB4cD6eF8gH0i: giri_success_glory_reward
            #L5R241jK3lM5nO7pQ9rS1t: giri_failure_glory_loss
            #L5R242uV4wX6yZ8aB0cD2e: giri_can_change
        }
    }

    ^"Complication" DEF {
        APPLIES TO [^"Samurai"]

        # Brief narrative moments arising from the tension between
        # ninjō and giri. Only one per character per session.
        # Character may stoically accept (no effect) or be moved
        # by it (3 strife + 1 Void point).

        RULES {
            #L5R243fG5hI7jK9lM1nO3p: one_per_character_per_session
            #L5R244qR6sT8uV0wX2yZ4a: accept_stoically_no_effect
            #L5R245bC7dE9fG1hI3jK5l: moved_by_it_strife_and_void
        }
    }

    # ===========================
    # BUSHIDO
    # ===========================

    ^"Bushido" DEF {
        APPLIES TO [^"Samurai"]

        # The Way of the Warrior — the code of conduct that governs
        # samurai life. Seven tenets, each associated with a clan
        # that most embodies it. Adherence affects honor.

        TENETS {
            ^"Righteousness (Gi)" "Justice and moral correctness. Championed by the Crab."
            ^"Courage (Yu)" "Bravery and willingness to act. Championed by the Crane."
            ^"Compassion (Jin)" "Empathy and mercy toward others. Championed by the Phoenix."
            ^"Respect (Rei)" "Courtesy and proper behavior. Championed by the Crane."
            ^"Honesty (Makoto)" "Sincerity and truthfulness. Championed by the Dragon."
            ^"Honor (Meyo)" "Personal integrity and reputation. Championed by the Lion."
            ^"Duty (Chugo)" "Loyalty and service to one's lord. Championed by the Scorpion (in their own way)."
        }

        RULES {
            #L5R246mN8oP0qR2sT4uV6w: bushido_affects_honor
            #L5R247xY9zA1bC3dE5fG7h: clan_bushido_emphasis
        }
    }
}
