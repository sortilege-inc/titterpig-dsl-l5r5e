# .codex SECTION — Courts of Stone: Castles in Rokugan. Stand-off graph over
# l5r5e-0.4-courts-of-stone-castles.lore (spec §25). Part of the L5R5e system
# graph; DEPENDS_ON the shared schema. The chapter's general castle-mechanics
# prose (roles, defenses, Winter Court) names no unique entities; the graph
# below captures the SAMPLE CASTLES and their people, spirits, and environs.
#
# "Deer Clan" is lore-only (no .ttrpg DEF; the family DEF is ^"Shika"); it is
# defined as a codex Faction entity in the Deer Clan section and referenced here.
# Kyūden Hida, Kyūden Doji, and Kakita Ryoku are amended (they are defined in the
# Emerald Empire / Crane Clan sections); Hida Defender / Kitsuki Investigator
# schools are DEFs and not reproduced.

CODEX "L5R5e_CoS_Castles_Codex" {
    NAME "Courts of Stone: Castles in Rokugan — Lore Graph"
    VERSION "0.1"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-09-02"
    FOR EDITION "l5r5e"
    DEPENDS_ON "L5R5e_Codex_Schema" VERSION "0.9"

    # -- Last Breath Castle (Shiro Matsu) ---------------------------------------

    ENTITY #L5RcxCoScas01lbcastle ^"Last Breath Castle" {
        IS ^"Castle"
        SOURCE "l5r5e-0.4-courts-of-stone-castles.lore" AT "last-breath-castle"
        RELATIONSHIPS {
            ^"held-by"      -> ^"Lion Clan"   FROM "the orange-and-gold banners of Shiro Matsu, Last Breath Castle"
            ^"located-near" -> ^"Beiden Pass" FROM "From its position, it dominates Beiden Pass"
        }
    }
    ENTITY #L5RcxCoScas02matsutsk ^"Matsu Tsuko" {
        IS ^"Person"
        SOURCE "l5r5e-0.4-courts-of-stone-castles.lore" AT "last-breath-castle"
        RELATIONSHIPS {
            ^"member-of" -> ^"Lion Clan" FROM "the Matsu family daimyō, Matsu Tsuko, the Lady of Lions"
            ^"leads"     -> ^"Matsu"     FROM "the Matsu family daimyō, Matsu Tsuko"
        }
    }
    ENTITY #L5RcxCoScas03hallance ^"Hall of Ancestors" {
        IS ^"Temple"
        SOURCE "l5r5e-0.4-courts-of-stone-castles.lore" AT "last-breath-castle"
        RELATIONSHIPS {
            ^"held-by" -> ^"Lion Clan" FROM "a sacred temple to the fallen warriors of every Lion family"
        }
    }
    ENTITY #L5RcxCoScas04valstorm ^"Valley of Storms" {
        IS ^"Region"
        SOURCE "l5r5e-0.4-courts-of-stone-castles.lore" AT "last-breath-castle"
    }
    ENTITY #L5RcxCoScas05lionteet ^"Lion's Teeth" {
        IS ^"Road"
        SOURCE "l5r5e-0.4-courts-of-stone-castles.lore" AT "strengths-and-weaknesses"
    }
    ENTITY #L5RcxCoScas06beidenov ^"Beiden Overlook" {
        IS ^"Landmark"
        SOURCE "l5r5e-0.4-courts-of-stone-castles.lore" AT "beiden-overlook"
        RELATIONSHIPS {
            ^"located-near" -> ^"Beiden Pass" FROM "The lookout post on the southeastern end of Beiden Pass"
        }
    }
    ENTITY #L5RcxCoScas07beidentw ^"Beiden" {
        IS ^"Town"
        SOURCE "l5r5e-0.4-courts-of-stone-castles.lore" AT "castle-culture"
        RELATIONSHIPS {
            ^"located-near" -> ^"Beiden Pass" FROM "Beiden is located on the southern side of the pass of the same name"
        }
    }
    ENTITY #L5RcxCoScas08shmatsut ^"Shiro Matsu Toshi" {
        IS ^"City"
        SOURCE "l5r5e-0.4-courts-of-stone-castles.lore" AT "shiro-matsu-toshi"
        RELATIONSHIPS {
            ^"held-by"    -> ^"Lion Clan"     FROM "the city, known simply as Shiro Matsu Toshi, is among the largest in the Empire"
            ^"located-in" -> ^"Yama Province" FROM "who serve the Lion Clan not only at Last Breath Castle but throughout Yama Province"
        }
    }
    ENTITY #L5RcxCoScas09shmakoto ^"Shrine of Makoto" {
        IS ^"Temple"
        SOURCE "l5r5e-0.4-courts-of-stone-castles.lore" AT "shiro-matsu-toshi"
    }
    ENTITY #L5RcxCoScas10ikomakan ^"Ikoma Kanoko" {
        IS ^"Person"
        SOURCE "l5r5e-0.4-courts-of-stone-castles.lore" AT "shiro-matsu-toshi"
        RELATIONSHIPS {
            ^"member-of" -> ^"Lion Clan" FROM "One of the most renowned bards of the present day, Ikoma Kanoko"
        }
    }
    ENTITY #L5RcxCoScas11ryuheizz ^"Ryūhei" {
        IS ^"Person"
        SOURCE "l5r5e-0.4-courts-of-stone-castles.lore" AT "ryūhei-monk"
        RELATIONSHIPS {
            ^"member-of" -> ^"Lion Clan" FROM "having retired from his life as a samurai of the Akodo family"
        }
    }
    ENTITY #L5RcxCoScas12akohisay ^"Akodo Hisayo" {
        IS ^"Person"
        SOURCE "l5r5e-0.4-courts-of-stone-castles.lore" AT "ryūhei-monk"
        RELATIONSHIPS {
            ^"member-of" -> ^"Lion Clan" FROM "murdered his friend and superior officer, Akodo Hisayo"
        }
    }

    # -- Hida Palace (Kyūden Hida — amended) ------------------------------------

