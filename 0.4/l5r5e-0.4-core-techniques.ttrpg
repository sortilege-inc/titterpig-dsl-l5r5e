    # ===========================
    # RITUALS (ritual) — CEREMONIAL TECHNIQUES
    # ===========================

    ^"Ritual" DEF {
        APPLIES TO [^"Samurai", ^"Adversary"]

        # Rituals are religious ceremonies performed to appease the kami
        # and draw forth their blessings. Unlike invocations, rituals are
        # not the rarefied secrets of shugenja schools; instead, they are
        # day-to-day practices performed by many religious functionaries
        # throughout Rokugan. Most priests, shrine keepers, and court
        # mystics know and perform rituals regularly. Many monks and
        # shugenja also know how to perform rituals.
        #
        # Symbol: (ritual)
        # Available to: Schools listing "rituals" among available techniques
        # Activation: During downtime (and potentially other scenes at GM's discretion)

        # ----- Rituals (alphabetical) -----

        #0ThQxz2j6q0FzktJJUhQXK ^"Cleansing Rite" DEF {
            RANK 1
            ACTIVATION "As a downtime activity, make a TN 3 Theology (Void) check targeting up to five characters to remove spiritual contaminants from the targets before they spread. Note: this cannot remove a ^\"Shadowlands Taint\" disadvantage once it has taken hold, but it can prevent this spiritual contamination from taking root after a character is exposed."
            EFFECTS "If you succeed, remove the ^\"Afflicted\" condition from the target."
            OPPORTUNITIES {
                "Void (op)(op): If one or more targets is an ^\"Otherworldly\" being, you become aware of it after completing the ritual — but you do not know which target."
                "Void (op)+: Choose one additional target per (op) spent this way."
                "Void (op)+: Instead of targeting characters, you may target an area encompassing a number of range bands around you equal to (op) spent this way. Remove the ^\"Defiled\" terrain quality from this area. If it is a deeply unhallowed place that has long been the domain of evil, the ^\"Defiled\" quality returns after one day, plus additional days equal to your bonus successes."
            }
        }

        #i2GEqhySgpp0wZ2MGeJZXo ^"Commune with the Spirits" DEF {
            RANK 1
            ACTIVATION "As a downtime activity or Support action, make a TN 1 Theology check using Air, Earth, Fire, Water, or Void to appeal to nearby spirits of that Element (appeal to the departed, such as ancestor spirits, and other non-elemental supernatural presences if using Void) for aid."
            EFFECTS "If you succeed, choose and receive one of the following boons: (1) Sense the Kami — Detect all spirits and uses of their magic by shugenja within a number of range bands equal to the ring you used plus your bonus successes. (2) Spiritual Knowledge — Learn one fact the spirits know about the area. (3) Elemental Gift — The kami deliver a small amount of the Element in question to you (e.g., rain from water kami, sparks from fire kami, a gust from air kami, a stone from earth kami, or a found ancestor's belonging from Void)."
            OPPORTUNITIES {
                "(op): Reduce the TN of your next check to interact with or appeal to kami or supernatural presences of this Element by 1."
                "(op)+: If you succeed, receive one additional boon per (op) spent this way. Each boon can only be received one time per activation."
            }
        }

        #bNxt2ZFUbgSKhc6XxSTMUh ^"Divination" DEF {
            RANK 1
            ACTIVATION "As a downtime activity, make a TN 2 Theology (Void) check targeting one character to see glimpses of their future."
            EFFECTS "If you succeed, choose one of the following omens in the target's near future: (1) Omen of the Azure Dragon — The next time the target performs a check using an Artisan skill this game session, the target adds a kept (ring) set to an (su)(st) result. (2) Omen of the Black Tortoise — Same for a Scholar skill check. (3) Omen of the White Tiger — Same for a Martial skill check. (4) Omen of the Vermilion Bird — Same for a Social skill check. (5) Omen of the Weaver and the Cowherd — Same for a Trade skill check. If you fail, the GM chooses one of the above omens instead. The target cannot receive another divination until the next game session."
            OPPORTUNITIES {
                "(op): If you fail, an additional omen appears to you after the first. Choose one of the above omens in addition to the one the GM chose."
            }
        }

        #xPU8WmbyxLxC5CxRZEdt3b ^"Tea Ceremony" DEF {
            RANK 2
            ACTIVATION "Once per game session, as a downtime activity using a tea set, make a TN 2 Performance (Void) check targeting yourself and a number of other characters up to your ranks in Culture, who are also participants. Up to one other participant may assist (see ^\"Assistance\")."
            EFFECTS "Each target removes 3 strife, plus additional strife equal to your bonus successes."
            OPPORTUNITIES {
                "(op): Reduce the TN of each target's next check by 1."
                "(op)+: Each target removes 1 fatigue, plus 1 fatigue per (op) spent this way."
                "(op)(op): If you succeed, each target gains 1 Void point."
            }
        }

        #AzCGIVbmmmxR18NvYcsqsZ ^"Threshold Barrier" DEF {
            RANK 1
            ACTIVATION "As a downtime activity, make a TN 2 Theology check using Air, Earth, Fire, Water, or Void targeting a threshold, gate, or other entryway at range 0-1."
            EFFECTS "If you succeed, the threshold is barred against a particular entity type based on the ring chosen for one hour, plus additional hours equal to your bonus successes. When an entity of that type attempts to enter, it must resist with a TN 3 Meditation (Void) check or be repelled. Whether it succeeds or fails, you immediately become aware of its attempted entry. Entity types by ring: Air — Ethereal ^\"Otherworldly\" beings such as spirits and ghosts. Earth — Living ^\"Tainted\" beings. Fire — Undead beings with corporeal form. Water — Wild animals. Void — Humans."
            OPPORTUNITIES {
                "(op): Instead of protecting a threshold, you may protect the entirety of a sealed area extending a number of range bands around you no greater than your bonus successes."
                "(op): If any beings of the type you are sealing the threshold against have passed through the threshold within the last twenty-four hours, you become aware of their passage."
            }
        }

        RULES {
            #L5R314yZ6aB8cD0eF2gH4i: rituals_performed_during_downtime_or_other_scenes_at_gm_discretion
            #L5R315jK7lM9nO1pQ3rS5t: rituals_available_to_schools_listing_rituals
            #L5R316uV8wX0yZ2aB4cD6e: rituals_cannot_remove_taint_once_taken_hold
        }
    }

    # ===========================
    # SHŪJI (shūji) — SOCIAL TECHNIQUES
    # ===========================

    ^"Shūji" DEF {
        ALIAS "Shuji"
        APPLIES TO [^"Samurai", ^"Adversary"]

        # Shūji are social techniques, leveraging that most powerful of
        # human tools: communication. Shūji can be used in intrigues,
        # duels, skirmishes, and other types of conflicts as common sense
        # and the GM's discretion dictate.
        #
        # Symbol: (shūji)
        # Available to: Schools listing "shūji" among available techniques
        # Elemental classifications: Air, Earth, Fire, Water, Void

        # ----- Air Shūji -----
        # Air shūji are indirect, probing, and sometimes teasing. This
        # style of conversation revolves around setting up subtle traps
        # for others to fall into, then exploiting them. Air shūji hinge
        # on details rather than the bigger picture, controlling the scope
        # of conversation to deflect contrary evidence or logical argumentation.

        #VWaekx4sOx9p31xOOeVWoA ^"Artisan's Appraisal" DEF {
            RANK 2
            ACTIVATION "When assessing an object or performance with an Artisan skill (Air), Performance (Air), or Games (Air) check, you may spend (op) in the following ways:"
            OPPORTUNITIES {
                "Air (op): Choose a ring; learn the value of that ring for the creator or performer and all advantages and disadvantages attached to that ring that are not of the curse type."
                "Air (op): If the creator or performer is an NPC, learn their demeanor."
            }
        }

        #q8uBm6dX5qGw3c14Zes3o0 ^"Bend with the Storm" DEF {
            RANK 5
            ACTIVATION "When you make a Social skill (Air) check targeting another character, you may spend (op) in the following way:"
            OPPORTUNITIES {
                "Air (op): Choose an advantage or disadvantage. The target comes to believe that you possess that advantage or disadvantage without your having to expend noticeable effort or state it directly. Further, the target believes that you do not know you have given this advantage or disadvantage away. If you do anything that could call this misconception into question, any character may resist with a TN 5 Sentiment check (Earth 6, Fire 3) to discern that the advantage or disadvantage is not real. This effect persists until the target is faced with incontrovertible evidence or succeeds on the check to resist."
            }
        }

        #CKeJWFjQNsec0w910GbkxC ^"Cadence" DEF {
            RANK 1
            ACTIVATION "When you make a Social skill (Air) check, you may spend (op) in the following ways:"
            OPPORTUNITIES {
                "Air (op): Convey a secret message that alters the meaning of what you are saying outwardly (or has nothing to do with it at all) to one character observing you who possesses this technique."
                "Air (op)(op): Convey a secret message that alters the meaning of what you are saying outwardly (or has nothing to do with it at all) to one character observing you who does not possess this technique."
            }
        }

        #HvkOd6sfKqveTIaT1XqFUK ^"Feigned Opening" DEF {
            RANK 2
            ACTIVATION "As a Movement and Scheme action, make a Performance (Air) check targeting one character in the scene who is observing you. The TN is equal to the target's vigilance. This technique can only be used during skirmish and mass battle conflicts."
            EFFECTS "If you succeed, reduce the TN of the next Attack checks against each target (or their cohort, in a mass battle) by 1 plus your bonus successes. This effect persists until the end of your next turn."
            OPPORTUNITIES {
                "Air (op)+: Choose one additional target with vigilance lower than or equal to the original target's per (op) spent this way."
                "Air (op)+: In a mass battle, increase the TN of Attack checks targeting your cohort by 1, plus 1 per additional (op) spent this way."
            }
        }

        #8oUal3jbDPcxKD67zs8nqC ^"Prey on the Weak" DEF {
            RANK 2
            ACTIVATION "As a Scheme action, make a TN 1 Courtesy (Air) check targeting a ^\"Compromised\" character."
            EFFECTS "If you succeed, your target must choose one of the following: (1) Immediately unmask in a manner of their choosing based on the circumstances. (2) Forfeit glory equal to your Air Ring plus your bonus successes to leave the scene."
            OPPORTUNITIES {
                "Air (op)+: If the target chooses to unmask, you learn one of their disadvantages of their choice per (op) spent this way."
                "Air (op)(op): If the target chooses to leave the scene, you notice their destination from the direction of their departure or overhear from the crowd where they will retreat."
            }
        }

        #byWI1ENLrPr1vx3ReJY6qJ ^"Rustling of Leaves" DEF {
            RANK 1
            ACTIVATION "When you make a Social skill (Air) check to spread a rumor, you may spend (op) in the following way:"
            OPPORTUNITIES {
                "Air (op)+: Increase the TN of any check to trace the rumor back to you by 2 per (op) spent this way."
            }
        }

        #9joMTiwaMNeSp95EKmWY6s ^"The Wind Blows Both Ways" DEF {
            RANK 3
            ACTIVATION "When you make a Courtesy or Performance (Air) check targeting another character, you may spend (op) in the following ways:"
            OPPORTUNITIES {
                "Air (op)+: The next time the target receives a glory award, increase the glory they gain by 1 per (op) spent this way. This effect persists until the end of the scene."
                "Air (op)+: The next time the target forfeits or stakes glory, increase the glory they must forfeit or stake by 1 per (op) spent this way. This effect persists until the end of the scene."
            }
        }

        #8QZaeUPiDjZFahmngR05R5 ^"Whispers of Court" DEF {
            RANK 1
            ACTIVATION "As a Scheme action, make a Courtesy (Air) check targeting each character in the scene. The TN of this check is equal to the lowest vigilance among your targets."
            EFFECTS "If you succeed, you create a rumor that sweeps across the room like a storm. Everyone in the scene hears it, and characters with vigilance lower than your bonus successes even come to give it some credence. If spreading a rumor is your social objective in an intrigue, you score rhetorical points equal to your Air Ring plus your bonus successes."
            OPPORTUNITIES {
                "Air (op): Learn one other rumor that is spreading in the current scene."
            }
        }

        #WNWIn3206q8LJV0QMByNHX ^"Wolf's Proposal" DEF {
            RANK 4
            ACTIVATION "As a Scheme action, make a Courtesy or Performance (Air) check targeting any number of characters in the scene. The TN of this check is equal to the highest vigilance among your targets."
            EFFECTS "If you succeed, each target behaves as though your honor is 10 higher or lower than its actual value, plus or minus an additional 10 for each bonus success (to a maximum honor value of 100 or a minimum honor value of 0). If you do anything that could call your perceived honor into question, any target may resist with a TN 4 Sentiment check (Earth 5, Fire 2) to determine your actual honor attribute. This effect persists until the end of the scene."
            OPPORTUNITIES {
                "Air (op): Choose a character in the scene. Learn if their honor is higher or lower than yours (the actual value)."
            }
        }

        # ----- Earth Shūji -----
        # Earth shūji focus on building others up through a combination of
        # support, expectation, and pressure when needed. A character using
        # this rhetoric speaks at a measured pace, weighing words carefully
        # and developing an argument from the foundation up.

        #OeYj4seb4GneHX6VlWs6m3 ^"Ancestry Unearthed" DEF {
            RANK 1
            ACTIVATION "When you make a Scholar skill (Earth) or Social skill (Earth) check targeting a character, you may spend (op) as follows:"
            OPPORTUNITIES {
                "Earth (op): You know one sworn oath the character's family took in the past, and whether or not they have broken or bent it."
                "Earth (op)(op): You know one secret of the character's family that they would prefer be forgotten, and have perhaps even worked to bury."
                "Earth (op)(op)(op): You know something the character does not even know about their own ancestry."
            }
        }

        #YRrwJlgAyPpVIMmg9hKPC4 ^"Civility Foremost" DEF {
            RANK 2
            ACTIVATION "As a Scheme action, make a Command or Courtesy (Earth) check targeting one character to claim protection for an individual of your choice by rights of honor. The TN of the check is equal to the target's vigilance."
            EFFECTS "If you succeed, the target must forfeit honor equal to your Earth Ring plus your bonus successes and suffer that much strife to perform an Attack or Scheme action targeting the chosen individual. This effect persists until the end of the scene, or until the target performs an Attack or Scheme action."
            OPPORTUNITIES {
                "Earth (op)+: Choose one additional target with vigilance lower than or equal to your first target's vigilance per (op) spent this way."
            }
        }

        #mfl9jlCknrtobgA4Rc4Rmp ^"Honest Assessment" DEF {
            RANK 1
            ACTIVATION "As a Support action, make a TN 2 Courtesy (Earth) check to appraise the weaknesses of a character."
            EFFECTS "If you succeed, choose one of the target's known disadvantages. The target does not apply that disadvantage to their checks until the end of the scene."
            OPPORTUNITIES {
                "Earth (op)+: Choose one additional disadvantage per (op) spent this way."
                "Earth (op)(op): Reduce the TN of the target's next skill check using the ring the disadvantage is attached to by 2."
            }
        }

        #RTLqrkTuF0J8RJWpY3gkKA ^"Pillar of Calm" DEF {
            RANK 4
            ACTIVATION "As a Scheme and Support action, make a Command (Earth) check targeting a number of characters up to your Earth Ring times your school rank. The TN of this check is equal to the highest strife among the targets."
            EFFECTS "If you succeed while targeting all of the leaders involved in a conflict, you may de-escalate the conflict one level (from a mass battle to a skirmish, a skirmish to a duel, or a duel to an intrigue)."
            OPPORTUNITIES {
                "Earth (op)(op)+: You may de-escalate the conflict by one additional level per (op)(op) spent this way."
            }
        }

        #n1bPScWFDIHIP8vDn1nCBD ^"Stonewall Tactics" DEF {
            RANK 1
            ACTIVATION "When making a Social skill (Earth) or Martial skill (Earth) check targeting a character, you may spend (op) in the following way:"
            OPPORTUNITIES {
                "Earth (op)+: Increase the TN of any check the target makes that does not target you by 1 per (op) spent this way. This effect persists until the beginning of your next turn."
            }
        }

        #lT1wuCRy1xXQY9icJVke8t ^"Touchstone of Courage" DEF {
            RANK 3
            ACTIVATION "As a Support action, make a TN 4 Command (Earth) check targeting any number of characters (or your cohort during a mass battle)."
            EFFECTS "If you succeed during an intrigue, duel, or skirmish conflict, each target increases their composure by your Earth Ring. This effect persists until the end of the scene. If you succeed during a mass battle, increase your army's discipline by your Earth Ring plus your bonus successes. This effect persists until the end of the scene."
            OPPORTUNITIES {
                "Earth (op)(op): During an intrigue, duel, or skirmish, each target removes strife equal to your Earth Ring."
                "Earth (op)(op): During a mass battle, your army removes panic equal to your Earth Ring."
            }
        }

        #W0QB6DGhPm1R9Jv0KczLUo ^"The Immovable Hand of Peace" DEF {
            RANK 5
            ACTIVATION "Once per game session as a Scheme action, during a duel or skirmish, make a TN 5 Command (Earth) check targeting every character in the scene."
            EFFECTS "If you succeed, the scene becomes an intrigue between you and the other principal characters. This effect persists for one round, plus additional rounds equal to your bonus successes. If you have not achieved a peaceful resolution by the time this effect ends, the scene returns to its previous state."
            OPPORTUNITIES {
                "Earth (op): You may also perform this action during a mass battle or other form of conflict (other than an intrigue)."
            }
        }

        #UN5KQZjDq79Is7cPIQCoJo ^"Weight of Duty" DEF {
            RANK 1
            ACTIVATION "When you make a Social skill (Earth) check targeting a character, you may spend (op) as follows:"
            OPPORTUNITIES {
                "Earth (op): Learn one way the target fears failing as a samurai."
                "Earth (op)(op): Learn the target's ^\"Giri\"."
            }
        }

        # ----- Fire Shūji -----
        # Fire shūji focus on provocation in the most direct sense, eliciting
        # a reaction immediately and with fervor. Anger, joy, despair, and the
        # burning desire for justice are all tools of one who wields Fire shūji.
        # A speaker can illuminate injustice or set hearts ablaze with pride,
        # but it can also blind people to the wider situation or consequences.

        #2VbFS6xaG13cbbOk5miwjo ^"Bravado" DEF {
            RANK 4
            ACTIVATION "As a Scheme action, make a Games (Fire) or Performance (Fire) check targeting any number of characters in the scene. The TN of this check is equal to the highest vigilance among your targets."
            EFFECTS "If you succeed, each target behaves as though your glory is 10 higher or lower than its actual value, plus or minus an additional 10 for each bonus success (to a maximum glory value of 100 or a minimum glory value of 0). If you do anything that could call your glory into question, any character may resist with a TN 4 Sentiment check (Air 5, Water 2) to determine your actual glory attribute. This effect persists until the end of the scene."
            OPPORTUNITIES {
                "Fire (op): Choose a character in the scene. Learn if their glory is higher or lower than yours (the actual value)."
            }
        }

        #EgewuV5s96on3zjNrTvJpe ^"Dazzling Performance" DEF {
            RANK 3
            ACTIVATION "When making an Artisan skill (Fire), Games (Fire), or Performance (Fire) check, you may spend (op) in the following way:"
            OPPORTUNITIES {
                "Fire (op)+: The next time you receive a glory award this scene, increase the amount you receive by 1. If there is a character of higher status in the scene, increase it by 1 per (op) spent this way instead."
            }
        }

        #nxx4PUuUEDXcRbh17Z0blU ^"Fanning the Flames" DEF {
            RANK 2
            ACTIVATION "When making a Social skill (Fire) check targeting one or more characters, you may spend (op) in the following way:"
            OPPORTUNITIES {
                "Fire (op)+: One target gains the ^\"Dazed\" condition per (op) spent this way."
                "Fire (op)(op)+: One target gains the ^\"Enraged\" condition per (op)(op) spent this way."
            }
        }

        #IGquxVDtJcTEXwn2nTUvqG ^"Lightning Raid" DEF {
            RANK 2
            ACTIVATION "Once per scene, as an Attack and Movement action, make a TN 3 Command (Fire) check targeting any number of characters in the scene (or one cohort in a mass battle)."
            EFFECTS "If you succeed during a skirmish, each character increases their initiative by your Fire Ring plus your bonus successes at the beginning of the next round. If you succeed during a mass battle, one enemy leader's cohort suffers panic equal to your Fire Ring plus your bonus successes."
            OPPORTUNITIES {
                "Fire (op): During a skirmish, immediately perform a ^\"Strike\" action."
                "Fire (op): During a mass battle, immediately perform an ^\"Assault\" action against the chosen enemy cohort's leader."
            }
        }

        #rUz6ukITtPc8k3vRHmpoNP ^"Rallying Cry" DEF {
            RANK 3
            ACTIVATION "As a Support action, make a TN 2 Command (Fire) or Performance (Fire) check targeting any number of characters in the scene (or one cohort in a mass battle)."
            EFFECTS "If you succeed, the targets are energized and excited by your rhetoric. After Step 5: Choose Kept Dice, each target adds a kept (ring) set to an (su)(st) result. This effect persists until the end of your next turn."
            OPPORTUNITIES {
                "Fire (op)+: In a skirmish, each enemy in the scene suffers 1 strife per (op) spent this way."
                "Fire (op)+: In a mass battle, the enemy army suffers 1 panic per (op) spent this way."
            }
        }

        #ZJIQtg1P6USMPRIzJcn5Al ^"Sear the Wound" DEF {
            RANK 5
            ACTIVATION "When making a Social skill (Fire) check targeting one or more characters, you may spend (op) in the following way:"
            OPPORTUNITIES {
                "Fire (op)+: Choose a known disadvantage of one of your targets per (op) spent this way. That disadvantage applies to all of the target's checks until the end of the scene."
            }
        }

        #Mm0nf52NuXTKisPrdeDQ8m ^"Sensational Distraction" DEF {
            RANK 1
            ACTIVATION "When making a Social skill (Fire) check targeting one or more characters, you may spend (op) in the following way:"
            OPPORTUNITIES {
                "Fire (op)+: When interacting with other characters, the target treats their vigilance as 1 lower per (op) spent this way; when interacting with you, the target treats their vigilance as 1 higher per (op) spent this way. This effect persists until the end of the scene."
            }
        }

        #LNoCHrAXMq2QTNhoUg9lAk ^"Stirring the Embers" DEF {
            RANK 1
            ACTIVATION "When making a Social skill (Fire) check targeting one or more characters, you may spend (op) in the following way:"
            OPPORTUNITIES {
                "Fire (op)+: Choose a target and one of their known distinctions per (op) spent this way. Until the end of the scene, when that advantage applies to a check, the target may reroll up to three dice (instead of two)."
            }
        }

        #CUVTW0xoeEbzJYrll6mbV7 ^"Truth Burns through Lies" DEF {
            RANK 1
            ACTIVATION "When making a Scholar skill (Fire) check to assess a character's story, you may spend (op) in the following way:"
            OPPORTUNITIES {
                "Fire (op): If there is a single statement upon which the character's story hinges, you determine what it is and what you would need to do to verify or disprove it."
            }
        }

        # ----- Water Shūji -----
        # Water shūji play to the heart rather than the mind, calling upon the
        # listener to let their emotions guide them and be swept along without
        # question. Camaraderie, shame, guilt, material needs, and base desires
        # are all the domain of Water shūji. A skilled courtier can draw even
        # the harshest enemies to the negotiating table by making it the path
        # of least resistance.

        #NQn7sBvlEBYJctesfGDqZH ^"All in Jest" DEF {
            RANK 1
            ACTIVATION "When you make a Commerce (Water), Courtesy (Water), or Performance (Water) check, you may spend (op) in the following way:"
            OPPORTUNITIES {
                "Water (op)+: If you forfeited honor as part of the check in order to say something rude or appeal to your target's base desires (greed, lust, laziness, etc.), regain 1 honor per (op) spent this way (see ^\"Forfeiting Social Attributes\")."
            }
        }

        #OokjiwHlZEupNcxuHLKuIR ^"Buoyant Arrival" DEF {
            RANK 5
            ACTIVATION "As a Scheme action, make a Courtesy (Water) check targeting a number of characters up to your Water Ring. The TN of the check is equal to the vigilance of the character with the highest status among your targets."
            EFFECTS "If you succeed, you may enter or leave the conversation gracefully. You need not forfeit honor or glory for interrupting, suddenly departing, or preempting someone else, regardless of the respective status of the participants."
        }

        #5yqq8PHChTMAT9MtGipsIF ^"Ebb and Flow" DEF {
            RANK 3
            ACTIVATION "As a Scheme or Support action, make a Courtesy (Water), Command (Water), or Games (Water) check targeting one character. The TN of this check is equal to the target's vigilance."
            EFFECTS "If you succeed (and chose Scheme action), choose one of the target's advantages that you know; whenever it applies, invert it. This effect persists until the end of the scene. If you succeed (and chose Support action), choose one of the target's disadvantages you know; whenever it applies, invert it. This effect persists until the end of the scene."
            OPPORTUNITIES {
                "Water (op): Choose one additional advantage or disadvantage and apply the effect to it."
                "Water (op)(op)+: Choose one additional target with vigilance lower than or equal to your first target's vigilance per (op)(op) spent this way."
            }
        }

        #hi3iUtKJkFWkYG9ijGT7wi ^"Regal Bearing" DEF {
            RANK 4
            ACTIVATION "As a Scheme action, make a Command (Water) or Performance (Water) check targeting any number of characters in the scene. The TN of this check is equal to the highest vigilance among your targets."
            EFFECTS "If you succeed, each target treats your status as being 10 higher or lower (to a maximum status of 100 or a minimum status of 0), plus or minus an additional 10 per bonus success. If you do anything that could call your status into question, any character may resist with a TN 4 Sentiment check (Earth 2, Fire 5) to determine your actual status attribute. This effect persists until the end of the scene."
            OPPORTUNITIES {
                "Water (op): Choose a character in the scene. Learn if their status is higher or lower than yours (the actual value)."
            }
        }

        #8Yh77FWi4wCMphnZVYwU30 ^"Shallow Waters" DEF {
            RANK 1
            ACTIVATION "When you make a Social skill (Water) check targeting a character, you may spend (op) as follows:"
            OPPORTUNITIES {
                "Water (op): Learn of one material item or worldly experience the target desires."
                "Water (op)(op): Learn the target's ^\"Ninjō\"."
            }
        }

        #V2GiQ9rSTBn8gNE2cQ2vxo ^"Slippery Maneuvers" DEF {
            RANK 2
            ACTIVATION "As a Movement and Support action, make a TN 2 Command (Water) check targeting any number of friendly characters in the scene (or your cohort during a mass battle). This technique can only be used during a skirmish or mass battle."
            EFFECTS "If you succeed during a skirmish, choose a position containing terrain that you can see. Each target may immediately move 1 range band toward it. Attack checks targeting any of your targets inside the terrain treat the terrain as having the ^\"Obscuring\" terrain quality. This effect persists until the end of the scene. If you succeed during a mass battle, choose a piece of terrain you can see. You and your cohort may immediately move to occupy it if it is unoccupied. Attack action checks targeting you and your cohort while you are inside the terrain treat the terrain as having the ^\"Obscuring\" terrain quality. This effect persists until the end of the scene."
            OPPORTUNITIES {
                "Water (op): Each target is able to leverage ^\"Obscuring\" terrain to better effect; Attack action checks targeting them have their TN increased by 2 instead of 1. This effect persists until the end of the scene."
            }
        }

        #xGEyMoFPgvxb1IpMhk3c0p ^"Tributaries of Trade" DEF {
            RANK 2
            ACTIVATION "Once per scene as a Scheme and Support action, make a TN 1 Commerce (Water) skill check to establish that you acquired a chosen item earlier. From a narrative standpoint, you procured this gift during your last opportunity (or sent an attendant to retrieve it) but are only revealing it now."
            EFFECTS "If you succeed, you produce an item with a rarity less than or equal to 1 plus your bonus successes. You must still pay the price of the item."
            OPPORTUNITIES {
                "Water (op)+: Reduce the price you must pay for the item by one-quarter per (op) spent this way (to a minimum of one-quarter of the original price)."
            }
        }

        #svvmtBGYb5XXrrqx9aY0hD ^"Well of Desire" DEF {
            RANK 1
            ACTIVATION "When you make a Courtesy (Water) check to present a gift to a target, you may spend (op) as follows:"
            OPPORTUNITIES {
                "Water (op): To refuse your gift, your target must forfeit glory equal to your Water Ring. Additionally, if the gift is something that the target desires, the target also must suffer strife equal to its rarity to refuse it. If your target accepts the gift, reduce the TN of your next Social skill check targeting them by the rarity of the item (to a minimum of 1)."
            }
        }

        # ----- Void Shūji -----
        # Void shūji revolve around understanding and expressing the inner
        # mysteries of the universe to help oneself and others move toward
        # Enlightenment, selfless goals, or otherworldly ends. Some Void
        # shūji are limited to a specific clan (listed with RESTRICTION).

        #kVXN7d6hHmaHfUcKdInRxO ^"All Arts Are One" DEF {
            RANK 3
            ACTIVATION "As a Support action, make a TN 4 Martial skill (Void), Games (Void), or Performance (Void) check to rapidly absorb information on a new activity covered by that skill."
            EFFECTS "If you succeed, you immediately intuit how to wield a new weapon, play a new game, use a new instrument, or perform a new song, dance, or other task. You do not apply any TN increase that might be associated with dealing with something new to you."
            OPPORTUNITIES {
                "Void (op): Choose a ring. Reduce the TN of your next check using that ring for the chosen skill by 1. This effect persists until the end of your next turn (or until the end of the scene during a narrative scene)."
            }
        }

        #ozZWaYuZNqChFF0cboMnTQ ^"A Samurai's Fate" DEF {
            RANK 4
            ACTIVATION "As an action, make a TN 5 Command (Void) check targeting any number of characters (or your cohort, during a mass battle)."
            EFFECTS "If you succeed during a skirmish, each target ignores any critical strikes with severity lower than your Void Ring plus your bonus successes. This effect persists until the end of the scene (at which point the injuries take effect). If you succeed during a mass battle, your army counts as having the Fearless Army ability: at the end of each round, your army removes panic equal to your glory rank. This effect persists until the end of the scene."
        }

        #kcz9tYqb7ZkxEjkD96CUXF ^"Courtier's Resolve" DEF {
            RANK 1
            ACTIVATION "Once per scene as a Support action, you may spend 1 Void point to recover from strife."
            EFFECTS "Remove strife equal to your glory rank."
        }

        #kq4jfxIvUd5ASOCHRHNBEf ^"Lady Doji's Decree" DEF {
            RANK 2
            RESTRICTION "Crane Clan only"
            ACTIVATION "Once per game session as an action, make a Courtesy (Void) check targeting a number of characters up to your school rank. The TN of this check is equal to the vigilance of the character with the highest status among your targets."
            EFFECTS "If you succeed, your targets cannot perform Attack actions targeting you. This effect persists for one round, plus additional rounds equal to your bonus successes, or until you perform an Attack action."
            OPPORTUNITIES {
                "Void (op)+: Choose one additional target with status lower than your first target per (op) spent this way."
                "Void (op)(op): Your targets also cannot perform Scheme actions targeting you."
            }
        }

        #ula0DlV5RD8JehvWU8oZZe ^"Lady Shinjo's Speed" DEF {
            RANK 2
            RESTRICTION "Unicorn Clan only"
            ACTIVATION "As a downtime activity, if you have a steed available, make a TN 2 Survival (Void) check to reach a destination with extreme swiftness."
            EFFECTS "If you succeed, you reach the destination in half the time it would normally require. If you so desire, one character may ride along with you."
            OPPORTUNITIES {
                "Void (op): You may lead a number of willing characters with mounts of their own up to your school rank."
            }
        }

        #35TfdsuJBkqnd1UpLLEGHa ^"Lord Akodo's Roar" DEF {
            RANK 2
            RESTRICTION "Lion Clan only"
            ACTIVATION "Once per game session as an action, make a TN 1 Command (Void) check targeting each hostile character within a number of range bands equal to your school rank."
            EFFECTS "If you succeed, each target suffers the ^\"Dazed\" condition."
            OPPORTUNITIES {
                "Void (op)(op)+: After you perform this action, one other friendly character per (op)(op) spent this way at range 0-3 may immediately perform a ^\"Strike\" action targeting a ^\"Dazed\" character."
            }
        }

        #ahpgcTigitmTmFf8vWGMX1 ^"Lord Bayushi's Whispers" DEF {
            RANK 2
            RESTRICTION "Scorpion Clan only"
            ACTIVATION "Once per game session, during a narrative scene or as a downtime activity, make a TN 2 Skulduggery (Void) check to uncover an informant who can give you information about a subject."
            EFFECTS "If you succeed, you reveal one informant who can give you information about a topic of your choice. If the informant's profile is required, use an appropriate NPC of the GM's choice."
            OPPORTUNITIES {
                "Void (op): If you succeed, choose one skill. The informant has a number of ranks in that skill equal to your school rank and can perform checks with that skill to assist you until the end of the scene."
            }
        }

        #HPyhRH2w9P002W4dTymcYl ^"Lord Togashi's Insight" DEF {
            RANK 2
            RESTRICTION "Dragon Clan only"
            ACTIVATION "Once per game session as an action, make a TN 2 Meditation (Void) check to seek cosmic wisdom regarding a quandary in front of you."
            EFFECTS "If you succeed, you receive a brief vision or hear the voice of Togashi providing a hint regarding one way you might proceed (which the GM should furnish). This hint should not be the full answer, but it should help you move forward toward a solution or at least formulate a plan of action."
            OPPORTUNITIES {
                "Void (op): Reduce the TN of your first check to overcome the problem you are facing by your school rank (to a minimum of 1)."
            }
        }

        #2HdMwjLF8vs7Y8cAuRydLF ^"Rouse the Soul" DEF {
            RANK 5
            ACTIVATION "When making a Social skill (Void) or Theology (Void) check targeting one or more characters, you may spend (op) in the following way:"
            OPPORTUNITIES {
                "Void (op)+: Remove one of the following conditions from one target per (op) spent this way: ^\"Afflicted\", ^\"Enraged\", ^\"Exhausted\", ^\"Intoxicated\", or ^\"Unconscious\"."
            }
        }

        RULES {
            #L5R317fG9hI1jK3lM5nO7p: shuji_social_techniques_usable_in_intrigues_duels_skirmishes_and_other_conflicts
            #L5R318qR0sT2uV4wX6yZ8a: shuji_available_to_schools_listing_shuji
            #L5R319bC1dE3fG5hI7jK9l: shuji_organized_by_elemental_classification
        }
    }

    # ===========================
    # MAHŌ (mahō) — DARK SORCERY
    # ===========================

    ^"Mahō" DEF {
        ALIAS "Maho"
        APPLIES TO [^"Samurai", ^"Adversary"]

        # Kansen are evil spirits, twisted kami that spill forth from Jigoku
        # or were once kami corrupted within Rokugan. Those mortals who dare
        # to wield the evil sorcery called mahō are known as mahō-tsukai.
        # Reviled by society and hunted by sworn orders, mahō-tsukai often
        # act subtly, disguising their corruption beneath a pleasant façade.
        #
        # Symbol: (mahō)
        # Available to: Anyone with access to evil lore (ancient tome, kansen
        #   mentor, or ^"Shadowlands Taint" disadvantage) and the will to
        #   seize power at any cost

        # --- Mahō Framework Rules ---

        PROPER_SACRIFICES {
            # Kansen require sacrifice to fuel mahō — usually blood (own or
            # another's), but particularly evil acts can also suffice at GM's
            # discretion.
            #
            # Exceptional sacrifice (killing a human victim or crossing a
            # vital personal line): may reroll up to 3 blank rolled dice
            # during the check. The offering is consumed.
        }

        SPIRITUAL_BACKLASH {
            # When a mahō-tsukai generates 3 or more (st) on kept dice while
            # performing a mahō technique, the mahō-tsukai suffers a critical
            # strike with severity equal to their current strife. Then, the GM
            # assigns the ^"Shadowlands Taint" disadvantage to one of the
            # mahō-tsukai's rings that does not already have it.
        }

        CHANNELING_MAHO {
            # Like invocations, mahō techniques can be channeled (see
            # ^"Channeling"). However, for each die a character reserves
            # while channeling a mahō technique, the character receives
            # 1 fatigue.
        }

        IMPORTUNE_MAHO {
            # Once per scene, a ^"Tainted" character may choose one mahō
            # technique they have not learned (even if they do not meet the
            # prerequisites) and make a sacrifice to the kansen. To importune
            # mahō, a character must kill a human victim or cross a previously
            # inviolable personal line (betray a close friend, abandon a
            # personal ideal, allow despair to overwhelm them entirely). If
            # the GM determines the kansen is satisfied, the character may
            # perform the action associated with that technique. The character
            # may channel this mahō as usual but can only perform the action
            # once.
        }

        # --- Mahō Techniques ---

        #Z08hgcM2pmKDZ3JoeHgysC ^"Grip of Anguish" DEF {
            RANK 1
            ACTIVATION "As an Attack action, make a Theology (Water) check targeting one living being at range 0-2. The TN of the check is equal to the target's vigilance."
            EFFECTS "If you succeed, you curse your target, causing them to suffer supernatural damage equal to your Water Ring plus the number of your rings with a ^\"Shadowlands Taint\" disadvantage attached."
            OPPORTUNITIES {
                "Water (op): One target must resist with a TN 3 Fitness check (Earth 1, Fire 4) or suffer one of the following conditions of your choice: ^\"Dazed\", ^\"Disoriented\", ^\"Silenced\"."
                "Water (op)+: Treat the maximum range of the technique as 1 higher per (op) spent this way."
                "Water (op)+: Choose one additional target per (op) spent this way."
                "Water (op)(op): One target must resist with a TN 3 Fitness check (Earth 1, Fire 4) or suffer one of the following conditions of your choice: ^\"Bleeding\", ^\"Immobilized\", or ^\"Lightly Wounded\"."
            }
        }

        #E7dbkpcgyzgOINco7KmXAx ^"Incite Haunting" DEF {
            RANK 1
            ACTIVATION "As an Attack and Scheme action, make a Theology check targeting one character at range 0-1. This check uses any ring of your choice, and the TN of the check is equal to the target's vigilance."
            EFFECTS "If you succeed, you curse your target, causing them to suffer the ^\"Afflicted\" condition. If you fail, the target rebuffs your efforts. If your shortfall is 2 or higher, the target also becomes aware of your attempted malediction."
            OPPORTUNITIES {
                "(op)+: Treat the maximum range of the technique as 1 higher per (op) spent this way."
                "(op)+: Choose one additional target per (op) spent this way."
            }
        }

        #v5nWeISsM5mfuLuV0SfcQH ^"Mark of Desecration" DEF {
            RANK 1
            ACTIVATION "As a Support action, make a TN 2 Theology (Earth) check targeting a number of corpses up to your Earth Ring at range 0-3."
            EFFECTS "If you succeed, you summon a ^\"Zombie Peasant\" from each target. You also curse an area encompassing 1 range band around each target's position, which gains the ^\"Defiled\" terrain quality."
            OPPORTUNITIES {
                "Earth (op)+: Choose one additional target per (op) spent this way."
                "Earth (op)+: Increase each zombie's endurance by 1 per (op) spent this way."
                "Earth (op)(op): Once per round, one zombie may use your skill ranks instead of its own for a check."
                "Earth (op)(op)+: One target who was a warrior in life per (op)(op) spent this way rises as a ^\"Bushi Skeleton\" instead."
            }
        }

        #ZVD5eQXiGpcpsn5fmAKVJc ^"Sinful Whispers" DEF {
            RANK 1
            ACTIVATION "As an Attack and Scheme action, make a Theology (Air) check targeting one character with the ^\"Afflicted\" condition at range 0-4. The TN of the check is equal to the target's vigilance."
            EFFECTS "If you succeed, you curse your target, sapping their will; they must answer your questions honestly (and find doing so unremarkable at the time). This effect persists for a number of rounds equal to your Air Ring."
            OPPORTUNITIES {
                "Air (op): The target does not remember what you asked, even if prompted to think about the conversation later."
                "Air (op)(op)(op): You may give the target a single simple order. The target may ignore that order, but receives 2 strife at the end of each scene in which they disregard it. When the target becomes ^\"Compromised\", they must unmask and attempt to fulfill the order until the end of the scene."
            }
        }

        #HEiZLRgKB0B99Z4IeLqn0p ^"Unholy Fervor" DEF {
            RANK 1
            ACTIVATION "As a Support action, make a Theology (Fire) check targeting one character at range 0-3. The TN of this check is equal to the target's vigilance."
            EFFECTS "If you succeed, you curse the target with blinding fury; they suffer the ^\"Enraged\" condition. You also augment the target's corruption; they may treat each of their ^\"Shadowlands Taint\" disadvantages as an advantage that applies to any checks using its ring. This effect persists until the end of the scene."
            OPPORTUNITIES {
                "Fire (op): Each target receives strife equal to your Fire Ring and removes that much fatigue."
                "Fire (op)+: Choose one additional target per (op) spent this way."
            }
        }

        RULES {
            #L5R320mN2oP4qR6sT8uV0w: maho_forbidden_throughout_empire_punishable_by_death
            #L5R321xY3zA5bC7dE9fG1h: maho_requires_blood_sacrifice_exceptional_sacrifice_rerolls_3_blanks
            #L5R322iJ4kL6mN8oP0qR2s: maho_spiritual_backlash_critical_strike_plus_taint
            #L5R323tU5vW7xY9zA1bC3d: maho_channeling_incurs_1_fatigue_per_reserved_die
            #L5R324eF6gH8iJ0kL2mN4o: maho_importune_once_per_scene_requires_exceptional_sacrifice
        }
    }

    # ===========================
    # NINJUTSU (ninjutsu) — SHINOBI TECHNIQUES
    # ===========================

    ^"Ninjutsu" DEF {
        APPLIES TO [^"Samurai", ^"Adversary"]

        # Ninjutsu are secret techniques passed down from shinobi masters
        # to their students. They are hardly ever committed to paper, and
        # are written only in the minds of their practitioners. Sneaking
        # through shadows, poisoning foes, and vanishing without a trace —
        # to employ these tactics is to stray from the path of Bushidō, but
        # some are willing to pay this price for their family, clan, and empire.
        #
        # Symbol: (ninjutsu)
        # Available to: Schools listing "ninjutsu" among available techniques

        #Fw3nwqrRGKBgIpzO0vFakT ^"Skulk" DEF {
            RANK 1
            ACTIVATION "When you perform an Initiative or Attack check using Air, you may spend (op) as follows:"
            OPPORTUNITIES {
                "(op): If you are in ^\"Obscuring\" terrain, a crowd, or otherwise concealed from sight, one character with vigilance lower than or equal to your ranks in Skulduggery loses sight of you."
            }
        }

        #4W0IygSdrLHDKytB1I8yIw ^"Deadly Sting" DEF {
            RANK 2
            ACTIVATION "As an Attack action, you may use one dose of a poison and make a TN 3 Martial Arts (Air) check using a readied ^\"Concealable\" weapon targeting one character within the weapon's range."
            EFFECTS "If you succeed, apply the chosen poison to your weapon (see ^\"Poison\"). Then, the target suffers physical damage equal to the deadliness of your weapon plus your bonus successes."
            OPPORTUNITIES {
                "Air (op): Move 1 range band."
                "Air (op)+: If you succeed, the target suffers a critical strike with severity 2, plus 1 per (op) spent this way."
            }
        }

        #5yKYfFDPSlfe5aZ8XGo6QF ^"Noxious Cloud" DEF {
            RANK 3
            ACTIVATION "As an Attack action, you may use two doses of any single poison and make a TN 2 Medicine (Air) check targeting each other character at range 0-2."
            EFFECTS "If you succeed, each target suffers 3 physical damage, ignoring their resistance. This damage counts as being inflicted by a weapon envenomed with the poison you chose (see ^\"Poison\")."
            OPPORTUNITIES {
                "Air (op): Move 1 range band."
                "Air (op)+: Until the end of the scene, the area at range 0-2 becomes ^\"Obscuring\" and ^\"Dangerous\" terrain."
                "Air (op)(op)+: If you succeed, one target per (op)(op) spent this way suffers a critical strike with severity 2."
            }
        }

        #vxiscnhW4PgnwgCjbB9QVZ ^"Silencing Stroke" DEF {
            RANK 4
            ACTIVATION "As an Attack action, make a TN 4 Martial Arts (Air) check using a readied weapon targeting one character within the weapon's range."
            EFFECTS "If you succeed, the target suffers physical damage equal to your weapon's base damage and suffers the ^\"Silenced\" condition. Other characters beyond range 0-2 of the target do not notice that they have been struck for 1 round, plus additional rounds equal to your bonus successes."
            OPPORTUNITIES {
                "Air (op)+: If you succeed, the target suffers a critical strike with severity equal to the deadliness of your weapon plus 1 per (op) spent this way beyond the first."
            }
        }

        RULES {
            #L5R324eF6gH8iJ0kL2mN4o: ninjutsu_available_to_schools_listing_ninjutsu
            #L5R325pQ7rS9tU1vW3xY5z: ninjutsu_secret_oral_tradition_rarely_written
            #L5R326aB8cD0eF2gH4iJ6k: ninjutsu_strays_from_bushido
        }
    }

    # ===========================
    # INVERSIONS (inversion) — VOID TECHNIQUES
    # ===========================

    ^"Inversion" DEF {
        APPLIES TO [^"Samurai", ^"Adversary"]

        # NOTE: Inversions are not in the Core Rulebook; they appear in
        # sourcebooks (Celestial Realms, etc.). Included here as a
        # category placeholder.
        #
        # Rare and dangerous techniques that manipulate the Void itself.
        # Practiced by ishiken (Void shugenja) and those who commune
        # directly with the nothingness between elements.
        #
        # Symbol: (inversion)
        # Available to: Schools listing Inversions (primarily Void shugenja)

        EXAMPLES {
            ^"Void Awakening" RANK 1 "(inversion). Action: Sense supernatural presences and Void disturbances."
            ^"Sever Ties" RANK 3 "(inversion). Action: Sever a spiritual connection or bond."
            ^"Unmake" RANK 5 "(inversion). Action: Dissolve an object or effect into the Void."
        }

        RULES {
            #L5R327lM9nO1pQ3rS5tU7v: inversions_require_ishiken
            #L5R328wX0yZ2aB4cD6eF8g: inversions_cause_fatigue_on_strife
            #L5R329hI1jK3lM5nO7pQ9r: inversions_unpredictable_consequences
        }
    }

    # ===========================
    # MANTRA (mantra) — MEDITATION TECHNIQUES
    # ===========================

    ^"Mantra" DEF {
        APPLIES TO [^"Samurai", ^"Adversary"]

        # NOTE: Mantras are not in the Core Rulebook; they appear in
        # sourcebooks (Celestial Realms, etc.). Included here as a
        # category placeholder.
        #
        # Contemplative techniques combining meditation and spiritual
        # focus. Mantras bridge kihō and invocations.
        #
        # Symbol: (mantra)
        # Available to: Sourcebook schools (Celestial Realms, etc.)

        RULES {
            #L5R330sT2uV4wX6yZ8aB0c: mantras_meditation_focus
            #L5R331dE3fG5hI7jK9lM1n: mantras_bridge_kiho_invocations
        }
    }

    # Note: Technique prerequisites are now described within the
    # ^"Technique" DEF above (prerequisites, waiver rules, = mark,
    # losing special access). No separate DEF needed.
}
