    # ===========================
    # INVOCATIONS (invocation) — ELEMENTAL PRAYERS
    # ===========================

    ^"Invocation" DEF {
        APPLIES TO [^"Samurai", ^"Adversary"]

        # Invocations are prayers and offerings to powerful spirits in
        # exchange for earthly support. They are practiced primarily by
        # shugenja, who are elite samurai priests from ancient, secretive
        # lineages with the power to speak directly to the kami.
        # Invocations are new actions.
        #
        # Symbol: (invocation)
        # Available to: Schools listing Invocations in technique groups (shugenja)

        # Invocations have elemental classifications (Air, Earth, Fire,
        # Water). Note: there are NO Void invocations.
        ELEMENTAL_CLASSIFICATIONS ["Air", "Earth", "Fire", "Water"]

        # --- EFFECT KEYWORDS ---
        # Italicized keywords in invocation effects indicate function:
        # Augment (change/bolster), Mend (restore), Purify (cast out evil),
        # Scry (reveal info), Smite (cause harm), Summon (create something).

        # --- PROPER OFFERINGS ---
        # A shugenja who makes a material offering alongside an invocation
        # may reroll up to 3 rolled dice showing blank results. The offering
        # is consumed. Offerings by spirit type:
        #   Air: Incense, feathers, flowers
        #   Earth: Salt, soil/stones from sacred places, seeds
        #   Fire: Kindling, paper, ash, small flammable objects
        #   Water: Coins, seashells, precious materials, seaweed, sake
        #   Fortunes: Texts, food, origami, works of art
        #   Ancestor Spirits: Food, incense, sake or other libations

        # --- CHANNELING ---
        # Allows delaying completion of an invocation, carrying results
        # over to the next invocation of the same Element.
        CHANNELING {
            ^"Choosing to Channel" "After Step 5: Choose Kept Dice, the character may channel any number of kept dice. Instead of resolving the rest of the check, the character reserves these dice (tracking faces shown). The check ends with no dice results or effects resolved (including success or failure)."
            ^"Using Channeled Dice" "On the character's next turn, if they perform an invocation of the same Element, during Step 3: Assemble and Roll Dice Pool, roll one fewer (ring) per reserved (ring) and one fewer (skill) per reserved (skill), then add channeled dice set to their original results."
            ^"Limitations" "May channel any number of times during a conflict. Outside conflict, may channel only once, and it doubles the invocation time."
            ^"Interruption" "If a character with channeled dice performs any action other than an invocation of the same Element, all channeled dice are lost. If a character becomes ^\"Dazed\", ^\"Silenced\", or ^\"Unconscious\" while channeling, reserved dice are lost."
        }

        # --- SPIRITUAL BACKLASH ---
        # When 3+ (st) symbols on kept dice while performing an invocation:
        # 3 fatigue, cannot use invocations of that element until end of
        # scene, plus element-specific effect.
        SPIRITUAL_BACKLASH {
            "Trigger: 3 or more (st) symbols on kept dice while performing an invocation."
            "Base: 3 fatigue; cannot use invocations of that element again until end of scene."
            ^"Air" "GM chooses up to two additional characters in range who become targets (or GM picks a player to choose, for an NPC)."
            ^"Fire" "Technique targets each character in range. Terrain at range 0-2 may become ^\"Dangerous\" at GM's discretion."
            ^"Earth" "Terrain at range 0-3 gains ^\"Imbalanced\" (Earth) for days equal to the shugenja's strife."
            ^"Water" "Terrain at range 0-1 turns to muck and becomes ^\"Entangling\"."
        }

        # --- IMPORTUNE INVOCATIONS ---
        # Once per scene, a character who knows 1+ invocations may attempt
        # an unlearned invocation (even without prerequisites) by making a
        # valuable offering to the kami (rare or unique item, lost forever).
        # TN increased by 1 + 1 per school rank the prerequisite exceeds
        # the character's rank. May channel as usual but perform only once.

        # --- PREPARED INVOCATIONS ---
        # Downtime activity: bind an invocation into an expendable vessel.
        # Only one prepared invocation at a time (preparing another fades
        # the first). Anyone holding it can unleash via listed activation.
        # Check uses the invocation's ring and TN.
        #
        # Wards: Parchment marked by mystic symbols.
        #   Preparation Skill: ^"Composition"
        #   Ingredients: Calligraphy set, 1 bu of parchment.
        #   Place on any surface, write a triggering condition. When
        #   fulfilled, the invocation activates at its location.

        # --- SPENDING (op) FOR INVOCATIONS ---
        # General (op) options by element (GM decides applicability):
        INVOCATION_OPPORTUNITIES {
            #cDevpZXtxqd46NJqprp4rm ^"Air" DEF {
                "Air (op)(op)+: Choose one additional target per (op)(op) spent this way."
                "+(op): Treat maximum range as 1 higher per (op) spent this way."
                "(op): Reduce TN of next Movement action check by 1. Persists until end of next turn."
                "Air +(op): If technique can target others, choose one additional target per (op) spent this way."
                "Air +(op): If technique targets all in area, exclude 1 character per (op) spent this way."
            }
            #itdq5tlzzZmtVUu19qKpsB ^"Earth" DEF {
                "(op): Increase physical resistance by 1 until beginning of next turn."
                "+(op): If technique can target others, choose one additional target per (op) spent this way."
                "+(op): Treat maximum range as 1 higher per (op) spent this way."
                "(op): Damage inflicts physical instead of supernatural."
                "(op): Damage has the ^\"Sacred\" quality."
            }
            #FR6cTej4A3soIQUAo6uoaz ^"Fire" DEF {
                "+(op): Treat maximum range as 1 higher per (op) spent this way."
                "+(op): If technique can target others, choose one additional target per (op) spent this way."
                "(op): Reduce TN of next Attack action check by 1. Persists until end of next turn."
                "+(op): Increase TN of checks to resist by 1 per (op) spent this way."
                "Fire (op)(op)+: One target per (op)(op) must resist TN 3 ^\"Fitness\" (Air 4, Water 1) or suffer ^\"Burning\"."
            }
            #JfSJn1ALKF1amg3pUJXPhp ^"Water" DEF {
                "(op): Increase supernatural resistance by 1 until end of next turn."
                "+(op): If technique can target others, choose one additional target per (op) spent this way."
                "Water (op)(op)+: Treat max or min range as 1 higher or lower per (op)(op) spent this way."
                "Water (op): Remove 1 fatigue from target or yourself."
                "(op): Reduce TN of next Support action check by 1. Persists until end of next turn."
            }
        }

        # ==================
        # AIR INVOCATIONS
        # ==================

        # Air kami are fickle and capricious beings, but none are nimbler
        # or more subtle. They bestow lightness of step, nimbleness of
        # mind, and the ability to enhance or obscure sight.

        #NplLa67DjUuIrOWZjhEO5V ^"Blessed Wind" DEF {
            RANK 1
            OTHER_NAMES "Bottled Duststorm (Alchemy), Tamon's Rebuke (Fortunist), Column of the World (Foreign)"
            ACTIVATION "As a Support action, make a TN 2 Theology (Air) check targeting one position at range 0-3."
            EFFECTS "If you succeed, you summon a swirling wind at the target position. Any character at range 0-2 of the chosen position counts as being in ^\"Obscuring\" terrain for Attack actions targeting them. Persists for one round, plus additional rounds equal to your bonus successes."
            OPPORTUNITIES {
                "Air (op): This effect persists until end of the scene instead."
            }
        }

        #92FDBSLYNzoMbnc4ueKtnX ^"By the Light of the Lord Moon" DEF {
            RANK 1
            OTHER_NAMES "Kitsuki's Eyes (Ancestral), Wind Scatters Shadow (Elemental), Reveal the World of Ghosts (Foreign)"
            ACTIVATION "As a Scheme action, make a TN 2 Theology (Air) check targeting an area at range 0-2."
            EFFECTS "If you succeed, you scry for each hidden character and concealed object (secret compartments, trap doors, concealed weapons) in the targeted area, revealing it with a luminous outline only you can perceive. Only reveals mundane concealment."
            OPPORTUNITIES {
                "Air +(op): Reveal up to one magically concealed object per (op) spent this way."
                "Air (op)(op)+: Choose one additional character at range 0-1 per (op)(op) spent this way who can also see the objects."
            }
        }

        #XfCP5vVEcizWd4A7HhjF8l ^"Call Upon the Wind" DEF {
            RANK 2
            OTHER_NAMES "Gentle Wings of the Wren (Alchemy), Doji's Steps (Ancestral), Benten Smiles (Fortunist)"
            ACTIVATION "As a Movement action, make a TN 4 Theology (Air) check targeting yourself."
            EFFECTS "If you succeed, you augment your movement with a gust of wind that carries you aloft. You may move vertically freely and ignore the effects of terrain while flying. Persists until end of the scene."
            OPPORTUNITIES {
                "Air (op)(op)+: While flying, carry up to one additional willing character at range 0-2 per (op)(op) spent this way."
            }
        }

        #YY6q3YNKSDp3EMJu8qmnwY ^"Cloak of Night" DEF {
            RANK 1
            OTHER_NAMES "Smoke of Stolen Light (Alchemy), Shroud of the North Wind (Fortunist), Walk in the Shadow World (Foreign)"
            ACTIVATION "As a Scheme and Support action, make a Theology (Air) check targeting one object or character at range 0-1. TN equals the target's ^\"Silhouette\"."
            EFFECTS "If you succeed, you augment the target with an illusion that renders it invisible to the naked eye. The object is still physically present and can be touched, smelled, or sensed with any normal sense other than vision. Persists for one round, plus additional rounds equal to your bonus successes."
            OPPORTUNITIES {
                "Air (op)(op)+: Choose one additional target of the same silhouette or smaller per (op)(op) spent this way."
            }
        }

        #r2gWHZuAwLe2R7ZU9aFbLC ^"False Realm of the Fox Spirits" DEF {
            RANK 4
            OTHER_NAMES "Ikoma Recalls a Tale (Ancestral), Lost in the Isawa Mori (Fortunist), Paint the Spyglass Lens (Foreign)"
            ACTIVATION "As a Scheme action, make a TN 5 Theology (Air) check targeting one position at range 0-4."
            EFFECTS "If you succeed, you summon illusory terrain at the target position extending range bands up to your Air Ring. A character unaware of its false nature must resist with a TN 4 ^\"Survival\" check (Earth 5, Fire 2) to realize its falsehood at a distance. Any physical contact reveals the lie (though the illusion stays in place). Persists for rounds equal to your Air Ring plus bonus successes (or that many minutes in narrative or downtime)."
            OPPORTUNITIES {
                "Air (op): This effect persists until end of the scene instead."
                "Air +(op): The illusory terrain has one of the following terrain qualities per (op) spent this way: ^\"Dangerous\", ^\"Entangling\", or ^\"Obscuring\"."
            }
        }

        #xKrS3aGxf7KIwhECALgvkN ^"Grasp of the Air Dragon" DEF {
            RANK 3
            OTHER_NAMES "Shikajin's Leap (Ancestral), Jikoju's Journey (Fortunist), The Wind's Cradle (Foreign)"
            ACTIVATION "As an Attack action or a Support action, make a TN 4 Theology (Air) check targeting one character at range 3-5."
            EFFECTS {
                "If you succeed, you summon a gale-force wind to move the target range bands equal to your Air Ring plus bonus successes (max 6), ignoring intervening terrain. Set the target down gently (Support) or slam them into the ground (Attack)."
                "Attack: Target must resist with a TN 4 ^\"Fitness\" check (Earth 5, Fire 2) or suffer the effects of a fall from range 3."
            }
            OPPORTUNITIES {
                "Air +(op): Treat the maximum range as 1 higher per (op) spent this way."
                "Air (op)(op)+: Increase the height of the fall the target suffers by 1 per (op)(op) spent this way."
            }
        }

        #f9tEfUTkeEZJEZfaWNwgM2 ^"Mask of Wind" DEF {
            RANK 2
            OTHER_NAMES "Paste of Moving Features (Alchemy), Furuyari's Face (Ancestral), Sadahako's Joke (Fortunist)"
            ACTIVATION "As a Scheme and Support action, make a TN 3 Theology (Air) check targeting yourself."
            EFFECTS "If you succeed, you augment yourself with an illusion that makes you look like someone else. An observer must resist with a TN 4 ^\"Sentiment\" check (Earth 5, Fire 2) to notice something amiss from appearance alone; if they succeed, they may spend (op) to recognize you specifically. Persists until end of the scene."
            OPPORTUNITIES {
                "Air (op): Alter your voice to sound like someone else. Separate TN 4 Sentiment check (Earth 5, Fire 2) to notice from voice alone; may spend (op) to recognize you."
                "Air (op)(op)+: This effect persists for one additional scene per (op)(op) spent this way."
            }
        }

        #LqzP8pxVfEv2IxA67lSDD8 ^"Nature's Touch" DEF {
            RANK 1
            OTHER_NAMES "Shinjo's Whispers (Ancestral), Run Alongside the Ki-Rin (Fortunist), Voice of the Glen King (Foreign)"
            ACTIVATION "As a Support action, make a TN 1 Theology (Air) check targeting yourself."
