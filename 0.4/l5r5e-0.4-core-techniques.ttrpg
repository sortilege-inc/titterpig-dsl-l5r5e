BASE "L5R5e_Core_Techniques" {
    NAME "Legend of the Five Rings 5th Edition - Technique types, categories, and core technique definitions"
    VERSION "0.4.1"
    SPEC_VERSION "0.4"
    RELEASE_DATE "2026-03-01"

    # Core Rulebook: All technique types and their mechanics.
    # Techniques are special abilities purchased with XP and unlocked
    # through school curriculum advancement. Each has a type, rank,
    # activation method, and associated ring/skill.

    # ===========================
    # TECHNIQUE FRAMEWORK
    # ===========================

    #L5R350fG9hI1jK3lM5nO7p ^"Technique" DEF {
        APPLIES TO [^"Samurai", ^"Adversary"]

        # Techniques are special abilities that represent advanced training.
        # They enable a character to perform feats more quickly or in a
        # unique way, or to exploit opportunities others would overlook.

        # --- CATEGORY ---
        # Each character is granted access to technique categories by their
        # ^"School". The categories are:

        CATEGORY ENUM ["Kata", "Kihō", "Invocation", "Ritual", "Shūji", "Mahō", "Ninjutsu"]
        # Additional categories from sourcebooks: Inversion, Mantra

        # --- NAME ---
        # Each technique has a name, though different schools may describe
        # similar tactics differently. Some techniques (especially invocations)
        # have an "Other Names" field. Players are encouraged to use them
        # to underscore the unique traditions of individual schools.

        # --- PREREQUISITES ---
        # School ranks, clan affiliations, role/schools, ring values, skill
        # ranks, other techniques, or other qualifiers required to purchase
        # a technique with experience.
        #
        # Prerequisites are WAIVED if:
        # - A character is directly granted a technique during character
        #   creation (or at another time), OR
        # - The technique appears on the character's curriculum by name or
        #   as part of a listed group (e.g. "Rank 1-3 Kata").
        #
        # Such techniques and groups are marked with = to denote their
        # special status. If a character does not choose a technique to
        # which they have special access, or advances past the school rank
        # that enables them to buy it without purchasing it, they LOSE
        # their special access and can no longer purchase it at reduced cost.

        # --- XP COST ---
        # All techniques cost 3 XP to purchase. If a technique costs a
        # different amount, it is listed in the entry.

        # --- ACTIVATION ---
        # Each technique specifies when and how it can be used. The
        # activation generally includes some or all of the following:
        ACTIVATION_COMPONENTS {
            #V7IwVF3r66mCKeFefueKuT ^"Use" DEF {
                "As an Action: Character must perform an action during a conflict scene. If the action lists one or more types, it possesses each of those types."
                "As a Downtime Activity: Character must spend a downtime scene to attempt the task."
                "When Making a Check: Character can activate only during checks using the specified skill, skill group, ring, or combination. Usually requires spending (op)."
            }
            ^"Check" "If activation requires an action or downtime scene, it generally requires a separate check with a specified TN. If no ring is specified, any ring may be used (e.g. the one matching current stance in conflict). If a skill group is listed, the character chooses any skill from that group."
            ^"Targets" "Characters, positions, or objects affected. When a character has a choice of multiple possible targets, they must choose from among the valid targets."
            ^"Range" "Specified as 'at range [number]', 'at range [number]-[number]', 'in range of your weapon', or similar. Targets beyond the specified range are not affected."
            ^"Other Requirements" "Circumstantial requirements such as 'using a readied weapon', 'under the full moon', or 'while on ^\"Hallowed\" ground'."
        }

        # --- EFFECTS ---
        # Each technique lists effects that occur after activation. Each
        # paragraph represents a distinct effect.
        #
        # - "If you succeed" effects only resolve on successful check.
        # - "If you fail" effects only resolve on failed check.
        # - Effects with alternate conditions resolve under stated conditions.
        # - Effects with no conditions always resolve.
        #
        # Persistent Effects: Some effects persist for a set duration
        # (e.g. "until the beginning of your next turn", "for one round
        # plus additional rounds equal to your bonus successes", "until
        # the end of the scene"). A character cannot benefit (or suffer)
        # from more than one instance of the same persistent effect, even
        # from multiple sources. If overlapping: player chooses if beneficial,
        # GM chooses if harmful.

        # --- NEW OPPORTUNITIES ---
        # Many techniques list one or more uses of (op) specific to the
        # check. Some are preceded by a ring requirement (e.g. "Air (op)")
        # meaning the character can only spend (op) this way if they used
        # that ring for the check.

        PROPERTIES {
            ^"Name" STRING REQUIRED
            ^"Category" STRING  # References category ENUM above
            ^"Rank" INTEGER MIN 1 MAX 5
            ^"Prerequisites" STRING  # School rank, ring values, clan, etc.
            ^"XP Cost" INTEGER DEFAULT 3
            ^"Activation" STRING  # Use, Check, Targets, Range, Other Requirements
            ^"Description" STRING  # Narrative description (no mechanical effect)
            ^"Effects" STRING  # Mechanical effects with conditional resolution
            ^"New Opportunities" STRING  # Technique-specific (op) spends
        }

        RULES {
            #L5R300aB2cD4eF6gH8iJ0k: technique_categories_granted_by_school
            #L5R301lM3nO5pQ7rS9tU1v: prerequisites_waived_for_curriculum
            #L5R301aM3nO5pQ7rS9tU2w: lose_special_access_if_skipped
            #L5R302wX4yZ6aB8cD0eF2g: all_techniques_cost_3xp_unless_noted
            #L5R302aX4yZ6aB8cD0eF3h: persistent_effects_do_not_stack
        }
    }

    # ===========================
    # KATA (kata) — MARTIAL TECHNIQUES
    # ===========================

    ^"Kata" DEF {
        APPLIES TO [^"Samurai", ^"Adversary"]

        # Kata are specialized combat techniques that allow martial artists
        # to vanquish even foes who exceed them in physical strength, speed,
        # or agility. Some kata are new actions, while others grant new ways
        # to spend (op).
        #
        # Symbol: (kata)
        # Available to: Schools listing Kata in technique groups

        # Kata have form classifications:
        FORM_CLASSIFICATIONS {
            "General" "Available to any character with kata access"
            "Close Combat" "Melee weapon techniques"
            "Ranged Combat" "Bow and ranged weapon techniques"
        }

        # ==================
        # GENERAL KATA
        # ==================

        #T9POwkfZWkuZvYQv83o8Ab ^"Battle in the Mind" DEF {
            RANK 3
            ACTIVATION "When you make an ^\"Initiative\" check for a ^\"Duel\" using your Void Ring, you may spend (op):"
            OPPORTUNITIES {
                "Void (op): You name two rings, then your opponent must name one. When your opponent selects their stance during their first turn, they cannot select the ring they named."
                "Void +(op): Choose a technique category. Learn one of your opponent's known techniques of that category (chosen by opponent) per (op) spent this way."
            }
        }

        #oddkoaxIyd7JQiywOXHmBX ^"Breath of Wind Style" DEF {
            RANK 4
            ACTIVATION "When you make a Martial Arts [Melee, Ranged, or Unarmed] (Air) check, you may spend (op):"
            OPPORTUNITIES {
                "Air +(op): One target must resist with a TN 3 ^\"Fitness\" check (Earth 4, Fire 1) or suffer ^\"Disoriented\" and fatigue equal to their shortfall. Increase the TN to resist by 1 per (op) spent this way."
            }
        }

        #YHt6EVGbAa1u7vArotHqOh ^"Crashing Wave Style" DEF {
            RANK 4
            ACTIVATION "When you make a Martial Arts [Melee, Ranged, or Unarmed] (Water) check, you may spend (op):"
            OPPORTUNITIES {
                "Water +(op): One target must resist with a TN 3 ^\"Fitness\" check (Earth 1, Fire 4) or suffer ^\"Bleeding\" and fatigue equal to their shortfall. Increase the TN to resist by 1 per (op) spent this way."
            }
        }

        #l2wYxPgu8jTyj5EdSlvmOM ^"Crescent Moon Style" DEF {
            RANK 2
            ACTIVATION "When you perform Guard action, you may spend (op):"
            OPPORTUNITIES {
                "(op): After a character at range 1-2 performs an Attack action targeting you or another character you are guarding, you may perform a Strike action with one readied Martial Arts [Melee or Unarmed] weapon targeting that character (if within weapon's range). Persists until start of your next turn, or until you perform a Strike action this way."
            }
        }

        #afQfncH9y7kre1RoUTqtma ^"Crimson Leaves Strike" DEF {
            RANK 3
            ACTIVATION "As an Attack action using a readied weapon, make a TN 4 Martial Arts (Earth) check targeting one character within weapon's range."
            EFFECTS {
                "If you succeed, target suffers physical damage equal to your Earth Ring plus bonus successes. Choose one of target's readied weapons; target must resist with a TN 4 ^\"Fitness\" check (Air 2, Water 5) or lose control of the chosen weapon, which travels 3 range bands in a direction of your choice."
            }
            OPPORTUNITIES {
                "Earth (op): If you disarm your opponent, you may take control of their weapon instead of knocking it away."
            }
        }

        #CiESopm2EvTr90r7JRDN8f ^"Disappearing World Style" DEF {
            RANK 4
            ACTIVATION "When you make a Martial Arts [Melee, Ranged, or Unarmed] (Fire) check, you may spend (op):"
            OPPORTUNITIES {
                "Fire +(op): One target must resist with a TN 3 ^\"Fitness\" check (Air 4, Water 1) or suffer ^\"Dazed\" and fatigue equal to their shortfall. Increase the TN to resist by 1 per (op) spent this way."
            }
        }

        #bWzTE8wFpDe2NVPUtMENyC ^"Flowing Water Strike" DEF {
            RANK 3
            ACTIVATION "As an Attack and Movement action using a readied weapon, make a TN 3 Martial Arts (Water) check targeting one character at range 0-2 (regardless of weapon's usual range restrictions)."
            EFFECTS {
                "If you succeed, the target suffers physical damage equal to your Water Ring and suffers ^\"Bleeding\". Target must resist with a TN 4 ^\"Fitness\" check (Earth 2, Fire 5); if they fail, increase the physical damage by your weapon's base damage."
            }
            OPPORTUNITIES {
                "Water (op): Remove ^\"Dazed\", ^\"Disoriented\", ^\"Immobilized\", or ^\"Prone\" from yourself."
            }
        }

        #TklHzFuxZjRGJun08NB32d ^"Heartpiercing Strike" DEF {
            RANK 3
            ACTIVATION "As an Attack and Movement action using a readied weapon, make a TN 4 Martial Arts (Fire) check targeting one character within weapon's range."
            EFFECTS {
                "If you succeed, target suffers a ^\"Critical Strike\" with severity equal to weapon's deadliness plus bonus successes. The TN of the ^\"Fitness\" check to resist is 3 (Air 4, Water 1) instead of the normal TN."
                "If you fail, you suffer ^\"Disoriented\"."
            }
            OPPORTUNITIES {
                "Fire (op): Before resolving the effect, move up to 1 range band toward your target."
            }
        }

        #PplJyuuwlkxQFj7Q3h8OoD ^"Iron in the Mountains Style" DEF {
            RANK 4
            ACTIVATION "When you make a Martial Arts [Melee, Ranged, or Unarmed] (Earth) check, you may spend (op):"
            OPPORTUNITIES {
                "Earth +(op): One target must resist with a TN 3 ^\"Fitness\" check (Air 1, Water 4) or suffer ^\"Prone\" and fatigue equal to their shortfall. Increase the TN to resist by 1 per (op) spent this way."
            }
        }

        #VZRaBoZ23jv6pba1NYHPZz ^"Lord Hida's Grip" DEF {
            RANK 2
            PREREQUISITES "Crab Clan"
            ACTIVATION "As an Attack action, make a ^\"Fitness\" (Void) check targeting one creature of ^\"Silhouette\" 3 or larger at range 0-1. TN equals the target's silhouette (minimum 1)."
            EFFECTS {
                "If you succeed, target suffers ^\"Immobilized\"."
                "If you succeed, you count as granting ^\"Assistance\" to all characters who perform Attack actions against your target. Persists until beginning of your next turn."
            }
            OPPORTUNITIES {
                "Void (op): Target must resist with a ^\"Fitness\" check or suffer physical damage equal to its silhouette (ignoring resistance) and ^\"Prone\". TN of this check equals your school rank."
            }
        }

        #FpFKDUlzB1l3h8wu1zEcIH ^"Lord Shiba's Valor" DEF {
            RANK 2
            PREREQUISITES "Phoenix Clan"
            ACTIVATION "Once per game session, as a Support action using one readied weapon, make a TN 2 Tactics (Void) check targeting any number of friendly characters in range of your weapon."
            EFFECTS {
                "If you succeed, other characters cannot select your targets as the targets of their Attack or Scheme actions if they could select you instead. If an action has multiple targets, you must be the first target chosen. Persists for a number of rounds equal to your school rank."
            }
            OPPORTUNITIES {
                "Void (op): If you succeed, increase the TN of Attack and Scheme checks targeting you by 1. Persists until end of your next turn."
            }
        }

        #UflzaeVG3sMdnX2D8WpBmM ^"Soaring Slice" DEF {
            RANK 1
            ACTIVATION "As an Attack action using one readied weapon in a one-handed grip, make a TN 2 Martial Arts check targeting one character at range 2-3."
            EFFECTS {
                "You hurl your weapon at the target."
                "If you succeed, deal physical damage equal to the weapon's base damage plus bonus successes. Weapon lands at range in a direction of your choice from target if they defend, or embeds in them if they suffer a ^\"Critical Strike\"."
                "If you fail, weapon travels range bands equal to the maximum range of the technique in the direction of the target."
            }
            OPPORTUNITIES {
                "+(op): Treat the maximum range of this technique as 1 higher per (op) spent this way."
                "(op): Reduce the TN of the next Attack action against the target before end of your next turn by 1."
            }
        }

        #fqgySMrDkB4hMONSWX3ma5 ^"Soul Sunder" DEF {
            RANK 5
            ACTIVATION "As a Support action, make a TN 4 ^\"Meditation\" (Void) check to attune your blade to the spirits of your honored ancestors."
            EFFECTS {
                "If you succeed, choose one readied weapon. It gains the ^\"Sacred\" quality, and when you use it to inflict a ^\"Critical Strike\" on an Otherworldly being, treat its deadliness as increased by your bonus successes. Persists until end of your next turn."
            }
            OPPORTUNITIES {
                "Void +(op): This effect persists for one additional round per (op) spent this way."
                "Void (op)(op): Otherworldly beings cannot perform Attack actions targeting you until start of your next turn."
                "Void (op)(op)(op): You may immediately perform a Strike action using your readied weapon."
            }
        }

        #1hQUQrjYJXEBabs23ddxXh ^"Striking as Air" DEF {
            RANK 1
            ACTIVATION "When you make a Martial Arts [Melee, Ranged, or Unarmed] (Air) check, you may spend (op):"
            OPPORTUNITIES {
                "Air +(op): Reserve one of your rolled dice, plus one additional die per (op) spent this way. These become dropped dice. When making a check with the same skill before end of your next turn, you may roll one fewer (skill) per reserved (skill) and one fewer (ring) per reserved (ring), then add the reserved dice set to their original results. They count as rolled dice."
            }
        }

        #U5Y9ZuMONlY5eu2449bcxS ^"Striking as Earth" DEF {
            RANK 1
            ACTIVATION "When you make a Martial Arts [Melee, Ranged, or Unarmed] (Earth) check, you may spend (op):"
            OPPORTUNITIES {
                "Earth +(op): Treat your physical resistance as 1 higher per (op) spent this way until beginning of your next turn."
            }
        }

        #RmhsIc0PPNoVYKsaRR08By ^"Striking as Fire" DEF {
            RANK 1
            ACTIVATION "When you make a Martial Arts [Melee, Ranged, or Unarmed] (Fire) Attack action check, you may spend (op):"
            OPPORTUNITIES {
                "Fire +(op): The next time your target suffers a ^\"Critical Strike\", increase its severity by 1 per (op) spent this way. Persists until end of your next turn."
            }
        }

        #JPTU0vOXmQbL7sBmJ5XWTn ^"Striking as Void" DEF {
            RANK 5
            ACTIVATION "When you make a Martial Arts [Melee, Ranged, or Unarmed] (Void) check, you may spend (op):"
            OPPORTUNITIES {
                "Void (op): Immediately switch to a different stance of your choice."
                "Void (op): If you fail, you may perform another action. This must be an action you have not yet performed this turn. You can only activate this opportunity once per round."
            }
        }

        #AKclPTcck4JeiWjmkYgZuF ^"Striking as Water" DEF {
            RANK 1
            ACTIVATION "When you make a Martial Arts [Melee, Ranged, or Unarmed] (Water) Attack action check, you may spend (op):"
            OPPORTUNITIES {
                "Water +(op): Your target treats their physical resistance as 1 lower per (op) spent this way. Persists until end of your next turn."
            }
        }

        #UskyyuB3xgSuYTawcQK1cn ^"Tactical Assessment" DEF {
            RANK 2
            ACTIVATION "When you make an ^\"Initiative\" check, you may spend (op):"
            OPPORTUNITIES {
                "Air (op): Choose an enemy. Learn one of their advantages (their choice) and their physical or supernatural resistance (your choice)."
                "Earth (op): Choose a character. They do not apply any of their disadvantages to their checks until end of their first turn."
                "Water (op): Choose a piece of ^\"Terrain\". Until start of your first turn, it counts as having the ^\"Obscuring\" quality for Attack action checks targeting you and your allies."
                "Fire (op): Choose a character and one of their advantages you know. Until end of their first turn, they apply that advantage to all of their checks."
            }
        }

        #CxCHlu7u5FjgSZVJVo0N4x ^"Warrior's Resolve" DEF {
            RANK 1
            ACTIVATION "Once per scene, as a Support action, you may spend 1 ^\"Void Points\" to recover."
            EFFECTS {
                "Remove fatigue equal to your ^\"Honor\" rank."
            }
        }

        # ==================
        # CLOSE COMBAT KATA
        # ==================

        # Performed with Martial Arts [Melee] or Martial Arts [Unarmed] weapons.

        #i05F04V9dqXMYX8JbjixhJ ^"Coiling Serpent Style" DEF {
            RANK 2
            ACTIVATION "When you make a Martial Arts [Melee] or Martial Arts [Unarmed] check using a ^\"Snaring\" weapon, you may spend (op):"
            OPPORTUNITIES {
                "+(op): Choose one weapon a target has readied; that weapon cannot be used for Attack actions. Persists until end of your next turn."
                "(op) +(op): One target of your action per (op) spent this way becomes ^\"Immobilized\"."
            }
        }

        #2tXet8vVinnG7L7B32pbGY ^"Iaijutsu Cut: Crossing Blade" DEF {
            RANK 2
            ACTIVATION "As an Attack and Movement action using one sheathed ^\"Razor-Edged\" weapon, make a TN 2 Martial Arts [Melee] check targeting one character at range 1-2."
            EFFECTS {
                "You draw and ready the sheathed weapon in a one-handed grip."
                "If you succeed, deal physical damage equal to the weapon's deadliness plus bonus successes."
            }
            OPPORTUNITIES {
                "(op): Ready one other sheathed Razor-Edged weapon."
            }
        }

        #qvjQa6mLVO7fM30Hyv4a6x ^"Iaijutsu Cut: Rising Blade" DEF {
            RANK 2
            ACTIVATION "As an Attack action using one sheathed ^\"Razor-Edged\" weapon, make a TN 3 Martial Arts [Melee] check targeting one character at range 0-1."
            EFFECTS {
                "You draw and ready the sheathed weapon in a one-handed grip."
                "If you succeed, deal physical damage equal to the weapon's deadliness. Target cannot defend against this damage if they are ^\"Compromised\"."
            }
            OPPORTUNITIES {
                "(op): Ready one other sheathed Razor-Edged weapon."
            }
        }

        #nlPPHaS22Qi6bGH9PdPF7G ^"Iron Forest Style" DEF {
            RANK 2
            ACTIVATION "When you make a Martial Arts [Melee] check using a polearm, you may spend (op):"
            OPPORTUNITIES {
                "+(op): The area in range of your weapon counts as ^\"Dangerous\" terrain for one target per (op) spent this way. When an affected character attempts to move closer to you, they must make a TN 4 ^\"Fitness\" check (Air 2, Water 5); if they fail, they cannot advance. Persists until start of your next turn."
            }
        }

        #zVzvM0KFizf2Zk0Dl66npx ^"Open-Hand Style" DEF {
            RANK 2
            ACTIVATION "When you make a Martial Arts [Unarmed] check using a weapon with the ^\"Snaring\" quality, you may spend (op):"
            OPPORTUNITIES {
                "(op) +(op): One target per (op) spent this way must switch to a different stance of your choice. Targets of ^\"Silhouette\" 3 or greater may resist with a TN 3 ^\"Fitness\" check and ignore this effect if they succeed."
            }
        }

        #mbd9b1u2gOkuihy6u4a1OD ^"Rushing Avalanche Style" DEF {
            RANK 2
            ACTIVATION "When you make a Martial Arts [Melee] check using a blunt weapon, you may spend (op):"
            OPPORTUNITIES {
                "(op): If you fail with a shortfall of two or less, your target suffers physical damage equal to your ranks in ^\"Fitness\"."
                "(op): If you succeed and your target is ^\"Prone\", increase the damage you deal by your ranks in Fitness."
            }
        }

        #gRerY2G6BTUOWgV93Cb9pv ^"Spinning Blades Style" DEF {
            RANK 2
            ACTIVATION "When you make a Martial Arts [Melee] or Martial Arts [Unarmed] Attack action check, if you have a second readied weapon you did not use for the attack, you may spend (op):"
            OPPORTUNITIES {
                "+(op): You must spend (op) equal to your target's Vigilance to activate this technique. You use your second readied weapon against one target, inflicting physical damage equal to its base damage. If that target is ^\"Dazed\", increase this damage by your ranks in the skill you used."
            }
        }

        #TDaxHcpqi8jUnrYRVlwRvw ^"Thunderclap Strike" DEF {
            RANK 3
            ACTIVATION "As an Attack action using a readied weapon, make a TN 3 Martial Arts [Melee or Unarmed] (Air) check targeting each character within weapon's range."
            EFFECTS {
                "If you succeed, each target suffers damage equal to weapon's base damage and must resist with a TN 3 ^\"Fitness\" check (Earth 4, Fire 1) or move 2 range bands directly away from you."
            }
            OPPORTUNITIES {
                "Air +(op): Increase the TN of checks to resist the effect by 1 per (op) spent this way."
            }
        }

        #pOE9DqbbvjfCiSiduASFrC ^"Veiled Menace Style" DEF {
            RANK 2
            ACTIVATION "When you make a Martial Arts [Melee] or Martial Arts [Unarmed] Attack action check using a weapon in a one-handed grip, you may spend (op):"
            OPPORTUNITIES {
                "+(op): If you succeed, choose one unaware or ^\"Disoriented\" target. That target suffers a ^\"Critical Strike\" with severity equal to weapon's deadliness plus 1 per (op) spent this way beyond the first."
            }
        }

        # ==================
        # RANGED COMBAT KATA
        # ==================

        # Performed with Martial Arts [Ranged] weapons.

        #fuDZ0k1PlVOEZVJ8niH54T ^"Hawk's Precision" DEF {
            RANK 1
            ACTIVATION "When you make a Martial Arts [Ranged] check, you may spend (op):"
            OPPORTUNITIES {
                "+(op): Treat the range of the weapon as 1 higher per (op) spent this way, to a maximum of range 6."
            }
        }

        #UZRVsXt9NvfcLaP9vLkNa1 ^"Pelting Hail Style" DEF {
            RANK 2
            ACTIVATION "When you make a Martial Arts [Ranged] check, you may spend (op):"
            OPPORTUNITIES {
                "+(op): Choose a number of other characters at range 0-2 of your target equal to (op) spent this way. Each chosen character receives strife equal to the base damage of your weapon."
            }
        }

        #P8W484mPIMuuLOSBVsO9Fn ^"Pin the Fan" DEF {
            RANK 5
            ACTIVATION "As an Attack and Movement action using a readied ranged weapon, make a Martial Arts [Ranged] check targeting one character within weapon's range. TN equals the target's vigilance plus the range of the attack."
            EFFECTS {
                "If you succeed, target suffers damage equal to two times the weapon's base damage plus bonus successes."
            }
            OPPORTUNITIES {
                "(op): If the target becomes ^\"Incapacitated\" as a result of damage from this action, they suffer a ^\"Critical Strike\" with severity equal to two times the weapon's deadliness plus bonus successes."
            }
        }

        RULES {
            #L5R303hI5jK7lM9nO1pQ3r: kata_form_classifications
            #L5R304sT6uV8wX0yZ2aB4c: kata_activated_in_combat
        }
    }

    # ===========================
    # KIHŌ (kihō) — MONASTIC TECHNIQUES
    # ===========================

    ^"Kihō" DEF {
        ALIAS "Kiho"
        APPLIES TO [^"Samurai", ^"Adversary"]

        # Kihō are philosophical and spiritual techniques for aligning
        # one's inner energy — ki — to that of the wider cosmos. This
        # allows monks and other seekers of Enlightenment to act in
        # harmony with the universe's natural course, tapping into its
        # limitless potential. Kihō are new actions with two parts.
        #
        # Symbol: (kihō)
        # Available to: Schools listing Kihō in technique groups (monks)

        # Kihō have elemental classifications (Air, Earth, Fire, Water, Void).

        STRUCTURE {
            ^"Enhancement" "Persistent effect that lasts until the character chooses to end it, successfully activates another kihō, or the scene ends. Usually goes undetected by untrained onlookers."
            ^"Burst" "Resolves immediately if the user has the requisite number of bonus successes. Generally much more visible (gouts of flame, rumbling earth, gusts of air)."
        }

        # A character can have only one kihō enhancement at a time and
        # cannot reactivate a kihō if currently benefiting from its enhancement.
        # Only characters with school ranks in a school listing kihō can purchase them.

        # ==================
        # EARTH KIHŌ
        # ==================

        # Focus on securing one's roots, feeling vibrations, and waiting
        # for the right moment to strike.

        #krwQclUIQMQy7qHb1lnnUT ^"Cleansing Spirit" DEF {
            RANK 1
            ACTIVATION "As a Support action, make a TN 1 Theology (Earth) check. You may choose one other character at range 0-1 as the target for the burst effect."
            ENHANCEMENT "Reduce the TN of all your checks to resist poison, disease, ^\"Mahō\", the ^\"Defiled\" terrain quality, and the effects of Otherworldly and Tainted beings by your Earth Ring."
            BURST "2+ bonus successes: Remove one of the following conditions from your target: ^\"Afflicted\", ^\"Bleeding\", ^\"Dazed\", ^\"Disoriented\", ^\"Dying\", Fatigued, or ^\"Intoxicated\"."
        }

        #wipC0ms8dqRk9zuBoXaerX ^"Earth Needs No Eyes" DEF {
            RANK 1
