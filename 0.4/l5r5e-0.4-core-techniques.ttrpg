BASE "L5R5e_Core_Techniques" {
    NAME "Legend of the Five Rings 5th Edition - Technique types, categories, and core technique definitions"
    VERSION "0.4.4"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-03-01"

    # Core Rulebook: All technique types and their mechanics.
    # Techniques are special abilities purchased with XP and unlocked
    # through school curriculum advancement. Each has a type, rank,
    # activation method, and associated ring/skill.

    # ===========================
    # TECHNIQUE FRAMEWORK
    # ===========================

    #L5R350fG9hI1jK3lM5nO7p ^"Technique" DEF {
        APPLIES TO [^"Samurai", ^"Adversary"]

        # Techniques are special abilities that represent advanced training.
        # They enable a character to perform feats more quickly or in a
        # unique way, or to exploit opportunities others would overlook.

        # --- CATEGORY ---
        # Each character is granted access to technique categories by their
        # ^"School". The categories are:

        CATEGORY ENUM ["Kata", "Kihō", "Invocation", "Ritual", "Shūji", "Mahō", "Ninjutsu"]
        # Additional categories from sourcebooks: Inversion, Mantra

        # --- NAME ---
        # Each technique has a name, though different schools may describe
        # similar tactics differently. Some techniques (especially invocations)
        # have an "Other Names" field. Players are encouraged to use them
        # to underscore the unique traditions of individual schools.

        # --- PREREQUISITES ---
        # School ranks, clan affiliations, role/schools, ring values, skill
        # ranks, other techniques, or other qualifiers required to purchase
        # a technique with experience.
        #
        # Prerequisites are WAIVED if:
        # - A character is directly granted a technique during character
        #   creation (or at another time), OR
        # - The technique appears on the character's curriculum by name or
        #   as part of a listed group (e.g. "Rank 1-3 Kata").
        #
        # Such techniques and groups are marked with = to denote their
        # special status. If a character does not choose a technique to
        # which they have special access, or advances past the school rank
        # that enables them to buy it without purchasing it, they LOSE
        # their special access and can no longer purchase it at reduced cost.

        # --- XP COST ---
        # All techniques cost 3 XP to purchase. If a technique costs a
        # different amount, it is listed in the entry.

        # --- ACTIVATION ---
        # Each technique specifies when and how it can be used. The
        # activation generally includes some or all of the following:
        ACTIVATION_COMPONENTS {
            #V7IwVF3r66mCKeFefueKuT ^"Use" DEF {
                "As an Action: Character must perform an action during a conflict scene. If the action lists one or more types, it possesses each of those types."
                "As a Downtime Activity: Character must spend a downtime scene to attempt the task."
                "When Making a Check: Character can activate only during checks using the specified skill, skill group, ring, or combination. Usually requires spending (op)."
            }
            ^"Check" "If activation requires an action or downtime scene, it generally requires a separate check with a specified TN. If no ring is specified, any ring may be used (e.g. the one matching current stance in conflict). If a skill group is listed, the character chooses any skill from that group."
            ^"Targets" "Characters, positions, or objects affected. When a character has a choice of multiple possible targets, they must choose from among the valid targets."
            ^"Range" "Specified as 'at range [number]', 'at range [number]-[number]', 'in range of your weapon', or similar. Targets beyond the specified range are not affected."
            ^"Other Requirements" "Circumstantial requirements such as 'using a readied weapon', 'under the full moon', or 'while on ^\"Hallowed\" ground'."
        }

        # --- EFFECTS ---
        # Each technique lists effects that occur after activation. Each
        # paragraph represents a distinct effect.
        #
        # - "If you succeed" effects only resolve on successful check.
        # - "If you fail" effects only resolve on failed check.
        # - Effects with alternate conditions resolve under stated conditions.
        # - Effects with no conditions always resolve.
        #
        # Persistent Effects: Some effects persist for a set duration
        # (e.g. "until the beginning of your next turn", "for one round
        # plus additional rounds equal to your bonus successes", "until
        # the end of the scene"). A character cannot benefit (or suffer)
        # from more than one instance of the same persistent effect, even
        # from multiple sources. If overlapping: player chooses if beneficial,
        # GM chooses if harmful.

        # --- NEW OPPORTUNITIES ---
        # Many techniques list one or more uses of (op) specific to the
        # check. Some are preceded by a ring requirement (e.g. "Air (op)")
        # meaning the character can only spend (op) this way if they used
        # that ring for the check.

        PROPERTIES {
            ^"Name" STRING REQUIRED
            ^"Category" STRING  # References category ENUM above
            ^"Rank" INTEGER MIN 1 MAX 5
            ^"Prerequisites" STRING  # School rank, ring values, clan, etc.
            ^"XP Cost" INTEGER DEFAULT 3
            ^"Activation" STRING  # Use, Check, Targets, Range, Other Requirements
            ^"Description" STRING  # Narrative description (no mechanical effect)
            ^"Effects" STRING  # Mechanical effects with conditional resolution
            ^"New Opportunities" STRING  # Technique-specific (op) spends
        }

        RULES {
            #L5R300aB2cD4eF6gH8iJ0k: technique_categories_granted_by_school
            #L5R301lM3nO5pQ7rS9tU1v: prerequisites_waived_for_curriculum
            #L5R301aM3nO5pQ7rS9tU2w: lose_special_access_if_skipped
            #L5R302wX4yZ6aB8cD0eF2g: all_techniques_cost_3xp_unless_noted
            #L5R302aX4yZ6aB8cD0eF3h: persistent_effects_do_not_stack
        }
    }

    # ===========================
    # KATA (kata) — MARTIAL TECHNIQUES
    # ===========================

    ^"Kata" DEF {
        APPLIES TO [^"Samurai", ^"Adversary"]

        # Kata are specialized combat techniques that allow martial artists
        # to vanquish even foes who exceed them in physical strength, speed,
        # or agility. Some kata are new actions, while others grant new ways
        # to spend (op).
        #
        # Symbol: (kata)
        # Available to: Schools listing Kata in technique groups

        # Kata have form classifications:
        FORM_CLASSIFICATIONS {
            "General" "Available to any character with kata access"
            "Close Combat" "Melee weapon techniques"
            "Ranged Combat" "Bow and ranged weapon techniques"
        }

        # ==================
        # GENERAL KATA
        # ==================

        #T9POwkfZWkuZvYQv83o8Ab ^"Battle in the Mind" DEF {
            RANK 3
            DESCRIPTION "As two masters of any martial art square off before a duel, each seeks to predict the other’s angle of attack and strategy, and the ways their predictions might be foiled by the opponent’s."
            ACTIVATION "When you make an ^\"Initiative\" check for a ^\"Duel\" using your Void Ring, you may spend (op):"
            OPPORTUNITIES {
                "Void (op): You name two rings, then your opponent must name one. When your opponent selects their stance during their first turn, they cannot select the ring they named."
                "Void +(op): Choose a technique category. Learn one of your opponent's known techniques of that category (chosen by opponent) per (op) spent this way."
            }
        }

        #oddkoaxIyd7JQiywOXHmBX ^"Breath of Wind Style" DEF {
            RANK 4
            DESCRIPTION "A swift strike to the solar plexus or throat can leave the target reeling; an experienced bushi can steal the breath from their foe with a quick jab even while executing another attack."
            ACTIVATION "When you make a Martial Arts [Melee, Ranged, or Unarmed] (Air) check, you may spend (op):"
            OPPORTUNITIES {
                "Air +(op): One target must resist with a TN 3 ^\"Fitness\" check (Earth 4, Fire 1) or suffer ^\"Disoriented\" and fatigue equal to their shortfall. Increase the TN to resist by 1 per (op) spent this way."
            }
        }

        #YHt6EVGbAa1u7vArotHqOh ^"Crashing Wave Style" DEF {
            RANK 4
            DESCRIPTION "The wave washes over the stone, wearing it away, and so the bushi’s weapon passes across their foe’s flesh, leaving behind a bloody gash or slice that is sure to slow their enemy even if the hit is not fatal."
            ACTIVATION "When you make a Martial Arts [Melee, Ranged, or Unarmed] (Water) check, you may spend (op):"
            OPPORTUNITIES {
                "Water +(op): One target must resist with a TN 3 ^\"Fitness\" check (Earth 1, Fire 4) or suffer ^\"Bleeding\" and fatigue equal to their shortfall. Increase the TN to resist by 1 per (op) spent this way."
            }
        }

        #l2wYxPgu8jTyj5EdSlvmOM ^"Crescent Moon Style" DEF {
            RANK 2
            DESCRIPTION "Striking first is valuable, but so is surviving. To defend without sacrificing offense, a bushi must be ready to retaliate swiftly after blocking or evading. With a quick shift, the bushi switches from defense to bring down their full force upon their enemy."
            ACTIVATION "When you perform Guard action, you may spend (op):"
            OPPORTUNITIES {
                "(op): After a character at range 1-2 performs an Attack action targeting you or another character you are guarding, you may perform a Strike action with one readied Martial Arts [Melee or Unarmed] weapon targeting that character (if within weapon's range). Persists until start of your next turn, or until you perform a Strike action this way."
            }
        }

        #afQfncH9y7kre1RoUTqtma ^"Crimson Leaves Strike" DEF {
            RANK 3
            DESCRIPTION "Sweeping their blade down in a sudden arc, the bushi lands a blow atop the enemy’s weapon, scattering it from their hand like falling leaves."
            ACTIVATION "As an Attack action using a readied weapon, make a TN 4 Martial Arts (Earth) check targeting one character within weapon's range."
            EFFECTS {
                "If you succeed, target suffers physical damage equal to your Earth Ring plus bonus successes. Choose one of target's readied weapons; target must resist with a TN 4 ^\"Fitness\" check (Air 2, Water 5) or lose control of the chosen weapon, which travels 3 range bands in a direction of your choice."
            }
            OPPORTUNITIES {
                "Earth (op): If you disarm your opponent, you may take control of their weapon instead of knocking it away."
            }
        }

        #CiESopm2EvTr90r7JRDN8f ^"Disappearing World Style" DEF {
            RANK 4
            DESCRIPTION "Seeing nothing but their enemy, the bushi surges forward in a flurry of strikes, seeking to land a hit to the eyes, temple, or other vulnerable area rapidly after their initial attack. This stunning blow can leave the enemy staggered, giving the bushi a chance to finish the battle with their next attack."
            ACTIVATION "When you make a Martial Arts [Melee, Ranged, or Unarmed] (Fire) check, you may spend (op):"
            OPPORTUNITIES {
                "Fire +(op): One target must resist with a TN 3 ^\"Fitness\" check (Air 4, Water 1) or suffer ^\"Dazed\" and fatigue equal to their shortfall. Increase the TN to resist by 1 per (op) spent this way."
            }
        }

        #bWzTE8wFpDe2NVPUtMENyC ^"Flowing Water Strike" DEF {
            RANK 3
            DESCRIPTION "A skilled warrior is not restricted by the optimal range of their weapon, and can open or close gaps to compensate for positional disadvantages."
            ACTIVATION "As an Attack and Movement action using a readied weapon, make a TN 3 Martial Arts (Water) check targeting one character at range 0-2 (regardless of weapon's usual range restrictions)."
            EFFECTS {
                "If you succeed, the target suffers physical damage equal to your Water Ring and suffers ^\"Bleeding\". Target must resist with a TN 4 ^\"Fitness\" check (Earth 2, Fire 5); if they fail, increase the physical damage by your weapon's base damage."
            }
            OPPORTUNITIES {
                "Water (op): Remove ^\"Dazed\", ^\"Disoriented\", ^\"Immobilized\", or ^\"Prone\" from yourself."
            }
        }

        #TklHzFuxZjRGJun08NB32d ^"Heartpiercing Strike" DEF {
            RANK 3
            DESCRIPTION "Battle is the art of killing, and woe betide any warrior who forgets it. With a roar, the bushi launches forward, stabbing out with their weapon to fatally impale their enemy. Even if the strike does not slay the foe, it is likely to weaken them significantly."
            ACTIVATION "As an Attack and Movement action using a readied weapon, make a TN 4 Martial Arts (Fire) check targeting one character within weapon's range."
            EFFECTS {
                "If you succeed, target suffers a ^\"Critical Strike\" with severity equal to weapon's deadliness plus bonus successes. The TN of the ^\"Fitness\" check to resist is 3 (Air 4, Water 1) instead of the normal TN."
                "If you fail, you suffer ^\"Disoriented\"."
            }
            OPPORTUNITIES {
                "Fire (op): Before resolving the effect, move up to 1 range band toward your target."
            }
        }

        #PplJyuuwlkxQFj7Q3h8OoD ^"Iron in the Mountains Style" DEF {
            RANK 4
            DESCRIPTION "The bushi strikes with crushing force, breaking their enemy’s footing and knocking them to the ground with an overwhelming blow or sweeping their stance out from underneath them with a well-placed kick."
            ACTIVATION "When you make a Martial Arts [Melee, Ranged, or Unarmed] (Earth) check, you may spend (op):"
            OPPORTUNITIES {
                "Earth +(op): One target must resist with a TN 3 ^\"Fitness\" check (Air 1, Water 4) or suffer ^\"Prone\" and fatigue equal to their shortfall. Increase the TN to resist by 1 per (op) spent this way."
            }
        }

        #VZRaBoZ23jv6pba1NYHPZz ^"Lord Hida's Grip" DEF {
            RANK 2
            DESCRIPTION "The Kami Hida, patron of the Crab Clan, was a legendary slayer of monsters. He beheaded the massive demon that once menaced the rose-marble palace, and ripped out one skull of the two-headed Kabuto no Oni and crushed the other head with it. However, Hida was no mere brute: he was cunning, killing monsters by exploiting their weaknesses. Warriors of the Crab Clan train in similar techniques. They turn their foes' great weight against them by pinning or strategically damaging specific body parts."
            PREREQUISITES "Crab Clan"
            ACTIVATION "As an Attack action, make a ^\"Fitness\" (Void) check targeting one creature of ^\"Silhouette\" 3 or larger at range 0-1. TN equals the target's silhouette (minimum 1)."
            EFFECTS {
                "If you succeed, target suffers ^\"Immobilized\"."
                "If you succeed, you count as granting ^\"Assistance\" to all characters who perform Attack actions against your target. Persists until beginning of your next turn."
            }
            OPPORTUNITIES {
                "Void (op): Target must resist with a ^\"Fitness\" check or suffer physical damage equal to its silhouette (ignoring resistance) and ^\"Prone\". TN of this check equals your school rank."
            }
        }

        #FpFKDUlzB1l3h8wu1zEcIH ^"Lord Shiba's Valor" DEF {
            RANK 2
            DESCRIPTION "Once, in the Shadowlands, the Kami Shiba stood alone between a vast horde of its foul denizens and the last of the Seven Thunders after their victory against Fu Leng. Drawing the legendary sword Ofushikai, Shiba cut his way through the host to the First Oni. Legends say that their blades flashed for a hundred days, shattering mountains around them and cutting great rifts across the ground. In the end, each slew the other, but Shiba fell with his oath to protect unbroken."
            PREREQUISITES "Phoenix Clan"
            ACTIVATION "Once per game session, as a Support action using one readied weapon, make a TN 2 Tactics (Void) check targeting any number of friendly characters in range of your weapon."
            EFFECTS {
                "If you succeed, other characters cannot select your targets as the targets of their Attack or Scheme actions if they could select you instead. If an action has multiple targets, you must be the first target chosen. Persists for a number of rounds equal to your school rank."
            }
            OPPORTUNITIES {
                "Void (op): If you succeed, increase the TN of Attack and Scheme checks targeting you by 1. Persists until end of your next turn."
            }
        }

        #UflzaeVG3sMdnX2D8WpBmM ^"Soaring Slice" DEF {
            RANK 1
            DESCRIPTION "Jerking their arm in a sudden motion, the bushi hurls their weapon at the enemy, hoping to take the foe off guard or open a gap in their defenses."
            ACTIVATION "As an Attack action using one readied weapon in a one-handed grip, make a TN 2 Martial Arts check targeting one character at range 2-3."
            EFFECTS {
                "You hurl your weapon at the target."
                "If you succeed, deal physical damage equal to the weapon's base damage plus bonus successes. Weapon lands at range in a direction of your choice from target if they defend, or embeds in them if they suffer a ^\"Critical Strike\"."
                "If you fail, weapon travels range bands equal to the maximum range of the technique in the direction of the target."
            }
            OPPORTUNITIES {
                "+(op): Treat the maximum range of this technique as 1 higher per (op) spent this way."
                "(op): Reduce the TN of the next Attack action against the target before end of your next turn by 1."
            }
        }

        #fqgySMrDkB4hMONSWX3ma5 ^"Soul Sunder" DEF {
            RANK 5
            DESCRIPTION "While bushi are generally less well equipped to deal with supernatural threats than shugenja, mastery of any art reveals how the world is all interconnected. Warriors deeply engaged with the mysteries of the sword can attune themselves to their ancestral blades to cut even those beings who walk between worlds and whose flesh steel normally will not bite."
            ACTIVATION "As a Support action, make a TN 4 ^\"Meditation\" (Void) check to attune your blade to the spirits of your honored ancestors."
            EFFECTS {
                "If you succeed, choose one readied weapon. It gains the ^\"Sacred\" quality, and when you use it to inflict a ^\"Critical Strike\" on an Otherworldly being, treat its deadliness as increased by your bonus successes. Persists until end of your next turn."
            }
            OPPORTUNITIES {
                "Void +(op): This effect persists for one additional round per (op) spent this way."
                "Void (op)(op): Otherworldly beings cannot perform Attack actions targeting you until start of your next turn."
                "Void (op)(op)(op): You may immediately perform a Strike action using your readied weapon."
            }
        }

        #1hQUQrjYJXEBabs23ddxXh ^"Striking as Air" DEF {
            RANK 1
            DESCRIPTION "Not every stroke a warrior throws in battle is intended to kill—even if they all lead to that end goal. A skilled fighter can tell when an attack will not land and subtly shift it into a different sort of attack, meant to probe the enemy’s defenses or draw their guard out of position. By carefully placing attack after attack, a master of the blade can eventually whittle down their opponent’s options until none remain but death."
            ACTIVATION "When you make a Martial Arts [Melee, Ranged, or Unarmed] (Air) check, you may spend (op):"
            OPPORTUNITIES {
                "Air +(op): Reserve one of your rolled dice, plus one additional die per (op) spent this way. These become dropped dice. When making a check with the same skill before end of your next turn, you may roll one fewer (skill) per reserved (skill) and one fewer (ring) per reserved (ring), then add the reserved dice set to their original results. They count as rolled dice."
            }
        }

        #U5Y9ZuMONlY5eu2449bcxS ^"Striking as Earth" DEF {
            RANK 1
            DESCRIPTION "After striking, the bushi roots themself to the ground, hunkering down to make sure their armor takes the brunt of a hit or raising a weapon in a warding position where it can deflect harm without being damaged."
            ACTIVATION "When you make a Martial Arts [Melee, Ranged, or Unarmed] (Earth) check, you may spend (op):"
            OPPORTUNITIES {
                "Earth +(op): Treat your physical resistance as 1 higher per (op) spent this way until beginning of your next turn."
            }
        }

        #RmhsIc0PPNoVYKsaRR08By ^"Striking as Fire" DEF {
            RANK 1
            DESCRIPTION "Victory cannot be achieved through defense alone, and it is a poor student of the sword who forgets that their most important goal is simple: cut down their enemy. All else fades to the background as the bushi fiercely presses the attack, trying to force an error or open an opportunity to end their foe."
            ACTIVATION "When you make a Martial Arts [Melee, Ranged, or Unarmed] (Fire) Attack action check, you may spend (op):"
            OPPORTUNITIES {
                "Fire +(op): The next time your target suffers a ^\"Critical Strike\", increase its severity by 1 per (op) spent this way. Persists until end of your next turn."
            }
        }

        #JPTU0vOXmQbL7sBmJ5XWTn ^"Striking as Void" DEF {
            RANK 5
            DESCRIPTION "The future is part of Void’s domain, infinite in possibility and unfathomable in depth. Because of its formlessness, one cannot scheme to undermine the uncertain future—but the instant it takes shape, an action is vulnerable to countermeasures. The bushi rests until the last possible second, allowing the potential energy of their strike to take shape only after it is too late for their enemy to respond."
            ACTIVATION "When you make a Martial Arts [Melee, Ranged, or Unarmed] (Void) check, you may spend (op):"
            OPPORTUNITIES {
                "Void (op): Immediately switch to a different stance of your choice."
                "Void (op): If you fail, you may perform another action. This must be an action you have not yet performed this turn. You can only activate this opportunity once per round."
            }
        }

        #AKclPTcck4JeiWjmkYgZuF ^"Striking as Water" DEF {
            RANK 1
            DESCRIPTION "The finest armor is useless if a warrior can bypass it, slipping a blade through the gaps that allow the wearer to move or using blunt, concussive force to create a space. As the bushi strikes, they attempt to slide past the target’s defenses to deliver a lethal blow."
            ACTIVATION "When you make a Martial Arts [Melee, Ranged, or Unarmed] (Water) Attack action check, you may spend (op):"
            OPPORTUNITIES {
                "Water +(op): Your target treats their physical resistance as 1 lower per (op) spent this way. Persists until end of your next turn."
            }
        }

        #UskyyuB3xgSuYTawcQK1cn ^"Tactical Assessment" DEF {
            RANK 2
            DESCRIPTION "Akodo’s Leadership and Bayushi’s Lies agree on a few topics, for both leaders were practical to a certain degree, even if Akodo famously scorned many of Bayushi’s methods. As the scholar Hida Fuyuko noted in her revelatory commentary on Leadership’s lessons for commanders on the Kaiu Wall, the most famous meeting of these two minds comes on the matter of preparation: battles are not won in the field, but in the leadup to the conflict. Even in small clashes, the warrior who better understands the terrain, the strength of their own forces, and the composition of the enemy’s troops is usually victorious."
            ACTIVATION "When you make an ^\"Initiative\" check, you may spend (op):"
            OPPORTUNITIES {
                "Air (op): Choose an enemy. Learn one of their advantages (their choice) and their physical or supernatural resistance (your choice)."
                "Earth (op): Choose a character. They do not apply any of their disadvantages to their checks until end of their first turn."
                "Water (op): Choose a piece of ^\"Terrain\". Until start of your first turn, it counts as having the ^\"Obscuring\" quality for Attack action checks targeting you and your allies."
                "Fire (op): Choose a character and one of their advantages you know. Until end of their first turn, they apply that advantage to all of their checks."
            }
        }

        #CxCHlu7u5FjgSZVJVo0N4x ^"Warrior's Resolve" DEF {
            RANK 1
            DESCRIPTION "The bushi draws a deep breath, exhaling as they rise to their feet. Pain can be conquered as long as there is a duty to be done. Honor is stronger than steel, it is said, and it falls to the samurai to prove it."
            ACTIVATION "Once per scene, as a Support action, you may spend 1 ^\"Void Points\" to recover."
            EFFECTS {
                "Remove fatigue equal to your ^\"Honor\" rank."
            }
        }

        # ==================
        # CLOSE COMBAT KATA
        # ==================

        # Performed with Martial Arts [Melee] or Martial Arts [Unarmed] weapons.

        #i05F04V9dqXMYX8JbjixhJ ^"Coiling Serpent Style" DEF {
            RANK 2
            DESCRIPTION "Entrapping techniques can be performed with many different weapons, from the kusari-gama wielded by brigands to the ornate, hook-headed polearms used by the Phoenix Clan’s greatest masters of the spear."
            ACTIVATION "When you make a Martial Arts [Melee] or Martial Arts [Unarmed] check using a ^\"Snaring\" weapon, you may spend (op):"
            OPPORTUNITIES {
                "+(op): Choose one weapon a target has readied; that weapon cannot be used for Attack actions. Persists until end of your next turn."
                "(op) +(op): One target of your action per (op) spent this way becomes ^\"Immobilized\"."
            }
        }

        #2tXet8vVinnG7L7B32pbGY ^"Iaijutsu Cut: Crossing Blade" DEF {
            RANK 2
            DESCRIPTION "The bushi twists their scabbard outward as they draw, The bushi grips their scabbard against their hip and cutting horizontally to extend their reach. draws, cutting upward to catch an advancing foe without being cut themself."
            ACTIVATION "As an Attack and Movement action using one sheathed ^\"Razor-Edged\" weapon, make a TN 2 Martial Arts [Melee] check targeting one character at range 1-2."
            EFFECTS {
                "You draw and ready the sheathed weapon in a one-handed grip."
                "If you succeed, deal physical damage equal to the weapon's deadliness plus bonus successes."
            }
            OPPORTUNITIES {
                "(op): Ready one other sheathed Razor-Edged weapon."
            }
        }

        #qvjQa6mLVO7fM30Hyv4a6x ^"Iaijutsu Cut: Rising Blade" DEF {
            RANK 2
            DESCRIPTION "The bushi grips their scabbard against their hip and draws, cutting upward to catch an advancing foe without being cut themself."
            ACTIVATION "As an Attack action using one sheathed ^\"Razor-Edged\" weapon, make a TN 3 Martial Arts [Melee] check targeting one character at range 0-1."
            EFFECTS {
                "You draw and ready the sheathed weapon in a one-handed grip."
                "If you succeed, deal physical damage equal to the weapon's deadliness. Target cannot defend against this damage if they are ^\"Compromised\"."
            }
            OPPORTUNITIES {
                "(op): Ready one other sheathed Razor-Edged weapon."
            }
        }

        #nlPPHaS22Qi6bGH9PdPF7G ^"Iron Forest Style" DEF {
            RANK 2
            DESCRIPTION "A bushi versed in the spear can control their spacing with their opponent, forcing their foe to risk impalement each time they advance or catching loose clothes or stray body parts on the head of the weapon. Akodo’s Leadership refers to such a technique as the Iron Forest style, which turns the length of a single spear into an insurmountable distance."
            ACTIVATION "When you make a Martial Arts [Melee] check using a polearm, you may spend (op):"
            OPPORTUNITIES {
                "+(op): The area in range of your weapon counts as ^\"Dangerous\" terrain for one target per (op) spent this way. When an affected character attempts to move closer to you, they must make a TN 4 ^\"Fitness\" check (Air 2, Water 5); if they fail, they cannot advance. Persists until start of your next turn."
            }
        }

        #zVzvM0KFizf2Zk0Dl66npx ^"Open-Hand Style" DEF {
            RANK 2
            DESCRIPTION "Power does not come from speed alone. A master martial artist can apply force for maximum effect, making even gentle movements devastatingly effective blocks and strikes. With enough experience, a martial artist can even control their opponent’s stance."
            ACTIVATION "When you make a Martial Arts [Unarmed] check using a weapon with the ^\"Snaring\" quality, you may spend (op):"
            OPPORTUNITIES {
                "(op) +(op): One target per (op) spent this way must switch to a different stance of your choice. Targets of ^\"Silhouette\" 3 or greater may resist with a TN 3 ^\"Fitness\" check and ignore this effect if they succeed."
            }
        }

        #mbd9b1u2gOkuihy6u4a1OD ^"Rushing Avalanche Style" DEF {
            RANK 2
            DESCRIPTION "When adopting this style, the bushi strikes with reckless abandon using a heavy armament. Thanks to the sheer weight of their weapon and the ferocity of their strikes, even a glancing blow can cause serious harm, and a telling blow usually ends the battle."
            ACTIVATION "When you make a Martial Arts [Melee] check using a blunt weapon, you may spend (op):"
            OPPORTUNITIES {
                "(op): If you fail with a shortfall of two or less, your target suffers physical damage equal to your ranks in ^\"Fitness\"."
                "(op): If you succeed and your target is ^\"Prone\", increase the damage you deal by your ranks in Fitness."
            }
        }

        #gRerY2G6BTUOWgV93Cb9pv ^"Spinning Blades Style" DEF {
            RANK 2
            DESCRIPTION "The biggest advantage of dual wielding does not usually stem from striking with two weapons simultaneously, largely because this is a very difficult feat. Instead, it comes from the fact that the warrior does not need to sacrifice defense while attacking or offense while defending. The off-hand blade can deflect and threaten even as the main-hand weapon attacks, or the bushi can strike with the offhand weapon while the main-hand weapon is locked with the foe’s blade. Either weapon can deliver death, and so the enemy must watch both at all times."
            ACTIVATION "When you make a Martial Arts [Melee] or Martial Arts [Unarmed] Attack action check, if you have a second readied weapon you did not use for the attack, you may spend (op):"
            OPPORTUNITIES {
                "+(op): You must spend (op) equal to your target's Vigilance to activate this technique. You use your second readied weapon against one target, inflicting physical damage equal to its base damage. If that target is ^\"Dazed\", increase this damage by your ranks in the skill you used."
            }
        }

        #TDaxHcpqi8jUnrYRVlwRvw ^"Thunderclap Strike" DEF {
            RANK 3
            DESCRIPTION "Sweeping their weapon in a wide arc, the bushi lashes out at their foes, driving them back to make an opening for their next move."
            ACTIVATION "As an Attack action using a readied weapon, make a TN 3 Martial Arts [Melee or Unarmed] (Air) check targeting each character within weapon's range."
            EFFECTS {
                "If you succeed, each target suffers damage equal to weapon's base damage and must resist with a TN 3 ^\"Fitness\" check (Earth 4, Fire 1) or move 2 range bands directly away from you."
            }
            OPPORTUNITIES {
                "Air +(op): Increase the TN of checks to resist the effect by 1 per (op) spent this way."
            }
        }

        #pOE9DqbbvjfCiSiduASFrC ^"Veiled Menace Style" DEF {
            RANK 2
            DESCRIPTION "Assassination and other clandestine tactics are frowned upon by many samurai. None can deny the effectiveness of such techniques, however. By drawing their enemy’s gaze away from the true threat, a bushi can often tip the scales against a strong foe."
            ACTIVATION "When you make a Martial Arts [Melee] or Martial Arts [Unarmed] Attack action check using a weapon in a one-handed grip, you may spend (op):"
            OPPORTUNITIES {
                "+(op): If you succeed, choose one unaware or ^\"Disoriented\" target. That target suffers a ^\"Critical Strike\" with severity equal to weapon's deadliness plus 1 per (op) spent this way beyond the first."
            }
        }

        # ==================
        # RANGED COMBAT KATA
        # ==================

        # Performed with Martial Arts [Ranged] weapons.

        #fuDZ0k1PlVOEZVJ8niH54T ^"Hawk's Precision" DEF {
            RANK 1
            DESCRIPTION "While most bushi are expected to be proficient in the use of the bow, some are terrifyingly accurate, capable of hitting targets well beyond the expected engagement range."
            ACTIVATION "When you make a Martial Arts [Ranged] check, you may spend (op):"
            OPPORTUNITIES {
                "+(op): Treat the range of the weapon as 1 higher per (op) spent this way, to a maximum of range 6."
            }
        }

        #UZRVsXt9NvfcLaP9vLkNa1 ^"Pelting Hail Style" DEF {
            RANK 2
            DESCRIPTION "A volley of arrows on the battlefield can be deadly, but most importantly from a strategic standpoint, it is terrifying to even the staunchest veterans. Even if only one in ten shots finds its mark, the salvo rattles opponents and forces caution."
            ACTIVATION "When you make a Martial Arts [Ranged] check, you may spend (op):"
            OPPORTUNITIES {
                "+(op): Choose a number of other characters at range 0-2 of your target equal to (op) spent this way. Each chosen character receives strife equal to the base damage of your weapon."
            }
        }

        #P8W484mPIMuuLOSBVsO9Fn ^"Pin the Fan" DEF {
            RANK 5
            DESCRIPTION "While it is difficult to kill at range with a single arrow, it can certainly be done, and master archers have been performing legendary feats of precision since the early days of Rokugan. From Hantei Genji’s famous shots to the arrow loosed by Doji Hotaru that slew Akodo Arasou, killing shots have often changed the course of the Emerald Empire’s history."
            ACTIVATION "As an Attack and Movement action using a readied ranged weapon, make a Martial Arts [Ranged] check targeting one character within weapon's range. TN equals the target's vigilance plus the range of the attack."
            EFFECTS {
                "If you succeed, target suffers damage equal to two times the weapon's base damage plus bonus successes."
            }
            OPPORTUNITIES {
                "(op): If the target becomes ^\"Incapacitated\" as a result of damage from this action, they suffer a ^\"Critical Strike\" with severity equal to two times the weapon's deadliness plus bonus successes."
            }
        }

        RULES {
            #L5R303hI5jK7lM9nO1pQ3r: kata_form_classifications
            #L5R304sT6uV8wX0yZ2aB4c: kata_activated_in_combat
        }
    }

    # ===========================
    # KIHŌ (kihō) — MONASTIC TECHNIQUES
    # ===========================

    ^"Kihō" DEF {
        ALIAS "Kiho"
        APPLIES TO [^"Samurai", ^"Adversary"]

        # Kihō are philosophical and spiritual techniques for aligning
        # one's inner energy — ki — to that of the wider cosmos. This
        # allows monks and other seekers of Enlightenment to act in
        # harmony with the universe's natural course, tapping into its
        # limitless potential. Kihō are new actions with two parts.
        #
        # Symbol: (kihō)
        # Available to: Schools listing Kihō in technique groups (monks)

        # Kihō have elemental classifications (Air, Earth, Fire, Water, Void).

        STRUCTURE {
            ^"Enhancement" "Persistent effect that lasts until the character chooses to end it, successfully activates another kihō, or the scene ends. Usually goes undetected by untrained onlookers."
            ^"Burst" "Resolves immediately if the user has the requisite number of bonus successes. Generally much more visible (gouts of flame, rumbling earth, gusts of air)."
        }

        # A character can have only one kihō enhancement at a time and
        # cannot reactivate a kihō if currently benefiting from its enhancement.
        # Only characters with school ranks in a school listing kihō can purchase them.

        # ==================
        # EARTH KIHŌ
        # ==================

        # Focus on securing one's roots, feeling vibrations, and waiting
        # for the right moment to strike.

        #krwQclUIQMQy7qHb1lnnUT ^"Cleansing Spirit" DEF {
            RANK 1
            DESCRIPTION "The monk centers their ki, then reaches out and touches another character, counterbalancing their turbulent energies with the stillness of the monk’s own soul. This restores the character’s spirit, driving out poison, disease, and even the grip of evil spirits, provided they have not yet taken root in the character’s soul."
            ACTIVATION "As a Support action, make a TN 1 Theology (Earth) check. You may choose one other character at range 0-1 as the target for the burst effect."
            ENHANCEMENT "Reduce the TN of all your checks to resist poison, disease, ^\"Mahō\", the ^\"Defiled\" terrain quality, and the effects of Otherworldly and Tainted beings by your Earth Ring."
            BURST "2+ bonus successes: Remove one of the following conditions from your target: ^\"Afflicted\", ^\"Bleeding\", ^\"Dazed\", ^\"Disoriented\", ^\"Dying\", Fatigued, or ^\"Intoxicated\"."
        }

        #wipC0ms8dqRk9zuBoXaerX ^"Earth Needs No Eyes" DEF {
            RANK 1
            DESCRIPTION "The monk who waits and listens sees much, even without eyes. Sending out waves of their own energy and letting the ki of the life around them flow back into their body through the ground, the monk feels the reverberations of everything moving nearby, from the thunderous breaths of a warrior in battle to the footsteps of the tiniest ants."
            ACTIVATION "As a Support action, make a TN 1 ^\"Meditation\" (Earth) check."
            ENHANCEMENT "You can use vibrations through the earth to 'see' a number of range bands in all directions equal to your Earth Ring. Increase your vigilance by your Earth Ring."
            BURST "3+ bonus successes: Instantly become aware of all living creatures and objects touching the ground within range bands equal to your Earth Ring plus bonus successes."
        }

        #3Fweudc4obifR4EbMZynk9 ^"Earthen Fist" DEF {
            RANK 1
            DESCRIPTION "Placing their hand on the ground, the monk draws forth the hardness of stone, pulling up clumps of rocky soil that coat their skin or invisibly reinforcing their bones and muscles with the durability of granite."
            ACTIVATION "As an Attack and Support action, make a TN 1 Martial Arts [Unarmed] (Earth) check. You may choose a character at range 0-1 as the target for the burst effect."
            ENHANCEMENT "Treat base damage of your unarmed ^\"Punch\" and ^\"Kick\" profiles as increased by your Earth Ring. Increase your physical resistance by 1."
            BURST "2+ bonus successes: Target suffers physical damage equal to your Earth Ring. Target must resist with a TN 4 ^\"Fitness\" check (Air 2, Water 5) or suffer ^\"Prone\"."
        }

        #gdgrtdGzSeWlHcjTk0NNIM ^"Grasp the Earth Dragon" DEF {
            RANK 3
            DESCRIPTION "Planting a foot on the ground and taking a wide stance, the monk stomps, sending reverberations of ki rushing down into the depths. An instant later, the monk’s body is filled with the resilience of bedrock; stones rise and orbit their body to deflect attacks, rocks adhere to their flesh forming rocky scales, or their flesh becomes as difficult to crack as granite."
            ACTIVATION "As a Movement and Support action, make a TN 2 ^\"Meditation\" (Earth) check."
            ENHANCEMENT "Reduce severity of all ^\"Critical Strike\" from physical sources by your Earth Ring. After a character performs an Attack action against you, you may spend 1 ^\"Void Points\" to cause them to suffer fatigue equal to your ranks in ^\"Fitness\"."
            BURST "3+ bonus successes: Reduce all physical damage you suffer to 1. After any character deals physical damage to you, they suffer ^\"Prone\". Persists until end of your next turn."
        }

        #XsMsGJPrheajJUvflEzzag ^"Way of the Earthquake" DEF {
            RANK 2
            DESCRIPTION "The monk slams a hand or foot into the ground, and the earth itself shudders under the weight of the blow as their ki rushes through the soil. Nearby enemies are hurled to the ground and find it shifting treacherously underneath them as they struggle to rise."
            ACTIVATION "As an Attack and Support action, make a TN 2 Martial Arts [Unarmed] (Earth) check. You may choose any number of other characters at range 0-1 as targets for the burst effect."
            ENHANCEMENT "After you perform an Attack or Support action, or defend against damage, you may choose one other character at range 0-2 who must resist with a TN 4 ^\"Fitness\" check (Air 2, Water 5) or suffer physical damage equal to your Earth Ring and ^\"Prone\"."
            BURST "2+ bonus successes: Each target suffers physical damage equal to your Earth Ring. Each ^\"Prone\" target suffers physical damage equal to your Earth Ring plus bonus successes and ^\"Immobilized\" instead."
        }

        # ==================
        # AIR KIHŌ
        # ==================

        # Center on hearing the whispers of the world and understanding
        # their meaning. To align one's ki with air is to detach from
        # earthly desires, becoming untethered from the world.

        #pWKnSQA7eqbEEBJ1SWdn28 ^"Air Fist" DEF {
            RANK 1
            DESCRIPTION "The monk swirls their hands in an intricate pattern, channeling their ki into the air and turning even a placid breeze into a funnel of roaring wind. A gale follows the monk’s strikes, hurling foes back and slamming them against intervening objects."
            ACTIVATION "As an Attack and Support action, make a TN 1 Martial Arts [Unarmed] (Air) check. You may choose one other character at range 0-1 as the target for the burst effect."
            ENHANCEMENT "Treat the maximum range of your ^\"Punch\" and ^\"Kick\" unarmed profiles as equal to your Air Ring."
            BURST "2+ bonus successes: Target suffers physical damage equal to your Air Ring. Target must make a TN 4 ^\"Fitness\" check (Earth 5, Fire 2) or be pushed 1 range band away from you, plus range bands equal to their shortfall."
        }

        #vOpIPIgApjNJyCQtOvqKYq ^"The Great Silence" DEF {
            RANK 1
            DESCRIPTION "The monk swirls their hands in a spiral, pulling noise inward and stealing even the reverberations that sounds make through the air. Lies die on the lips unspoken, and prayers never reach the spirits for whom they were intended. Skilled practitioners often maintain this technique, twisting the wind around them to steal away pernicious words and wicked prayers alike."
            ACTIVATION "As a Scheme and Support action, make a TN 1 Theology (Air) check."
            ENHANCEMENT "Increase the TN of Scheme action checks targeting you by one plus your ranks in Command."
            BURST "2+ bonus successes: Characters at range 0-3 suffer ^\"Silenced\" and cannot hear. Persists until beginning of your next turn."
        }

        #2kBLGVA2RaIKRMqhLy3Qhy ^"Riding the Clouds" DEF {
            RANK 2
            DESCRIPTION "The monk inhales and lets go their earthly bonds to ascend to new heights. Lifted by a small tornado, an invisible current of air, or even a cloud, the monk can move far more freely. While this current of wind does not fully negate the effects of gravity, it allows the user to traverse terrain they otherwise could not and enhances their athleticism greatly."
            ACTIVATION "As a Movement and Support action, make a TN 2 ^\"Meditation\" (Air) check."
            ENHANCEMENT "When you move 1+ range bands, you may move that number plus 1, and you may move 1 of those range bands vertically or horizontally. You may ignore effects of ^\"Terrain\" while moving. If you fall, treat the distance as 1 range band."
            BURST "1+ bonus successes: Immediately move 1 range band, plus one additional per bonus success. May move vertically or horizontally, ignoring terrain."
        }

        #badQgLnRyoNauA063y5bOo ^"Way of the Willow" DEF {
            RANK 3
            DESCRIPTION "The oak stands firm against the storm and breaks, but the willow survives it by bending. The monk dances on the wind like the willow, feeling the currents of ki upon the air and moving out of the way of attacks effortlessly."
            ACTIVATION "As a Movement and Support action, make a TN 3 ^\"Meditation\" (Air) check."
            ENHANCEMENT "When a character performs an Attack action check targeting you, reduce any damage you suffer by 2 for each kept die containing (op)."
            BURST "2+ bonus successes: Increase the TN of Attack action checks targeting you by your ranks in ^\"Meditation\" until beginning of your next turn."
        }

        # ==================
        # FIRE KIHŌ
        # ==================

        # Function by kindling the energy within, fostering its life-giving
        # force and channeling it outward. Some monks create flames;
        # others manipulate heat directly.

        #lAQIjKFkZekzmFES1nowZn ^"Breaking Blow" DEF {
            RANK 1
            DESCRIPTION "A kihō practitioner skilled in aligning their energy to the element of Fire can deliver a strike that forces a spark of ki into an object and ignites the latent energy within; causing the object to explode or shatter."
            ACTIVATION "As an Attack and Support action, make a TN 1 Martial Arts [Unarmed] (Fire) check. You may choose one object at range 0-1 as the target for the burst effect."
            ENHANCEMENT "When you succeed at a Martial Arts [Unarmed] check against a target, choose one worn armor or readied weapon in target's possession. It gains ^\"Damaged\" unless the target chooses to receive 2 fatigue."
            BURST "2+ bonus successes: Chosen object gains ^\"Damaged\". At GM's discretion, can shatter tough mundane objects (wooden doors, earthen walls, trees). 4+ bonus successes: Chosen object gains ^\"Destroyed\" instead. Can destroy reinforced mundane objects (metal doors, stone walls)."
        }

        #A8jke0NppVpMQayMFqulqf ^"Channel the Fire Dragon" DEF {
            RANK 2
            DESCRIPTION "Fire is not just destruction; it is also life. The monk inhales sharply, igniting their ki to strengthen themself. While this life-giving fire smolders within their lungs, the monk is largely immune to cold weather and flames alike. Ki practitioners experienced in this art can even exhale scorching torrents of flame."
            ACTIVATION "As an Attack and Support action, make a TN 2 ^\"Meditation\" (Fire) check. You may choose to have each other character at range 0-1 become a target for the burst effect."
            ENHANCEMENT "Automatically succeed on all checks to resist extreme weather with bonus successes equal to your Fire Ring. If you would suffer damage from physical or supernatural fire (invocations, kihō), you may spend 1 ^\"Void Points\" to prevent that damage and remove that much fatigue instead."
            BURST "2+ bonus successes: Each target must resist with a TN 4 ^\"Fitness\" check (Air 5, Water 2) or suffer physical damage equal to your Fire Ring and ^\"Burning\". Flammable objects ignite, creating ^\"Dangerous\" terrain at GM's discretion."
        }

        #KuWVH32akfe4wsx8F0YkFw ^"Flame Fist" DEF {
            RANK 1
            DESCRIPTION "The monk throws a rapid, reckless strike, and flame streams out, seizing and charring whatever the monk touches. While sustaining this kihō, the monk’s hands and feet trail fire, lending power to their strikes."
            ACTIVATION "As an Attack and Support action, make a TN 1 Martial Arts [Unarmed] (Fire) check. You may choose a character at range 0-1 as the target for the burst effect."
            ENHANCEMENT "Treat the deadliness of your unarmed ^\"Punch\" and ^\"Kick\" profiles as increased by your Fire Ring and treat their damage type as supernatural."
            BURST "2+ bonus successes: Target suffers physical damage equal to your Fire Ring and must make a TN 4 ^\"Fitness\" check (Air 5, Water 2) or suffer ^\"Dazed\"."
        }

        #9Jjqz0O4akueYJBFvLVGTh ^"The Body Is an Anvil" DEF {
            RANK 1
            DESCRIPTION "The monk focuses their ki to the point where they expect a foe’s blow to land, expelling energy to counter the force of the strike. Weapons have been known to shatter into clouds of sparks and chunks of metal when touching a monk’s body, unmade by the force of the monk’s inner energy."
            ACTIVATION "As a Movement and Support action, make a TN 3 ^\"Meditation\" (Fire) check. You may choose a character at range 0-2 as the target for the burst effect."
            ENHANCEMENT "When you defend against damage from an Attack action, the character who attacked you suffers supernatural damage equal to your Fire Ring and ^\"Dazed\"."
            BURST "2+ bonus successes: Before you defend against damage dealt by the target, reduce the damage by your Fire Ring. If you successfully defend, one weapon the target used gains ^\"Damaged\", and the target suffers ^\"Burning\"."
        }

        #9vqtVV8iiXHOWDq86X9Tt4 ^"Way of the Falling Star" DEF {
            RANK 3
            DESCRIPTION "The monk hurls a series of rapid strikes. With each one, fire or rippling heat erupts from their palm, elbow, foot, or other striking surface scorching their target."
            ACTIVATION "As an Attack and Support action, make a TN 3 Martial Arts [Unarmed] (Fire) check. You may choose one character at range 0-2 as the target for the burst effect."
            ENHANCEMENT "When you perform an Attack action using a ^\"Punch\" or ^\"Kick\" against a ^\"Dazed\" target, increase the damage you inflict by your Fire Ring."
            BURST "3+ bonus successes: Target suffers supernatural damage equal to your Fire Ring plus your ranks in ^\"Fitness\". Target must resist with a TN 5 Fitness check (Air 6, Water 3) or suffer ^\"Burning\" and ^\"Dazed\"."
        }

        # ==================
        # WATER KIHŌ
        # ==================

        # Allow practitioners to feel the ebb and flow in all things.
        # Mastery over one's own ki can be extended to rejuvenate allies
        # or twist a foe's ki with a gentle strike.

        #lUQz8DfxSTaNk9PIeR0qP8 ^"Freezing the Lifeblood" DEF {
            RANK 2
            DESCRIPTION "The monk touches a single point on the target’s body and, with an icy stare, causes the ki within the target to seize up, contracting muscles into a spasmed state and then making them fall slack."
            ACTIVATION "As an Attack and Support action, make a TN 2 Martial Arts [Unarmed] (Water) check. You may choose one character at range 0-1 as the target for the burst effect."
            ENHANCEMENT "After a character defends against damage you inflict with an Attack action using a ^\"Punch\" or ^\"Kick\", they suffer ^\"Immobilized\" unless they choose to receive 3 fatigue."
            BURST "2+ bonus successes: Target suffers supernatural damage equal to your Water Ring (ignoring resistance) and ^\"Immobilized\". 4+ bonus successes: Target suffers a ^\"Critical Strike\" with severity equal to your Water Ring plus ranks in Medicine instead."
        }

        #xNK1aTBpoAgTR8T2DHSt4M ^"Ki Protection" DEF {
            RANK 1
            DESCRIPTION "The monk touches the injured individual, feeling the flow of their ki and using their own to gently correct its flow. While the monk sustains this kihō, their touch continues to heal, though repeating the effort numerous times is quite draining."
            ACTIVATION "As a Movement and Support action, make a TN 1 ^\"Meditation\" (Water) check. You may choose one character at range 0-1 as the target for the burst effect."
            ENHANCEMENT "When you perform the Calming Breath action, you may remove 2 fatigue instead of 1. After you perform an action, you may spend 1 ^\"Void Points\" to remove fatigue equal to your ranks in Medicine from one other character at range 0-1."
            BURST "2+ bonus successes: Target removes fatigue equal to your ranks in Medicine plus your bonus successes. Each target cannot be affected by this again until end of scene."
        }

        #gE6r4owWMgQAaZ1SwGXiKV ^"Ride the Water Dragon" DEF {
            RANK 3
            DESCRIPTION "The monk shifts their stance and moves with inexorable purpose, making their ki fluid and allowing mystical energy to ripple off them like harmless raindrops."
            ACTIVATION "As a Movement and Support action, make a TN 3 ^\"Meditation\" (Water) check."
            ENHANCEMENT "When you are targeted by a check for an invocation, ^\"Mahō\", or kihō, increase the TN of the check by your ranks in ^\"Meditation\". At GM's discretion, you may pass through certain supernatural barriers and wards without triggering their effects."
            BURST "2+ bonus successes: Remove all persistent effects from supernatural sources (invocations, mahō, kihō) from yourself. 4+ bonus successes: Remove all such effects from all characters at range 0-2 instead."
        }

        #iYxo7Ian6nRvdSK9a4n9VG ^"Water Fist" DEF {
            RANK 1
            DESCRIPTION "The monk throws a soft blow against a nearby object and makes their ki as water, rippling across intervening objects and sliding past protections to reach its destination. The force of the strike travels through any contact surface, striking another target touching it, even if they are on the other side of a wooden door, stone wall, or other physical barrier."
            ACTIVATION "As an Attack and Support action, make a TN 1 Martial Arts [Unarmed] (Water) check. You may choose one character at range 0-3 who shares a contact surface with you as the target for the burst effect."
            ENHANCEMENT "Your Attack checks using ^\"Punch\" or ^\"Kick\" ignore an amount of target's physical resistance up to two times your Water Ring. You may spend 1 ^\"Void Points\" to perform an unarmed attack through any solid surface your target is touching, as long as you are both in contact with the same surface at range 0 to your Water Ring."
            BURST "If you succeed: Target suffers physical damage equal to your Water Ring."
        }

        #Oc4NyP1CX6vtQaC9yPtyue ^"Way of the Seafoam" DEF {
            RANK 1
            DESCRIPTION "The monk shifts and matches their movements to their surroundings, sliding to their feet and righting themself like a duck bobbing to the surface of a pond. In this state, the monk can even traverse water, their ki buoying them where they contact the waves."
            ACTIVATION "As a Movement and Support action, make a TN 1 ^\"Meditation\" (Water) check."
            ENHANCEMENT "You may walk on water as if it were solid ground."
            BURST "2+ bonus successes: Remove ^\"Immobilized\" and ^\"Prone\" from yourself. Then switch to any stance and move up to 2 range bands."
        }

        # ==================
        # VOID KIHŌ
        # ==================

        # Involve seeing through the lie of material reality into the
        # truth beneath. The subtlest movements can create vast ripples,
        # and the gentlest strikes can become deadly.

        #51Nf3dWxc5uGMhzedo8xx0 ^"Death Touch" DEF {
            RANK 4
            DESCRIPTION "The monk delivers a blow to a single point on their target’s body and gives a dread proclamation that echoes across the ensuing stillness. The lucky are merely wounded by this experience, but a single brush from a master of such a deadly ki technique can be fatal."
            ACTIVATION "As an Attack and Support action, make a TN 3 Martial Arts [Unarmed] (Void) check. You may choose a character at range 0-1 as the target for the burst effect."
            ENHANCEMENT "When you perform an Attack action using a ^\"Punch\" or ^\"Kick\", the target cannot defend against the damage you deal unless they spend 1 ^\"Void Points\"."
            BURST "3+ bonus successes: Target suffers ^\"Dazed\" and ^\"Disoriented\" and must resist with a TN 4 ^\"Fitness\" check or suffer ^\"Unconscious\". 4+ bonus successes against a minion NPC: target is simply slain."
        }

        #4ayCZl2M6xicRMydHWVR9L ^"Still the Elements" DEF {
            RANK 3
            DESCRIPTION "The monk seeks the infinite Void within themself, delving into their ki and pushing back spiritual beings and tipping the balance between the elements as they desire. Kansen, kami, other spiritual powers, and sometimes even mortals are repelled by the emptiness in the monk."
            ACTIVATION "As an Intrigue and Support action, make a TN 4 ^\"Meditation\" (Void) check. When you perform this action, choose Air, Earth, Fire, or Water."
            ENHANCEMENT "When you are targeted by a check using the chosen ring, you may choose 1 kept die from the check and set it to a blank face. You may spend 1 ^\"Void Points\" to choose additional kept dice up to your ranks in ^\"Meditation\" and set them to blank faces."
            BURST "2+ bonus successes: The ^\"Terrain\" at range 0-3 becomes ^\"Imbalanced\" [Chosen Element] until end of scene."
        }

        #SzlaMn9rWVAUW2Le6f1l5e ^"Touch the Void Dragon" DEF {
            RANK 5
            DESCRIPTION "The root of the universe is nothing and everything, and the monk pursues this spiral to its depths, finding limitless power within. The monk sees many realities swirl around them while maintaining this kihō, the storm of possibilities slowly solidifying into the present. Thus, they can jump at opportunities that might otherwise have passed them by."
            ACTIVATION "As a Support action, make a TN 4 ^\"Meditation\" (Void) check."
            ENHANCEMENT "You may spend (op) from Void checks as if it were (op) from a check using any Element. You may spend (op) from Air, Earth, Fire, or Water checks as if it were (op) from a Void check."
            BURST "2+ bonus successes: Gain 1 ^\"Void Points\". You can only gain 1 Void point from this effect per scene."
        }

        #KVeWNJE1wLimaK11qrGCr4 ^"Way of the Edgeless Sword" DEF {
            RANK 5
            DESCRIPTION "The wise know that it is not the blade that cuts, but the swordmaster. After all, the Tao of Shinsei teaches that weapons are simply another tool, no more sacred than a harvesting thresher or plow. The monk runs their hand along an object, channeling ki into it and transforming it into a killing edge, even if it appears to be nothing more than a common stick, a wooden sword, or their wizened hand."
            ACTIVATION "As an Attack and Support action, make a TN 3 ^\"Meditation\" check. You may choose any number of characters at range 0-1 as targets."
            ENHANCEMENT "Treat the base damage and deadliness of your unarmed profile and improvised weapons you wield as equal to your ranks in Martial Arts [Unarmed] plus your Void Ring. They count as possessing ^\"Durable\" and ^\"Razor-Edged\"."
            BURST "2+ bonus successes: Each target suffers a ^\"Critical Strike\" with deadliness equal to your Void Ring plus ranks in Martial Arts [Unarmed]."
        }

        RULES {
            #L5R306oP8qR0sT2uV4wX6y: kiho_require_monk_school
            #L5R307zA9bC1dE3fG5hI7j: kiho_one_enhancement_at_a_time
            #L5R308kL0mN2oP4qR6sT8u: kiho_enhancement_and_burst_structure
        }
    }

    # ===========================
    # INVOCATIONS (invocation) — ELEMENTAL PRAYERS
    # ===========================

    ^"Invocation" DEF {
        APPLIES TO [^"Samurai", ^"Adversary"]

        # Invocations are prayers and offerings to powerful spirits in
        # exchange for earthly support. They are practiced primarily by
        # shugenja, who are elite samurai priests from ancient, secretive
        # lineages with the power to speak directly to the kami.
        # Invocations are new actions.
        #
        # Symbol: (invocation)
        # Available to: Schools listing Invocations in technique groups (shugenja)

        # Invocations have elemental classifications (Air, Earth, Fire,
        # Water). Note: there are NO Void invocations.
        ELEMENTAL_CLASSIFICATIONS ["Air", "Earth", "Fire", "Water"]

        # --- EFFECT KEYWORDS ---
        # Italicized keywords in invocation effects indicate function:
        # Augment (change/bolster), Mend (restore), Purify (cast out evil),
        # Scry (reveal info), Smite (cause harm), Summon (create something).

        # --- PROPER OFFERINGS ---
        # A shugenja who makes a material offering alongside an invocation
        # may reroll up to 3 rolled dice showing blank results. The offering
        # is consumed. Offerings by spirit type:
        #   Air: Incense, feathers, flowers
        #   Earth: Salt, soil/stones from sacred places, seeds
        #   Fire: Kindling, paper, ash, small flammable objects
        #   Water: Coins, seashells, precious materials, seaweed, sake
        #   Fortunes: Texts, food, origami, works of art
        #   Ancestor Spirits: Food, incense, sake or other libations

        # --- CHANNELING ---
        # Allows delaying completion of an invocation, carrying results
        # over to the next invocation of the same Element.
        CHANNELING {
            ^"Choosing to Channel" "After Step 5: Choose Kept Dice, the character may channel any number of kept dice. Instead of resolving the rest of the check, the character reserves these dice (tracking faces shown). The check ends with no dice results or effects resolved (including success or failure)."
            ^"Using Channeled Dice" "On the character's next turn, if they perform an invocation of the same Element, during Step 3: Assemble and Roll Dice Pool, roll one fewer (ring) per reserved (ring) and one fewer (skill) per reserved (skill), then add channeled dice set to their original results."
            ^"Limitations" "May channel any number of times during a conflict. Outside conflict, may channel only once, and it doubles the invocation time."
            ^"Interruption" "If a character with channeled dice performs any action other than an invocation of the same Element, all channeled dice are lost. If a character becomes ^\"Dazed\", ^\"Silenced\", or ^\"Unconscious\" while channeling, reserved dice are lost."
        }

        # --- SPIRITUAL BACKLASH ---
        # When 3+ (st) symbols on kept dice while performing an invocation:
        # 3 fatigue, cannot use invocations of that element until end of
        # scene, plus element-specific effect.
        SPIRITUAL_BACKLASH {
            "Trigger: 3 or more (st) symbols on kept dice while performing an invocation."
            "Base: 3 fatigue; cannot use invocations of that element again until end of scene."
            ^"Air" "GM chooses up to two additional characters in range who become targets (or GM picks a player to choose, for an NPC)."
            ^"Fire" "Technique targets each character in range. Terrain at range 0-2 may become ^\"Dangerous\" at GM's discretion."
            ^"Earth" "Terrain at range 0-3 gains ^\"Imbalanced\" (Earth) for days equal to the shugenja's strife."
            ^"Water" "Terrain at range 0-1 turns to muck and becomes ^\"Entangling\"."
        }

        # --- IMPORTUNE INVOCATIONS ---
        # Once per scene, a character who knows 1+ invocations may attempt
        # an unlearned invocation (even without prerequisites) by making a
        # valuable offering to the kami (rare or unique item, lost forever).
        # TN increased by 1 + 1 per school rank the prerequisite exceeds
        # the character's rank. May channel as usual but perform only once.

        # --- PREPARED INVOCATIONS ---
        # Downtime activity: bind an invocation into an expendable vessel.
        # Only one prepared invocation at a time (preparing another fades
        # the first). Anyone holding it can unleash via listed activation.
        # Check uses the invocation's ring and TN.
        #
        # Wards: Parchment marked by mystic symbols.
        #   Preparation Skill: ^"Composition"
        #   Ingredients: Calligraphy set, 1 bu of parchment.
        #   Place on any surface, write a triggering condition. When
        #   fulfilled, the invocation activates at its location.

        # --- SPENDING (op) FOR INVOCATIONS ---
        # General (op) options by element (GM decides applicability):
        INVOCATION_OPPORTUNITIES {
            #cDevpZXtxqd46NJqprp4rm ^"Air" DEF {
                "Air (op)(op)+: Choose one additional target per (op)(op) spent this way."
                "+(op): Treat maximum range as 1 higher per (op) spent this way."
                "(op): Reduce TN of next Movement action check by 1. Persists until end of next turn."
                "Air (op)(op)+: If this technique can target characters other than you, choose additional target per (op)(op) spent this way."
                "Air (op)(op)+: If this technique targets all characters in an area, choose 1 character in range to exclude as a target per (op)(op) spent this way."
            }
            #itdq5tlzzZmtVUu19qKpsB ^"Earth" DEF {
                "(op): Increase physical resistance by 1 until beginning of next turn."
                "+(op): If technique can target others, choose one additional target per (op) spent this way."
                "+(op): Treat maximum range as 1 higher per (op) spent this way."
                "(op): Damage inflicts physical instead of supernatural."
                "(op): Damage has the ^\"Sacred\" quality."
            }
            #FR6cTej4A3soIQUAo6uoaz ^"Fire" DEF {
                "+(op): Treat maximum range as 1 higher per (op) spent this way."
                "+(op): If technique can target others, choose one additional target per (op) spent this way."
                "(op): Reduce TN of next Attack action check by 1. Persists until end of next turn."
                "+(op): Increase TN of checks to resist by 1 per (op) spent this way."
                "Fire (op)(op)+: One target per (op)(op) must resist TN 3 ^\"Fitness\" (Air 4, Water 1) or suffer ^\"Burning\"."
            }
            #JfSJn1ALKF1amg3pUJXPhp ^"Water" DEF {
                "(op): Increase supernatural resistance by 1 until end of next turn."
                "+(op): If technique can target others, choose one additional target per (op) spent this way."
                "Water (op)(op)+: Treat max or min range as 1 higher or lower per (op)(op) spent this way."
                "Water (op)(op): Remove 1 fatigue from the target or yourself."
                "(op): Reduce TN of next Support action check by 1. Persists until end of next turn."
            }
        }

        # ==================
        # AIR INVOCATIONS
        # ==================

        # Air kami are fickle and capricious beings, but none are nimbler
        # or more subtle. They bestow lightness of step, nimbleness of
        # mind, and the ability to enhance or obscure sight.

        #NplLa67DjUuIrOWZjhEO5V ^"Blessed Wind" DEF {
            RANK 1
            DESCRIPTION "The shugenja recites a short chant, and the dust whips up, carried upon twisting currents of air that foil and deflect projectiles. Stones, arrows, and even larger missiles are knocked aside by buffeting winds, keeping the target safe from such attacks."
            OTHER_NAMES "Bottled Duststorm (Alchemy), Tamon's Rebuke (Fortunist), Column of the World (Foreign)"
            ACTIVATION "As a Support action, make a TN 2 Theology (Air) check targeting one position at range 0-3."
            EFFECTS "If you succeed, you summon a swirling wind at the target position. Any character at range 0-2 of the chosen position counts as being in ^\"Obscuring\" terrain for Attack actions targeting them. Persists for one round, plus additional rounds equal to your bonus successes."
            OPPORTUNITIES {
                "Air (op): This effect persists until end of the scene instead."
            }
        }

        #92FDBSLYNzoMbnc4ueKtnX ^"By the Light of the Lord Moon" DEF {
            RANK 1
            DESCRIPTION "When a shugenja performs this invocation, the light shifts to that of a moonlit night, unweaving the shadows to lay bare the things they conceal. Hidden objects glow faintly with silver light, while mystical illusions are revealed as translucent, gossamer forms."
            OTHER_NAMES "Kitsuki's Eyes (Ancestral), Wind Scatters Shadow (Elemental), Reveal the World of Ghosts (Foreign)"
            ACTIVATION "As a Scheme action, make a TN 2 Theology (Air) check targeting an area at range 0-2."
            EFFECTS "If you succeed, you scry for each hidden character and concealed object (secret compartments, trap doors, concealed weapons) in the targeted area, revealing it with a luminous outline only you can perceive. Only reveals mundane concealment."
            OPPORTUNITIES {
                "Air +(op): Reveal up to one magically concealed object per (op) spent this way."
                "Air (op)(op)+: Choose one additional character at range 0-1 per (op)(op) spent this way who can also see the objects."
            }
        }

        #XfCP5vVEcizWd4A7HhjF8l ^"Call Upon the Wind" DEF {
            RANK 2
            DESCRIPTION "The shugenja whispers a breathless prayer and rises from the ground as gentle winds bear them aloft. Air spirits usually carry their charges gracefully, without dropping them to stumble the last few feet—usually."
            OTHER_NAMES "Gentle Wings of the Wren (Alchemy), Doji's Steps (Ancestral), Benten Smiles (Fortunist)"
            ACTIVATION "As a Movement action, make a TN 4 Theology (Air) check targeting yourself."
            EFFECTS "If you succeed, you augment your movement with a gust of wind that carries you aloft. You may move vertically freely and ignore the effects of terrain while flying. Persists until end of the scene."
            OPPORTUNITIES {
                "Air (op)(op)+: While flying, carry up to one additional willing character at range 0-2 per (op)(op) spent this way."
            }
        }

        #YY6q3YNKSDp3EMJu8qmnwY ^"Cloak of Night" DEF {
            RANK 1
            DESCRIPTION "A sufficiently learned shugenja can call forth air kami to play one of their simplest and most effective tricks: enveloping an object or person in their embrace to hide it from sight."
            OTHER_NAMES "Smoke of Stolen Light (Alchemy), Shroud of the North Wind (Fortunist), Walk in the Shadow World (Foreign)"
            ACTIVATION "As a Scheme and Support action, make a Theology (Air) check targeting one object or character at range 0-1. TN equals the target's ^\"Silhouette\"."
            EFFECTS "If you succeed, you augment the target with an illusion that renders it invisible to the naked eye. The object is still physically present and can be touched, smelled, or sensed with any normal sense other than vision. Persists for one round, plus additional rounds equal to your bonus successes."
            OPPORTUNITIES {
                "Air (op)(op)+: Choose one additional target of the same silhouette or smaller per (op)(op) spent this way."
            }
        }

        #r2gWHZuAwLe2R7ZU9aFbLC ^"False Realm of the Fox Spirits" DEF {
            RANK 4
            DESCRIPTION "The kami are not bound so tightly to the Mortal Realm of Ningen-dō as mortals (even shugenja) are. They can see the ways in which the mortal and spiritual realms overlap and disconnect, and when beseeched by a shugenja, they can even draw visions of one realm into another, creating vast, nearly tangible falsehoods that fool all but the keenest observers."
            OTHER_NAMES "Ikoma Recalls a Tale (Ancestral), Lost in the Isawa Mori (Fortunist), Paint the Spyglass Lens (Foreign)"
            ACTIVATION "As a Scheme action, make a TN 5 Theology (Air) check targeting one position at range 0-4."
            EFFECTS "If you succeed, you summon illusory terrain at the target position extending range bands up to your Air Ring. A character unaware of its false nature must resist with a TN 4 ^\"Survival\" check (Earth 5, Fire 2) to realize its falsehood at a distance. Any physical contact reveals the lie (though the illusion stays in place). Persists for rounds equal to your Air Ring plus bonus successes (or that many minutes in narrative or downtime)."
            OPPORTUNITIES {
                "Air (op): This effect persists until end of the scene instead."
                "Air +(op): The illusory terrain has one of the following terrain qualities per (op) spent this way: ^\"Dangerous\", ^\"Entangling\", or ^\"Obscuring\"."
            }
        }

        #xKrS3aGxf7KIwhECALgvkN ^"Grasp of the Air Dragon" DEF {
            RANK 3
            DESCRIPTION "Invocations are marked Shikajin's Leap (Ancestral), Jikoju's Journey with a stylized scroll () (Fortunist), The Wind's Cradle (Foreign) in curriculum tables. The shugenja exhales a long breath at the end of the incantation and extends a hand. A stillness descends, the moment before the storm breaks. Then, the clouds high above twist and trail from the Heavens like festival streamers. The wind swoops toward the target and hurls them into the air—carrying them to safety or to their doom, depending on the will of the shugenja."
            OTHER_NAMES "Shikajin's Leap (Ancestral), Jikoju's Journey (Fortunist), The Wind's Cradle (Foreign)"
            ACTIVATION "As an Attack action or a Support action, make a TN 4 Theology (Air) check targeting one character at range 3-5."
            EFFECTS {
                "If you succeed, you summon a gale-force wind to move the target range bands equal to your Air Ring plus bonus successes (max 6), ignoring intervening terrain. Set the target down gently (Support) or slam them into the ground (Attack)."
                "Attack: Target must resist with a TN 4 ^\"Fitness\" check (Earth 5, Fire 2) or suffer the effects of a fall from range 3."
            }
            OPPORTUNITIES {
                "Air +(op): Treat the maximum range as 1 higher per (op) spent this way."
                "Air (op)(op)+: Increase the height of the fall the target suffers by 1 per (op)(op) spent this way."
            }
        }

        #f9tEfUTkeEZJEZfaWNwgM2 ^"Mask of Wind" DEF {
            RANK 2
            DESCRIPTION "Deception is not the way of the samurai, but it is often the way of expedience. The shugenja asks the air kami to mask their features and even their voice, causing onlookers to perceive a different person."
            OTHER_NAMES "Paste of Moving Features (Alchemy), Furuyari's Face (Ancestral), Sadahako's Joke (Fortunist)"
            ACTIVATION "As a Scheme and Support action, make a TN 3 Theology (Air) check targeting yourself."
            EFFECTS "If you succeed, you augment yourself with an illusion that makes you look like someone else. An observer must resist with a TN 4 ^\"Sentiment\" check (Earth 5, Fire 2) to notice something amiss from appearance alone; if they succeed, they may spend (op) to recognize you specifically. Persists until end of the scene."
            OPPORTUNITIES {
                "Air (op): Alter your voice to sound like someone else. Separate TN 4 Sentiment check (Earth 5, Fire 2) to notice from voice alone; may spend (op) to recognize you."
                "Air (op)(op)+: This effect persists for one additional scene per (op)(op) spent this way."
            }
        }

        #LqzP8pxVfEv2IxA67lSDD8 ^"Nature's Touch" DEF {
            RANK 1
            DESCRIPTION "To perform this rite, the shugenja seeks Chikushō-dō, the Realm of Animals, in the world around them and in their own heart. This allows the shugenja to communicate with (though not dominate) animals of the mortal realm."
            OTHER_NAMES "Shinjo's Whispers (Ancestral), Run Alongside the Ki-Rin (Fortunist), Voice of the Glen King (Foreign)"
            ACTIVATION "As a Support action, make a TN 1 Theology (Air) check targeting yourself."
            EFFECTS "If you succeed, you augment yourself with the ability to speak to animals of the natural world (not Otherworldly or Tainted beings). Animals understand you within their ability but are not compelled to obey. Persists until end of the scene."
            OPPORTUNITIES {
                "Air (op): Until end of scene, you can understand animals' speech."
                "Air (op): The animal acts favorably toward you, fulfilling one request that does not put it in danger without subsequent checks."
                "Air (op)(op): You can communicate with an Otherworldly being this way, provided it has anything to say to you."
            }
        }

        #TsiIGqNZadTeTlOLghFrL6 ^"Rise, Air" DEF {
            RANK 4
            DESCRIPTION "A manifest air kami is a flickering, shifting thing, a whirlwind of power with lashing arms that screams with the voice of the storm. It towers above the tallest of humans, yet can find its way through the slightest of cracks. The slightest slip of concentration while guiding such a being can lead to untold devastation as the child of the tempest carves its way across the landscape."
            OTHER_NAMES "Dust of Incarnation (Alchemy), Guardian of Air (Ancestral), Summon the Air Djinn (Foreign)"
            ACTIVATION "As a Support action, make a TN 6 Theology (Air) check targeting one position at range 3-5."
            EFFECTS "If you succeed, you summon a Manifest Air Kami to fight for you. It appears at the target position and obeys you for two rounds, plus additional rounds equal to your bonus successes, taking its turn immediately after yours each round. When this effect ends, it departs or, if stirred to ire, begins to follow its own directives (will not attack you unless provoked)."
            OPPORTUNITIES {
                "Air (op): The manifest air kami arrives in a cyclone. Each character at range 0-2 of the target position must resist with a TN 4 ^\"Fitness\" check (Earth 5, Fire 2) or suffer supernatural damage equal to your Air Ring and be pushed 2 range bands."
            }
        }

        #Fan1aXISbY2DQwjOtHBqr4 ^"Secrets on the Wind" DEF {
            RANK 2
            DESCRIPTION "The spirits of air need little prompting to gossip, even if their breathless murmurs are often incomprehensible to human ears. To make this clandestine invocation, the shugenja offers up incense of sandalwood and plum to convince the air kami to repeat what is said far away."
            OTHER_NAMES "Whisper in Bayushi's Ear (Ancestral), Tenjin's Gift (Fortunist), The Fly on the Northern Wall (Foreign)"
            ACTIVATION "As a Scheme action, make a TN 3 Theology (Air) check targeting one position at range 0."
            EFFECTS "If you succeed, you scry with whispering winds that eavesdrop on the chosen position. The air kami can overhear anything said within range bands equal to your Air Ring. Persists for twenty-four hours or until you designate a new area. While this effect persists, you may spend an action to hear anything being said at the moment in the designated area."
            OPPORTUNITIES {
                "Air (op): You can also smell any scents in that area."
                "Air (op): If another character discovers your invocation, the effect immediately ends, preventing them from identifying it as your handiwork."
                "Air (op)(op)+: Persists for twenty-four additional hours per (op)(op) spent this way."
            }
        }

        #BvozMnAavOlJGFN8CUZHo9 ^"Summon Fog" DEF {
            RANK 2
            DESCRIPTION "Tendrils of mist spill forth from the character’s robes or armor, billowing out before them and wrapping them in an ominous haze."
            OTHER_NAMES "Soshi's Escape (Ancestral), Veil of the Dawn (Elemental), Jotei Curls in Rest (Fortunist)"
            ACTIVATION "As a Support action, make a TN 2 Theology (Air) check targeting one position at range 0-4."
            EFFECTS "If you succeed, you summon a fog bank extending 1 range band around the target position. This fog bank counts as ^\"Obscuring\" terrain."
            OPPORTUNITIES {
                "Air (op): Target a character instead of a position. The fog bank follows that character."
                "Air +(op): The fog bank encompasses 1 additional range band per (op) spent this way (max range 6)."
                "Air (op)(op): The fog bank becomes a freezing ice storm, also counting as ^\"Dangerous\" terrain."
            }
        }

        #mQA8bcf9pDPdbetjIcw9Dr ^"Tempest of Air" DEF {
            RANK 1
            DESCRIPTION "The shugenja beseeches the air spirits to lash out all around them, calling buffeting winds to push foes backward or even hurl them to the ground."
            OTHER_NAMES "Stormy Vial (Alchemy), Howl of Isora (Fortunist), Flap of the Wyvern's Wings (Foreign)"
            ACTIVATION "As an Attack action, make a TN 3 Theology (Air) check targeting each character at range 2-3."
            EFFECTS "If you succeed, blasts of wind smite each target. Each target suffers supernatural damage equal to your Air Ring and must resist with a TN 4 ^\"Fitness\" check (Earth 5, Fire 2) or suffer ^\"Disoriented\"."
            OPPORTUNITIES {
                "Air +(op): Each target who fails their Fitness check is also pushed 1 range band away from you per (op) spent this way."
            }
        }

        #BBT7VBmJQGzmfoApPgFvRG ^"Token of Memory" DEF {
            RANK 1
            DESCRIPTION "After performing this invocation, the shugenja conjures an illusion from the air, a trick of the light captured in hand."
            OTHER_NAMES "Riddle of Agasha (Ancestral), Trick of the Air Kami (Elemental), Ebisu's Joke (Fortunist)"
            ACTIVATION "As a Scheme action, make a TN 2 Theology (Air) check targeting one position at range 0-1."
            EFFECTS "If you succeed, you summon an illusion of one inanimate object at the target position. The illusory object's ^\"Silhouette\" is up to your bonus successes (beginning at 0). The item appears real but cannot be used. Any character must resist with a TN 4 Artisan, Smithing, or Design check (Earth 5, Fire 2) using a Scholar skill approach to discern its illusory nature. Persists until end of the scene."
            OPPORTUNITIES {
                "Air (op): The object can appear to be a creature or person (though it does not move)."
                "Air +(op): Summon one additional illusory object in range per (op) spent this way."
                "Air (op)(op): Illusory objects you summon have mass and can be used as if real (still inanimate, do not move on their own). They vanish when the effect ends."
            }
        }

        #BNwrARfqANunt8AvWaaUZR ^"Vapor of Nightmares" DEF {
            RANK 3
            DESCRIPTION "The shugenja murmurs an incantation half-heard by the target, and as the ominous chant fades and the scent cloud of incense parts, the object of the target’s fear strides forth as an illusive phantasm."
            OTHER_NAMES "Togashi Speaks Softly (Ancestral), Your Heart's Enemy (Elemental), Shadow of the Karmic Wheel (Fortunist)"
            ACTIVATION "As an Attack action, make a TN 4 Theology (Air) check targeting one character at range 2-3."
            EFFECTS "If you succeed, you summon an illusion of your target's greatest fear. Target must resist with a TN 4 ^\"Meditation\" check (Earth 5, Fire 2); if they fail, they suffer strife equal to your Air Ring plus bonus successes, and must immediately unmask if they become ^\"Compromised\" this way. If they unmask in the presence of the phantasm, they focus their attentions on the phantasm (attacking it, fleeing from it, or unleashing harsh words upon it) rather than dealing with you or anyone else. The phantasm persists for rounds equal to your Air Ring."
            OPPORTUNITIES {
                "Air (op): If a target fails the Meditation check, they also suffer ^\"Disoriented\"."
                "Air (op): The phantasm persists until end of the scene instead."
            }
        }

        #cXoaHMNRB1c7egQ8E9FuPO ^"Wrath of Kaze-no-Kami" DEF {
            RANK 5
            DESCRIPTION "When stirred to wrath through the deepest secrets of the shugenja’s art, the spirits of the wind become a howling tornado, spinning around the priest and raising them from the ground while devastating everything in reach; uprooting trees, shattering buildings, and crushing foes."
            OTHER_NAMES "Bottled Typhoon (Alchemy), Utaku's Stampede (Ancestral), The Air Dragon's Fury (Elemental)"
            ACTIVATION "As an Attack action, make a TN 5 Theology (Air) check targeting each character at range 2-4."
            EFFECTS "If you succeed, you summon a hurricane that buffets all characters in range. At the end of each of your turns, each target in range must resist with a TN 4 ^\"Fitness\" check (Earth 5, Fire 2) or suffer supernatural damage equal to your Air Ring and ^\"Disoriented\". The hurricane persists for rounds equal to your Air Ring and can destroy objects or structures at GM's discretion."
            OPPORTUNITIES {
                "Air (op): You may end the hurricane at any time as an action."
                "Air +(op): Each target who fails the Fitness check is hurled range bands away from you equal to (op) spent this way. Upon landing, each target hurled suffers the effects of falling the number of range bands they moved."
                "Air (op)(op): While within the hurricane, you can fly, moving vertically and ignoring the effects of terrain."
            }
        }

        #dfUyYhPMclsERpsdRTRBKo ^"Yari of Air" DEF {
            RANK 1
            DESCRIPTION "The shugenja adopts a spear-fighting stance, and a swirling, darting mass ripples into being in their hand. It weighs almost nothing and yet strikes with the force of a thunderclap."
            OTHER_NAMES "Rod of the Wind Yari (Alchemy), Suijin's Spear (Fortunist), Halberd of the Djinn (Foreign)"
            ACTIVATION "As a Support action, make a TN 1 Theology (Air) check to summon a spear made of swirling wind into your hand."
            EFFECTS "If you succeed, you summon and ready a ^\"Yari\" made of wind, visible only by a wispy outline. It has the ^\"Concealable\" quality. When you make an Attack or Support action check using the invisible spear, during Step 5: Choose Kept Dice, add a kept (ring) set to an (ex)(st) result. The spear persists until the end of any turn in which it leaves your grip or until the end of the encounter."
            OPPORTUNITIES {
                "Air (op): The weapon you summon can be any kind of melee or ranged weapon instead of a spear."
                "Air (op): After performing this action, you may immediately perform a Guard action using the weapon you summoned."
                "Air (op)(op): You may summon a pair of weapons instead of a single weapon."
            }
        }

        # ==================
        # EARTH INVOCATIONS
        # ==================

        # Earth invocations focus on protection, defense against the
        # Shadow, and slow but inevitable destruction.

        #VcpohGGPOCpYJbC7sXyawc ^"Armor of Earth" DEF {
            RANK 1
            DESCRIPTION "Earth is the Element of protection, as evidenced by this invocation. When a shugenja performs this invocation, shards of stone fly toward them, fastening around them to clad them in rocky armor."
            OTHER_NAMES "Hida's Shell (Ancestral), The Hand of Bishamon (Fortunist), Stone Shields (Foreign)"
            ACTIVATION "As a Support action, make a TN 2 Theology (Earth) check targeting yourself."
            EFFECTS "You summon and equip a suit of armor that grants physical resistance equal to your Earth Ring plus bonus successes and has the ^\"Cumbersome\" and ^\"Wargear\" qualities. Persists for rounds equal to your Earth Ring, then tumbles to the ground as loose stones."
            OPPORTUNITIES {
                "Earth (op): This effect persists until end of the scene instead."
                "Earth (op): The armor has the ^\"Durable\" quality."
                "Earth (op)(op): The armor has the ^\"Sacred\" quality."
            }
        }

        #H0BOW20NiMv02DSUg6ABq4 ^"Bind the Shadow" DEF {
            RANK 2
            DESCRIPTION "When confronting a Tainted being, the shugenja can call forth the pure spirit of a small sanctified object to weaken or even paralyze the monster."
            OTHER_NAMES "Circle of Salt and Ash (Alchemy), Earth Kami's Scorn (Elemental), Judgment of the Ten-Thousand (Fortunist)"
            ACTIVATION "As an Attack action, make a TN 3 Theology (Earth) check targeting one Otherworldly being at range 0-2."
            EFFECTS "If you succeed, crackling arcs of jade light smite and purify your target; it must resist with a TN 4 ^\"Fitness\" (Air 2, Water 5) check or suffer ^\"Immobilized\" and ^\"Silenced\". Persists for rounds equal to your Earth Ring."
            OPPORTUNITIES {
                "Earth (op): Each target that fails is bound until end of the scene instead."
                "Earth (op)(op): Each target that fails is bound for one year instead."
                "Earth (op)(op)+: Increase TN of checks to resist by 1 per (op)(op) spent this way."
                "Earth (op)(op)(op): Each target that fails is bound for one hundred years instead."
            }
        }

        #UxzkfwEGCbhDtVZPERxIWw ^"Caress of Earth" DEF {
            RANK 1
            DESCRIPTION "The shugenja draws their hand across a broken item, calling upon the spirits of metal, wood, or stone to restore and fortify it. Splintered planks knit back together, metal glows and writhes before solidifying into a form like new, and stone congeals as liquid before freezing back into form."
            OTHER_NAMES "Salve of the Stone Kami (Alchemy), Kaiu's Many Hands (Ancestral), Litany of Rebinding (Foreign)"
            ACTIVATION "As a Support action, make a TN 3 Theology (Earth) check targeting one item with ^\"Damaged\" or ^\"Destroyed\" at range 0-1."
            EFFECTS "If you succeed, you mend the target, removing the Damaged or Destroyed quality from it."
            OPPORTUNITIES {
                "Earth (op): One target gains the ^\"Durable\" quality until end of the scene."
            }
        }

        #jB66LO3XY0680iyjeeXNHC ^"Courage of Seven Thunders" DEF {
            RANK 1
            DESCRIPTION "At the dawn of the Empire, the Seven Thunders stood against Fu Leng, and their clash resounded from the Shadowlands to every corner of Rokugan. Earth is the Element of recollection, and from the earth kami, a shugenja can unearth fragments of the memories of these heroes from across the ages and impart them to their comrades in arms. This invocation does not erase fear, but it reminds a samurai of the legacy they must uphold—that others stood against the darkness before and prevailed."
            OTHER_NAMES "Akodo's Unflinching Stand (Ancestral), Unyielding Heart of Stone (Elemental), Walk into the Valley of Shadow (Foreign)"
            ACTIVATION "As a Support action, make a TN 2 Theology (Earth) check targeting a number of characters up to your Earth Ring at range 0-2."
            EFFECTS "If you succeed, you augment each target with vigorous resolve; each target increases their composure by your Earth Ring. Persists until end of the scene."
            OPPORTUNITIES {
                "Earth (op): Each target also increases their endurance by your Earth Ring while this effect persists."
                "Earth +(op): Each target removes 1 strife per (op) spent this way."
                "Earth (op)(op): This technique targets each friendly character in range instead."
            }
        }

        #qO9gg8gdaMejV0gyAJW6ug ^"Earthquake" DEF {
            RANK 4
            DESCRIPTION "Earthquakes are common in some parts of Rokugan, and they are rightly feared—whole villages have been known to vanish when the earth spirits are set to turmoil. To intentionally raise their ire is dangerous, but it is one of the most powerful techniques a shugenja can wield. Ripples shoot across the ground around them as the earth bucks and tumbles. The shugenja’s foes plummet into chasms of darkness and sulfur, entombed forever beneath the ground they once walked."
            OTHER_NAMES "Akodo's Bellow (Ancestral), Swallowed by the Earth Kami (Elemental), Kyufoki's Hammer (Fortunist)"
            ACTIVATION "As an Attack action, make a TN 5 Theology (Earth) check targeting each other character at range 0-3."
            EFFECTS "If you succeed, you summon an earthquake. At the end of each of your turns, each target must resist with a TN 5 ^\"Fitness\" check (Air 3, Water 6) or suffer supernatural damage equal to twice your Earth Ring and ^\"Prone\". Persists for rounds equal to your Earth Ring."
            OPPORTUNITIES {
                "Earth (op): Persists until end of the scene, or you may dispel it at any time as an action."
                "Earth +(op): Summon a chasm beneath one character in range; that character and anyone at range 0-1 of them fall range bands equal to (op) spent this way into the earth."
                "Earth (op)(op)+: Destroy one building or fortification in range per (op)(op) spent this way. Each character inside must resist with a TN 3 ^\"Fitness\" check (Air 1, Water 4) to escape or suffer a ^\"Critical Strike\" with severity 10."
            }
        }

        #XiOb7u4vjRj241sudXaSnI ^"Earth Becomes Sky" DEF {
            RANK 3
            DESCRIPTION "The shugenja makes a short incantation and stomps a foot on the ground, and the earth kami spray torrents of dirt, stones, and even boulders toward their foe."
            OTHER_NAMES "Vial of Explosive Earth (Alchemy), The Fall of Yama-no-Kami (Fortunist), Throwing the Avalanche (Foreign)"
            ACTIVATION "As an Attack action, make a TN 3 Theology (Earth) check targeting one character at range 1-3."
            EFFECTS "If you succeed, you summon a boulder to smite your target. The target suffers supernatural damage equal to your Earth Ring plus bonus successes and must resist with a TN 3 ^\"Fitness\" check (Air 1, Water 4) or suffer ^\"Prone\". If your target is already ^\"Prone\", double the damage."
        }

        #y63r6sZ4UT0LE4sOyZGf3v ^"Embrace of Kenro-Ji-Jin" DEF {
            RANK 2
            DESCRIPTION "The shugenja appeals to rumbling subterranean kami, offering the proper prayers to receive safe passage even across places humans were not meant to tread. The spirits shroud the shugenja, allowing them to stick to rocky surfaces or parting the ground to allow passage."
            OTHER_NAMES "Earth Spider's Salve (Alchemy), Hiruma's Passage (Ancestral), Climbing the Earth Dragon's Back (Elemental)"
            ACTIVATION "As a Support action, make a TN 2 Theology (Earth) check targeting yourself."
            EFFECTS "If you succeed, you augment yourself with the ability to stick to earthen surfaces, traversing even vertical surfaces made of earth or stone. Persists for one round, plus additional rounds equal to bonus successes (or one minute in narrative)."
            OPPORTUNITIES {
                "Earth (op): This effect persists until end of the scene instead."
                "Earth (op): You can pass through solid earth as if it was water when you move. Supernatural resistance against Earth invocations, kihō, and mahō equal to your Earth Ring."
                "Earth (op)(op): Effects also apply to metal. Physical resistance against metal weapons equal to your Earth Ring."
            }
        }

        #7qY7Tid6mGxbXVjQ1WQ2Hs ^"Grasp of Earth" DEF {
            RANK 1
            DESCRIPTION "With a harsh chant and a gesture of seizing, the shugenja calls upon the earth spirits to lay hold of someone, dragging them down and containing them. Usually, this invocation causes the target’s legs to sink into ground that has turned into sucking mud, quicksand, or a hole beneath them and entraps them."
            OTHER_NAMES "Crystallizing Potion (Alchemy), Hida's Bindings (Ancestral), Frozen in Bishamon's Gaze (Fortunist)"
            ACTIVATION "As an Attack action, make a TN 2 Theology (Earth) check targeting one character at range 0-2."
            EFFECTS "If you succeed, you summon cracks in the earth; each target suffers supernatural damage equal to your Earth Ring and must resist with a TN 4 ^\"Fitness\" check (Air 2, Water 5) or suffer ^\"Prone\"."
            OPPORTUNITIES {
                "Earth (op): Each target that fails also suffers ^\"Immobilized\"."
                "Earth (op): Reduce the damage each target suffers to 0."
            }
        }

        #eQ4ghrfo9TIxOEvbkmZDog ^"Jade Strike" DEF {
            RANK 1
            DESCRIPTION "Jade, said to be the tears of Amaterasu, is a sacred stone. It is anathema to creatures of darkness, and it is one of the few substances capable of harming the greater minions of Fu Leng, the fallen Kami. A shugenja can mimic its effects by entreating earth kami to punish evil before them. The shugenja’s hand is enveloped in the sacred green glow, which strikes forth, withering creatures of evil and humans under the sway of the Shadowlands’ insidious power."
            OTHER_NAMES "Tears of the Sun Goddess (Ancestral), Breath of the Jade Dragon (Fortunist), The Earth's Sacred Rebuke (Foreign)"
            ACTIVATION "As an Attack action, make a TN 2 Theology (Earth) check targeting one character at range 0-3."
            EFFECTS {
                "If you succeed and the target is an Otherworldly being, you smite and purify it with searing jade energy. It suffers a ^\"Critical Strike\" with severity equal to your Earth Ring plus bonus successes. The creature may spend (op)(op) from its check to resist to conceal that it has been affected, potentially concealing its Otherworldly nature (though it still suffers the effects)."
                "If you succeed and the target is not Otherworldly, it suffers no ill effects."
            }
            OPPORTUNITIES {
                "Earth (op): Each Otherworldly target suffers ^\"Silenced\" and cannot use ^\"Mahō\" until end of your next turn."
            }
        }

        #mcHQRuTWw8KlIwpUzilJC9 ^"Jurōjin's Balm" DEF {
            RANK 1
            DESCRIPTION "Jurōjin, guardian of longevity, health, and physical wellbeing, is one of the most sought after of the Seven Fortunes—for whether one is a lord or a peasant, one is sure to pray for health sooner or later. A shugenja can impart spiritual fortification in this Fortune’s name, anointing the body of the target with sacred earth, healing plants such as ginseng or rhubarb, or stranger remedies still. While under the effects of this blessing, a character is much more resistant to poison, disease, and the effects of alcohol—which can be a boon or curse depending on one's goals."
            OTHER_NAMES "Lifeblood of the Earth Kami (Elemental), Jiro's Patience (Fortunist), Kiss of the Pond Woman (Foreign)"
            ACTIVATION "As a Support action, make a TN 1 Theology (Earth) check targeting one character at range 0-1."
            EFFECTS "If you succeed, you augment your target's fortitude. The target reduces TN of all checks to resist poison and disease by 2 (min 1). The target cannot become intoxicated via alcohol. Persists until end of the scene."
            OPPORTUNITIES {
                "Earth (op): Target also reduces TN of checks to resist ^\"Mahō\", ^\"Defiled\" terrain, and effects of Otherworldly beings by 2 (min 1)."
                "Earth (op)(op): This effect persists for twenty-four hours instead."
                "Earth (op)(op): You also mend your target, removing current poisons, the ^\"Dying\" condition, and suppressing disease symptoms until end of scene."
            }
        }

        #n2iq1tu2O2g94ZCXQNGGc9 ^"Power of the Earth Dragon" DEF {
            RANK 3
            DESCRIPTION "The shugenja places a hand on the earth and a hand over the target’s heart. They recite a deep, reverberating prayer that thrums loudly through both, bringing the vitality and resilience of stone to the blessed."
            OTHER_NAMES "Fortifying Stone Vial (Alchemy), Osano-Wo's Determination (Ancestral), Jurōjin's Verdant Blessing (Fortunist)"
            ACTIVATION "As a Support action, make a TN 4 Theology (Earth) check targeting one character at range 0-2."
            EFFECTS "If you succeed, you augment your target's resilience, increasing their endurance by your Earth Ring plus bonus successes. Persists for one round, plus additional rounds equal to bonus successes. Each target cannot be affected by this invocation again until end of scene."
            OPPORTUNITIES {
                "Earth (op): This effect persists until end of the scene instead."
            }
        }

        #sKdFvbJx8cCcZoqVOtV3ND ^"Rise, Earth" DEF {
            RANK 4
            DESCRIPTION "An earth kami bursts from the ground, manifesting as a guardian creature of living rock with veins of sapphire, ruby, or even jade. Earth kami can be cantankerous, but they hate anything tainted and strive to obliterate them."
            OTHER_NAMES "Guardian of Earth (Ancestral), Sentinels of Mount Sengen (Fortunist), Clay Warriors (Foreign)"
            ACTIVATION "As a Support action, make a TN 6 Theology (Earth) check targeting one position that includes dirt, clay, or stone at range 0-3."
            EFFECTS "If you succeed, you summon a Manifest Earth Kami to fight for you, which bursts forth at the target position. It obeys you for three rounds, plus additional rounds equal to bonus successes, taking its turn immediately after yours. When this effect ends, it departs or follows its own directives (will not attack you unless provoked)."
            OPPORTUNITIES {
                "Earth +(op): Increase the earth kami's endurance by 2 per (op) spent this way."
                "Earth (op): The earth kami's stone fists unarmed attack profile gains the ^\"Sacred\" quality."
                "Earth (op): The manifest earth kami creates a shockwave. Each character at range 0-2 of the chosen position must resist with a TN 4 ^\"Fitness\" check (Air 2, Water 5) or suffer physical or supernatural damage equal to your Earth Ring and ^\"Prone\"."
            }
        }

        #6r4XG5lmNpe5V92hBG8hDk ^"Symbol of Earth" DEF {
            RANK 2
            DESCRIPTION "Earth spirits govern boundaries and domains. By inscribing an emblem in dirt, scratching it upon stone, or imprinting it upon sand, a shugenja can create a field that repels malevolent supernatural entities."
            OTHER_NAMES "Mark of Crystal and Jade (Alchemy), Consecration of Ningen-do (Fortunist), Seal of the Pure Soil (Foreign)"
            ACTIVATION "As a Support action, make a TN 3 Theology (Earth) check targeting one position at range 0-1."
            EFFECTS "If you succeed, you summon a symbol that purifies the area at the target position. Each time an Otherworldly being attempts to move closer to the target, it suffers supernatural damage equal to your Earth Ring and must make a TN 4 ^\"Fitness\" check (Air 2, Water 5) or suffer ^\"Prone\". Persists for one round, plus additional rounds equal to bonus successes."
            OPPORTUNITIES {
                "Earth (op): Persists until end of the scene instead."
                "Earth (op)(op): Persists for twenty-four hours instead."
            }
        }

        #KDLW2Y7qOErx7dyBx5QamT ^"Tetsubō of Earth" DEF {
            RANK 1
            DESCRIPTION "The shugenja takes a steady stance and calls the spirits of earth. A pillar of stone rises from a nearby plot of soil, chunks cracking away to reveal the form of a studded club. Despite its great weight, the shugenja can heft it with ease, their might reinforced by the spirits of earth."
            OTHER_NAMES "The Blacksmith's Hammer (Alchemy), Akemi's Pillar (Ancestral), Bishamon's Kanabō (Fortunist)"
            ACTIVATION "As a Support action, make a TN 1 Theology (Earth) check targeting one position at range 0-1 that includes stone, dirt, or clay."
            EFFECTS "If you succeed, you summon and ready a ^\"Tetsubō\" made of stone. When you deal damage with an Attack action using this weapon, if a target is ^\"Prone\", that target suffers additional damage equal to your Earth Ring. Persists until the end of any turn in which it leaves your grip or until end of scene."
            OPPORTUNITIES {
                "Earth (op): The weapon can be any kind of melee weapon instead. It has the ^\"Durable\" quality."
                "Earth (op): After performing this action, immediately perform a Guard action using this weapon."
                "Earth (op)(op): The weapon has the ^\"Sacred\" quality."
            }
        }

        #AwBos9V1n8xz2unFujyZsS ^"Tomb of Jade" DEF {
            RANK 5
            DESCRIPTION "One of the most powerful invocations of the spirits of earth, the rite the Kuni shugenja call the Tomb of Jade seals an entity suffused with the power of the Shadowlands within jade, transforming its blighted flesh into this sacred substance. However, if the prison of jade is cracked or broken, the spell weakens, and the being sealed within might be able to escape to wreak havoc once again. If it ever escapes, the shugenja who sealed it becomes aware of its escape, for the earth kami send a rumbling warning, shaking their current location to raise the alarm."
            OTHER_NAMES "Mercy of the Sun Goddess (Ancestral), Embrace of the Stone Kami (Elemental), Amaterasu's Petrifying Gaze (Fortunist)"
            ACTIVATION "As an Attack action, make a TN 6 Theology (Earth) check targeting one character at range 0-1."
            EFFECTS {
                "If you succeed and the target is a Tainted being, you purify it, slowly transforming it into jade. At the beginning of each of the target's turns, reduce the value of each of its rings by 1. Persists for rounds equal to your Earth Ring plus bonus successes. If any ring is reduced to 0, the target is turned entirely into jade — it can only be freed if the statue is damaged or destroyed. The jade statue causes area at range 0-2 to count as ^\"Hallowed\" (Earth) terrain."
                "If you succeed and the target is not Tainted, it suffers no ill effects."
            }
            OPPORTUNITIES {
                "Earth (op): This effect persists until end of the scene instead."
                "Earth (op): At a later point, you may release the target from its jade prison as an action."
                "Earth +(op): Choose one condition per (op) spent: ^\"Dazed\", ^\"Disoriented\", ^\"Immobilized\", or ^\"Prone\". If the target is Otherworldly, it suffers the chosen conditions."
            }
        }

        #8OC12ARmXg4moK6E8G6kbu ^"Wall of Earth" DEF {
            RANK 1
            DESCRIPTION "For their part, earth kami are not too proud to shape walls, ditches, or even buildings along lines in the dirt that a shugenja traces or blesses with reagents like topaz and oak. Placing such a wall underneath someone is likely to hurl them to the ground, while placing one under a building could wreak havoc and cause considerable damage to the structure. The invoked construction endures as long as a mundane construction of the same material would. If it is merely dirt called into the desired shape, it begins to erode within a few days, while if the ground the shugenja raises is largely composed of stone, the construction might stand for centuries."
            OTHER_NAMES "Crystallizing Powder (Alchemy), Shape the Earth (Elemental), Sengen's Hands (Fortunist)"
            ACTIVATION "As a Support action, make a TN 2 Theology (Earth) check targeting two positions at range 0-2."
            EFFECTS "If you succeed, you summon a wall of earth between the two target points that is range 1 in thickness and range 3 in height. Each character standing where the wall erupts must resist with a TN 2 ^\"Fitness\" check (Air 1, Water 3) or suffer physical damage equal to your Earth Ring and ^\"Prone\". The wall endures as long as a mundane construction of the same material."
            OPPORTUNITIES {
                "Earth (op): The wall counts as terrain with one quality: ^\"Dangerous\", ^\"Entangling\", or ^\"Obscuring\"."
                "Earth +(op): Treat maximum range as 1 higher per (op) spent this way."
                "Earth (op)(op): Summon an Outpost fortification instead of a wall."
                "Earth (op)(op)(op): Summon a Fortress fortification instead."
                "Earth (op)(op)(op)(op): Summon a Castle fortification instead."
            }
        }

        # ==================
        # FIRE INVOCATIONS
        # ==================

        # Fire kami are ferocious and direct, and invocations of fire can
        # be equally ferocious. These prayers are some of the most
        # destructive a shugenja can summon.

        #86DyTuZ2YGO79E8j8SfbMT ^"Armor of Radiance" DEF {
            RANK 2
            DESCRIPTION "By appealing to the fire kami that slumber within an object, a shugenja can turn a set of armor into a weapon. The fire kami’s creative energy expands rapidly as the incantation ends, causing shimmering radiance to burst forth into a halo of fire that encircles the armor and the wearer, searing their foes."
            OTHER_NAMES "Oil of Awakening Flames (Alchemy), Armor of Osano-Wo (Ancestral), Robes of the Ifrit (Foreign)"
            ACTIVATION "As a Support action, make a TN 2 Theology (Fire) check targeting one set of armor at range 0-1."
            EFFECTS "If you succeed, you augment the target armor, enveloping it in blinding radiance and searing heat (that do not affect the wearer). When a character at range 0-1 of the wearer begins their turn, they suffer ^\"Burning\" and ^\"Dazed\". Persists for one round, plus additional rounds equal to bonus successes."
            OPPORTUNITIES {
                "Fire (op): The armor gains the ^\"Wargear\" quality."
                "Fire (op)(op): This effect persists until end of the scene instead."
            }
        }

        #quAGB7rBtQ5tQG95dLda7c ^"Biting Steel" DEF {
            RANK 1
            DESCRIPTION "Flame, passion, and ingenuity transform ore into steel, and steel into a sword. So too, then, can a shugenja wield flame to transform a sword into an even greater weapon, one with an impossible edge that parts nearly any substance in its ferocity. By drawing a pattern along the naked blade, a shugenja can wake the spirits of fire still sleeping within it."
            OTHER_NAMES "Salve of Unyielding Metal (Alchemy), Awaken the Blade's Flame (Elemental), The Forge of Xing Guo (Fortunist)"
            ACTIVATION "As a Support action, make a TN 2 Theology (Fire) check targeting one weapon at range 0-1."
            EFFECTS "If you succeed, you augment the weapon with blazing energy. Increase the weapon's base damage by your Fire Ring. Persists for one round, plus additional rounds equal to bonus successes."
            OPPORTUNITIES {
                "Fire (op): After performing this action, if you have the enhanced weapon readied, immediately perform a Strike action with it."
                "Fire +(op): While the effect persists, increase the weapon's deadliness by 1 per (op) spent this way."
                "Fire (op)(op): This effect persists until end of the scene instead."
            }
        }

        #HWBosPNCFy1b8FyLaPBiyo ^"Breath of the Fire Dragon" DEF {
            RANK 3
            DESCRIPTION "“Fire begins with breath,” or so the Isawa have long said. Some shugenja make this practice literal, calling upon the fire kami to ignite the air they exhale, transforming it into a gout of charring flame. Besides burning foes, it also tends to ignite nearby flammable objects."
            OTHER_NAMES "Oni's Sake (Alchemy), Togashi's Radiant Breath (Ancestral), Sigh of the Desert Winds (Foreign)"
            ACTIVATION "As an Attack action, make a TN 4 Theology (Fire) check targeting one character at range 0-3."
            EFFECTS "If you succeed, you exhale searing flames that smite the target. The target suffers supernatural damage equal to your Fire Ring plus two times your bonus successes and ^\"Burning\". Each character at range 0-1 of the target must make a TN 3 ^\"Fitness\" check (Air 4, Water 1) or suffer supernatural damage equal to your Fire Ring."
        }

        #UxqYyOYBTIjoiKI173BUqa ^"Extinguish" DEF {
            RANK 1
            DESCRIPTION "A shugenja who communes with the spirits of fire must learn to still them, lest the flames they conjure consume the shugenja. The trick is to stoke the kami's wrath briefly but intensely, so that it is exhausted that much more quickly. With a few words and a rising gesture, the shugenja inhales, drawing the flames to a searing glow, then exhales, letting them settle to embers."
            ACTIVATION "As a Support action, make a TN 3 Theology (Fire) check targeting up to three mundane sources of fire at range 0-3."
            EFFECTS "If you succeed, you summon the fire kami's energy into yourself. Extinguish each target flame and remove 1 fatigue per target source of fire extinguished."
            OPPORTUNITIES {
                "Fire (op)(op): Also end all persistent effects from other Fire invocations and flame-based supernatural effects in the area."
            }
        }

        #orPoOAzUjZe7O1yz4NpGD7 ^"Fukurokujin's Wit" DEF {
            RANK 1
            DESCRIPTION "Shujenja are scholars at their heart, for their art is one of long hours of study and dedication to the refinement of the mind. Thus, many seek the blessing of Fukurokujin, keeper of knowledge and patron to scholars. A shugenja can call upon the guidance of this Fortune to sharpen their mind to a razor edge and vitalize their nerves."
            OTHER_NAMES "Wisdom of the Kitsu (Ancestral), Ignite the Mind's Candle (Elemental), Mantra of the Scholar Kings (Foreign)"
            ACTIVATION "As a Support action, make a TN 1 Theology (Fire) check targeting yourself."
            EFFECTS "If you succeed, you augment your target's wits and cunning. When making checks, the target adds a kept (ring) set to a (su) result. Persists for one round, plus additional rounds equal to bonus successes."
            OPPORTUNITIES {
                "Fire (op): You may target another character at range 0-2 instead of yourself."
            }
        }

        #F2OWZGlDOzC9BgL15XXNz4 ^"Fury of Osano-wo" DEF {
            RANK 3
            DESCRIPTION "The Fortune of Fire and Thunder, Osano-wo is the mythical son of the Kami Hida. With a sudden, harsh incantation and downward gesture, a shugenja can conjure a bolt of lightning to strike foes with a powerful blast."
            OTHER_NAMES "Orbs of Heavenly Fire (Alchemy), Hochiu's Final Stand (Ancestral), Reap the Sparking Seeds (Elemental)"
            ACTIVATION "As an Attack action, make a TN 5 Theology (Fire) check targeting one character at range 0-4. Can only be performed outdoors. If the weather is already stormy, reduce TN by 1."
            EFFECTS "If you succeed, you call forth lightning to smite your target. The target suffers supernatural damage equal to your Fire Ring plus three times your bonus successes. If a target is ^\"Incapacitated\" by this damage, they suffer a ^\"Critical Strike\" with severity 8."
            OPPORTUNITIES {
                "Fire (op): The target and any other characters at range 0-2 must make a TN 3 ^\"Meditation\" check (Air 4, Water 1) or suffer ^\"Dazed\" and strife equal to three times your Fire Ring."
                "Fire +(op): Increase severity of any critical strikes inflicted as part of this action by 2 per (op) spent this way."
            }
        }

        #38zjqES537U7MWEi2hHOSe ^"Katana of Fire" DEF {
            RANK 1
            DESCRIPTION "The shugenja takes a kenjutsu posture, holding their hands aloft or in a guarded position, and a burst of fire swirls into existence in their grip in the shape of a sword. This blade weighs nearly nothing, but its edge cuts like fine steel, leaving blazing trails of light in the air behind it and scorching cuts through any flesh it crosses."
            OTHER_NAMES "Forging Fire into Steel (Alchemy), Echo of Short (Ancestral), Sword of Osano-Wo (Fortunist)"
            ACTIVATION "As a Support action, make a TN 1 Theology (Fire) check to summon forth a blade of flame."
            EFFECTS "If you succeed, you summon and ready a ^\"Katana\" made of fire. It has the ^\"Wargear\" quality. Damage inflicted with this weapon is supernatural rather than physical. Persists until the end of any turn in which it leaves your grip or until end of scene."
            OPPORTUNITIES {
                "Fire (op): The weapon can be any kind of melee weapon instead of a katana."
                "Fire (op): You may immediately perform a Strike action using the weapon."
                "Fire (op): You may summon and ready a pair of weapons instead."
                "Fire (op): After you perform an Attack action with the weapon, each target must resist with a TN 3 ^\"Fitness\" check (Air 4, Water 1) or suffer ^\"Burning\"."
            }
        }

        #DZjOEyXTBINt0wr4vmtox4 ^"Matsu's Battlecry" DEF {
            RANK 1
            DESCRIPTION "The shugenja calls to kami of war and flame with an ancient chant, and the calamitous spirits of the battledin roar back, inciting fury within nearby targets. This can drive foes to rash acts, or inspire a dread bravery in allies."
            OTHER_NAMES "Embracing the Flames (Elemental), Haze of Battle (Foreign), Hotei's Curse (Fortunist)"
            ACTIVATION "As a Scheme action, make a Theology (Fire) check targeting a number of characters up to your Fire Ring at range 0-2. TN equals the highest vigilance among your targets."
            EFFECTS "If you succeed, you summon an illusion of a hellish scene only the target can perceive. The target receives 1 strife plus additional strife equal to bonus successes, and must resist with a TN 3 ^\"Meditation\" check (Air 4, Water 1) or immediately suffer ^\"Enraged\"."
        }

        #uIvUtFDQoVVXcmj9B1d0W1 ^"Ravenous Swarms" DEF {
            RANK 3
            DESCRIPTION "The shugenja ignites a number of candles and hurls them into the air, and the flames leap forth, quickly devouring the tallow before subsiding into smaller fiery motes. These settle around the shugenja’s shoulders or near their feet, sputtering cheerily and spitting out sparks that seek to spread and multiply. In addition to providing a (dangerous) source of light, these flames can also leap onto anyone the shugenja attacks."
            OTHER_NAMES "Forgotten Fury of Asahina (Ancestral), Dancing Orbs of Flame (Elemental), Inari's Kitsunebi (Fortunist)"
            ACTIVATION "As a Support action, make a TN 3 Theology (Fire) check targeting one position containing a flammable object at range 0-1. The object is consumed."
            EFFECTS {
                "If you succeed, you summon fiery motes equal to your Fire Ring plus the ^\"Silhouette\" of the object consumed. When you succeed at an Attack action, you may spend motes up to your school rank to add one bonus success per mote spent. Persists until end of scene."
                "After you perform a Fire invocation, you summon one additional fiery mote. Persists until end of scene."
            }
            OPPORTUNITIES {
                "Fire (op): The motes only set nearby objects on fire when you will them to, rather than haphazardly."
                "Fire (op): When you defend against damage, you may spend motes up to your Fire Ring to reduce damage by 1 per mote spent."
            }
        }

        #h4591ExTW4T6LwF2uKSlHL ^"Rise, Flame" DEF {
            RANK 4
            DESCRIPTION "A humanoid form wrought of flame, garbed in a flowing robe of cinder and smoke, with hair of trailing sparks, a manifest fire kami is an alluring and terrible sight to behold. Where its gaze passes, flames arise, and only ash remains in its wake."
            OTHER_NAMES "Bulb of Incarnation (Alchemy), Guardian of Fire (Ancestral), Uzume's Handmaiden (Fortunist)"
            ACTIVATION "As a Support action, make a TN 6 Theology (Fire) check targeting one position containing flammable material at range 0-3."
            EFFECTS "If you succeed, you summon a Manifest Fire Kami. It consumes the flammable material, appearing in its position. It obeys you for two rounds, plus additional rounds equal to bonus successes, taking its turn immediately after yours. When this effect ends, it departs or follows its own directives (will not attack you unless provoked)."
            OPPORTUNITIES {
                "Fire (op): The fire kami bursts forth in searing flame. Each character at range 0-2 must resist with a TN 4 ^\"Fitness\" check (Air 5, Water 2) or suffer ^\"Burning\" and ^\"Dazed\"."
                "Fire +(op): The fire kami consumes one additional flammable source in range per (op) spent this way. Increase its endurance by the silhouettes of all consumed objects."
                "Fire (op): When the fire kami's fatigue exceeds its endurance, it detonates. Each character at range 0-3 must resist with a TN 5 ^\"Fitness\" check (Air 6, Water 3) or suffer supernatural damage equal to two times your Fire Ring and ^\"Burning\" and ^\"Dazed\"."
            }
        }

        #rkOv3bnv9EZZMingEY7idT ^"The Cleansing Fire" DEF {
            RANK 1
            DESCRIPTION "With a roared incantation, the shugenja spreads their hands wide and a circle of fire spills forth, rippling across the ground and searing everything in its path. These flames are indiscriminate, hungrily lapping at friend, foe, and inanimate object alike."
            OTHER_NAMES "Anointment of the Fire Dragon (Alchemy), Merciful Rage of Isawa (Ancestral), The Peace of Osano-Wo (Fortunist)"
            ACTIVATION "As an Attack action, make a TN 1 Theology (Fire) check targeting each other character at range 0-2."
            EFFECTS "If you succeed, you smite each target with a roaring burst of fire. Each target suffers ^\"Dazed\" and must resist with a TN 3 ^\"Fitness\" check (Air 4, Water 1) or suffer supernatural damage equal to your Fire Ring plus their shortfall and ^\"Burning\"."
        }

        #nvY36ye8hXc8IVKTxkjJpa ^"The Fires from Within" DEF {
            RANK 1
            DESCRIPTION "The incantation to call fire is guttural and raw. Even as the words echo, the shugenja’s hands snap open, and motes of flame trail from their fingertips, searing their way toward the objects of the shugenja’s ire. If the shugenja has the strength of will to maintain their focus, they can direct the motes with amazing precision and burn tiny, searing holes in their targets. However, if the shugenja lets their heart swell with wrath or fury, the motes bloom into tiny infernos that seek to consume anything they hit and leave only ash."
            OTHER_NAMES "The Illuminating Light of Asako (Ancestral), The Riddle of Hotei (Fortunist), Extending the Fire-Heart (Foreign)"
            ACTIVATION "As an Attack action, make a TN 3 Theology (Fire) check targeting a number of characters up to your Fire Ring at range 1-3."
            EFFECTS "If you succeed, you smite each target with a stream of fire. Each target suffers supernatural damage equal to your Fire Ring plus bonus successes."
            OPPORTUNITIES {
                "Fire +(op): Treat maximum range as 1 higher per (op) spent this way."
            }
        }

        #nki0fc98BKM2NmzKMLB8hv ^"The Soul's Blade" DEF {
            RANK 5
            DESCRIPTION "The shugenja extends a hand toward the sky and makes a dangerous appeal, calling for a heavenly weapon with which to vanquish their enemy. If the invocation is performed properly and the shugenja’s cause is judged worthy, the sky cracks and a thunderbolt descends from the heavens, blasting through anything in its path. It lands writhing in the shugenja's hand, forming a weapon that appears in the shape pictured in the shugenja's mind. Be it the hide of a great beast or the sorcerous ward of a mahō-tsukai, there is nothing this blade of judgment cannot pierce."
            OTHER_NAMES "Talon of the Fire Dragon (Alchemy), Heavenly Petal of the Chrysanthemum (Ancestral), Mountain Splitter (Foreign)"
            ACTIVATION "As a Support action, make a TN 4 Theology (Fire) check to summon forth a blade of pure energy."
            EFFECTS "If you succeed, you summon and ready a ^\"Katana\" or ^\"Naginata\" made of searing, crackling energy. Attacks made with this weapon inflict supernatural damage and ignore all forms of resistance. Persists until it leaves your grip or until end of scene."
            OPPORTUNITIES {
                "Fire (op): The weapon can be any kind of melee weapon instead."
                "Fire (op): You may immediately perform a Strike action using the weapon."
                "Fire (op): You may summon and ready a pair of weapons instead."
                "Fire (op): One character you choose other than yourself may wield the weapon."
                "Fire (op)(op): After you perform an Attack action with the weapon, each target must resist with a TN 4 ^\"Fitness\" check (Air 5, Water 2) or suffer ^\"Dazed\"."
            }
        }

        #0889Wdi3EAE2y5Qz0MEBmx ^"Wall of Fire" DEF {
            RANK 2
            DESCRIPTION "A roiling wall of fire sends a very specific message: approach and die in a manner most awful. Shugenja who commune with fire spirits can summon forth such blazing warnings with relative ease, brushing oil or powder across the ground and then igniting it with a word of invocation. The wall of fire sparks to life with great force and extends up a few yards for several moments, but it maintains its intensity only so long as it has fuel."
            OTHER_NAMES "Igniting Powder of Combusting Ash (Alchemy), Chasing Osano-Wo (Fortunist), Walls of the Fire Palace (Foreign)"
            ACTIVATION "As an Attack and Support action, make a TN 4 Theology (Fire) check targeting two positions at range 2-4."
            EFFECTS "If you succeed, you summon a wall of flame between the target points that extends to range 1 in thickness and range 3 in height; this area counts as ^\"Dangerous\" terrain. Persists for one round plus additional rounds equal to bonus successes. Any character standing where the wall erupts suffers ^\"Dazed\" and must resist with a TN 2 ^\"Fitness\" check (Air 3, Water 1) or suffer supernatural damage equal to your Fire Ring and ^\"Burning\"."
            OPPORTUNITIES {
                "Fire (op): The wall of fire also counts as ^\"Entangling\" or ^\"Obscuring\" terrain (choose one)."
            }
        }

        #n4T4nj5iTvjdqhQWxWxX9g ^"Wings of the Phoenix" DEF {
            RANK 4
            DESCRIPTION "The shugenja leaps into the air, and fiery wings burst forth behind them, carrying them into the sky. Small motes of flame fall in the wake of the shugenja’s passing, igniting the ground cover before fading into delicate feathers of ash."
            OTHER_NAMES "Isawa's Ascent (Ancestral), Flameform Transmutation (Alchemy), Hachiman's Fiery Steed (Fortunist)"
            ACTIVATION "As a Support action, make a TN 4 Theology (Fire) check targeting yourself."
            EFFECTS "If you succeed, you augment yourself with wings of flame. These flames do not harm you. You can move vertically and horizontally freely and ignore terrain while flying. Persists one round, plus additional rounds equal to bonus successes. While persisting, any terrain you fly over at range 0-3 is ignited and becomes ^\"Dangerous\" terrain until the beginning of your next turn; each character within suffers ^\"Dazed\" and must resist with a TN 2 ^\"Fitness\" check (Air 3, Water 1) or suffer supernatural damage equal to your Fire Ring and ^\"Burning\"."
            OPPORTUNITIES {
                "Fire +(op): While flying, carry up to one additional willing character at range 0-2 per (op) spent this way."
                "Fire (op)(op): This effect persists until end of the scene instead."
            }
        }

        # ==================
        # WATER INVOCATIONS
        # ==================

        # Water invocations grant the shugenja speed and quick reflexes,
        # as well as the ability to heal injuries and calm the fevered mind.

        #PwLDwQgQYFflDkoPz3WLcd ^"Bō of Water" DEF {
            RANK 1
            DESCRIPTION "A shugenja can invoke the spirits in a nearby pool or stream to take the form of a weapon. This weapon can change form at the bearer’s will, swirling from a staff into a blade in the blink of an eye, and back again."
            OTHER_NAMES "Kaimetsu-o's Paddle (Ancestral), Ebisu's Walking Stick (Fortunist), Staff of the Sorcerer (Foreign)"
            ACTIVATION "As a Support action, make a TN 1 Theology (Water) check to summon a staff made of water from a nearby pool, stream, or airborne vapor."
            EFFECTS "If you succeed, you summon and ready a ^\"Bō\" made of water. It has the ^\"Snaring\" quality. At the end of each round, you may transform this weapon into a different melee weapon. Persists until end of any turn in which it leaves your grip or until end of scene."
            OPPORTUNITIES {
                "Water (op): The weapon can be any kind of melee or ranged weapon instead."
                "Water (op): You may immediately perform a Strike action using the weapon."
                "Water (op): When performing an Attack action with this weapon, treat its minimum or maximum range as 1 higher or lower."
            }
        }

        #bf5kcDp6gIfovmOxYm8lCT ^"Dance of Seasons" DEF {
            RANK 2
            DESCRIPTION "A skilled shugenja can entreat the kami to change the world around them through a rite that seems as much performance as invocation. As the shugenja dances, the water kami mirror the movements and shift the moisture around them from water to ice to vapor and back again. A skilled shugenja might be able to use this to entrap the unwary, drenching them in the waters of a summer storm before plunging them into the frozen heart of winter."
            OTHER_NAMES "Salt of Seasonal Change (Alchemy), Kuriko's Earnest Wish (Ancestral), Spinning Uzume's Wheel (Fortunist)"
            ACTIVATION "As a Movement and Support action, make a TN 3 Theology (Water) check targeting one position containing water (pool, river, snow/ice, mist) at range 1-3."
            EFFECTS "If you succeed, you summon the essence of the seasons to freeze, thaw, or evaporate water at range 0-1 of the target position. Ice becomes solid ^\"Dangerous\" terrain. Vapor creates ^\"Obscuring\" terrain. Mud becomes ^\"Entangling\" terrain. Water within living beings is unaffected."
            OPPORTUNITIES {
                "Water +(op): Choose one additional target position per (op) spent this way."
                "Water +(op): Attempt to encase in ice one character in the affected area per (op) spent this way. Each must resist with a TN 3 ^\"Fitness\" check (Earth 1, Fire 4) or suffer ^\"Immobilized\" and ^\"Disoriented\"."
            }
        }

        #vq88zxQr2hbdo1gHvYKeXr ^"Dominion of Suijin" DEF {
            RANK 1
            DESCRIPTION "A shugenja deeply attuned to the kami of water can see other places in watery reflections. Incredibly powerful practitioners can even use this reflection to transport themself and others to the desired place through the water—even if they arrive slightly damp."
            OTHER_NAMES "Iuchi's Window (Ancestral), All Rivers Meet Again (Elemental), Spies of the Garden Pond (Foreign)"
            ACTIVATION "As a Movement and Scheme action, make a TN 2 Theology (Water) check targeting one position containing a body of water at range 0-1."
            EFFECTS "If you succeed, you scry in the ripples. The target body of water displays an image of a second body of water of your choice and its surroundings as if the onlooker were just below the surface. The second body must be at range 0-6 and you must have concrete knowledge of it."
            OPPORTUNITIES {
                "Water (op): You can also hear (very muffled) noises through the pool."
                "Water (op): Only you can see the vision; to others, the pool shows no images."
                "Water (op): The location can be any distance from you (but must still be familiar)."
                "Water (op)(op): You may use clouds, fog banks, snow, or sheets of ice as bodies of water for this technique."
                "Water (op)(op)(op): You and a number of characters up to your Water Ring may pass through a temporary portal to the other location. One way only; you arrive soaked."
            }
        }

        #jklNqnTkhfW3wr7iP0IWFP ^"Ever-Changing Waves" DEF {
            RANK 5
            DESCRIPTION "A shugenja might have lived as a bird, a wolf, a plant, and humans of various stations before being born into their current position in the Celestial Order. All of these existences are separate, and yet they are inexorably bound. By following the bond backward, a shugenja adept in communing with the water kami can reshape their own flesh to mirror a past form— albeit briefly—transforming into a natural animal or supernatural beast for a short time."
            OTHER_NAMES "Elixir of Transmuting Form (Alchemy), Blessing of Megumi (Fortunist), Myriadic Forms (Foreign)"
            ACTIVATION "As a Support action, make a TN 4 Theology (Water) check targeting yourself."
            EFFECTS "If you succeed, you augment your body, transforming it into that of a natural animal of ^\"Silhouette\" 2. While in this form, use its ring values, derived attributes, abilities, and advantages with the physical or social type, but your own skill ranks and advantages with the mental or spiritual type. Persists until you choose to end it or are rendered ^\"Unconscious\". Do not remove fatigue or strife when reverting; if this causes fatigue to exceed endurance (or strife to exceed composure), suffer a ^\"Critical Strike\" with severity 5 (or become ^\"Compromised\")."
            OPPORTUNITIES {
                "Water (op): Transform into a different sentient species."
                "Water (op): Transform into an Otherworldly being, such as a supernatural beast."
                "Water +(op): Choose a new form of silhouette 1 higher or lower per (op) spent this way (min 0, max 6)."
            }
        }

        #ppc9oDk4evzd6leQJ1IEHa ^"Hands of the Tides" DEF {
            RANK 3
            DESCRIPTION "Water binds all living beings, and by communing deeply with the vital spirits that flow through everything, a shugenja can master many arts. Using this esoteric invocation, a shugenja can exchange the positions of living beings near one another, throw enemies off-balance, or put allies in a position of advantage. While the Elemental Masters have been known to debate whether the water spirits shift the targets or reshape the world around them, the effect of the invocation—shuffling the positions of a number of individuals in a small radius as the shugenja sees fit—is easy to understand, if hard to comprehend."
            OTHER_NAMES "Tracing the Lifeblood (Alchemy), Ikoma Tumbles with Akodo (Ancestral), Suijin's Command (Fortunist)"
            ACTIVATION "As a Movement action, make a TN 5 Theology (Water) check targeting yourself and a number of other characters up to your Water Ring at range 1-4."
            EFFECTS {
                "If you succeed, you summon the targets. You may cause them to exchange their positions in space. Each target's original position must be occupied by a target, and each target must occupy a position."
                "Each target receives 2 strife."
            }
            OPPORTUNITIES {
                "Water +(op): Choose a new stance for one target per (op) spent this way."
            }
        }

        #YhsrUsNdIExy7aarFIb0Tq ^"Heart of the Water Dragon" DEF {
            RANK 2
            DESCRIPTION "The shugenja traces a gentle pattern on the target’s skin with purified water, calling upon the water kami in their body to protect and mend the flesh they call home. The target becomes extremely resistant to invocations, sorcery, and other supernatural abilities; summoned flames ripple off their skin harmlessly, and baleful maledictions pass over the targets."
            OTHER_NAMES "Vapors of Goodwill (Alchemy), Walking Beside Jurōjin (Fortunist), Mark of Resistance (Foreign)"
            ACTIVATION "As a Support action, make a TN 3 Theology (Water) check targeting one character at range 0-2."
            EFFECTS "If you succeed, you augment your target with spiritual fluidity. The target gains supernatural resistance equal to your Water Ring and removes 1 fatigue at the end of each round. Persists for one round, plus additional rounds equal to bonus successes. Each target cannot be affected by this invocation again until end of scene."
            OPPORTUNITIES {
                "Water (op)(op): When the target succeeds on a check to resist the effect of a kihō, ^\"Mahō\", or invocation, the character who used the technique must also make the check to resist that effect, or suffer the effect themself."
            }
        }

        #cKo7SprmGNURr6WzKjNbhC ^"Inari's Blessing" DEF {
            RANK 1
            DESCRIPTION "Water is life, and water kami can provide life-giving gifts of food and drink even from the most desolate environments. After the shugenja performs the invocation, the land nearby flourishes with life, delivering food to the shugenja, and pure water springs from the ground. This food is simple and nourishing, and it can be cooked or even packed away as rations for later if needed."
            OTHER_NAMES "Miya's Gift (Ancestral), Feast of the Water Kami (Elemental), Oasis in the Desert (Foreign)"
            ACTIVATION "As a Support action, make a TN 2 Theology (Water) check targeting one position at range 1."
            EFFECTS "If you succeed, you summon a meal at the target position that can feed a number of people up to your Water Ring plus bonus successes."
            OPPORTUNITIES {
                "Water (op): The meal is particularly fortifying. Any character who partakes during downtime removes fatigue equal to your Water Ring."
                "Water +(op): The meal can feed people equal to your Water Ring plus bonus successes times (op) spent this way instead."
            }
        }

        #F2o0nLWXD2ZlK9J1o0RCpG ^"Path to Inner Peace" DEF {
            RANK 1
            DESCRIPTION "By communing with the water kami that dwell within the body, a shugenja can right imbalances and correct the flow of ki, speeding the recovery of stamina dramatically."
            OTHER_NAMES "Jurōjin's Kiss (Alchemy), Transcendence of Asako (Ancestral), Touch of the Hot Springs (Elemental)"
            ACTIVATION "As a Support action, make a TN 2 Theology (Water) check targeting yourself or another character at range 0-2."
            EFFECTS "If you succeed, you mend your target's exhausted muscles. The target removes fatigue equal to your Water Ring plus bonus successes. Each target cannot be affected by this invocation again until end of scene."
            OPPORTUNITIES {
                "Water (op): Choose one condition: ^\"Bleeding\", ^\"Dazed\", ^\"Disoriented\", or Lightly Wounded. Remove that condition from each target."
                "Water (op): Your target also removes strife equal to your bonus successes."
            }
        }

        #qz7ErNaO2gYWCc2MWV95Km ^"Reflections of P'an Ku" DEF {
            RANK 1
            DESCRIPTION "Water kami are notoriously covetous, and things lost to the depths rarely resurface. Still, this avarice can offer advantages. A shugenja learned in this art can call forth water spirits to recognize an item by submerging it in sacred water. The water spirits often provide cryptic answers, but they usually can grant the shugenja a good idea of an item’s composition, whether it possesses any mystical properties, and the general disposition of these traits."
            OTHER_NAMES "Agasha's Vast Wisdom (Ancestral), Rumors of the Water Kami (Elemental), Whispers of the Steel (Foreign)"
            ACTIVATION "As a Scheme action, make a TN 2 Theology (Water) check targeting one item at range 0-1."
            EFFECTS "If you succeed, you scry to uncover all properties an item possesses, including its name, maker, mundane qualities, magical properties, curses, and sealed techniques (nemuranai)."
            OPPORTUNITIES {
                "Water (op): Gain knowledge of the item's origin in broad strokes (where it was forged, the clan of the individual who carried it longest, or similar)."
                "Water (op): Target a character instead. Identify one invocation, kihō, mahō, or supernatural ability or item they possess, along with its name and general qualities."
            }
        }

        #i69RClcbahfKFcRPV7qlgZ ^"Rise, Water" DEF {
            RANK 4
            DESCRIPTION "Water kami are nurturing, for water fosters all life. However, like all nature spirits, they are beings of destruction and creation; calling a water kami to take manifest form is to summon a potent force indeed. A manifest water kami often takes a humanoid form, rising from a nearby lake, river, or ocean and carried aloft on a crushing wave. As water splits into rivulets, so a manifest water kami can split into multiple smaller beings, each one surging forth to devastate the foe."
            OTHER_NAMES "Wine of Invocation (Alchemy), Guardian of Water (Ancestral), Isora's Attendant (Fortunist)"
            ACTIVATION "As a Support action, make a TN 6 Theology (Water) check targeting one position containing a large quantity of water at range 0-3."
            EFFECTS "If you succeed, you summon a Manifest Water Kami to fight for you. It appears from the targeted body of water and obeys you for two rounds, plus additional rounds equal to bonus successes, taking its turn immediately after yours. When this effect ends, it departs or follows its own directives (will not attack you unless provoked)."
            OPPORTUNITIES {
                "Water (op): The water kami attempts to swallow anyone inside it; each must resist with a TN 4 ^\"Fitness\" check (Earth 2, Fire 5) or be pulled in and begin suffocating. As an action, a trapped character may make a TN 3 ^\"Fitness\" check (Earth 1, Fire 4) to escape."
                "Water (op): Upon arrival, the water kami may move range bands up to your Water Ring."
                "Water +(op): Split the manifest water kami into smaller manifest water kami equal to (op) spent this way. Each has endurance equal to 12 divided by number of (op) spent (rounded up)."
            }
        }

        #jB7KiIYjN8UGeumpf9PRAG ^"Stride the Waves" DEF {
            RANK 2
            DESCRIPTION "Guided by the spirits of water, the character can slide effortlessly across the surface of a stormy sea, ride a current of water out of the ocean, or even plunge beneath its depths, breathing the brine as though it were air."
            OTHER_NAMES "Elixir of Cork Properties (Alchemy), Kaimetsu-o's Road (Ancestral), Walking the Water Garden (Fortunist)"
            ACTIVATION "As a Support action, make a TN 2 Theology (Water) check targeting one character at range 0-2."
            EFFECTS "If you succeed, you summon a buoyant current. Even if the target cannot normally swim, they can control where they move in or on water. The target ignores negative effects of terrain while in water and does not suffocate while underwater. Persists until end of scene."
        }

        #QhyO3TjTjlHFo994VMePla ^"Strike the Tsunami" DEF {
            RANK 3
            DESCRIPTION "Upending the contents of a water pouch or reaching into a nearby lake or stream, the shugenja pulls out an impossibly large torrent that slams into several foes nearby, pushing them back or dragging them forward as the shugenja wills."
            OTHER_NAMES "Bottle of Oceanic Storms (Alchemy), Suitengu's Arrow (Fortunist), Calling the Wave (Foreign)"
            ACTIVATION "As an Attack action, make a TN 4 Theology (Water) check targeting a number of characters up to your Water Ring at range 0-3. Must have a source of water."
            EFFECTS "If you succeed, you smite your targets with a spray of water. Each target suffers supernatural damage equal to your Water Ring plus bonus successes. Each target must resist with a TN 3 ^\"Fitness\" check (Earth 1, Fire 4); you may move each target who fails range bands up to their shortfall in any direction."
            OPPORTUNITIES {
                "Water (op): Each target who fails the check to resist also suffers ^\"Bleeding\"."
            }
        }

        #IuPbSpskAqfARgk1lcVSfz ^"Suijin's Embrace" DEF {
            RANK 4
            DESCRIPTION "A shugenja with the proper knowledge—and the will to wield it—can inflict a drowning death upon their enemy, transforming the air in their lungs into seawater and killing them as surely as throwing them off a pier while tied to a heavy stone."
            OTHER_NAMES "The Ocean in a Drop (Alchemy), Following Doji's Steps (Ancestral), Kissing the Water Kami (Elemental)"
            ACTIVATION "As an Attack action, make a TN 4 Theology (Water) check targeting one character at range 1-3."
            EFFECTS "If you succeed, you smite your target with lungfuls of seawater. The target suffers supernatural damage equal to your Water Ring plus two times bonus successes. If a target's fatigue exceeds their endurance this way, the target begins to suffocate for rounds equal to your Water Ring plus bonus successes or until you release them as a Support action."
        }

        #lxGvcBNlSjehHqUT3zoFUv ^"Sympathetic Energies" DEF {
            RANK 2
            DESCRIPTION "Water kami flow through all living beings, and a shugenja can use their winding channels to transfer boons and curses alike between individuals."
            OTHER_NAMES "Compassion of Shinjo (Ancestral), Suijin Is Generous (Fortunist), Desert Pollen (Foreign)"
            ACTIVATION "As a Support action, make a TN 2 Theology (Water) check to spread one chosen persistent invocation effect across a number of targets equal to your Water Ring at range 0-1."
            EFFECTS "If you succeed, you augment the spiritual power of one persistent invocation effect already affecting one target. Each other target counts as being affected by it as well. Persists as long as the original effect persists on the original target."
            OPPORTUNITIES {
                "Water (op)(op): Choose a condition the target is suffering instead of a persistent invocation effect."
            }
        }

        #quZAMCVlPWiE1TbXNbhTeF ^"The Rushing Wave" DEF {
            RANK 1
            DESCRIPTION "The shugenja calls the torrent as their steed and rides it, pulling a wave of water from a nearby lake, pond, river, or ocean to propel them forward at incredible speed."
            OTHER_NAMES "Utaku's Waterborne Steed (Ancestral), The Clay Kobune (Alchemy), Isora's Spinning Dance (Fortunist)"
            ACTIVATION "As a Movement action, make a TN 2 Theology (Water) check targeting one character at range 0-1. Must have a large source of water nearby."
            EFFECTS {
                "If you succeed during a skirmish, you summon a rushing waterspout that propels the target. The target may immediately move 1 range band, plus additional range bands equal to bonus successes."
                "If you succeed during a narrative or downtime scene, you summon a gentle current that doubles the target's speed across or through water. Persists until end of scene."
            }
        }

        RULES {
            #L5R310gH2iJ4kL6mN8oP0q: invocations_require_shugenja_school
            #L5R311rS3tU5vW7xY9zA1b: invocations_use_theology_check
            #L5R312cD4eF6gH8iJ0kL2m: invocations_no_void_element
            #L5R313nO5pQ7rS9tU1vW3x: importune_invocations
            #L5R310aB2cD4eF6gH8iJ1k: proper_offerings_reroll_blanks
            #L5R310bS3tU5vW7xY9zA2c: channeling_reserved_dice
            #L5R310cD4eF6gH8iJ0kL3m: spiritual_backlash_3_strife_on_kept
            #L5R310dO5pQ7rS9tU1vW4x: prepared_invocations_and_wards
        }
    }

    # ===========================
    # RITUALS (ritual) — CEREMONIAL TECHNIQUES
    # ===========================

    ^"Ritual" DEF {
        APPLIES TO [^"Samurai", ^"Adversary"]

        # Rituals are religious ceremonies performed to appease the kami
        # and draw forth their blessings. Unlike invocations, rituals are
        # not the rarefied secrets of shugenja schools; instead, they are
        # day-to-day practices performed by many religious functionaries
        # throughout Rokugan. Most priests, shrine keepers, and court
        # mystics know and perform rituals regularly. Many monks and
        # shugenja also know how to perform rituals.
        #
        # Symbol: (ritual)
        # Available to: Schools listing "rituals" among available techniques
        # Activation: During downtime (and potentially other scenes at GM's discretion)

        # ----- Rituals (alphabetical) -----

        #0ThQxz2j6q0FzktJJUhQXK ^"Cleansing Rite" DEF {
            RANK 1
            DESCRIPTION "The ritualist sanctifies a person or group, anointing them with sacred substances that drive out unholy presences and malign sorcery."
            ACTIVATION "As a downtime activity, make a TN 3 Theology (Void) check targeting up to five characters to remove spiritual contaminants from the targets before they spread. Note: this cannot remove a ^\"Shadowlands Taint\" disadvantage once it has taken hold, but it can prevent this spiritual contamination from taking root after a character is exposed."
            EFFECTS "If you succeed, remove the ^\"Afflicted\" condition from the target."
            OPPORTUNITIES {
                "Void (op)(op): If one or more targets is an ^\"Otherworldly\" being, you become aware of it after completing the ritual — but you do not know which target."
                "Void (op)+: Choose one additional target per (op) spent this way."
                "Void (op)+: Instead of targeting characters, you may target an area encompassing a number of range bands around you equal to (op) spent this way. Remove the ^\"Defiled\" terrain quality from this area. If it is a deeply unhallowed place that has long been the domain of evil, the ^\"Defiled\" quality returns after one day, plus additional days equal to your bonus successes."
            }
        }

        #i2GEqhySgpp0wZ2MGeJZXo ^"Commune with the Spirits" DEF {
            RANK 1
            DESCRIPTION "The ritualist centers their mind on one of the Elements, appealing to the spirits in their environment and seeking their counsel or boon. Priests and laypeople are able to use this ritual to receive less specific guidance from the spirits, such as a leaf that falls to the ground pointing in the direction of the person or thing they are seeking."
            ACTIVATION "As a downtime activity or Support action, make a TN 1 Theology check using Air, Earth, Fire, Water, or Void to appeal to nearby spirits of that Element (appeal to the departed, such as ancestor spirits, and other non-elemental supernatural presences if using Void) for aid."
            EFFECTS "If you succeed, choose and receive one of the following boons: (1) Sense the Kami — Detect all spirits and uses of their magic by shugenja within a number of range bands equal to the ring you used plus your bonus successes. (2) Spiritual Knowledge — Learn one fact the spirits know about the area. (3) Elemental Gift — The kami deliver a small amount of the Element in question to you (e.g., rain from water kami, sparks from fire kami, a gust from air kami, a stone from earth kami, or a found ancestor's belonging from Void)."
            OPPORTUNITIES {
                "(op): Reduce the TN of your next check to interact with or appeal to kami or supernatural presences of this Element by 1."
                "(op)+: If you succeed, receive one additional boon per (op) spent this way. Each boon can only be received one time per activation."
            }
        }

        #bNxt2ZFUbgSKhc6XxSTMUh ^"Divination" DEF {
            RANK 1
            DESCRIPTION "The ritualist peers into a character’s future, ascertaining their fate from the patterns of the stars, the char marks upon animal bones, the placement of cast shells, or other omens they can read."
            ACTIVATION "As a downtime activity, make a TN 2 Theology (Void) check targeting one character to see glimpses of their future."
            EFFECTS "If you succeed, choose one of the following omens in the target's near future: (1) Omen of the Azure Dragon — The next time the target performs a check using an Artisan skill this game session, the target adds a kept (ring) set to an (su)(st) result. (2) Omen of the Black Tortoise — Same for a Scholar skill check. (3) Omen of the White Tiger — Same for a Martial skill check. (4) Omen of the Vermilion Bird — Same for a Social skill check. (5) Omen of the Weaver and the Cowherd — Same for a Trade skill check. If you fail, the GM chooses one of the above omens instead. The target cannot receive another divination until the next game session."
            OPPORTUNITIES {
                "(op): If you fail, an additional omen appears to you after the first. Choose one of the above omens in addition to the one the GM chose."
            }
        }

        #xPU8WmbyxLxC5CxRZEdt3b ^"Tea Ceremony" DEF {
            RANK 2
            DESCRIPTION "When Lady Doji served tea for the very first Emperor, the tea ceremony was born. Ceremony styles vary among the clans, from the gilded tea rooms of the Phoenix to the imperfect tea bowls of the Dragon, the early morning gatherings of the Crane to the snow- and moon-viewing ceremonies of the Scorpion. However, at its core the tea ceremony is fundamentally an appreciation of tea and, if done well, a spiritual moment for its participants. The tea represents all five elements: the fire used to heat the water, the earth from which the tea is grown, and the air that carries the aroma of the tea. Finally, void holds all four elements together, and brings in the mysterious fifth element, the moment of harmony and tranquility as one sips the tea."
            ACTIVATION "Once per game session, as a downtime activity using a tea set, make a TN 2 Performance (Void) check targeting yourself and a number of other characters up to your ranks in Culture, who are also participants. Up to one other participant may assist (see ^\"Assistance\")."
            EFFECTS "Each target removes 3 strife, plus additional strife equal to your bonus successes."
            OPPORTUNITIES {
                "(op): Reduce the TN of each target's next check by 1."
                "(op)+: Each target removes 1 fatigue, plus 1 fatigue per (op) spent this way."
                "(op)(op): If you succeed, each target gains 1 Void point."
            }
        }

        #AzCGIVbmmmxR18NvYcsqsZ ^"Threshold Barrier" DEF {
            RANK 1
            DESCRIPTION "The ritualist wards an entryway against beings of a certain sort, causing them to fail to observe the entryway or making them mentally repulsed by their efforts to enter it."
            ACTIVATION "As a downtime activity, make a TN 2 Theology check using Air, Earth, Fire, Water, or Void targeting a threshold, gate, or other entryway at range 0-1."
            EFFECTS "If you succeed, the threshold is barred against a particular entity type based on the ring chosen for one hour, plus additional hours equal to your bonus successes. When an entity of that type attempts to enter, it must resist with a TN 3 Meditation (Void) check or be repelled. Whether it succeeds or fails, you immediately become aware of its attempted entry. Entity types by ring: Air — Ethereal ^\"Otherworldly\" beings such as spirits and ghosts. Earth — Living ^\"Tainted\" beings. Fire — Undead beings with corporeal form. Water — Wild animals. Void — Humans."
            OPPORTUNITIES {
                "(op): Instead of protecting a threshold, you may protect the entirety of a sealed area extending a number of range bands around you no greater than your bonus successes."
                "(op): If any beings of the type you are sealing the threshold against have passed through the threshold within the last twenty-four hours, you become aware of their passage."
            }
        }

        RULES {
            #L5R314yZ6aB8cD0eF2gH4i: rituals_performed_during_downtime_or_other_scenes_at_gm_discretion
            #L5R315jK7lM9nO1pQ3rS5t: rituals_available_to_schools_listing_rituals
            #L5R316uV8wX0yZ2aB4cD6e: rituals_cannot_remove_taint_once_taken_hold
        }
    }

    # ===========================
    # SHŪJI (shūji) — SOCIAL TECHNIQUES
    # ===========================

    ^"Shūji" DEF {
        ALIAS "Shuji"
        APPLIES TO [^"Samurai", ^"Adversary"]

        # Shūji are social techniques, leveraging that most powerful of
        # human tools: communication. Shūji can be used in intrigues,
        # duels, skirmishes, and other types of conflicts as common sense
        # and the GM's discretion dictate.
        #
        # Symbol: (shūji)
        # Available to: Schools listing "shūji" among available techniques
        # Elemental classifications: Air, Earth, Fire, Water, Void

        # ----- Air Shūji -----
        # Air shūji are indirect, probing, and sometimes teasing. This
        # style of conversation revolves around setting up subtle traps
        # for others to fall into, then exploiting them. Air shūji hinge
        # on details rather than the bigger picture, controlling the scope
        # of conversation to deflect contrary evidence or logical argumentation.

        #VWaekx4sOx9p31xOOeVWoA ^"Artisan's Appraisal" DEF {
            RANK 2
            DESCRIPTION "The courtier looks at an object but sees its maker. Each thumbprint tells a story about the hand that crafted the piece; every subtle choice reveals something about the desires that linger in the artist’s mind."
            ACTIVATION "When assessing an object or performance with an Artisan skill (Air), Performance (Air), or Games (Air) check, you may spend (op) in the following ways:"
            OPPORTUNITIES {
                "Air (op): Choose a ring; learn the value of that ring for the creator or performer and all advantages and disadvantages attached to that ring that are not of the curse type."
                "Air (op): If the creator or performer is an NPC, learn their demeanor."
            }
        }

        #q8uBm6dX5qGw3c14Zes3o0 ^"Bend with the Storm" DEF {
            RANK 5
            DESCRIPTION "When faced with a much more powerful foe, a cunning courtier often feigns a position of weakness. In this way, they can lead the opponent where they desire by offering chances the foe cannot pass up."
            ACTIVATION "When you make a Social skill (Air) check targeting another character, you may spend (op) in the following way:"
            OPPORTUNITIES {
                "Air (op): Choose an advantage or disadvantage. The target comes to believe that you possess that advantage or disadvantage without your having to expend noticeable effort or state it directly. Further, the target believes that you do not know you have given this advantage or disadvantage away. If you do anything that could call this misconception into question, any character may resist with a TN 5 Sentiment check (Earth 6, Fire 3) to discern that the advantage or disadvantage is not real. This effect persists until the target is faced with incontrovertible evidence or succeeds on the check to resist."
            }
        }

        #CKeJWFjQNsec0w910GbkxC ^"Cadence" DEF {
            RANK 1
            DESCRIPTION "In courtly situations, it can be advantageous for courtiers of the same clan to be able to communicate wordlessly."
            ACTIVATION "When you make a Social skill (Air) check, you may spend (op) in the following ways:"
            OPPORTUNITIES {
                "Air (op): Convey a secret message that alters the meaning of what you are saying outwardly (or has nothing to do with it at all) to one character observing you who possesses this technique."
                "Air (op)(op): Convey a secret message that alters the meaning of what you are saying outwardly (or has nothing to do with it at all) to one character observing you who does not possess this technique."
            }
        }

        #HvkOd6sfKqveTIaT1XqFUK ^"Feigned Opening" DEF {
            RANK 2
            DESCRIPTION "A wise leader creates the impression of weakness to disguise strength, or strength to conceal weakness."
            ACTIVATION "As a Movement and Scheme action, make a Performance (Air) check targeting one character in the scene who is observing you. The TN is equal to the target's vigilance. This technique can only be used during skirmish and mass battle conflicts."
            EFFECTS "If you succeed, reduce the TN of the next Attack checks against each target (or their cohort, in a mass battle) by 1 plus your bonus successes. This effect persists until the end of your next turn."
            OPPORTUNITIES {
                "Air (op)+: Choose one additional target with vigilance lower than or equal to the original target's per (op) spent this way."
                "Air (op)+: In a mass battle, increase the TN of Attack checks targeting your cohort by 1, plus 1 per additional (op) spent this way."
            }
        }

        #8oUal3jbDPcxKD67zs8nqC ^"Prey on the Weak" DEF {
            RANK 2
            DESCRIPTION "Court is not a kind place, and a harsh word is no less cruel for being spoken softly and with perfect etiquette."
            ACTIVATION "As a Scheme action, make a TN 1 Courtesy (Air) check targeting a ^\"Compromised\" character."
            EFFECTS "If you succeed, your target must choose one of the following: (1) Immediately unmask in a manner of their choosing based on the circumstances. (2) Forfeit glory equal to your Air Ring plus your bonus successes to leave the scene."
            OPPORTUNITIES {
                "Air (op)+: If the target chooses to unmask, you learn one of their disadvantages of their choice per (op) spent this way."
                "Air (op)(op): If the target chooses to leave the scene, you notice their destination from the direction of their departure or overhear from the crowd where they will retreat."
            }
        }

        #byWI1ENLrPr1vx3ReJY6qJ ^"Rustling of Leaves" DEF {
            RANK 1
            DESCRIPTION "If everyone has heard a scandalous story, but it has no clear source, what can it be but true? The courtier cleverly spreads stories so none see them as the source."
            ACTIVATION "When you make a Social skill (Air) check to spread a rumor, you may spend (op) in the following way:"
            OPPORTUNITIES {
                "Air (op)+: Increase the TN of any check to trace the rumor back to you by 2 per (op) spent this way."
            }
        }

        #9joMTiwaMNeSp95EKmWY6s ^"The Wind Blows Both Ways" DEF {
            RANK 3
            DESCRIPTION "A word in the right ear at the right time can enhance the accomplishment of another, or a cutting slight can diminish their success in the eyes of those who matter."
            ACTIVATION "When you make a Courtesy or Performance (Air) check targeting another character, you may spend (op) in the following ways:"
            OPPORTUNITIES {
                "Air (op)+: The next time the target receives a glory award, increase the glory they gain by 1 per (op) spent this way. This effect persists until the end of the scene."
                "Air (op)+: The next time the target forfeits or stakes glory, increase the glory they must forfeit or stake by 1 per (op) spent this way. This effect persists until the end of the scene."
            }
        }

        #8QZaeUPiDjZFahmngR05R5 ^"Whispers of Court" DEF {
            RANK 1
            DESCRIPTION "Rumors are the currency of court, and when such news is in short supply, many courtiers simply spin it themselves. They use cunning schemes and plausible half-truths to bait their webs of intrigue."
            ACTIVATION "As a Scheme action, make a Courtesy (Air) check targeting each character in the scene. The TN of this check is equal to the lowest vigilance among your targets."
            EFFECTS "If you succeed, you create a rumor that sweeps across the room like a storm. Everyone in the scene hears it, and characters with vigilance lower than your bonus successes even come to give it some credence. If spreading a rumor is your social objective in an intrigue, you score rhetorical points equal to your Air Ring plus your bonus successes."
            OPPORTUNITIES {
                "Air (op): Learn one other rumor that is spreading in the current scene."
            }
        }

        #WNWIn3206q8LJV0QMByNHX ^"Wolf's Proposal" DEF {
            RANK 4
            DESCRIPTION "Being honorable is of the same value to a courtier as appearing honorable. True honor cannot be faked, but fortunately for many, the appearance of respectability can be fabricated."
            ACTIVATION "As a Scheme action, make a Courtesy or Performance (Air) check targeting any number of characters in the scene. The TN of this check is equal to the highest vigilance among your targets."
            EFFECTS "If you succeed, each target behaves as though your honor is 10 higher or lower than its actual value, plus or minus an additional 10 for each bonus success (to a maximum honor value of 100 or a minimum honor value of 0). If you do anything that could call your perceived honor into question, any target may resist with a TN 4 Sentiment check (Earth 5, Fire 2) to determine your actual honor attribute. This effect persists until the end of the scene."
            OPPORTUNITIES {
                "Air (op): Choose a character in the scene. Learn if their honor is higher or lower than yours (the actual value)."
            }
        }

        # ----- Earth Shūji -----
        # Earth shūji focus on building others up through a combination of
        # support, expectation, and pressure when needed. A character using
        # this rhetoric speaks at a measured pace, weighing words carefully
        # and developing an argument from the foundation up.

        #OeYj4seb4GneHX6VlWs6m3 ^"Ancestry Unearthed" DEF {
            RANK 1
            DESCRIPTION "A samurai’s ancestry often reveals a great deal about their political opportunities, assets, and probable allies in the Emerald Empire, for the rigid social strata allow little divergence. Any courtier can likely dredge up another samurai’s lineage from the dark corners of their mind, but some can recall it in an instant."
            ACTIVATION "When you make a Scholar skill (Earth) or Social skill (Earth) check targeting a character, you may spend (op) as follows:"
            OPPORTUNITIES {
                "Earth (op): You know one sworn oath the character's family took in the past, and whether or not they have broken or bent it."
                "Earth (op)(op): You know one secret of the character's family that they would prefer be forgotten, and have perhaps even worked to bury."
                "Earth (op)(op)(op): You know something the character does not even know about their own ancestry."
            }
        }

        #YRrwJlgAyPpVIMmg9hKPC4 ^"Civility Foremost" DEF {
            RANK 2
            DESCRIPTION "Samurai are warriors, but there are many contexts in which violence is inappropriate. Many strictures exist around the times weapons can and cannot be drawn. A courtier who has memorized the rules of such engagements can articulate why fighting would be improper or profane in nearly any situation."
            ACTIVATION "As a Scheme action, make a Command or Courtesy (Earth) check targeting one character to claim protection for an individual of your choice by rights of honor. The TN of the check is equal to the target's vigilance."
            EFFECTS "If you succeed, the target must forfeit honor equal to your Earth Ring plus your bonus successes and suffer that much strife to perform an Attack or Scheme action targeting the chosen individual. This effect persists until the end of the scene, or until the target performs an Attack or Scheme action."
            OPPORTUNITIES {
                "Earth (op)+: Choose one additional target with vigilance lower than or equal to your first target's vigilance per (op) spent this way."
            }
        }

        #mfl9jlCknrtobgA4Rc4Rmp ^"Honest Assessment" DEF {
            RANK 1
            DESCRIPTION "Honesty is a virtue of Bushidō, but direct honesty is often seen as rudeness among the samurai—instead, one is expected to find a polite way to imply one’s meaning to spare the feelings of the other involved. As a result, directness can be something of a rare and valuable commodity."
            ACTIVATION "As a Support action, make a TN 2 Courtesy (Earth) check to appraise the weaknesses of a character."
            EFFECTS "If you succeed, choose one of the target's known disadvantages. The target does not apply that disadvantage to their checks until the end of the scene."
            OPPORTUNITIES {
                "Earth (op)+: Choose one additional disadvantage per (op) spent this way."
                "Earth (op)(op): Reduce the TN of the target's next skill check using the ring the disadvantage is attached to by 2."
            }
        }

        #RTLqrkTuF0J8RJWpY3gkKA ^"Pillar of Calm" DEF {
            RANK 4
            DESCRIPTION "The character calls for reason to prevail and swords to be sheathed, appealing to a common ideal or greater threat that stands before the belligerent parties."
            ACTIVATION "As a Scheme and Support action, make a Command (Earth) check targeting a number of characters up to your Earth Ring times your school rank. The TN of this check is equal to the highest strife among the targets."
            EFFECTS "If you succeed while targeting all of the leaders involved in a conflict, you may de-escalate the conflict one level (from a mass battle to a skirmish, a skirmish to a duel, or a duel to an intrigue)."
            OPPORTUNITIES {
                "Earth (op)(op)+: You may de-escalate the conflict by one additional level per (op)(op) spent this way."
            }
        }

        #n1bPScWFDIHIP8vDn1nCBD ^"Stonewall Tactics" DEF {
            RANK 1
            DESCRIPTION "The courtier makes themself impossible for the target to ignore, raising a pressing concern that must be addressed first or even physically planting themself between a rival and their allies."
            ACTIVATION "When making a Social skill (Earth) or Martial skill (Earth) check targeting a character, you may spend (op) in the following way:"
            OPPORTUNITIES {
                "Earth (op)+: Increase the TN of any check the target makes that does not target you by 1 per (op) spent this way. This effect persists until the beginning of your next turn."
            }
        }

        #lT1wuCRy1xXQY9icJVke8t ^"Touchstone of Courage" DEF {
            RANK 3
            DESCRIPTION "Armies are rarely routed in the field; instead, most collapse when morale becomes impossible to maintain. As panic rises in the ranks, soldiers look to leaders to set an example. The character does just this, speaking to the importance of duty to bring their troops back from the edge of chaos."
            ACTIVATION "As a Support action, make a TN 4 Command (Earth) check targeting any number of characters (or your cohort during a mass battle)."
            EFFECTS "If you succeed during an intrigue, duel, or skirmish conflict, each target increases their composure by your Earth Ring. This effect persists until the end of the scene. If you succeed during a mass battle, increase your army's discipline by your Earth Ring plus your bonus successes. This effect persists until the end of the scene."
            OPPORTUNITIES {
                "Earth (op)(op): During an intrigue, duel, or skirmish, each target removes strife equal to your Earth Ring."
                "Earth (op)(op): During a mass battle, your army removes panic equal to your Earth Ring."
            }
        }

        #W0QB6DGhPm1R9Jv0KczLUo ^"The Immovable Hand of Peace" DEF {
            RANK 5
            DESCRIPTION "The courtier calls for the warriors in the field to lay down their arms and withdraw with such unquestionable conviction that even the fires of hate are temporarily smothered."
            ACTIVATION "Once per game session as a Scheme action, during a duel or skirmish, make a TN 5 Command (Earth) check targeting every character in the scene."
            EFFECTS "If you succeed, the scene becomes an intrigue between you and the other principal characters. This effect persists for one round, plus additional rounds equal to your bonus successes. If you have not achieved a peaceful resolution by the time this effect ends, the scene returns to its previous state."
            OPPORTUNITIES {
                "Earth (op): You may also perform this action during a mass battle or other form of conflict (other than an intrigue)."
            }
        }

        #UN5KQZjDq79Is7cPIQCoJo ^"Weight of Duty" DEF {
            RANK 1
            DESCRIPTION "All samurai know the pressure of expectation in countless forms. An observant courtier can read this when engaging with another character, learning their beliefs and in what ways they fear they might not live up to their own expectations."
            ACTIVATION "When you make a Social skill (Earth) check targeting a character, you may spend (op) as follows:"
            OPPORTUNITIES {
                "Earth (op): Learn one way the target fears failing as a samurai."
                "Earth (op)(op): Learn the target's ^\"Giri\"."
            }
        }

        # ----- Fire Shūji -----
        # Fire shūji focus on provocation in the most direct sense, eliciting
        # a reaction immediately and with fervor. Anger, joy, despair, and the
        # burning desire for justice are all tools of one who wields Fire shūji.
        # A speaker can illuminate injustice or set hearts ablaze with pride,
        # but it can also blind people to the wider situation or consequences.

        #2VbFS6xaG13cbbOk5miwjo ^"Bravado" DEF {
            RANK 4
            DESCRIPTION "Glory is half reputation and half poise. The courtier displays a confident mien, speaking more informally than propriety should allow. Their words and posture carry a tinge of arrogance, making them harder to ignore."
            ACTIVATION "As a Scheme action, make a Games (Fire) or Performance (Fire) check targeting any number of characters in the scene. The TN of this check is equal to the highest vigilance among your targets."
            EFFECTS "If you succeed, each target behaves as though your glory is 10 higher or lower than its actual value, plus or minus an additional 10 for each bonus success (to a maximum glory value of 100 or a minimum glory value of 0). If you do anything that could call your glory into question, any character may resist with a TN 4 Sentiment check (Air 5, Water 2) to determine your actual glory attribute. This effect persists until the end of the scene."
            OPPORTUNITIES {
                "Fire (op): Choose a character in the scene. Learn if their glory is higher or lower than yours (the actual value)."
            }
        }

        #EgewuV5s96on3zjNrTvJpe ^"Dazzling Performance" DEF {
            RANK 3
            DESCRIPTION "Performing a great feat can win a character renown, but performing a great feat and then telling the story of it draws far greater accolades. A courtier building a reputation in the competitive courts of Rokugan must master not just excellence, but also capture the imagination."
            ACTIVATION "When making an Artisan skill (Fire), Games (Fire), or Performance (Fire) check, you may spend (op) in the following way:"
            OPPORTUNITIES {
                "Fire (op)+: The next time you receive a glory award this scene, increase the amount you receive by 1. If there is a character of higher status in the scene, increase it by 1 per (op) spent this way instead."
            }
        }

        #nxx4PUuUEDXcRbh17Z0blU ^"Fanning the Flames" DEF {
            RANK 2
            DESCRIPTION "Inciting people to act foolishly or to flinch at the crucial moment is a key skill of a courtier, for words are their weapons. Inducing unchecked emotion is another tool in the courtier’s arsenal, and most become quite adept in the art of manipulating people into feeling certain things that are advantageous for the courtier. The courtier stings their target’s pride with needling comments or makes a flirtatious remark to draw their attention, pulling the target’s emotions to the surface and making them easier to predict."
            ACTIVATION "When making a Social skill (Fire) check targeting one or more characters, you may spend (op) in the following way:"
            OPPORTUNITIES {
                "Fire (op)+: One target gains the ^\"Dazed\" condition per (op) spent this way."
                "Fire (op)(op)+: One target gains the ^\"Enraged\" condition per (op)(op) spent this way."
            }
        }

        #IGquxVDtJcTEXwn2nTUvqG ^"Lightning Raid" DEF {
            RANK 2
            DESCRIPTION "The Unicorn Clan is famous for its quick strikes, smashing down upon its enemies with cavalry to sow chaos in their ranks and leave them vulnerable to the rest of the army. Other clans employ similar tactics, usually by ambushing exposed cities or supply trains in the field. The leader rouses their troops for a swift attack to leave the enemy in a state of disarray."
            ACTIVATION "Once per scene, as an Attack and Movement action, make a TN 3 Command (Fire) check targeting any number of characters in the scene (or one cohort in a mass battle)."
            EFFECTS "If you succeed during a skirmish, each character increases their initiative by your Fire Ring plus your bonus successes at the beginning of the next round. If you succeed during a mass battle, one enemy leader's cohort suffers panic equal to your Fire Ring plus your bonus successes."
            OPPORTUNITIES {
                "Fire (op): During a skirmish, immediately perform a ^\"Strike\" action."
                "Fire (op): During a mass battle, immediately perform an ^\"Assault\" action against the chosen enemy cohort's leader."
            }
        }

        #rUz6ukITtPc8k3vRHmpoNP ^"Rallying Cry" DEF {
            RANK 3
            DESCRIPTION "The leader roars, calling their troops to battle, and the voice of an army echoes around them as the single cry is joined by many. As one, the troops surge forward to claim victory or perish in the attempt."
            ACTIVATION "As a Support action, make a TN 2 Command (Fire) or Performance (Fire) check targeting any number of characters in the scene (or one cohort in a mass battle)."
            EFFECTS "If you succeed, the targets are energized and excited by your rhetoric. After Step 5: Choose Kept Dice, each target adds a kept (ring) set to an (su)(st) result. This effect persists until the end of your next turn."
            OPPORTUNITIES {
                "Fire (op)+: In a skirmish, each enemy in the scene suffers 1 strife per (op) spent this way."
                "Fire (op)+: In a mass battle, the enemy army suffers 1 panic per (op) spent this way."
            }
        }

        #ZJIQtg1P6USMPRIzJcn5Al ^"Sear the Wound" DEF {
            RANK 5
            DESCRIPTION "Many courtiers cannot resist the opportunity to twist the knife after delivering a stabbing remark, but the wise use this power judiciously. Though somewhat cruel, the technique of bringing a rival’s weakness to the forefront of their mind to burn away at their resolve is often effective."
            ACTIVATION "When making a Social skill (Fire) check targeting one or more characters, you may spend (op) in the following way:"
            OPPORTUNITIES {
                "Fire (op)+: Choose a known disadvantage of one of your targets per (op) spent this way. That disadvantage applies to all of the target's checks until the end of the scene."
            }
        }

        #Mm0nf52NuXTKisPrdeDQ8m ^"Sensational Distraction" DEF {
            RANK 1
            DESCRIPTION "Standing out in court requires a great deal of both cunning and flair, and standing out on purpose can be even harder. Courtiers train for much of their lives to learn to control the perceptions of others at court. The best courtiers know when to draw attention to themselves with a display of rhetorical prowess or another social feat and when to avoid attention. Drawing attention to oneself can give collaborators the chance to work unnoticed as well, and thus it is an extremely valuable tool in the courtier’s arsenal."
            ACTIVATION "When making a Social skill (Fire) check targeting one or more characters, you may spend (op) in the following way:"
            OPPORTUNITIES {
                "Fire (op)+: When interacting with other characters, the target treats their vigilance as 1 lower per (op) spent this way; when interacting with you, the target treats their vigilance as 1 higher per (op) spent this way. This effect persists until the end of the scene."
            }
        }

        #LNoCHrAXMq2QTNhoUg9lAk ^"Stirring the Embers" DEF {
            RANK 1
            DESCRIPTION "A good leader does not just compensate for the weaknesses of comrades, but also fosters their innate strengths. The courtier reminds an ally of one of their finer qualities, sparking their pride to get them to fight more fiercely or speak with greater conviction."
            ACTIVATION "When making a Social skill (Fire) check targeting one or more characters, you may spend (op) in the following way:"
            OPPORTUNITIES {
                "Fire (op)+: Choose a target and one of their known distinctions per (op) spent this way. Until the end of the scene, when that advantage applies to a check, the target may reroll up to three dice (instead of two)."
            }
        }

        #CUVTW0xoeEbzJYrll6mbV7 ^"Truth Burns through Lies" DEF {
            RANK 1
            DESCRIPTION "The courtier rapidly extrapolates, imagining the ramifications of a story and conjecturing what might have gone unsaid. If a loose thread exists in the account, they can find it, and that first thread can become the unraveling of the most cunning duplicity."
            ACTIVATION "When making a Scholar skill (Fire) check to assess a character's story, you may spend (op) in the following way:"
            OPPORTUNITIES {
                "Fire (op): If there is a single statement upon which the character's story hinges, you determine what it is and what you would need to do to verify or disprove it."
            }
        }

        # ----- Water Shūji -----
        # Water shūji play to the heart rather than the mind, calling upon the
        # listener to let their emotions guide them and be swept along without
        # question. Camaraderie, shame, guilt, material needs, and base desires
        # are all the domain of Water shūji. A skilled courtier can draw even
        # the harshest enemies to the negotiating table by making it the path
        # of least resistance.

        #NQn7sBvlEBYJctesfGDqZH ^"All in Jest" DEF {
            RANK 1
            DESCRIPTION "Veteran courtiers sometimes play off missteps as jokes. This underhanded but effective tactic puts the other person in a difficult position: press the issue and seem stubborn, or let it slide and give the courtier a pass."
            ACTIVATION "When you make a Commerce (Water), Courtesy (Water), or Performance (Water) check, you may spend (op) in the following way:"
            OPPORTUNITIES {
                "Water (op)+: If you forfeited honor as part of the check in order to say something rude or appeal to your target's base desires (greed, lust, laziness, etc.), regain 1 honor per (op) spent this way (see ^\"Forfeiting Social Attributes\")."
            }
        }

        #OokjiwHlZEupNcxuHLKuIR ^"Buoyant Arrival" DEF {
            RANK 5
            DESCRIPTION "Some people have the ability to blend in with any social environment, fluidly adapting to the rough atmosphere of the humblest tavern one day, while walking among the rulers of the Empire the next."
            ACTIVATION "As a Scheme action, make a Courtesy (Water) check targeting a number of characters up to your Water Ring. The TN of the check is equal to the vigilance of the character with the highest status among your targets."
            EFFECTS "If you succeed, you may enter or leave the conversation gracefully. You need not forfeit honor or glory for interrupting, suddenly departing, or preempting someone else, regardless of the respective status of the participants."
        }

        #5yqq8PHChTMAT9MtGipsIF ^"Ebb and Flow" DEF {
            RANK 3
            DESCRIPTION "Just as hardest ice and the gentlest mist are composed of the same water, seasoned courtiers know that all it takes is time and work to transform strength into weakness and weakness into strength. The courtier manipulates a person's perceptions with ease, keeping their allies confident and their foes uneasy."
            ACTIVATION "As a Scheme or Support action, make a Courtesy (Water), Command (Water), or Games (Water) check targeting one character. The TN of this check is equal to the target's vigilance."
            EFFECTS "If you succeed (and chose Scheme action), choose one of the target's advantages that you know; whenever it applies, invert it. This effect persists until the end of the scene. If you succeed (and chose Support action), choose one of the target's disadvantages you know; whenever it applies, invert it. This effect persists until the end of the scene."
            OPPORTUNITIES {
                "Water (op): Choose one additional advantage or disadvantage and apply the effect to it."
                "Water (op)(op)+: Choose one additional target with vigilance lower than or equal to your first target's vigilance per (op)(op) spent this way."
            }
        }

        #hi3iUtKJkFWkYG9ijGT7wi ^"Regal Bearing" DEF {
            RANK 4
            DESCRIPTION "Courtiers train in the art of carrying themselves no matter what clothing they wear, gaining impeccable control over their posture, tone, and choice of words to project exactly the social standing they desire others to see."
            ACTIVATION "As a Scheme action, make a Command (Water) or Performance (Water) check targeting any number of characters in the scene. The TN of this check is equal to the highest vigilance among your targets."
            EFFECTS "If you succeed, each target treats your status as being 10 higher or lower (to a maximum status of 100 or a minimum status of 0), plus or minus an additional 10 per bonus success. If you do anything that could call your status into question, any character may resist with a TN 4 Sentiment check (Earth 2, Fire 5) to determine your actual status attribute. This effect persists until the end of the scene."
            OPPORTUNITIES {
                "Water (op): Choose a character in the scene. Learn if their status is higher or lower than yours (the actual value)."
            }
        }

        #8Yh77FWi4wCMphnZVYwU30 ^"Shallow Waters" DEF {
            RANK 1
            DESCRIPTION "A good courtier learns how to read the desires of those around them from the subtle cues of their responses in conversation, as well as how to probe for details without revealing their intentions."
            ACTIVATION "When you make a Social skill (Water) check targeting a character, you may spend (op) as follows:"
            OPPORTUNITIES {
                "Water (op): Learn of one material item or worldly experience the target desires."
                "Water (op)(op): Learn the target's ^\"Ninjō\"."
            }
        }

        #V2GiQ9rSTBn8gNE2cQ2vxo ^"Slippery Maneuvers" DEF {
            RANK 2
            DESCRIPTION "The leader makes several signals and calls out a command—often a code word—to their troops; suddenly, the formation shifts in unison to take advantage of the terrain around them."
            ACTIVATION "As a Movement and Support action, make a TN 2 Command (Water) check targeting any number of friendly characters in the scene (or your cohort during a mass battle). This technique can only be used during a skirmish or mass battle."
            EFFECTS "If you succeed during a skirmish, choose a position containing terrain that you can see. Each target may immediately move 1 range band toward it. Attack checks targeting any of your targets inside the terrain treat the terrain as having the ^\"Obscuring\" terrain quality. This effect persists until the end of the scene. If you succeed during a mass battle, choose a piece of terrain you can see. You and your cohort may immediately move to occupy it if it is unoccupied. Attack action checks targeting you and your cohort while you are inside the terrain treat the terrain as having the ^\"Obscuring\" terrain quality. This effect persists until the end of the scene."
            OPPORTUNITIES {
                "Water (op): Each target is able to leverage ^\"Obscuring\" terrain to better effect; Attack action checks targeting them have their TN increased by 2 instead of 1. This effect persists until the end of the scene."
            }
        }

        #xGEyMoFPgvxb1IpMhk3c0p ^"Tributaries of Trade" DEF {
            RANK 2
            DESCRIPTION "Gift giving is an important cultural practice in Rokugan (as is the art of gift refusal, which any potential recipient must repeat at least twice before accepting the third offer). While some courtiers have a gift prepared for any possible contingency, many simply get acquainted with the art of explaining why a gift could only have been intended for its current recipient (even if they originally procured it for a different purpose). The ability to quickly acquire an item is valued among all courtiers, as a gift demands reciprocity in some kind, whether that be in favors, esteem, or subsequent gifts."
            ACTIVATION "Once per scene as a Scheme and Support action, make a TN 1 Commerce (Water) skill check to establish that you acquired a chosen item earlier. From a narrative standpoint, you procured this gift during your last opportunity (or sent an attendant to retrieve it) but are only revealing it now."
            EFFECTS "If you succeed, you produce an item with a rarity less than or equal to 1 plus your bonus successes. You must still pay the price of the item."
            OPPORTUNITIES {
                "Water (op)+: Reduce the price you must pay for the item by one-quarter per (op) spent this way (to a minimum of one-quarter of the original price)."
            }
        }

        #svvmtBGYb5XXrrqx9aY0hD ^"Well of Desire" DEF {
            RANK 1
            DESCRIPTION "Bribery is considered to be corruption in Rokugan, yet gift exchanges and gift giving is a time-honored tradition. The shrewdest courtiers can engineer scenarios in which their targets cannot refuse their gifts without tarnishing their reputations. Thus, the recipient of such a poisoned gift might find it preferable to owe the courtier a favor than to be shamed in public."
            ACTIVATION "When you make a Courtesy (Water) check to present a gift to a target, you may spend (op) as follows:"
            OPPORTUNITIES {
                "Water (op): To refuse your gift, your target must forfeit glory equal to your Water Ring. Additionally, if the gift is something that the target desires, the target also must suffer strife equal to its rarity to refuse it. If your target accepts the gift, reduce the TN of your next Social skill check targeting them by the rarity of the item (to a minimum of 1)."
            }
        }

        # ----- Void Shūji -----
        # Void shūji revolve around understanding and expressing the inner
        # mysteries of the universe to help oneself and others move toward
        # Enlightenment, selfless goals, or otherworldly ends. Some Void
        # shūji are limited to a specific clan (listed with RESTRICTION).

        #kVXN7d6hHmaHfUcKdInRxO ^"All Arts Are One" DEF {
            RANK 3
            DESCRIPTION "Just as the four elements are bound together by Void, certain underlying principles, including aesthetics, logic, and discipline, unite all forms of art. By meditating on these similarities, a courtier is able to more easily grasp the fundamentals of any subject."
            ACTIVATION "As a Support action, make a TN 4 Martial skill (Void), Games (Void), or Performance (Void) check to rapidly absorb information on a new activity covered by that skill."
            EFFECTS "If you succeed, you immediately intuit how to wield a new weapon, play a new game, use a new instrument, or perform a new song, dance, or other task. You do not apply any TN increase that might be associated with dealing with something new to you."
            OPPORTUNITIES {
                "Void (op): Choose a ring. Reduce the TN of your next check using that ring for the chosen skill by 1. This effect persists until the end of your next turn (or until the end of the scene during a narrative scene)."
            }
        }

        #ozZWaYuZNqChFF0cboMnTQ ^"A Samurai's Fate" DEF {
            RANK 4
            DESCRIPTION "A leader asks their warriors for the final service all samurai must someday render to their lord: to lay down their lives that others might live. Even as they fall in battle, their shed blood waters the fields that will grow a thousand victories."
            ACTIVATION "As an action, make a TN 5 Command (Void) check targeting any number of characters (or your cohort, during a mass battle)."
            EFFECTS "If you succeed during a skirmish, each target ignores any critical strikes with severity lower than your Void Ring plus your bonus successes. This effect persists until the end of the scene (at which point the injuries take effect). If you succeed during a mass battle, your army counts as having the Fearless Army ability: at the end of each round, your army removes panic equal to your glory rank. This effect persists until the end of the scene."
        }

        #kcz9tYqb7ZkxEjkD96CUXF ^"Courtier's Resolve" DEF {
            RANK 1
            DESCRIPTION "Warriors do battle with their bodies, and courtiers do battle with their minds. To maintain one’s composure while surrounded by the challenges of court, one must be able to clear and organize one’s mind, returning focus to the most vital tasks."
            ACTIVATION "Once per scene as a Support action, you may spend 1 Void point to recover from strife."
            EFFECTS "Remove strife equal to your glory rank."
        }

        #kq4jfxIvUd5ASOCHRHNBEf ^"Lady Doji's Decree" DEF {
            RANK 2
            DESCRIPTION "Propriety, grace, and eloquence were of great importance to the founder of the Crane Clan. With a word, she was said to defuse the most dangerous situations. Crane Clan courtiers follow in her footsteps, forcing bystanders to listen with a single striking comment."
            RESTRICTION "Crane Clan only"
            ACTIVATION "Once per game session as an action, make a Courtesy (Void) check targeting a number of characters up to your school rank. The TN of this check is equal to the vigilance of the character with the highest status among your targets."
            EFFECTS "If you succeed, your targets cannot perform Attack actions targeting you. This effect persists for one round, plus additional rounds equal to your bonus successes, or until you perform an Attack action."
            OPPORTUNITIES {
                "Void (op)+: Choose one additional target with status lower than your first target per (op) spent this way."
                "Void (op)(op): Your targets also cannot perform Scheme actions targeting you."
            }
        }

        #ula0DlV5RD8JehvWU8oZZe ^"Lady Shinjo's Speed" DEF {
            RANK 2
            DESCRIPTION "The Kami Shinjo carried within her a curiosity that could never be fully satisfied. Her passion extends to her clan, who still feel the call of the unexplored. Peerless riders, the Unicorn Clan finds their way across unfamiliar terrain with ease, as Shinjo taught them centuries ago."
            RESTRICTION "Unicorn Clan only"
            ACTIVATION "As a downtime activity, if you have a steed available, make a TN 2 Survival (Void) check to reach a destination with extreme swiftness."
            EFFECTS "If you succeed, you reach the destination in half the time it would normally require. If you so desire, one character may ride along with you."
            OPPORTUNITIES {
                "Void (op): You may lead a number of willing characters with mounts of their own up to your school rank."
            }
        }

        #35TfdsuJBkqnd1UpLLEGHa ^"Lord Akodo's Roar" DEF {
            RANK 2
            DESCRIPTION "The Kami Akodo One-Eye, who founded the Lion Clan, was the greatest tactician in the Empire. His victories rested not upon the strength of his arm, but upon his keen mind and his faith in the people he rallied behind him. The true general never stands alone, for they are always bolstered by the united will of their followers. With a roar that echoes through the ranks, chilling their foes and heartening their comrades, the leader charges as Akodo himself once did."
            RESTRICTION "Lion Clan only"
            ACTIVATION "Once per game session as an action, make a TN 1 Command (Void) check targeting each hostile character within a number of range bands equal to your school rank."
            EFFECTS "If you succeed, each target suffers the ^\"Dazed\" condition."
            OPPORTUNITIES {
                "Void (op)(op)+: After you perform this action, one other friendly character per (op)(op) spent this way at range 0-3 may immediately perform a ^\"Strike\" action targeting a ^\"Dazed\" character."
            }
        }

        #ahpgcTigitmTmFf8vWGMX1 ^"Lord Bayushi's Whispers" DEF {
            RANK 2
            DESCRIPTION "The Kami Bayushi, self-appointed villain of the Emperor Hantei and master of duplicity, founded the Scorpion Clan with a simple purpose: to dishonor themselves so that others could live honorably. Bayushi maintained vast networks of spies and informants, and he was extremely skilled at turning assets others used to try to spy on him. The Scorpion Clan has carried on this tradition with an efficiency that would surely make Bayushi proud. Hardly a town exists in the Empire without an agent of the Scorpion."
            RESTRICTION "Scorpion Clan only"
            ACTIVATION "Once per game session, during a narrative scene or as a downtime activity, make a TN 2 Skulduggery (Void) check to uncover an informant who can give you information about a subject."
            EFFECTS "If you succeed, you reveal one informant who can give you information about a topic of your choice. If the informant's profile is required, use an appropriate NPC of the GM's choice."
            OPPORTUNITIES {
                "Void (op): If you succeed, choose one skill. The informant has a number of ranks in that skill equal to your school rank and can perform checks with that skill to assist you until the end of the scene."
            }
        }

        #HPyhRH2w9P002W4dTymcYl ^"Lord Togashi's Insight" DEF {
            RANK 2
            DESCRIPTION "The enigmatic Kami Togashi was said to have the ability to see the future, by which provenance he excused himself from the Tournament of the Kami. Occasionally he appears to his descendants, the members of the Dragon Clan, in flashes of visions or sudden, unexplained bursts of insight. Whether those who hear the voice of Togashi himself are truly in contact with their progenitor, channeling his essence across the ages, or are letting their imaginations run a bit too wild is a topic of discussion among the Dragon’s scholars."
            RESTRICTION "Dragon Clan only"
            ACTIVATION "Once per game session as an action, make a TN 2 Meditation (Void) check to seek cosmic wisdom regarding a quandary in front of you."
            EFFECTS "If you succeed, you receive a brief vision or hear the voice of Togashi providing a hint regarding one way you might proceed (which the GM should furnish). This hint should not be the full answer, but it should help you move forward toward a solution or at least formulate a plan of action."
            OPPORTUNITIES {
                "Void (op): Reduce the TN of your first check to overcome the problem you are facing by your school rank (to a minimum of 1)."
            }
        }

        #2HdMwjLF8vs7Y8cAuRydLF ^"Rouse the Soul" DEF {
            RANK 5
            DESCRIPTION "Many things can cloud the soul, but words can awaken it. The courtier speaks honestly and without pretension, calling upon their allies to overcome earthly circumstances and reach a mutual goal."
            ACTIVATION "When making a Social skill (Void) or Theology (Void) check targeting one or more characters, you may spend (op) in the following way:"
            OPPORTUNITIES {
                "Void (op)+: Remove one of the following conditions from one target per (op) spent this way: ^\"Afflicted\", ^\"Enraged\", ^\"Exhausted\", ^\"Intoxicated\", or ^\"Unconscious\"."
            }
        }

        RULES {
            #L5R317fG9hI1jK3lM5nO7p: shuji_social_techniques_usable_in_intrigues_duels_skirmishes_and_other_conflicts
            #L5R318qR0sT2uV4wX6yZ8a: shuji_available_to_schools_listing_shuji
            #L5R319bC1dE3fG5hI7jK9l: shuji_organized_by_elemental_classification
        }
    }

    # ===========================
    # MAHŌ (mahō) — DARK SORCERY
    # ===========================

    ^"Mahō" DEF {
        ALIAS "Maho"
        APPLIES TO [^"Samurai", ^"Adversary"]

        # Kansen are evil spirits, twisted kami that spill forth from Jigoku
        # or were once kami corrupted within Rokugan. Those mortals who dare
        # to wield the evil sorcery called mahō are known as mahō-tsukai.
        # Reviled by society and hunted by sworn orders, mahō-tsukai often
        # act subtly, disguising their corruption beneath a pleasant façade.
        #
        # Symbol: (mahō)
        # Available to: Anyone with access to evil lore (ancient tome, kansen
        #   mentor, or ^"Shadowlands Taint" disadvantage) and the will to
        #   seize power at any cost

        # --- Mahō Framework Rules ---

        PROPER_SACRIFICES {
            # Kansen require sacrifice to fuel mahō — usually blood (own or
            # another's), but particularly evil acts can also suffice at GM's
            # discretion.
            #
            # Exceptional sacrifice (killing a human victim or crossing a
            # vital personal line): may reroll up to 3 blank rolled dice
            # during the check. The offering is consumed.
        }

        SPIRITUAL_BACKLASH {
            # When a mahō-tsukai generates 3 or more (st) on kept dice while
            # performing a mahō technique, the mahō-tsukai suffers a critical
            # strike with severity equal to their current strife. Then, the GM
            # assigns the ^"Shadowlands Taint" disadvantage to one of the
            # mahō-tsukai's rings that does not already have it.
        }

        CHANNELING_MAHO {
            # Like invocations, mahō techniques can be channeled (see
            # ^"Channeling"). However, for each die a character reserves
            # while channeling a mahō technique, the character receives
            # 1 fatigue.
        }

        IMPORTUNE_MAHO {
            # Once per scene, a ^"Tainted" character may choose one mahō
            # technique they have not learned (even if they do not meet the
            # prerequisites) and make a sacrifice to the kansen. To importune
            # mahō, a character must kill a human victim or cross a previously
            # inviolable personal line (betray a close friend, abandon a
            # personal ideal, allow despair to overwhelm them entirely). If
            # the GM determines the kansen is satisfied, the character may
            # perform the action associated with that technique. The character
            # may channel this mahō as usual but can only perform the action
            # once.
        }

        # --- Mahō Techniques ---

        #Z08hgcM2pmKDZ3JoeHgysC ^"Grip of Anguish" DEF {
            RANK 1
            DESCRIPTION "The mahō-tsukai calls for the kansen afflicting their victim to wreak sickness and agony upon them. The victim is tormented by nausea, pain, and feverish delusions."
            ACTIVATION "As an Attack action, make a Theology (Water) check targeting one living being at range 0-2. The TN of the check is equal to the target's vigilance."
            EFFECTS "If you succeed, you curse your target, causing them to suffer supernatural damage equal to your Water Ring plus the number of your rings with a ^\"Shadowlands Taint\" disadvantage attached."
            OPPORTUNITIES {
                "Water (op): One target must resist with a TN 3 Fitness check (Earth 1, Fire 4) or suffer one of the following conditions of your choice: ^\"Dazed\", ^\"Disoriented\", ^\"Silenced\"."
                "Water (op)+: Treat the maximum range of the technique as 1 higher per (op) spent this way."
                "Water (op)+: Choose one additional target per (op) spent this way."
                "Water (op)(op): One target must resist with a TN 3 Fitness check (Earth 1, Fire 4) or suffer one of the following conditions of your choice: ^\"Bleeding\", ^\"Immobilized\", or ^\"Lightly Wounded\"."
            }
        }

        #E7dbkpcgyzgOINco7KmXAx ^"Incite Haunting" DEF {
            RANK 1
            DESCRIPTION "Kansen are kami twisted by the power of Fu Leng, and they need little prompting to cause harm. Directing them toward a target with a vile rite and profane words that seem to warp the air, the mahō-tsukai afflicts a poor soul with a spiritual malady that can fester and bloom, fueling darker curses still. Spiritualists can perceive kansen as wretched, ghostly figures, clinging to their victim and dragging them inexorably toward a wretched end wrought by their worst nature."
            ACTIVATION "As an Attack and Scheme action, make a Theology check targeting one character at range 0-1. This check uses any ring of your choice, and the TN of the check is equal to the target's vigilance."
            EFFECTS "If you succeed, you curse your target, causing them to suffer the ^\"Afflicted\" condition. If you fail, the target rebuffs your efforts. If your shortfall is 2 or higher, the target also becomes aware of your attempted malediction."
            OPPORTUNITIES {
                "(op)+: Treat the maximum range of the technique as 1 higher per (op) spent this way."
                "(op)+: Choose one additional target per (op) spent this way."
            }
        }

        #v5nWeISsM5mfuLuV0SfcQH ^"Mark of Desecration" DEF {
            RANK 1
            DESCRIPTION "The mahō-tsukai performs the rite upon a corpse or group of corpses, placing ominous masks over their faces and whispering dark words into their dead ears. The dead are dragged to their feet by the kansen possessing them, moving with the jerking, unnatural gait of an ill-made puppet."
            ACTIVATION "As a Support action, make a TN 2 Theology (Earth) check targeting a number of corpses up to your Earth Ring at range 0-3."
            EFFECTS "If you succeed, you summon a ^\"Zombie Peasant\" from each target. You also curse an area encompassing 1 range band around each target's position, which gains the ^\"Defiled\" terrain quality."
            OPPORTUNITIES {
                "Earth (op)+: Choose one additional target per (op) spent this way."
                "Earth (op)+: Increase each zombie's endurance by 1 per (op) spent this way."
                "Earth (op)(op): Once per round, one zombie may use your skill ranks instead of its own for a check."
                "Earth (op)(op)+: One target who was a warrior in life per (op)(op) spent this way rises as a ^\"Bushi Skeleton\" instead."
            }
        }

        #ZVD5eQXiGpcpsn5fmAKVJc ^"Sinful Whispers" DEF {
            RANK 1
            DESCRIPTION "The kansen assail the victim’s mind, murmuring dark things that slowly erode their concentration, making them more receptive to the words of the mahō-tsukai and less able to think coherently."
            ACTIVATION "As an Attack and Scheme action, make a Theology (Air) check targeting one character with the ^\"Afflicted\" condition at range 0-4. The TN of the check is equal to the target's vigilance."
            EFFECTS "If you succeed, you curse your target, sapping their will; they must answer your questions honestly (and find doing so unremarkable at the time). This effect persists for a number of rounds equal to your Air Ring."
            OPPORTUNITIES {
                "Air (op): The target does not remember what you asked, even if prompted to think about the conversation later."
                "Air (op)(op)(op): You may give the target a single simple order. The target may ignore that order, but receives 2 strife at the end of each scene in which they disregard it. When the target becomes ^\"Compromised\", they must unmask and attempt to fulfill the order until the end of the scene."
            }
        }

        #HEiZLRgKB0B99Z4IeLqn0p ^"Unholy Fervor" DEF {
            RANK 1
            DESCRIPTION "The kansen bite and tear the flesh of the victim, wracking them with pain that transforms into mindless fury."
            ACTIVATION "As a Support action, make a Theology (Fire) check targeting one character at range 0-3. The TN of this check is equal to the target's vigilance."
            EFFECTS "If you succeed, you curse the target with blinding fury; they suffer the ^\"Enraged\" condition. You also augment the target's corruption; they may treat each of their ^\"Shadowlands Taint\" disadvantages as an advantage that applies to any checks using its ring. This effect persists until the end of the scene."
            OPPORTUNITIES {
                "Fire (op): Each target receives strife equal to your Fire Ring and removes that much fatigue."
                "Fire (op)+: Choose one additional target per (op) spent this way."
            }
        }

        RULES {
            #L5R320mN2oP4qR6sT8uV0w: maho_forbidden_throughout_empire_punishable_by_death
            #L5R321xY3zA5bC7dE9fG1h: maho_requires_blood_sacrifice_exceptional_sacrifice_rerolls_3_blanks
            #L5R322iJ4kL6mN8oP0qR2s: maho_spiritual_backlash_critical_strike_plus_taint
            #L5R323tU5vW7xY9zA1bC3d: maho_channeling_incurs_1_fatigue_per_reserved_die
            #L5R324eF6gH8iJ0kL2mN4o: maho_importune_once_per_scene_requires_exceptional_sacrifice
        }
    }

    # ===========================
    # NINJUTSU (ninjutsu) — SHINOBI TECHNIQUES
    # ===========================

    ^"Ninjutsu" DEF {
        APPLIES TO [^"Samurai", ^"Adversary"]

        # Ninjutsu are secret techniques passed down from shinobi masters
        # to their students. They are hardly ever committed to paper, and
        # are written only in the minds of their practitioners. Sneaking
        # through shadows, poisoning foes, and vanishing without a trace —
        # to employ these tactics is to stray from the path of Bushidō, but
        # some are willing to pay this price for their family, clan, and empire.
        #
        # Symbol: (ninjutsu)
        # Available to: Schools listing "ninjutsu" among available techniques

        #Fw3nwqrRGKBgIpzO0vFakT ^"Skulk" DEF {
            RANK 1
            DESCRIPTION "Shinobi are known for walking silently from shadow to shadow, moving like phantoms. Some of this relies upon agility and speed, of course, but veterans in the art of stealth know that using a crowd or another visual distraction to walk unnoticed can be as effective as the most complex acrobatics."
            ACTIVATION "When you perform an Initiative or Attack check using Air, you may spend (op) as follows:"
            OPPORTUNITIES {
                "(op): If you are in ^\"Obscuring\" terrain, a crowd, or otherwise concealed from sight, one character with vigilance lower than or equal to your ranks in Skulduggery loses sight of you."
            }
        }

        #4W0IygSdrLHDKytB1I8yIw ^"Deadly Sting" DEF {
            RANK 2
            DESCRIPTION "Poison is not a weapon an honorable samurai would choose, but it is tremendously effective, and like its namesake, the Scorpion Clan is not above envenoming its weapons to defeat foes it otherwise could not best."
            ACTIVATION "As an Attack action, you may use one dose of a poison and make a TN 3 Martial Arts (Air) check using a readied ^\"Concealable\" weapon targeting one character within the weapon's range."
            EFFECTS "If you succeed, apply the chosen poison to your weapon (see ^\"Poison\"). Then, the target suffers physical damage equal to the deadliness of your weapon plus your bonus successes."
            OPPORTUNITIES {
                "Air (op): Move 1 range band."
                "Air (op)+: If you succeed, the target suffers a critical strike with severity 2, plus 1 per (op) spent this way."
            }
        }

        #5yKYfFDPSlfe5aZ8XGo6QF ^"Noxious Cloud" DEF {
            RANK 3
            DESCRIPTION "Volatile concoctions are an important weapon in many shinobi’s arsenals, allowing them to create choking smoke into which they can escape or even poison unprepared foes to weaken them for a killing blow."
            ACTIVATION "As an Attack action, you may use two doses of any single poison and make a TN 2 Medicine (Air) check targeting each other character at range 0-2."
            EFFECTS "If you succeed, each target suffers 3 physical damage, ignoring their resistance. This damage counts as being inflicted by a weapon envenomed with the poison you chose (see ^\"Poison\")."
            OPPORTUNITIES {
                "Air (op): Move 1 range band."
                "Air (op)+: Until the end of the scene, the area at range 0-2 becomes ^\"Obscuring\" and ^\"Dangerous\" terrain."
                "Air (op)(op)+: If you succeed, one target per (op)(op) spent this way suffers a critical strike with severity 2."
            }
        }

        #vxiscnhW4PgnwgCjbB9QVZ ^"Silencing Stroke" DEF {
            RANK 4
            DESCRIPTION "Shinobi must often eliminate targets without raising an alarm, and so they often train in the art of disabling with a single strike. A shuriken to the trachea or a swift blow to occlude the carotid artery can leave a target unable to scream while the shinobi finishes their unsavory work."
            ACTIVATION "As an Attack action, make a TN 4 Martial Arts (Air) check using a readied weapon targeting one character within the weapon's range."
            EFFECTS "If you succeed, the target suffers physical damage equal to your weapon's base damage and suffers the ^\"Silenced\" condition. Other characters beyond range 0-2 of the target do not notice that they have been struck for 1 round, plus additional rounds equal to your bonus successes."
            OPPORTUNITIES {
                "Air (op)+: If you succeed, the target suffers a critical strike with severity equal to the deadliness of your weapon plus 1 per (op) spent this way beyond the first."
            }
        }

        RULES {
            #L5R324eF6gH8iJ0kL2mN4o: ninjutsu_available_to_schools_listing_ninjutsu
            #L5R325pQ7rS9tU1vW3xY5z: ninjutsu_secret_oral_tradition_rarely_written
            #L5R326aB8cD0eF2gH4iJ6k: ninjutsu_strays_from_bushido
        }
    }

    # ===========================
    # INVERSIONS (inversion) — VOID TECHNIQUES
    # ===========================

    ^"Inversion" DEF {
        APPLIES TO [^"Samurai", ^"Adversary"]

        # NOTE: Inversions are not in the Core Rulebook; they appear in
        # sourcebooks (Celestial Realms, etc.). Included here as a
        # category placeholder.
        #
        # Rare and dangerous techniques that manipulate the Void itself.
        # Practiced by ishiken (Void shugenja) and those who commune
        # directly with the nothingness between elements.
        #
        # Symbol: (inversion)
        # Available to: Schools listing Inversions (primarily Void shugenja)

        EXAMPLES {
            ^"Void Awakening" RANK 1 "(inversion). Action: Sense supernatural presences and Void disturbances."
            ^"Sever Ties" RANK 3 "(inversion). Action: Sever a spiritual connection or bond."
            ^"Unmake" RANK 5 "(inversion). Action: Dissolve an object or effect into the Void."
        }

        RULES {
            #L5R327lM9nO1pQ3rS5tU7v: inversions_require_ishiken
            #L5R328wX0yZ2aB4cD6eF8g: inversions_cause_fatigue_on_strife
            #L5R329hI1jK3lM5nO7pQ9r: inversions_unpredictable_consequences
        }
    }

    # ===========================
    # MANTRA (mantra) — MEDITATION TECHNIQUES
    # ===========================

    ^"Mantra" DEF {
        APPLIES TO [^"Samurai", ^"Adversary"]

        # NOTE: Mantras are not in the Core Rulebook; they appear in
        # sourcebooks (Celestial Realms, etc.). Included here as a
        # category placeholder.
        #
        # Contemplative techniques combining meditation and spiritual
        # focus. Mantras bridge kihō and invocations.
        #
        # Symbol: (mantra)
        # Available to: Sourcebook schools (Celestial Realms, etc.)

        RULES {
            #L5R330sT2uV4wX6yZ8aB0c: mantras_meditation_focus
            #L5R331dE3fG5hI7jK9lM1n: mantras_bridge_kiho_invocations
        }
    }

    # Note: Technique prerequisites are now described within the
    # ^"Technique" DEF above (prerequisites, waiver rules, = mark,
    # losing special access). No separate DEF needed.
    GUIDANCE {
        ENTRY ^"technique-system-overview" #L5RG154abcdefghijklm {
            CONCERNS [ ^"Technique" ]
            TOPICS [ "techniques", "history" ]
            TEXT "When the Kami fell to the earth, they brought with them knowledge, wisdom, and art from the Heavens themselves. They taught their craft and cunning to their human followers, many of whom were already known for their own unique bodies of knowledge and styles of swordplay, martial arts, and impersonation. In the centuries since, these methods have been diligently passed down from sensei to student. While many techniques continue to be practiced in their original form, others have been honed and refined into new and more impressive arts."
        }
        ENTRY ^"what-are-techniques" #L5RG155hijklmnopqrst {
            CONCERNS [ ^"Technique" ]
            TOPICS [ "techniques" ]
            TEXT "Techniques are special abilities that represent advanced training. They enable a character to perform feats more quickly or in a unique way, or to exploit opportunities others would overlook."
        }
        ENTRY ^"technique-categories" #L5RG156opqrstuvwxyza {
            CONCERNS [ ^"Technique" ]
            TOPICS [ "techniques", "categories", "schools" ]
            TEXT "Different characters wield different abilities, and each character is granted access to a number of technique categories by their school. The different categories are as follows: Kata (see p. 174): Kata are specialized combat techniques that allow martial artists to vanquish even foes who exceed them in physical strength, speed, or agility. Some kata are new actions, while others grant new ways to spend (op). Kata have form classifications (General, Close Combat, and Ranged Combat). Shūji (see p. 214): Shūji are verbal and social techniques allowing those who employ them to communicate clearly, avoid social traps, motivate their allies, and manipulate their rivals. Shūji are new actions or ways a character can spend (op). Shūji have elemental classifications (Air, Earth, Fire, Water, and Void). Kihō (see p. 182): Kihō are philosophical and spiritual techniques for aligning one’s inner energy—ki—to that of the wider cosmos. This allows monks and other seekers of Enlightenment to act in harmony with the universe’s natural course, tapping into its limitless potential. Kihō are new actions with two parts: an enhancement effect which persists until the user chooses to end it or uses another kihō and a burst effect which resolves upon activation if the user has sufficient bonus successes. Kihō have elemental classifications (Air, Earth, Fire, Water, and Void). Invocations (see p. 189): Invocations are prayers and offerings to powerful spirits in exchange for earthly support. They are practiced primarily by shugenja, who are elite samurai priests from ancient, secretive lineages with the power to speak directly to the kami. Invocations are new actions, and have elemental classifications (Air, Earth, Fire, and Water). Rituals (see p. 212): Rituals are religious ceremonies performed by spiritualists in Rokugan. Rituals tend to be ceremonial, lengthy, and of esoteric effect, unlike the flashy invocations of shugenja. Rituals are downtime activities. Mahō (see p. 224): Mahō are evil sorcerous techniques, dark pacts made with wicked spirits in exchange for power. They are practiced only by sorcerers called mahō-tsukai. Mahō are new actions. Ninjutsu (see p. 226): Ninjutsu are the secretive techniques of shinobi, taught clandestinely in various traditions. Ninjutsu are new actions or grant new ways to spend (op)."
        }
        ENTRY ^"kata-intro" #L5RG157vwxyzabcdefgh {
            CONCERNS [ ^"Kata" ]
            TOPICS [ "techniques", "kata" ]
            TEXT "Kata are martial techniques: sets of moves that warriors practice while training to gain the edge when they find themselves in combat situations. Kata allow a combatant to perform incredible martial feats and capitalize on openings that might slip away from less skilled combatants. Kata can be used in duels and skirmishes, and in other types of conflicts as common sense and the GM’s discretion dictate. Only characters with one or more school ranks in a school that lists “kata” among its available techniques can purchase kata."
        }
        ENTRY ^"kiho-intro" #L5RG158cdefghijklmno {
            CONCERNS [ ^"Kihō" ]
            TOPICS [ "techniques", "kiho" ]
            TEXT "Kihō, meaning “ki method,” are powerful spiritual techniques generally known only to monks. Practitioners activate them by aligning their inner energy (ki) to specific elements or universal forces. Kihō can be used in intrigues, duels, and skirmishes, and in other types of conflicts as common sense and the GM’s discretion dictate."
        }
        ENTRY ^"invocations-intro" #L5RG159jklmnopqrstuv {
            CONCERNS [ ^"Invocation" ]
            TOPICS [ "techniques", "invocations", "shugenja" ]
            TEXT "Invocations are the techniques wielded by shugenja, the elite priests of the samurai class who turn their unmatched spiritual potential to the gravest of affairs: researching and understanding the nature of the universe, suppressing the powers of the Shadowlands, and engaging in wars among the clans. Invocations can be used in intrigues, duels, and skirmishes, and in other types of conflicts as common sense and the GM’s discretion dictate. Only characters with one or more school ranks in a school that lists “invocations” among its available techniques can purchase invocations."
        }
        ENTRY ^"rituals-intro" #L5RG160qrstuvwxyzabc {
            CONCERNS [ ^"Ritual" ]
            TOPICS [ "techniques", "rituals" ]
            TEXT "Rituals are religious ceremonies performed to appease the kami and draw forth their blessings. Unlike invocations, rituals are not the rarefied secrets of shugenja schools; instead, they are day-to-day practices performed by many religious functionaries throughout Rokugan. Still, they are miraculous occurrences, if subtle ones. Most priests, shrine keepers, and court mystics know and perform rituals on a regular basis. Many monks and shugenja also know how to perform rituals. Rituals are performed during downtime, and potentially during other types of scenes at the GM’s discretion. Only characters with one or more school ranks in a school that lists “rituals” among its available techniques can purchase rituals."
        }
        ENTRY ^"shuji-intro" #L5RG161xyzabcdefghij {
            CONCERNS [ ^"Shūji" ]
            TOPICS [ "techniques", "shuji" ]
            TEXT "Shūji are social techniques, leveraging that most powerful of human tools: communication. Shūji can be used in intrigues, duels, skirmishes, and other types of conflicts as common sense and the GM’s discretion dictate. Only characters with one or more school ranks in a school that lists “shūji” among its available techniques can purchase shūji."
        }
        ENTRY ^"maho-intro" #L5RG162efghijklmnopq {
            CONCERNS [ ^"Mahō" ]
            TOPICS [ "techniques", "maho", "shadowlands" ]
            TEXT "Kansen are evil spirits, twisted kami that spill forth from Jigoku or were once kami dwelling within Rokugan before becoming corrupted. While kami can be mercurial and dangerous to mortals, especially if provoked, they are fundamentally creative forces within the world. When they bring destruction, it is often a prelude to greater creation, much as a wildfire rejuvenates a forest. Kansen, by contrast, bloom in the wake of devastation, choking out all life or twisting it with their touch. They are drawn to despair, terror, and most of all, fresh blood. Where they take root, nothing else grows. Those mortals who dare to wield the evil sorcery called mahō are known as mahō-tsukai. Reviled by society and hunted by several sworn orders within the bounds of the Emerald Empire, mahō-tsukai often act subtly, disguising their corruption beneath a pleasant façade and stirring words."
        }
        ENTRY ^"ninjutsu-intro" #L5RG163lmnopqrstuvwx {
            CONCERNS [ ^"Ninjutsu" ]
            TOPICS [ "techniques", "ninjutsu", "shinobi" ]
            TEXT "Ninjutsu are secret techniques passed down from shinobi masters to their students. They are hardly ever committed to paper, and are written only in the minds of their practitioners. Sneaking through shadows, poisoning foes, and vanishing without a trace— to employ these tactics is to stray from the path of Bushidō, but some are willing to pay this price for their family, clan, and empire."
        }
        ENTRY ^"kata-curriculum-symbol" #L5RG164abcdefghijklm {
            CONCERNS [ ^"Kata" ]
            TOPICS [ "techniques", "kata", "curriculum" ]
            TEXT "Kata are marked with a stylized weapon in curriculum tables"
        }
        ENTRY ^"kiho-curriculum-symbol" #L5RG165hijklmnopqrst {
            CONCERNS [ ^"Kihō" ]
            TOPICS [ "techniques", "kiho", "curriculum" ]
            TEXT "Kihō are marked with a stylized tree in curriculum tables"
        }
        ENTRY ^"invocation-curriculum-symbol" #L5RG166opqrstuvwxyza {
            CONCERNS [ ^"Invocation" ]
            TOPICS [ "techniques", "invocations", "curriculum" ]
            TEXT "Invocations are marked with a stylized scroll in curriculum tables."
        }
        ENTRY ^"ritual-curriculum-symbol" #L5RG167vwxyzabcdefgh {
            CONCERNS [ ^"Ritual" ]
            TOPICS [ "techniques", "rituals", "curriculum" ]
            TEXT "Rituals are marked with a stylized incense offering in curriculum tables."
        }
        ENTRY ^"shuji-curriculum-symbol" #L5RG168cdefghijklmno {
            CONCERNS [ ^"Shūji" ]
            TOPICS [ "techniques", "shuji", "curriculum" ]
            TEXT "Shūji are marked with a stylized calligraphy brush in curriculum tables."
        }
        ENTRY ^"maho-curriculum-symbol" #L5RG169jklmnopqrstuv {
            CONCERNS [ ^"Mahō" ]
            TOPICS [ "techniques", "maho", "curriculum" ]
            TEXT "Mahō do not appear in any curriculums of upstanding samurai schools. If such dark secrets did appear in a curriculum table, they would be marked with a stylized oni's head."
        }
        ENTRY ^"ninjutsu-curriculum-symbol" #L5RG170qrstuvwxyzabc {
            CONCERNS [ ^"Ninjutsu" ]
            TOPICS [ "techniques", "ninjutsu", "curriculum" ]
            TEXT "Ninjutsu are marked in curriculum tables by a stylized throwing star."
        }
        ENTRY ^"what-is-ki" #L5RG171xyzabcdefghij {
            CONCERNS [ ^"Kihō" ]
            TOPICS [ "techniques", "kiho", "ki" ]
            TEXT "“Ki” (“qi” or “ch’i,” when translated from Chinese) is the animating energy of living things, which conscious beings can control in part through their willpower. Like many parts of Legend of the Five Rings, ki is a real world concept that has inspired part of this fantasy setting, and should be treated with due consideration as such. In Rokugan, kihō practitioners align their body’s inner ki with the vast and inestimable energies of the universe to perform amazing feats. Each kihō is a martial form that aids the user expressing their ki in the form of an element."
        }
        ENTRY ^"kiho-effect-visibility" #L5RG172efghijklmnopq {
            CONCERNS [ ^"Kihō" ]
            TOPICS [ "techniques", "kiho" ]
            TEXT "The enhancement effect of a kihō often goes unnoticed by those not trained in the mastery of ki, for their senses are not attuned to seeking it. Those with the proper training might perceive it as a swirling corona of power, a gentle rippling of energy, or an immense spiritual weight cast on those nearby, depending on the technique in use. A kihō's burst effect, on the other hand, is rarely so subtle, for flinging fire or shattering the earth tends to attract attention."
        }
        ENTRY ^"appealing-to-the-kami" #L5RG173lmnopqrstuvwx {
            CONCERNS [ ^"Invocation" ]
            TOPICS [ "techniques", "invocations", "kami" ]
            TEXT "Kami are not obligated to answer the call of a shugenja, nor do they tend to react to frivolous entreaties. Outside of conflicts and other life-and-death situations, a shugenja can only attempt a given invocation once per scene; if the shugenja succeeds, the kami have done as asked and it would be unseemly to request more. If the attempt ended in failure, the kami have made their answer clear. Additionally, if a shugenja attempts to use an invocation in a way that falls far outside of its relevant context (for instance, attempting to summon vast quantities of jade to turn a profit, rather than to smite evil), the kami may not answer at all. The kami are not at the beck and call of the shugenja; if anything, the relationship works the other way around."
        }
        ENTRY ^"honor-and-invocations" #L5RG174stuvwxyzabcde {
            CONCERNS [ ^"Invocation" ]
            TOPICS [ "techniques", "invocations", "honor" ]
            TEXT "Some invocations may allow or even encourage a PC to behave dishonorably. With the Mask of Wind, for example, one could impersonate someone of higher status, and Secrets on the Wind would allow a character to eavesdrop effortlessly on their own lord. The GM should remind players that their characters must still forfeit or stake honor to commit acts that defy the tenets of Bushidō, even when they are using mystical powers to enact their plots."
        }
        ENTRY ^"conviction-of-purpose" #L5RG175zabcdefghijkl {
            CONCERNS [ ^"Jade Strike" ]
            TOPICS [ "techniques", "invocations", "jade", "shadowlands" ]
            TEXT "Because conviction is a key part of wielding the unyielding power of the sacred stone, a character cannot simply hurl the holy power of jade at anyone they suspect to harbor the corruption of the Shadowlands. If a character attempts the invocation and the target is not Tainted, their certainty might be shaken. Worse, the earth kami may even stop responding to their call for a short time, angry to have been roused without good reason."
        }
        ENTRY ^"the-tea-ceremony" #L5RG176ghijklmnopqrs {
            CONCERNS [ ^"Tea Ceremony" ]
            TOPICS [ "techniques", "rituals", "tea ceremony" ]
            TEXT "Guests are escorted to the site of the tea ceremony, ideally a tea house specially designed for this function or another place of elegant simplicity. There, they are asked to cleanse their mouths and hands—and also their souls—much in the same way purification is performed at shrines. The guests sit in a prescribed order and the host makes the tea in front of them in a series of elaborate, meticulous steps, each gesture or position passed down to them from tea masters through the ages. Finally, the host serves the tea to the guests, who partake of the same bowl one after another. After the tea has been finished, and the utensils cleaned and put away, the guests leave the tea house in the order they arrived, and the host's final bow signifies the end of the ceremony."
        }
        ENTRY ^"range-of-shuji" #L5RG177nopqrstuvwxyz {
            CONCERNS [ ^"Shūji" ]
            TOPICS [ "techniques", "shuji", "range" ]
            TEXT "Shūji can generally affect characters close enough to hear the speaker (or otherwise understand them). In most circumstances, this is range 0–4, but under less than ideal conditions (high winds, clashing of swords and screaming of dying warriors, pounding rain), it might be a smaller area. Additionally, shūji can sometimes be transmitted by means other than speech. While written rhetoric is often less effective for stirring large groups, a well-targeted letter to a specific person might be extremely moving. At the GM’s discretion, a character can transmit a shūji technique over time and distance via epistolary or similar means, though it generally only affects a single intended recipient."
        }
        ENTRY ^"mahos-subtle-approach" #L5RG178uvwxyzabcdefg {
            CONCERNS [ ^"Mahō" ]
            TOPICS [ "techniques", "maho" ]
            TEXT "Unlike the invocations of shugenja, which are frequently direct in their application, mahō techniques are often slower. The mahō-tsukai first invokes a subtle curse upon their target, drawing kansen to that ill-fated individual. Once the curse takes hold, the mahō-tsukai calls the kansen to act upon the target in a variety of unpleasant ways, from engaging in mental and social manipulation to inflicting agony, illness, and death. This can take months, or even years, and if the mahō-tsukai is subtle enough, none ever realize that their target was afflicted with a curse."
        }
    }
}
