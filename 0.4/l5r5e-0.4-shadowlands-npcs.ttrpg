    # source stat block (page 135)
    ^"Hellish Sorcerer (Powerful Oni)" DEF {
        EXTENDS ^"NPC"

        # A base profile for oni that tap into the Taint to power
        # dangerous magic rivaling the most depraved mahō-tsukai.

        PROPERTIES {
