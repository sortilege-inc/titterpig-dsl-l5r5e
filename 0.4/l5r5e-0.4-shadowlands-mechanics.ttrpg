            #NBng9tw1noWfbVN9MzWwYG ^"Tatami Gusoku" DEF { ^"Physical Resistance" INTEGER 3 ^"Qualities" STRING "Wargear (while equipped)" ^"Rarity" INTEGER 4 ^"Cost" STRING "7 koku" }
            #tkpj6TjgUYId83NuoKjB9V ^"Tosei-Gusoku" DEF { ^"Physical Resistance" INTEGER 4 ^"Qualities" STRING "Cumbersome, Durable, Wargear" ^"Rarity" INTEGER 8 ^"Cost" STRING "50 koku" ^"Special" STRING "Treat physical resistance as 2 higher against projectile attacks." }
