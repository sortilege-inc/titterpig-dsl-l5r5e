            #MbsBPqYhE3aoLmz9B2Zva2 ^"Engineer's Kit" DEF { ^"Cost" STRING "3 bu" ^"Rarity" INTEGER 3 }
            #OJdvLHhsyig6vVDF9wi5cp ^"Sapper's Kit" DEF { ^"Cost" STRING "1 bu" ^"Rarity" INTEGER 3 }
            #7RrUZb18yKq6X08uA2zwJ9 ^"Smithy's Kit" DEF { ^"Cost" STRING "3 bu" ^"Rarity" INTEGER 3 ^"Special" STRING "Cumbersome, silhouette 1." }
            #ESywGjv1cMp8DoP40jDPX8 ^"Smoke Arrows" DEF { ^"Cost" STRING "3 bu" ^"Rarity" INTEGER 4 ^"Special" STRING "Modify bow profile: Damage -2, Deadliness -2. Used for signaling along the Wall." }
            #MrUdYvNCUIErNxvv7mz4Ba ^"Spyglass" DEF { ^"Cost" STRING "2 koku" ^"Rarity" INTEGER 5 ^"Special" STRING "See small items with great clarity at up to range 5." }
            #ZS2bffK9Ai6joonWQrLwQM ^"Taketaba" DEF { ^"Cost" STRING "4 bu" ^"Rarity" INTEGER 4 ^"Special" STRING "Covered mobile platform providing cover for archers and crossbow users on the battlefield." }
            #ehAqFPgLwm14V4Aw2P77fX ^"Tate" DEF { ^"Cost" STRING "3 bu" ^"Rarity" INTEGER 3 ^"Special" STRING "Set up as Support action. Increase TN of projectile Attack checks targeting character behind it by 2." }
