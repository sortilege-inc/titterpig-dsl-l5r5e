EXTENSION "L5R5e_Shadowlands" EXTENDS "L5R5e_Core_Character" {
    NAME "Legend of the Five Rings 5th Edition - Shadowlands: New Player Options"
    VERSION "0.4.2"
    SPEC_VERSION "0.4.1"
    RELEASE_DATE "2026-03-01"

    # Shadowlands (Chapters 2 and 3): Falcon Minor Clan, Toritaka family,
    # new schools, advantages, disadvantages, Taint disadvantages,
    # heritages, weapons, armor, personal effects, signature scrolls,
    # item patterns, artifacts, techniques, mahō, titles, opportunity
    # tables, corruption rules, oni generation, demeanors, NPC templates.

    # ===========================
    # FALCON MINOR CLAN
    # ===========================

    # source (page 87)
    ^"Falcon Minor Clan" DEF {
        EXTENDS #L5R250aB2cD4eF6gH8iJ0k ^"Clan"
        APPLIES TO [^"Samurai"]

        # The Falcon guard against spiritual threats from the
        # Spirit Realms - ghosts, gaki, and similar dangers.
        # A Minor Clan to the north of Crab lands, they seek
        # not only to battle yurai but to understand them.

        PROPERTIES {
            ^"Clan Name" STRING "Falcon" FIXED
            ^"Clan Type" STRING "Minor Clan"
            ^"Clan Ring Bonus" DEF { ^"Void" INTEGER 1 }
            ^"Clan Skill Bonus" DEF { ^"Theology" INTEGER 1 }
            ^"Clan Status" INTEGER DEFAULT 26
        }

        FAMILIES {
            ^"Toritaka"
        }

    }


    # ===========================
    # FALCON FAMILIES
    # ===========================

    #L5RSL60vW1xY3zA5bC7dE9f ^"Toritaka" DEF {
        EXTENDS #L5R251lM3nO5pQ7rS9tU1v ^"Family"
        APPLIES TO [^"Samurai"]

        PROPERTIES {
            ^"Family Name"     STRING "Toritaka" FIXED
            ^"Clan"            STRING "Falcon"
            ^"Ring Increase" DEF { CHOOSE 1 [^"Earth", ^"Water"] INTEGER 1 }
            ^"Skill Increases" DEF {
                ^"Survival" INTEGER 1
                ^"Meditation" INTEGER 1
            }
            ^"Glory"           INTEGER 35
            ^"Starting Wealth" INTEGER 3
        }
    }


    # ===========================
    # NEW SCHOOLS
    # ===========================

    # source (page 88)
    ^"Asako Inquisitor" DEF {
        EXTENDS #L5R252wX4yZ6aB8cD0eF2g ^"School"
        APPLIES TO [^"Samurai"]
        DESCRIPTION "Unlike the horrors of the Shadowlands, mahō can arise anywhere and can exist in any location as a hidden corruption. To root out and combat this, the Asako Inquisitors were formed in the third century. Originally, they concentrated on their own clan, to purge the Phoenix of any who would engage in such foul practices, but over time, their remit widened to include all of the Emerald Empire. This has brought Asako Inquisitors, who answer only to their clan's Council of Five and the Emperor, into conflict at times with people of the Kuni Purifier School."

        # Formed in the third century to root out mahō within
        # the Phoenix, their remit widened to all of the Emerald
        # Empire. They answer only to the Council of Five and
        # the Emperor, sometimes clashing with Kuni Purifiers.

        PROPERTIES {
            ^"School Name" STRING "Asako Inquisitor" FIXED
            ^"Clan" STRING "Phoenix"
            ^"Roles" LIST ["Courtier", "Shugenja"]
            ^"Ring Increase" DEF {
                ^"Fire" INTEGER 1
                ^"Void" INTEGER 1
            }
            ^"Starting Skills" DEF { CHOOSE 3 [^"Courtesy", ^"Martial Arts [Melee]", ^"Martial Arts [Unarmed]", ^"Meditation", ^"Performance", ^"Theology"] INTEGER 1 }
            ^"Starting Honor" INTEGER DEFAULT 35
            ^"Techniques Available" LIST ["Invocations", "Rituals", "Shūji"]
        }


        STARTING_TECHNIQUES {
            RITUAL ^"Cleansing Rite"
            RITUAL ^"Commune with the Spirits"
            RITUAL ^"Divination"
            SHUJI ^"Cadence"
            SHUJI ^"Truth Burns through Lies"
        }

        SCHOOL_ABILITY "Traces of Passage" {
            "Once per scene as a Support action, you may scry to detect any supernatural abilities used at range 0-3 in the last day (such as invocations, mahō, and kihō). Reduce the TN of your checks to investigate this phenomenon by your school rank."
        }

        MASTERY_ABILITY ^"Resilient Readiness" {
            "When you make a check to investigate a supernatural phenomenon, you may spend (op) as follows: (op)+: Increase your resistance against that phenomenon (such as a specific invocation, kihō, mahō, or NPC ability) by an amount equal to the (op) you spend this way. This effect persists until the end of the scene."
        }
        STARTING_OUTFIT [
            "traveling clothes", "sanctified robes",
            "daishō (any one sword of rarity 7 or lower and wakizashi)",
            "scroll satchel", "traveling pack"
        ]

        CURRICULUM {
            RANK 1 {
                SKILL_GROUP "Scholar Skills"
                SKILL "Command"
                SKILL "Martial Arts [Melee]"
                SKILL "Meditation"
                TECHNIQUE_GROUP "Rank 1 Fire Invocations"
                ^"Threshold Barrier" [ritual]
                ^"Weight of Duty" [shuji]
            }
            RANK 2 {
                SKILL_GROUP "Social Skills"
                SKILL "Government"
                SKILL "Meditation"
                SKILL "Theology"
                TECHNIQUE_GROUP "Rank 1-2 Air Invocations"
                ^"Essence of Jade" [invocation]
                ^"Open-Hand Style" [kata]
            }
            RANK 3 {
                SKILL_GROUP "Martial Skills"
                SKILL "Medicine"
                SKILL "Performance"
                SKILL "Theology"
                TECHNIQUE_GROUP "Rank 1-3 Earth Invocations"
                ^"Regal Bearing" [shuji]
                ^"Touchstone of Courage" [shuji]
            }
            RANK 4 {
                SKILL_GROUP "Scholar Skills"
                SKILL "Courtesy"
                SKILL "Martial Arts [Melee]"
                SKILL "Survival"
                TECHNIQUE_GROUP "Rank 1-4 Water Invocations"
                ^"The Soul's Blade" [invocation]
                ^"Bravado" [shuji]
            }
            RANK 5 {
                SKILL_GROUP "Social Skills"
                SKILL "Composition"
                SKILL "Skulduggery"
                SKILL "Tactics"
                TECHNIQUE_GROUP "Rank 1-5 Fire Invocations"
                ^"Striking as Void" [kata]
                ^"Rouse the Soul" [shuji]
            }
            RANK 6 {
                ^"Resilient Readiness"
            }
        }

    }

    # source (page 89)
    ^"Kakita Swordsmith" DEF {
        EXTENDS #L5R252wX4yZ6aB8cD0eF2g ^"School"
        APPLIES TO [^"Samurai"]
        DESCRIPTION "Like all institutions of the Crane, the Kakita Swordsmith School emphasizes perfection and excellence. The blades they forge are renowned across Rokugan as the finest that can be made; some duelists wait long years for the opportunity to have one of these blades crafted for their use. Very rarely, a venerable swordsmith will take on a promising youth as an apprentice, though most apprentices spend decades before they are honored as \"proficient.\""

        # The blades they forge are renowned as the finest
        # in Rokugan. Duelists wait years for one of these
        # blades. Apprentices spend decades before being
        # honored as proficient.

        PROPERTIES {
            ^"School Name" STRING "Kakita Swordsmith" FIXED
            ^"Clan" STRING "Crane"
            ^"Roles" LIST ["Artisan", "Courtier"]
            ^"Ring Increase" DEF {
                ^"Air" INTEGER 1
                ^"Fire" INTEGER 1
            }
            ^"Starting Skills" DEF { CHOOSE 5 [^"Aesthetics", ^"Martial Arts [Melee]", ^"Courtesy", ^"Culture", ^"Sentiment", ^"Smithing", ^"Theology"] INTEGER 1 }
            ^"Starting Honor" INTEGER DEFAULT 55
            ^"Techniques Available" LIST ["Kata", "Rituals", "Shūji"]
            ^"Patterns" STRING "Kakita Pattern"
        }


        STARTING_TECHNIQUES {
            KATA CHOOSE 1 [^"Soaring Slice", ^"Striking as Air", ^"Striking as Fire"]
            SHUJI ^"Artisan's Appraisal"
        }

        SCHOOL_ABILITY "Sacred Art of Steel" {
            "Once per game session when you make a check to craft, improve, or maintain a weapon, you may add a number of kept (ring) set to (op) results equal to your school rank."
        }

        MASTERY_ABILITY ^"Ashidaka's Method" {
            "When you create a new weapon, you may apply two different patterns that you know to it (instead of one)."
        }
        STARTING_OUTFIT [
            "traveling clothes", "ceremonial clothes",
            "daishō (a personally crafted katana with Kakita pattern and wakizashi)",
            "smithing hammer", "traveling pack",
            "an attendant or Rokugani pony"
        ]

        CURRICULUM {
            RANK 1 {
                SKILL_GROUP "Artisan Skills"
                SKILL "Courtesy"
                SKILL "Culture"
                SKILL "Martial Arts [Melee]"
                TECHNIQUE_GROUP "Rank 1 Kata"
                ^"Blessing of Steel" [ritual]
                ^"Well of Desire" [shuji]
            }
            RANK 2 {
                SKILL_GROUP "Scholar Skills"
                SKILL "Aesthetics"
                SKILL "Meditation"
                SKILL "Smithing"
                TECHNIQUE_GROUP "Rank 1-2 Rituals"
                ^"Ebb and Flow" [shuji]
                ^"Tributaries of Trade" [shuji]
            }
            RANK 3 {
                SKILL_GROUP "Martial Skills"
                SKILL "Sentiment"
                SKILL "Smithing"
                SKILL "Theology"
                TECHNIQUE_GROUP "Rank 1-4 Air Shūji"
                ^"All Arts are One" [shuji]
                ^"Dazzling Performance" [shuji]
            }
            RANK 4 {
                SKILL_GROUP "Artisan Skills"
                SKILL "Courtesy"
                SKILL "Martial Arts [Melee]"
                SKILL "Performance"
                TECHNIQUE_GROUP "Rank 1-4 Kata"
                ^"Soul Sunder" [kata]
                ^"Bravado" [shuji]
            }
            RANK 5 {
                SKILL_GROUP "Scholar Skills"
                SKILL "Aesthetics"
                SKILL "Design"
                SKILL "Smithing"
                TECHNIQUE_GROUP "Rank 1-5 Fire Shūji"
                ^"Buoyant Arrival" [shuji]
                ^"Striking as Void" [kata]
            }
            RANK 6 {
                ^"Ashidaka's Method"
            }
        }

    }

    # source (page 90)
    ^"Kitsu Medic" DEF {
        EXTENDS #L5R252wX4yZ6aB8cD0eF2g ^"School"
        APPLIES TO [^"Samurai"]
        DESCRIPTION "Though the Kitsu family is known more for its shugenja samurai, the students of the Kitsu Medic School are also of note. They are skilled in the martial arts, but their primary vocation is healing. As such, they are an important part of any Lion army going into battle. The warrior skills of Kitsu Medics mean they can be at the forefront of the fighting, killing foes as well as tending to their clan's wounded."

        # Skilled in martial arts but primarily healers. Important
        # part of any Lion army, able to fight at the forefront
        # while tending to clan wounded.

        PROPERTIES {
            ^"School Name" STRING "Kitsu Medic" FIXED
            ^"Clan" STRING "Lion"
            ^"Roles" LIST ["Artisan", "Bushi"]
            ^"Ring Increase" DEF {
                ^"Earth" INTEGER 1
                ^"Water" INTEGER 1
            }
            ^"Starting Skills" DEF { CHOOSE 5 [^"Command", ^"Fitness", ^"Martial Arts [Melee]", ^"Martial Arts [Unarmed]", ^"Medicine", ^"Sentiment", ^"Survival"] INTEGER 1 }
            ^"Starting Honor" INTEGER DEFAULT 44
            ^"Techniques Available" LIST ["Kata", "Rituals", "Shūji"]
        }


        STARTING_TECHNIQUES {
            KATA CHOOSE 1 [^"Crescent Moon Style", ^"Striking as Earth", ^"Striking as Water"]
            RITUAL CHOOSE 1 [^"Cleansing Rite", ^"Threshold Barrier"]
            SHUJI ^"Stonewall Tactics"
        }

        SCHOOL_ABILITY "Field Medicine" {
            "When you perform a Medicine check to remove fatigue or a condition from a friendly character, that character removes additional fatigue up to your school rank."
        }

        MASTERY_ABILITY ^"Healer's Hands" {
            "When you make a check to remove a condition from another character, you may receive 2 fatigue to treat the TN as 1."
        }
        STARTING_OUTFIT [
            "traveling clothes", "ashigaru armor",
            "daishō (katana and wakizashi)",
            "satchel of medicinal supplies", "traveling pack"
        ]

        CURRICULUM {
            RANK 1 {
                SKILL_GROUP "Scholar Skills"
                SKILL "Fitness"
                SKILL "Martial Arts [Melee]"
                SKILL "Survival"
                TECHNIQUE_GROUP "Rank 1 Kata"
                ^"Commune with the Spirits" [ritual]
                ^"Honest Assessment" [shuji]
            }
            RANK 2 {
                SKILL_GROUP "Martial Skills"
                SKILL "Medicine"
                SKILL "Survival"
                SKILL "Theology"
                TECHNIQUE_GROUP "Rank 1-2 Earth Shūji"
                ^"Flowing Water Strike" [kata]
                ^"Rushing Avalanche Style" [kata]
            }
            RANK 3 {
                SKILL_GROUP "Artisan Skills"
                SKILL "Martial Arts [Melee]"
                SKILL "Martial Arts [Unarmed]"
                SKILL "Medicine"
                TECHNIQUE_GROUP "Rank 1-3 Kata"
                ^"Iron in the Mountains Style" [kata]
                ^"Touchstone of Courage" [shuji]
            }
            RANK 4 {
                SKILL_GROUP "Scholar Skills"
                SKILL "Command"
                SKILL "Fitness"
                SKILL "Survival"
                TECHNIQUE_GROUP "Rank 1-5 Water Shūji"
                ^"A Samurai's Fate" [shuji]
                ^"Crashing Wave Style" [kata]
            }
            RANK 5 {
                SKILL_GROUP "Martial Skills"
                SKILL "Courtesy"
                SKILL "Medicine"
                SKILL "Sentiment"
                TECHNIQUE_GROUP "Rank 1-5 Kata"
                ^"Rouse the Soul" [shuji]
                ^"Sear the Wound" [shuji]
            }
            RANK 6 {
                ^"Healer's Hands"
            }
        }

    }

    # source (page 91)
    ^"Kuni Warden" DEF {
        EXTENDS #L5R252wX4yZ6aB8cD0eF2g ^"School"
        APPLIES TO [^"Samurai"]
        DESCRIPTION "A number of Kuni who lack the aptitude to become shugenja are trained in the tradition of the Kuni Wardens. These grim monks maintain the Barracks of the Damned, a massive hospital, laboratory, and prison that is also their temple. Experts at subduing Tainted humans and overcoming sorcery, even without weapons, many serve at or near the Wall, but some Wardens occasionally make their way into the wider world. The order sometimes sends its agents to \"tend to the spiritual needs\" of those who have been exposed to the corruption of Fu Leng. This can include offering the mercy of death, should their charge be fully consumed by the Taint."

        # Grim monks who maintain the Barracks of the Damned.
        # Experts at subduing Tainted humans and overcoming
        # sorcery without weapons. Some are sent to tend the
        # spiritual needs of those exposed to corruption.

        PROPERTIES {
            ^"School Name" STRING "Kuni Warden" FIXED
            ^"Clan" STRING "Crab"
            ^"Roles" LIST ["Monk"]
            ^"Ring Increase" DEF {
                ^"Fire" INTEGER 1
                ^"Void" INTEGER 1
            }
            ^"Starting Skills" DEF { CHOOSE 4 [^"Command", ^"Martial Arts [Melee]", ^"Martial Arts [Unarmed]", ^"Meditation", ^"Performance", ^"Theology"] INTEGER 1 }
            ^"Starting Honor" INTEGER DEFAULT 34
            ^"Techniques Available" LIST ["Kihō", "Rituals", "Shūji"]
        }


        STARTING_TECHNIQUES {
            KIHO CHOOSE 1 [^"Cleansing Spirit", ^"Flame Fist"]
            RITUAL CHOOSE 1 [^"Cleansing Rite", ^"Threshold Barrier"]
            SHUJI ^"Truth Burns through Lies"
        }

        SCHOOL_ABILITY "Suppressing Blows" {
            "When you perform an Attack action check using Martial Arts [Melee] or Martial Arts [Unarmed], you may spend (op) as follows: (op)+: One character per (op) spent this way who is in range of the weapon you used suffers the Silenced condition. Maximum (op) equal to your school rank."
        }

        MASTERY_ABILITY ^"Sacred Fist" {
            "All of your kihō gain the following additional burst effect: If you have 3 or more bonus successes, your unarmed attack profiles gain the Sacred quality until the end of your next turn."
        }
        STARTING_OUTFIT [
            "sanctified robes", "concealed armor",
            "daishō (kabutowari and wakizashi)",
            "calligraphy kit", "traveling pack"
        ]

        CURRICULUM {
            RANK 1 {
                SKILL_GROUP "Scholar Skills"
                SKILL "Martial Arts [Melee]"
                SKILL "Martial Arts [Unarmed]"
                SKILL "Meditation"
                TECHNIQUE_GROUP "Rank 1 Kata"
                ^"Courtier's Resolve" [shuji]
                ^"The Body Is an Anvil" [kiho]
            }
            RANK 2 {
                SKILL_GROUP "Martial Skills"
                SKILL "Performance"
                SKILL "Sentiment"
                SKILL "Theology"
                TECHNIQUE_GROUP "Rank 1-2 Fire Kihō"
                ^"Crimson Leaves Strike" [kata]
                ^"Coiling Serpent Style" [kata]
            }
            RANK 3 {
                SKILL_GROUP "Social Skills"
                SKILL "Fitness"
                SKILL "Martial Arts [Unarmed]"
                SKILL "Theology"
                TECHNIQUE_GROUP "Rank 1-3 Earth Kihō"
                ^"Thunderclap Strike" [kata]
                ^"Rallying Cry" [shuji]
            }
            RANK 4 {
                SKILL_GROUP "Martial Skills"
                SKILL "Command"
                SKILL "Government"
                SKILL "Skulduggery"
                TECHNIQUE_GROUP "Rank 1-4 Void Shūji"
                ^"Bravado" [shuji]
                ^"Death Touch" [kiho]
            }
            RANK 5 {
                SKILL_GROUP "Scholar Skills"
                SKILL "Fitness"
                SKILL "Martial Arts [Melee]"
                SKILL "Meditation"
                TECHNIQUE_GROUP "Rank 1-5 Void Kihō"
                ^"Striking as Void" [kata]
                ^"Sear the Wound" [shuji]
            }
            RANK 6 {
                ^"Sacred Fist"
            }
        }

    }

    # source (page 92)
    ^"Mirumoto Taoist Blade" DEF {
        EXTENDS #L5R252wX4yZ6aB8cD0eF2g ^"School"
        APPLIES TO [^"Samurai"]
        DESCRIPTION "As the name suggests, the monks of the Mirumoto Taoist Blade School make study of swordplay an integral part of their quest for Enlightenment. Such are their skills that their blades act as if part of their bodies, striking as easily as fists would do for others. Their isolated monastery and dōjō is nestled deep within northern mountains within Dragon lands, and it is extraordinarily rare for them to host visitors. Most Rokugani who witness their skills do so when one of these monks departs to walk the Emerald Empire in search of new insights and possibly even new lessons in the blade."

        # Monks who make swordplay integral to their quest
        # for Enlightenment. Their blades act as part of their
        # bodies. Isolated monastery deep within Dragon lands.

        PROPERTIES {
            ^"School Name" STRING "Mirumoto Taoist Blade" FIXED
            ^"Clan" STRING "Dragon"
            ^"Roles" LIST ["Bushi", "Monk"]
            ^"Ring Increase" DEF {
                ^"Void" INTEGER 1
                ^"Water" INTEGER 1
            }
            ^"Starting Skills" DEF { CHOOSE 4 [^"Labor", ^"Martial Arts [Melee]", ^"Martial Arts [Unarmed]", ^"Meditation", ^"Survival", ^"Theology"] INTEGER 1 }
            ^"Starting Honor" INTEGER DEFAULT 48
            ^"Techniques Available" LIST ["Kata", "Kihō", "Rituals"]
        }


        STARTING_TECHNIQUES {
            KATA CHOOSE 2 [^"Iaijutsu Cut: Rising Blade", ^"Soaring Slice", ^"Striking as Water"]
            KIHO ^"Water Fist"
        }

        SCHOOL_ABILITY "Sharpened Ki" {
            "Your kihō that affect your unarmed attack profiles also apply to weapons you wield in a one-handed grip. When you succeed on a check to activate a kihō that affects your unarmed attack profiles or a weapon you wield in a one-handed grip, add bonus successes equal to your school rank."
        }

        MASTERY_ABILITY ^"The Effortless Path" {
            "When making a check to activate a kihō, you may spend (op) as follows: (op): If you succeed on this check, after you activate the kihō, you may perform a Strike action with a weapon you have readied in a one-handed grip."
        }
        STARTING_OUTFIT [
            "traveling clothes",
            "daishō (any one sword of rarity 7 or lower and wakizashi)",
            "traveling pack"
        ]

        CURRICULUM {
            RANK 1 {
                SKILL_GROUP "Martial Skills"
                SKILL "Labor"
                SKILL "Survival"
                SKILL "Theology"
                TECHNIQUE_GROUP "Rank 1 Kata"
                ^"Crescent Moon Style" [kata]
                ^"Ki Protection" [kiho]
            }
            RANK 2 {
                SKILL_GROUP "Scholar Skills"
                SKILL "Fitness"
                SKILL "Martial Arts [Melee]"
                SKILL "Meditation"
                TECHNIQUE_GROUP "Rank 1-2 Water Kihō"
                ^"Flowing Water Strike" [kata]
                ^"Iaijutsu Cut: Crossing Blade" [kata]
            }
            RANK 3 {
                SKILL_GROUP "Martial Skills"
                SKILL "Medicine"
                SKILL "Survival"
                SKILL "Theology"
                TECHNIQUE_GROUP "Rank 1-3 Earth Kihō"
                ^"Crimson Leaves Strike" [kata]
                ^"Still the Elements" [kiho]
            }
            RANK 4 {
                SKILL_GROUP "Scholar Skills"
                SKILL "Composition"
                SKILL "Martial Arts [Unarmed]"
                SKILL "Meditation"
                TECHNIQUE_GROUP "Rank 1-4 Void Kihō"
                ^"Striking as Void" [kata]
                ^"Crashing Wave Style" [kata]
            }
            RANK 5 {
                SKILL_GROUP "Martial Skills"
                SKILL "Labor"
                SKILL "Sentiment"
                SKILL "Theology"
                TECHNIQUE_GROUP "Rank 1-5 Kata"
                ^"Touch the Void Dragon" [kiho]
                ^"Way of the Edgeless Sword" [kiho]
            }
            RANK 6 {
                ^"The Effortless Path"
            }
        }

    }

    # source (page 93)
    ^"Moto Avenger" DEF {
        EXTENDS #L5R252wX4yZ6aB8cD0eF2g ^"School"
        APPLIES TO [^"Samurai"]
        DESCRIPTION "The Moto revere life, death, and the passage between the two. Life comes from the meeting of earth and sky as the rain falls to the plains; at death, the two are divided, for the body returns to the soil while the spirit returns to the sky. Moto spiritualists work to guide spirits to their proper place, that they may return to the eternal cycle, keeping the cosmos in balance. However, some beings defy the cycle through heresies such as undeath—and Moto Avengers are specialists trained to rectify such perversions of the natural order. The many Moto who have became Tainted within the Shadowlands have drawn Avengers from the distant corners of the Moto lands, that they might destroy these abominations and free the spirits of their fallen comrades."

        # Moto spiritualists guide spirits to their proper place.
        # Avengers specialize in rectifying perversions of the
        # natural order such as undeath. Many Moto fallen to
        # the Taint have drawn Avengers from distant corners.

        PROPERTIES {
            ^"School Name" STRING "Moto Avenger" FIXED
            ^"Clan" STRING "Unicorn"
            ^"Roles" LIST ["Shugenja"]
            ^"Ring Increase" DEF {
                ^"Air" INTEGER 1
                ^"Earth" INTEGER 1
            }
            ^"Starting Skills" DEF { CHOOSE 3 [^"Courtesy", ^"Culture", ^"Martial Arts [Melee]", ^"Sentiment", ^"Survival", ^"Theology"] INTEGER 1 }
            ^"Starting Honor" INTEGER DEFAULT 44
            ^"Techniques Available" LIST ["Air and Earth Invocations", "Rituals", "Shūji"]
        }


        STARTING_TECHNIQUES {
            INVOCATION ^"Grasp of Earth"
            INVOCATION ^"Tempest of Air"
            SHUJI ^"Ancestry Unearthed"
            SHUJI ^"Honest Assessment"
        }

        SCHOOL_ABILITY "Hands of Earth and Sky" {
            "When you perform an invocation that targets at least one other character, if you succeed, you may nourish or drain: Nourish: receive fatigue up to your school rank. One target removes fatigue equal to amount received. Drain: remove fatigue up to your school rank. One target receives fatigue equal to amount removed."
        }

        MASTERY_ABILITY ^"Empathic Transfer" {
            "When you nourish, you may remove one condition the target is suffering by transferring it to yourself. When you drain, you may remove one condition you are suffering by transferring it to one of your targets."
        }
        STARTING_OUTFIT [
            "traveling clothes", "ashigaru armor",
            "wakizashi", "scroll satchel",
            "finger of jade", "traveling pack",
            "Unicorn warhorse"
        ]

        CURRICULUM {
            RANK 1 {
                SKILL_GROUP "Scholar Skills"
                SKILL "Command"
                SKILL "Martial Arts [Melee]"
                SKILL "Survival"
                TECHNIQUE_GROUP "Rank 1 Rituals"
                ^"Bind the Shadow" [invocation]
                ^"Caress of Earth" [invocation]
            }
            RANK 2 {
                SKILL_GROUP "Martial Skills"
                SKILL "Culture"
                SKILL "Medicine"
                SKILL "Theology"
                TECHNIQUE_GROUP "Rank 1-2 Air Invocations"
                ^"Essence of Jade" [invocation]
                ^"Touchstone of Courage" [shuji]
            }
            RANK 3 {
                SKILL_GROUP "Trade Skills"
                SKILL "Courtesy"
                SKILL "Martial Arts [Melee]"
                SKILL "Tactics"
                TECHNIQUE_GROUP "Rank 1-3 Earth Shūji"
                ^"Earthquake" [invocation]
                ^"Earth Becomes Sky" [invocation]
            }
            RANK 4 {
                SKILL_GROUP "Social Skills"
                SKILL "Medicine"
                SKILL "Sentiment"
                SKILL "Theology"
                TECHNIQUE_GROUP "Rank 1-4 Earth Invocations"
                ^"Rise, Air" [invocation]
                ^"Wolf's Proposal" [shuji]
            }
            RANK 5 {
                SKILL_GROUP "Scholar Skills"
                SKILL "Martial Arts [Melee]"
                SKILL "Performance"
                SKILL "Survival"
                TECHNIQUE_GROUP "Rank 1-5 Air Invocations"
                ^"Rouse the Soul" [shuji]
                ^"Tomb of Jade" [invocation]
            }
            RANK 6 {
                ^"Empathic Transfer"
            }
        }

    }

    # source (page 94)
    ^"Toritaka Phantom Hunter" DEF {
        EXTENDS #L5R252wX4yZ6aB8cD0eF2g ^"School"
        APPLIES TO [^"Samurai"]
        DESCRIPTION "From the days of the Falcon Clan founder, Toritaka Yotogi, Toritaka Phantom Hunters have sought out gaki and other malign supernatural beings, a task that is often unfortunately easy, given the clan's proximity to the haunted Shinomen Forest and the corrupted Shadowlands. Phantom Hunters often act in concert with Crab Clan warriors, using their legendary abilities to detect supernatural threats that others, even the skilled bushi stationed on the Wall, cannot perceive."

        # From the days of Toritaka Yotogi, Phantom Hunters
        # have sought out gaki and malign supernatural beings.
        # They act in concert with Crab warriors, using legendary
        # abilities to detect threats others cannot perceive.

        PROPERTIES {
            ^"School Name" STRING "Toritaka Phantom Hunter" FIXED
            ^"Clan" STRING "Falcon"
            ^"Roles" LIST ["Shugenja"]
            ^"Ring Increase" DEF {
                ^"Air" INTEGER 1
                ^"Water" INTEGER 1
            }
            ^"Starting Skills" DEF { CHOOSE 3 [^"Culture", ^"Government", ^"Martial Arts [Melee]", ^"Sentiment", ^"Survival", ^"Theology"] INTEGER 1 }
            ^"Starting Honor" INTEGER DEFAULT 40
            ^"Techniques Available" LIST ["Invocations", "Rituals", "Shūji"]
        }


        STARTING_TECHNIQUES {
            INVOCATION ^"By the Light of the Lord Moon"
            RITUAL ^"Cleansing Rite"
            RITUAL ^"Commune with the Spirits"
            RITUAL ^"Tea Ceremony"
            SHUJI ^"Courtier's Resolve"
        }

        SCHOOL_ABILITY "Eyes of Yotogi" {
            "Otherworldly beings treat your vigilance as being increased by your school rank. When you make a check to search for Otherworldly beings, or make an Initiative check in a conflict against them, if you succeed, add bonus successes equal to your school rank."
        }

        MASTERY_ABILITY ^"Yotogi's Piercing Gaze" {
            "You can perceive beings that are normally invisible to human sight, such as spirits and characters concealed by supernatural abilities. When you deal damage to an Otherworldly being, you ignore an amount of its resistance up to your ranks in Meditation."
        }
        STARTING_OUTFIT [
            "traveling clothes", "sanctified robes",
            "daishō (katana and wakizashi)",
            "scroll satchel", "traveling pack"
        ]

        CURRICULUM {
            RANK 1 {
                SKILL_GROUP "Scholar Skills"
                SKILL "Courtesy"
                SKILL "Martial Arts [Melee]"
                SKILL "Survival"
                TECHNIQUE_GROUP "Rank 1 Air Invocations"
                ^"Bō of Water" [invocation]
                ^"Threshold Barrier" [ritual]
            }
            RANK 2 {
                SKILL_GROUP "Martial Skills"
                SKILL "Culture"
                SKILL "Sentiment"
                SKILL "Theology"
                TECHNIQUE_GROUP "Rank 1-2 Water Shūji"
                ^"Essence of Jade" [invocation]
                ^"Striking as Air" [kata]
            }
            RANK 3 {
                SKILL_GROUP "Social Skills"
                SKILL "Government"
                SKILL "Martial Arts [Melee]"
                SKILL "Sentiment"
                TECHNIQUE_GROUP "Rank 1-3 Water Invocations"
                ^"Rise, Water" [invocation]
                ^"Crescent Moon Style" [kata]
            }
            RANK 4 {
                SKILL_GROUP "Trade Skills"
                SKILL "Martial Arts [Melee]"
                SKILL "Performance"
                SKILL "Theology"
                TECHNIQUE_GROUP "Rank 1-4 Air Invocations"
                ^"Rouse the Soul" [shuji]
                ^"Soul Sunder" [kata]
            }
            RANK 5 {
                SKILL_GROUP "Scholar Skills"
                SKILL "Command"
                SKILL "Courtesy"
                SKILL "Survival"
                TECHNIQUE_GROUP "Rank 1-5 Air Shūji"
                ^"Flowing Water Cut" [kata]
                ^"Wrath of Kaze-no-Kami" [invocation]
            }
            RANK 6 {
                ^"Yotogi's Piercing Gaze"
            }
        }

    }

    # source (page 95)
    ^"Yogo Preserver" DEF {
        EXTENDS #L5R252wX4yZ6aB8cD0eF2g ^"School"
        APPLIES TO [^"Samurai"]
        DESCRIPTION "Like all Scorpion, Yogo Preservers view their duty to the Emperor as being beyond the considerations of honor. Theirs is a special task, bound to the cursed destiny of the original Yogo—protecting shrines that contain artifacts best lost to history, such as the Black Scrolls. Using their paper servants called shikigami, these somber individuals poison, murder, and thieve—in the name of staving off the darkness that threatens all Rokugan."

        # Yogo Preservers protect shrines containing artifacts
        # best lost to history, such as the Black Scrolls. Using
        # paper servants called shikigami, they poison, murder,
        # and thieve in the name of staving off the darkness.

        PROPERTIES {
            ^"School Name" STRING "Yogo Preserver" FIXED
            ^"Clan" STRING "Scorpion"
            ^"Roles" LIST ["Shugenja"]
            ^"Ring Increase" DEF {
                ^"Fire" INTEGER 1
                ^"Void" INTEGER 1
            }
            ^"Starting Skills" DEF { CHOOSE 3 [^"Aesthetics", ^"Courtesy", ^"Martial Arts [Melee]", ^"Sentiment", ^"Skulduggery", ^"Theology"] INTEGER 1 }
            ^"Starting Honor" INTEGER DEFAULT 38
            ^"Techniques Available" LIST ["Invocations", "Rituals", "Shūji"]
        }


        STARTING_TECHNIQUES {
            INVOCATION ^"By the Light of the Lord Moon"
            INVOCATION ^"Embrace of Kenro-Ji-Jin"
            INVOCATION ^"Yari of Air"
            RITUAL ^"Craft Shikigami"
            RITUAL ^"Threshold Barrier"
        }

        SCHOOL_ABILITY "Warded Shikigami" {
            "You can have a number of additional shikigami (see page 115) up to your school rank. Once per scene, after you perform an action, you may instruct one of your shikigami to perform an action, for which it benefits from your assistance."
        }

        MASTERY_ABILITY ^"Kingdom of Paper and Ink" {
            "When one of your shikigami performs an action, it may spend (op) as follows: (op)+: Another one of your shikigami at range 0-3 of you may perform an action. Increase the (op) cost of this ability by (op) for each of your shikigami that has acted this turn."
        }
        STARTING_OUTFIT [
            "traveling clothes", "sanctified robes",
            "concealed armor", "wakizashi",
            "bō (staff)", "traveling pack"
        ]

        CURRICULUM {
            RANK 1 {
                SKILL_GROUP "Artisan Skills"
                SKILL "Culture"
                SKILL "Martial Arts [Melee]"
                SKILL "Theology"
                TECHNIQUE_GROUP "Rank 1 Fire Invocations"
                ^"Cloak of Night" [invocation]
                ^"Reflections of P'an Ku" [invocation]
            }
            RANK 2 {
                SKILL_GROUP "Scholar Skills"
                SKILL "Aesthetics"
                SKILL "Courtesy"
                SKILL "Skulduggery"
                TECHNIQUE_GROUP "Rank 1-2 Air Invocations"
                ^"Hands of the Tides" [invocation]
                ^"Skulk" [ninjutsu]
            }
            RANK 3 {
                SKILL_GROUP "Trade Skills"
                SKILL "Government"
                SKILL "Smithing"
                SKILL "Theology"
                TECHNIQUE_GROUP "Rank 1-3 Fire Invocations"
                ^"Vapor of Nightmares" [invocation]
                ^"Wings of the Phoenix" [invocation]
            }
            RANK 4 {
                SKILL_GROUP "Social Skills"
                SKILL "Martial Arts [Melee]"
                SKILL "Performance"
                SKILL "Sentiment"
                TECHNIQUE_GROUP "Rank 1-4 Air Invocations"
                ^"Silencing Stroke" [ninjutsu]
                ^"Suijin's Embrace" [invocation]
            }
            RANK 5 {
                SKILL_GROUP "Artisan Skills"
                SKILL "Culture"
                SKILL "Government"
                SKILL "Theology"
                TECHNIQUE_GROUP "Rank 1-5 Fire Invocations"
                ^"Ever-Changing Waves" [invocation]
                ^"Tomb of Jade" [invocation]
            }
            RANK 6 {
                ^"Kingdom of Paper and Ink"
            }
        }

    }

    # ===========================
    # NEW ADVANTAGES: DISTINCTIONS
    # ===========================

    # source (page 96)
    ^"Dead Eyes" DEF {
        EXTENDS #L5R266oP8qR0sT2uV4wX6y ^"Distinction"

        PROPERTIES {
            ^"Ring" STRING "Earth"
            ^"Types" LIST ["Mental"]
        }

        EFFECT {
            "Your gaze is unnervingly calm, even in the face of horrors."
            "When performing a check that relies on avoiding fear or exuberant emotions (such as Meditation [Earth] to avoid running from a monstrous oni or Sentiment [Earth] to avoid being caught up in a raucous crowd), you may reroll up to two dice."
        }
    }

    # source (page 96)
    ^"Friend of the Nezumi" DEF {
        EXTENDS #L5R266oP8qR0sT2uV4wX6y ^"Distinction"

        PROPERTIES {
            ^"Ring" STRING "Water"
            ^"Types" LIST ["Interpersonal"]
        }

        EFFECT {
            "You have earned the trust and friendship of the nezumi, the ratfolk who dwell near the Kaiu Wall."
            "When performing a check to interact with nezumi or one that relates to your status with them (such as Courtesy [Water] to help locate a secret tunnel near the Wall or Performance [Water] to convince a tribe to follow your lead), you may reroll up to two dice."
        }
    }

    # source (page 96)
    ^"Light Sleeper" DEF {
        EXTENDS #L5R266oP8qR0sT2uV4wX6y ^"Distinction"

        PROPERTIES {
            ^"Ring" STRING "Water"
            ^"Types" LIST ["Physical"]
        }

        EFFECT {
            "You wake at the slightest disturbance, always alert even in slumber."
            "When performing a check that calls on rapidly recovering from sleep (such as Survival [Water] to detect a threatening sound while dozing or Fitness [Water] to react even when someone else is standing watch), you may reroll up to two dice."
        }
    }

    # ===========================
    # NEW ADVANTAGES: PASSIONS
    # ===========================

    # source (page 97)
    ^"Creatures" DEF {
        EXTENDS #L5R267zA9bC1dE3fG5hI7j ^"Passion"

        PROPERTIES {
            ^"Ring" STRING "Fire"
            ^"Types" LIST ["Mental"]
        }

        EFFECT {
            "You are fascinated by strange and monstrous creatures."
            "After performing a check to study or hear tales of odd creatures (such as Culture [Fire] to wonder about new creatures or Performance [Fire] to entice someone to offer you a tale of encounters with Shadowlands monsters), you remove 3 strife."
        }
    }

    # ===========================
    # NEW DISADVANTAGES: ADVERSITIES
    # ===========================

    # source (page 97)
    ^"Demon Wound" DEF {
        EXTENDS #L5R268kL0mN2oP4qR6sT8u ^"Adversity"

        PROPERTIES {
            ^"Ring" STRING "Earth"
            ^"Types" LIST ["Spiritual", "Scar"]
        }

        EFFECT {
            "You bear a wound inflicted by a denizen of the Shadowlands that never fully heals."
            "When you make a check that involves your wound (such as Fitness [Earth] to get a good night's sleep while in the Shadowlands or Meditation [Earth] to refrain from crying out in pain while near an oni), you must choose and reroll two dice showing (su) or (ex). After resolving the check, if you failed, gain 1 Void point."
        }
    }

    # source (page 97)
    ^"Lost Name" DEF {
        EXTENDS #L5R268kL0mN2oP4qR6sT8u ^"Adversity"

        PROPERTIES {
            ^"Ring" STRING "Void"
            ^"Types" LIST ["Spiritual"]
        }

        EFFECT {
            "You have lost your true name, whether through dark magic or spiritual crisis."
            "When you make a check that involves personal convictions (such as Meditation [Void] as part of your quest for Enlightenment or Survival [Void] to create a spiritually harmonious rock garden), you must choose and reroll two dice showing (su) or (ex). After resolving the check, if you failed, gain 1 Void point."
        }
    }

    # ===========================
    # NEW DISADVANTAGES: ANXIETIES
    # ===========================

    # source (page 97)
    ^"Fallen Ancestor" DEF {
        EXTENDS #L5R269vW1xY3zA5bC7dE9f ^"Anxiety"

        PROPERTIES {
            ^"Ring" STRING "Void"
            ^"Types" LIST ["Spiritual", "Interpersonal"]
        }

        EFFECT {
            "One of your ancestors fell to darkness, and their shame haunts you."
            "After performing a check that involves the spirits or your family history (such as Theology [Void] to perform a family ritual or Sentiment [Void] to show mercy to a wounded opponent), you receive 3 strife. If this is the first time this scene, gain 1 Void point."
        }
    }

    # source (page 98)
    ^"Obtuse" DEF {
        EXTENDS #L5R269vW1xY3zA5bC7dE9f ^"Anxiety"

        PROPERTIES {
            ^"Ring" STRING "Air"
            ^"Types" LIST ["Mental"]
        }

        EFFECT {
            "You struggle to pick up on social cues and the emotions of others."
            "After performing a check to analyze or react to the emotions of others (such as Design [Air] to compliment someone's garb or Sentiment [Air] to decode a double meaning in someone else's speech), you receive 3 strife. If this is the first time this scene, gain 1 Void point."
        }
    }

    # source (page 98)
    ^"Reformed Mahō-Tsukai" DEF {
        EXTENDS #L5R269vW1xY3zA5bC7dE9f ^"Anxiety"

        PROPERTIES {
            ^"Ring" STRING "Water"
            ^"Types" LIST ["Interpersonal"]
        }

        EFFECT {
            "You once practiced blood magic, and the memories of that dark time still haunt you."
            "After performing a check that reminds you of your former life (such as Courtesy [Water] to speak pleasantly with a priest or Meditation [Water] to calm yourself when witnessing the aftermath of a blood magic sacrifice), you receive 3 strife. If this is the first time this scene, gain 1 Void point."
        }
    }

    # ===========================
    # SHADOWLANDS TAINT DISADVANTAGES
    # ===========================

    # source (page 99)
    ^"Shadowlands Taint [Kansen Whispers]" DEF {
        EXTENDS #L5R268kL0mN2oP4qR6sT8u ^"Adversity"

        PROPERTIES {
            ^"Ring" STRING "Air"
            ^"Types" LIST ["Curse", "Mental"]
        }

        EFFECT {
            "Kansen whisper dark secrets in your ear, making it difficult to communicate with subtlety."
            "When you make a check to use subtlety in your communications (such as Courtesy [Air] to convey a double-meaning in court or Composition [Air] to refine your letter declining an important invitation), you must choose and reroll two dice showing (su) or (ex). After resolving the check, if you failed, gain 1 Void point."
        }
    }

    # source (page 99)
    ^"Shadowlands Taint [Distorted Limbs]" DEF {
        EXTENDS #L5R268kL0mN2oP4qR6sT8u ^"Adversity"

        PROPERTIES {
            ^"Ring" STRING "Earth"
            ^"Types" LIST ["Curse", "Physical"]
        }

        EFFECT {
            "Your limbs have become subtly distorted by the Taint, hindering your physical prowess."
            "When you make a check that calls on your physical prowess (such as Fitness [Earth] to survive a fall or Labor [Earth] to exert yourself in the field), you must choose and reroll two dice showing (su) or (ex). After resolving the check, if you failed, gain 1 Void point."
        }
    }

    # source (page 100)
    ^"Shadowlands Taint [Unnatural Skin]" DEF {
        EXTENDS #L5R268kL0mN2oP4qR6sT8u ^"Adversity"

        PROPERTIES {
            ^"Ring" STRING "Fire"
            ^"Types" LIST ["Curse", "Physical"]
        }

        EFFECT {
            "Your skin has become unnaturally tough, treated as concealed armor, but it hinders rapid movement."
            "When you make a check requiring rapid movements (such as Fitness [Fire] to vault over a falling log or Martial Arts [Unarmed] [Fire] to strike swiftly), you must choose and reroll two dice showing (su) or (ex). After resolving the check, if you failed, gain 1 Void point."
        }
    }

    # source (page 100)
    ^"Shadowlands Taint [One with the Darkness]" DEF {
        EXTENDS #L5R268kL0mN2oP4qR6sT8u ^"Adversity"

        PROPERTIES {
            ^"Ring" STRING "Void"
            ^"Types" LIST ["Curse", "Physical", "Spiritual"]
        }

        EFFECT {
            "When fully covered by shadows or in an unlit location, you cannot be detected. You can conceal non-physical effects of the Taint from detection."
            "When you make a check to intuit meaning (such as Courtesy [Void] to seek a hidden threat in a message or Survival [Void] to sense what crops will grow best), you must choose and reroll two dice showing (su) or (ex). After resolving the check, if you failed, gain 1 Void point."
        }
    }

    # source (page 100)
    ^"Shadowlands Taint [Blasphemous Appetites]" DEF {
        EXTENDS #L5R268kL0mN2oP4qR6sT8u ^"Adversity"

        PROPERTIES {
            ^"Ring" STRING "Water"
            ^"Types" LIST ["Curse", "Mental", "Spiritual"]
        }

        EFFECT {
            "You have a near uncontrollable hunger for raw meat. Once sated, you remove all strife."
            "When you make a check to notice details about those you care about (such as Sentiment [Water] to detect the emotional state of a friend or Medicine [Water] to determine their physical state), you must choose and reroll two dice showing (su) or (ex). After resolving the check, if you failed, gain 1 Void point."
        }
    }

    # ===========================
    # NEW SAMURAI HERITAGES
    # ===========================

    # source (page 101)
    ^"Shadowlands Heritages" DEF {
        APPLIES TO [^"Samurai"]

        # Unique heritages arising from Crab bloodline or
        # Shadowlands/Taint influence. Used instead of the
        # core heritage table during character creation.

        HERITAGE_TABLE {

            1 #2NmqoZtn7CJUKF8hO4WyFa ^"Blood and Mortar" DEF {
                MODIFIERS {
                    ^"Status" "+3"
                }

                EFFECT {
                    "Gain Blessed Lineage advantage (assignable in excess of normal limits)"
                    "While on the Wall, glory rank treated as 1 higher"
                }
            }

            2-3 #hyanImCpyOtCRSTIXhnMSH ^"Infamous Builder" DEF {
                MODIFIERS {
                    ^"Glory" "-5"
                }

                SUB_TABLE "1d10" {
                    "1-3" "Government"
                    "4-6" "Labor"
                    "7-10" "Smithing"
                }
            }

            4-5 #84VwRxlSr08Adoy6Rhk4q7 ^"Lost in the Darkness" DEF {
                MODIFIERS {
                    ^"Honor" "+5"
                    ^"Glory" "-5"
                }

                EFFECT {
                    "Ancestor might still be alive in the Shadowlands"
                }

                SUB_TABLE "1d10" {
                    "1-3" "Culture"
                    "4-6" "Survival"
                    "7-10" "Theology"
                }
            }

            6-7 #m9cR6fegiA8hgMJ2dy8NPD ^"Vengeance for the Fallen" DEF {
                MODIFIERS {
                    ^"Honor" "+5"
                }

                EFFECT {
                    "Gain Haunting (Void) adversity (assignable in excess of normal limits)"
                }

                SUB_TABLE "1d10" {
                    "1-3" "Fitness"
                    "4-5" "Martial Arts [Melee]"
                    "6-7" "Martial Arts [Ranged]"
                    "8" "Martial Arts [Unarmed]"
                    "9" "Tactics"
                    "10" "Meditation"
                }
            }

            8-9 #1iKq9ZKDEFk338jFlNxji5 ^"Twenty Goblin Thief" DEF {
                MODIFIERS {
                    ^"Glory" "-3"
                }

                SUB_TABLE "1d10" {
                    "1-3" "Culture"
                    "4-6" "Skulduggery"
                    "7-10" "Theology"
                }
            }

            10 #xNOTS8vnId74g6lqsZ9RVf ^"Tainted Blood" DEF {
                MODIFIERS {
                    ^"Status" "-3"
                }

                EFFECT {
                    "Gain Fallen Ancestor disadvantage"
                    "You may reduce one ring by 1 to increase Void Ring by 1 (cannot raise above 3)"
                }
            }
        }
    }

    # ===========================
    # NEW WEAPONS
    # ===========================

    # source (pages 102-104)
    ^"Shadowlands Weapons" DEF {
        APPLIES TO [^"Samurai"]

        ENTRIES {
            #tBgSRsVVBDIdP1dUcGMbDh ^"Flyssa" DEF { ^"Category" STRING "Sword" ^"Skill" STRING "Martial Arts [Melee]" ^"Range" STRING "1" ^"Damage" INTEGER 4 ^"Deadliness" INTEGER 4 ^"Grips" STRING "1-hand: -; 2-hand: Razor-Edged" ^"Qualities" STRING "Wargear" ^"Rarity" INTEGER 8 ^"Cost" STRING "15 koku" ^"Special" STRING "(op)(op)+: Ignore 1 point of target's physical resistance per (op)(op) spent." }
            #BFgjnFJU9wmxv9Oz7HDX3r ^"Kabutowari" DEF { ^"Category" STRING "Sword" ^"Skill" STRING "Martial Arts [Melee]" ^"Range" STRING "0-1" ^"Damage" INTEGER 3 ^"Deadliness" INTEGER 3 ^"Grips" STRING "1-hand: -" ^"Qualities" STRING "Durable, Snaring" ^"Rarity" INTEGER 7 ^"Cost" STRING "6 koku" }
            #leuagzC6zrrOGWF4STaBfZ ^"Tekkan" DEF { ^"Category" STRING "Sword" ^"Skill" STRING "Martial Arts [Melee]" ^"Range" STRING "1-2" ^"Damage" INTEGER 4 ^"Deadliness" INTEGER 3 ^"Grips" STRING "1-hand: Cumbersome; 2-hand: Damage +2" ^"Qualities" STRING "Durable, Wargear" ^"Rarity" INTEGER 8 ^"Cost" STRING "50 koku" }
            #CGItLx4r8lPR7OK4f3UBLo ^"Genno" DEF { ^"Category" STRING "Hammer" ^"Skill" STRING "Martial Arts [Melee]" ^"Range" STRING "0-1" ^"Damage" INTEGER 3 ^"Deadliness" INTEGER 3 ^"Grips" STRING "1-hand: -; 2-hand: Damage +4" ^"Qualities" STRING "Durable, Mundane" ^"Rarity" INTEGER 5 ^"Cost" STRING "1 koku" ^"Special" STRING "(op)(op): If you succeed but target reduces damage to 0, they suffer Dazed and Prone." }
            #WOGFKsz54i88BxV0Bfxv6o ^"Tsuruhashi" DEF { ^"Category" STRING "Axe" ^"Skill" STRING "Martial Arts [Melee]" ^"Range" STRING "1" ^"Damage" INTEGER 4 ^"Deadliness" INTEGER 3 ^"Grips" STRING "1-hand: Cumbersome; 2-hand: Deadliness +2" ^"Qualities" STRING "Mundane" ^"Rarity" INTEGER 4 ^"Cost" STRING "5 bu" ^"Special" STRING "(op)(op): If you succeed but target reduces damage to 0, their armor gains Damaged and they suffer Bleeding." }
            #gmLJffhOaTCEy7VzHLhzeO ^"Doom Crossbow" DEF { ^"Category" STRING "Crossbow" ^"Skill" STRING "Martial Arts [Ranged]" ^"Range" STRING "3-5" ^"Damage" INTEGER 8 ^"Deadliness" INTEGER 6 ^"Grips" STRING "2-hand: -" ^"Qualities" STRING "Cumbersome, Prepare, Wargear" ^"Rarity" INTEGER 10 ^"Cost" STRING "80 koku" ^"Special" STRING "When inflicting a critical strike, increase severity by the silhouette of the target." }
            #WMhsZeUximbOu1cNVtLw6C ^"Kaiu no Oyumi" DEF { ^"Category" STRING "Crossbow" ^"Skill" STRING "Martial Arts [Ranged]" ^"Range" STRING "2-5" ^"Damage" INTEGER 7 ^"Deadliness" INTEGER 3 ^"Grips" STRING "2-hand: -" ^"Qualities" STRING "Cumbersome, Prepare, Wargear" ^"Rarity" INTEGER 8 ^"Cost" STRING "60 koku" ^"Special" STRING "(op)(op): After performing the Attack action, immediately prepare this weapon for use again." }
            #7mjgYtbRHF99VmwPWby7jN ^"Storm Bow" DEF { ^"Category" STRING "Crossbow" ^"Skill" STRING "Martial Arts [Ranged]" ^"Range" STRING "1-4" ^"Damage" INTEGER 4 ^"Deadliness" INTEGER 3 ^"Grips" STRING "2-hand: -" ^"Qualities" STRING "Cumbersome, Prepare, Wargear" ^"Rarity" INTEGER 9 ^"Cost" STRING "60 koku" ^"Special" STRING "(op): Each character at range 0-1 of your initial target also becomes a target of this attack." }
            #r30CTp40kuTjABJFMP0l61 ^"Sode" DEF { ^"Category" STRING "Shield" ^"Skill" STRING "Martial Arts [Melee]" ^"Range" STRING "0" ^"Damage" INTEGER 1 ^"Deadliness" INTEGER 1 ^"Grips" STRING "Shoulder: -" ^"Qualities" STRING "Durable, Wargear" ^"Rarity" INTEGER 8 ^"Cost" STRING "8 koku" ^"Special" STRING "Do not require free hands. Cannot be wielded with another shield. Treat physical resistance as 1 higher against projectile attacks." }
            #pOQGMeEJnFQ1EcHao6aCFz ^"Large Shield" DEF { ^"Category" STRING "Shield" ^"Skill" STRING "Martial Arts [Melee]" ^"Range" STRING "0" ^"Damage" INTEGER 3 ^"Deadliness" INTEGER 2 ^"Grips" STRING "1-hand: -" ^"Qualities" STRING "Cumbersome, Durable, Wargear" ^"Rarity" INTEGER 8 ^"Cost" STRING "10 koku" ^"Special" STRING "While readied, treat physical resistance as 6. As Movement and Support action, increase TN of Attack checks targeting you by 2 until start of next turn." }
            #wMjt9k6ubQy44RhPdYL1mi ^"Small Shield" DEF { ^"Category" STRING "Shield" ^"Skill" STRING "Martial Arts [Melee]" ^"Range" STRING "0" ^"Damage" INTEGER 2 ^"Deadliness" INTEGER 2 ^"Grips" STRING "1-hand: -" ^"Qualities" STRING "Cumbersome, Durable, Wargear" ^"Rarity" INTEGER 8 ^"Cost" STRING "6 koku" ^"Special" STRING "While readied, treat physical resistance as 5. As Movement and Support action, increase TN of Attack checks targeting you by 1 until start of next turn." }
            #uDY5pIP5bZTvQuZIIbFkpP ^"Ballista" DEF { ^"Category" STRING "Siege" ^"Skill" STRING "Martial Arts [Ranged]" ^"Range" STRING "3-5" ^"Damage" INTEGER 14 ^"Deadliness" INTEGER 8 ^"Grips" STRING "2-hand: -" ^"Qualities" STRING "Durable, Prepare (2)" ^"Rarity" INTEGER 7 ^"Cost" STRING "60 koku" ^"Special" STRING "Damage ignores 4 points of physical resistance." }
            #4BKxa6LZIxDkOiKUtGXFRQ ^"O-Gata Dohou" DEF { ^"Category" STRING "Siege" ^"Skill" STRING "Martial Arts [Ranged]" ^"Range" STRING "4-5" ^"Damage" INTEGER 16 ^"Deadliness" INTEGER 6 ^"Grips" STRING "2-hand: -" ^"Qualities" STRING "Durable, Prepare (2)" ^"Rarity" INTEGER 7 ^"Cost" STRING "120 koku" }
        }

    }

