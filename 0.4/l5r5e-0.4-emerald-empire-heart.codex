        SOURCE "l5r5e-0.4-emerald-empire-heart.lore" AT "other-resources"
    }

    ENTITY #L5RcxEEheart04heralds ^"Imperial Heralds" {
        IS ^"Organization"
        SOURCE "l5r5e-0.4-emerald-empire-heart.lore" AT "other-resources"
        RELATIONSHIPS {
            ^"operated-by" -> ^"Miya" FROM "The Imperial Heralds of the Miya family"
        }
    }

    ENTITY #L5RcxEEheart05goshiz ^"Goshi" {
        IS ^"Title"
        SOURCE "l5r5e-0.4-emerald-empire-heart.lore" AT "samurai-among-the-commoners"
