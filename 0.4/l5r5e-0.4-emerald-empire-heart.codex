    ENTITY #L5RcxEEheart07buzzvil ^"Buzzing Fly Village" {
        IS ^"Village"
        SOURCE "l5r5e-0.4-emerald-empire-heart.lore" AT "buzzing-fly-village"
        RELATIONSHIPS {
            ^"located-in" -> ^"Rugashi Province" FROM "It is located in Rugashi Province"
            ^"held-by"    -> ^"Lion Clan"        FROM "within the Kitsu lands of the Lion Clan"
