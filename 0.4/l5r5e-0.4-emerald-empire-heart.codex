        SOURCE "l5r5e-0.4-emerald-empire-heart.lore" AT "brewmaster-reiha"
        RELATIONSHIPS {
            ^"oversees" -> ^"Buzzing Fly Brewery" FROM "Reiha is in charge of the Buzzing Fly Brewery"
        }
    }

    # -- Anbasukai Village ------------------------------------------------------

    ENTITY #L5RcxEEheart12anbavil ^"Anbasukai Village" {
        IS ^"Village"
        SOURCE "l5r5e-0.4-emerald-empire-heart.lore" AT "anbasukai-village"
