# .codex SECTION — Emerald Empire: Heart of the Empire (Chapter 3). Stand-off
# graph over l5r5e-0.4-emerald-empire-heart.lore (spec §25). Part of the L5R5e
# system graph. Built in batches; this file grows as the chapter is folded in.
# (Batch 1: the systemic entities + the rural village vignettes.)

CODEX "L5R5e_Codex_EE_Heart" {
    NAME "Emerald Empire: Heart of the Empire — Lore Graph"
    VERSION "0.1"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-09-02"
    FOR EDITION "l5r5e"
    DEPENDS_ON "L5R5e_Codex_Schema" VERSION "0.7"

    # -- Fortunes, orders, and offices -----------------------------------------

    ENTITY #L5RcxEEheart01inariz ^"Inari" {
        IS ^"Fortune"
        SOURCE "l5r5e-0.4-emerald-empire-heart.lore" AT "heart-of-the-empire"
    }

    ENTITY #L5RcxEEheart02koshin ^"Koshin" {
        IS ^"Fortune"
        SOURCE "l5r5e-0.4-emerald-empire-heart.lore" AT "other-resources"
    }

    ENTITY #L5RcxEEheart03barefo ^"Barefoot Brethren" {
