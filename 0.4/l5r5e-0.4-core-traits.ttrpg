BASE "L5R5e_Core_Traits" {
    NAME "Legend of the Five Rings 5th Edition - Rings, skills, and derived attributes"
    VERSION "0.4.3"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-03-01"

    # Core Rulebook: Rings, skills, derived values, social attributes
    # The Five Rings are the core attributes of L5R, each representing
    # a philosophy and approach to problem-solving, not just raw capability.

    # ===========================
    # THE FIVE RINGS
    # ===========================

    ^"Ring" DEF {
        APPLIES TO [^"Samurai", ^"Adversary", ^"Peasant"]

        INTEGER MIN 1 MAX 5

        # Rings are the fundamental attributes of every character.
        # Unlike traditional RPG stats, rings represent approaches
        # to action rather than innate physical/mental traits.
        # Ring value determines: dice kept, stance benefits, and
        # derived attributes.

        RULES {
            #L5R100aB2cD4eF6gH8iJ0k: ring_value_determines_kept_dice
            #L5R101lM3nO5pQ7rS9tU1v: ring_value_determines_approach
            #L5R102wX4yZ6aB8cD0eF2g: starting_rings_all_at_one
        }
    }

    ^"Air" DEF {
        APPLIES TO [^"Samurai", ^"Adversary", ^"Peasant"]

        INTEGER MIN 1 MAX 5

        # Personality: see GUIDANCE ^"air-ring".
        #
        # Air approaches: speaking carefully, moving precisely,
        # noticing subtle clues, striking with finesse, deceiving
        # with subtlety, crafting with delicacy.

        RULES {
            #L5R103hI5jK7lM9nO1pQ3r: air_stance_evasion
            #L5R104sT6uV8wX0yZ2aB4c: air_opportunity_precision
            #L5R105dE7fG9hI1jK3lM5n: air_contributes_to_focus
            #L5R106oP8qR0sT2uV4wX6y: air_contributes_to_vigilance
        }
    }

    ^"Earth" DEF {
        APPLIES TO [^"Samurai", ^"Adversary", ^"Peasant"]

        INTEGER MIN 1 MAX 5

        # Personality: see GUIDANCE ^"earth-ring".
        #
        # Earth approaches: withstanding, remembering, maintaining,
        # defending patiently, observing thoroughly, enduring.

        RULES {
            #L5R107zA9bC1dE3fG5hI7j: earth_stance_resilience
            #L5R108kL0mN2oP4qR6sT8u: earth_opportunity_reassurance
            #L5R109vW1xY3zA5bC7dE9f: earth_contributes_to_endurance
            #L5R110gH2iJ4kL6mN8oP0q: earth_contributes_to_composure
        }
    }

    ^"Fire" DEF {
        APPLIES TO [^"Samurai", ^"Adversary", ^"Peasant"]

        INTEGER MIN 1 MAX 5

        # Personality: see GUIDANCE ^"fire-ring".
        #
        # Fire approaches: creating, commanding, inventing, attacking
        # aggressively, speaking passionately, inspiring others.

        RULES {
            #L5R111rS3tU5vW7xY9zA1b: fire_stance_aggressive_bonus
            #L5R112cD4eF6gH8iJ0kL2m: fire_opportunity_inflict_strife
            #L5R113nO5pQ7rS9tU1vW3x: fire_contributes_to_endurance
            #L5R114yZ6aB8cD0eF2gH4i: fire_contributes_to_focus
        }
    }

    ^"Water" DEF {
        APPLIES TO [^"Samurai", ^"Adversary", ^"Peasant"]

        INTEGER MIN 1 MAX 5

        # Personality: see GUIDANCE ^"water-ring".
        #
        # Water approaches: perceiving, persuading, adapting, flowing
        # around defenses, reading people, moving gracefully.

        RULES {
            #L5R115jK7lM9nO1pQ3rS5t: water_stance_extra_action
            #L5R116uV8wX0yZ2aB4cD6e: water_opportunity_remove_fatigue
            #L5R117fG9hI1jK3lM5nO7p: water_contributes_to_composure
            #L5R118qR0sT2uV4wX6yZ8a: water_contributes_to_vigilance
        }
    }

    ^"Void" DEF {
        APPLIES TO [^"Samurai", ^"Adversary", ^"Peasant"]

        INTEGER MIN 1 MAX 5

        # Personality: see GUIDANCE ^"void-ring".
        #
        # Void approaches: acting instinctively, sensing the supernatural,
        # achieving enlightenment, meditating, divining.

        RULES {
            #L5R119bC1dE3fG5hI7jK9l: void_stance_scheme_immunity
            #L5R120mN2oP4qR6sT8uV0w: void_opportunity_reduce_tn
            #L5R121xY3zA5bC7dE9fG1h: void_determines_void_point_max
            #L5R122iJ4kL6mN8oP0qR2s: void_used_for_initiative
        }
    }

    # -----------------------------------------------------------------------
    # GUIDANCE (§22) — verbatim ring personalities (book pp.32-34).
    # -----------------------------------------------------------------------
    GUIDANCE {
        ENTRY ^"the-five-rings" #L5RG20aB1cD2eF3gH4iJ5k {
            CONCERNS [ ^"Ring" ]
            TOPICS [ "rings" ]
            TEXT "Each of the five rings represents a character's natural inclination toward a certain approach to solving problems. Rather than reflecting exclusively mental and physical parameters, a character's rings are primarily an expression of their propensity toward certain ways of seeing the world and facing challenges. When making a check using a given ring, a player rolls a number of Ring dice ((ring)) equal to their value for that ring. For player characters, each ring has a rank between 1 and 5, though some exceptional beings might possess values beyond this range."
        }
        ENTRY ^"air-ring" #L5RG21bC2dE3fG4hI5jK6l {
            CONCERNS [ ^"Air" ]
            TOPICS [ "rings", "air" ]
            TEXT "The Air Ring represents a graceful, cunning, and precise personality. This approach is subtle or layered with nuance, as the character moves too nimbly or speaks too obliquely to be pinned down. A character with a high Air Ring value is eloquent, physically and socially deft, and shrewd."
        }
        ENTRY ^"earth-ring" #L5RG22cD3eF4gH5iJ6kL7m {
            CONCERNS [ ^"Earth" ]
            TOPICS [ "rings", "earth" ]
            TEXT "The Earth Ring represents a character's aptitude for taking a steady, thorough, and grounded approach to problems. This approach is cautious and considerate, as the character works to get results without suffering losses or taking unneeded risks. A character with a high Earth Ring value is likely to be physically tough, mentally resilient, and reliable."
        }
        ENTRY ^"fire-ring" #L5RG23dE4fG5hI6jK7lM8n {
            CONCERNS [ ^"Fire" ]
            TOPICS [ "rings", "fire" ]
            TEXT "The Fire Ring represents a ferocious, direct, and inventive personality. This approach is explosive and intense, as the character works to get results no matter the cost to himself or others. A character with a high Fire Ring value is likely to be passionate, curious, physically quick, occasionally brusque, and a fast learner."
        }
        ENTRY ^"water-ring" #L5RG24eF5gH6iJ7kL8mN9o {
            CONCERNS [ ^"Water" ]
            TOPICS [ "rings", "water" ]
            TEXT "The Water Ring represents an adaptable, powerful, and perceptive personality. The approach is balanced and reversible, as the character works to achieve results without overextending themself or underperforming. A character with a high Water Ring value is naturally affable, physically flexible, observant, and easygoing."
        }
        ENTRY ^"void-ring" #L5RG25fG6hI7jK8lM9nO0p {
            CONCERNS [ ^"Void" ]
            TOPICS [ "rings", "void" ]
            TEXT "The Void Ring represents a centered, unflinching personality; it can also represent the \"flow state.\" By letting go of the suffering inherent in one's ego-driven desires, the samurai can transcend earthly limitations. It is the enlightened approach, accepting the nature of all Elements, yet allowing no one Element to dominate. A character with a high Void Ring value is likely to be spiritually sensitive, wise, and introspective."
        }
    }

    # ===========================
    # DERIVED ATTRIBUTES
    # ===========================

    ^"Endurance" DEF {
        APPLIES TO [^"Samurai", ^"Adversary"]

        INTEGER MIN 1

        # Represents physical stamina and ability to withstand fatigue
        # and damage in physical conflicts.
        # Formula: (Earth + Fire) × 2
        # When fatigue exceeds endurance, character is incapacitated.

        FORMULA "(Earth + Fire) × 2"

        RULES {
            #L5R123tU5vW7xY9zA1bC3d: incapacitation_at_max_fatigue
            #L5R124eF6gH8iJ0kL2mN4o: fatigue_tracked_against_endurance
        }
    }

    ^"Composure" DEF {
        APPLIES TO [^"Samurai", ^"Adversary"]

        INTEGER MIN 1

        # Represents emotional fortitude and ability to maintain decorum.
        # Formula: (Earth + Water) × 2
        # When strife > composure, character becomes Compromised.

        FORMULA "(Earth + Water) × 2"

        RULES {
            #L5R125pQ7rS9tU1vW3xY5z: compromised_when_strife_exceeds
            #L5R126aB8cD0eF2gH4iJ6k: strife_tracked_against_composure
            #L5R127lM9nO1pQ3rS5tU7v: strife_removal_between_scenes
        }
    }

    ^"Focus" DEF {
        APPLIES TO [^"Samurai", ^"Adversary"]

        INTEGER MIN 1

        # Represents mental sharpness and ability to concentrate.
        # Formula: Fire + Air
        # Used to break initiative ties.

        FORMULA "Fire + Air"

        RULES {
            #L5R128wX0yZ2aB4cD6eF8g: focus_breaks_initiative_ties
        }
    }

    ^"Vigilance" DEF {
        APPLIES TO [^"Samurai", ^"Adversary"]

        INTEGER MIN 0

        # Represents passive awareness and ability to detect threats.
        # Formula: (Air + Water) / 2 (rounded down)
        # Serves as TN for Scheme actions targeting the character.
        # Reduced to 1 when Compromised.

        FORMULA "(Air + Water) / 2 (rounded down)"

        RULES {
            #L5R129hI1jK3lM5nO7pQ9r: vigilance_is_scheme_tn
            #L5R130sT2uV4wX6yZ8aB0c: vigilance_drops_when_compromised
        }
    }

    ^"Void Points Max" DEF {
        APPLIES TO [^"Samurai", ^"Adversary"]

        INTEGER MIN 0

        # Maximum number of Void points a character can hold.
        # Formula: Void ring value
        # Void Points current is tracked against this maximum.
        # Void points are spent to activate certain abilities and
        # recovered through specific actions and rest.

        FORMULA "Void"

        RULES {
            #L5R130aT2uV4wX6yZ8aB0d: void_points_max_equals_void_ring
            #L5R130bE3fG5hI7jK9lM1o: void_points_current_tracked_against_max
        }
    }

    # ===========================
    # SOCIAL ATTRIBUTES
    # ===========================

    ^"Honor" DEF {
        APPLIES TO [^"Samurai"]

        INTEGER MIN 0 MAX 100

        # Rank = tens digit (e.g., honor 35 = rank 3).
        # Characters above rank 6 gain virtue advantages.
        # Characters below rank 3 gain flaw disadvantages.
        # Description: see GUIDANCE ^"honor".

        RULES {
            #L5R131dE3fG5hI7jK9lM1n: honor_rank_calculation
            #L5R132oP4qR6sT8uV0wX2y: forfeiting_honor_mechanics
            #L5R133zA5bC7dE9fG1hI3j: staking_honor_mechanics
            #L5R134kL6mN8oP0qR2sT4u: high_honor_virtue_advantages
            #L5R135vW7xY9zA1bC3dE5f: low_honor_flaw_disadvantages
        }
    }

    ^"Glory" DEF {
        APPLIES TO [^"Samurai"]

        INTEGER MIN 0 MAX 100

        # Rank = tens digit. Reflects how well-known a character's deeds are.
        # High glory grants fame advantages; low glory grants infamy.
        # Description: see GUIDANCE ^"glory".

        RULES {
            #L5R136gH8iJ0kL2mN4oP6q: glory_rank_calculation
            #L5R137rS9tU1vW3xY5zA7b: forfeiting_glory_mechanics
            #L5R138cD0eF2gH4iJ6kL8m: staking_glory_mechanics
            #L5R139nO1pQ3rS5tU7vW9x: high_glory_fame_advantages
            #L5R140yZ2aB4cD6eF8gH0i: low_glory_infamy_disadvantages
        }
    }

    ^"Status" DEF {
        APPLIES TO [^"Samurai"]

        INTEGER MIN 0 MAX 100

        # Rank = tens digit. Largely determined by birth and position.
        # Used by GM to determine social deference and authority.
        # Description: see GUIDANCE ^"status".

        RULES {
            #L5R141jK3lM5nO7pQ9rS1t: status_rank_calculation
            #L5R142uV4wX6yZ8aB0cD2e: status_determines_social_deference
            #L5R143fG5hI7jK9lM1nO3p: status_rarely_changes
        }
    }

    # -----------------------------------------------------------------------
    # GUIDANCE (§22) — verbatim social-attribute descriptions (book p37).
    # -----------------------------------------------------------------------
    GUIDANCE {
        ENTRY ^"honor" #L5RG26gH7iJ8kL9mN0oP1q {
            CONCERNS [ ^"Honor" ]
            TOPICS [ "honor", "social attributes" ]
            TEXT "Honor represents a character's personal investment in the concept of Bushidō and that character's belief that they are upholding the values it entails. Honor increases when a character makes a hard choice in the name of Bushidō, and decreases when a character acts in opposition to these values, loses faith in their code, or stakes their honor on an oath that they break. A high or low honor attribute results in a character gaining virtue advantages or flaw disadvantages (see Table 7-2: Honor Scores, on page 302)."
        }
        ENTRY ^"glory" #L5RG27hI8jK9lM0nO1pQ2r {
            CONCERNS [ ^"Glory" ]
            TOPICS [ "glory", "social attributes" ]
            TEXT "Glory represents society's view of a character's success in their mandated role. It reflects the reputation they have as an effective agent of their lord, as well as a general consensus on how they uphold Bushidō. Glory rises from a character's heroic deeds, and decreases when a character disparages Bushidō, lets their reputation suffer, or stakes it on a boastful claim they fail to fulfill. A high or low glory attribute results in a character gaining fame advantages or infamy disadvantages (see Table 7-3: Glory Scores, on page 304)."
        }
        ENTRY ^"status" #L5RG28iJ9kL0mN1oP2qR3s {
            CONCERNS [ ^"Status" ]
            TOPICS [ "status", "social attributes" ]
            TEXT "Status is an attribute that reflects a character's social standing, based on both their political sway and the mandate of the Celestial Order. Status changes infrequently; instead, it is mostly used by the GM to measure the comparative social standing of the PCs and various NPCs, as well as by the PCs to know the proper etiquette they should use to interact with a given NPC (see Table 7-4: Status Scores, on page 305)."
        }
        ENTRY ^"social-attributes-and-inner-conflict" #L5RG29jK0lM1nO2pQ3rS4t {
            CONCERNS [ ^"Honor", ^"Glory", ^"Status" ]
            TOPICS [ "social attributes", "theme" ]
            TEXT "Samurai dramas focus on characters' internal conflicts as much as external ones. While external foes and challenges frequently drive the plot, a samurai's principal battle is often fought within their own heart. In the Legend of the Five Rings Roleplaying Game, characters have three social attributes (honor, glory, and status) to help players weigh the societal forces constantly pulling upon a samurai."
        }
        ENTRY ^"gm-guidance-on-social-attributes" #L5RG30kL1mN2oP3qR4sT5u {
            CONCERNS [ ^"Honor", ^"Glory", ^"Status" ]
            TOPICS [ "social attributes", "game master" ]
            TEXT "Chapter 7: The Game Master has resources for GMs to use social attributes during the game. If a character's honor or glory increases above 64 or falls below 30, they begin to receive advantages or disadvantages as described in these tables."
        }
        ENTRY ^"you-the-player-and-you-the-character" #L5RG31lM2nO3pQ4rS5tU6v {
            CONCERNS [ ^"Advantage", ^"Technique" ]
            TOPICS [ "abilities", "second person" ]
            TEXT "Character abilities such as advantages and techniques are written in second person for clarity. As the player, you make all decisions for your character, who does what is described in the ability within the fiction of the game."
        }
    }

    # ===========================
    # SKILL GROUPS AND SKILLS
    # ===========================

    #L5R199uV8wX0yZ2aB4cD6e ^"Skill" DEF {
        APPLIES TO [^"Samurai", ^"Adversary"]

        INTEGER MIN 0 MAX 5

        # Learned abilities representing training and experience.
        # Combined with a ring to form dice pools (Skill dice = skill ranks).
        # Organized into five skill groups matching the five rings.
        # Each skill can be approached through any ring.
        #
        # Rank 0: Untrained
        # Rank 1: Beginner (basic training)
        # Rank 2: Apprentice (functional proficiency)
        # Rank 3: Professional (competent practitioner)
        # Rank 4: Expert (exceptional ability)
        # Rank 5: Master (among the greatest in the land)

        RULES {
            #L5R144qR6sT8uV0wX2yZ4a: skill_ranks_equal_skill_dice
            #L5R145bC7dE9fG1hI3jK5l: any_skill_any_ring_approach
            #L5R146mN8oP0qR2sT4uV6w: skill_groups_match_rings
        }
    }

    # --- ARTISAN SKILL GROUP ---

    ^"Aesthetics" DEF {
        APPLIES TO [^"Samurai", ^"Adversary"]

        INTEGER MIN 0 MAX 5

        # Understanding and creation of visual art, including painting,
        # sculpture, bonsai cultivation, ikebana (flower arranging),
        # rock gardens, and calligraphy. Also the appreciation and
        # critique of art.

        SKILL_GROUP "Artisan"

        RULES {
            #L5R147xY9zA1bC3dE5fG7h: art_creation_and_appreciation
        }
    }

    ^"Composition" DEF {
        APPLIES TO [^"Samurai", ^"Adversary"]

        INTEGER MIN 0 MAX 5

        # Creation of literary works: poetry, letters, essays, stories.
        # In Rokugan, composing poetry is an essential social skill
        # for samurai. Used for formal correspondence, love letters,
        # and political communication.

        SKILL_GROUP "Artisan"

        RULES {
            #L5R148iJ0kL2mN4oP6qR8s: literary_creation
            #L5R149tU1vW3xY5zA7bC9d: poetry_social_importance
        }
    }

    ^"Design" DEF {
        APPLIES TO [^"Samurai", ^"Adversary"]

        INTEGER MIN 0 MAX 5

        # Skill in fashion, clothing design, textile arts, and
        # personal presentation. Creating and selecting appropriate
        # attire for different occasions.

        SKILL_GROUP "Artisan"

        RULES {
            #L5R150eF2gH4iJ6kL8mN0o: fashion_and_presentation
        }
    }

    ^"Smithing" DEF {
        APPLIES TO [^"Samurai", ^"Adversary"]

        INTEGER MIN 0 MAX 5

        # Crafting of weapons, armor, and metal goods. In Rokugan,
        # swordsmithing is a sacred art. Also covers repair and
        # maintenance of equipment.

        SKILL_GROUP "Artisan"

        RULES {
            #L5R151pQ3rS5tU7vW9xY1z: weapon_and_armor_creation
            #L5R152aB4cD6eF8gH0iJ2k: sacred_swordsmithing
        }
    }

    # -----------------------------------------------------------------------
    # GUIDANCE (§22) — Chapter 3 Skills: per-skill descriptions + approach-uses
    # (book pp.141-170). Skill mechanics/ring/max live in the skill DEFs above.
    # -----------------------------------------------------------------------
    GUIDANCE {
        ENTRY ^"skill-smithing" #L5RG103nO4pQ5rS6tU7v {
            CONCERNS [ ^"Smithing" ]
            TOPICS [ "skills", "artisan", "smithing" ]
            TEXT "Samurai are warriors, and even their arts are influenced by war. The Smithing skill covers the creation of arms and armor for ceremonial and battlefield use. Many samurai go into battle wielding armor and weaponry that are stunning works of art in their own right. The finest armor and weapons—especially the daishō—are created with an eye toward both use and aesthetic, as they will be in service for centuries. They must reflect the influence and wealth of the family that owns them, for the sword is said to be the outward manifestation of the samurai's soul. Ruling families have weapons hundreds of years old, displayed in a place of honor as a living reminder of each family's history. The Phoenix and Crane are famous for the beauty of their work, while the Crab blades are known for durability and effectiveness. Those rare creations worked by a Kakita smith are widely acknowledged to be the greatest of all. The Smithing skill can be used with the appropriate rings as follows: Restore Approach (Earth Ring): Repairing a damaged weapon or piece of armor, performing routine upkeep and cleaning on a weapon or piece of armor, treating a weapon or piece of armor to prevent rust and corrosion. Adapt Approach (Water Ring): Improving an existing weapon or piece of armor, reshaping a mundane item into a weapon, sizing a weapon for a new wielder, salvaging a destroyed sword to reforge it. Invent Approach (Fire Ring): Forging a new blade, crafting a new piece of armor, inventing a new weapon or piece of armor, conjecturing about possible new weapons and armor technologies. Refine Approach (Air Ring): Polishing a blade to hone its edge, improving a spear's grip, adding embellishments to a naginata to accent the beautiful wave pattern of the steel. Attune Approach (Void Ring): Learning the purpose for which a weapon or piece of armor was forged, discerning whether a weapon or piece of armor has any supernatural features, unlocking supernatural potential within a forged item. Subskills: Armorsmithing, Bowmaking, Swordsmithing."
        }
    }

    # --- MARTIAL SKILL GROUP ---

    ^"Fitness" DEF {
        APPLIES TO [^"Samurai", ^"Adversary"]

        INTEGER MIN 0 MAX 5

        # Athletic ability, physical endurance, and body conditioning.
        # Covers running, climbing, swimming, jumping, and resisting
        # physical hardship. Used to resist critical strikes.

        SKILL_GROUP "Martial"

        RULES {
            #L5R153lM5nO7pQ9rS1tU3v: athletic_feats
            #L5R154wX6yZ8aB0cD2eF4g: critical_strike_resistance
        }
    }

    ^"Martial Arts [Melee]" DEF {
        APPLIES TO [^"Samurai", ^"Adversary"]

        INTEGER MIN 0 MAX 5

        # Training in melee weapons: katana, wakizashi, no-dachi,
        # naginata, yari, bo, tetsubō, and other hand-to-hand weapons.
        # The primary combat skill for most samurai.

        SKILL_GROUP "Martial"

        RULES {
            #L5R155hI7jK9lM1nO3pQ5r: melee_attack_checks
            #L5R156sT8uV0wX2yZ4aB6c: weapon_proficiency
        }
    }

    ^"Martial Arts [Ranged]" DEF {
        APPLIES TO [^"Samurai", ^"Adversary"]

        INTEGER MIN 0 MAX 5

        # Training in ranged weapons: yumi (bow), crossbow, shuriken,
        # blowgun, and throwing weapons. Archery is highly esteemed
        # in Rokugani culture.

        SKILL_GROUP "Martial"

        RULES {
            #L5R157dE9fG1hI3jK5lM7n: ranged_attack_checks
            #L5R158oP0qR2sT4uV6wX8y: archery_cultural_prestige
        }
    }

    ^"Martial Arts [Unarmed]" DEF {
        APPLIES TO [^"Samurai", ^"Adversary"]

        INTEGER MIN 0 MAX 5

        # Training in unarmed combat and improvised weapons. Covers
        # wrestling (sumai), punching, kicking, grappling, and
        # use of improvised objects as weapons.

        SKILL_GROUP "Martial"

        RULES {
            #L5R159zA1bC3dE5fG7hI9j: unarmed_attack_checks
            #L5R160kL2mN4oP6qR8sT0u: grappling_and_sumai
        }
    }

    ^"Meditation" DEF {
        APPLIES TO [^"Samurai", ^"Adversary"]

        INTEGER MIN 0 MAX 5

        # Mental discipline, emotional control, and spiritual focus.
        # Used for initiative checks, calming breath actions,
        # resisting fear, and spiritual practices.

        SKILL_GROUP "Martial"

        RULES {
            #L5R161vW3xY5zA7bC9dE1f: initiative_checks
            #L5R162gH4iJ6kL8mN0oP2q: calming_breath_strife_removal
            #L5R163rS5tU7vW9xY1zA3b: spiritual_focus
        }
    }

    ^"Tactics" DEF {
        APPLIES TO [^"Samurai", ^"Adversary"]

        INTEGER MIN 0 MAX 5

        # Strategic and tactical thinking. Used for commanding troops,
        # planning ambushes, coordinating groups, and initiative checks.
        # Essential for military leaders and battlefield commanders.

        SKILL_GROUP "Martial"

        RULES {
            #L5R164cD6eF8gH0iJ2kL4m: military_command
            #L5R165nO7pQ9rS1tU3vW5x: initiative_checks
            #L5R166yZ8aB0cD2eF4gH6i: battlefield_coordination
        }
    }

    # --- SCHOLAR SKILL GROUP ---

    ^"Culture" DEF {
        APPLIES TO [^"Samurai", ^"Adversary"]

        INTEGER MIN 0 MAX 5

        # Knowledge of Rokugani history, customs, etiquette, heraldry,
        # current events, and social protocols. Essential for navigating
        # the complex social hierarchies of the Empire.

        SKILL_GROUP "Scholar"

        RULES {
            #L5R167jK9lM1nO3pQ5rS7t: etiquette_knowledge
            #L5R168uV0wX2yZ4aB6cD8e: heraldry_identification
            #L5R169fG1hI3jK5lM7nO9p: historical_knowledge
        }
    }

    ^"Government" DEF {
        APPLIES TO [^"Samurai", ^"Adversary"]

        INTEGER MIN 0 MAX 5

        # Knowledge of law, bureaucracy, political systems, and
        # Imperial governance. Understanding of taxation, legal codes,
        # and administrative procedures.

        SKILL_GROUP "Scholar"

        RULES {
            #L5R170qR2sT4uV6wX8yZ0a: legal_knowledge
            #L5R171bC3dE5fG7hI9jK1l: bureaucratic_navigation
        }
    }

    ^"Medicine" DEF {
        APPLIES TO [^"Samurai", ^"Adversary"]

        INTEGER MIN 0 MAX 5

        # Knowledge of healing, herbal remedies, surgery, disease
        # treatment, and poison identification. Used to treat injuries,
        # create medicines, and diagnose illness.

        SKILL_GROUP "Scholar"

        RULES {
            #L5R172mN4oP6qR8sT0uV2w: healing_treatment
            #L5R173xY5zA7bC9dE1fG3h: poison_identification
            #L5R174iJ6kL8mN0oP2qR4s: disease_treatment
        }
    }

    ^"Sentiment" DEF {
        APPLIES TO [^"Samurai", ^"Adversary"]

        INTEGER MIN 0 MAX 5

        # Understanding of psychology, emotions, and motivations.
        # Used to read people's emotional states, understand their
        # desires, and predict behavior. Straddles Scholar and Social
        # skill groups.

        SKILL_GROUP "Scholar"

        RULES {
            #L5R175tU7vW9xY1zA3bC5d: emotional_reading
            #L5R176eF8gH0iJ2kL4mN6o: motivation_analysis
        }
    }

    ^"Theology" DEF {
        APPLIES TO [^"Samurai", ^"Adversary"]

        INTEGER MIN 0 MAX 5

        # Knowledge of the spiritual world: kami, Fortunes, Celestial
        # Order, Shinseism, religious practices, and the nature of
        # spirits. Essential for shugenja and monks.

        SKILL_GROUP "Scholar"

        RULES {
            #L5R177pQ9rS1tU3vW5xY7z: spiritual_knowledge
            #L5R178aB0cD2eF4gH6iJ8k: fortune_and_kami_lore
            #L5R179lM1nO3pQ5rS7tU9v: ritual_understanding
        }
    }

