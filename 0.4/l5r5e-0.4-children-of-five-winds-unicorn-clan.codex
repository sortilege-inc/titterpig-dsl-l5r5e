    }
    ENTITY #L5RcxCFWuni29riverhro ^"River of the Unexpected Hero" {
        IS ^"River"
        SOURCE "l5r5e-0.4-children-of-five-winds-unicorn-clan.lore" AT "the-lands-of-the-ide"
        RELATIONSHIPS { ^"located-in" -> ^"Shinomen Forest" FROM "The River of the Unexpected Hero bisects their provinces and eventually winds into the Shinomen Forest" }
    }
    ENTITY #L5RcxCFWuni30greatday ^"Great Day Palace" {
        IS ^"Palace"
        SOURCE "l5r5e-0.4-children-of-five-winds-unicorn-clan.lore" AT "the-lands-of-the-ide"
        RELATIONSHIPS {
            ^"held-by"      -> ^"Ide"                     FROM "Kyūden Ide is the only \"traditional\" keep in Unicorn lands... Great Day Castle"
            ^"located-near" -> ^"Chrysanthemum Petal Lake" FROM "Rising above the northern banks of Chrysanthemum Petal Lake and the surrounding lakeside town, Kyūden Ide" }
    }
    ENTITY #L5RcxCFWuni31goldyurt ^"Golden Yurts" {
        IS ^"Building"
        SOURCE "l5r5e-0.4-children-of-five-winds-unicorn-clan.lore" AT "the-lands-of-the-ide"
        RELATIONSHIPS { ^"held-by" -> ^"Ide" FROM "they maintain a fleet of mobile palatial tents known as the Golden Yurts... a portable palace" }
    }
    ENTITY #L5RcxCFWuni32ideyuto ^"Ide Yūto" {
        IS ^"Person"
        SOURCE "l5r5e-0.4-children-of-five-winds-unicorn-clan.lore" AT "ide-yūto"
        RELATIONSHIPS { ^"member-of" -> ^"Ide" FROM "As the son of high-ranking diplomats, wayward slacker Ide Yūto" }
    }

