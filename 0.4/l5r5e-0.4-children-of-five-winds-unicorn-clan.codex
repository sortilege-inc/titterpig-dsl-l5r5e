    }
    ENTITY ^"Dark Moto" {
        SOURCE "l5r5e-0.4-children-of-five-winds-unicorn-clan.lore" AT "moto"
        RELATIONSHIPS {
            ^"led-by"          -> ^"Moto Tsume"             FROM "Now, Moto Tsume's undying forces ride atop skeletal onikage... the Dark Moto endlessly train and launch relentless raids against the Kaiu Wall"
            ^"corrupted-by" -> ^"Jigoku"                 FROM "Moto Tsume himself is an immortal wraith enthralled by Jigoku's Taint"
            ^"located-in"   -> ^"Fallen Chrysanthemum Lake" FROM "From their stronghold at Fallen Chrysanthemum Lake, the Dark Moto endlessly train" }
    }
    ENTITY ^"Second Wind" {
        SOURCE "l5r5e-0.4-children-of-five-winds-unicorn-clan.lore" AT "moto"
        RELATIONSHIPS { ^"led-by" -> ^"Moto Tsume" FROM "he... led one-third of the Moto's warriors, the Second Wind, beyond the Wall to defeat the Shadowlands menace once and for all" }
    }
    ENTITY ^"Fallen Chrysanthemum Lake" {
        SOURCE "l5r5e-0.4-children-of-five-winds-unicorn-clan.lore" AT "moto"
        RELATIONSHIPS { ^"held-by" -> ^"Dark Moto" FROM "From their stronghold at Fallen Chrysanthemum Lake, the Dark Moto endlessly train and launch relentless raids against the Kaiu Wall" }
    }
    ENTITY #L5RcxCFWuni37kiro ^"Kiro" {
        IS ^"Artifact"
        SOURCE "l5r5e-0.4-children-of-five-winds-unicorn-clan.lore" AT "moto"
        RELATIONSHIPS { ^"held-by" -> ^"Moto Tsume" FROM "In his grip is Kiro, the ancestral sword of the Ki-Rin, once a symbol of the Shinjo's kinship and trust, now a trophy of the family's hubris" }
    }
    ENTITY ^"Moto Ogödei" {
        SOURCE "l5r5e-0.4-children-of-five-winds-unicorn-clan.lore" AT "moto"
        RELATIONSHIPS { ^"member-of" -> ^"Moto" FROM "They say Moto Ogödei's youngest son is determined to join the Crab Clan" }
    }
    ENTITY #L5RcxCFWuni39khulan ^"Shinjo Khulan Khan" {
        IS ^"Person"
        SOURCE "l5r5e-0.4-children-of-five-winds-unicorn-clan.lore" AT "the-hidden-valley"
        RELATIONSHIPS {
            ^"member-of"   -> ^"Shinjo"        FROM "the Unicorn Clan Champion Shinjo Khulan Khan"
            ^"leads"       -> ^"Unicorn Clan"  FROM "The people who live here, the Ganzu, pledged themselves to the Unicorn Clan Champion Shinjo Khulan Khan in 1010" }
    }
    ENTITY #L5RcxCFWuni40hiddenvl ^"Hidden Valley" {
        IS ^"City"
        SOURCE "l5r5e-0.4-children-of-five-winds-unicorn-clan.lore" AT "the-hidden-valley"
        RELATIONSHIPS {
            ^"located-near" -> ^"Pillar of the Sky" FROM "the Hidden Valley is a peaceful oasis in the deserts beyond the Pillar of the Sky mountains"
            ^"held-by"      -> ^"Ganzu"             FROM "The people who live here, the Ganzu, pledged themselves to the Unicorn Clan Champion" }
    }
    ENTITY #L5RcxCFWuni41ganzu ^"Ganzu" {
        IS ^"Faction"
        SOURCE "l5r5e-0.4-children-of-five-winds-unicorn-clan.lore" AT "the-hidden-valley"
        RELATIONSHIPS {
            ^"located-in" -> ^"Hidden Valley" FROM "The people who live here, the Ganzu"
            ^"serves"     -> ^"Unicorn Clan"  FROM "the Ganzu, pledged themselves to the Unicorn Clan Champion Shinjo Khulan Khan in 1010... stewarding the Sand Road on the clan's behalf" }
    }
    ENTITY #L5RcxCFWuni42lordsdth ^"Lords of Death" {
        IS ^"Faction"
        SOURCE "l5r5e-0.4-children-of-five-winds-unicorn-clan.lore" AT "religious-beliefs"
        RELATIONSHIPS { ^"member-of" -> ^"Moto" FROM "Chief among the Moto traditions is the worship of the Lords of Death... the traditional pantheon, the Ten Lords of Death" }
    }

    # ---- The world beyond Rokugan (Ki-Rin's exile) -------------------------
    ENTITY #L5RcxCFWuni43rempet ^"Empire of Rempet" {
        IS ^"Region"
        SOURCE "l5r5e-0.4-children-of-five-winds-unicorn-clan.lore" AT "iuchi"
    }
    ENTITY #L5RcxCFWuni44sunkings ^"Sun Kings" {
        IS ^"Faction"
        SOURCE "l5r5e-0.4-children-of-five-winds-unicorn-clan.lore" AT "the-lands-of-the-shinjo"
        RELATIONSHIPS { ^"located-in" -> ^"Empire of Rempet" FROM "when Shinjo fell into the hands of the Sun Kings and was held hostage for a profane ritual" }
    }
    ENTITY #L5RcxCFWuni45alqamari ^"al-Qamari" {
        IS ^"Organization"
        SOURCE "l5r5e-0.4-children-of-five-winds-unicorn-clan.lore" AT "the-lands-of-the-shinjo"
        RELATIONSHIPS {
