            ^"enemy-of"   -> ^"al-Qamari"        FROM "a necromancer tyrant who was overthrown by the Ki-Rin and al-Qamari" }
    }
    ENTITY #L5RcxCFWuni47plainsws ^"Plains of Wind and Stone" {
