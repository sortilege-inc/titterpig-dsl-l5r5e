        SOURCE "l5r5e-0.4-children-of-five-winds-unicorn-clan.lore" AT "culture-and-traditions"
    }

    # ---- Amendments to entities already in the graph -----------------------
    ENTITY ^"Far Traveler Castle" {
        SOURCE "l5r5e-0.4-children-of-five-winds-unicorn-clan.lore" AT "far-traveler-castle"
        RELATIONSHIPS {
            ^"held-by"      -> ^"Shinjo"           FROM "The seat of the Shinjo's power, Far Traveler Castle"
            ^"located-near" -> ^"Water Dragon Lake" FROM "rising over Water Dragon Lake to the west and Dragon's Heart Forest to the south" }
    }
    ENTITY ^"Shinjo Altansarnai" {
        SOURCE "l5r5e-0.4-children-of-five-winds-unicorn-clan.lore" AT "far-traveler-castle"
        RELATIONSHIPS { ^"leads" -> ^"Unicorn Clan" FROM "The current champion, Shinjo Altansarnai, proudly hangs monuments to her children's hunting prowess on these walls" }
    }
    ENTITY ^"Battle Maiden Castle" {
        SOURCE "l5r5e-0.4-children-of-five-winds-unicorn-clan.lore" AT "battle-maiden-castle"
        RELATIONSHIPS {
            ^"held-by"      -> ^"Utaku"               FROM "the Utaku's ancestral keep stands less than a day's ride from Far Traveler Castle"
            ^"located-near" -> ^"Far Traveler Castle" FROM "the Utaku's ancestral keep stands less than a day's ride from Far Traveler Castle" }
    }
    ENTITY ^"Dreamer's Forest" {
        SOURCE "l5r5e-0.4-children-of-five-winds-unicorn-clan.lore" AT "the-dreamers-forest"
        RELATIONSHIPS { ^"located-near" -> ^"Gatherer of Winds Castle" FROM "South of Shiro Iuchi is a lone patch of woods in the midst of the rolling plains... This cursed forest is off-limits, filled with malicious kansen" }
