            ^"ally-of"   -> ^"Unicorn Clan" FROM "It was he who found allies in al-Qamari and orchestrated Shinjo's rescue" }
    }
    ENTITY #L5RcxCFWuni46nephrent ^"Nephrentep" {
        IS ^"Person"
