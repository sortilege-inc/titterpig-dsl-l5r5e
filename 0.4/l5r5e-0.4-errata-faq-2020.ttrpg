    MODIFY ^"Voice of the Wilds" {
        STARTING_TECHNIQUES {
            RITUAL CHOOSE 1 [^"Commune with the Spirits", ^"Divination"]
            SHUJI CHOOSE 2 [^"Well of Desire", ^"Weight of Duty", ^"Rustling of Leaves", ^"Sensational Distraction"]
