            }
        }
    }

    MODIFY ^"Manifest Fire Kami" {
        PROPERTIES {
            ^"Rings" DEF {
                ^"Air" INTEGER 1
                ^"Earth" INTEGER 2
                ^"Fire" INTEGER 6
                ^"Water" INTEGER 2
                ^"Void" INTEGER 1
