    ^"GM Guidance: Optional Rules Catalog (2020)" DEF {
        APPLIES TO [^"Game Rules"]
        PROPERTIES {
            ^"Source Document" STRING "L5R5e FAQ August 2020"
            ^"Guidance Type"   STRING "Catalog of official optional rules across published books"
        }
        CATALOG {
            ^"Bonds" "Courts of Stone p. 136, Path of Waves p. 187"
            ^"Cross-Ring Opportunities" "Core rulebook p. 298"
            ^"Grittier Games" "Core rulebook p. 288"
            ^"Experienced PCs" "Core rulebook p. 305"
            ^"One-Roll Duels" "Core rulebook p. 261"
            ^"Range Bands on a Tactical Grid" "Core rulebook p. 266"
            ^"Risky Checks" "L5R5e FAQ August 2020 p. 9"
            ^"Ronin Honor and Glory" "Path of Waves p. 181"
            ^"Shoddy Improvised Weapons" "L5R5e FAQ August 2020 p. 10"
            ^"Subskills" "Core rulebook p. 143"
            ^"Trifling Breaches and Small Sacrifices" "Shadowlands p. 143, Courts of Stone p. 135"
            ^"Unmasking for Effect" "Courts of Stone p. 135"
        }
        RULES {
            #L5REF55wX6yZ8aB0cD2eF4g: gm_guidance_optional_rules_catalog
        }
