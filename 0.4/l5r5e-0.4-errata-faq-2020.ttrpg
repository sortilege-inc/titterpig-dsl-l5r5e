            ENTRY ^"errata-jian-0" #L5RERGrQjySvNNdSGpuDG2 {
                CONCERNS [ ^"Jian" ]
                TOPICS [ "errata" ]
                TEXT "p. 231: Table 5-1: Weapons, Jian entry: 2-hand grip should grant Razor-Edged quality in addition to +1 DLS."
