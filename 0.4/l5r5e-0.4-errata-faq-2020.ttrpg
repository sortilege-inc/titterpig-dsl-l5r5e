    MODIFY ^"Furiribi" {
        EXTENDS ^"NPC"

        PROPERTIES {
            ^"Type" STRING "Adversary" FIXED
            ^"Category" STRING "Spirit"
            ^"Combat Conflict Rank" INTEGER 1
            ^"Intrigue Conflict Rank" INTEGER 2
            ^"Description" STRING "An 'aimless flame' left behind after traumatic death. Purple orbs that linger where bodies died, luring unwary to deaths. Burns not flesh but soul."
            ^"Rings" DEF {
                ^"Air" INTEGER 2
                ^"Earth" INTEGER 2
                ^"Fire" INTEGER 2
                ^"Water" INTEGER 1
                ^"Void" INTEGER 1
            }
            ^"Endurance" INTEGER 6
            ^"Composure" INTEGER 4
            ^"Focus" INTEGER 4
            ^"Vigilance" INTEGER 2
            ^"Silhouette" INTEGER 0
            ^"Demeanor" STRING "Detached"
            ^"Social Skill Check TN Modifiers" STRING "Earth +1, Fire +1, Void -2"
            ^"Skills" LIST OF STRING ["Artisan 0", "Martial 1", "Scholar 0", "Social 0", "Trade 0"]
            ^"Advantages" LIST OF STRING ["Incorporeal (Earth) [Martial; Physical, Spiritual]"]
            ^"Disadvantages" LIST OF STRING ["Sadness (Void) [Social; Mental]"]
            ^"Gear" LIST OF STRING ["Ghostly energy (Physical 10)"]
        }

        ^"Ghostly Body" DEF {
            ^"Description" STRING "The furiribi is an Otherworldly creature of silhouette 0 that can pass through solid objects."
        }

        ^"Burns the Soul" DEF {
            ^"Description" STRING "When a creature touches a furiribi they must make a TN 4 Fitness check (Earth 5, Fire 5, Void 2) to resist the furiribi's spiritual flame. If a creature fails, they take 5 Supernatural damage and become Exhausted. If the target is already Exhausted, they become Incapacitated."
        }

        GUIDANCE {
            ENTRY ^"errata-furiribi-0" #L5RERG3gC9xsxNeb9svDIr {
                CONCERNS [ ^"Furiribi" ]
                TOPICS [ "errata" ]
                TEXT "p. 243, Furiribi: The Burns the Soul ability's final sentence should read 'If the target is already Exhausted, they suffer the Unconscious condition.'"
            }
        }
    }

    MODIFY ^"Void Points" {
        APPLIES TO [^"Samurai"]

        INTEGER MIN 0

        # Spiritual currency representing connection to the Void.
        # Maximum = Void ring value. Recovered slowly.

        STARTING_VALUE "Void ring value / 2 (rounded up)"
        MAXIMUM "Void ring value"

        USES {
            ^"Seize the Moment" "A samurai should know the right moment to act, but sometimes, even the hand of fate must be nudged by bold action. While making a check, during Step 3: Assemble and Roll Dice Pool, a character may spend 1 Void point to roll one additional Ring die (ring) and subsequently keep one additional die during Step 5: Choose Kept Dice."
            ^"Shattering Parry" "When faced with death, a samurai must sometimes accept terrible losses to survive. When trying to survive a critical strike, a character may spend 1 Void point to dramatically intercept the attack with their weapon to increase their chance of survival, potentially sacrificing the weapon in the process as described on page 270."
            ^"Techniques and Other Abilities" "Certain techniques and other character abilities require spending a Void point to activate."
        }

        RECOVERY {
            "After failing a check on which one of their adversities was resolved (see Resolving Advantages and Disadvantages, on page 24)."
            "Once per scene, after one of their anxieties caused their strife to rise (see Resolving Advantages and Disadvantages, on page 24)."
            "After choosing to be affected by a complication that the GM (or the controlling player) introduced into the scene (see page 39)."
            "After the GM conceals the TN of a check from the players (see When to Reveal or Conceal the TN, on page 297)."
        }

        GUIDANCE {
            ENTRY ^"faq-void-points-0" #L5RERGhqiiNO2zTzYULNn1 {
                CONCERNS [ ^"Void Points" ]
                TOPICS [ "faq" ]
                TEXT "Q: When a character's advantage is inverted during a check, do they gain 2 Void points if they then fail (or receive strife)? Do they gain 0 if the inverted advantage is canceled by a different advantage? A: Always gains back 1 Void point after the check, regardless of success/failure or cancellation by another advantage."
            }
        }
    }

    MODIFY ^"NPC" {
        # Metatype anchor for non-player character definitions

        GUIDANCE {
            ENTRY ^"faq-npc-0" #L5RERGWDUbIjcYBcdj39Sh {
                CONCERNS [ ^"NPC" ]
                TOPICS [ "faq" ]
                TEXT "Q: How should NPC Void points be handled? A: Minion NPCs do not have (and cannot spend) Void points. Adversary NPCs have Void points equal to half their Void Ring, rounded up."
            }
            ENTRY ^"faq-npc-1" #L5RERGhXFJetrBhW1gONat {
                CONCERNS [ ^"NPC" ]
                TOPICS [ "faq" ]
                TEXT "Q: When an NPC performs Mahō, how many rings count as having Shadowlands Taint for scaling? A: Not Tainted = 0 rings. Tainted (not Otherworldly) = 2 rings. Otherworldly + Tainted = 4 rings. If (combat) threat 10+, may count as 5 at GM's discretion."
            }
        }
    }

    MODIFY ^"School" {
        APPLIES TO [^"Samurai"]

        # Generic school type. School definitions EXTENDS this type.
        # A school defines the character's role, ring and skill
        # bonuses, starting honor, technique access, school ability,
        # curriculum, and mastery ability.

        PROPERTIES {
            ^"School Name" STRING REQUIRED FIXED
            ^"Clan" STRING REQUIRED
            ^"Roles" LIST REQUIRED                   # ["Bushi"], ["Courtier", "Shugenja"], etc.
            ^"Ring Increase" STRING REQUIRED          # "+1 [Ring], +1 [Ring]"
            ^"Starting Skills" STRING REQUIRED        # "choose N: +1 [Skill], +1 [Skill], ..."
            ^"Starting Honor" INTEGER MIN 0 MAX 100 REQUIRED
            ^"Techniques Available" LIST REQUIRED     # ["Kata", "Rituals", "Shūji"]
        }

        GUIDANCE {
            ENTRY ^"faq-school-0" #L5RERGCGrAiQ0uNlbuhloU {
                CONCERNS [ ^"School" ]
                TOPICS [ "faq" ]
                TEXT "Q: Can a character count multiple purchases from a single entry toward their current school rank? A: Yes, any number of purchases count."
            }
            ENTRY ^"faq-school-1" #L5RERGMMPnmNghBScmoRWi {
                CONCERNS [ ^"School" ]
                TOPICS [ "faq" ]
                TEXT "Q: If a character has = symbol access that they could not normally purchase, can they buy it after completing that rank? A: No. Special access does not persist."
            }
        }
    }

    MODIFY ^"Asahina Artificer" {
        EXTENDS #L5R252wX4yZ6aB8cD0eF2g ^"School"
        APPLIES TO [^"Samurai"]

        # Art and religion intertwine for the Asahina, for to them, faith,
        # beauty, and peace are all aspects of the same truth. The Asahina
        # take any opportunity to teach their philosophy and try to improve
        # harmony in the Empire.

        PROPERTIES {
            ^"School Name" STRING "Asahina Artificer" FIXED
            ^"Clan" STRING "Crane"
            ^"Roles" LIST ["Shugenja", "Artisan"]
            ^"Ring Increase" DEF {
                ^"Air" INTEGER 1
                ^"Fire" INTEGER 1
            }
            ^"Starting Skills" DEF { CHOOSE 3 [^"Aesthetics", ^"Courtesy", ^"Culture", ^"Design", ^"Games", ^"Theology"] INTEGER 1 }
            ^"Starting Honor" INTEGER DEFAULT 50
            ^"Techniques Available" LIST ["Invocations", "Rituals", "Shūji"]
        }

        STARTING_TECHNIQUES {
            INVOCATION CHOOSE 3 [^"Blessed Wind", ^"Armor of Radiance", ^"Inari's Blessing", ^"Reflections of P'an Ku", ^"Token of Memory"]
            RITUAL ^"Commune with the Spirits"
            RITUAL ^"Cleansing Rite"
        }

        SCHOOL_ABILITY "Spiritual Artisan" {
            "When making a check to mystically summon an illusion or to summon, augment, or awaken an object, you may add a number of kept (ring) set to (op) results equal to your school rank."
        }

        MASTERY_ABILITY ^"Stir the Slumbering Spirit" {
            "Once per game session as a downtime activity, you may make a TN 4 Artisan (Void) check to awaken an item's spirit. If you succeed, until the end of the game session, it becomes a nemuranai (see page 307) with a sealed invocation of your choice based on the item's history. The GM is the final arbiter of the appropriateness of any invocation selected this way."
        }

        STARTING_OUTFIT [
            "Sanctified robes",
            "wakizashi (short sword)", "knife",
            "yumi (bow)", "quiver of arrows",
            "scroll satchel", "traveling pack"
        ]

        # The Asahina Artificer School teaches its students invocations by
        # Elemental names, for they continue the traditions passed down from
        # Isawa Asahina, their founder.
        # (See ^"Invocation Names and Traditions")

        CURRICULUM {
            RANK 1 {
                SKILL_GROUP "Artisan Skills"
                SKILL "Courtesy"
                SKILL "Culture"
                SKILL "Theology"
                TECHNIQUE_GROUP "Rank 1 Air Invocations"
                ^"Path to Inner Peace" [invocation]
                ^"Artisan's Appraisal" [shuji]
            }
            RANK 2 {
                SKILL_GROUP "Scholar Skills"
                SKILL "Aesthetics"
                SKILL "Design"
                SKILL "Performance"
                TECHNIQUE_GROUP "Rank 1-2 Water Invocations"
                ^"Grasp of the Air Dragon" [invocation]
                ^"Tea Ceremony" [ritual]
            }
            RANK 3 {
                SKILL_GROUP "Social Skills"
                SKILL "Aesthetics"
                SKILL "Design"
                SKILL "Theology"
                TECHNIQUE_GROUP "Rank 1-3 Fire Invocations"
                ^"Wings of the Phoenix" [invocation]
                ^"Vapor of Nightmare" [invocation]
            }
            RANK 4 {
                SKILL_GROUP "Artisan Skills"
                SKILL "Fitness"
                SKILL "Performance"
                SKILL "Theology"
                TECHNIQUE_GROUP "Rank 1-4 Water Invocations"
                ^"Bend with the Storm" [shuji]
                ^"Rise, Air" [invocation]
            }
            RANK 5 {
                SKILL_GROUP "Scholar Skills"
                SKILL "Aesthetics"
                SKILL "Design"
                SKILL "Performance"
                TECHNIQUE_GROUP "Rank 1-5 Air Invocations"
                ^"Ever-Changing Waves" [invocation]
                ^"Buoyant Arrival" [shuji]
            }
            RANK 6 {
                ^"Stir the Slumbering Spirit"
            }
        }

        GUIDANCE {
            ENTRY ^"faq-asahina-artificer-0" #L5RERGisA8cpSxd4huuiCI {
                CONCERNS [ ^"Asahina Artificer" ]
                TOPICS [ "faq" ]
                TEXT "Q: When does the Asahina Artificer's school ability apply? A: It applies to invocations that summon illusions, summon objects, augment objects, or awaken objects."
            }
        }
    }

    MODIFY ^"Matsu Berserker" {
        EXTENDS #L5R252wX4yZ6aB8cD0eF2g ^"School"
        APPLIES TO [^"Samurai"]

        # The Matsu's soldiers are the front line and main strength of the
        # Lion armies. Their bravery and zeal for battle are unquestioned.
        # The Matsu warrior dōjō teaches the primacy of offense and the
        # necessity of seizing the initiative in all things. Aggression is the
        # hallmark of the Matsu style; direct action is their watchword.
        # This bellicose attitude often puts them at odds with the careful
        # strategies of the Akodo, but the Matsu serve the Lion and the
        # Empire with unquestioned loyalty.

        PROPERTIES {
            ^"School Name" STRING "Matsu Berserker" FIXED
            ^"Clan" STRING "Lion"
            ^"Roles" LIST ["Bushi"]
            ^"Ring Increase" DEF {
                ^"Earth" INTEGER 1
                ^"Fire" INTEGER 1
            }
            ^"Starting Skills" DEF { CHOOSE 5 [^"Command", ^"Fitness", ^"Labor", ^"Martial Arts [Melee]", ^"Martial Arts [Ranged]", ^"Martial Arts [Unarmed]", ^"Survival"] INTEGER 1 }
            ^"Starting Honor" INTEGER DEFAULT 55
            ^"Techniques Available" LIST ["Kata", "Rituals", "Shūji"]
        }

        STARTING_TECHNIQUES {
            KATA CHOOSE 1 [^"Rushing Avalanche Style", ^"Spinning Blades Style"]
            SHUJI ^"Stirring the Embers"
        }

        SCHOOL_ABILITY "Matsu's Fury" {
            "After you suffer a critical strike or unmask, you may suffer the Enraged condition to remove an amount of fatigue from yourself equal to your school rank."
        }

        MASTERY_ABILITY ^"Rending Jaws of the Lion" {
            "Once per round, when performing an Attack action check while Enraged, you may spend 1 Void point to alter each kept die containing (su) to a result containing (ex)."
        }

        STARTING_OUTFIT [
            "Ashigaru armor", "traveling clothes",
            "daishō (katana and wakizashi)",
            "nodachi (greatsword) or tessen (war fan)",
            "knife", "yumi (bow)", "quiver of arrows",
            "traveling pack"
        ]

        CURRICULUM {
            RANK 1 {
                SKILL_GROUP "Martial Skills"
                SKILL "Command"
                SKILL "Labor"
                SKILL "Survival"
                TECHNIQUE_GROUP "Rank 1 Kata"
                ^"Lord Akodo's Roar" [shuji]
                ^"Stonewall Tactics" [shuji]
            }
            RANK 2 {
                SKILL_GROUP "Martial Skills"
                SKILL "Command"
                SKILL "Medicine"
                SKILL "Smithing"
                TECHNIQUE_GROUP "Rank 1-2 Kata"
                ^"Heartpiercing Strike" [kata]
                ^"Fanning the Flames" [shuji]
            }
            RANK 3 {
                SKILL_GROUP "Martial Skills"
                SKILL "Composition"
                SKILL "Government"
                SKILL "Theology"
                TECHNIQUE_GROUP "Rank 1-3 Kata"
                ^"Disappearing World Style" [kata]
                ^"Rallying Cry" [shuji]
            }
            RANK 4 {
                SKILL_GROUP "Martial Skills"
                SKILL "Command"
                SKILL "Courtesy"
                SKILL "Culture"
                TECHNIQUE_GROUP "Rank 1-4 Kata"
                ^"Striking as Void" [kata]
                ^"Bravado" [shuji]
            }
            RANK 5 {
                SKILL_GROUP "Martial Skills"
                SKILL "Labor"
                SKILL "Medicine"
                SKILL "Smithing"
                TECHNIQUE_GROUP "Rank 1-5 Kata"
                ^"Rouse the Soul" [shuji]
                ^"Sear the Wound" [shuji]
            }
            RANK 6 {
                ^"Rending Jaws of the Lion"
            }
        }

        GUIDANCE {
            ENTRY ^"faq-matsu-berserker-0" #L5RERGb1cVtRC1FB8T9NY4 {
                CONCERNS [ ^"Matsu Berserker" ]
                TOPICS [ "faq" ]
                TEXT "Q: Can a Matsu Berserker's school ability trigger even while already suffering Enraged? A: Yes. Can trigger ability even while already Enraged (only one instance per Persistent Effects)."
            }
        }
    }

        ^"GM Guidance: TN Modifiers (2020)" DEF {
        APPLIES TO [^"Game Rules"]
        PROPERTIES {
            ^"Source Document" STRING "L5R5e FAQ August 2020"
            ^"Guidance Type"   STRING "TN modification by narrative circumstance"
            ^"Description"     STRING "Guidelines on modifying the TN of a check based on narrative circumstances."
        }
        TN_PENALTIES {
            ^"+1" STRING "Fresh snow on rooftop, scarce tools, lacking cultural context, radically different climate, biting insects, predisposition to distrust from past encounters."
            ^"+2" STRING "Entirely foreign tool, very rushed (half time or less), life-threateningly hot/cold, weak with hunger/thirst, significant encumbrance (two silhouette 2+ objects)."
            ^"+3" STRING "Not sharing a language, storm winds on open sea, acting against a celestial being's will in their presence."
        }
        TN_BONUSES {
            ^"-1" STRING "Uncommonly good tools, significantly more time (double+), gentle downhill slope, primary sources, acting per own giri/ninjō after unmasking, predisposition to trust (few encounters), appealing to target's giri or ninjō, favorable winds."
            ^"-2" STRING "Entire library on topic, an attendant for long march, predisposition to trust (many encounters), deep shadow for hiding, appealing to both giri and ninjō."
            ^"-3" STRING "Cart for moving heavy objects (silhouette 3+), acting with blessing of celestial being in their presence."
        }
        RULES {
            #L5REF49iJ0kL2mN4oP6qR8s: gm_guidance_tn_modifier_penalties
            #L5REF50tU1vW3xY5zA7bC9d: gm_guidance_tn_modifier_bonuses
        }
    }

        ^"GM Guidance: Staked Social Attributes (2020)" DEF {
        APPLIES TO [^"Game Rules"]
        PROPERTIES {
            ^"Source Document" STRING "L5R5e FAQ August 2020"
            ^"Guidance Type"   STRING "Staking honor, glory, status to convince or accomplish without checks"
            ^"Description"     STRING "Guidelines on staking honor, glory, and status to convince others or accomplish social goals without checks."
            ^"Personal Oaths"  STRING "Stake honor."
            ^"Public Statements" STRING "Stake glory."
            ^"Guarantees"      STRING "Based on position or finances: stake status."
            ^"Combined Oaths"  STRING "Stake all invoked attributes (with added benefits)."
            ^"Failure Penalty" STRING "If you fail to uphold the oath, lose staked points. If the opportunity to lose stake passes, staked points are returned. Lifetime oaths: GM/player may agree to treat as fulfilled."
        }
        HONOR_STAKES {
            ^"Honor's Demand" "Convince a samurai to uphold a Bushido aspect. Stake honor equal to your focus. Lost if you break the reciprocal Bushido restrictions their act entails."
            ^"Trust My Blade" "Entrust a samurai with a task without a check. Stake honor equal to target's status rank. Lost if you give up on or definitively fail the task."
            ^"I Will Return It" "Borrow an item without a check. Stake honor equal to item's rarity. Lost if the item is lost or cannot be returned."
            ^"To Betray Others Betrays Oneself" "Gain trust when you could benefit by betrayal. Stake honor equal to focus. Lost if you betray their trust or act significantly against their interests."
            ^"The Wise Listen" "Accept expertise without a check. Stake honor equal to target's status. Lost as Honor's Demand."
        }
        GLORY_STAKES {
            ^"This Oath I Claim" "Any honor-stake oath done publicly. Stake glory instead of (or in addition to) honor. Lost if failure becomes publicly known."
        }
        STATUS_STAKES {
            ^"Trust My Conviction" "Back ambitions socially or financially. Stake status 1 (single item) to 10 (army backing). Lost if you fail to make a gift of similar value or answer the backer's future requests for assistance."
        }
        COMBINED_STAKES {
            ^"Hear My Plea" "If the GM requires checks, stake an attribute to reduce TN. Attribute equal to target's focus for -1 TN, plus 3 additional per extra -1, maximum -3 total."
        }
        RULES {
            #L5REF51eF2gH4iJ6kL8mN0o: gm_guidance_staked_honor_examples
            #L5REF52pQ3rS5tU7vW9xY1z: gm_guidance_staked_glory_examples
            #L5REF53aB4cD6eF8gH0iJ2k: gm_guidance_staked_status_examples
            #L5REF54lM5nO7pQ9rS1tU3v: gm_guidance_staked_combined_hear_my_plea
        }
    }

