    # =================================================================
    # FAQ: CORE RULES — NEW IN 2020
    # =================================================================

    ^"FAQ: Simultaneous Effects Resolution Order (2020)" DEF {
        APPLIES TO [^"Game Rules"]
        PROPERTIES {
            ^"Source Document" STRING "L5R5e FAQ August 2020"
            ^"Clarifies"       STRING "Resolution order for simultaneous non-dice-modification effects"
            ^"Source Page"     STRING "Core p. 27"
            ^"Question"        STRING "When two effects (not dice modification) occur at the same time, how is order of resolution decided?"
            ^"Answer"          STRING "Follow the order for simultaneous dice modification (see p. 27 of the core rulebook)."
        }
        RULES {
            #L5REF37gH8iJ0kL2mN4oP6q: faq_simultaneous_effects_resolution_order
        }
    }

    ^"FAQ: Inverted Advantage Always 1 Void Point (2020)" DEF {
        APPLIES TO [^"Game Rules"]
        PROPERTIES {
            ^"Source Document" STRING "L5R5e FAQ August 2020"
            ^"Clarifies"       STRING "Void point return when an advantage is inverted"
            ^"Question"        STRING "When a character's advantage is inverted during a check, do they gain 2 Void points if they then fail (or receive strife)? Do they gain 0 if the inverted advantage is canceled by a different advantage?"
            ^"Answer"          STRING "Always gains back 1 Void point after the check, regardless of success/failure or cancellation by another advantage."
        }
        RULES {
            #L5REF38rS9tU1vW3xY5zA7b: faq_inverted_advantage_always_1_void_point
        }
    }

    ^"FAQ: NPC Void Points (2020)" DEF {
        APPLIES TO [^"Game Rules"]
        PROPERTIES {
            ^"Source Document" STRING "L5R5e FAQ August 2020"
            ^"Clarifies"       STRING "How NPCs (minion vs adversary) handle Void points"
            ^"Question"        STRING "How should NPC Void points be handled?"
            ^"Answer"          STRING "Minion NPCs do not have (and cannot spend) Void points. Adversary NPCs have Void points equal to half their Void Ring, rounded up."
        }
        RULES {
            #L5REF39cD0eF2gH4iJ6kL8m: faq_npc_void_points_minion_none_adversary_half
        }
    }

    # =================================================================
    # FAQ: CHARACTER ADVANCEMENT (carryover from 2019)
    # =================================================================

    ^"FAQ: Multiple Purchases Toward Rank (2020)" DEF {
        APPLIES TO [^"Game Rules"]
        PROPERTIES {
            ^"Source Document" STRING "L5R5e FAQ August 2020"
            ^"Clarifies"       STRING "Counting purchases toward school rank"
            ^"Question"        STRING "Can a character count multiple purchases from a single entry toward their current school rank?"
            ^"Answer"          STRING "Yes, any number of purchases count."
            ^"Carryover From"  STRING "L5R5e FAQ 2019"
        }
        RULES {
            #L5REF40nO1pQ3rS5tU7vW9x: faq_2020_multiple_purchases_count_toward_rank
        }
    }

    ^"FAQ: Special Access Does Not Persist (2020)" DEF {
        APPLIES TO [^"Game Rules"]
        PROPERTIES {
            ^"Source Document" STRING "L5R5e FAQ August 2020"
            ^"Clarifies"       STRING "'=' symbol special-access scope"
            ^"Question"        STRING "If a character has = symbol access that they could not normally purchase, can they buy it after completing that rank?"
            ^"Answer"          STRING "No. Special access does not persist."
            ^"Carryover From"  STRING "L5R5e FAQ 2019"
        }
        RULES {
            #L5REF41yZ2aB4cD6eF8gH0i: faq_2020_special_access_does_not_persist
        }
    }

    # =================================================================
    # FAQ: SCHOOL ABILITIES
    # =================================================================

    ^"FAQ: Asahina Artificer Ability Scope (2020)" DEF {
        APPLIES TO [^"Game Rules"]
        PROPERTIES {
            ^"Source Document" STRING "L5R5e FAQ August 2020"
            ^"Clarifies"       STRING "Asahina Artificer school ability scope"
            ^"Question"        STRING "When does the Asahina Artificer's school ability apply?"
            ^"Answer"          STRING "It applies to invocations that summon illusions, summon objects, augment objects, or awaken objects."
            ^"Carryover From"  STRING "L5R5e FAQ 2019"
        }
        RULES {
            #L5REF42jK3lM5nO7pQ9rS1t: faq_2020_asahina_artificer_ability_scope
        }
    }

    ^"FAQ: Matsu Berserker Enraged Trigger (2020)" DEF {
        APPLIES TO [^"Game Rules"]
        PROPERTIES {
            ^"Source Document" STRING "L5R5e FAQ August 2020"
            ^"Clarifies"       STRING "Matsu Berserker school ability and Enraged condition"
            ^"Question"        STRING "Can a Matsu Berserker's school ability trigger even while already suffering Enraged?"
            ^"Answer"          STRING "Yes. Can trigger ability even while already Enraged (only one instance per Persistent Effects)."
            ^"Carryover From"  STRING "L5R5e FAQ 2019"
        }
        RULES {
            #L5REF43uV4wX6yZ8aB0cD2e: faq_2020_matsu_berserker_enraged_trigger
        }
    }

    # =================================================================
    # FAQ: TECHNIQUES — EXPANDED IN 2020
    # =================================================================

    ^"FAQ: Iaijutsu Cut Razor-Edged + One-Hand Required (2020)" DEF {
        APPLIES TO [^"Game Rules"]
        PROPERTIES {
            ^"Source Document" STRING "L5R5e FAQ August 2020"
            ^"Clarifies"       STRING "Iaijutsu Cut weapon-grip and Razor-Edged requirements (expanded)"
            ^"Source Page"     STRING "Core p. 179"
            ^"Question"        STRING "Can Iaijutsu Cut techniques be used with a Razor-Edged weapon that has no one-handed grip (naginata, nodachi), or a one-handed grip that lacks Razor-Edged (jian)?"
            ^"Answer"          STRING "No to both. Iaijutsu Cut cannot be used with weapons that cannot be wielded in a one-handed grip, OR that lack Razor-Edged in their one-handed grip. (Expanded from 2019 answer to also cover the jian case.)"
        }
        RULES {
            #L5REF44fG5hI7jK9lM1nO3p: faq_iaijutsu_cut_razor_edged_one_hand_required
        }
    }

    ^"FAQ: Multi-Target Highest TN No Stacking (2020)" DEF {
        APPLIES TO [^"Game Rules"]
        PROPERTIES {
            ^"Source Document" STRING "L5R5e FAQ August 2020"
            ^"Clarifies"       STRING "Multi-target action checks and TN stacking"
            ^"Question"        STRING "When a multi-target action check (e.g. Thunderclap Strike) targets multiple characters with TN-increasing effects, what happens?"
            ^"Answer"          STRING "Take the highest TN from among the targets. Air stance bonus is not applied multiple times even if multiple targets are in Air stance."
        }
        RULES {
            #L5REF45qR6sT8uV0wX2yZ4a: faq_multi_target_highest_tn_no_stacking
        }
    }

    ^"FAQ: Mahō NPC Tainted Ring Scaling (2020)" DEF {
        APPLIES TO [^"Game Rules"]
        PROPERTIES {
            ^"Source Document" STRING "L5R5e FAQ August 2020"
            ^"Clarifies"       STRING "Tainted-ring counting for NPC mahō scaling"
            ^"Question"        STRING "When an NPC performs Mahō, how many rings count as having Shadowlands Taint for scaling?"
            ^"Answer"          STRING "Not Tainted = 0 rings. Tainted (not Otherworldly) = 2 rings. Otherworldly + Tainted = 4 rings. If (combat) threat 10+, may count as 5 at GM's discretion."
        }
        RULES {
            #L5REF46bC7dE9fG1hI3jK5l: faq_maho_npc_tainted_ring_scaling
        }
    }

    ^"FAQ: Redirect Timing After Kept Before Resolve (2020)" DEF {
        APPLIES TO [^"Game Rules"]
        PROPERTIES {
            ^"Source Document" STRING "L5R5e FAQ August 2020"
            ^"Clarifies"       STRING "Timing of redirect effects (Fiend's Retreat, Laughing Fox Style, etc.)"
            ^"Question"        STRING "When must a character choose to use Fiend's Retreat, Laughing Fox Style, and similar redirect effects?"
            ^"Answer"          STRING "After the attacker has chosen kept dice, but before symbols on kept dice are resolved (after Step 5, before Step 6)."
        }
        RULES {
            #L5REF47mN8oP0qR2sT4uV6w: faq_redirect_timing_after_kept_before_resolve
        }
    }

    # =================================================================
    # FAQ: LORE (carryover from 2019)
    # =================================================================

    ^"FAQ: Kisshoten Eight Great Fortunes Discrepancy (2020)" DEF {
        APPLIES TO [^"Game Rules"]
        PROPERTIES {
            ^"Source Document" STRING "L5R5e FAQ August 2020"
            ^"Clarifies"       STRING "Discrepancy between core rulebook and Emerald Empire on Eight Great Fortunes"
            ^"Question"        STRING "Why is Kisshōten noted as one of the Eight Great Fortunes in the core rulebook, but isn't in Emerald Empire?"
            ^"Answer"          STRING "Kisshōten is widely considered one of the Eight Great Fortunes, though some in Rokugan disagree. Those dissenters managed to remove Kisshōten's entry from Emerald Empire."
            ^"Carryover From"  STRING "L5R5e FAQ 2019"
        }
        RULES {
            #L5REF48xY9zA1bC3dE5fG7h: faq_2020_kisshoten_discrepancy
        }
    }

    # =================================================================
    # GM GUIDANCE: TN MODIFIERS
    # =================================================================

    ^"GM Guidance: TN Modifiers (2020)" DEF {
        APPLIES TO [^"Game Rules"]
        PROPERTIES {
            ^"Source Document" STRING "L5R5e FAQ August 2020"
            ^"Guidance Type"   STRING "TN modification by narrative circumstance"
            ^"Description"     STRING "Guidelines on modifying the TN of a check based on narrative circumstances."
        }
        TN_PENALTIES {
            ^"+1" STRING "Fresh snow on rooftop, scarce tools, lacking cultural context, radically different climate, biting insects, predisposition to distrust from past encounters."
            ^"+2" STRING "Entirely foreign tool, very rushed (half time or less), life-threateningly hot/cold, weak with hunger/thirst, significant encumbrance (two silhouette 2+ objects)."
            ^"+3" STRING "Not sharing a language, storm winds on open sea, acting against a celestial being's will in their presence."
        }
        TN_BONUSES {
            ^"-1" STRING "Uncommonly good tools, significantly more time (double+), gentle downhill slope, primary sources, acting per own giri/ninjō after unmasking, predisposition to trust (few encounters), appealing to target's giri or ninjō, favorable winds."
            ^"-2" STRING "Entire library on topic, an attendant for long march, predisposition to trust (many encounters), deep shadow for hiding, appealing to both giri and ninjō."
            ^"-3" STRING "Cart for moving heavy objects (silhouette 3+), acting with blessing of celestial being in their presence."
        }
        RULES {
            #L5REF49iJ0kL2mN4oP6qR8s: gm_guidance_tn_modifier_penalties
            #L5REF50tU1vW3xY5zA7bC9d: gm_guidance_tn_modifier_bonuses
        }
    }

    # =================================================================
    # GM GUIDANCE: STAKED SOCIAL ATTRIBUTES
    # =================================================================

    ^"GM Guidance: Staked Social Attributes (2020)" DEF {
        APPLIES TO [^"Game Rules"]
        PROPERTIES {
            ^"Source Document" STRING "L5R5e FAQ August 2020"
            ^"Guidance Type"   STRING "Staking honor, glory, status to convince or accomplish without checks"
            ^"Description"     STRING "Guidelines on staking honor, glory, and status to convince others or accomplish social goals without checks."
            ^"Personal Oaths"  STRING "Stake honor."
            ^"Public Statements" STRING "Stake glory."
            ^"Guarantees"      STRING "Based on position or finances: stake status."
            ^"Combined Oaths"  STRING "Stake all invoked attributes (with added benefits)."
            ^"Failure Penalty" STRING "If you fail to uphold the oath, lose staked points. If the opportunity to lose stake passes, staked points are returned. Lifetime oaths: GM/player may agree to treat as fulfilled."
        }
        HONOR_STAKES {
            ^"Honor's Demand" "Convince a samurai to uphold a Bushido aspect. Stake honor equal to your focus. Lost if you break the reciprocal Bushido restrictions their act entails."
            ^"Trust My Blade" "Entrust a samurai with a task without a check. Stake honor equal to target's status rank. Lost if you give up on or definitively fail the task."
            ^"I Will Return It" "Borrow an item without a check. Stake honor equal to item's rarity. Lost if the item is lost or cannot be returned."
            ^"To Betray Others Betrays Oneself" "Gain trust when you could benefit by betrayal. Stake honor equal to focus. Lost if you betray their trust or act significantly against their interests."
            ^"The Wise Listen" "Accept expertise without a check. Stake honor equal to target's status. Lost as Honor's Demand."
        }
        GLORY_STAKES {
            ^"This Oath I Claim" "Any honor-stake oath done publicly. Stake glory instead of (or in addition to) honor. Lost if failure becomes publicly known."
        }
        STATUS_STAKES {
            ^"Trust My Conviction" "Back ambitions socially or financially. Stake status 1 (single item) to 10 (army backing). Lost if you fail to make a gift of similar value or answer the backer's future requests for assistance."
        }
        COMBINED_STAKES {
            ^"Hear My Plea" "If the GM requires checks, stake an attribute to reduce TN. Attribute equal to target's focus for -1 TN, plus 3 additional per extra -1, maximum -3 total."
        }
        RULES {
            #L5REF51eF2gH4iJ6kL8mN0o: gm_guidance_staked_honor_examples
            #L5REF52pQ3rS5tU7vW9xY1z: gm_guidance_staked_glory_examples
            #L5REF53aB4cD6eF8gH0iJ2k: gm_guidance_staked_status_examples
            #L5REF54lM5nO7pQ9rS1tU3v: gm_guidance_staked_combined_hear_my_plea
        }
    }

    # =================================================================
    # GM GUIDANCE: USING OPTIONAL RULES
