    MODIFY ^"Void Points" {
        GUIDANCE {
            ENTRY ^"faq-void-points-0" #L5RERGhqiiNO2zTzYULNn1 {
                CONCERNS [ ^"Void Points" ]
                TOPICS [ "faq" ]
                TEXT "Q: When a character's advantage is inverted during a check, do they gain 2 Void points if they then fail (or receive strife)? Do they gain 0 if the inverted advantage is canceled by a different advantage? A: Always gains back 1 Void point after the check, regardless of success/failure or cancellation by another advantage."
            }
        }
    }

    MODIFY ^"NPC" {
        GUIDANCE {
            ENTRY ^"faq-npc-0" #L5RERGWDUbIjcYBcdj39Sh {
                CONCERNS [ ^"NPC" ]
                TOPICS [ "faq" ]
                TEXT "Q: How should NPC Void points be handled? A: Minion NPCs do not have (and cannot spend) Void points. Adversary NPCs have Void points equal to half their Void Ring, rounded up."
            }
            ENTRY ^"faq-npc-1" #L5RERGhXFJetrBhW1gONat {
                CONCERNS [ ^"NPC" ]
                TOPICS [ "faq" ]
                TEXT "Q: When an NPC performs Mahō, how many rings count as having Shadowlands Taint for scaling? A: Not Tainted = 0 rings. Tainted (not Otherworldly) = 2 rings. Otherworldly + Tainted = 4 rings. If (combat) threat 10+, may count as 5 at GM's discretion."
            }
        }
    }

    MODIFY ^"School" {
        GUIDANCE {
            ENTRY ^"faq-school-0" #L5RERGCGrAiQ0uNlbuhloU {
                CONCERNS [ ^"School" ]
                TOPICS [ "faq" ]
                TEXT "Q: Can a character count multiple purchases from a single entry toward their current school rank? A: Yes, any number of purchases count."
            }
            ENTRY ^"faq-school-1" #L5RERGMMPnmNghBScmoRWi {
                CONCERNS [ ^"School" ]
                TOPICS [ "faq" ]
                TEXT "Q: If a character has = symbol access that they could not normally purchase, can they buy it after completing that rank? A: No. Special access does not persist."
            }
        }
    }

    MODIFY ^"Asahina Artificer" {
        GUIDANCE {
            ENTRY ^"faq-asahina-artificer-0" #L5RERGisA8cpSxd4huuiCI {
                CONCERNS [ ^"Asahina Artificer" ]
                TOPICS [ "faq" ]
                TEXT "Q: When does the Asahina Artificer's school ability apply? A: It applies to invocations that summon illusions, summon objects, augment objects, or awaken objects."
            }
        }
    }

    MODIFY ^"Matsu Berserker" {
        GUIDANCE {
            ENTRY ^"faq-matsu-berserker-0" #L5RERGb1cVtRC1FB8T9NY4 {
                CONCERNS [ ^"Matsu Berserker" ]
                TOPICS [ "faq" ]
                TEXT "Q: Can a Matsu Berserker's school ability trigger even while already suffering Enraged? A: Yes. Can trigger ability even while already Enraged (only one instance per Persistent Effects)."
            }
        }
    }

        ^"GM Guidance: TN Modifiers (2020)" DEF {
        APPLIES TO [^"Game Rules"]
        PROPERTIES {
            ^"Source Document" STRING "L5R5e FAQ August 2020"
            ^"Guidance Type"   STRING "TN modification by narrative circumstance"
            ^"Description"     STRING "Guidelines on modifying the TN of a check based on narrative circumstances."
        }
        TN_PENALTIES {
            ^"+1" STRING "Fresh snow on rooftop, scarce tools, lacking cultural context, radically different climate, biting insects, predisposition to distrust from past encounters."
            ^"+2" STRING "Entirely foreign tool, very rushed (half time or less), life-threateningly hot/cold, weak with hunger/thirst, significant encumbrance (two silhouette 2+ objects)."
            ^"+3" STRING "Not sharing a language, storm winds on open sea, acting against a celestial being's will in their presence."
        }
        TN_BONUSES {
            ^"-1" STRING "Uncommonly good tools, significantly more time (double+), gentle downhill slope, primary sources, acting per own giri/ninjō after unmasking, predisposition to trust (few encounters), appealing to target's giri or ninjō, favorable winds."
            ^"-2" STRING "Entire library on topic, an attendant for long march, predisposition to trust (many encounters), deep shadow for hiding, appealing to both giri and ninjō."
            ^"-3" STRING "Cart for moving heavy objects (silhouette 3+), acting with blessing of celestial being in their presence."
        }
        RULES {
            #L5REF49iJ0kL2mN4oP6qR8s: gm_guidance_tn_modifier_penalties
            #L5REF50tU1vW3xY5zA7bC9d: gm_guidance_tn_modifier_bonuses
        }
    }

        ^"GM Guidance: Staked Social Attributes (2020)" DEF {
        APPLIES TO [^"Game Rules"]
        PROPERTIES {
            ^"Source Document" STRING "L5R5e FAQ August 2020"
            ^"Guidance Type"   STRING "Staking honor, glory, status to convince or accomplish without checks"
            ^"Description"     STRING "Guidelines on staking honor, glory, and status to convince others or accomplish social goals without checks."
            ^"Personal Oaths"  STRING "Stake honor."
            ^"Public Statements" STRING "Stake glory."
            ^"Guarantees"      STRING "Based on position or finances: stake status."
            ^"Combined Oaths"  STRING "Stake all invoked attributes (with added benefits)."
            ^"Failure Penalty" STRING "If you fail to uphold the oath, lose staked points. If the opportunity to lose stake passes, staked points are returned. Lifetime oaths: GM/player may agree to treat as fulfilled."
        }
        HONOR_STAKES {
            ^"Honor's Demand" "Convince a samurai to uphold a Bushido aspect. Stake honor equal to your focus. Lost if you break the reciprocal Bushido restrictions their act entails."
            ^"Trust My Blade" "Entrust a samurai with a task without a check. Stake honor equal to target's status rank. Lost if you give up on or definitively fail the task."
            ^"I Will Return It" "Borrow an item without a check. Stake honor equal to item's rarity. Lost if the item is lost or cannot be returned."
            ^"To Betray Others Betrays Oneself" "Gain trust when you could benefit by betrayal. Stake honor equal to focus. Lost if you betray their trust or act significantly against their interests."
            ^"The Wise Listen" "Accept expertise without a check. Stake honor equal to target's status. Lost as Honor's Demand."
        }
        GLORY_STAKES {
            ^"This Oath I Claim" "Any honor-stake oath done publicly. Stake glory instead of (or in addition to) honor. Lost if failure becomes publicly known."
        }
        STATUS_STAKES {
            ^"Trust My Conviction" "Back ambitions socially or financially. Stake status 1 (single item) to 10 (army backing). Lost if you fail to make a gift of similar value or answer the backer's future requests for assistance."
        }
        COMBINED_STAKES {
            ^"Hear My Plea" "If the GM requires checks, stake an attribute to reduce TN. Attribute equal to target's focus for -1 TN, plus 3 additional per extra -1, maximum -3 total."
        }
        RULES {
            #L5REF51eF2gH4iJ6kL8mN0o: gm_guidance_staked_honor_examples
            #L5REF52pQ3rS5tU7vW9xY1z: gm_guidance_staked_glory_examples
            #L5REF53aB4cD6eF8gH0iJ2k: gm_guidance_staked_status_examples
            #L5REF54lM5nO7pQ9rS1tU3v: gm_guidance_staked_combined_hear_my_plea
        }
    }

        ^"GM Guidance: Optional Rules Catalog (2020)" DEF {
        APPLIES TO [^"Game Rules"]
        PROPERTIES {
            ^"Source Document" STRING "L5R5e FAQ August 2020"
            ^"Guidance Type"   STRING "Catalog of official optional rules across published books"
        }
        CATALOG {
            ^"Bonds" "Courts of Stone p. 136, Path of Waves p. 187"
            ^"Cross-Ring Opportunities" "Core rulebook p. 298"
            ^"Grittier Games" "Core rulebook p. 288"
            ^"Experienced PCs" "Core rulebook p. 305"
            ^"One-Roll Duels" "Core rulebook p. 261"
            ^"Range Bands on a Tactical Grid" "Core rulebook p. 266"
            ^"Risky Checks" "L5R5e FAQ August 2020 p. 9"
            ^"Ronin Honor and Glory" "Path of Waves p. 181"
            ^"Shoddy Improvised Weapons" "L5R5e FAQ August 2020 p. 10"
            ^"Subskills" "Core rulebook p. 143"
            ^"Trifling Breaches and Small Sacrifices" "Shadowlands p. 143, Courts of Stone p. 135"
            ^"Unmasking for Effect" "Courts of Stone p. 135"
        }
        RULES {
            #L5REF55wX6yZ8aB0cD2eF4g: gm_guidance_optional_rules_catalog
        }
    }

        ^"Optional Rule Playset: Blood and Consequences" DEF {
        APPLIES TO [^"Game Rules"]
        PROPERTIES {
            ^"Source Document" STRING "L5R5e FAQ August 2020"
            ^"Focus"           STRING "Emotionally driven drama with high personal stakes. Violence is extremely deadly but quick to resolve. Characters die much more easily; transience of life is a core theme."
            ^"Optional Rules Used" LIST [
                "Bonds",
                "Grittier Games",
                "Experienced PCs (+20 starting XP)",
                "One-Roll Duels",
                "Ronin Honor and Glory",
                "Trifling Breaches and Small Sacrifices",
                "Unmasking for Effect"
            ]
        }
        RULES {
            #L5REF56hI7jK9lM1nO3pQ5r: playset_blood_and_consequences
        }
    }

