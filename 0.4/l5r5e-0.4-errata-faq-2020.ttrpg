        ^"Optional Rule: Risky Checks" DEF {
        APPLIES TO [^"Game Rules"]
        PROPERTIES {
            ^"Source Document"     STRING "L5R5e FAQ August 2020"
            ^"Source Page"         STRING "p. 9"
            ^"Rule Type"           STRING "Optional Rule" FIXED
            ^"Recommended For"     STRING "Dramatic campaigns with heroic action or large fortune swings"
            ^"Description"         STRING "Circumstances don't make a task easier or harder, but allow more reward for success or worse consequences for failure. Risk Level = additional bonus successes (on success) or additional shortfall (on failure). Default risk level is 0."
            ^"Procedure"           STRING "GM announces risk level with the TN before the dice roll. Player may reconsider and propose another path. On success: add bonus successes equal to risk level. On failure: add that amount to shortfall."
        }
        RISK_LEVELS {
            ^"+1" STRING "Charging downhill, flirting with higher status, outfoxing someone you know personally."
            ^"+2" STRING "Leaping from rafters onto enemy, speaking openly about emotions before higher status, experimental art technique."
            ^"+3" STRING "Jumping from second story into hay below, obliquely referencing higher-status person's failure, eschewing conventional wisdom on etiquette/artistry."
        }
        RULES {
            #L5REF62vW3xY5zA7bC9dE1f: optional_risky_checks_mechanic
            #L5REF63gH4iJ6kL8mN0oP2q: optional_risky_checks_examples
        }
    }

        ^"Optional Rule: Shoddy Improvised Weapons" DEF {
        APPLIES TO [^"Game Rules"]
        PROPERTIES {
            ^"Source Document"     STRING "L5R5e FAQ August 2020"
            ^"Source Page"         STRING "p. 10"
            ^"Rule Type"           STRING "Optional Rule" FIXED
            ^"Recommended For"     STRING "Campaigns valuing proper weapons and unarmed attacks"
            ^"Description"         STRING "Improvised weapons break more easily. Applies to weapons from core p. 230 and Path of Waves p. 113 profiles, but NOT those from Improvised Assault (Path of Waves p. 87, already destroyed at end of scene)."
            ^"Procedure"           STRING "After an Attack action check with an improvised weapon, it gains the Damaged quality (or Destroyed if already Damaged). Character may spend (op)+ from the Attack check to prevent Damaged. The (op) spent must be >= the number of Attack action checks performed with that weapon this scene."
        }
        REFERENCES {
            "Improvised weapons" -> #L5R444improvisedweapons01 ^"Improvised Weapons"
        }
        RULES {
            #L5REF64rS5tU7vW9xY1zA3b: optional_shoddy_improvised_weapons_mechanic
        }
    }

        ^"Treasure Hunter (Alternate) School" DEF {
        EXTENDS #L5RPW40nO5pQ7rS9tU1vW3x ^"Treasure Hunter"

        PROPERTIES {
            ^"School Name" STRING "Treasure Hunter (Alternate)" FIXED
            ^"Replaces"    STRING "Risk and Reward school ability"
            ^"Requires"    STRING "Risky Checks optional rule"
        }

        SCHOOL_ABILITY "Fortune and Folly" {
            "When you succeed at a risky check or a check to which one of your disadvantages applies, you may add a number of bonus successes up to your school rank."
        }

        RULES {
            #L5REF65cD6eF8gH0iJ2kL4m: alternate_treasure_hunter_fortune_and_folly
        }
    }

    MODIFY ^"Improvised Weapons" {
        GUIDANCE {
            ENTRY ^"errata-improvised-weapons-margin-note" #L5RERGimprvwpn2020aaaa {
                CONCERNS [ ^"Improvised Weapons" ]
                TOPICS [ "errata" ]
                TEXT "p. 230: The following margin note should be added: An improvised weapon uses the most similar weapon profile (often a club or a knife), with DMG and DLS reduced by 1, or more at the GM's discretion. They are wielded with Martial Arts [Unarmed]."
            }
        }
    }

}
