    }

    MODIFY ^"Qamarist Shield Bearer Tradition" {
        SET ^"Techniques Available" LIST ["Close Combat and General Kata", "Rituals", "Shūji"]
        CURRICULUM {
            RANK 2 {
                SKILL_GROUP "Martial Skills"
                SKILL "Command"
                SKILL "Government"
                SKILL "Smithing"
                TECHNIQUE_GROUP "Rank 1-2 Rituals"
                ^"Goading Taunt" [shuji]
                ^"Iron Shell Style" [kata]
            }
        }
        STARTING_OUTFIT [
            "traveling clothes", "lacquered armor",
            "yari (spear) or naginata (polearm)",
            "one weapon of rarity 6 or lower", "scimitar",
            "Qamarist heavy shield", "alchemical kit",
            "the Qamarist holy book", "traveling pack", "one trinket"
        ]

        GUIDANCE {
            ENTRY ^"errata-qamarist-shield-bearer-tradition-0" #L5RERGRLDmT6Op944xZmy6 {
                CONCERNS [ ^"Qamarist Shield Bearer Tradition" ]
                TOPICS [ "errata" ]
                TEXT "p. 56: Techniques Available should read 'Shūji' not 'Earth Shūji.' Curriculum Rank 2: 'Iron Shield Style' should read 'Iron Shell Style.' Starting Outfit should include 'scimitar.'"
            }
        }
    }

    MODIFY ^"Summoning Mantra" {
