    # Path of Waves Table 3-1 has no entity of its own — the profiles it lists are
    # individual item DEFs — so this entry corrects each affected item directly.
    # SET changes the property the item already declares; the errata provenance
    # fields are new on these items, so they are introduced in PROPERTIES (S13).

    MODIFY ^"Chair" {
        SET ^"Skills" STRING "Unarmed"
        PROPERTIES {
            # --- correction ---
            ^"Skills" STRING "Unarmed"

            ^"Source Book"    STRING "Path of Waves"
            ^"Source Chapter" STRING "Chapter 3"
            ^"Source Page"    STRING "p. 113"
            ^"Errata Note"    STRING "Table 3-1: Weapons: chair, lute, sake bottle and cups, scroll case should have \"Unarmed\" skill instead of \"Melee.\""
        }
        RULES {
