            ^"Disadvantages" LIST OF STRING ["Hubris: (air) Social; Mental"]
            ^"Favored Weapons" LIST OF STRING ["Claws: Range 0, Damage 0, Deadliness 2, Concealable, Razor-Edged"]
        }
        RULES {
            #L5RNGRRBpmJ6yQoB7s1hzh: cat_pouncing_predator "Pouncing Predator: A cat is a silhouette 0 creature. When performing an Attack action check against an unaware or Prone target, it may spend (op) as follows: (op): The target suffers the Disoriented condition."
        }
    }

