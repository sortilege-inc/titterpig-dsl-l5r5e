    #L5RNa2kUIxGJ7gBWwub7M7 ^"Animal Checks" DEF {
        APPLIES TO [^"NPC"]

        # Core Rulebook, page 325 sidebar.

        PROPERTIES {
            ^"Source Page" INTEGER 325
            ^"Description" STRING "Animals don't generally have ranks in Trade skills, but if they need to roll it, any wild animal has Survival rank 2 and any domesticated animal has Survival rank 1."
            ^"Wild Animal Survival Rank" INTEGER 2
            ^"Domesticated Animal Survival Rank" INTEGER 1
        }
    }

