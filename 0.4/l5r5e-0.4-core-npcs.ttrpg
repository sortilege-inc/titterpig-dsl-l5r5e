    #L5RNErFC2jRCfBSeQWvxWG ^"Utaku Steed" DEF {
        EXTENDS ^"NPC"

        PROPERTIES {
            ^"Type" STRING "Minion" FIXED
            ^"Category" STRING "Animals"
            ^"Combat Conflict Rank" INTEGER 4
            ^"Intrigue Conflict Rank" INTEGER 2
            ^"Source Page" INTEGER 327
            ^"Description" STRING "The sacred steeds of the Utaku Battlemaidens are paragons of horses. They are fiery and ferocious, but utterly loyal to their riders and fearless in the field."
            ^"Rings" DEF {
                ^"Air" INTEGER 1
                ^"Earth" INTEGER 3
                ^"Fire" INTEGER 3
                ^"Water" INTEGER 3
                ^"Void" INTEGER 1
            }
            ^"Endurance" INTEGER 14
            ^"Composure" INTEGER 10
            ^"Focus" INTEGER 6
            ^"Vigilance" INTEGER 2
            ^"Silhouette" INTEGER 3
            ^"Demeanor" STRING "Loyal"
            ^"Social Skill Check TN Modifiers" STRING "Air +1, Earth -2, Fire -2"
            ^"Skills" LIST OF STRING ["Artisan 0", "Martial 3", "Scholar 0", "Social 3", "Trade 0"]
            ^"Advantages" LIST OF STRING ["Tireless Runner: (earth) Martial; Physical"]
            ^"Disadvantages" LIST OF STRING ["Quick to Anger: (fire) Social; Interpersonal"]
            ^"Favored Weapons" LIST OF STRING ["Hooves: Range 1–2, Damage 7, Deadliness 6"]
            ^"Gear" LIST OF STRING ["Hide and armor (Physical 4)", "saddle", "saddlebags", "feed bag", "grooming kit"]
        }
        RULES {
            #L5RNz1ACFDh6gTBdKNbhNB: utaku_steed_legendary_steed "Legendary Steed: An Utaku steed is a silhouette 3 creature. It can be ridden by a human-sized (silhouette 2 or lower) rider, but generally does not tolerate any rider other than a worthy Utaku Battle Maiden."
            #L5RNmqRIpD2Nm5EQPuOzI4: utaku_steed_paragon_of_horses "Paragon of Horses: A Utaku steed grants its rider skilled assistance (see page 26) on Martial checks they make while mounted."
        }
    }

    #L5RNV9MAbdPWVMxSHmfiap ^"Wolf" DEF {
        EXTENDS ^"NPC"

        PROPERTIES {
            ^"Type" STRING "Minion" FIXED
            ^"Category" STRING "Animals"
            ^"Combat Conflict Rank" INTEGER 1
            ^"Intrigue Conflict Rank" INTEGER 1
            ^"Source Page" INTEGER 327
            ^"Description" STRING "Wolves lurk among the forested regions of the Empire in packs of ten or more, working collectively to stalk and bring down prey. They use relentless pursuit and quick “hit-and-run” attacks to hunt, only closing for the kill when their quarry is weakened and worn down. They usually avoid humans, but can be territorial if provoked."
            ^"Rings" DEF {
                ^"Air" INTEGER 2
                ^"Earth" INTEGER 2
                ^"Fire" INTEGER 3
                ^"Water" INTEGER 3
                ^"Void" INTEGER 1
            }
            ^"Endurance" INTEGER 4
            ^"Composure" INTEGER 4
            ^"Focus" INTEGER 6
            ^"Vigilance" INTEGER 4
            ^"Demeanor" STRING "Cautious"
            ^"Social Skill Check TN Modifiers" STRING "Air +2, Earth -2"
            ^"Skills" LIST OF STRING ["Artisan 0", "Martial 1", "Scholar 0", "Social 1", "Trade 0"]
            ^"Advantages" LIST OF STRING ["Pack Tactics: (water) Martial, Social; Interpersonal"]
            ^"Disadvantages" LIST OF STRING ["Cautious Hunter: (fire) Martial; Mental"]
            ^"Favored Weapons" LIST OF STRING ["Fangs: Range 0, Damage 4, Deadliness 4, Snaring"]
            ^"Gear" LIST OF STRING ["Hide (Physical 2)"]
        }
        RULES {
            #L5RNsnNHLkYM5By9K66j4u: wolf_circle_the_kill "Circle the Kill: When performing a Martial Arts [Unarmed] check, a wolf may spend (op) in the following ways. Water (op): The target suffers the Bleeding condition. Fire (op): The target treats all terrain as Dangerous (see page 267) until the end of their next turn."
        }
    }

    # ---------------------------
    # ANIMAL PROFILE VARIANTS
    # ---------------------------

    # Sidebar variants of the profiles above. Values inside a
    # ^"Profile Modifiers" block are added to the corresponding
    # value on the base profile; ^"Silhouette" is an absolute
    # override of the base profile's value.

    #L5RN5kzPH5roAYEKAm60mI ^"Large Dog" DEF {
        EXTENDS #L5RN5IJBqiCWVbxgJBNyRp ^"Dog"

        PROPERTIES {
            ^"Type" STRING "Minion" FIXED
            ^"Category" STRING "Animals"
            ^"Source Page" INTEGER 326
            ^"Description" STRING "Dogs come in a variety of sizes, from small hounds for rabbit hunting to massive beasts bred for battle. These can be represented with through one of the following sets of modifications to the Dog profile:"
            ^"Silhouette" INTEGER 2
            ^"Profile Modifiers" DEF {
                ^"Physical Resistance" INTEGER 1
                ^"Endurance" INTEGER 2
                ^"Combat Conflict Rank" INTEGER 1
            }
        }
    }

    #L5RNyFDKuvTbdd4xuTJRdE ^"Small Dog" DEF {
        EXTENDS #L5RN5IJBqiCWVbxgJBNyRp ^"Dog"

        PROPERTIES {
            ^"Type" STRING "Minion" FIXED
            ^"Category" STRING "Animals"
            ^"Source Page" INTEGER 326
            ^"Description" STRING "Dogs come in a variety of sizes, from small hounds for rabbit hunting to massive beasts bred for battle. These can be represented with through one of the following sets of modifications to the Dog profile:"
            ^"Silhouette" INTEGER 1
            ^"Profile Modifiers" DEF {
                ^"Vigilance" INTEGER 1
            }
        }
    }

    #L5RNO8mbPNvXHvOYdxXd2U ^"Unicorn Warhorse" DEF {
        EXTENDS #L5RN0gOLaJVZQteJXvkX1R ^"Horse (Rokugani Pony)"

        PROPERTIES {
            ^"Type" STRING "Minion" FIXED
            ^"Category" STRING "Animals"
            ^"Source Page" INTEGER 327
            ^"Description" STRING "Unicorn warhorses are vastly superior to Rokugani ponies as warhorses. A Unicorn warhorse can be represented with the following modifications to the Rokugani Pony profile:"
            ^"Removed Disadvantages" LIST OF STRING ["Skittish: (fire) Martial; Mental"]
            ^"Added Advantages" DEF {
                ^"Count" INTEGER 1
                ^"Source" STRING "Warrior NPC template (page 311)"
                ^"Options" LIST OF STRING ["Masterful Fighter: (earth) Martial; Mental", "Fearsome Presence: (fire) Social; Interpersonal", "Veteran’s Instincts: (water) Scholar; Mental"]
            }
            ^"Profile Modifiers" DEF {
                ^"Endurance" INTEGER 4
                ^"Composure" INTEGER 4
                ^"Combat Conflict Rank" INTEGER 1
            }
        }
    }
    ^"Artist Template" DEF {
        APPLIES TO [^"NPC Template"]

        # Core Rulebook p312: NPC template overlay applied to a base NPC profile.

        PROPERTIES {
            ^"Base Profile" STRING "Any NPC profile"
            ^"Conflict Rank Modifier" STRING "Intrigue +2"
            ^"Ring Modifier" STRING "+1 Fire"
            ^"Skill Modifier" STRING "+2 Artisan and Social skills"
            ^"Advantages (Add or Replace 0-2)" STRING "Eye for Detail (Air) [Artisan; Mental], Renown (Fire) [Artisan; Interpersonal], Steady Hand (Earth) [Artisan; Physical]"
            ^"Disadvantages (Add or Replace 0-2)" STRING "Cantankerous (Water) [Social; Interpersonal], Naiveté (Fire) [Social; Interpersonal], World-Weariness (Earth) [Social; Interpersonal]"
            ^"Techniques (Add)" STRING "Shūji (shuji)"
            ^"Demeanor (Replace 1)" STRING "Detached, Gruff, Shrewd"
        }

        RULES {
            #2ESMowcuaIwakEEmiQoaC8: artist_template_overlay
        }
    }

    ^"Investigator Template" DEF {
        APPLIES TO [^"NPC Template"]

        # Core Rulebook p312: NPC template overlay applied to a base NPC profile.

        PROPERTIES {
            ^"Base Profile" STRING "Any NPC profile"
            ^"Conflict Rank Modifier" STRING "Combat +2, Intrigue +2"
            ^"Ring Modifier" STRING "+1 Air"
            ^"Skill Modifier" STRING "+1 Martial and Scholar Skills"
            ^"Advantages (Add or Replace 0-2)" STRING "Analytical Mind (Fire) [Scholar; Mental], Self-Awareness (Void) [Martial; Mental], Sharp Eyes (Water) [Scholar; Physical]"
            ^"Disadvantages (Add or Replace 0-2)" STRING "Disbeliever (Fire) [Social; Mental], Haughty Tone (Air) [Social; Interpersonal], Severe Allergies (Earth) [Martial; Physical]"
            ^"Techniques (Add)" STRING "Kata (kata), Shūji (shuji)"
