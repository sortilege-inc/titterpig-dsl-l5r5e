                ^"Void" INTEGER 4
            }
            ^"Demeanor" STRING "Amiable"
            ^"Social Skill Check TN Modifiers" STRING "Air +2, Earth -2"
            ^"Endurance" INTEGER 7
            ^"Composure" INTEGER 12
            ^"Focus" INTEGER 8
            ^"Vigilance" INTEGER 4
            ^"Honor" INTEGER 55
            ^"Glory" INTEGER 70
            ^"Status" INTEGER 35
            ^"Skills" LIST OF STRING ["Artisan 2", "Martial 0", "Scholar 4", "Social 4", "Trade 3"]
            ^"Advantages" LIST OF STRING ["Keen Empathy (Void) [Social; Interpersonal]", "Scholar of the Tao (Void) [Scholar; Mental]"]
            ^"Disadvantages" LIST OF STRING ["Dangerous Secrets (Fire) [Social; Interpersonal]"]
            ^"Favored Weapons" LIST OF STRING ["Bō: Range 1-2, Damage 6, Deadliness 2, Mundane"]
            ^"Gear" LIST OF STRING ["Sanctified robes (Physical 1, Supernatural 3, Ceremonial)", "copy of the Tao of Shinsei"]
        }
        DESCRIPTION "Hinata is a lean and wiry man in his late forties with a friendly and outgoing demeanor, a ready smile, and a quick wit. He is extremely charismatic, applying his innate charm to all his interactions, but he is particularly amiable when dealing with commoners (both heimin and hinin). His knowledge of the Tao of Shinsei is almost encyclopedic, and he often punctuates his speech with appropriate quotes from it."
        ^"Quote the Tao" DEF {
            ^"Description" STRING "Once per scene, Hinata may quote from the Tao of Shinsei in a way particularly relevant to the situation and choose a character in the scene. The next Social skill or Scholar skill check the chosen character makes in that scene reduces its TN by 2 (to a minimum of 1)."
        }
        RULES {
            #L5RPOWnpc19Hinata: hinata
        }
    }

    # source stat block (page 165)
    ^"Yuuto" DEF {
        EXTENDS ^"NPC"
        PROPERTIES {
            ^"Type" STRING "Adversary" FIXED
            ^"Combat Conflict Rank" INTEGER 2
            ^"Intrigue Conflict Rank" INTEGER 4
            ^"Rings" DEF {
                ^"Air" INTEGER 3
                ^"Earth" INTEGER 2
                ^"Fire" INTEGER 3
                ^"Water" INTEGER 3
                ^"Void" INTEGER 3
            }
            ^"Demeanor" STRING "Restrained"
            ^"Social Skill Check TN Modifiers" STRING "Earth +2, Air -2"
            ^"Endurance" INTEGER 8
            ^"Composure" INTEGER 14
            ^"Focus" INTEGER 7
            ^"Vigilance" INTEGER 4
            ^"Honor" INTEGER 30
            ^"Glory" INTEGER 44
            ^"Status" INTEGER 20
            ^"Skills" LIST OF STRING ["Artisan 0", "Martial 2", "Scholar 3", "Social 3", "Trade 3"]
            ^"Advantages" LIST OF STRING ["Of the People (Void) [Social; Interpersonal]"]
            ^"Disadvantages" LIST OF STRING ["Scars of Battle (Fire) [Martial; Physical]"]
            ^"Favored Weapons" LIST OF STRING ["Knife: Range 0, Damage 2, Deadliness 4, Concealable, Mundane, Razor-Edged"]
            ^"Gear" LIST OF STRING ["Common clothes (Physical 1, Mundane)", "10 koku", "a small logbook written in code that contains blackmail on many people in Hirosaka"]
        }
        DESCRIPTION "Yuuto is an older man bearing the marks of battle: his face is scarred, and he walks with a pronounced limp. He is intelligent, insightful, and politically astute, but particularly in the presence of samurai, he tends to speak only when he has something he considers important to say—and then does so with perfect deference."
        ^"The People's Champion" DEF {
            ^"Description" STRING "When Yuuto makes a Social skill check, if no target has a status of 26 or higher, he treats the TN as 2 lower (minimum of 1)."
        }
        RULES {
            #L5RPOWnpc20Yuuto: yuuto
        }
    }

    # source stat block (page 232)
    ^"Novice Rōnin" DEF {
        EXTENDS ^"NPC"
        PROPERTIES {
            ^"Type" STRING "Minion" FIXED
            ^"Combat Conflict Rank" INTEGER 2
            ^"Intrigue Conflict Rank" INTEGER 1
            ^"Rings" DEF {
                ^"Air" INTEGER 2
                ^"Earth" INTEGER 3
                ^"Fire" INTEGER 2
                ^"Water" INTEGER 3
                ^"Void" INTEGER 1
            }
            ^"Demeanor" STRING "Gruff"
            ^"Social Skill Check TN Modifiers" STRING "Water +2, Earth -2"
            ^"Endurance" INTEGER 12
            ^"Composure" INTEGER 10
            ^"Focus" INTEGER 4
            ^"Vigilance" INTEGER 2
            ^"Honor" INTEGER 33
            ^"Glory" INTEGER 35
            ^"Status" INTEGER 21
            ^"Skills" LIST OF STRING ["Artisan 0", "Martial 2", "Scholar 1", "Social 1", "Trade 1"]
            ^"Advantages" LIST OF STRING ["Martial Instinct (Fire) [Martial; Mental]"]
            ^"Disadvantages" LIST OF STRING ["Unnecessarily Rude (Water) [Social; Interpersonal]"]
            ^"Favored Weapons" LIST OF STRING ["Katana: Range 1, Damage 4, Deadliness 5/7, Ceremonial, Razor-Edged", "Yumi: Range 2-5, Damage 5, Deadliness 3"]
            ^"Gear" LIST OF STRING ["Worn traveler's clothes (Physical 2, Mundane)", "quiver", "straw cloak", "handful of zeni"]
        }
        DESCRIPTION "To survive on their own, or out of a need to belong, rōnin sometimes band together in small mercenary groups. At a cursory glance, these groups appear identical to bandit gangs, but what distinguishes them is some sense of honor. Upon joining, those recently cast aside by the clans will fashion themselves after a mentor, a rōnin who has proven they can survive the indifference of the waves."
        ^"Striking as Fire" DEF {
            ^"Description" STRING "When performing an Attack action (Fire) check, a novice rōnin may spend (op) as follows: Fire (op)+: Increase the severity of any critical strike dealt as part of this attack by 2 per (op) spent in this way."
        }
        RULES {
            #L5RPOWnpc21NoviceRoni: novice_ronin
        }
    }

}