# L5R 5E - PATH OF WAVES: NON-PLAYER CHARACTERS (NPCs)
# Village, temple, and wilderness NPCs + local spirits from Twin Blessings
# Village (Ch.4), Hirosaka (Ch.5), and Chapter 7. Source: Path of Waves.

EXTENSION "L5R5e_PathOfWaves_NPCs" {
    VERSION "0.4.2"
    SPEC_VERSION "0.4"
    RELEASE_DATE "2026-09-02"
    DEPENDS_ON "L5R5e_Core_Core"

    # source stat block (page 126)
    ^"Setsuo, Village Leader" DEF {
        EXTENDS ^"NPC"
        PROPERTIES {
            ^"Type" STRING "Adversary" FIXED
            ^"Combat Conflict Rank" INTEGER 3
            ^"Intrigue Conflict Rank" INTEGER 3
            ^"Rings" DEF {
                ^"Air" INTEGER 2
                ^"Earth" INTEGER 4
                ^"Fire" INTEGER 2
                ^"Water" INTEGER 2
                ^"Void" INTEGER 1
            }
            ^"Demeanor" STRING "Shrewd"
            ^"Social Skill Check TN Modifiers" STRING "Air +2, Fire -2"
            ^"Endurance" INTEGER 8
            ^"Composure" INTEGER 8
            ^"Focus" INTEGER 4
            ^"Vigilance" INTEGER 3
            ^"Honor" INTEGER 60
            ^"Glory" INTEGER 40
            ^"Status" INTEGER 24
            ^"Skills" LIST OF STRING ["Artisan 0", "Martial 1", "Scholar 1", "Social 3", "Trade 4"]
            ^"Advantages" LIST OF STRING ["Support of the Village (Fire) [Social; Interpersonal]"]
            ^"Disadvantages" LIST OF STRING ["Dark Secret (Fire) [Social; Mental]"]
            ^"Favored Weapons" LIST OF STRING ["Nearby Object: Range 0-1, Damage 2, Deadliness 3/4, Mundane"]
            ^"Gear" LIST OF STRING ["Common clothes (Physical 1, Mundane)", "withered twine necklace"]
        }
        DESCRIPTION "Setsuo is a lean, hardworking man with strong arms and a bent back. His greying hair, rough skin, and bright eyes make his age difficult to guess, though his son is barely a man, so Setsuo can't be as old as he appears. Years of stooping in the rice paddies have taken their toll, though he is optimistic, lively, and genuinely fond of visitors and the news they might bring from the rest of Rokugan. Setsuo has received more of an education than most peasants, sometime in his past. He tries to keep this hidden, but sometimes his knowledge of court politics, samurai etiquette, and geography can be surprising. If questioned, he'll admit that he hasn't spent his whole life in the village, as most have. As a youth, he left to live in Hirosaka, where he gained experience of things he won't admit to. This isn't a period of his life he likes to talk about, particularly within hearing of his son. Setsuo is also cunning and willing to lie to the magistrate when taxes must be paid, in order for the village to prosper. He has lofty ideas, as though he questions his place in the Celestial Order, but he dislikes violence and would rather use his intellect than rebellion to improve his lot."
        ^"Overlooked" DEF {
            ^"Description" STRING "When Setsuo makes a check targeting a character with a higher status rank, they treat that character's vigilance as 1 lower."
        }
        RULES {
            #L5RPOWnpc10Setsuo: setsuo
        }
    }

    # source stat block (page 127)
    ^"Hiroto, Sake Brewer" DEF {
        EXTENDS ^"NPC"
        PROPERTIES {
            ^"Type" STRING "Adversary" FIXED
            ^"Combat Conflict Rank" INTEGER 3
            ^"Intrigue Conflict Rank" INTEGER 2
            ^"Rings" DEF {
                ^"Air" INTEGER 1
                ^"Earth" INTEGER 2
                ^"Fire" INTEGER 3
                ^"Water" INTEGER 3
                ^"Void" INTEGER 2
            }
            ^"Demeanor" STRING "Loyal"
            ^"Social Skill Check TN Modifiers" STRING "Water +2, Fire -2"
            ^"Endurance" INTEGER 9
            ^"Composure" INTEGER 6
            ^"Focus" INTEGER 3
            ^"Vigilance" INTEGER 5
            ^"Honor" INTEGER 40
            ^"Glory" INTEGER 35
            ^"Status" INTEGER 22
            ^"Skills" LIST OF STRING ["Artisan 1", "Martial 2", "Scholar 0", "Social 2", "Trade 3"]
            ^"Advantages" LIST OF STRING ["Large Stature (Earth) [Martial; Physical]"]
            ^"Disadvantages" LIST OF STRING ["Superstitious (Fire) [Social; Spiritual]"]
            ^"Favored Weapons" LIST OF STRING ["Sake bottle: Range 0-1, Damage 2, Deadliness 3/5, Mundane"]
            ^"Gear" LIST OF STRING ["Common clothes (Physical 1, Mundane)", "bottle of sake"]
        }
        DESCRIPTION "Hiroto the brewer is a large, well-built, down-to-earth fellow who is nevertheless highly superstitious. At night, he stops his ears with wax so he won't hear anything calling him from the forest, and this makes him hard to wake. Hiroto works tirelessly in the fields, but his passion is for making sake. He is never happier than when pounding the rice and chanting the brewers' chants at the top of his lungs. This might be why he built his home apart from the others, so no one has to hear him but his tolerant family. He is immensely proud of his daughter, Kaiya. He is too polite to say so, however, and only sings her praises when he's been indulging in his sake, when the only ones likely to hear are Setsuo or Michi, his closest friends among many in the village. He respects the priest but is somewhat in awe of religious leaders and so cannot relax around Daizō. The same is true, and even more obvious, when he meets a shugenja. He was the same with monks until he encountered Michi, who has been careful to foster an irreverent reputation."
        ^"Surprising Prowess" DEF {
            ^"Description" STRING "The first time a character makes a Martial Arts check against Hiroto each scene, the TN of that check is increased by 2."
        }
        RULES {
            #L5RPOWnpc11Hiroto: hiroto
        }
    }

    # source stat block (page 128)
    ^"Kitsune (Path of Waves)" DEF {
        EXTENDS ^"NPC"
        PROPERTIES {
            ^"Type" STRING "Adversary" FIXED
            ^"Combat Conflict Rank" INTEGER 2
            ^"Intrigue Conflict Rank" INTEGER 2
            ^"Rings" DEF {
                ^"Air" INTEGER 4
                ^"Earth" INTEGER 2
                ^"Fire" INTEGER 2
                ^"Water" INTEGER 2
                ^"Void" INTEGER 3
            }
            ^"Demeanor" STRING "Clever"
            ^"Social Skill Check TN Modifiers" STRING "Air +2, Earth -2"
            ^"Endurance" INTEGER 6
            ^"Composure" INTEGER 8
            ^"Focus" INTEGER 4
            ^"Vigilance" INTEGER 2
            ^"Honor" INTEGER 25
            ^"Glory" INTEGER 20
            ^"Status" INTEGER 20
            ^"Skills" LIST OF STRING ["Artisan 0", "Martial 0", "Scholar 0", "Social 2", "Trade 1"]
            ^"Advantages" LIST OF STRING ["Dangerous Allure (Fire) [Social; Interpersonal]"]
            ^"Disadvantages" LIST OF STRING ["Irrepressible Flirtation (Fire) [Social; Interpersonal]"]
            ^"Favored Weapons" LIST OF STRING ["Claws and Fangs: Range 0-1, Damage 3, Deadliness 4, Razor-Edged"]
            ^"Gear" LIST OF STRING ["Elaborate Robes (Physical 1, Resplendent)", "sake cup (Sacred)"]
        }
        DESCRIPTION "The three kitsune, one woman and two others with androgynous appearances, look like beautiful, jovial young humans and are dressed like wealthy courtiers, in fine silks of russet and silver. They all have the same narrow faces and delicate features, giving the impression they are closely related. Though they seem to maintain human form effortlessly, they retain their bushy tails, which they hide within their clothes. This may be because they cannot change their forms completely, or because they are too proud of their tails to lose them. Either way, after their party has gone on a while, they are less careful to keep the tails concealed."
        ^"Shapeshifter" DEF {
            ^"Description" STRING "As a Support action, a kitsune can transform into human form (or back again). While in their fox form, they are silhouette 1. When they become Compromised, their fox feet, ears, or tails reappear."
        }
        RULES {
            #L5RPOWnpc12Kitsune: kitsune
        }
    }

    # source stat block (page 129)
    ^"Kami of the Hot Spring" DEF {
        EXTENDS ^"NPC"
        PROPERTIES {
            ^"Type" STRING "Adversary" FIXED
            ^"Combat Conflict Rank" INTEGER 8
            ^"Intrigue Conflict Rank" INTEGER 2
            ^"Rings" DEF {
                ^"Air" INTEGER 1
                ^"Earth" INTEGER 2
                ^"Fire" INTEGER 4
                ^"Water" INTEGER 5
                ^"Void" INTEGER 1
            }
            ^"Demeanor" STRING "Irritable"
            ^"Social Skill Check TN Modifiers" STRING "Fire +2, Air -1, Water -1"
            ^"Endurance" INTEGER 13
            ^"Composure" INTEGER 5
            ^"Focus" INTEGER 3
            ^"Vigilance" INTEGER 2
            ^"Silhouette" INTEGER 2
            ^"Skills" LIST OF STRING ["Artisan 1", "Martial 3", "Scholar 3", "Social 3", "Trade 1"]
            ^"Advantages" LIST OF STRING ["Liquid Body (Water) [Martial; Physical]"]
            ^"Disadvantages" LIST OF STRING ["Ever-Changing (Water) [Social, Martial; Interpersonal, Physical]"]
            ^"Favored Weapons" LIST OF STRING ["Scalding Spit: Range 0-3, Damage 5, Deadliness 5, deals supernatural damage"]
            ^"Gear" LIST OF STRING ["Cloud of steam (Physical 3, Supernatural 3)"]
        }
        DESCRIPTION "Only an experienced shugenja would detect the presence of this kami. Yet anyone entering the spring can experience its lively, warming energy, something beyond the simple temperature of the water. Those who fail to approach the spring correctly soon learn of the kami's displeasure, as the water bubbles and spits. If the kami is not quickly appeased with a gift, or the unwelcome visitor does not leave, the kami grows angry enough to manifest. It rises out of the water in a seething rage: a mutable, watery, humanoid form giving off scalding steam. While this kami has a quick temper, its watery nature means it may also quickly change its mind and return to its spring, so it won't pursue anyone for long."
        ^"Hot Water Spirit" DEF {
            ^"Description" STRING "The kami of the spring is an Otherworldly being of silhouette 2. Once per scene, as an Attack and Support action, it may target two positions at range 2-4. Hot water erupts between the target points that extends to range 1 in thickness and range 3 in height; this area counts as Dangerous terrain (page 267 of the core rulebook). This effect persists for two rounds. Any character standing where the steam erupts suffers the Dazed condition and must resist with a TN 2 Fitness check (Air 3, Water 1) or suffer 5 supernatural damage and the Burning condition."
        }
        RULES {
            #L5RPOWnpc13KamioftheH: kami_of_the_hot_spring
        }
    }

