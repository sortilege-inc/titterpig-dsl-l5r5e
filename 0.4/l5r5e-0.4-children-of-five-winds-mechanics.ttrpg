    # ===========================
    # NEW SAMURAI HERITAGES
    # ===========================

    # source stat block (page 97)
    ^"New Samurai Heritages Table" DEF {
        APPLIES TO [^"Samurai"]

        # Table 2-1: New Samurai Heritages. Backgrounds for samurai with
        # ancestral ties to the Unicorn Clan and the lands beyond Rokugan.
        # Used instead of the core rulebook heritage table.

        HERITAGE_TABLE {

            1 #gCFkEdJN0NrsGSzFVhq6hD ^"Ancestral Horse Line" DEF {
                # One of your ancestors possessed a mighty Unicorn
                # warhorse.

                MODIFIERS {
                    ^"Glory" "+3"
                }

                EFFECT {
                    "Add additional warhorse to starting items ("
                }

                SUB_TABLE "1d10" {
                    "1-2" "Utaku"
                    "3-4" "Shinjo"
                    "5-6" "Iuchi"
                    "7-8" "Ide"
                    "9-10" "Moto)"
                }
            }

            2 #L8URXctUSTs5q0RApULhPA ^"Heart of the Horse" DEF {
                # Your horse chose you.

                MODIFIERS {
                    ^"Glory" "+3"
                    ^"Status" "-3"
                }

                EFFECT {
                    "Gain a horse and the Karmic Tie (Void) distinction with it"
                }
            }

            3-4 #KuGEkb3AAlrQ8DeDK8IIEU ^"Knowledge Exchange" DEF {
                # An ancestor learned techniques of another school.

                MODIFIERS {
                    ^"Glory" "-5"
                }

                EFFECT {
                    "Learn one additional technique ("
                }

                SUB_TABLE "1d10" {
                    "1-3" "kata"
                    "4-6" "shūji"
                    "7" "ritual"
                    "8" "invocation"
                    "9" "kihō"
                    "10" "mahō or ninjutsu). Select rank 1 technique. You can perform that technique even if it is not normally allowed by your school"
                }
            }

            5 #LwBH4oJuiMiuHceoWTSEXh ^"Lost Banner" DEF {
                # Your family lost a symbolic banner.

                MODIFIERS {
                    ^"Glory" "-5"
                }

                EFFECT {
                    "Gain Indomitable Will distinction (can exceed normal advantage limits at creation)"
                }
            }

            6-7 #OhRxrHSJXkLU2pLpLipNRQ ^"Splintered Loyalties" DEF {
                # Related to non-Rokugani people or raised outside
                # Rokugan.

                MODIFIERS {
                    ^"Status" "-5"
                }

                SUB_TABLE "1d10" {
                    "1-2" "Aesthetics"
                    "3-4" "Courtesy"
                    "5-6" "Culture"
                    "7-8" "Meditation"
                    "9-10" "Commerce. Gain +1 rank"
                }
            }

            8 #M6OlywRl97YLVScUZemIx6 ^"Sacred Wilderness" DEF {
                # Ancestor established a protected sacred wilderness.

                MODIFIERS {
                    ^"Status" "+5"
                }

                EFFECT {
                    "Add estate to starting items with free food, shelter, and medical care"
                }
            }

            9 #1skeeUyizts1f1x9yfAlBH ^"Spirit Companion" DEF {
                # Ancestor made an agreement with a spirit.

                MODIFIERS {
                    ^"Status" "+3"
                    ^"Glory" "-3"
                }

                EFFECT {
                    "Know one additional meishōdō talisman ("
                }

                SUB_TABLE "1d10" {
                    "1-2" "Air"
                    "3-4" "Water"
                    "5-6" "Earth"
                    "7-8" "Fire"
                    "9-10" "Void). Select rank 1 invocation. You can perform that invocation even if it is not normally allowed by your school"
                }
            }

            10 #Vb7AlY2oJr6tr0FG7FRC8m ^"Spiritual Debt" DEF {
                # Your family owes a spirit.

                MODIFIERS {
                    ^"Honor" "+3"
                    ^"Glory" "-3"
                }

                SUB_TABLE "1d10" {
                    "1" "and reduce another by 1 (max 3)"
                }
            }
        }
    }

