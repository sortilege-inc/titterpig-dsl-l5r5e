EXTENSION "L5R5e_Children_of_Five_Winds" EXTENDS "L5R5e_Core_Character" {
    NAME "Legend of the Five Rings 5th Edition - Children of the Five Winds: New Player Options"
    VERSION "0.4.2"
    SPEC_VERSION "0.4.1"
    RELEASE_DATE "2026-03-01"

    # Children of the Five Winds (Chapters 2 and 3): Fox Minor Clan, Kitsune family,
    # new schools, advantages, disadvantages, heritages, weapons, armor,
    # personal effects, blessed treasures, meishōdō talismans, item patterns,
    # techniques (kata, rituals, shūji, invocation), titles, conditions, demeanor.

    # ===========================
    # FOX MINOR CLAN
    # ===========================

    # source stat block (page 82)
    ^"Fox Minor Clan" DEF {
        EXTENDS #L5R250aB2cD4eF6gH8iJ0k ^"Clan"
        APPLIES TO [^"Samurai"]

        # The Fox consider themselves representatives of nature
        # and advocates for Senkyo. With literal fox spirits in their
        # bloodline, the Fox commune with nature and bargain with
        # forest spirits to maintain harmony between humans and
        # animals. After centuries of isolation, they are now considering
        # becoming more involved in the Empire's politics.

        PROPERTIES {
            ^"Clan Name" STRING "Fox" FIXED
            ^"Clan Type" STRING "Minor Clan"
            ^"Clan Ring Bonus" DEF { ^"Earth" INTEGER 1 }
            ^"Clan Skill Bonus" DEF { ^"Survival" INTEGER 1 }
            ^"Clan Status" INTEGER DEFAULT 30
        }

        FAMILIES {
            ^"Kitsune"
        }

        RULES {
            #L5RCW01aB2cD4eF6gH8iJ0: fox_representatives_of_nature
            #L5RCW02kL3mN5oP7qR9sT1u: fox_advocates_for_senkyo
        }
    }


    # ===========================
    # FOX FAMILIES
    # ===========================

    #L5RCW40lM3nO5pQ7rS9tU1v ^"Kitsune" DEF {
        EXTENDS #L5R251lM3nO5pQ7rS9tU1v ^"Family"
        APPLIES TO [^"Samurai"]

        PROPERTIES {
            ^"Family Name"     STRING "Kitsune" FIXED
            ^"Clan"            STRING "Fox"
            ^"Ring Increase" DEF { CHOOSE 1 [^"Air", ^"Water"] INTEGER 1 }
            ^"Skill Increases" DEF {
                ^"Fitness" INTEGER 1
                ^"Theology" INTEGER 1
            }
            ^"Glory"           INTEGER 40
            ^"Starting Wealth" INTEGER 2
        }
    }


    # ===========================
    # NEW SCHOOLS
    # ===========================

    # source stat block (page 83)
    ^"Ganzu Guardian Tradition" DEF {
        EXTENDS #L5R252wX4yZ6aB8cD0eF2g ^"School"
        APPLIES TO [^"Samurai"]

        # The Ganzu people of the Hidden Valley are in some ways
        # the sixth great family of the Unicorn Clan. Their battle
        # traditions are suited to desert terrain, teaching warriors
        # to fight with precision and let the foe exhaust themselves.

        PROPERTIES {
            ^"School Name" STRING "Ganzu Guardian Tradition" FIXED
            ^"Roles" LIST ["Bushi"]
            ^"Ring Increase" DEF {
                ^"Earth" INTEGER 1
                ^"Water" INTEGER 1
            }
            ^"Starting Skills" DEF { CHOOSE 5 [^"Command", ^"Fitness", ^"Labor", ^"Martial Arts [Melee]", ^"Medicine", ^"Sentiment", ^"Tactics"] INTEGER 1 }
            ^"Starting Honor" INTEGER DEFAULT 45
            ^"Techniques Available" LIST ["Kata", "Rituals", "Shūji"]
        }


        STARTING_TECHNIQUES {
            KATA ^"Slashing Sandstorm Style"
            SHUJI CHOOSE 1 [^"Honest Assessment", ^"Shallow Waters"]
        }

        SCHOOL_ABILITY "Moment of Certainty" {
            "Once per scene after you defend against damage, you may roll a number of skill dice equal to the fatigue you received this way. Choose a number of those dice up to your school rank and reserve them. Until end of scene, when you perform an Attack action check, after choosing kept dice, you may add one reserved die as an additional kept die."
        }

        MASTERY_ABILITY ^"Measured Force" {
            "When you use your school ability to add kept dice to a check, you may add a number of your reserved dice up to your ranks in Fitness (instead of only one)."
        }
        STARTING_OUTFIT [
            "traveling clothes", "concealed armor",
            "Ganzu ring ax", "two knives",
            "traveling rations (eight days)"
        ]

        CURRICULUM {
            RANK 1 {
                SKILL_GROUP "Martial Skills"
                SKILL "Command"
                SKILL "Survival"
                SKILL "Theology"
                TECHNIQUE_GROUP "Rank 1 Water Shūji"
                ^"Distracting Flurry Style" [kata]
                ^"Soaring Slice" [kata]
            }
            RANK 2 {
                SKILL_GROUP "Social Skills"
                SKILL "Fitness"
                SKILL "Martial Arts [Melee]"
                SKILL "Theology"
                TECHNIQUE_GROUP "Rank 1-2 Kata"
                ^"Scouring Wind Style" [kata]
                ^"Feigned Opening" [shuji]
            }
            RANK 3 {
                SKILL_GROUP "Trade Skills"
                SKILL "Fitness"
                SKILL "Martial Arts [Melee]"
                SKILL "Tactics"
                TECHNIQUE_GROUP "Rank 1-3 Earth Shūji"
                ^"Thunderbolt Style" [kata]
                ^"Center the World" [ritual]
            }
            RANK 4 {
                SKILL_GROUP "Martial Skills"
                SKILL "Command"
                SKILL "Survival"
                SKILL "Theology"
                TECHNIQUE_GROUP "Rank 1-4 Kata"
                ^"Rouse the Soul" [shuji]
                ^"Regal Bearing" [shuji]
            }
            RANK 5 {
                SKILL_GROUP "Scholar Skills"
                SKILL "Command"
                SKILL "Martial Arts [Melee]"
                SKILL "Survival"
                TECHNIQUE_GROUP "Rank 1-5 Water Shūji"
                ^"The Immovable Hand of Peace" [shuji]
                ^"Striking as Void" [kata]
            }
            RANK 6 {
                ^"Measured Force"
            }
        }

    }

    # source stat block (page 84)
    ^"Ide Emissary" DEF {
        EXTENDS #L5R252wX4yZ6aB8cD0eF2g ^"School"
        APPLIES TO [^"Samurai"]

        # The Ide family specializes in retaining relationships
        # through trade and good will. Emissaries learn the customs,
        # protocols, and styles of any court they visit, from Rokugani
        # castles to Ujik ordus to Qamarist spires of academia.

        PROPERTIES {
            ^"School Name" STRING "Ide Emissary" FIXED
            ^"Clan" STRING "Unicorn"
            ^"Roles" LIST ["Courtier", "Bushi"]
            ^"Ring Increase" DEF {
                ^"Fire" INTEGER 1
                ^"Water" INTEGER 1
            }
            ^"Starting Skills" DEF { CHOOSE 5 [^"Courtesy", ^"Culture", ^"Games", ^"Government", ^"Martial Arts [Unarmed]", ^"Sentiment", ^"Survival"] INTEGER 1 }
            ^"Starting Honor" INTEGER DEFAULT 50
            ^"Techniques Available" LIST ["Kata", "Rituals", "Shūji"]
        }


        STARTING_TECHNIQUES {
            SHUJI ^"Glorious Entrance"
            SHUJI CHOOSE 1 [^"Stirring the Embers", ^"Well of Desire"]
        }

        SCHOOL_ABILITY "Disarming Demeanor" {
            "When you perform a Support action check, you may spend (op) as follows: (op)+: Choose one character in the scene with vigilance lower than your school ranks plus (op) spent this way. You treat that character's focus and vigilance each as 1 lower until end of scene."
        }

        MASTERY_ABILITY ^"Student of Many Courts" {
            "Once per scene as a Support action, you may make a TN 3 Culture (Fire or Water) check targeting any number of other characters in the scene. If you succeed and chose Fire, each character gains the Emboldened condition. If you succeed and chose Water, each character removes 3 strife."
        }
        STARTING_OUTFIT [
            "ceremonial clothes", "traveling clothes",
            "wakizashi (short sword) or scimitar", "knife",
            "journal", "calligraphy set",
            "Ide traveling pony"
        ]

        CURRICULUM {
            RANK 1 {
                SKILL_GROUP "Social Skills"
                SKILL "Culture"
                SKILL "Sentiment"
                SKILL "Survival"
                TECHNIQUE_GROUP "Rank 1 Earth Shūji"
                ^"Open-Hand Style" [kata]
                ^"Cultural Exchange" [ritual]
            }
            RANK 2 {
                SKILL_GROUP "Social Skills"
                SKILL "Fitness"
                SKILL "Government"
                SKILL "Martial Arts [Unarmed]"
                TECHNIQUE_GROUP "Rank 1-2 Fire Shūji"
                ^"Entice with Offerings" [shuji]
                ^"Solidify Gratitude" [shuji]
            }
            RANK 3 {
                SKILL_GROUP "Trade Skills"
                SKILL "Command"
                SKILL "Meditation"
                SKILL "Tactics"
                TECHNIQUE_GROUP "Rank 1-3 Water Shūji"
                ^"Everyone Has a Price" [shuji]
                ^"Incite Wrath" [shuji]
            }
            RANK 4 {
                SKILL_GROUP "Social Skills"
                SKILL "Aesthetics"
                SKILL "Design"
                SKILL "Composition"
                TECHNIQUE_GROUP "Rank 1-4 Fire Shūji"
                ^"Sear the Wound" [shuji]
                ^"Crashing Wave Style" [kata]
            }
            RANK 5 {
                SKILL_GROUP "Trade Skills"
                SKILL "Command"
                SKILL "Games"
                SKILL "Tactics"
                TECHNIQUE_GROUP "Rank 1-5 Earth Shūji"
                ^"Rouse the Soul" [shuji]
                ^"Striking as Void" [kata]
            }
            RANK 6 {
                ^"Student of Many Courts"
            }
        }

    }

    # source stat block (page 85)
    ^"Iuchi Horse Lord Disciple" DEF {
        EXTENDS #L5R252wX4yZ6aB8cD0eF2g ^"School"
        APPLIES TO [^"Samurai"]

        # The Iuchi's Horse Lord Disciples follow an ancient tradition
        # established by Iuchi's eldest child. Foremost experts in
        # equine medicine, they are specialized Meishōdō Masters
        # who invoke equestrian spirits using unique talismans
        # designed to adorn mounts rather than samurai.

        PROPERTIES {
            ^"School Name" STRING "Iuchi Horse Lord Disciple" FIXED
            ^"Clan" STRING "Unicorn"
            ^"Roles" LIST ["Shugenja", "Artisan"]
            ^"Ring Increase" DEF {
                ^"Air" INTEGER 1
                ^"Water" INTEGER 1
            }
            ^"Starting Skills" DEF { CHOOSE 3 [^"Commerce", ^"Design", ^"Medicine", ^"Sentiment", ^"Survival", ^"Theology"] INTEGER 1 }
            ^"Starting Honor" INTEGER DEFAULT 40
            ^"Techniques Available" LIST ["Invocations", "Rituals", "Shūji"]
        }


        STARTING_TECHNIQUES {
            INVOCATION CHOOSE 1 [^"Jurojin's Balm", ^"Nature's Touch", ^"Path to Inner Peace"]
            RITUAL ^"Commune with the Spirits"
            RITUAL ^"Protection of the Flock"
            SHUJI CHOOSE 1 [^"Call to Ride", ^"Shallow Waters"]
        }

        SCHOOL_ABILITY "The Horse Lord's Favor" {
            "When you make a check to craft, improve, or maintain an item, you may imprint it with the Horse Lord's Favor, giving it one of your advantages or disadvantages. If the item is a meishōdō talisman, you may give it an advantage or disadvantage from its sealed spirit. While an item with your Favor adorns a horse or Loyal Steed creature, the creature is Otherworldly and possesses the chosen trait. If a meishōdō talisman, the creature may perform any techniques it contains. Sustain up to school rank items. Additionally, Medicine checks to remove fatigue or conditions from equine creatures add bonus successes equal to school rank."
        }

        MASTERY_ABILITY ^"The Noble Heart Shines Through" {
            "Once per scene, spend 1 Void point to target any non-Shadowlands creature of silhouette 3 or greater, giving the target the Loyal Steed ability until end of scene. Make a Courtesy (Water) or Theology (Void) check with TN equal to target's vigilance. If you succeed, the target is favorable and willing to be ridden. Horses of the Blessed Herd (Utaku steeds) are immune."
        }
        STARTING_OUTFIT [
            "sanctified robes", "traveling clothes",
            "yumi (bow)", "quiver of arrows",
            "wakizashi (short sword)",
            "two meishōdō talismans each containing a Rank 1 invocation",
            "traveling pack", "Iuchi riding steed"
        ]

        CURRICULUM {
            RANK 1 {
                SKILL_GROUP "Scholar Skills"
                SKILL "Courtesy"
                SKILL "Design"
                SKILL "Survival"
                TECHNIQUE_GROUP "Rank 1 Water Invocations"
                ^"Divination" [ritual]
                ^"Sympathetic Energies" [invocation]
            }
            RANK 2 {
                SKILL_GROUP "Artisan Skills"
                SKILL "Commerce"
                SKILL "Medicine"
                SKILL "Theology"
                TECHNIQUE_GROUP "Rank 1-2 Rituals"
                ^"Artisan's Appraisal" [shuji]
                ^"Call Upon the Wind" [invocation]
            }
            RANK 3 {
                SKILL_GROUP "Martial Skills"
                SKILL "Design"
                SKILL "Medicine"
                SKILL "Theology"
                TECHNIQUE_GROUP "Rank 1-3 Air Invocations"
                ^"Horse Whisperer" [shuji]
                ^"Shadow of Days" [ritual]
            }
            RANK 4 {
                SKILL_GROUP "Social Skills"
                SKILL "Medicine"
                SKILL "Survival"
                SKILL "Theology"
                TECHNIQUE_GROUP "Rank 1-4 Earth Invocations"
                ^"Regal Bearing" [shuji]
                ^"Ride the Water Dragon" [kiho]
            }
            RANK 5 {
                SKILL_GROUP "Artisan Skills"
                SKILL "Command"
                SKILL "Survival"
                SKILL "Theology"
                TECHNIQUE_GROUP "Rank 1-5 Water Invocations"
                ^"Buoyant Arrival" [shuji]
                ^"Rouse the Soul" [shuji]
            }
            RANK 6 {
                ^"The Noble Heart Shines Through"
            }
        }

    }

    ^"Kitsune Mediator" DEF {
        EXTENDS #L5R252wX4yZ6aB8cD0eF2g ^"School"
        APPLIES TO [^"Samurai"]

        # The Fox Clan's Kitsune Mediators are sent to places
        # experiencing supernatural strife. They mediate between
        # human and supernatural inhabitants, determining if
        # problems are spiritual in nature and helping both sides
        # reach new accords.

        PROPERTIES {
            ^"School Name" STRING "Kitsune Mediator" FIXED
            ^"Clan" STRING "Fox"
            ^"Roles" LIST ["Courtier", "Sage"]
            ^"Ring Increase" DEF {
                ^"Void" INTEGER 1
                ^"Water" INTEGER 1
            }
            ^"Starting Skills" DEF { CHOOSE 5 [^"Command", ^"Courtesy", ^"Martial Arts [Ranged]", ^"Medicine", ^"Meditation", ^"Performance", ^"Survival"] INTEGER 1 }
            ^"Starting Honor" INTEGER DEFAULT 40
            ^"Techniques Available" LIST ["Kata", "Rituals", "Shūji"]
        }


        STARTING_TECHNIQUES {
            RITUAL ^"Commune with the Spirits"
            SHUJI CHOOSE 1 [^"Appreciate the Scenery", ^"Shallow Waters"]
        }

        SCHOOL_ABILITY "Calm Counsel" {
            "After a friendly character at range 0-4 receives strife, you may impose the Centered condition on that character. You can use this ability a number of times per scene up to your school rank."
        }

        MASTERY_ABILITY ^"Cool Heads Prevail" {
            "Friendly Centered characters at range 0-4 from you treat their composure and endurance as increased by your ranks in Courtesy."
        }
        STARTING_OUTFIT [
            "sanctified robes", "wakizashi (short sword)",
            "knife", "yumi (bow)", "quiver of arrows",
            "calligraphy set", "scroll satchel",
            "traveling pack", "bottle of sake",
            "sweets (four servings)"
        ]

        CURRICULUM {
            RANK 1 {
                SKILL_GROUP "Social Skills"
                SKILL "Aesthetics"
                SKILL "Survival"
                SKILL "Theology"
                TECHNIQUE_GROUP "Rank 1 Water Shūji"
                ^"Spiritual Survey" [ritual]
                ^"Threshold Barrier" [ritual]
            }
            RANK 2 {
                SKILL_GROUP "Scholar Skills"
                SKILL "Courtesy"
                SKILL "Fitness"
                SKILL "Meditation"
                TECHNIQUE_GROUP "Rank 1-2 Rituals"
                ^"Complementary Experience" [shuji]
                ^"Solidify Gratitude" [shuji]
            }
            RANK 3 {
                SKILL_GROUP "Social Skills"
                SKILL "Culture"
                SKILL "Government"
                SKILL "Sentiment"
                TECHNIQUE_GROUP "Rank 1-3 Earth Shūji"
                ^"Pillar of Calm" [shuji]
                ^"Swaying Grass Evasion" [kata]
            }
            RANK 4 {
                SKILL_GROUP "Scholar Skills"
                SKILL "Command"
                SKILL "Fitness"
                SKILL "Tactics"
                TECHNIQUE_GROUP "Rank 1-4 Rituals"
                ^"Nature's Touch" [invocation]
                ^"A Samurai's Fate" [shuji]
            }
            RANK 5 {
                SKILL_GROUP "Social Skills"
                SKILL "Aesthetics"
                SKILL "Survival"
                SKILL "Theology"
                TECHNIQUE_GROUP "Rank 1-5 Void Shūji"
                ^"By the Light of the Lord Moon" [invocation]
                ^"Bend with the Storm" [shuji]
            }
            RANK 6 {
                ^"Cool Heads Prevail"
            }
        }

    }

    ^"Kitsune Naturalist" DEF {
        EXTENDS #L5R252wX4yZ6aB8cD0eF2g ^"School"
        APPLIES TO [^"Samurai"]

        # The shugenja of the Kitsune family are attuned to spirits
        # of animals, plants, and primordial forces. Their tradition
        # leads them to invoke elements in equal measure rather
        # than favoring any single element.

        PROPERTIES {
            ^"School Name" STRING "Kitsune Naturalist" FIXED
            ^"Clan" STRING "Fox"
            ^"Roles" LIST ["Shugenja"]
            ^"Ring Increase" DEF {
                ^"Air" INTEGER 1
                ^"Earth" INTEGER 1
            }
            ^"Starting Skills" DEF { CHOOSE 3 [^"Courtesy", ^"Fitness", ^"Meditation", ^"Sentiment", ^"Survival", ^"Theology"] INTEGER 1 }
            ^"Starting Honor" INTEGER DEFAULT 40
            ^"Techniques Available" LIST ["Invocations", "Rituals", "Shūji"]
        }


        STARTING_TECHNIQUES {
            INVOCATION ^"Nature's Touch"
            INVOCATION CHOOSE 2 [^"Extinguish", ^"Jurojin's Balm", ^"Inari's Blessing"]
            RITUAL ^"Commune with the Spirits"
            RITUAL ^"Spiritual Survey"
        }

        SCHOOL_ABILITY "Natural Balance" {
            "When you succeed on a check to activate an invocation, if it is the first invocation of that element you have activated this scene, you may add bonus successes or kept dice set to (op) equal to your school rank."
        }

        MASTERY_ABILITY ^"Procession of Seasons" {
            "After you resolve the effects of an invocation, if you have successfully activated at least one Air, one Earth, one Fire, and one Water invocation during this scene, you may have a number of characters up to your ranks in Survival each remove half their strife and fatigue (rounded up). Once per scene."
        }
        STARTING_OUTFIT [
            "sanctified robes", "wakizashi (short sword)", "knife",
            "scroll satchel", "traveling pack",
            "bottle of sake", "sweets (four servings)"
        ]

        CURRICULUM {
            RANK 1 {
                SKILL_GROUP "Scholar Skills"
                SKILL "Design"
                SKILL "Games"
                SKILL "Survival"
                TECHNIQUE_GROUP "Rank 1 Air Invocations"
                ^"Wayfinder's Instincts" [ritual]
                ^"Divination" [ritual]
            }
            RANK 2 {
                SKILL_GROUP "Artisan Skills"
                SKILL "Courtesy"
                SKILL "Fitness"
                SKILL "Theology"
                TECHNIQUE_GROUP "Rank 1-2 Earth Invocations"
                ^"Grasp of the Air Dragon" [invocation]
                ^"Cunning Omission" [shuji]
            }
            RANK 3 {
                SKILL_GROUP "Social Skills"
                SKILL "Meditation"
                SKILL "Sentiment"
                SKILL "Survival"
                TECHNIQUE_GROUP "Rank 1-3 Water Invocations"
                ^"False Realm of the Fox Spirits" [invocation]
                ^"Power of the Earth Dragon" [invocation]
            }
            RANK 4 {
                SKILL_GROUP "Scholar Skills"
                SKILL "Courtesy"
                SKILL "Fitness"
                SKILL "Survival"
                TECHNIQUE_GROUP "Rank 1-4 Fire Invocations"
                ^"Ever-Changing Waves" [invocation]
                ^"Wolf's Proposal" [shuji]
            }
            RANK 5 {
                SKILL_GROUP "Artisan Skills"
                SKILL "Culture"
                SKILL "Meditation"
                SKILL "Theology"
                TECHNIQUE_GROUP "Rank 1-5 Air Invocations"
                ^"The Soul's Blade" [invocation]
                ^"Rouse the Soul" [shuji]
            }
            RANK 6 {
                ^"Procession of Seasons"
            }
        }

    }

    ^"Sand Road Wayfinder Tradition" DEF {
        EXTENDS #L5R252wX4yZ6aB8cD0eF2g ^"School"
        APPLIES TO [^"Samurai"]

        # Guides along the Sand Road who know the perils of each
        # region's terrain, supernatural threats, and hostile humans.
        # This school represents specialists from any region
        # bordering the Sand Road.

        PROPERTIES {
            ^"School Name" STRING "Sand Road Wayfinder Tradition" FIXED
            ^"Roles" LIST ["Bushi", "Shinobi"]
            ^"Ring Increase" DEF {
                ^"Earth" INTEGER 1
                CHOOSE 1 [^"Air", ^"Fire", ^"Water", ^"Void"] INTEGER 1
            }
            ^"Starting Skills" DEF { CHOOSE 5 [^"Command", ^"Commerce", ^"Labor", ^"Fitness", ^"Martial Arts [Melee]", ^"Martial Arts [Ranged]", ^"Survival"] INTEGER 1 }
            ^"Starting Honor" INTEGER DEFAULT 35
            ^"Techniques Available" LIST ["Kata", "Rituals", "Shūji"]
        }


        STARTING_TECHNIQUES {
            KATA CHOOSE 1 [^"Striking as Air", ^"Striking as Earth", ^"Striking as Fire", ^"Striking as Water"]
            RITUAL CHOOSE 1 [^"Traveler's Experience", ^"Wayfinder's Instincts"]
        }

        SCHOOL_ABILITY "Dunestrider" {
            "At start of each scene, choose one terrain quality: Dangerous, Entangling, Imbalanced, or Obscuring. Each friendly character within a number of range bands equal to your school rank ignores negative effects of that terrain quality."
        }

        MASTERY_ABILITY ^"Lay of the Land" {
            "Once per game session as a Support action or during a narrative scene, you may change which terrain quality your school ability affects. While in terrain with the chosen quality, you may add up to two bonus successes to each check you make."
        }
        STARTING_OUTFIT [
            "traveling clothes", "one weapon of rarity 7 or lower",
            "two knives", "traveling rations (eight days)",
            "traveling pack", "tent (small)"
        ]

        CURRICULUM {
            RANK 1 {
                SKILL_GROUP "Trade Skills"
                SKILL "Command"
                SKILL "Martial Arts [Melee]"
                SKILL "Martial Arts [Ranged]"
                TECHNIQUE_GROUP "Rank 1 Kata"
                ^"Distracting Flurry Style" [kata]
                ^"Cultural Exchange" [ritual]
            }
            RANK 2 {
                SKILL_GROUP "Martial Skills"
                SKILL "Command"
                SKILL "Medicine"
                SKILL "Survival"
                TECHNIQUE_GROUP "Rank 1-2 Kata"
                ^"Center the World" [ritual]
                ^"Touchstone of Courage" [shuji]
            }
            RANK 3 {
                SKILL_GROUP "Social Skills"
                SKILL "Skulduggery"
                SKILL "Survival"
                SKILL "Tactics"
                TECHNIQUE_GROUP "Rank 1-3 Earth Shūji"
                ^"Iron in the Mountains Style" [kata]
                ^"Skulk" [ninjutsu]
            }
            RANK 4 {
                SKILL_GROUP "Scholar Skills"
                SKILL "Meditation"
                SKILL "Medicine"
                SKILL "Survival"
                TECHNIQUE_GROUP "Rank 1-4 Kata"
                ^"Noxious Cloud" [ninjutsu]
                ^"Breath of Wind Style" [kata]
            }
            RANK 5 {
                SKILL_GROUP "Trade Skills"
                SKILL "Command"
                SKILL "Martial Arts [Melee]"
                SKILL "Martial Arts [Ranged]"
                TECHNIQUE_GROUP "Rank 1-5 Kata"
                ^"Silencing Stroke" [ninjutsu]
                ^"Rouse the Soul" [shuji]
            }
            RANK 6 {
                ^"Lay of the Land"
            }
        }

    }

    # source stat block (page 89)
    ^"Scholar of al-Zawira Tradition" DEF {
        EXTENDS #L5R252wX4yZ6aB8cD0eF2g ^"School"
        APPLIES TO [^"Samurai"]

        # In the city of al-Zawira, Qamarist scholars push the
        # bounds of knowledge in many fields. The massive scope
        # of the Caliphate gives access to knowledge from all
        # corners of a vast domain.

        PROPERTIES {
            ^"School Name" STRING "Scholar of al-Zawira Tradition" FIXED
            ^"Roles" LIST ["Courtier"]
            ^"Ring Increase" DEF {
                ^"Earth" INTEGER 1
                ^"Fire" INTEGER 1
            }
            ^"Starting Skills" DEF { CHOOSE 5 [^"Courtesy", ^"Culture", ^"Government", ^"Medicine", ^"Sentiment", ^"Survival", ^"Theology"] INTEGER 1 }
            ^"Starting Honor" INTEGER DEFAULT 50
            ^"Techniques Available" LIST ["Kata", "Rituals", "Shūji"]
        }


        STARTING_TECHNIQUES {
            RITUAL ^"Shadow of Days"
            SHUJI CHOOSE 1 [^"Ancestry Unearthed", ^"Cite the Facts", ^"Stirring the Embers", ^"Truth Burns through Lies"]
        }

        SCHOOL_ABILITY "Methodical Observation" {
            "Once per scene when you make a Scholar skill check, you may reserve a number of dropped dice up to your school rank. Until end of scene, when you make a non- Scholar skill check, after choosing dice, you may add up to one reserved die as a kept die."
        }

        MASTERY_ABILITY ^"Logical Conclusion" {
            "Once per game session when making a non-Scholar skill check, instead of rolling skill dice equal to your ranks in the skill used, you may roll skill dice equal to one of your Scholar skills of your choice."
        }
        STARTING_OUTFIT [
            "traveling clothes", "ceremonial clothes",
            "one weapon of rarity 6 or lower", "knife",
            "calligraphy set", "traveling pack", "numerous books"
        ]

        CURRICULUM {
            RANK 1 {
                SKILL_GROUP "Scholar Skills"
                SKILL "Composition"
                SKILL "Courtesy"
                SKILL "Fitness"
                TECHNIQUE_GROUP "Rank 1 Rituals"
