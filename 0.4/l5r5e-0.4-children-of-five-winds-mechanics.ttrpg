    # source stat block (page 90)
    ^"Shinjo Mounted Archer" DEF {
        EXTENDS #L5R252wX4yZ6aB8cD0eF2g ^"School"
        APPLIES TO [^"Samurai"]

        # One of the Great Clans' oldest traditions. Students seek
        # unity of horse and rider, mastering festival archery
        # (yabusame and kasagake) and bowcraft from horseback.

        PROPERTIES {
            ^"School Name" STRING "Shinjo Mounted Archer" FIXED
            ^"Clan" STRING "Unicorn"
            ^"Roles" LIST ["Bushi", "Artisan"]
            ^"Ring Increase" DEF {
                ^"Air" INTEGER 1
                ^"Fire" INTEGER 1
            }
            ^"Starting Skills" DEF { CHOOSE 5 [^"Culture", ^"Fitness", ^"Martial Arts [Ranged]", ^"Meditation", ^"Performance", ^"Smithing", ^"Tactics"] INTEGER 1 }
            ^"Starting Honor" INTEGER DEFAULT 40
            ^"Techniques Available" LIST ["Kata", "Rituals", "Shūji"]
        }


        STARTING_TECHNIQUES {
            KATA ^"Pelting Hail Style"
            KATA CHOOSE 1 [^"Hawk's Precision", ^"Striking as Fire"]
        }

        SCHOOL_ABILITY "Unity of Horse and Rider" {
            "When you spend Void to seize the moment during a check using a bow, you may negate (st) symbols up to your school rank. If you succeed, gain bonus successes equal to the number of (st) negated. While riding your steed, all Martial Arts [Ranged] and Performance checks have unskilled assistance."
        }

        MASTERY_ABILITY ^"Spirit of the Sacred Horse" {
            "Any steed you ride gains +4 endurance, +2 composure, +1 vigilance, and the Resplendent item quality. When you spend 1 or more Void points during a Martial Arts [Ranged] or Performance check, an item you have equipped gains the Sacred and Hewing item qualities, and you add kept dice set to (op) results equal to your Void ring."
        }
        STARTING_OUTFIT [
            "lacquered armor", "ceremonial clothes",
            "daishō (katana or scimitar, wakizashi)", "Shinjo horsebow",
            "quiver of arrows with three special arrows (one armor-piercing, one flesh-cutter, and one humming bulb)",
            "knife", "traveling pack", "bowyer's kit",
            "Shinjo courser or Unicorn warhorse"
        ]

        CURRICULUM {
            RANK 1 {
                SKILL_GROUP "Martial Skills"
                SKILL "Courtesy"
                SKILL "Smithing"
                SKILL "Survival"
                TECHNIQUE_GROUP "Rank 1 Kata"
                ^"Call to Ride" [shuji]
                ^"Lady Shinjo's Speed" [shuji]
            }
            RANK 2 {
                SKILL_GROUP "Artisan Skills"
                SKILL "Martial Arts [Ranged]"
                SKILL "Performance"
                SKILL "Theology"
                TECHNIQUE_GROUP "Rank 1-2 Rituals"
                ^"Horse Whisperer" [shuji]
                ^"Sudden Downpour Style" [kata]
            }
            RANK 3 {
                SKILL_GROUP "Martial Skills"
                SKILL "Performance"
                SKILL "Smithing"
                SKILL "Survival"
                TECHNIQUE_GROUP "Rank 1-3 Kata"
                ^"Dazzling Performance" [shuji]
                ^"Rallying Cry" [shuji]
            }
            RANK 4 {
                SKILL_GROUP "Scholar Skills"
                SKILL "Martial Arts [Ranged]"
                SKILL "Meditation"
                SKILL "Survival"
                TECHNIQUE_GROUP "Rank 1-4 Fire Shūji"
                ^"Pin the Fan" [kata]
                ^"Wolf's Proposal" [shuji]
            }
            RANK 5 {
                SKILL_GROUP "Martial Skills"
                SKILL "Culture"
                SKILL "Performance"
                SKILL "Survival"
                TECHNIQUE_GROUP "Rank 1-5 Kata"
                ^"Rouse the Soul" [shuji]
                ^"Silencing Stroke" [ninjutsu]
            }
            RANK 6 {
                ^"Spirit of the Sacred Horse"
            }
        }

    }

