        }

        ^"Flash-Cast" DEF {
            ^"Description" STRING "The night heron may spend a Movement action to hurl itself to a spot within its normal movement range, casting a splash of blue or golden, glowing powder over everything within range 0-1 of where it lands. Those caught within must resist with a TN 2 Fitness check (Fire 1, Air 3); if they fail, they become Dazed."
        }

        RULES {
            #L5RPW71rW8aG0cM8nR5bA1fA6yH:night_heron
        }
    }

    # source stat block (page 243)
    ^"Red-Crowned Heron" DEF {
        EXTENDS ^"NPC"

        PROPERTIES {
            ^"Type" STRING "Minion" FIXED
            ^"Category" STRING "Animal"
            ^"Combat Conflict Rank" INTEGER 1
            ^"Intrigue Conflict Rank" INTEGER 1
            ^"Description" STRING "Sacred to Doji and Kakita families. Symbol of beauty, cleverness, and longevity. Largest crane species in Rokugan. Needlessly killing one is considered bad luck."
            ^"Rings" DEF {
                ^"Air" INTEGER 2
                ^"Earth" INTEGER 1
                ^"Fire" INTEGER 1
                ^"Water" INTEGER 2
                ^"Void" INTEGER 2
            }
            ^"Endurance" INTEGER 3
            ^"Composure" INTEGER 5
            ^"Focus" INTEGER 3
            ^"Vigilance" INTEGER 3
            ^"Demeanor" STRING "Serene"
            ^"Social Skill Check TN Modifiers" STRING "Earth +2, Void -2"
            ^"Skills" LIST OF STRING ["Artisan 0", "Martial 1", "Scholar 0", "Social 0", "Trade 2"]
            ^"Advantages" LIST OF STRING ["Graceful Flight (Earth) [Martial; Physical]"]
            ^"Disadvantages" LIST OF STRING ["Easily Frightened (Void) [Martial; Mental]"]
            ^"Favored Weapons" LIST OF STRING ["Clawed talons: Range 0, Damage 3, Deadliness 5, Razor-Edged"]
        }

        ^"Startling Aggression" DEF {
            ^"Description" STRING "Once per scene, the red-crowned heron may rise up and furiously flap its wings. All characters within range 0-1 of the heron must make a TN 2 Fitness check (Fire 1, Void 3) to resist; if they fail, they suffer 2 strife and become Dazed."
        }

        RULES {
            #L5RPW71oK0kK9pS2hK7iZ4xJ0gX:red_crowned_heron
        }
    }

