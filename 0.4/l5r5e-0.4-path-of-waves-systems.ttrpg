EXTENSION "L5R5e_Path_of_Waves_Systems" EXTENDS "L5R5e_Core_Systems" {
    NAME "Legend of the Five Rings 5th Edition - Path of Waves: Systems, Titles, Bonds, and NPCs"
    VERSION "0.4.2"
    SPEC_VERSION "0.4.1"
    RELEASE_DATE "2026-03-01"

    # Path of Waves (Chapters 6 & 7): New titles with advancement tables,
    # bonds system (forging, advancing, calling upon, bond types and abilities),
    # personal code system, social objectives, ronin honor/glory optional rule,
    # ronin unmasking variants, typical ronin tasks, ronin clan relationships,
    # NPC templates, NPC stat blocks, and animal/creature profiles.

    # ===========================
    # (op)TIONAL RULE: RONIN HONOR AND GLORY
    # ===========================

    # source stat block (page 17)
    ^"Ronin Honor and Glory" DEF {
        APPLIES TO [^"Optional Rule"]
        PROPERTIES {
            ^"Type" STRING "Optional Rule"
            ^"Scope" STRING "Ronin characters"
        }
        RULES {
            #L5RPW60rP8bU4vL4sU0jD8vM8aD: ronin_honor_halved "When a ronin performs an act that causes them to forfeit or gain honor (such as a breach of their code of conduct), the GM may halve the amount of honor forfeited or gained."
            #L5RPW60yZ2fF2sE8bJ2jO0zD8fD: ronin_glory_doubled "When a ronin forfeits or gains glory, the GM may double that amount. Greater risk yields greater accolades, but failures damage reputation severely."
            #L5RPW60qO1yB1eT0nO4vU3jV6mX: ronin_honor_glory_rationale "These modifications represent the ronin's reliance on reputation (glory) first and foremost rather than on their already-tarnished honor."
            #L5RPW60yP1sV6yY4gC2iU4fH4vY: ronin_personal_code_tenets "GMs should consider the paramount and less significant tenets of Bushido in a ronin's personal code and how these affect any decrease or increase in their glory and honor attributes."
        }
    }

    # ===========================
    # PERSONAL CODE SYSTEM
    # ===========================

    # source stat block (page 181)
    ^"Ronin Personal Code" DEF {
        APPLIES TO [^"System"]
        PROPERTIES {
            ^"Type" STRING "Character Development"
            ^"Scope" STRING "Ronin, peasant, and gaijin characters"
        }
        RULES {
            #L5RPW60sJ9oB2mU1hH0uV2iD7mN: personal_code_three_factors "When developing a ronin's personal code, consider three factors: their past, their ninjō (desire), and their views on Bushido."
            #L5RPW60eU5nJ6tJ6xU4yC0tI3zB: personal_code_paramount_tenet "Players pick one paramount tenet and one less significant tenet to help craft their code. Only these two have mechanical implications."
            #L5RPW60pV5fF5bL1aB5aO8hN6pT: personal_code_ranking "Players may rank the importance of each tenet and include a sentence about how their character regards each one."
            #L5RPW60nE4mH7qD1xZ9nD1lA3kV: personal_code_evolving "A ronin's personal code can change as the character develops. As this happens, the code may reflect characters becoming more or less altruistic."
            #L5RPW60oQ3yQ3eH1cL4sS0vD0hX: personal_code_summary_statement "The personal code should include a simple statement summarizing the ronin's deeply held beliefs and the behavior they find virtuous."
        }
    }

    # ===========================
    # RONIN UNMASKING VARIANTS
    # ===========================

    ^"Ronin Tactical Unmasking" DEF {
        APPLIES TO [^"System"]
        PROPERTIES {
            ^"Type" STRING "Unmasking"
            ^"Scope" STRING "Ronin characters"
        }
        RULES {
            #L5RPW60yZ8hX0sO2eG7qN2yS5qA: ronin_unmasking_context "Ronin are less impacted by unmasking than lorded samurai since they have no lord whose reputation they represent. However, unmasking still has mechanical and narrative effects."
            #L5RPW60hG1hE2qR0zU3rV8yE3pO: ronin_unmasking_risk "Unlike samurai, a ronin's opinion may hold little authority. Expressing opinions unless carefully considered can result in imprisonment or execution, even if the risk to personal honor is low."
        }

        ENTRIES {
            ^"Gross Offense" DEF {
                PROPERTIES {
                    ^"Type" STRING "Unmasking Variant"
                    ^"Effect" STRING "The character takes great offense from a comment or nearby item. They immediately begin to overtly defend their position or voice displeasure. The TN of their next Social skill check increases by 1."
                }
            }
            ^"Muddled Words" DEF {
                PROPERTIES {
                    ^"Type" STRING "Unmasking Variant"
                    ^"Effect" STRING "The character becomes confused, loses concentration, and has difficulty communicating effectively. In an intrigue, they reduce momentum points gained by 1. In a conflict, they reduce their initiative by 1."
                }
            }
            ^"Secret Revealed" DEF {
                PROPERTIES {
                    ^"Type" STRING "Unmasking Variant"
                    ^"Effect" STRING "The character begins a monologue and accidentally reveals an important detail or secret pertinent to the current scene. The player chooses which secret is revealed; it becomes known to all characters in the scene."
                }
            }
            ^"Silent Tirade" DEF {
                PROPERTIES {
                    ^"Type" STRING "Unmasking Variant"
                    ^"Effect" STRING "The character becomes outwardly dismayed or frustrated, revealing intentions through facial expressions or nonverbal cues. The next action targeting the character using a Social skill reduces its TN by 1."
                }
            }
            ^"Unthinking Boasts" DEF {
                PROPERTIES {
                    ^"Type" STRING "Unmasking Variant"
                    ^"Effect" STRING "The character regales others about past accomplishments to divert attention from failings. This self-indulgent behavior is seen as hubris. The character forfeits glory equal to their highest ring value."
                }
            }
        }
    }

    # ===========================
    # NEW SOCIAL OBJECTIVES
    # ===========================

    # source stat block (page 184)
    ^"Endear" DEF {
        APPLIES TO [^"Social Objective"]
        PROPERTIES {
            ^"Type" STRING "Social Objective"
            ^"Scope" STRING "All characters (particularly appropriate for ronin)"
            ^"Completion Requirement" STRING "Accumulate momentum points equal to target's status rank using appropriate Social skill checks. TN based on target's vigilance."
            ^"Effect" STRING "Reduce the rarity to find an employment opportunity by 2 or a number equal to Commerce skill, whichever is greater."
            ^"Failure Condition" STRING "If the target retires from the scene before completion, this objective cannot be completed."
        }
    }

    # source stat block (page 184)
    ^"Gain an Audience" DEF {
        APPLIES TO [^"Social Objective"]
        PROPERTIES {
            ^"Type" STRING "Social Objective"
            ^"Scope" STRING "All characters (particularly appropriate for ronin)"
            ^"Completion Requirement" STRING "Accumulate momentum points equal to target's status rank. Skills used depend on the target's nature: Skulduggery for criminal elements, Government for governing bodies, Theology for religious organizations."
            ^"Effect" STRING "The character gains an audience with the target, the nature and security of such arrangements determined by the GM."
            ^"Failure Condition" STRING "If the character fails at three consecutive checks, this objective cannot be completed."
        }
    }

    # source stat block (page 185)
    ^"Gather Information" DEF {
        APPLIES TO [^"Social Objective"]
        PROPERTIES {
            ^"Type" STRING "Social Objective"
            ^"Scope" STRING "All characters (particularly appropriate for ronin)"
            ^"Completion Requirement" STRING "Accumulate momentum points equal to the status rank of the target most affected by the information sought."
            ^"Effect" STRING "The character gains the information they seek. Opportunities may add details, confirm reliability, or identify origin of information."
            ^"Failure Condition" STRING "If the character fails at two consecutive checks, the information fails to manifest, and the character's inquiries become known to the target."
        }
    }

    # ===========================
    # TITLES
    # ===========================

    # source stat block (page 185)
    ^"In Service to a Lord" DEF {
        APPLIES TO [^"Title"]
        PROPERTIES {
            ^"Type" STRING "Title"
            ^"Assigned By" STRING "Daimyo, advisors, and other individuals of import who can assign titles on their lord's behalf."
            ^"Status Award" STRING "+10 (to a maximum of 25)"
            ^"XP to Completion" INTEGER 24
        }
        RULES {
            #L5RPW61vW2xT7sU2nK0xO5jA3dW: in_service_title_ability "Privileged Position (Title Ability): Once per session, when acting in your lord's interest, you may use their status rank as your own."
        }
        CURRICULUM {
            Rank 1 {
                SKILL_GROUP "Martial"
                SKILL_GROUP "Social"
                SKILL "Culture"
                SKILL "Government"
                TECH_GROUP "Rank 1-2 Kata"
                TECHNIQUE "Wolf's Proposal"
                TECHNIQUE "Fluent Bargaining"
            }
        }
    }

    # source stat block (page 186)
    ^"Perfect Land Sect Member" DEF {
        APPLIES TO [^"Title"]
        PROPERTIES {
            ^"Type" STRING "Title"
            ^"Assigned By" STRING "A leader of the Perfect Land Sect."
            ^"Status Award" STRING "-5 (to a minimum of 15)"
            ^"XP to Completion" INTEGER 24
        }
        RULES {
            #L5RPW61cZ0zG8yK6rP5iH8mW3dN: perfect_land_title_ability "Trustworthy Cadence (Title Ability): When making a social skill check targeting a character with status 20 or lower, reduce the TN by 1."
        }
        CURRICULUM {
            Rank 1 {
                SKILL_GROUP "Scholar"
                SKILL "Courtesy"
                SKILL "Fitness"
                SKILL "Labor"
                TECH_GROUP "Rank 1-2 Water Shūji"
                TECHNIQUE "Roar of Encouragement"
                TECHNIQUE "Rallying Cry"
            }
        }
    }

    # source stat block (page 186)
    ^"Ghostlands Warrior" DEF {
        APPLIES TO [^"Title"]
        PROPERTIES {
            ^"Type" STRING "Title"
            ^"Assigned By" STRING "A member of the Yodhaniya of the Ivory Kingdoms."
            ^"Status Award" STRING "+0 (+10 in the Ivory Kingdoms, to a maximum of 50)"
            ^"XP to Completion" INTEGER 36
        }
        RULES {
            #L5RPW61xA4fT2iA6pJ2hC4zF7lX: ghostlands_warrior_title_ability "Eyes of the Yodhaniya (Title Ability): When you make a check to see through supernatural illusion, reduce the TN by 1. If you are in Defiled terrain, reduce the TN by 2 instead."
        }
        CURRICULUM {
            Rank 1 {
                SKILL_GROUP "Martial"
                SKILL "Command"
                SKILL "Medicine"
                SKILL "Survival"
                TECHNIQUE "Earth Needs No Eyes"
                TECHNIQUE "Soaring Slice"
                TECHNIQUE "Cleansing of Coral and Gold"
            }
        }
    }

    # source stat block (page 187)
    ^"Astradhari" DEF {
        APPLIES TO [^"Title"]
        PROPERTIES {
            ^"Type" STRING "Title"
            ^"Assigned By" STRING "An Ivory Kingdoms High Sage (such a person may only be chosen by the GM)."
            ^"Status Award" STRING "+0 (+25 in the Ivory Kingdoms, to a maximum of 65)"
            ^"XP to Completion" INTEGER 36
        }
        RULES {
            #L5RPW61mR7rQ4tU1fC2cZ8zI8iE: astradhari_title_ability "Sacred Mantras (Title Ability): You can purchase mantra techniques."
        }
        CURRICULUM {
            Rank 1 {
                SKILL_GROUP "Scholar"
                SKILL_GROUP "Martial"
                SKILL "Command"
                SKILL "Courtesy"
                TECH_GROUP "Rank 1-3 Rituals"
                TECHNIQUE "Summoning Mantra: [Implement Name]"
                TECHNIQUE "Touchstone of Courage"
            }
        }
    }

    # ===========================
    # BONDS SYSTEM
    # ===========================

    # source stat block (page 187)
    ^"Bonds System" DEF {
        APPLIES TO [^"System"]
        PROPERTIES {
            ^"Type" STRING "Optional Rules System"
            ^"Scope" STRING "All characters"
        }
        RULES {
            #L5RPW62qP2dA7gP7dR2dU1xE1dY: bonds_what_they_are "Bonds are close relationships important to the story that are dynamic and can change and grow. They provide mechanical incentives for character-oriented drama."
            #L5RPW62gA9fO6nP0fM5fD2uI2xF: bonds_forging "A player may request to forge a bond with someone else. The GM decides if it makes sense. The player spends XP to forge or advance the bond."
            #L5RPW62pB5iT2oS9vJ4uZ7oP6zB: bonds_xp_not_school "Experience spent on bonds does not contribute toward a character's current school rank or to a title."
            #L5RPW62jD8oP7eC1lR5xD8xC8kQ: bonds_calling_upon "A character can call upon a bond to use its unlocked abilities a number of times per session equal to the bond's rank."
            #L5RPW62pP4fD4cT1hL1lY0wL5tD: bonds_persist_after_death "Bonds do not vanish if the bonded person leaves or perishes. The lessons and strength gained are permanent. A character can continue to advance a bond with a dead person."
            #L5RPW62oE8dH5nN2jC0pG9cB4aG: bonds_pc_vs_npc "Bonds between PCs function mechanically but are not generally as useful as bonds between PCs and NPCs. Bonds help get more out of relationships with characters who appear less frequently."
            #L5RPW62oP3uM1fQ1pV5mB7tW9oX: bonds_multi_character "Bonds generally exist between two characters but can exist between more at GM's discretion (e.g., a fellowship or family sharing a single bond)."
            #L5RPW62rG4bR5jV1fP8bW1nK9bU: bonds_evolving "If two characters' relationship changes (rivals become comrades, family member becomes nemesis), the GM and player can change the bond type. Ranks remain but type changes."
            #L5RPW62zO4eF0vU6nL8qZ6cP2nQ: bonds_mutual_pc "If two or more PCs forge or advance a bond, each PC must individually spend the full XP required at the same time."
        }
    }

    # --- BOND RANK TABLE ---

    ^"Bond Rank Table" DEF {
        APPLIES TO [^"Table"]
        TABLE {
            COLUMNS ["Bond Rank", "XP Cost", "Ability Unlocked"]
            ROW ["Rank 1", "3 XP", "Bond Ability (varies by bond type): In addition to narrative benefits, you may call upon your relationship with one bonded character based on the type of bond."]
            ROW ["Rank 2", "4 XP", "Like you always say...: You count as having one bonded character's assistance on a check in which the bonded character is skilled."]
            ROW ["Rank 3", "6 XP", "A familiar presence draws near...: If the bonded character is an NPC, you may play that character instead of your own for the next scene (or establishing flashback). Adhere to that character's giri and ninjō. Major decisions require GM approval. If bonded character is a PC, you may immediately play out an establishing flashback between your characters."]
            ROW ["Rank 4", "8 XP", "You taught me this!: Use one bonded character's ring or skill ranks (or skill group ranks for NPCs) for a check instead of your own."]
            ROW ["Rank 5", "10 XP", "We are bound by this fate we have made!: Transfer one of your Void points to the bonded character, or gain 1 Void point after they spend a Void point."]
        }
    }

    # --- BOND TYPES ---

    ^"Old Flame Bond" DEF {
        APPLIES TO [^"Bond"]
        PROPERTIES {
            ^"Type" STRING "Bond"
            ^"Bond Type" STRING "Old Flame"
            ^"Description" STRING "Represents people with a romantic history who find themselves crossing paths frequently, thrown together once again, or entangled in one another's circumstances."
        }
        RULES {
            #L5RPW62sE8sN3nX8rN2mP5cO6bR: old_flame_base "An old flame knows your best and worst qualities (and any advantages/disadvantages you possessed at the time), and you know theirs. They are willing to use these to achieve their own goals as long as it does not significantly harm you. They will do you small favors (hints about opportunities, warnings of danger, directions to contacts) often without being asked."
            #L5RPW62kM8aN1aG0tE0iP4lF7lE: old_flame_allies_enemies "Your old flame's allies are cautious to hostile depending on how the relationship dissolved. Your old flame's enemies are likely unaware of you but might attempt to use you against your old flame if they learn of your past."
            #L5RPW62zF4qN3lB1xI3iI5yO1nX: old_flame_rank3 "At bond rank 3 or higher, your old flame takes more significant steps on your behalf (paying off debts, arriving to rescue you, putting your name before someone wealthy or powerful seeking ronin with your skills) — usually without your request."
            #L5RPW62mO1sO4hU9sD8aA3mL3iI: old_flame_ability "It's Always Like This with You (Bond Ability): At the end of a scene involving your old flame or reminders of them, after removing strife and fatigue, you may call upon your bond to remove additional fatigue equal to your bond rank, then gain that much strife."
        }
    }

    # source stat block (page 189)
    ^"Partner Bond" DEF {
        APPLIES TO [^"Bond"]
        PROPERTIES {
            ^"Type" STRING "Bond"
            ^"Bond Type" STRING "Partner"
            ^"Description" STRING "Represents individuals who have made long, lasting bonds of unconditional trust — close friends, spouses, lovers, fellow soldiers, or survivors who rely on each other."
        }
        RULES {
            #L5RPW62nA9cA6mU4mQ4sX5fJ9dD: partner_base "A partner trusts you implicitly and will assist with nearly anything given rational explanation. However, they also intervene to stop you from doing things harmful to you."
            #L5RPW62mY9uB7mX6qH1kS1hM4dN: partner_allies_enemies "Friends and allies of your partner tolerate you and give benefit of the doubt, but generally won't do favors unless the favor benefits your partner directly. Enemies of your partner view you as an enemy."
            #L5RPW62aC7pR5aD1jL6lK9uM3tS: partner_rank3 "At bond rank 3 or higher, your partner more proactively intervenes on your behalf, may be more assertive about your harmful tendencies, and backs you with full means at their disposal if you insist something is important."
            #L5RPW62bD1zL8sO4vA5rM7jV4vW: partner_ability "Always Got Your Back (Bond Ability): Once per scene, you may call upon your bond to know exactly what your partner is thinking (or was thinking at a previous time), or have your partner know exactly what you are thinking, without direct communication. Express this idea in five words or fewer, plus additional words equal to your bond rank. When you use this ability, you and your partner may remove strife up to your bond rank, divided between the two as you choose."
        }
    }

    # source stat block (page 189)
    ^"Protector and Ward Bond" DEF {
        APPLIES TO [^"Bond"]
        PROPERTIES {
            ^"Type" STRING "Bond"
            ^"Bond Type" STRING "Protector and Ward"
            ^"Description" STRING "Represents a character who has taken responsibility for someone dependent on them — a lost heir, someone their lord wanted dead, or someone who simply needed them."
        }
        RULES {
            #L5RPW62iH4mN1bN1jR9tS7dF5oY: protector_ward_base "If protector: your ward is reliant on you and cannot fully fend for themselves but is eager to help. If ward: your protector seeks to act in your best interests and keep you safe."
            #L5RPW62vY2pH4jE7sB1wF1wO5iE: protector_ward_allies_enemies "Enemies of your ward target you first. Allies of your ward view you positively, may feel great debt, and assist within their means (hiding you, acquiring equipment, giving contacts)."
            #L5RPW62mC5vC7lL9uZ8zJ4gR7cF: protector_rank3 "At bond rank 3+ (protector): You instinctively sense if your ward is in danger. Your ward (if NPC) acquires 1 rank in 2 skill groups in which you possess 3+ ranks. Ward starts to act on own initiative and may get you out of trouble."
            #L5RPW62oN5xJ5kF6uG6rJ8cD5rX: ward_rank3 "At bond rank 3+ (ward): Your protector instinctively senses if you are in danger. Your protector (if NPC) acquires 1 rank in 2 skill groups in which you possess 3+ ranks and looks out for your happiness in addition to safety."
            #L5RPW62bK9xE6vA1lB8hM3yI2iW: protector_ability "Under My Protection (Protector Bond Ability): Once per scene when protecting your ward, their interests, or their memory, you may call upon your bond to treat your endurance as increased by your bond rank until end of scene."
            #L5RPW62qQ6bL2mD9jS2kU9wL0gD: ward_ability "I've Been Learning (Ward Bond Ability): Once per scene when you or your protector makes a check in which the other has 1+ skill ranks (or skill group ranks if NPC), you may call upon your bond to negate strife results equal to your bond rank."
        }
    }

    ^"Rival Bond" DEF {
        APPLIES TO [^"Bond"]
        PROPERTIES {
            ^"Type" STRING "Bond"
            ^"Bond Type" STRING "Rival"
            ^"Description" STRING "Represents characters who often come into conflict but do not hate each other and may even feel mutual respect."
        }
        RULES {
            #L5RPW62dV3fQ4vZ7sE8cF5gP9vO: rival_base "A rival seeks to oppose you when opportunity presents itself and is unfavorably disposed toward you. However, their enmity lends gravity to your position, making those outside the conflict more convinced of your importance."
            #L5RPW62tN3bX4rU7vG1pX2tU5sI: rival_allies_enemies "Allies of your rival treat you with grudging respect and suspicion. Your rival's enemies might seek your aid or offer you aid in opposing your rival."
            #L5RPW62dP9rT3sD7tY0vZ1kT2eU: rival_rank3 "At bond rank 3+, your rival views themselves as your true foe and looks dimly upon anyone else who acts against you. They can be relied upon to keep others from harming you (so they can defeat you on their own terms someday)."
            #L5RPW62oV8aA9aM8mP7sP3iQ7tB: rival_ability "I Will Surpass You! (Bond Ability): While making a check, you may call upon your bond. Receive strife equal to your bond rank, then reroll up to that many dice."
        }
    }

    ^"Wanderers Fellowship Bond" DEF {
        APPLIES TO [^"Bond"]
        PROPERTIES {
            ^"Type" STRING "Bond"
            ^"Bond Type" STRING "Wanderers' Fellowship"
            ^"Description" STRING "Represents warrior bands who work, fight, suffer, and laugh together. These bonds can become as strong as family bonds."
        }
        RULES {
            #L5RPW62qS6dR6uT6kF6xK0jK0zN: fellowship_base "Other fellowship members watch out for your safety, help with modest favors (cuts on jobs, introductions, buying sake), and expect you to reciprocate."
            #L5RPW62fK0rW3sW7mP8fH5jV1kQ: fellowship_allies "Those who have worked with your fellowship before regard you the same way they do your fellows. Your actions reflect upon members, and if you step out of line they intervene to set you on the right path or remove you."
            #L5RPW62xM8mX0zG6qE6uW6wQ1mD: fellowship_rank3 "At bond rank 3+, your fellowship's loyalty is extremely deep. Members accept dangerous jobs without question, join battles that do not pay, and perhaps even buy your sake without reminding you three times."
            #L5RPW62yQ3nV2rP3lF6sJ4jR2bC: fellowship_ability "Sworn to Duty and to Death (Bond Ability): At the start of your turn, if you are Compromised or Incapacitated, you may call upon your bond to remove fatigue and strife equal to your bond rank."
        }
    }

    # ===========================
    # TYPICAL RONIN TASKS TABLE
    # ===========================

    # source stat block (page 179)
    ^"Typical Ronin Tasks" DEF {
        APPLIES TO [^"Table"]
        TABLE {
            COLUMNS ["Task", "Description", "Skill Group", "Rarity", "Base Wage"]

            # --- LOW RISK ---
            ROW ["Administration", "Maintaining documents for tax collectors, general administration of an estate, scribing documents, and writing letters.", "Artisan, Scholar, or Trade", "8", "1 bu/day"]
            ROW ["Attendant", "Acting as a lantern or umbrella bearer or as a servant coordinator.", "Artisan, Scholar, or Trade", "5", "1 bu/week"]
            ROW ["Ceremony", "Performing a peasant wedding, blessing new ground before construction, or purifying leather being tanned.", "Scholar", "6", "2 bu/day"]
            ROW ["Combat Training", "Peasant levy training using basic weapons like clubs, spears, and farming tools, along with instruction on preparing moats.", "Martial", "3", "1 bu/week"]
            ROW ["Crafting", "Crafting goods or tools, overseeing creation of leather, or forging weapons. Wage does not include materials.", "Artisan", "5", "1 bu/day"]
            ROW ["Hunting", "Gathering food or other resources through hunting of game.", "Trade", "4", "1 bu/week"]
            ROW ["Sailing", "Acting as a crew member aboard a sailing vessel.", "Trade", "2", "1 bu/week"]

            # --- MEDIUM RISK ---
            ROW ["Bodyguard (Yojimbo) or Guard", "Serving on a city patrol, as protection for an individual, or for a group such as a caravan.", "Martial", "3", "4 bu/week"]
            ROW ["Bounty Hunting", "Hunting down a group or individual plaguing a town or village with aim of capturing or eliminating the threat.", "Martial", "4", "4 bu/week"]
            ROW ["Extortion", "Threatening someone to gain some benefit or payment for an employer.", "Social", "6", "7 bu/week"]
            ROW ["Firefighting", "Offering service to fight fires breaking out in a city, town, or village.", "Martial", "4", "2 bu/week"]
            ROW ["Negotiation", "Acting on behalf of a daimyo or lord dealing with another group considered dishonorable.", "Social", "5", "5 bu/week"]
            ROW ["Thievery", "Stealing from an estate or individual; includes espionage.", "Trade", "6", "3 bu/week"]

            # --- HIGH RISK ---
            ROW ["Kidnapping", "Taking a target and removing them from regular abode to another locale.", "Martial, Social, or Trade", "7", "5 koku/job"]
            ROW ["Assassination", "Eliminating an important member of a council, local governor, or bandit leader.", "Martial or Trade", "8", "10 koku/job"]
            ROW ["Protection", "Protecting a township, village during harvest, or shrine from looters.", "Martial", "6", "1 koku/week"]
            ROW ["Smuggling", "Taking livestock, goods, or individuals across established borders.", "Scholar or Trade", "7", "2 koku/job"]
            ROW ["Soldier", "Serving in a lord's army.", "Martial", "5", "1 koku/week"]
        }
        RULES {
            #L5RPW63xB4cR5iR8vK1kL8oA6rR: ronin_task_wage_quality "GMs may consider multiplying payments received by a character's school rank if appropriate for the task, reflecting a ronin's maintenance of quality."
        }
    }

    # ===========================
    # RONIN CLAN RELATIONSHIPS TABLE
    # ===========================

    # source stat block (page 180)
    ^"Ronin Clan Relationships" DEF {
        APPLIES TO [^"Table"]
        TABLE {
            COLUMNS ["Clan", "Typical Employment Options", "Suggested Pay Modifier"]
            ROW ["Crab", "Soldiers and armed recovery teams searching for missing scouts beyond the Wall.", "x1"]
            ROW ["Crane", "Spies, soldiers, scouts, and messengers.", "x1.5"]
            ROW ["Dragon", "Wilderness guides and caravan escorts headed to small villages through treacherous terrain to collect taxes.", "x1"]
            ROW ["Lion", "Mercenary soldiers, messengers, teachers of ashigaru.", "x0.5"]
            ROW ["Phoenix", "Caravan guards, librarians, scribes, and yoriki.", "x1"]
            ROW ["Scorpion", "Spies, messengers, and couriers.", "x1.5"]
            ROW ["Unicorn", "Soldiers, messengers, and scouts.", "x1.5"]
        }
    }

