    # ===========================
    # HAND TO MOUTH SUBSYSTEM
    # ===========================

    # source stat block (page 107)
    ^"Hand to Mouth System" DEF {
        APPLIES TO [^"System"]
        PROPERTIES {
            ^"Description" STRING "Economic subsystem for ronin characters reflecting the challenges of living without a lord's resources. Covers trade in Rokugan, making money, fluctuating currency values, travel papers, and the slow erosion of status and honor that comes with lordless survival."
        }
        RULES {
            #L5RPW09oZ4mZ0zK7nU0hP3lL5iI: trade_philosophy "Samurai society considers trade beneath samurai station. Lorded samurai use barter, gifts, and favors rather than coin. Ronin must handle coin directly."
            #L5RPW09yV9gS7dH1eE2fF5kE5iA: ronin_economics "Ronin are subject to financial forces beyond their control. Rokugan has no unified currency. Value of zeni, bu, or koku fluctuates by region and harvest."
            #L5RPW09bE2nP4mH5gP5fT3oD5rY: weapon_acquisition "Weapons are not sold in shops. They are commissioned by lords. Ronin must convince blacksmiths to forge weapons or acquire them by other means."
            #L5RPW09qO3bT0sC6tG7gF1bZ7aC: travel_papers "Travel papers required for legal movement. Ronin must humble themselves to obtain them. Without papers, ronin risk being treated as spies or bandits."
            #L5RPW09hR9gI7cK1sV0xM4wZ7rF: lifestyle_degradation "Ronin maintaining samurai appearance must pay for sword repair, armor maintenance, horse care, and silk cleaning. Many sell off fine things; the pony is usually first, then armor."
        }
    }

    # ===========================
    # CELESTIAL IMPLEMENTS SYSTEM
    # ===========================

    # The celestial implements system from the Ivory Kingdoms.
    # Characters must acquire the Astradhari title to learn
    # Summoning Mantras. A character may learn summoning
    # mantras equal to their school rank.

    ^"Celestial Implements System" DEF {
        APPLIES TO [^"System"]
        PROPERTIES {
            ^"Name" STRING "Celestial Implements (Astras)"
            ^"Source" STRING "Ivory Kingdoms tradition"
            ^"Description" STRING "Celestial implements are divine weapons and objects invoked through sacred mantras. An astradhari (wielder of astras) must learn the Summoning Mantra for each specific implement. Implements have a Blessing Source (deity, element, counter element, restriction), a Form (projectile, melee, armor, utility), and Boons (supernatural qualities)."
        }
        RULES {
            #L5RPW06vH3gV1uZ4uQ6vA6sG3hP: implement_summoning_limit "A character may learn a number of specific summoning mantras equal to their school rank."
            #L5RPW06pB8nH1fI6iT8wC6gD8iP: implement_staked_honor "When summoning, the character must stake honor equal to two times their honor rank on upholding the implement's restriction."
            #L5RPW06uE1lU0wN9oB8iF5vP9sR: implement_restriction_break "If the character breaks the restriction, they lose staked honor and the implement is dispelled. Cannot summon that implement again this scene."
            #L5RPW06bG1cK1gB3aF7pF2xY2qA: implement_qualities "All summoned implements gain Ceremonial, Resplendent, and Sacred qualities (losing Mundane and Subtle)."
        }
    }

    # ===========================
    # SCHOOL-BUILDING GUIDELINES
    # ===========================

    # The book provides a detailed school-building system in
    # Chapter 2 (pages 76-84). Key reference tables are encoded here.

    # source stat block (page 76)
    ^"School Building System" DEF {
        APPLIES TO [^"System"]
        PROPERTIES {
            ^"Description" STRING "Step-by-step system for creating custom schools. Steps: 1) Determine role(s), 2) Choose affiliations and summary, 3) Design school ability, 4) Choose ring bonuses, 5) Choose skills, 6) Select technique access and starting techniques, 7) Build curriculum and mastery ability, 8) Starting outfit, 9) Name."
        }
        RULES {
            #L5RPW07wF3jC4fW5yF6uI0aO9cW: school_build_roles "Seven roles available: Artisan, Bushi, Courtier, Monk, Sage, Shinobi, Shugenja. Recommend 1-2 roles (max 3)."
            #L5RPW07jZ4xF4dQ7cW8oB7vL0pT: school_build_skills_artisan "Artisan: 7 skills available, 5 picks. Common: Aesthetics, Composition, Courtesy, Culture, Design, Martial Arts [Melee], Smithing."
            #L5RPW07bG2yZ0cQ4oG2yZ5pZ6wD: school_build_skills_bushi "Bushi: 7 skills available, 5 picks. Common: Command, Fitness, Government, Martial Arts [Melee/Ranged/Unarmed], Meditation, Tactics."
            #L5RPW07gK3lO5pV5eH3xO4bV1pV: school_build_skills_courtier "Courtier: 7 skills available, 5 picks. Common: Composition, Courtesy, Culture, Government, Martial Arts [Ranged], Performance, Sentiment."
            #L5RPW07gJ0rE6rX0oI7pF7kD8yR: school_build_skills_monk "Monk: 6 skills available, 4 picks. Common: Fitness, Martial Arts [Melee/Unarmed], Meditation, Survival, Theology."
            #L5RPW07bD9gZ7eG0mG5kZ4yD2cC: school_build_skills_sage "Sage: 6 skills available, 3 picks. Common: Courtesy, Games, Labor, Meditation, Survival, Theology."
            #L5RPW07mP7tQ3cK2rR5vV5wN2gS: school_build_skills_shinobi "Shinobi: 7 skills available, 5 picks. Common: Courtesy, Culture, Skulduggery, Martial Arts [Melee/Ranged], Medicine, Performance."
            #L5RPW07wZ1qM0xN8bC1cU3cO6dK: school_build_skills_shugenja "Shugenja: 6 skills available, 3 picks. Common: Composition, Courtesy, Culture, Games, Meditation, Theology."
            #L5RPW07jL5iU5uA8tJ1dF6gC7fL: school_build_starting_techniques "Starting techniques by role: Artisan 3, Bushi 2, Courtier 2, Monk 3, Sage 4-5, Shinobi 2, Shugenja 4-5 (including Commune with Spirits)."
            #L5RPW07xV5yE9aO5oC4lI9gU8oV: school_build_first_ring "Suggested first ring: Artisan (Fire/Water), Bushi (Earth), Courtier/Shinobi (Air), Monk/Sage (Void), Shugenja (attuned element)."
        }
    }
}
