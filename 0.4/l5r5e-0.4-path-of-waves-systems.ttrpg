    # source stat block (page 229)
    ^"Annoyed Tax Collector" DEF {
        EXTENDS ^"NPC"
        PROPERTIES {
            ^"Type" STRING "Adversary" FIXED
            ^"Combat Conflict Rank" INTEGER 2
            ^"Intrigue Conflict Rank" INTEGER 3
            ^"Description" STRING "Imperial tax collectors often drafted from yoriki and doshin. Occasionally delegated to an Emerald Magistrate as a veiled demotion. Ronin are often hired as bodyguards."
            ^"Rings" DEF {
                ^"Air" INTEGER 2
                ^"Earth" INTEGER 2
                ^"Fire" INTEGER 3
                ^"Water" INTEGER 1
                ^"Void" INTEGER 1
            }
            ^"Honor" INTEGER 55
            ^"Glory" INTEGER 43
            ^"Status" INTEGER 39
            ^"Endurance" INTEGER 8
            ^"Composure" INTEGER 8
            ^"Focus" INTEGER 4
            ^"Vigilance" INTEGER 2
            ^"Demeanor" STRING "Assertive"
            ^"Skills" LIST OF STRING ["Artisan 0", "Martial 2", "Scholar 2", "Social 2", "Trade 1"]
            ^"Advantages" LIST OF STRING ["Vaguely Threatening: Martial; Interpersonal, Physical", "Imperial Authority: Social; Interpersonal"]
            ^"Disadvantages" LIST OF STRING ["Unpopular: Social; Interpersonal"]
            ^"Favored Weapons" LIST OF STRING ["Katana: Range 1, Damage 4, Deadliness 5/7, Ceremonial, Razor-Edged"]
            ^"Gear" LIST OF STRING ["Lacquered armor (Physical 4, Ceremonial, Cumbersome, Wargear)", "wakizashi", "jitte", "knife", "riding pony", "traveling outfit", "as many ronin minions as possible"]
        }
        RULES {
            #L5RPW70tH7rU5xH7eM0nU2eU7qI: tax_collector_aura_of_dread "Aura of Dread: At the start of a scene where an annoyed tax collector is present, or when one arrives for the first time, all other characters with status 65 or less receive 3 strife."
        }
    }

