# .codex SECTION — Emerald Empire: Wilds of Rokugan (Chapter 6 — coasts,
# forests, mountains, and ruins). Stand-off graph over
# l5r5e-0.4-emerald-empire-wilds.lore (spec §25). Part of the L5R5e system
# graph; DEPENDS_ON the shared schema. Covers the mountain passes and forges,
# the great forests and their spirits, Shinomen Forest and the nezumi, the
# haunted ruins (Burned Monk, Forgotten Village), and the coastal sites.
#
# Note: the chapter opens by reprinting the Dai / Plains Wind statblock from
# enlightenment.lore — that entity is already in the enlightenment section.

CODEX "L5R5e_Codex_EE_Wilds" {
    NAME "Emerald Empire: Wilds of Rokugan — Lore Graph"
    VERSION "0.1"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-09-02"
    FOR EDITION "l5r5e"
    DEPENDS_ON "L5R5e_Codex_Schema" VERSION "0.9"

    # -- Framing fiction (no matching heading; bound at file level) -------------

    ENTITY #L5RcxEEwil01nejiropr ^"Nejiro Province" {
