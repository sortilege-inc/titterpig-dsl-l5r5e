# .codex SECTION — Shadowlands: Out of the Shadows (running Shadowlands games).
# Stand-off graph over l5r5e-0.4-shadowlands-out-of-the-shadows.lore (spec §25).
# GM-facing procedure plus new mechanical Titles (The Damned, Harvester,
# Twenty-Goblin Crab, Witch Hunter, Dread Enforcer), Corruption rules, and Oni
# Generation — all DEFs/rules, not lore entities. Captured: the recurring POV
# vignette bushi, bound at file level.

CODEX "L5R5e_Shl_OutOfShadows_Codex" {
    NAME "Shadowlands: Out of the Shadows — Lore Graph"
    VERSION "0.1"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-09-02"
    FOR EDITION "l5r5e"
    DEPENDS_ON "L5R5e_Codex_Schema" VERSION "0.9"

    ENTITY #L5RcxShlout01hidasane ^"Hida Sanae" {
        IS ^"Person"
        SOURCE "l5r5e-0.4-shadowlands-out-of-the-shadows.lore"
        RELATIONSHIPS { ^"member-of" -> ^"Crab Clan" FROM "the recurring Crab bushi Hida Sanae" }
    }
}
