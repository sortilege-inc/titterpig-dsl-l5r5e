            }

            #QpOJO4mD6GPhFwUiPqML7w ^"Fun and Games" DEF {
                ^"Type" STRING "Shūji"
                ^"Subtype" STRING "Water Shūji"
                ^"Rank" INTEGER 1
                ^"Activation" STRING "When you make a Games (Water) check"
                ^"Opportunities" STRING "Water (op)+: Choose one participant or observer, remove 1 strife per (op) spent. Water (op)(op)(op): Remove 1 strife from each participant and observer instead."
            }

            # --- VOID SHUJI ---

            #eYH247TMrCVewL7IBbB8xk ^"Foreseen Need" DEF {
                ^"Type" STRING "Shūji"
                ^"Subtype" STRING "Void Shūji"
                ^"Rank" INTEGER 4
                ^"Activation" STRING "As a Support action"
                ^"Check" STRING "TN 1 Artisan (Void)"
                ^"Effect" STRING "If you succeed, recall that you foresaw the need for an item with rarity equal to 1 plus bonus successes. Spend one Void point to instantly reveal an item you could have crafted (must be reasonable)."
                ^"Opportunities" STRING "Void (op): Double the rarity of the target item, but the item must be perishable or of sentimental value only."
            }
        }

    }

    # ===========================
