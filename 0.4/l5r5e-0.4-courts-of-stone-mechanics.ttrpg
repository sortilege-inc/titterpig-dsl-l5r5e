                ^"Open-Hand Style" [kata]
            }
            RANK 3 {
                SKILL_GROUP "Social Skills"
                SKILL "Culture"
                SKILL "Commerce"
                SKILL "Meditation"
                TECHNIQUE_GROUP "Rank 1-3 Air Shūji"
                ^"The Great Silence" [kiho]
                ^"The Ties that Bind" [ritual]
            }
            RANK 4 {
                SKILL_GROUP "Martial Skills"
                SKILL "Culture"
                SKILL "Medicine"
                SKILL "Performance"
