                ^"Soaring Slice" [kata]
            }
            RANK 2 {
                SKILL_GROUP "Trade Skills"
                SKILL "Courtesy"
                SKILL "Culture"
                SKILL "Martial Arts [Melee]"
                TECHNIQUE_GROUP "Rank 1-2 Close Combat Kata"
                ^"To Float or Sink" [ninjutsu]
                ^"Crescent Moon Style" [kata]
            }
            RANK 3 {
                SKILL_GROUP "Martial Skills"
                SKILL "Smithing"
                SKILL "Games"
                SKILL "Skulduggery"
                TECHNIQUE_GROUP "Rank 1-3 General Kata"
                ^"Slicing Wind Kick" [ninjutsu]
