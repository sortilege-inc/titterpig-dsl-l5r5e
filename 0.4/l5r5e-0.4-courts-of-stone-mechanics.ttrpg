    # source stat block (page 96)
    ^"Shika Speardancer" DEF {
        EXTENDS #L5R252wX4yZ6aB8cD0eF2g ^"School"
        APPLIES TO [^"Samurai"]

        # Shika Speardancers are yojimbo and shinobi, but to the
        # outside world, they are simply seen as messengers known
        # for their swiftness and neutrality. Their cover as couriers
        # frees them to work as bodyguards or assassins without
        # drawing attention. They practice a unique set of kata that
        # combine dizzying spins, lightning-speed twirls, and deadly
        # accuracy with their yari.

        PROPERTIES {
            ^"School Name" STRING "Shika Speardancer" FIXED
            ^"Clan" STRING "Deer"
            ^"Roles" LIST ["Bushi", "Shinobi"]
            ^"Ring Increase" DEF {
                ^"Air" INTEGER 1
                ^"Fire" INTEGER 1
            }
            ^"Starting Skills" DEF { CHOOSE 5 [^"Martial Arts [Melee]", ^"Meditation", ^"Skulduggery", ^"Survival", ^"Fitness", ^"Sentiment", ^"Courtesy"] INTEGER 1 }
            ^"Starting Honor" INTEGER DEFAULT 35
            ^"Techniques Available" LIST ["Kata", "Rituals", "Shūji"]
        }


        STARTING_TECHNIQUES {
            KATA ^"Trip the Leg"
            KATA CHOOSE 1 [^"Striking as Air", ^"Striking as Fire"]
        }

        SCHOOL_ABILITY "Typhoon in the Bamboo Grove" {
            "When making a Martial Arts [Melee] or Fitness check, you may spend (op)(op) to cause a number of characters no greater than your school rank and within range of your readied weapon to suffer the Dazed condition."
        }

        MASTERY_ABILITY ^"The Lowest Bow" {
            "When performing an Attack action using Martial Arts [Melee], you may spend (op) as follows: (op)+: Choose one character other than your target at range 2 with vigilance lower than or equal to (op) spent this way. That character suffers a critical strike with severity equal to your weapon's deadliness plus your ranks in Martial Arts [Melee]."
        }
        STARTING_OUTFIT [
            "traveling clothes", "stealth clothing or ashigaru armor",
            "yari or kamayari", "wakizashi",
            "traveling pack"
        ]

        CURRICULUM {
            RANK 1 {
                SKILL_GROUP "Martial Skills"
                SKILL "Games"
                SKILL "Skulduggery"
                SKILL "Survival"
                TECHNIQUE_GROUP "Rank 1 Air Shūji"
