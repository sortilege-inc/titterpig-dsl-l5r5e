            # --- WATER SHUJI ---

            #NHSvf55MvHC872WUw9laYv ^"Beware the Smallest Mouse" DEF {
                ^"Type" STRING "Shūji"
                ^"Subtype" STRING "Water Shūji"
                ^"Rank" INTEGER 1
                ^"Activation" STRING "When you make a Social skill (Water) check targeting one or more characters"
