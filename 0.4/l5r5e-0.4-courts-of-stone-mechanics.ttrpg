        }

        SCHOOL_ABILITY "Claws of the Crab" {
            "When you make a check to perform the Guard action, you may spend (op) as follows: (op)+: If you succeed, you may guard one additional character in range per (op) spent this way. Maximum (op) equal to your school rank."
        }

        MASTERY_ABILITY ^"The Standing Death" {
            "Once per game session, when you perform the Challenge action, you may choose up to 6 additional characters who can hear you as targets. These targets must have status lower than or equal to your original target's. If you succeed, each target must fight you in a clash one at a time in an order of their choosing (or flee the battle). Each clash lasts one round. After each clash, you regain fatigue equal to your Earth Ring. Until all clashes have concluded (or you have been killed), none of your targets can perform Attack or Scheme actions outside of their individual clashes."
        }
        STARTING_OUTFIT [
            "crossbow or spear", "daishō",
            "pony or ashigaru armor", "traveling pack",
            "map of Crab Lands", "knife"
        ]

        CURRICULUM {
