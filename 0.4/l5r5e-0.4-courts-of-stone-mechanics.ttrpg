                SKILL "Survival"
                TECHNIQUE_GROUP "Rank 1-4 Fire Shūji"
                ^"Rouse the Soul" [shuji]
                ^"Disappearing World Style" [kata]
            }
            RANK 5 {
                SKILL_GROUP "Social Skills"
                SKILL "Government"
                SKILL "Sentiment"
                SKILL "Tactics"
                TECHNIQUE_GROUP "Rank 1-5 General Kata"
                ^"Silent Elimination" [ninjutsu]
