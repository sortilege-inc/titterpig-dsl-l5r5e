    # ===========================
    # OPTIONAL RULES: TRIFLING BREACHES & SMALL SACRIFICES
    # ===========================

    # source (page 134)
    ^"Courtesy Honor Rules" DEF {
        APPLIES TO [^"Samurai"]

        # Optional additions to the core honor and glory forfeits/awards table.

        ^"Trifling Breaches" DEF {
            # When a character wishes to commit a breach of Courtesy
            # judged less serious than a minor breach, they must first
            # forfeit 1 honor. Examples include:
            # - Cursing in the presence of someone of higher status
            # - Publicly discussing finances or mercantile pursuits
            # - Forgetting specifics of a minor societal ritual before someone of higher status
        }

        ^"Small Sacrifices" DEF {
            # When a character makes a sacrifice in the name of
            # Courtesy judged less significant than a minor sacrifice,
            # they are awarded 1 honor. Examples include:
            # - Paying an honest compliment to an enemy during battle
            # - Letting a serious insult to your person pass
        }

    }

    # ===========================
    # OPPORTUNITY TABLES FOR INTRIGUE GAMES
    # ===========================

    # source (page 132)
    ^"Intrigue Opportunity Tables" DEF {
        APPLIES TO [^"Samurai"]

        # Optional opportunity expenditures for Winter Court games
        # and other intrigue-oriented games. Can be used in any game
        # for intrigue scenes such as arguments, romance, and
        # investigative challenges.

        ^"Spending Opportunity in Negotiations" DEF {
            ENTRIES {
                #yNtsTA7DdBPIEzUNx2lWjp ^"Air (op)(op)+" DEF {
                    ^"Effect" STRING "Your verbal trap ensnares someone: they must offer you a minor concession unrelated to your current social objective unless they give up 1 momentum point per (op)(op) spent this way."
                }
                #hyh8MOgcA2gNpA8jwHo45R ^"Earth (op)(op)(op)" DEF {
                    ^"Effect" STRING "Your uncompromising dedication stalls the conversation. Choose a character in the scene: that character cannot gain momentum points toward any social objective until the end of your next turn."
                }
                #n03r0nt2NybZXMeljGCfvJ ^"Fire (op)(op)" DEF {
                    ^"Effect" STRING "You set someone on the defense with fast-paced questions. Choose a demand or statement another character has made. Their player (or GM for NPCs) must tell you any hidden motivations behind that demand or statement."
                }
                #Im4ITlhjnHOVhgG7XzcHuD ^"Water (op)(op)" DEF {
                    ^"Effect" STRING "You break the tension with a well-timed joke. Ask one personal question of a character with a different social objective (unrelated to negotiations). If they answer honestly, they gain 1 momentum point and may ask you a personal question; if they do, you gain 1 momentum point."
                }
                #xU0aWPJC9FKXcfjN3SvElt ^"Void (op)(op)(op)" DEF {
                    ^"Effect" STRING "You shake someone's conviction with deep insight. Until the end of your next turn, any momentum points they score are added to your current social objective instead of their own."
                }
            }
        }

        ^"Spending Opportunity in Romance" DEF {
            ENTRIES {
                #pAlXfRh3rKsc5l6BExE0uK ^"Air (op)(op)" DEF {
                    ^"Effect" STRING "The conversation turns to mutual acquaintances. Name a character you and your intended both know. They must tell you what they think of that character, revealing one of that person's advantages or disadvantages."
                }
                #d24Am8O2oDh1Kjzl9uL3NL ^"Earth (op)(op)" DEF {
                    ^"Effect" STRING "An offhand comment reveals common ground: an odd hobby, a favorite actor, or a core belief. Make three suggestions to your intended's player; they must tell you which one it is. You and your intended may each remove 2 strife."
                }
                #Dcx7P8HzRlHCQtcAC9Wp3q ^"Fire (op)(op)" DEF {
                    ^"Effect" STRING "A detail of your appearance catches your intended's interest. Their player must tell you which physical attribute they find most captivating. You and your intended each receive 1 strife and reduce the TN of your next Social skill check by 1."
                }
                #uV0hsUQ4yZ45Iy6BE5u07h ^"Water (op)(op)" DEF {
                    ^"Effect" STRING "Your interaction is pleasant enough that your intended suggests another meeting within the next day or two. They offer you several options for the next time you spend personal time together; choose whichever you like best."
                }
                #M9iasbyRU2IDvC9a75HVnT ^"Void (op)(op)(op)" DEF {
                    ^"Effect" STRING "Due to circumstances beyond your control, you and your intended find yourselves unexpectedly aware of one another. Your intended decides what kind of contact it was and how they react, though they will not blame you for anything untoward."
                }
            }
        }

        ^"Spending Opportunity in Espionage" DEF {
            ENTRIES {
                #9ZzV49Xaq2SRfnyEFLMxG8 ^"Air (op)+" DEF {
                    ^"Effect" STRING "Your subtlety lets you step out of sight. Designate a number of Minion NPCs equal to (op) spent this way or a single Adversary NPC with vigilance lower than or equal to (op) spent. Those characters lose sight of you."
                }
                #SDztLdZSNlsuldFGeR3Xvu ^"Earth (op)+" DEF {
                    ^"Effect" STRING "You locate an excellent hiding place, either where no one questions your cover identity or a concealed location no one checks. While hiding there, reduce the TN of checks to avoid notice by (op) spent this way."
                }
                #MxrAfJvksOXAX463EIgpLO ^"Fire (op)(op)(op)" DEF {
                    ^"Effect" STRING "A stray motion catches someone's attention, but unexpectedly they are sympathetic or helpful when they notice you. Who are they, and how do they offer to help?"
                }
                #yV5rEVGC4DJUZ8JqtChtJ1 ^"Water (op)" DEF {
                    ^"Effect" STRING "You observe a clue indicating information about your target might be found elsewhere. The GM reveals another viable avenue for espionage on the same subject, unrelated to your current operation."
                }
                #M2PfHcmVXyt4YuvL1H05f0 ^"Void (op)" DEF {
                    ^"Effect" STRING "Your understanding of stealth clues you in on the possibility that you are not the first spy to pass this way. The GM reveals whether another spy has traversed your location and, if so, what trace they left behind."
                }
            }
        }

    }
}
