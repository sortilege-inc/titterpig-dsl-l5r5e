EXTENSION "L5R5e_Courts_of_Stone" EXTENDS "L5R5e_Core_Character" {
    NAME "Legend of the Five Rings 5th Edition - Courts of Stone: New Player Options"
    VERSION "0.4.3"
    SPEC_VERSION "0.4.1"
    RELEASE_DATE "2026-03-01"

    # Courts of Stone (Chapters 2 and 3): Deer Minor Clan, Shika family,
    # new schools, advantages, disadvantages, heritages, weapons, armor,
    # courtier/shinobi items, techniques (kata, ninjutsu, rituals, shūji),
    # titles, bonds system, and opportunity tables for intrigue games.

    # ===========================
    # DEER MINOR CLAN
    # ===========================

    # source stat block (page 88)
    ^"Deer Minor Clan" DEF {
        EXTENDS #L5R250aB2cD4eF6gH8iJ0k ^"Clan"
        APPLIES TO [^"Samurai"]

        # The Deer seek societal balance. When the Great Clans
        # are equal in power, they strive to outdo each other but
        # do not dare go to war. When the Deer observe that one
        # clan is strong and another weak, they strive to make them
        # equal. They are manipulators working for balance within
        # the Empire. Shika Matchmakers mingle with high society
        # to collect information and guide the courts, while
        # Speardancers carry out secret missions in the shadows.

        PROPERTIES {
            ^"Clan Name" STRING "Deer" FIXED
            ^"Clan Type" STRING "Minor Clan"
            ^"Clan Ring Bonus" DEF { ^"Air" INTEGER 1 }
            ^"Clan Skill Bonus" DEF { ^"Sentiment" INTEGER 1 }
            ^"Clan Status" INTEGER DEFAULT 30
        }

        FAMILIES {
            ^"Shika"
        }

    }


    # ===========================
    # DEER FAMILIES
    # ===========================

    #L5RCS50wX4yZ6aB8cD0eF2g ^"Shika" DEF {
        EXTENDS #L5R251lM3nO5pQ7rS9tU1v ^"Family"
        APPLIES TO [^"Samurai"]

        PROPERTIES {
            ^"Family Name"     STRING "Shika" FIXED
            ^"Clan"            STRING "Deer"
            ^"Ring Increase" DEF { CHOOSE 1 [^"Water", ^"Fire"] INTEGER 1 }
            ^"Skill Increases" DEF {
                ^"Courtesy" INTEGER 1
                ^"Culture" INTEGER 1
            }
            ^"Glory"           INTEGER 35
            ^"Wealth" DEF { ^"Count" INTEGER 5  ^"Type" STRING "koku"  ^"Starting" BOOLEAN true }
        }
    }


    # ===========================
    # NEW SCHOOLS
    # ===========================

    # source (page 89)
    ^"Bayushi Deathdealer" DEF {
        EXTENDS #L5R252wX4yZ6aB8cD0eF2g ^"School"
        APPLIES TO [^"Samurai"]

        # The school of warriors Bayushi founded trains under
        # the principle that it is always better to be underestimated.
        # Its curriculum includes the bow, the sword, and subtler
        # weapons still. Students are always reminded that iaijutsu
        # is merely a tool of power like any other.

        PROPERTIES {
            ^"School Name" STRING "Bayushi Deathdealer" FIXED
            ^"Clan" STRING "Scorpion"
            ^"Roles" LIST ["Bushi", "Shinobi"]
            ^"Ring Increase" DEF {
                ^"Air" INTEGER 1
                ^"Fire" INTEGER 1
            }
            ^"Starting Skills" DEF { CHOOSE 5 [^"Command", ^"Courtesy", ^"Fitness", ^"Martial Arts [Melee]", ^"Martial Arts [Ranged]", ^"Tactics", ^"Sentiment", ^"Skulduggery"] INTEGER 1 }
            ^"Starting Honor" INTEGER DEFAULT 40
            ^"Techniques Available" LIST ["Kata", "Rituals", "Shūji"]
        }


        STARTING_TECHNIQUES {
            KATA CHOOSE 1 [^"Striking as Air", ^"Striking as Fire"]
            SHUJI ^"Assess Strengths"
        }

        SCHOOL_ABILITY "Way of the Scorpion" {
            "When you exploit a target's disadvantage as part of an Initiative check for a duel or an Attack action, you do not need to spend a Void point, and you may reroll additional dice up to your school rank."
        }

        MASTERY_ABILITY ^"Strike First, Strike Last" {
            "When you inflict a critical strike during a duel or skirmish, treat the deadliness of your weapon as increased by the difference between your initiative and your target's initiative (subtracting the lower from the higher)."
        }
        STARTING_OUTFIT [
            "traveling clothes", "ashigaru armor",
            "daishō", "knife",
            "shinobigatana or folding half bow",
            "traveling pack"
        ]

        CURRICULUM {
            RANK 1 {
                SKILL_GROUP "Martial Skills"
                SKILL "Courtesy"
                SKILL "Games"
                SKILL "Skulduggery"
                TECHNIQUE_GROUP "Rank 1 General Kata"
                ^"Deceitful Strike" [ninjutsu]
                ^"Spiteful Loss" [shuji]
            }
            RANK 2 {
                SKILL_GROUP "Social Skills"
                SKILL "Martial Arts [Melee]"
                SKILL "Meditation"
                SKILL "Skulduggery"
                TECHNIQUE_GROUP "Rank 1-2 Air Shūji"
                ^"Deadly Sting" [ninjutsu]
                ^"Iaijutsu Cut: Rising Blade" [kata]
            }
            RANK 3 {
                SKILL_GROUP "Martial Skills"
                SKILL "Courtesy"
                SKILL "Smithing"
                SKILL "Survival"
                TECHNIQUE_GROUP "Rank 1-3 Close Combat Kata"
                ^"Cunning Distraction" [ninjutsu]
                ^"All Shall Fear Me" [shuji]
            }
            RANK 4 {
                SKILL_GROUP "Scholar Skills"
                SKILL "Command"
                SKILL "Games"
                SKILL "Tactics"
                TECHNIQUE_GROUP "Rank 1-4 Ranged Kata"
                ^"A Samurai's Fate" [shuji]
                ^"Rallying Cry" [shuji]
            }
            RANK 5 {
                SKILL_GROUP "Social Skills"
                SKILL "Martial Arts [Melee]"
                SKILL "Martial Arts [Ranged]"
                SKILL "Tactics"
                TECHNIQUE_GROUP "Rank 1-5 Kata"
                ^"Stillness of Death" [ninjutsu]
                ^"Hidden in Smoke" [shuji]
            }
            RANK 6 {
                ^"Strike First, Strike Last"
            }
        }

    }

    # source stat block (page 90)
    ^"Daidoji Spymaster" DEF {
        EXTENDS #L5R252wX4yZ6aB8cD0eF2g ^"School"
        APPLIES TO [^"Samurai"]

        # Seen as nothing more than simple bureaucrats, clerks,
        # or scribes, the Daidoji Spymasters operate as intelligence-
        # gathering agents who report directly to the Daidoji daimyo.
        # They monitor other clan representatives, infiltrate organizations,
        # kidnap potential threats, and steal private documents.

        PROPERTIES {
            ^"School Name" STRING "Daidoji Spymaster" FIXED
            ^"Clan" STRING "Crane"
            ^"Roles" LIST ["Courtier", "Shinobi"]
            ^"Ring Increase" DEF {
                ^"Air" INTEGER 1
                ^"Earth" INTEGER 1
            }
            ^"Starting Skills" DEF { CHOOSE 5 [^"Command", ^"Courtesy", ^"Culture", ^"Government", ^"Performance", ^"Sentiment", ^"Skulduggery"] INTEGER 1 }
            ^"Starting Honor" INTEGER DEFAULT 35
            ^"Techniques Available" LIST ["Kata", "Rituals", "Shūji"]
        }


        STARTING_TECHNIQUES {
            SHUJI ^"Ancestry Unearthed"
            NINJUTSU CHOOSE 1 [^"Like a Ghost", ^"Skulk"]
            KATA CHOOSE 1 [^"Striking as Air", ^"Striking as Earth"]
        }

        SCHOOL_ABILITY "Incisive Insight" {
            "Once per scene, when making a check for a Scheme action targeting another character, you may receive a number of strife up to your school rank to reduce the TN by that amount (to a minimum of 1)."
        }

        MASTERY_ABILITY ^"Spy Network" {
            "As a downtime activity in any place of human habitation, you may make a TN 4 Skulduggery check to find an agent of the Daidoji spy network. If you succeed, you find this individual among the inhabitants and gain the Ally advantage for them. If you succeed with 2 or more bonus successes, the individual may occupy a low-to-mid-level position in a household or organization of your choosing."
        }
        STARTING_OUTFIT [
            "traveling clothes", "ceremonial clothes",
            "wakizashi", "sokutoki",
            "disguise kit", "opening and closing kit"
        ]

        CURRICULUM {
            RANK 1 {
                SKILL_GROUP "Trade Skills"
                SKILL "Command"
                SKILL "Culture"
                SKILL "Government"
                TECHNIQUE_GROUP "Rank 1 Air Shūji"
                ^"Lady Doji's Decree" [shuji]
                ^"Weight of Duty" [shuji]
            }
            RANK 2 {
                SKILL_GROUP "Scholar Skills"
                SKILL "Courtesy"
                SKILL "Games"
                SKILL "Skulduggery"
                TECHNIQUE_GROUP "Rank 1-2 Earth Shūji"
                ^"What's Yours Is Mine" [ninjutsu]
                ^"Treaty Signing" [ritual]
            }
            RANK 3 {
                SKILL_GROUP "Social Skills"
                SKILL "Culture"
                SKILL "Sentiment"
                SKILL "Martial Arts [Unarmed]"
                TECHNIQUE_GROUP "Rank 1-3 Air Shūji"
                ^"Hidden in Smoke" [shuji]
                ^"Open-Hand Style" [kata]
            }
            RANK 4 {
                SKILL_GROUP "Trade Skills"
                SKILL "Command"
                SKILL "Government"
                SKILL "Tactics"
                TECHNIQUE_GROUP "Rank 1-4 Water Shūji"
                ^"Cunning Distraction" [ninjutsu]
                ^"Wolf's Proposal" [shuji]
            }
            RANK 5 {
                SKILL_GROUP "Scholar Skills"
                SKILL "Command"
                SKILL "Martial Arts [Melee]"
                SKILL "Tactics"
                TECHNIQUE_GROUP "Rank 1-5 Earth Shūji"
                ^"Noxious Cloud" [ninjutsu]
                ^"Bend with the Storm" [shuji]
            }
            RANK 6 {
                ^"Spy Network"
            }
        }

    }

    # source stat block (page 91)
    ^"Doji Bureaucrat" DEF {
        EXTENDS #L5R252wX4yZ6aB8cD0eF2g ^"School"
        APPLIES TO [^"Samurai"]

        # Formidable negotiators and researchers capable of
        # understanding complex systems of commerce, bureaucracy,
        # and esoteric laws. Their familiarity with Rokugani law allows
        # them to navigate the Imperial Court while turning the
        # intricacies of the law against their rivals.

        PROPERTIES {
            ^"School Name" STRING "Doji Bureaucrat" FIXED
            ^"Clan" STRING "Crane"
            ^"Roles" LIST ["Courtier"]
            ^"Ring Increase" DEF {
                ^"Earth" INTEGER 1
                ^"Water" INTEGER 1
            }
            ^"Starting Skills" DEF { CHOOSE 5 [^"Command", ^"Composition", ^"Courtesy", ^"Culture", ^"Games", ^"Government", ^"Meditation"] INTEGER 1 }
            ^"Starting Honor" INTEGER DEFAULT 55
            ^"Techniques Available" LIST ["Rituals", "Shūji"]
        }


        STARTING_TECHNIQUES {
            SHUJI ^"Courtier's Resolve"
            SHUJI ^"Stonewall Tactics"
        }

        SCHOOL_ABILITY "Procedure and Protocol" {
            "When you cause a character to receive strife as a result of a check using a social approach, that character suffers additional strife equal to your school rank."
        }

        MASTERY_ABILITY ^"Post Facto" {
            "Once per game session as a Scheme and Support action, you may make a TN 3 Government (Earth) check. If you succeed, you reveal a huge legal loophole or arcane precedent that legally justifies the actions of you and your allies during the scene. Others can refuse to accept your logic, but must forfeit honor equal to your ranks in Government plus your bonus successes to do so."
        }
        STARTING_OUTFIT [
            "ceremonial clothing", "wakizashi",
            "legal primer", "blank forms",
            "calligraphy kit",
            "scroll designating the bearer as an individual of decidedly moderate authority"
        ]

        CURRICULUM {
            RANK 1 {
                SKILL_GROUP "Scholar Skills"
                SKILL "Commerce"
                SKILL "Composition"
                SKILL "Courtesy"
                TECHNIQUE_GROUP "Rank 1 Earth Shūji"
                ^"Treaty Signing" [ritual]
                ^"Beware the Smallest Mouse" [shuji]
            }
            RANK 2 {
                SKILL_GROUP "Trade Skills"
                SKILL "Courtesy"
                SKILL "Games"
                SKILL "Government"
                TECHNIQUE_GROUP "Rank 1-2 Water Shūji"
                ^"The Wind Blows Both Ways" [shuji]
                ^"Unyielding Terms" [shuji]
            }
            RANK 3 {
                SKILL_GROUP "Social Skills"
                SKILL "Commerce"
                SKILL "Culture"
                SKILL "Sentiment"
                TECHNIQUE_GROUP "Rank 1-3 Air Shūji"
                ^"Hidden in Smoke" [shuji]
                ^"All Shall Fear Me" [shuji]
            }
            RANK 4 {
                SKILL_GROUP "Scholar Skills"
                SKILL "Command"
                SKILL "Meditation"
                SKILL "Tactics"
                TECHNIQUE_GROUP "Rank 1-4 Rituals"
                ^"The Immovable Hand of Peace" [shuji]
                ^"Rallying Cry" [shuji]
            }
            RANK 5 {
                SKILL_GROUP "Trade Skills"
                SKILL "Command"
                SKILL "Performance"
                SKILL "Tactics"
                TECHNIQUE_GROUP "Rank 1-5 Void Shūji"
                ^"Bend with the Storm" [shuji]
                ^"Formal Tea Ceremony" [ritual]
            }
            RANK 6 {
                ^"Post Facto"
            }
        }

    }

    # source stat block (page 92)
    ^"Ikoma Shadow" DEF {
        EXTENDS #L5R252wX4yZ6aB8cD0eF2g ^"School"
        APPLIES TO [^"Samurai"]

        # The Lion Clan's Ikoma family trains a small number of
        # students in stealth, political subterfuge, and even battlefield
        # sabotage. These Ikoma Shadows infiltrate enemy camps in
        # wartime and enemy castles in peacetime, stealing or altering
        # messages and inflaming tensions between other clans.

        PROPERTIES {
            ^"School Name" STRING "Ikoma Shadow" FIXED
            ^"Clan" STRING "Lion"
            ^"Roles" LIST ["Courtier", "Shinobi"]
            ^"Ring Increase" DEF {
                ^"Air" INTEGER 1
                ^"Fire" INTEGER 1
            }
            ^"Starting Skills" DEF { CHOOSE 5 [^"Courtesy", ^"Culture", ^"Government", ^"Martial Arts [Melee]", ^"Martial Arts [Ranged]", ^"Skulduggery", ^"Survival"] INTEGER 1 }
            ^"Starting Honor" INTEGER DEFAULT 40
            ^"Techniques Available" LIST ["Kata", "Rituals", "Shūji"]
        }


        STARTING_TECHNIQUES {
            SHUJI ^"Whispers of Court"
            NINJUTSU ^"Skulk"
            KATA CHOOSE 1 [^"Hawk's Precision", ^"Warrior's Resolve"]
        }

        SCHOOL_ABILITY "Victory before Honor" {
            "Once per scene when performing a check, you may stake an amount of honor no greater than your school rank to re-roll a number of dice equal to twice the amount of honor staked. For each re-rolled die result that does not contain a (su) or (ex), you forfeit one staked honor."
        }

        MASTERY_ABILITY ^"Victory Is the Greatest Honor" {
            "Once per session after failing a Martial or Social check, you may stake up to your school rank in honor to try again, adding bonus successes equal to the honor staked. If you fail, you forfeit all honor staked. If you succeed, you instead gain 1 honor and 1 glory."
        }
        STARTING_OUTFIT [
            "ashigaru armor or ceremonial clothes",
            "daishō or wakizashi and kamayari", "yumi",
            "any one musical instrument or book of poetry",
            "traveling pack"
        ]

        CURRICULUM {
            RANK 1 {
                SKILL_GROUP "Martial Skills"
                SKILL "Performance"
                SKILL "Skulduggery"
                SKILL "Survival"
                TECHNIQUE_GROUP "Rank 1 General Kata"
                ^"What's Yours Is Mine" [ninjutsu]
                ^"Rustling of Leaves" [shuji]
            }
            RANK 2 {
                SKILL_GROUP "Social Skills"
                SKILL "Martial Arts [Unarmed]"
                SKILL "Sentiment"
                SKILL "Skulduggery"
                TECHNIQUE_GROUP "Rank 1-2 Fire Shūji"
                ^"Crackling Laughter" [shuji]
                ^"The Wind Blows Both Ways" [shuji]
            }
            RANK 3 {
                SKILL_GROUP "Scholar Skills"
                SKILL "Commerce"
                SKILL "Labor"
                SKILL "Seafaring"
                TECHNIQUE_GROUP "Rank 1-3 Water Shūji"
                ^"Artful Alibi" [ninjutsu]
                ^"All Arts Are One" [shuji]
            }
            RANK 4 {
                SKILL_GROUP "Martial Skills"
                SKILL "Command"
                SKILL "Skulduggery"
                SKILL "Survival"
                TECHNIQUE_GROUP "Rank 1-4 Kata"
                ^"Deceitful Strike" [ninjutsu]
                ^"Bravado" [shuji]
            }
            RANK 5 {
                SKILL_GROUP "Social Skills"
                SKILL "Martial Arts [Ranged]"
                SKILL "Martial Arts [Unarmed]"
                SKILL "Tactics"
                TECHNIQUE_GROUP "Rank 1-5 Air Shūji"
                ^"Silent Elimination" [ninjutsu]
                ^"Pin the Fan" [kata]
            }
            RANK 6 {
                ^"Victory Is the Greatest Honor"
            }
        }

    }

    # source (page 93)
    ^"Mercenary Ninja Training" DEF {
        EXTENDS #L5R252wX4yZ6aB8cD0eF2g ^"School"
        APPLIES TO [^"Samurai"]

        # Without family, honor, or remorse, Mercenary Ninja
        # move without a trace to ply their lethal trade. Consisting
        # of highly skilled commoners and former Great Clan shinobi,
        # they exist as disposable and deniable assets. Daimyo and
        # nobles purchase their loyalty to kill and steal with
        # ruthless efficiency. No formal schools exist for such
        # lawless individuals.

        PROPERTIES {
            ^"School Name" STRING "Mercenary Ninja Training" FIXED
            ^"Roles" LIST ["Shinobi"]
            ^"Ring Increase" DEF {
                ^"Air" INTEGER 1
                CHOOSE 1 [^"Earth", ^"Fire", ^"Water", ^"Void"] INTEGER 1
            }
            ^"Starting Skills" DEF { CHOOSE 5 [^"Fitness", ^"Martial Arts [Melee]", ^"Martial Arts [Ranged]", ^"Martial Arts [Unarmed]", ^"Medicine", ^"Skulduggery", ^"Survival"] INTEGER 1 }
            ^"Starting Honor" INTEGER DEFAULT 20
            ^"Techniques Available" LIST ["Kata", "Ninjutsu", "Rituals"]
        }


        STARTING_TECHNIQUES {
            NINJUTSU ^"Skulk"
            SHUJI CHOOSE 1 [^"Cadence", ^"Shallow Waters"]
        }

        SCHOOL_ABILITY "Disciple of Darkness" {
            "When you perform a check to hide, move stealthily, or deceive others as to your true identity, you may suffer a number of strife up to your school rank to choose that many characters targeted by the check. Treat each chosen character's vigilance as 1 lower while resolving the check."
        }

        MASTERY_ABILITY ^"One with the Shadows" {
            "When you perform a Ninjutsu technique, you may add two kept (ring) set to an (op) result to your check. You may do this 3 times per session."
        }
        STARTING_OUTFIT [
            "kusarifundo or tekken", "kama or ninjato",
            "3 shuriken or blowgun", "stealth clothing",
            "peasant clothes", "50 feet of rope",
            "tenugui"
        ]

        CURRICULUM {
            RANK 1 {
                SKILL_GROUP "Martial Skills"
                SKILL "Performance"
                SKILL "Skulduggery"
                SKILL "Survival"
                TECHNIQUE_GROUP "Rank 1 General Kata"
                ^"Beware the Smallest Mouse" [shuji]
                ^"Like a Ghost" [ninjutsu]
            }
            RANK 2 {
                SKILL_GROUP "Trade Skills"
                SKILL "Fitness"
                SKILL "Martial Arts [Melee]"
                SKILL "Martial Arts [Unarmed]"
                TECHNIQUE_GROUP "Rank 1-2 Ninjutsu"
                ^"Silent Elimination" [ninjutsu]
                ^"Veiled Menace Style" [kata]
            }
            RANK 3 {
                SKILL_GROUP "Social Skills"
                SKILL "Martial Arts [Ranged]"
                SKILL "Medicine"
                SKILL "Smithing"
                TECHNIQUE_GROUP "Rank 1-3 Ranged Kata"
                ^"Feigned Opening" [shuji]
                ^"Slicing Wind Kick" [ninjutsu]
            }
            RANK 4 {
                SKILL_GROUP "Martial Skills"
                SKILL_GROUP "Scholar Skills"
                SKILL "Seafaring"
                SKILL "Skulduggery"
                ^"Hidden in Smoke" [shuji]
                ^"Breath of Wind Style" [kata]
                ^"Silencing Stroke" [ninjutsu]
            }
            RANK 5 {
                SKILL_GROUP "Trade Skills"
                SKILL "Meditation"
                SKILL "Tactics"
                SKILL "Theology"
                TECHNIQUE_GROUP "Rank 1-5 Ninjutsu"
                ^"Foreseen Need" [shuji]
                ^"Striking as Void" [kata]
            }
            RANK 6 {
                ^"One with the Shadows"
            }
        }

    }

    # source (page 94)
    ^"Shiba Artist" DEF {
        EXTENDS #L5R252wX4yZ6aB8cD0eF2g ^"School"
        APPLIES TO [^"Samurai"]

        # Renowned throughout Rokugan for their deeply spiritual
        # works of art, the Phoenix Clan's Shiba Artists are highly
        # sought after for festivals and special events. They always
        # make the act of creation a part of the work itself.

        PROPERTIES {
            ^"School Name" STRING "Shiba Artist" FIXED
            ^"Clan" STRING "Phoenix"
            ^"Roles" LIST ["Artisan"]
            ^"Ring Increase" DEF {
                ^"Fire" INTEGER 1
                ^"Void" INTEGER 1
            }
            ^"Starting Skills" DEF { CHOOSE 5 [^"Aesthetics", ^"Composition", ^"Courtesy", ^"Culture", ^"Design", ^"Performance", ^"Smithing"] INTEGER 1 }
            ^"Starting Honor" INTEGER DEFAULT 50
            ^"Techniques Available" LIST ["Kata", "Rituals", "Shūji"]
        }


        STARTING_TECHNIQUES {
            RITUAL ^"Tea Ceremony"
            SHUJI CHOOSE 2 [^"Assess Strengths", ^"Courtier's Resolve", ^"Fun and Games"]
        }

        SCHOOL_ABILITY "Architect of Tranquility" {
            "Once per scene after you succeed at an Artisan skill check, you may choose a number of characters in the scene equal to your school rank. Each chosen character removes 3 strife."
        }

        MASTERY_ABILITY ^"Sudden Clarity" {
            "When you use your school ability, you may remove one or more of the following conditions from each chosen character: Dazed, Disoriented, Enraged, Exhausted, Intoxicated. Additionally, each chosen character removes 3 fatigue."
        }
        STARTING_OUTFIT [
            "ceremonial clothes", "common clothes",
            "traveling clothes", "wakizashi",
            "traveling pack", "calligraphy set"
        ]

        CURRICULUM {
            RANK 1 {
                SKILL_GROUP "Artisan Skills"
                SKILL "Courtesy"
                SKILL "Culture"
                SKILL "Performance"
                TECHNIQUE_GROUP "Rank 1 Fire Shūji"
                ^"Offend the Sensibilities" [shuji]
                ^"Fun and Games" [shuji]
            }
            RANK 2 {
                SKILL_GROUP "Social Skills"
                SKILL "Aesthetics"
                SKILL "Government"
                SKILL "Meditation"
                TECHNIQUE_GROUP "Rank 1-2 Air Shūji"
                ^"The Wind Blows Both Ways" [shuji]
                ^"Civility Foremost" [shuji]
            }
            RANK 3 {
                SKILL_GROUP "Artisan Skills"
                SKILL "Command"
                SKILL "Government"
                SKILL "Meditation"
                TECHNIQUE_GROUP "Rank 1-3 Water Shūji"
                ^"Formal Tea Ceremony" [ritual]
                ^"All Arts Are One" [shuji]
            }
            RANK 4 {
                SKILL_GROUP "Scholar Skills"
                SKILL "Performance"
                SKILL "Composition"
                SKILL "Smithing"
                TECHNIQUE_GROUP "Rank 1-4 Void Shūji"
                ^"Rouse the Soul" [shuji]
                ^"Hidden in Smoke" [shuji]
            }
            RANK 5 {
                SKILL_GROUP "Artisan Skills"
                SKILL "Culture"
                SKILL "Courtesy"
                SKILL "Performance"
                TECHNIQUE_GROUP "Rank 1-5 Rituals"
                ^"Bend with the Storm" [shuji]
                ^"Buoyant Arrival" [shuji]
            }
            RANK 6 {
                ^"Sudden Clarity"
            }
        }

    }

    # source stat block (page 95)
    ^"Shika Matchmaker" DEF {
        EXTENDS #L5R252wX4yZ6aB8cD0eF2g ^"School"
        APPLIES TO [^"Samurai"]

        # Shika Matchmakers are shugenja guided by Musubi, the
        # secretive Fortune who binds together the fates of people.
        # Their greatest power is their ability to see the bonds people
        # form. A practitioner of Musubu can sense the future results
        # of fortuitous or inopportune matches.

        PROPERTIES {
            ^"School Name" STRING "Shika Matchmaker" FIXED
            ^"Clan" STRING "Deer"
            ^"Roles" LIST ["Courtier", "Shugenja"]
            ^"Ring Increase" DEF {
                ^"Air" INTEGER 1
                ^"Water" INTEGER 1
            }
            ^"Starting Skills" DEF { CHOOSE 3 [^"Composition", ^"Courtesy", ^"Culture", ^"Meditation", ^"Sentiment", ^"Theology"] INTEGER 1 }
            ^"Starting Honor" INTEGER DEFAULT 50
            ^"Techniques Available" LIST ["Air and Water Invocations", "Rituals", "Shūji"]
        }


        STARTING_TECHNIQUES {
            RITUAL ^"The Ties that Bind"
            INVOCATION ^"Yari of Air"
            INVOCATION CHOOSE 2 [^"Blessed Wind", ^"Path to Inner Peace", ^"Sympathetic Energies", ^"Tempest of Air"]
        }

        SCHOOL_ABILITY "Gift of Musubi-no-Kami" {
