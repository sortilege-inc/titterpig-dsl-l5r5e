    # ===========================
    # SHINOBI ARMOR
    # ===========================

    # source (page 112)
    ^"Courts of Stone Armor" DEF {
        APPLIES TO [^"Samurai"]

        ENTRIES {
            #mDPBX8LKxLuqpPlSu3yS7p ^"Firefighter's Coat" DEF {
                ^"Physical Resistance" INTEGER 2
                ^"Qualities" LIST OF STRING ["Cumbersome"]
                ^"Rarity" INTEGER 4
                ^"Cost" STRING "6 bu"
                ^"Special" STRING "Ignores effects of Dangerous terrain created by fire. Treats resistance against flames (physical and supernatural) as 4."
            }

            #kYdNFF6JWlbdz6OWyjfWsn ^"Stealth Clothing" DEF {
                ^"Physical Resistance" INTEGER 2
                ^"Qualities" LIST OF STRING ["Forbidden", "Subtle"]
                ^"Rarity" INTEGER 7
                ^"Cost" STRING "4 bu"
                ^"Special" STRING "Reversible (dark/bright sides). While in Obscuring terrain with appropriate side shown, increase TN of Attack checks targeting you by additional 1 (total +2)."
            }
        }

    }

    # ===========================
    # TITLES
    # ===========================

    # source (pages 128-131)
    ^"Courts of Stone Titles" DEF {
        APPLIES TO [^"Samurai"]

        ENTRIES {
            #DawvxEXxNiCBGui2ksMDK1 ^"Castellan" DEF {
                ^"Assigned By" STRING "A daimyo after putting the character in charge of a castle's day-to-day management"
                ^"Status Award" STRING "+5 (to a maximum of 30)"
                ^"Glory Award" STRING "+10 (to a maximum of 60)"
                ^"XP to Completion" INTEGER 20
                ^"Title Ability" STRING "Every Stone Has its Place"
                ^"Title Ability Effect" STRING "When undertaking a downtime activity to prepare your castle for an important event (a wedding, battle, or Winter Court), you may change all rolled blank results to (op) results."
                ^"Advancement" LIST OF STRING [
                    "Social Skills (Skill Group)",
                    "Culture (Skill)",
                    "Design (Skill)",
                    "Government (Skill)",
                    "Rallying Cry (shuji)",
                    "Slippery Maneuvers (shuji)",
                    "Touchstone of Courage (shuji)"
                ]
            }

            #CBDhjhaznK7lXRdzIcciJP ^"Covert Agent" DEF {
                ^"Assigned By" STRING "Any individual who gives the character a task requiring them to act against their sworn lord's interests"
                ^"Honor Award" STRING "-10 (to a minimum of 25)"
                ^"XP to Completion" INTEGER 20
                ^"Immediate Effects" STRING "Gain the Dark Secret disadvantage"
                ^"Title Ability" STRING "Practiced Prevaricator"
                ^"Title Ability Effect" STRING "When you make a check to deceive or hide from someone, you may negate up to 2 (st) symbols."
                ^"Advancement" LIST OF STRING [
                    "Social Skills (Skill Group)",
                    "Meditation (Skill)",
                    "Artful Alibi (ninjutsu)",
                    "Cadence (shuji)",
                    "Cunning Distraction (ninjutsu)",
                    "To Float or Sink (ninjutsu)",
                    "What's Yours Is Mine (ninjutsu)"
                ]
            }

            #8sOSwOmuEMswK9LG6H3d9g ^"Dreaded Enforcer" DEF {
                ^"Assigned By" STRING "A lord after assigning the character to assassinate or remove someone of Status 60 or higher, and the character succeeds"
                ^"Honor Award" STRING "-10 (to a minimum of 5)"
                ^"Glory Award" STRING "-20 (to a minimum of 15)"
                ^"XP to Completion" INTEGER 40
                ^"Immediate Effects" STRING "Gain the Whispers of Cruelty disadvantage"
                ^"Title Ability" STRING "Merciless Eyes"
                ^"Title Ability Effect" STRING "When making a check to plan an assassination or attack with lethal intent, you may negate up to 2 (st) symbols."
                ^"Advancement" LIST OF STRING [
                    "Martial Skills (Skill Group)",
                    "Medicine (Skill)",
                    "Skulduggery (Skill)",
                    "Deceitful Strike (ninjutsu)",
                    "Like a Ghost (ninjutsu)",
                    "Silent Elimination (ninjutsu)",
                    "The Stillness of Death (ninjutsu)"
                ]
            }

            #DDyXqicBB916vL8qoiBdWc ^"Esteemed Negotiator" DEF {
                ^"Assigned By" STRING "A daimyo or individual of status 50 or higher who requests the character as a mediator"
                ^"Glory Award" STRING "+10 (to a minimum of 65)"
                ^"XP to Completion" INTEGER 34
                ^"Title Ability" STRING "Calming Words"
                ^"Title Ability Effect" STRING "Once per scene, as a Scheme and Support action, you may reduce the strife of all characters in the scene by your ranks in Sentiment."
                ^"Advancement" LIST OF STRING [
                    "Social Skills (Skill Group)",
                    "Culture (Skill)",
                    "Government (Skill)",
                    "Sentiment (Skill)",
                    "Rank 1-3 Earth Shūji (shuji) (Tech Group)",
                    "The Ties that Bind (ritual)",
                    "Treaty Signing (ritual)"
                ]
            }

            #t3wbGE4jkSR9YWSCAjhyRk ^"Kenshinzen" DEF {
                ^"Assigned By" STRING "Two existing kenshinzen, after witnessing the character defeating a kenshinzen in a duel. Character must have honor 65 or higher."
                ^"Glory Award" STRING "+20 (to a maximum of 75)"
                ^"XP to Completion" INTEGER 24
                ^"Title Ability" STRING "A Single Moment"
                ^"Title Ability Effect" STRING "When you perform an Attack action that uses a sheathed Razor-Edged weapon, you may spend (op): Void (op)(op): Your target cannot defend against the damage unless they spend a Void point. Any (op): After resolving, you may sheathe the weapon you used."
                ^"Advancement" LIST OF STRING [
                    "Martial Skills (Skill Group)",
                    "Social Skills (Skill Group)",
                    "Culture (Skill)",
                    "Sentiment (Skill)",
                    "Rank 1-5 Close Combat Kata (kata) (Tech Group)",
                    "Rank 1-5 Void Shūji (shuji) (Tech Group)",
                    "Tea Ceremony (ritual)"
                ]
            }

            #dQYSnpCr8xbSZ4JVeGPx9o ^"Kyuden Asako Shieldbearer" DEF {
                ^"Assigned By" STRING "The commander of the Kyuden Asako Shieldbearers when the character joins their ranks"
                ^"Glory Award" STRING "+5 (to a maximum of 55)"
                ^"XP to Completion" INTEGER 40
                ^"Title Ability" STRING "Time-Tested Defense"
                ^"Title Ability Effect" STRING "After an Attack action check targeting you fails, the attacker suffers strife equal to their shortfall."
                ^"Advancement" LIST OF STRING [
                    "Scholar Skills (Skill Group)",
                    "Martial Arts [Melee] (Skill)",
                    "Martial Arts [Ranged] (Skill)",
                    "Meditation (Skill)",
                    "Tactics (Skill)",
                    "Rank 1-3 Kata (kata) (Tech Group)",
                    "Cleansing Rite (ritual)"
                ]
                ^"Special Equipment" STRING "Small Bronze Shield: Range 0, Damage 2, Deadliness 2, Cumbersome, Durable, Wargear. When readied, treat physical resistance as 5. As Movement and Support action, increase TN of Attack checks targeting you by 1 until start of next turn."
            }

            #vjy7ijED6zppsSOtQ77hAX ^"Master Artisan" DEF {
                ^"Assigned By" STRING "Someone of status 75 or higher after the character performs a great artistic feat"
                ^"Glory Award" STRING "+30 (to a maximum of 80)"
                ^"XP to Completion" INTEGER 60
                ^"Title Ability" STRING "Inspired Creations"
                ^"Title Ability Effect" STRING "When crafting an item, you may spend (op)(op)(op): The item is a singular masterwork. You must name it. Once per game session when making a check using the item, a character may add 1 (ring) set to any result of their choice."
                ^"Advancement" LIST OF STRING [
                    "Artisan Skills (Skill Group)",
                    "Courtesy (Skill)",
                    "Culture (Skill)",
                    "Medicine (Skill)",
                    "Meditation (Skill)",
                    "All Arts Are One (shuji)",
                    "Formal Tea Ceremony (ritual)"
                ]
            }

            #TOKFE9W2BTylk2hb5BnXGG ^"Winter Court Champion" DEF {
                ^"Assigned By" STRING "The Emperor or one of their chosen agents after the character wins a major contest at Winter Court"
                ^"Glory Award" STRING "+20 (to a maximum of 75)"
                ^"XP to Completion" INTEGER 16
                ^"Title Ability" STRING "Accustomed to Attention"
                ^"Title Ability Effect" STRING "When making a check to boast or get people's attention, you may negate up to 2 (st) symbols."
                ^"Advancement" LIST OF STRING [
                    "Artisan Skills (Skill Group)",
                    "Social Skills (Skill Group)",
                    "Artisan's Appraisal (shuji)",
                    "Formal Tea Ceremony (ritual)",
                    "Fun and Games (shuji)",
                    "Offend the Sensibilities (shuji)",
                    "Spiteful Loss (shuji)"
                ]
            }

            #fJH7BSJaKZ5fLr9ck6g6lZ ^"Seven Fold Palace Acolyte" DEF {
                ^"Assigned By" STRING "One of the masters of the Seven Fold Palace after the character begins studying there"
                ^"Glory Award" STRING "+5 (to a maximum of 35)"
                ^"XP to Completion" INTEGER 36
                ^"Title Ability" STRING "First, Forge Yourself"
                ^"Title Ability Effect" STRING "When you make a check to craft an item, you may suffer a number of fatigue up to your ranks in Fitness. If you do, change that many results containing (su) to (op) results."
                ^"Advancement" LIST OF STRING [
                    "Trade Skills (Skill Group)",
                    "Aesthetics (Skill)",
                    "Design (Skill)",
                    "Fitness (Skill)",
                    "Meditation (Skill)",
                    "Smithing (Skill)",
                    "Artisan's Appraisal (shuji)"
                ]
            }
        }

    }

    # ===========================
    # BONDS SYSTEM
    # ===========================

    # source stat block (page 136)
    ^"Bonds" DEF {
        APPLIES TO [^"Samurai"]

        # Bonds are a new way to spend experience points,
        # reflecting the deepening of connection between two
        # people. Experience spent on bonds does not contribute
        # toward school curriculum rank or a title.

        ^"Bond Ranks" DEF {
            #KgV28EwqbZziQ2ezCuwzKw ^"Rank 1" DEF {
                ^"XP Cost" INTEGER 3
                ^"Ability" STRING "Bond Ability (varies by bond type) plus narrative benefits"
            }
            #86bc7rOp4Hsxum2LSQmPRH ^"Rank 2" DEF {
                ^"XP Cost" INTEGER 4
                ^"Ability" STRING "Like you always say...: Count as having bonded character's assistance on a check in which they are skilled."
            }
            #s60bDXkUVDiRYDGpz1xmeR ^"Rank 3" DEF {
                ^"XP Cost" INTEGER 6
                ^"Ability" STRING "A familiar presence draws near...: If NPC, you may play them for the next scene. If PC, play out an establishing flashback."
            }
            #8Ec837SvJiZLGf7kOMhzEe ^"Rank 4" DEF {
                ^"XP Cost" INTEGER 8
                ^"Ability" STRING "You taught me this!: Use one bonded character's ring or skill ranks for a check instead of your own."
            }
            #oh9dnDABvhws0Hrudx71QI ^"Rank 5" DEF {
                ^"XP Cost" INTEGER 10
                ^"Ability" STRING "We are bound by this fate we have made!: Transfer one Void point to bonded character or gain 1 Void point after they spend one."
            }
        }

        ^"Bond Types" DEF {
            #9PP21MdWLqSF9tvp643qrF ^"Family Bond" DEF {
                ^"Bond Ability" STRING "Strong Roots Grow Deep: Once per scene, call upon bond to treat composure as increased by bond rank until end of scene."
            }
            #pGmfk7Wq12xvwBDPCNS4Qx ^"Comrade Bond" DEF {
                ^"Bond Ability" STRING "Just Like Old Times: When performing a check using a skill the bonded character has ranks in, call upon bond to negate a number of (st) results up to bond rank."
            }
            #CyrnYiMyZEIYWW6UWAi5LT ^"Lover Bond" DEF {
                ^"Bond Ability" STRING "With You, the Storm Subsides: At end of scene involving lover or reminders of them, call upon bond to remove additional strife equal to bond rank."
            }
            #s3Bhe9EFP9q6w3CdJgQhax ^"Rival Bond" DEF {
                ^"Bond Ability" STRING "I Will Surpass You!: While making a check, call upon bond. Receive strife equal to bond rank; reroll up to that many dice."
            }
            #gfGIkdiwrUZkyK9c6dnqWj ^"Nemesis Bond" DEF {
                ^"Bond Ability" STRING "They Were Responsible!: Call upon bond to determine if nemesis was involved in a situation. GM provides clear answer. If confirmed, reduce TN of next check to address the problem by bond rank."
            }
        }

    }

    # ===========================
    # NEW SAMURAI HERITAGES
    # ===========================

    # source (page 104)
    ^"Courts of Stone Heritages" DEF {
        APPLIES TO [^"Samurai"]

        # Table 2-1: New Samurai Heritages (page 104).
        # New heritages for samurai with ancestral connections
        # to the Crane Clan or the mysterious underworld of the
        # shinobi. Used instead of Table 2-1 in the core rulebook.

        HERITAGE_TABLE {

            1 #v4pzleB1tNtdgU1XO9iCEx ^"Dishonorable Cheat" DEF {
                # One of your kin was caught cheating in a high-profile
                # duel. Instead of committing seppuku to purge their
                # dishonor and redeem their family, they ran away and
                # became a rōnin, disgracing their bloodline.

                MODIFIERS {
                    ^"Glory" "-5"
                }

                # Sub-table (roll 1d10): a skill to aid you in bringing
                # your disgraced kin to justice.
                SUB_TABLE "1d10" {
                    "1-3" "Gain +1 ^\"Martial Arts [Choose One]\""
                    "4-6" "Gain +1 ^\"Survival\""
                    "7-10" "Gain +1 ^\"Government\""
                }
            }

            2-3 #s0sUwIEvvlrRubJEwMn8PO ^"Triumph over the Lion" DEF {
                # In your family line one of your ancestors held a decisive
                # victory over the Lion. It may have been a duel, a critical
                # game of Go, a battle, or any number of things. The
                # circumstances are irrelevant; the Lion were embarrassed,
                # and your ancestor brought honor to your clan.

                MODIFIERS {
                    ^"Honor" "+5"
                }

                # Sub-table (roll 1d10): the family heirloom added to your
                # starting items. You choose one quality and the GM chooses
                # one quality from the item qualities list (core rulebook
                # page 240); both are applied to the item.
                SUB_TABLE "1d10" {
                    "1-3" "A weapon"
                    "4-6" "A game set of your choice"
                    "7-8" "Some other item relevant to your ancestor's victory"
                    "9" "A horse or another animal"
                    "10" "The deed to a small piece of land on the border of Lion territory"
                }
            }

            4-5 #f4DhOygATi36KX70HPMmnW ^"Unforgivable Performance" DEF {
                # In the recent past one of your kin gave a truly horrible
                # performance in the presence of the Imperial line. Through
                # their embarrassing acting in a scene they caused the
                # Emperor to leave the theatre, and now rumors abound of
                # your family being cursed by the Fortunes for such a failure.

                MODIFIERS {
                    ^"Status" "-3"
                }

                EFFECT {
                    "Gain the ^\"Benten's Curse (Air)\" disadvantage (core rulebook page 116)"
                }

                # Sub-table (roll 1d10): a skill that will help redeem your family.
                SUB_TABLE "1d10" {
                    "1-3" "Gain +1 ^\"Performance\""
                    "4-6" "Gain +1 ^\"Culture\""
                    "7-9" "Gain +1 ^\"Command\""
                    "10" "Gain +1 ^\"Courtesy\""
                }
            }

            6-7 #IE4tFxWFofbGuImnBkFxlI ^"Triumph During Gempuku" DEF {
                # One of your parents was a Topaz Champion and brought
                # honor to your clan and your family.

                MODIFIERS {
                    ^"Honor" "+3"
                    ^"Glory" "+3"
                }

                EFFECT {
                    "Gain the ^\"Support of the Kakita Dueling Academy\" distinction, where the Topaz Championship takes place"
                }
            }

            8-9 #vzCnLJmsIrSOsRx7N3erZs ^"A Little Too Close to Heaven" DEF {
                # One of your ancestors is rumored to have had an
                # illegitimate child with an Emperor. While you may be able
                # to link your heritage to the Imperial line, the disgrace
                # of such an affair stains this joy.

                MODIFIERS {
                    ^"Status" "+5"
                    ^"Honor" "-5"
                }

                # Sub-table (roll 1d10): a skill that can aid you in
                # discovering the truth about your lineage.
                SUB_TABLE "1d10" {
                    "1-2" "Gain +1 ^\"Government\""
                    "3-4" "Gain +1 ^\"Commerce\""
                    "5-6" "Gain +1 ^\"Sentiment\""
                    "7-8" "Gain +1 ^\"Meditation\""
                    "9-10" "Gain +1 ^\"Theology\""
                }
            }

            10 #GJzMXJAC0TdPMBdtGDaT4e ^"Elegant Craftsman" DEF {
                # Your ancestor was a truly gifted artisan and produced in
                # their lifetime a masterwork that is still renowned today.
                # You now live in the shadow of this ancestor, and your clan
                # expects your complete focus in bringing glory to your line
                # once again.

                MODIFIERS {
                    ^"Glory" "+5"
                }

                EFFECT {
                    "Gain the ^\"Isolation\" anxiety (page 103)"
                    "Choose one of your character's rings; you may reduce the value of this ring by 1 to increase the value of your Fire or Air Ring by 1 (this still cannot raise it above 3)"
                }
            }
        }
    }

