    ^"Affect of Harmlessness" DEF {
        EXTENDS #L5R266oP8qR0sT2uV4wX6y ^"Distinction"

        PROPERTIES {
            ^"Ring" STRING "Air"
            ^"Types" LIST ["Interpersonal"]
        }

        EFFECT {
            "You project an air of harmlessness that puts strangers at ease."
            "When performing a check to ingratiate yourself with a stranger (such as Courtesy [Air] to be pleasant to someone of higher status or Performance [Air] to conceal your true intentions toward a social equal), you may reroll up to two dice."
        }
    }

    # source stat block (page 99)
    ^"Famously Neutral" DEF {
