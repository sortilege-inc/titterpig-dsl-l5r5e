                ^"Deadliness" INTEGER 4
                ^"Grips" STRING "1-hand: -; 2-hand: Deadliness +1"
                ^"Qualities" LIST OF STRING ["Concealable", "Forbidden", "Razor-Edged"]
                ^"Rarity" INTEGER 7
                ^"Cost" STRING "12 koku"
            }

            #GPtYBNxANRkDYNYi1VaMc1 ^"Shinobigatana" DEF {
