# .codex SECTION — Emerald Empire: Sacred Spaces (Chapter 4 — cosmology, the
# Fortunes, shrines, festivals, and forbidden beliefs). Stand-off graph over
# l5r5e-0.4-emerald-empire-religion.lore (spec §25). Part of the L5R5e system
# graph; DEPENDS_ON the shared schema. Covers the realms of the cosmos (Yomi,
# Senkyō, Yume-dō, Gaki-dō, Tōshigoku), Emma-Ō and the nine Kings of Hell, the
# named Fortunes, the great shrines (Ki-Rin, Benten Seidō, Willow-Healing Kami),
# the festivals, and the malicious Fortunes.

CODEX "L5R5e_Codex_EE_Religion" {
    NAME "Emerald Empire: Sacred Spaces — Lore Graph"
    VERSION "0.1"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-09-02"
    FOR EDITION "l5r5e"
    DEPENDS_ON "L5R5e_Codex_Schema" VERSION "0.9"

    # -- Cosmography: the realms ------------------------------------------------

    ENTITY #L5RcxEErel01yomizzzz ^"Yomi" {
