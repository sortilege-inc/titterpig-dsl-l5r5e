            ^"Composure" INTEGER 16
            ^"Focus" INTEGER 10
            ^"Vigilance" INTEGER 5
            ^"Silhouette" INTEGER 4
            ^"Demeanor" STRING "Detached"
            ^"Social Skill Check TN Modifiers" STRING "Air +1, Void +1, Water -2"
            ^"Skills" LIST OF STRING ["Artisan 3", "Martial 4", "Scholar 4", "Social 3", "Trade 2"]
            ^"Advantages" LIST OF STRING ["Giant's Strength (Earth) [Martial; Physical, Spiritual]", "Impossible Feats (Air) [Martial; Physical, Spiritual]", "Massive Stature (Earth) [Martial; Physical]"]
            ^"Disadvantages" LIST OF STRING ["Prideful and Vengeful (Earth) [Social; Mental]"]
            ^"Favored Weapons" LIST OF STRING ["Massive Fists: Range 0-2, Damage 7, Deadliness 5"]
        }

        ^"Elemental Powers" DEF {
            ^"Description" STRING "A marid is an Otherworldly being of silhouette 4. They can move vertically, and they ignore the negative effects of physical terrain. Additionally, they have a natural physical resistance value equal to the ring of their current stance."
        }

        ^"Incredible Power" DEF {
            ^"Description" STRING "The marid's enemies treat the area within range 0-1 of the marid as Dangerous terrain. The area around the marid at range 0-3 is Imbalanced (Air and Water), the kami are fearful of djinn. Additionally, the marid may attempt any invocation they want. If the marid is bound to another being, that being is immune to this ability's effects."
        }

        ^"Invisibility" DEF {
            ^"Description" STRING "As a Support action, a marid may become invisible and impossible to see, or they may become visible as a giant humanoid made from the element of their current stance."
        }

        RULES {
            #L5RCW31aa524f1512e8e9abb198:imposing_marid
        }
    }

    ^"Jorogumo" DEF {
        APPLIES TO [^"NPC"]

        PROPERTIES {
            ^"Type" STRING "Adversary" FIXED
            ^"Category" STRING "Spirit"
            ^"Combat Conflict Rank" INTEGER 3
            ^"Intrigue Conflict Rank" INTEGER 4
            ^"Description" STRING "Shapeshifting spider spirit capable of weaving complex sensory illusions. Ancestral enemy of kitsune, known for vengefulness and patience."
            ^"Rings" DEF {
                ^"Air" INTEGER 4
                ^"Earth" INTEGER 2
                ^"Fire" INTEGER 3
                ^"Water" INTEGER 3
                ^"Void" INTEGER 1
            }
            ^"Endurance" INTEGER 10
            ^"Composure" INTEGER 10
            ^"Focus" INTEGER 7
            ^"Vigilance" INTEGER 3
            ^"Demeanor" STRING "Shrewd"
            ^"Social Skill Check TN Modifiers" STRING "Air +2, Void -2"
            ^"Skills" LIST OF STRING ["Artisan 3", "Martial 2", "Scholar 3", "Social 1", "Trade 1"]
            ^"Advantages" LIST OF STRING ["Dangerous Allure (Fire) [Social; Interpersonal, Physical]", "Incredible Patience (Air) [Social; Interpersonal]"]
            ^"Disadvantages" LIST OF STRING ["Physically Weak (Fire) [Martial; Physical]"]
            ^"Favored Weapons" LIST OF STRING ["Fangs: Range 0-1, Damage 2, Deadliness 7", "Poison Webs: Range 2-3, Damage 3, Deadliness 5, Concealable, deals supernatural damage"]
        }

        ^"Shapeshifter" DEF {
            ^"Description" STRING "As a Support action, a jorogumo can transform into human or spider form. While in spider form, they are silhouette 0. When they become Compromised in their human form, their long spider legs appear, or their spider fangs protrude from their mouth."
        }

        ^"Illusionary Webs" DEF {
            ^"Description" STRING "As a downtime activity, the jorogumo may weave an illusion out of webs. They may create any scenery they choose, including objects, within range 4 of themself. These illusions are visually and tangibly convincing, even when consumed as food or used as weaponry. They are, however, ultimately fake. Targets may suspect something is not what it seems even if they still believe what their senses tell them. The illusion lasts until it is willingly dropped, or until the jorogumo becomes Compromised. When dropped, the illusions become Entangling and Obscuring terrain. Additionally, the jorogumo knows the invocations False Realm of the Fox Spirits and Vapor of Nightmares."
        }

        RULES {
            #L5RCW322577817dd75a74e2f5cc:jorogumo
        }
    }

    ^"Luusyn Khan" DEF {
        APPLIES TO [^"NPC"]

        PROPERTIES {
            ^"Type" STRING "Adversary" FIXED
            ^"Category" STRING "Spirit"
            ^"Combat Conflict Rank" INTEGER 8
            ^"Intrigue Conflict Rank" INTEGER 6
            ^"Description" STRING "Giant water spirit known as the king of serpents and dragon king, protector of freshwater purity. Resembles an enormous horned serpent with brilliant silver-blue scales."
            ^"Rings" DEF {
                ^"Air" INTEGER 5
                ^"Earth" INTEGER 1
                ^"Fire" INTEGER 1
                ^"Water" INTEGER 6
                ^"Void" INTEGER 4
            }
            ^"Endurance" INTEGER 16
            ^"Composure" INTEGER 12
            ^"Focus" INTEGER 6
            ^"Vigilance" INTEGER 4
            ^"Silhouette" INTEGER 5
            ^"Demeanor" STRING "Aloof"
            ^"Social Skill Check TN Modifiers" STRING "Air +2, Fire -2"
            ^"Skills" LIST OF STRING ["Artisan 2", "Martial 3", "Scholar 2", "Social 3", "Trade 2"]
            ^"Advantages" LIST OF STRING ["Ethereal Form (Air) [Martial, Trade; Physical]", "Terrifying Presence (Void) [Social, Trade; Fame, Mental, Spiritual]"]
            ^"Disadvantages" LIST OF STRING ["Proud (Air) [Social; Infamy, Interpersonal]"]
            ^"Favored Weapons" LIST OF STRING ["Lightning Strikes: Range 1-4, Damage 7, Deadliness 6, Sacred, deals physical or supernatural damage"]
            ^"Gear" LIST OF STRING ["Shrouded by storm clouds (Physical 4, Supernatural 5, Sacred)"]
        }

        ^"Electric Aura" DEF {
            ^"Description" STRING "After performing a successful Attack action check, the luusyn khan may spend :opp: as follows: :opp:: Characters within range 1 of the luusyn khan must make a TN 4 Fitness check (Earth 5, Void 5). If they fail, they gain the Disoriented condition."
        }

        ^"Spirit of Storm and Stream" DEF {
            ^"Description" STRING "A luusyn khan is an Otherworldly being of silhouette 5 that can fly. They can move vertically, and they ignore the negative effects of terrain. Additionally, once per scene, they may perform any Air or Water invocation other than Rise, Air; Even Changing Waves; and Rise, Water. The invocation counts as succeeding with three bonus successes and :opp::opp:."
        }

        RULES {
            #L5RCW337bc2b1a53e9c7547345e:luusyn_khan
        }
    }

    ^"Manticore" DEF {
        APPLIES TO [^"NPC"]

        PROPERTIES {
            ^"Type" STRING "Adversary" FIXED
            ^"Category" STRING "Spirit"
            ^"Combat Conflict Rank" INTEGER 4
            ^"Intrigue Conflict Rank" INTEGER 3
            ^"Description" STRING "Ageless shapeshifting being from Caliphate folklore. Sustains itself on human flesh while delighting in riddles and wordplay."
            ^"Rings" DEF {
                ^"Air" INTEGER 2
                ^"Earth" INTEGER 2
                ^"Fire" INTEGER 3
                ^"Water" INTEGER 3
                ^"Void" INTEGER 1
            }
            ^"Endurance" INTEGER 10
            ^"Composure" INTEGER 10
            ^"Focus" INTEGER 5
            ^"Vigilance" INTEGER 3
            ^"Demeanor" STRING "Ambitious"
            ^"Social Skill Check TN Modifiers" STRING "Fire +2, Void -2"
            ^"Skills" LIST OF STRING ["Artisan 0", "Martial 3", "Scholar 3", "Social 0", "Trade 2"]
            ^"Advantages" LIST OF STRING ["Expert Manipulator (Air) [Social; Interpersonal]", "Silent Stalker (Air) [Martial; Physical]"]
            ^"Disadvantages" LIST OF STRING ["Must Honor All Agreements (Earth) [Martial; Physical]", "Obsessed with Riddles (Air) [Social; Mental]"]
            ^"Favored Weapons" LIST OF STRING ["Claws and Fangs: Range 1, Damage 5, Deadliness 7, Razor-Edged", "Scorpion Sting: Range 0-3, Damage 2, Deadliness 9, Concealable"]
        }

        ^"Monstrous Shapeshifter" DEF {
            ^"Description" STRING "The manticore is an Otherworldly being. As a Support action, they can transform into the form of a human, a giant hunting cat, or a monstrous bird of prey. While in cat form, they have silhouette 3. While in bird form, they have silhouette 2 and can fly. They can use their scorpion tail in any form. When they become Compromised, the manticore is forced into either cat or bird form."
        }

        ^"Terrible Sorceries" DEF {
            ^"Description" STRING "Choose up to three mahō and up to three rituals that the manticore can perform. Add 1 to the manticore's combat conflict rank for each mahō chosen beyond the first."
        }

        RULES {
            #L5RCW34bcfdab33c48da0497444:manticore
        }
    }

    ^"Snow Lion" DEF {
        APPLIES TO [^"NPC"]

        PROPERTIES {
            ^"Type" STRING "Adversary" FIXED
            ^"Category" STRING "Spirit"
            ^"Combat Conflict Rank" INTEGER 6
            ^"Intrigue Conflict Rank" INTEGER 7
            ^"Description" STRING "Mountain spirit with white fur and turquoise mane, leaping from peak to peak. Associated with strength, joy, and playfulness by the Ujik."
            ^"Rings" DEF {
                ^"Air" INTEGER 4
                ^"Earth" INTEGER 6
                ^"Fire" INTEGER 1
                ^"Water" INTEGER 2
                ^"Void" INTEGER 5
            }
            ^"Endurance" INTEGER 8
            ^"Composure" INTEGER 14
            ^"Focus" INTEGER 2
            ^"Vigilance" INTEGER 3
            ^"Silhouette" INTEGER 3
            ^"Demeanor" STRING "Joyful"
            ^"Social Skill Check TN Modifiers" STRING "Water +2, Fire -2"
            ^"Skills" LIST OF STRING ["Artisan 1", "Martial 2", "Scholar 3", "Social 3", "Trade 2"]
            ^"Advantages" LIST OF STRING ["Playfulness (Air) [Social; Fame, Mental, Spiritual]", "Trickster (Air) [Martial, Social, Trade; Interpersonal, Mental]"]
            ^"Disadvantages" LIST OF STRING ["Easily Distracted (Air) [Social; Mental]"]
            ^"Favored Weapons" LIST OF STRING ["Powerful Jaws: Range 0-1, Damage 7, Deadliness 4, Sacred"]
            ^"Gear" LIST OF STRING ["Thick hide (Physical 3, Supernatural 2, Sacred)"]
        }

        ^"Mystical Being" DEF {
            ^"Description" STRING "A snow lion is an Otherworldly being of silhouette 3. While they cannot fly vertically, they still ignore the negative effects of terrain. Additionally, once per scene, they may perform a kihō (holy). The kihō counts as succeeding with three bonus successes and :opp::opp:."
        }

        ^"Roar of Emptiness" DEF {
            ^"Description" STRING "Once per scene, a snow lion may roar. Everyone within range 5 of the snow lion must succeed on a TN 4 Meditation check (Fire 5, Void 3) or gain the Disoriented condition and suffer 3 strife. If they succeed, they remove 3 strife instead."
        }

        RULES {
            #L5RCW35287dc49c001637835611:snow_lion
        }
    }

    ^"Wind Horse" DEF {
        APPLIES TO [^"NPC"]

        PROPERTIES {
            ^"Type" STRING "Adversary" FIXED
            ^"Category" STRING "Spirit"
            ^"Combat Conflict Rank" INTEGER 7
            ^"Intrigue Conflict Rank" INTEGER 1
            ^"Description" STRING "Massive Otherworldly horse equated with the Ujik soul. Its appearance portends good luck in the form of peace, wealth, and harmony."
            ^"Rings" DEF {
                ^"Air" INTEGER 4
                ^"Earth" INTEGER 4
                ^"Fire" INTEGER 6
                ^"Water" INTEGER 2
                ^"Void" INTEGER 2
            }
            ^"Endurance" INTEGER 12
            ^"Composure" INTEGER 4
            ^"Focus" INTEGER 5
            ^"Vigilance" INTEGER 3
            ^"Silhouette" INTEGER 4
            ^"Demeanor" STRING "Temperamental"
            ^"Social Skill Check TN Modifiers" STRING "Fire +2, Air -2"
            ^"Skills" LIST OF STRING ["Artisan 0", "Martial 3", "Scholar 0", "Social 0", "Trade 0"]
            ^"Advantages" LIST OF STRING ["Faster Than Any Mortal Horse (Fire) [Martial; Physical]"]
            ^"Disadvantages" LIST OF STRING ["Untamable (Fire) [Martial, Social; Mental, Spiritual]", "Quick to Anger (Fire) [Social; Interpersonal]"]
            ^"Favored Weapons" LIST OF STRING ["Hooves: Range 1-2, Damage 4, Deadliness 5, Sacred"]
            ^"Gear" LIST OF STRING ["Shrouded by Mist (Physical 3, Supernatural 4, Sacred)"]
        }

        ^"Soul of Wind and Light" DEF {
            ^"Description" STRING "A wind horse is an Otherworldly being of silhouette 4 and can pass through solid objects along with any riders. Additionally, once per scene, they may perform a Fire kihō. The kihō counts as succeeding with three bonus successes and :opp::opp:."
        }

        ^"Spirit of Freedom" DEF {
            ^"Description" STRING "The wind horse can't suffer from the Disoriented or Immobilized condition."
        }

        RULES {
            #L5RCW36fcceb3f6b695383c4a71:wind_horse
        }
    }

    # ===========================
    # NAMED NPCs (CHAPTER 1)
    # ===========================

    ^"Utaku Asagao" DEF {
        APPLIES TO [^"NPC"]

        # Once known by a different name, the shrine keeper Asagao
        # discovered who she truly was when a horse of the Blessed
        # Herd allowed her onto its back during an emergency. Now
        # devoted to Utaku's Shrine, she offers wisdom for anyone
        # who feels lost on their path through life.

        PROPERTIES {
            ^"Type" STRING "Adversary" FIXED
            ^"Combat Conflict Rank" INTEGER 3
            ^"Intrigue Conflict Rank" INTEGER 2
            ^"Description" STRING "Shrine keeper of Utaku Seido with mysterious connection to the Blessed Herd."
            ^"Rings" DEF {
                ^"Air" INTEGER 1
                ^"Earth" INTEGER 3
                ^"Fire" INTEGER 2
                ^"Water" INTEGER 4
                ^"Void" INTEGER 2
            }
            ^"Endurance" INTEGER 10
            ^"Composure" INTEGER 14
            ^"Focus" INTEGER 3
            ^"Vigilance" INTEGER 2
            ^"Honor" INTEGER 66
            ^"Glory" INTEGER 35
            ^"Status" INTEGER 25
            ^"Demeanor" STRING "Detached"
            ^"Social Skill Check TN Modifiers" STRING "Earth +1, Fire +1, Void -2"
            ^"Skills" LIST OF STRING ["Artisan 2", "Martial 3", "Scholar 2", "Social 0", "Trade 0"]
            ^"Advantages" LIST OF STRING ["Affinity with Horses (Void) [Social; Interpersonal]", "Local Folklorist (Earth) [Scholar; Mental]"]
            ^"Disadvantages" LIST OF STRING ["Overprotective (Fire) [Martial; Mental]"]
            ^"Favored Weapons" LIST OF STRING ["Broom (improvised weapon): Treat as bo (staff)"]
            ^"Gear" LIST OF STRING ["Shrine keeper robes (Physical 1, Supernatural 3, Ceremonial)", "Offerings"]
            ^"Companions" LIST OF STRING ["Taiyo (see Utaku warhorse on page 143)"]
        }

        ^"Path to Inner Peace" DEF {
            ^"Description" STRING "Invocation. As a Support action, may make a TN 2 Theology (Water) check targeting a character at range 0-2. If Asagao succeeds, the target removes 3 fatigue, plus 1 per bonus success. A target can be affected by Path to Inner Peace only once per scene."
        }

        RULES {
            #L5RCW37485a96fa3412dc06722c:utaku_asagao
        }
    }

    ^"Iuchi Itsuki" DEF {
        APPLIES TO [^"NPC"]

        # One of a handful of Meishodo Masters entrusted with
        # maintaining the wards and statues that contain the
        # Dreamer's Forest. Tempted by a fox spirit claiming
        # innocence, trapped in one of his talismans.

        PROPERTIES {
            ^"Type" STRING "Adversary" FIXED
            ^"Combat Conflict Rank" INTEGER 5
            ^"Intrigue Conflict Rank" INTEGER 3
            ^"Description" STRING "Meishodo Master maintaining Dreamer's Forest wards. Tempted by a fox spirit claiming innocence."
            ^"Rings" DEF {
                ^"Air" INTEGER 2
                ^"Earth" INTEGER 3
                ^"Fire" INTEGER 2
                ^"Water" INTEGER 4
                ^"Void" INTEGER 3
            }
            ^"Endurance" INTEGER 10
            ^"Composure" INTEGER 14
            ^"Focus" INTEGER 4
            ^"Vigilance" INTEGER 3
            ^"Honor" INTEGER 40
            ^"Glory" INTEGER 40
            ^"Status" INTEGER 30
            ^"Demeanor" STRING "Ambitious"
            ^"Social Skill Check TN Modifiers" STRING "Fire +2, Water -2"
            ^"Skills" LIST OF STRING ["Artisan 2", "Martial 1", "Scholar 2", "Social 4", "Trade 2"]
            ^"Advantages" LIST OF STRING ["Syncretic Philosophy (Water) [Social; Interpersonal]"]
            ^"Disadvantages" LIST OF STRING ["Vain (Void) [Social; Interpersonal, Mental]", "Haunted (Void) [Social; Interpersonal, Spiritual]"]
            ^"Favored Weapons" LIST OF STRING ["Kiseru (smoking pipe): Range 0, Damage 2, Deadliness 2, Concealable, Mundane"]
            ^"Gear" LIST OF STRING ["1 to 4 meishodo talismans (see Abilities)", "Sanctified robes (Physical 1, Supernatural 3, Ceremonial)", "Divination kit", "Medicine kit", "Up to three omamori"]
            ^"Companions" LIST OF STRING ["Natsu (see Iuchi riding steed on page 141)"]
        }

        ^"Deft Negotiator" DEF {
            ^"Description" STRING "During an intrigue or other noncombat scene, when making a Scheme action check, Itsuki may add a kept (ring) set to an (op) result to the check. During otherworldly encounters (see page 125), Itsuki gains this bonus on all actions."
        }

        ^"Meishodo Artist" DEF {
            ^"Description" STRING "Choose up to four invocations of rank 1-3 and one invocation of rank 4-5. Itsuki has meishodo talismans with the chosen invocations bound to them and can activate those invocations using the talismans as described in Iuchi Meishodo Master School in the core rulebook, page 83. You may also choose up to three rituals that Itsuki can perform."
        }

        RULES {
            #L5RCW38a20223c882a9ec1dd1a3:iuchi_itsuki
        }
    }

    ^"Ide Yuto" DEF {
        APPLIES TO [^"NPC"]

        # Wayward slacker son of high-ranking diplomats, Yuto
        # vanished while staying at Far Traveler Castle. He claims
        # he dove into Water Dragon Lake and surfaced in the
        # territory of the Centipede Clan. He has craved adventure
        # ever since.

        PROPERTIES {
            ^"Type" STRING "Adversary" FIXED
            ^"Combat Conflict Rank" INTEGER 1
            ^"Intrigue Conflict Rank" INTEGER 3
            ^"Description" STRING "Adventurous diplomat's son who claims an impossible underwater journey. Craves excitement."
            ^"Rings" DEF {
                ^"Air" INTEGER 2
                ^"Earth" INTEGER 2
                ^"Fire" INTEGER 3
                ^"Water" INTEGER 3
                ^"Void" INTEGER 2
            }
            ^"Endurance" INTEGER 10
            ^"Composure" INTEGER 10
            ^"Focus" INTEGER 5
            ^"Vigilance" INTEGER 2
            ^"Honor" INTEGER 40
            ^"Glory" INTEGER 44
            ^"Status" INTEGER 37
            ^"Demeanor" STRING "Ambitious"
            ^"Social Skill Check TN Modifiers" STRING "Fire +2, Water -2"
            ^"Skills" LIST OF STRING ["Artisan 1", "Martial 0", "Scholar 3", "Social 3", "Trade 2"]
            ^"Advantages" LIST OF STRING ["Tall Tales (Air) [Scholar; Interpersonal]", "Unfettered (Earth) [Social, Trade; Mental]"]
            ^"Disadvantages" LIST OF STRING ["Impetuous Risk-Taker (Fire) [Martial; Mental]"]
            ^"Gear" LIST OF STRING ["Traveling clothes (Physical 2, Durable, Mundane, Subtle)", "Traveling supplies", "Various trinkets", "String of koku"]
            ^"Companions" LIST OF STRING ["Riding pony Kushami (see Horse [Rokugani Pony] in the core rulebook, page 326)"]
        }

        ^"Quick Assessment" DEF {
            ^"Description" STRING "As a Support action, Yuto may target an NPC within range 0-3 who is currently engaged in conversation or combat. He discerns the target's demeanor, vigilance, and composure (and may reveal them to his allies)."
        }

        ^"Unassuming" DEF {
            ^"Description" STRING "When Yuto makes a check targeting a character with a higher status rank, he treats the target's vigilance as 1 lower."
        }

        RULES {
            #L5RCW39c06165867ce923b2ca60:ide_yuto
        }
    }

    ^"Moto Syujiko" DEF {
        APPLIES TO [^"NPC"]

        # Adorned in fur-lined robes and jingling with trinkets
        # from atop one of her riding camels, Moto Syujiko is a
        # traveling samurai, storyteller, and diviner of the Ujik
        # tradition. She reads fortunes and channels the Lords
        # of Death through knuckle bone divination.

        PROPERTIES {
            ^"Type" STRING "Adversary" FIXED
            ^"Combat Conflict Rank" INTEGER 3
            ^"Intrigue Conflict Rank" INTEGER 1
            ^"Description" STRING "Traveling samurai, storyteller, and Ujik diviner. Reads fortunes through knuckle bone divination and channels the Lords of Death."
            ^"Rings" DEF {
                ^"Air" INTEGER 2
                ^"Earth" INTEGER 3
                ^"Fire" INTEGER 2
                ^"Water" INTEGER 3
                ^"Void" INTEGER 3
            }
            ^"Endurance" INTEGER 10
            ^"Composure" INTEGER 12
            ^"Focus" INTEGER 4
            ^"Vigilance" INTEGER 3
            ^"Honor" INTEGER 40
            ^"Glory" INTEGER 38
            ^"Status" INTEGER 30
            ^"Demeanor" STRING "Detached"
            ^"Social Skill Check TN Modifiers" STRING "Earth +1, Fire +1, Void -2"
            ^"Skills" LIST OF STRING ["Artisan 2", "Martial 2", "Scholar 3", "Social 0", "Trade 2"]
            ^"Advantages" LIST OF STRING ["Well-Read (Fire) [Scholar; Mental]", "Lords of Death Blessing (Void) [Scholar, Social; Spiritual]"]
            ^"Disadvantages" LIST OF STRING ["Thick-Headed (Air) [Scholar, Social; Mental]"]
            ^"Favored Weapons" LIST OF STRING ["Scimitar: Range 1, Damage 4, Deadliness 5, Durable, Razor-Edged", "Horsebow: Range 2-4, Damage 4, Deadliness 5, Wargear"]
            ^"Gear" LIST OF STRING ["Wakizashi (short sword)", "Traveling supplies", "Divination kit", "Various trinkets", "String of koku"]
            ^"Companions" LIST OF STRING ["Two camels (see Camel in Path of Waves, page 235)"]
        }

        ^"Death Lord Divination" DEF {
            ^"Description" STRING "As a downtime activity, Syujiko can tell someone's fortune. After she offers a vague prediction to a character, choose one skill type (Artisan, Martial, Scholar, Social, or Trade). During the same session, the next time that character makes a skill check using the chosen type, they may replace one kept die with a single die showing a (su) result."
        }

        ^"Death Lord Curse" DEF {
            ^"Description" STRING "As a Support action, choose a target at range 0-2 and name a specific action type (such as Attack, Support, Movement, Intrigue, or similar). Until Syujiko's next turn, the next time the target attempts an action of the chosen type, they immediately receive 3 strife."
        }

        RULES {
            #L5RCW40427df39abea19faceab6:moto_syujiko
        }
    }

    ^"Shinjo Haruko" DEF {
        APPLIES TO [^"NPC"]

        # The Unicorn Champion's only biological daughter spends
        # most of her days on horseback, galloping along the shore
        # of Water Dragon Lake. After Imperial censure and a falling
        # out between the Shinjo and Ikoma families, all paths that
        # once seemed open to her have abruptly shut. She seeks a
        # new purpose but cannot find it near Far Traveler Castle.
        # Although one of the most talented horse archers of her
        # generation, Haruko tends to stir up trouble when bored.

        PROPERTIES {
            ^"Type" STRING "Adversary" FIXED
            ^"Combat Conflict Rank" INTEGER 6
            ^"Intrigue Conflict Rank" INTEGER 5
            ^"Description" STRING "The Unicorn Champion's only biological daughter. One of the most talented horse archers of her generation, seeking a new purpose after Imperial censure shut all her former paths."
            ^"Rings" DEF {
                ^"Air" INTEGER 4
                ^"Earth" INTEGER 3
                ^"Fire" INTEGER 3
                ^"Water" INTEGER 4
                ^"Void" INTEGER 3
            }
            ^"Endurance" INTEGER 12
            ^"Composure" INTEGER 14
            ^"Focus" INTEGER 7
            ^"Vigilance" INTEGER 4
            ^"Honor" INTEGER 60
            ^"Glory" INTEGER 65
            ^"Status" INTEGER 39
            ^"Demeanor" STRING "Impetuous"
            ^"Social Skill Check TN Modifiers" STRING "Earth +2, Air -2"
            ^"Skills" LIST OF STRING ["Artisan 2", "Martial 3", "Scholar 2", "Social 3", "Trade 1"]
            ^"Advantages" LIST OF STRING ["Skilled Archer (Air) [Martial; Physical]", "Friends in High Places (Air) [Social; Interpersonal]"]
            ^"Disadvantages" LIST OF STRING ["Reckless (Fire) [Social; Mental]"]
            ^"Favored Weapons" LIST OF STRING ["Shinjo Horsebow: Range 2-4, Damage 4, Deadliness 5, Wargear"]
            ^"Gear" LIST OF STRING ["Lamellar armor (Physical 4, Wargear)", "Quiver", "20 razor-leaf arrows", "Scimitar", "Wakizashi (short sword)", "Fine clothes", "Traveling clothes", "Some worn-out pillow books"]
            ^"Companions" LIST OF STRING ["Yue (see Shinjo courser on page 143)"]
        }

        ^"Horse Girl" DEF {
            ^"Description" STRING "Any steed Haruko rides or has personally trained gives the rider an additional bonus success on any Movement action check they make."
        }

        ^"Wishes at Dawn" DEF {
            ^"Description" STRING "In addition to her martial pursuits, Haruko also has a great love for the theater. Her most recent play, Wishes at Dawn, debuted at a provincial Winter Court and was met with significant praise. It depicts two star-crossed lovers, a Kakita and a Matsu, who must cross swords on the battlefield despite their secret love. While popular, neither the Matsu nor the Kakita family is particularly amused."
        }

        RULES {
            #L5RCW42a7b3e1d9f2c8a45e6701:shinjo_haruko
        }
    }

    ^"Kitsune Ryosei" DEF {
        APPLIES TO [^"NPC"]

        # Young and untested, Kitsune Ryosei only recently began
        # shadowing her father in preparation to take over as the
        # Fox Clan Champion. After making several Sakkaku pacts,
        # she underwent a sudden personality change. Some wonder
        # if she has been replaced by a trickster spirit. This profile
        # is for the real Ryosei; for the impersonator, apply the
        # Trickster Animal in Disguise template (page 140).

        PROPERTIES {
            ^"Type" STRING "Adversary" FIXED
            ^"Combat Conflict Rank" INTEGER 6
            ^"Intrigue Conflict Rank" INTEGER 3
            ^"Description" STRING "Young Fox Clan Champion. Recently made several Sakkaku pacts and underwent a sudden personality change. May have been replaced by a trickster spirit."
            ^"Rings" DEF {
                ^"Air" INTEGER 3
                ^"Earth" INTEGER 3
                ^"Fire" INTEGER 3
                ^"Water" INTEGER 2
                ^"Void" INTEGER 2
            }
            ^"Endurance" INTEGER 12
            ^"Composure" INTEGER 10
            ^"Focus" INTEGER 6
            ^"Vigilance" INTEGER 3
            ^"Honor" INTEGER 55
            ^"Glory" INTEGER 45
            ^"Status" INTEGER 64
            ^"Demeanor" STRING "Assertive"
            ^"Social Skill Check TN Modifiers" STRING "Earth +2, Air -2"
            ^"Skills" LIST OF STRING ["Artisan 1", "Martial 3", "Scholar 4", "Social 2", "Trade 2"]
            ^"Advantages" LIST OF STRING ["Blood of the Fox (Void) [Martial; Physical, Spiritual]", "Trickster Guardians (Air) [Martial, Social; Spiritual]"]
            ^"Disadvantages" LIST OF STRING ["Small Stature (Air) [Martial; Physical]", "Untested (Fire) [Martial, Social; Mental]", "Wandering Heart (Water) [Scholar; Mental]", "Short Attention Span (Water) [Scholar; Mental]"]
            ^"Favored Weapons" LIST OF STRING ["Trident: Range 2, Damage 4, Deadliness 4, Snaring, Wargear"]
            ^"Gear" LIST OF STRING ["Sanctified robes (Physical 1, Supernatural 3, Ceremonial)", "Wakizashi (short sword)", "Spiritual offerings", "Personal chop"]
        }

        ^"On Friendly Terms" DEF {
            ^"Description" STRING "Ryosei can talk to animals and understands their speech."
        }

        ^"Instinctive Pathfinding" DEF {
            ^"Description" STRING "While in dense or forested surroundings, Ryosei ignores the effects of Entangling and Obscuring terrain. Once per scene as a Support action, she may extend this ability to up to two targets at range 0-1. The effects of this ability last for as long as affected targets remain in these surroundings."
        }

        ^"Trickster Magic" DEF {
            ^"Description" STRING "When Ryosei performs an action to activate an invocation, she may spend (op) in the following way: (op): A target at range 0-1 suffers the Disoriented condition. Additionally, she knows the following invocations: Path of Beasts (Celestial Realms, page 109), Messenger of Chikusho-do (Celestial Realms, page 106), Nature's Touch (core rulebook, page 194), and Inari's Blessing (core rulebook, page 209)."
        }

        RULES {
            #L5RCW41da14a8a049a5855f53fd:kitsune_ryosei
        }
    }

    # ===========================
    # ADVENTURE NPCs (CHAPTER 4)
    # ===========================

    ^"Shinjo Higuchi (Possessed)" DEF {
        APPLIES TO [^"NPC"]

        PROPERTIES {
            ^"Type" STRING "Adversary" FIXED
            ^"Combat Conflict Rank" INTEGER 4
            ^"Intrigue Conflict Rank" INTEGER 1
            ^"Description" STRING "Popular author of stories and poems (pen name Hana-no-Ame), possessed by an ifrit from a meishodo talisman while visiting the City of the Rich Frog."
            ^"Rings" DEF {
                ^"Air" INTEGER 3
                ^"Earth" INTEGER 2
                ^"Fire" INTEGER 5
                ^"Water" INTEGER 1
                ^"Void" INTEGER 3
            }
            ^"Endurance" INTEGER 10
            ^"Composure" INTEGER 10
            ^"Focus" INTEGER 5
            ^"Vigilance" INTEGER 3
            ^"Honor" INTEGER 60
            ^"Glory" INTEGER 50
            ^"Status" INTEGER 39
            ^"Demeanor" STRING "Curious"
            ^"Social Skill Check TN Modifiers" STRING "Fire +1, Void +1, Air -2"
            ^"Skills" LIST OF STRING ["Artisan 1", "Martial 2", "Scholar 1", "Social 1", "Trade 0"]
            ^"Advantages" LIST OF STRING ["Eye for Detail (Air) [Artisan; Interpersonal, Mental]"]
            ^"Disadvantages" LIST OF STRING ["Possessed by Curiosity (Water) [Scholar; Mental]"]
            ^"Favored Weapons" LIST OF STRING ["Punch: Range 0, Damage 1, Deadliness 2, Snaring", "Kick: Range 1, Damage 2, Deadliness 1"]
            ^"Gear" LIST OF STRING ["Common clothes (Physical 1, Mundane)", "Calligraphy set", "Research notes"]
        }

        ^"Truth Burns Through Lies" DEF {
            ^"Description" STRING "When making a Scholar skill (Fire) check to assess a character's story, Higuchi may spend :opp: as follows: Fire :opp:: If there is a single statement upon which the character's story hinges, she determines what it is and what she would need to do to verify or disprove it."
        }

        ^"Flame Fist" DEF {
            ^"Description" STRING "Activation: As an Attack and Support action, Higuchi may make a TN 1 Martial Arts [Unarmed] (Fire) check to empower her unarmed blows. When she performs this action, she may choose a character at range 0-1 as the target for the burst effect. Enhancement Effect: While this kihō is active, treat the deadliness of Higuchi's unarmed punch and kick profiles as increased by 5 and treat her damage type as supernatural. Burst Effect: If Higuchi has two or more bonus successes, her target suffers 5 physical damage and must succeed on a TN 4 Fitness check (Air 5, Water 2) or suffer the Dazed condition."
        }

        ^"Searing Caress" DEF {
            ^"Description" STRING "When performing an Attack action check, Higuchi may spend :opp: as follows: :opp:+: The target and up to one other character per :opp: spent this way at range 0-1 of the target suffer the Burning condition."
        }

        RULES {
            #L5RCW42e6d3e5604f0489dc683d:shinjo_higuchi_possessed
        }
    }

    ^"Ikoma Kotone" DEF {
        APPLIES TO [^"NPC"]

        PROPERTIES {
            ^"Type" STRING "Adversary" FIXED
            ^"Combat Conflict Rank" INTEGER 1
            ^"Intrigue Conflict Rank" INTEGER 4
            ^"Description" STRING "Tea master and owner of the Teahouse with No Name in the City of the Rich Frog's Lion district. Diligent and professional, with a weakness for gossip and taboo romance stories."
            ^"Rings" DEF {
                ^"Air" INTEGER 3
                ^"Earth" INTEGER 2
                ^"Fire" INTEGER 2
                ^"Water" INTEGER 3
                ^"Void" INTEGER 3
            }
            ^"Endurance" INTEGER 8
            ^"Composure" INTEGER 10
            ^"Focus" INTEGER 5
            ^"Vigilance" INTEGER 3
            ^"Honor" INTEGER 60
            ^"Glory" INTEGER 50
            ^"Status" INTEGER 39
            ^"Demeanor" STRING "Shrewd"
            ^"Social Skill Check TN Modifiers" STRING "Air +2, Fire -2"
            ^"Skills" LIST OF STRING ["Artisan 2", "Martial 0", "Scholar 2", "Social 3", "Trade 0"]
            ^"Advantages" LIST OF STRING ["Professional Poise (Air) [Social; Interpersonal]"]
            ^"Disadvantages" LIST OF STRING ["Utter Gossip (Fire) [Social; Interpersonal]"]
        }

        ^"Master of Ceremonies" DEF {
            ^"Description" STRING "As tea master, Kotone has the right to speak the first word. During intrigue conflict scenes, characters who act before Kotone in initiative must forfeit 3 honor before starting their turn. They may choose instead to delay their turn to the end of the current initiative order."
        }

        ^"Stir the Leaves" DEF {
            ^"Description" STRING "As a Scheme action, Kotone may require any number of characters in the scene to make a TN 3 Courtesy (Air) or Performance (Air) check. Each character who fails increases the TN of their next check targeting Kotone by 1."
        }

        RULES {
            #L5RCW43e32b12d7a59cc5235b66:ikoma_kotone
        }
    }

    ^"Kaeru Haya" DEF {
