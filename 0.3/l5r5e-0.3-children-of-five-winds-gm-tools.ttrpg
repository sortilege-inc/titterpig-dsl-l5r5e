            ^"Skills" LIST OF STRING ["Artisan 0", "Martial 2", "Scholar 1", "Social 0", "Trade 1"]
            ^"Advantages" LIST OF STRING ["Steadfast Oaths (Earth) [Social; Interpersonal]", "Killer Instinct (Fire) [Martial; Mental]"]
            ^"Disadvantages" LIST OF STRING ["Implacable Boredom (Air) [Social; Interpersonal, Mental]"]
            ^"Favored Weapons" LIST OF STRING ["Katana: Range 1, Damage 4, Deadliness 5/7, Ceremonial, Razor-Edged", "Yumi: Range 2-5, Damage 5, Deadliness 3"]
            ^"Gear" LIST OF STRING ["Wakizashi", "Peacekeeper armor (Physical 2)", "Knife", "Mempo half mask", "Dice and cup"]
        }

        ^"Striking as Earth" DEF {
            ^"Description" STRING "When Haya makes a Martial Arts [Melee, Ranged, or Unarmed] (Earth) check, she may spend :opp: as follows: Earth :opp:: Treat your physical resistance as 1 higher per :opp: spent this way until the beginning of your next turn."
        }

        ^"Way of the Frog" DEF {
            ^"Description" STRING "Once per round, after an Attack action check targeting Haya succeeds, she may move 1 range band."
        }

        RULES {
