            ^"Advantages" LIST OF STRING ["Daikoku's Blessing (Water) [Social; Interpersonal, Spiritual]"]
            ^"Disadvantages" LIST OF STRING ["Quarrelsome (Void) [Social; Interpersonal]"]
            ^"Favored Weapons" LIST OF STRING ["Spear: Range 2, Damage 5, Deadliness 3"]
