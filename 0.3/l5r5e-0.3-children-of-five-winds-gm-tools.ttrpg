        PROPERTIES {
            ^"Type" STRING "Adversary" FIXED
            ^"Combat Conflict Rank" INTEGER 2
            ^"Intrigue Conflict Rank" INTEGER 1
            ^"Description" STRING "Old peacekeeper of the Kaeru family of ronin, leading the security group along the wharf in the City of the Rich Frog's Unicorn district. Has developed an interest in spiritual artifacts from beyond Rokugan."
            ^"Rings" DEF {
                ^"Air" INTEGER 2
                ^"Earth" INTEGER 3
                ^"Fire" INTEGER 2
                ^"Water" INTEGER 1
                ^"Void" INTEGER 1
            }
            ^"Endurance" INTEGER 10
            ^"Composure" INTEGER 6
            ^"Focus" INTEGER 5
            ^"Vigilance" INTEGER 2
            ^"Honor" INTEGER 30
            ^"Glory" INTEGER 40
            ^"Status" INTEGER 20
