EXTENSION "L5R5e_Children_of_Five_Winds_GM" EXTENDS "L5R5e_Children_of_Five_Winds" {
    NAME "Legend of the Five Rings 5th Edition - Children of the Five Winds: GM Tools"
    VERSION "0.3"
    RELEASE_DATE "2026-03-01"

    # Children of the Five Winds (Chapter 3): Otherworldly encounters system,
    # spirit pacts, NPC templates, horse templates, named NPCs, animals,
    # peoples of the Sand Road, spirits and strange beings, adventure NPCs.

    # ===========================
    # OTHERWORLDLY ENCOUNTERS SYSTEM
    # ===========================

    ^"Otherworldly Encounters" DEF {
        APPLIES TO [^"System"]
        # A social encounter system for interactions with spirits,
        # yokai, djinn, and other supernatural beings. Uses
        # atmospheric environmental descriptions and specialized
        # social objectives for both mortal and spirit participants.

        ^"Mortal Social Objectives" DEF {
            ENTRIES {
                ^"Create a Pact" {
                    ^"Momentum Required" STRING "Spirit's focus + higher of (intrigue rank or combat rank) + 2"
                    ^"Description" STRING "Accumulate momentum to establish a binding agreement between mortal and spirit."
                }
                ^"Dispel Possession" {
                    ^"Momentum Required" STRING "Spirit's focus + intrigue conflict rank (plus spirit's vigilance if possessing one of the characters pursuing this objective)"
                    ^"Description" STRING "Drive out a spirit that has possessed a character."
                }
                ^"Invoke for Aid" {
                    ^"Momentum Required" STRING "Spirit's intrigue conflict rank + rank of invocation desired (or +6 for effects more potent than an invocation)"
                    ^"Description" STRING "Request a spirit perform an invocation or other supernatural feat."
                }
                ^"Placate" {
                    ^"Momentum Required" STRING "Spirit's focus + combat conflict rank"
                    ^"Description" STRING "Calm an enraged spirit."
                }
                ^"Seal in an Object" {
                    ^"Momentum Required" STRING "Spirit's focus + double its intrigue conflict rank"
                    ^"Description" STRING "Bind a spirit in a physical vessel. The object gains the Sacred or Unholy quality. Way of Names practitioners may create a meishodo talisman."
                }
            }

            RULES {
                #L5RCW0287e22c4061dfe3a362ca:mortal_social_objectives
            }
        }

        ^"Spirit Social Objectives" DEF {
            ENTRIES {
                ^"Curse" {
                    ^"Momentum Required" STRING "Target's focus + Theology ranks"
                    ^"Description" STRING "Lay a curse on a character."
                }
                ^"Inspire Awe" {
                    ^"Momentum Required" STRING "Target's vigilance + Meditation ranks"
                    ^"Description" STRING "Terrify mortals with supernatural dread."
                }
                ^"Possession" {
                    ^"Momentum Required" STRING "2 x (target's focus + Command ranks)"
                    ^"Description" STRING "Take over a character's body."
                }
                ^"Request an Offering" {
                    ^"Minimum Momentum" INTEGER 1
                    ^"Description" STRING "Spirits request tribute from mortals."
                }
            }

            RULES {
                #L5RCW03c0397773f0cb957ced31:spirit_social_objectives
            }
        }

        ^"New Encounter Actions" DEF {
            ENTRIES {
                ^"Compel" {
                    ^"Description" STRING "Use a spirit's true name to force cooperation. Requires Way of Names training."
                }
                ^"Entice" {
                    ^"Description" STRING "Win a spirit's favor with offerings. Provides momentum and bonus information opportunities."
                }
            }

            RULES {
                #L5RCW042aee1def69565a437b05:new_encounter_actions
            }
        }

        RULES {
            #L5RCW015eae964d4f09cf64a17b:otherworldly_encounters
        }
    }

    # ===========================
    # SPIRIT PACTS SYSTEM
    # ===========================

    ^"Spirit Pacts" DEF {
        APPLIES TO [^"System"]
        # Three components: Terms (set by spirit), Boons (chosen
        # by mortal), and Domain (area where pact applies).

        ^"Pact Terms (Spirit-Set)" DEF {
            ENTRIES {
                ^"Mutual Defense" { ^"Description" STRING "Both parties agree to defend each other." }
                ^"Periodic Offerings" { ^"Description" STRING "Mortal provides regular tribute to the spirit." }
                ^"Taboos" { ^"Description" STRING "Mortal agrees to observe certain prohibitions." }
                ^"Various Tasks" { ^"Description" STRING "Spirit assigns tasks to the mortal from time to time." }
            }

            RULES {
                #L5RCW060e85691f2c6fd30fee58:pact_terms_spiritset
            }
        }

        ^"Pact Boons - Narrative" DEF {
            ENTRIES {
                ^"Fortunate Finding" { ^"Description" STRING "Mortal finds useful items or resources at opportune times." }
                ^"Gentle Rains" { ^"Description" STRING "Favorable weather in the pact domain." }
                ^"Good Health" { ^"Description" STRING "Resistance to disease and illness." }
                ^"Inspiration" { ^"Description" STRING "Creative insights and artistic breakthroughs." }
                ^"Plenty" { ^"Description" STRING "Abundant harvests and resources." }
                ^"Quiet Stars" { ^"Description" STRING "External conflicts are naturally directed away from the domain by sudden storms, flooding rivers, or other phenomena." }
                ^"Safe Harbor" { ^"Description" STRING "A protected refuge within the domain." }
            }

            RULES {
                #L5RCW07369b7b46026a20fd20b6:pact_boons_narrative
            }
        }

        ^"Pact Boons - Mechanical" DEF {
            ENTRIES {
                ^"Clarity" { ^"Description" STRING "Gain the Centered condition." }
                ^"Courage" { ^"Description" STRING "Gain the Emboldened condition." }
                ^"Energetic Recovery" { ^"Description" STRING "Enhanced fatigue recovery." }
                ^"Permanence" { ^"Description" STRING "When a character makes a check to resist an effect of an Otherworldly being, they can reroll a number of dice up to the spirit's Water Ring." }
                ^"Purity" { ^"Description" STRING "Resistance to spiritual corruption." }
                ^"Restoration" { ^"Description" STRING "Accelerated healing." }
                ^"Skillful Hands" { ^"Description" STRING "Bonus to craft or trade checks." }
            }

            RULES {
                #L5RCW08307da0cbb1fd65ef5047:pact_boons_mechanical
            }
        }

        RULES {
            #L5RCW05e44c18a12ccdd952e3f9:spirit_pacts
        }
    }

    # ===========================
    # NPC TEMPLATES
    # ===========================

    ^"Fox Clan Samurai Template" DEF {
        APPLIES TO [^"NPC Template"]
        PROPERTIES {
            ^"Base Profile" STRING "Any clan samurai profile"
            ^"Combat Rank Modifier" STRING "+1"
            ^"Intrigue Rank Modifier" STRING "+1"
            ^"Ring Modifier" STRING "+1 Earth"
            ^"Skill Modifier" STRING "+1 Scholar and Trade skills"
            ^"Advantages (add/replace 0-2)" LIST OF STRING ["Affinity with (any one animal species) (Void) [Social; Interpersonal]", "Animal Bond (Earth) [Social; Interpersonal, Mental]", "Sixth Sense (Void) [Martial; Spiritual]", "Talented Herbalist (Earth) [Social; Mental]"]
            ^"Disadvantages (add/replace 0-2)" LIST OF STRING ["Disdain for Urban Sprawl (Earth) [Interpersonal; Mental]", "Deals with Spirits (Fire) [Social; Interpersonal]", "Slow to Trust (Earth) [Social; Interpersonal]"]
            ^"Techniques (add/replace 0-2)" LIST OF STRING ["Invocations", "Kata", "Rituals"]
            ^"Demeanor (replace 1)" LIST OF STRING ["Detached", "Gruff", "Shrewd"]
        }

        RULES {
            #L5RCW091d399cf7b3763bec66fa:fox_clan_samurai_template
        }
    }

    ^"Trickster Animal in Disguise Template" DEF {
        APPLIES TO [^"NPC Template"]
        PROPERTIES {
            ^"Base Profile" STRING "Any human or animal profile"
            ^"Combat Rank Modifier" STRING "+1"
            ^"Intrigue Rank Modifier" STRING "+2"
            ^"Ring Modifier" STRING "+1 Air or +1 Fire"
            ^"Skill Modifier" STRING "+1 Scholar, Social, and Trade skills"
            ^"Composure Modifier" STRING "+2"
            ^"Advantages (add/replace 0-2)" LIST OF STRING ["Affinity with (same type of animal) (Void) [Social; Interpersonal]", "Dangerous Allure (Fire) [Social; Interpersonal, Physical]", "Shapeshifter's Guile (Air) [Social; Interpersonal]"]
            ^"Disadvantage (required)" STRING "Choose an animal or Otherworldly being feature, which is the flaw in this NPC's disguise"
            ^"Other Disadvantages (add/replace 0-2)" LIST OF STRING ["Materialistic (Air) [Social; Mental]", "Mysterious Taboo (Void) [Social; Spiritual]", "Paranoia (Water) [Social; Mental, Physical]"]
            ^"Techniques (add/replace 1-2)" LIST OF STRING ["Invocations", "Ninjutsu", "Shūji"]
            ^"Demeanor (replace 1)" LIST OF STRING ["Detached", "Playful (Earth +2, Water -2)", "Shrewd"]
        }

        RULES {
            #L5RCW109ffd9d0e867b0ab31c77:trickster_animal_in_disguise_template
        }
    }

    ^"Unicorn Clan Samurai Template" DEF {
        APPLIES TO [^"NPC Template"]
        PROPERTIES {
            ^"Base Profile" STRING "Any clan samurai profile"
            ^"Combat Rank Modifier" STRING "+2"
            ^"Ring Modifier" STRING "+1 Water"
            ^"Skill Modifier" STRING "+1 Martial and Trade skills"
            ^"Advantages (add/replace 0-2)" LIST OF STRING ["Affinity with Horses (Void) [Social; Interpersonal]", "Syncretic Philosophy (Water) [Social; Interpersonal, Mental]", "Quick Reflexes (Fire) [Martial; Interpersonal, Physical]", "Worldly (Void) [Social; Interpersonal, Physical]"]
            ^"Disadvantages (add/replace 0-2)" LIST OF STRING ["Bluntness (Air) [Social; Interpersonal]", "Softhearted (Fire) [Martial, Social; Interpersonal, Mental]", "Unfair Reputation (Air) [Social; Interpersonal]", "Wanderlust (Water) [Social; Mental]"]
            ^"Techniques (add/replace 0-2)" LIST OF STRING ["Kata", "Rituals", "Shūji"]
            ^"Demeanor (replace 1)" LIST OF STRING ["Assertive", "Compassionate", "Gruff"]
        }

        RULES {
            #L5RCW1124063fc9cb6bfcf01244:unicorn_clan_samurai_template
        }
    }

    # ===========================
    # UNICORN HORSE BREEDS
    # ===========================

    ^"Unicorn Horse Breeds" DEF {
        APPLIES TO [^"Table"]
        ENTRIES {
            ^"Ide Traveling Pony" {
                ^"Description" STRING "Hardy breed with +2 Endurance, +4 Composure, Intrigue +1. Removes Skittish disadvantage, adds Even-Tempered advantage. Built for endurance over long journeys."
            }
            ^"Iuchi Riding Steed" {
                ^"Description" STRING "Intelligent breed trained by Iuchi shugenja to respond to verbal and hand-gesture commands."
                ^"Conflict Rank Modifier" STRING "Intrigue +1"
                ^"Advantages (add 1)" LIST OF STRING ["Smart as a Human (Air) [Social; Mental]"]
                ^"Disadvantages (remove)" LIST OF STRING ["Skittish"]
                ^"Demeanor" STRING "Detached"
            }
            ^"Moto Charger" {
                ^"Description" STRING "Hot-tempered breed known for strength, size, and explosive gallop. Carries heavily armored lancers into battle but lacks stamina for prolonged journeys."
                ^"Conflict Rank Modifier" STRING "Combat +1"
                ^"Advantages (remove)" LIST OF STRING ["Tireless Runner"]
                ^"Advantages (add 2)" LIST OF STRING ["Brute Strength (Fire) [Martial; Physical]", "Fearsome Presence (Fire) [Social; Interpersonal]", "Masterful Fighter (Earth) [Martial; Mental]"]
                ^"Disadvantages (replace 1)" LIST OF STRING ["Quick to Anger (Fire) [Social; Interpersonal]", "Willful (Earth) [Social; Interpersonal]"]
            }
            ^"Shinjo Courser" {
                ^"Description" STRING "Renowned for speed and stamina but high-spirited and flighty. Ideal for scouts, courtiers, and mounted archers, but ill-suited to traditional battle."
                ^"Conflict Rank Modifier" STRING "Combat +1"
                ^"Endurance Modifier" STRING "+2"
                ^"Advantages (add)" LIST OF STRING ["Fleet of Foot (Water) [Martial; Physical]"]
                ^"Demeanor" STRING "Cautious [Air +2, Earth -2]"
            }
            ^"Utaku Warhorse" {
                ^"Description" STRING "Ideal blend of power, speed, and stamina bred by Utaku Horse Lord Disciples. Combat +1, +4 Endurance, +4 Composure. Removes Skittish disadvantage, adds one of: Fearsome Presence, Masterful Fighter, or Veteran's Instincts."
            }
        }

        RULES {
            #L5RCW1282394e2b9dd1cba69603:unicorn_horse_breeds
        }
    }

    # ===========================
    # ANIMAL NPCs
    # ===========================

    ^"Aurochs" DEF {
        APPLIES TO [^"NPC"]

        PROPERTIES {
            ^"Type" STRING "Adversary" FIXED
            ^"Category" STRING "Animal"
            ^"Combat Conflict Rank" INTEGER 8
            ^"Intrigue Conflict Rank" INTEGER 1
            ^"Description" STRING "Massive wild cattle with equally massive horns. They travel in herds of roughly thirty."
            ^"Rings" DEF {
                ^"Air" INTEGER 1
                ^"Earth" INTEGER 5
                ^"Fire" INTEGER 3
                ^"Water" INTEGER 2
                ^"Void" INTEGER 1
            }
            ^"Endurance" INTEGER 16
            ^"Composure" INTEGER 14
            ^"Focus" INTEGER 4
            ^"Vigilance" INTEGER 3
            ^"Silhouette" INTEGER 4
            ^"Demeanor" STRING "Laconic"
            ^"Social Skill Check TN Modifiers" STRING "Fire +2, Water -2"
            ^"Skills" LIST OF STRING ["Artisan 0", "Martial 2", "Scholar 0", "Social 0", "Trade 0"]
            ^"Advantages" LIST OF STRING ["Enormous Stature (Earth) [Martial; Physical]"]
            ^"Disadvantages" LIST OF STRING ["Bad Temper (Fire) [Martial; Mental]"]
            ^"Favored Weapons" LIST OF STRING ["Horns: Range 1, Damage 8, Deadliness 6, Durable"]
            ^"Gear" LIST OF STRING ["Thick hide (Physical 5)"]
        }

        ^"Trample" DEF {
            ^"Description" STRING "The aurochs is a silhouette 4 creature. When an aurochs inflicts a critical strike, the TN of the check to resist is 6, and if the target fails their check to resist, the target suffers the Dazed condition in addition to the other effects."
        }

        RULES {
            #L5RCW13409f4f4bb1aa3fe9ff72:aurochs
        }
    }

    ^"Badger" DEF {
        APPLIES TO [^"NPC"]

        PROPERTIES {
            ^"Type" STRING "Adversary" FIXED
            ^"Category" STRING "Animal"
            ^"Combat Conflict Rank" INTEGER 2
            ^"Intrigue Conflict Rank" INTEGER 1
            ^"Description" STRING "Solitary burrowing creature, prized in some communities and considered bad luck in others. Ferociously defends itself and its young when threatened."
            ^"Rings" DEF {
                ^"Air" INTEGER 1
                ^"Earth" INTEGER 3
                ^"Fire" INTEGER 3
                ^"Water" INTEGER 1
                ^"Void" INTEGER 1
            }
            ^"Endurance" INTEGER 12
            ^"Composure" INTEGER 6
            ^"Focus" INTEGER 4
            ^"Vigilance" INTEGER 2
            ^"Silhouette" INTEGER 1
            ^"Demeanor" STRING "Stubborn"
            ^"Social Skill Check TN Modifiers" STRING "Water +2, Earth -2"
            ^"Skills" LIST OF STRING ["Artisan 0", "Martial 1", "Scholar 0", "Social 0", "Trade 0"]
            ^"Advantages" LIST OF STRING ["Fast Burrowing (Earth) [Martial; Physical]"]
            ^"Disadvantages" LIST OF STRING ["Nocturnal (Earth) [Trade; Physical]", "Hot-Tempered (Fire) [Martial; Mental]"]
            ^"Favored Weapons" LIST OF STRING ["Claws: Range 0-1, Damage 4, Deadliness 3, Razor-Edged"]
        }

        ^"Berserker Fury" DEF {
            ^"Description" STRING "The badger is a silhouette 1 burrowing creature. After it is cornered, or after suffering a critical strike, the badger suffers the Enraged condition. While Enraged, a badger cannot suffer the Unconscious condition and may perform Attack actions even while incapacitated."
        }

        RULES {
            #L5RCW14ee6a8fba3f0d43df0607:badger
        }
    }

    ^"Giant Bat" DEF {
        APPLIES TO [^"NPC"]

        PROPERTIES {
            ^"Type" STRING "Minion" FIXED
            ^"Category" STRING "Animal"
            ^"Combat Conflict Rank" INTEGER 1
            ^"Intrigue Conflict Rank" INTEGER 1
            ^"Description" STRING "Docile creatures with wingspans nearing five feet and foxlike features. Considered good luck in Rokugani culture. Orchard farmers regard them with unmitigated pleasure."
            ^"Rings" DEF {
                ^"Air" INTEGER 4
                ^"Earth" INTEGER 1
                ^"Fire" INTEGER 2
                ^"Water" INTEGER 2
                ^"Void" INTEGER 1
            }
            ^"Endurance" INTEGER 6
            ^"Composure" INTEGER 6
            ^"Focus" INTEGER 6
            ^"Vigilance" INTEGER 3
            ^"Silhouette" INTEGER 1
            ^"Demeanor" STRING "Gregarious"
            ^"Social Skill Check TN Modifiers" STRING "Fire +2, Earth -2"
            ^"Skills" LIST OF STRING ["Artisan 0", "Martial 1", "Scholar 0", "Social 0", "Trade 0"]
            ^"Advantages" LIST OF STRING ["Keen Senses (Water) [Martial; Mental, Physical]", "Pack Tactics (Water) [Martial, Social; Interpersonal]"]
            ^"Disadvantages" LIST OF STRING ["Nocturnal (Earth) [Trade; Physical]"]
            ^"Favored Weapons" LIST OF STRING ["Bite: Range 0, Damage 2, Deadliness 1, Razor-Edged"]
        }

        ^"Nimble Flyer" DEF {
            ^"Description" STRING "The giant bat is a silhouette 1 creature that can fly. It can move vertically and ignores the negative effects of terrain."
        }

        RULES {
            #L5RCW15f664ffccb73cec7a26c9:giant_bat
        }
    }

    ^"Golden Eagle" DEF {
        APPLIES TO [^"NPC"]

        PROPERTIES {
            ^"Type" STRING "Minion" FIXED
            ^"Category" STRING "Animal"
            ^"Combat Conflict Rank" INTEGER 2
            ^"Intrigue Conflict Rank" INTEGER 1
            ^"Description" STRING "Largest birds of prey in Rokugan, with strength greater than their size suggests. Used in pairs by falconers to hunt deer, foxes, and other game."
            ^"Rings" DEF {
                ^"Air" INTEGER 4
                ^"Earth" INTEGER 1
                ^"Fire" INTEGER 3
                ^"Water" INTEGER 2
                ^"Void" INTEGER 1
            }
            ^"Endurance" INTEGER 8
            ^"Composure" INTEGER 6
            ^"Focus" INTEGER 7
            ^"Vigilance" INTEGER 3
            ^"Silhouette" INTEGER 1
            ^"Demeanor" STRING "Proud"
            ^"Social Skill Check TN Modifiers" STRING "Fire +2, Air -2"
            ^"Skills" LIST OF STRING ["Artisan 0", "Martial 1", "Scholar 0", "Social 1", "Trade 0"]
            ^"Advantages" LIST OF STRING ["Fleet of Foot (Water) [Martial; Physical]", "Sharp Eyesight (Water) [Martial, Trade; Physical]"]
            ^"Disadvantages" LIST OF STRING ["Hollow Bones (Earth) [Martial; Physical]", "Quick to Anger (Fire) [Social; Interpersonal]"]
            ^"Favored Weapons" LIST OF STRING ["Beak and Talons: Range 0, Damage 2, Deadliness 6"]
        }

        ^"Nimble Flyer" DEF {
            ^"Description" STRING "The golden eagle is a silhouette 1 creature that can fly. It can move vertically and ignores the negative effects of terrain."
        }

        RULES {
            #L5RCW16ecf5bf4714d9e2dbd277:golden_eagle
        }
    }

    ^"Riding Deer" DEF {
        APPLIES TO [^"NPC"]

        PROPERTIES {
            ^"Type" STRING "Minion" FIXED
            ^"Category" STRING "Animal"
            ^"Combat Conflict Rank" INTEGER 1
            ^"Intrigue Conflict Rank" INTEGER 1
            ^"Description" STRING "Extremely rare domesticated deer bred as stealthy woodland mounts by the Fox and Deer Clans."
            ^"Rings" DEF {
                ^"Air" INTEGER 1
                ^"Earth" INTEGER 2
                ^"Fire" INTEGER 1
                ^"Water" INTEGER 3
                ^"Void" INTEGER 1
            }
            ^"Endurance" INTEGER 6
            ^"Composure" INTEGER 4
            ^"Focus" INTEGER 4
            ^"Vigilance" INTEGER 3
            ^"Silhouette" INTEGER 3
            ^"Demeanor" STRING "Flighty"
            ^"Social Skill Check TN Modifiers" STRING "Air +2, Earth -2"
            ^"Skills" LIST OF STRING ["Artisan 0", "Martial 0", "Scholar 0", "Social 1", "Trade 0"]
            ^"Advantages" LIST OF STRING ["Forest Runner (Earth) [Martial; Physical]", "Lightning Reflexes (Fire) [Martial; Mental, Physical]"]
            ^"Disadvantages" LIST OF STRING ["Skittish (Fire) [Martial; Mental]"]
            ^"Favored Weapons" LIST OF STRING ["Hooves: Range 1, Damage 3, Deadliness 3", "Antlers: Range 1-2, Damage 2, Deadliness 5"]
            ^"Gear" LIST OF STRING ["Saddle, saddlebags, feed bag, grooming kit"]
        }

        ^"Forest Bounder" DEF {
            ^"Description" STRING "The riding deer is a silhouette 3 deer and can be ridden by a human-sized (silhouette 2 or lower) rider. It ignores penalties from dense forested terrain, even when carrying a rider."
        }

        RULES {
            #L5RCW17cc7ce614d0b353ea3792:riding_deer
        }
    }

    ^"Riding Bear" DEF {
        APPLIES TO [^"NPC"]

        PROPERTIES {
            ^"Type" STRING "Adversary" FIXED
            ^"Category" STRING "Animal"
            ^"Combat Conflict Rank" INTEGER 6
            ^"Intrigue Conflict Rank" INTEGER 1
            ^"Description" STRING "Aggressive brown bears of the Shinomen Forest, occasionally called upon as ursine mounts by especially woodsy shugenja."
            ^"Rings" DEF {
                ^"Air" INTEGER 4
                ^"Earth" INTEGER 3
                ^"Fire" INTEGER 3
                ^"Water" INTEGER 3
                ^"Void" INTEGER 1
            }
            ^"Endurance" INTEGER 12
            ^"Composure" INTEGER 12
            ^"Focus" INTEGER 3
            ^"Vigilance" INTEGER 2
            ^"Silhouette" INTEGER 3
            ^"Demeanor" STRING "Intimidating"
            ^"Social Skill Check TN Modifiers" STRING "Fire +2, Water -2"
            ^"Skills" LIST OF STRING ["Artisan 0", "Martial 1", "Scholar 0", "Social 1", "Trade 0"]
            ^"Advantages" LIST OF STRING ["Enormous Stature (Earth) [Martial; Physical]"]
            ^"Disadvantages" LIST OF STRING ["Opportunist (Fire) [Martial; Mental]"]
            ^"Favored Weapons" LIST OF STRING ["Claws and Fangs: Range 1-2, Damage 8, Deadliness 6"]
            ^"Gear" LIST OF STRING ["Thick hide (Physical 4)"]
        }

        ^"Ursine Mount" DEF {
            ^"Description" STRING "The riding bear is a silhouette 3 creature and can be ridden by a human-sized (silhouette 2 or lower) rider."
        }

        ^"Crushing Swipe" DEF {
            ^"Description" STRING "When a riding bear inflicts a critical strike, the TN of the check to resist is 4, and if the target fails the check to resist, the target suffers the Dazed condition in addition to the other effects."
        }

        RULES {
            #L5RCW18cd2e0e5b1ecd24f9734d:riding_bear
        }
    }

    ^"Tiger" DEF {
        APPLIES TO [^"NPC"]

        PROPERTIES {
            ^"Type" STRING "Adversary" FIXED
            ^"Category" STRING "Animal"
            ^"Combat Conflict Rank" INTEGER 6
            ^"Intrigue Conflict Rank" INTEGER 1
            ^"Description" STRING "Solitary predator with distinctive striped fur. Associated with nobility, pride, and fierceness by the Ujik, Nehiri, and Suhili."
            ^"Rings" DEF {
                ^"Air" INTEGER 1
                ^"Earth" INTEGER 4
                ^"Fire" INTEGER 2
                ^"Water" INTEGER 3
                ^"Void" INTEGER 1
            }
            ^"Endurance" INTEGER 8
            ^"Composure" INTEGER 12
            ^"Focus" INTEGER 6
            ^"Vigilance" INTEGER 4
            ^"Silhouette" INTEGER 3
            ^"Demeanor" STRING "Aggressive"
            ^"Social Skill Check TN Modifiers" STRING "Fire +2, Earth -2"
            ^"Skills" LIST OF STRING ["Artisan 0", "Martial 2", "Scholar 0", "Social 0", "Trade 0"]
            ^"Advantages" LIST OF STRING ["Swift and Agile (Fire) [Martial; Physical]"]
            ^"Disadvantages" LIST OF STRING ["Pride (Air) [Social; Mental]"]
            ^"Favored Weapons" LIST OF STRING ["Teeth and Claws: Range 1, Damage 5, Deadliness 9, Razor-Edged"]
            ^"Gear" LIST OF STRING ["Thick fur (Physical 2)"]
        }

        ^"Cunning Pounce" DEF {
            ^"Description" STRING "A tiger is a silhouette 3 creature with incredible strength but also cunning tactics. When a tiger makes a successful Attack action check against a target, that target must make a TN 4 Tactics check (Air 3, Earth 5) or gain the Disoriented condition."
        }

        ^"Savage Mauling" DEF {
            ^"Description" STRING "Disoriented targets cannot make checks to resist damage dealt by a tiger."
        }

        RULES {
            #L5RCW19a57dcda78795fa016e86:tiger
        }
    }

    ^"Ujik War Pony" DEF {
        APPLIES TO [^"NPC"]

        PROPERTIES {
            ^"Type" STRING "Minion" FIXED
            ^"Category" STRING "Animal"
            ^"Combat Conflict Rank" INTEGER 2
            ^"Intrigue Conflict Rank" INTEGER 1
            ^"Description" STRING "Short and stocky pony breeds of the Ujik tribes. Hardy, strong, and resistant to illness, prized by the Utaku and Moto for crossbreeding."
            ^"Rings" DEF {
                ^"Air" INTEGER 1
                ^"Earth" INTEGER 3
                ^"Fire" INTEGER 2
                ^"Water" INTEGER 3
                ^"Void" INTEGER 1
            }
            ^"Endurance" INTEGER 8
            ^"Composure" INTEGER 6
            ^"Focus" INTEGER 6
            ^"Vigilance" INTEGER 2
            ^"Silhouette" INTEGER 3
            ^"Demeanor" STRING "Loyal"
            ^"Social Skill Check TN Modifiers" STRING "Earth +1, Air -2, Water -2"
            ^"Skills" LIST OF STRING ["Artisan 0", "Martial 1", "Scholar 0", "Social 1", "Trade 0"]
            ^"Advantages" LIST OF STRING ["Brute Strength (Fire) [Martial; Physical]", "Tireless Runner (Earth) [Martial; Physical]"]
            ^"Disadvantages" LIST OF STRING ["Skittish (Fire) [Martial; Mental]"]
            ^"Favored Weapons" LIST OF STRING ["Hooves: Range 1-2, Damage 6, Deadliness 5"]
            ^"Gear" LIST OF STRING ["Hide (Physical 2)", "Saddle, saddlebags, feed bag, grooming kit"]
        }

        ^"Loyal Steed" DEF {
            ^"Description" STRING "The Ujik war pony is a silhouette 3 creature. It can be ridden by a human-sized (silhouette 2 or lower) rider."
        }

        RULES {
            #L5RCW20a2e584915196da9beb64:ujik_war_pony
        }
    }

