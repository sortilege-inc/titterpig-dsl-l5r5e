EXTENSION "L5R5e_Fields_of_Victory" EXTENDS "L5R5e_Core_Character" {
    NAME "Legend of the Five Rings 5th Edition - Fields of Victory: New Player Options"
    VERSION "0.3"
    RELEASE_DATE "2026-03-01"

    # Fields of Victory (Chapters 2 and 3): Badger Minor Clan, Ichiro family,
    # new schools, advantages, disadvantages, heritages, weapons, personal effects,
    # blessed treasures (nemuranai), item patterns, techniques (kata, ninjutsu,
    # rituals, shūji), titles, demeanor, NPC templates, opportunity tables,
    # and honor rules for warfare-focused campaigns.

    # ===========================
    # BADGER MINOR CLAN
    # ===========================

    ^"Badger Minor Clan" DEF {
        EXTENDS #L5R250aB2cD4eF6gH8iJ0k ^"Clan"
        APPLIES TO [^"Samurai"]

        # While most clans seem to spend all their time fighting
        # each other, the Badger steadfastly defend the northwest
        # border of the Emerald Empire. The trivialities of courtly
        # life and interclan intrigue are less than important. Only
        # the Crab face a more constant threat. Often forgotten
        # by most of the major powers of the Empire, the Badger
        # continue their charged duty with little to no outside
        # support. Only by being as strong, resilient, and self-
        # reliant as the mountains themselves can the Badger
        # ensure no invaders gain entrance to Rokugan.

        PROPERTIES {
            ^"Clan Name" STRING "Badger" FIXED
            ^"Clan Type" STRING "Minor Clan"
            ^"Clan Ring Bonus" DEF { ^"Earth" INTEGER 1 }
            ^"Clan Skill Bonus" DEF { ^"Martial Arts [Unarmed]" INTEGER 1 }
            ^"Clan Status" INTEGER DEFAULT 25
        }

        FAMILIES {
            ^"Ichirō"
        }

        RULES {
            #L5RFV01aB2cD4eF6gH8iJ0k: badger_defend_northwest_border
            #L5RFV02lM3nO5pQ7rS9tU1v: badger_bushido_righteousness_gi_important
            #L5RFV03wX4yZ6aB8cD0eF2g: badger_bushido_courtesy_rei_less_important
        }
    }


    # ===========================
    # BADGER FAMILIES
    # ===========================

    #L5RFV50oP8qR0sT2uV4wX6y ^"Ichirō" DEF {
        EXTENDS #L5R251lM3nO5pQ7rS9tU1v ^"Family"
        APPLIES TO [^"Samurai"]
        ALIAS "Ichiro"

        PROPERTIES {
            ^"Family Name"     STRING "Ichirō" FIXED
            ^"Clan"            STRING "Badger"
            ^"Ring Increase" DEF { CHOOSE 1 [^"Earth", ^"Fire"] INTEGER 1 }
            ^"Skill Increases" DEF {
                ^"Fitness" INTEGER 1
                ^"Tactics" INTEGER 1
            }
            ^"Glory"           INTEGER 35
            ^"Starting Wealth" INTEGER 3
        }
    }


    # ===========================
    # NEW SCHOOLS
    # ===========================

    ^"Agasha Ascetic" DEF {
        EXTENDS #L5R252wX4yZ6aB8cD0eF2g ^"School"
        APPLIES TO [^"Samurai"]

        # Combining the teachings of mystic and warrior, the
        # samurai of the Agasha Ascetic School fill a valuable
        # role when the Dragon Clan goes to war. Their skills in
        # calling upon the kami are impressive, but their martial
        # abilities mean they can attack and defend in combat
        # as well as any bushi. This battlefield flexibility makes
        # them dangerous and vital to the clan's small armies.

        PROPERTIES {
            ^"School Name" STRING "Agasha Ascetic" FIXED
            ^"Clan" STRING "Dragon"
            ^"Roles" LIST ["Shugenja", "Bushi"]
            ^"Ring Increase" DEF {
                ^"Air" INTEGER 1
                ^"Earth" INTEGER 1
            }
            ^"Starting Skills" DEF { CHOOSE 5 [^"Fitness", ^"Martial Arts [Ranged]", ^"Martial Arts [Melee]", ^"Meditation", ^"Sentiment", ^"Tactics", ^"Theology"] INTEGER 1 }
            ^"Starting Honor" INTEGER DEFAULT 45
            ^"Techniques Available" LIST ["Invocations", "Kata", "Rituals"]
        }


        STARTING_TECHNIQUES {
            INVOCATION CHOOSE 2 [^"Caress of Earth", ^"Cloak of Night", ^"Wall of Earth", ^"Yari of Air"]
            KATA CHOOSE 1 [^"Striking as Air", ^"Striking as Earth"]
            RITUAL ^"Cleansing Rite"
            RITUAL ^"Commune with Spirits"
        }

        SCHOOL_ABILITY "Stand as the Mountain" {
            "After you channel an invocation, increase your physical and supernatural resistances by an amount equal to the number of dice you reserved, to a maximum of your school rank. This effect persists until the start of your next turn."
        }

        MASTERY_ABILITY ^"Soul of Deepest Stones" {
            "When you successfully make a check to augment or mend a target, add a number of bonus successes equal to your ranks in Fitness."
        }
        STARTING_OUTFIT [
            "sanctified robes", "traveling clothes",
            "daishō (katana and wakizashi)", "scroll satchel",
            "journal", "traveling pack"
        ]

        CURRICULUM {
            RANK 1 {
                SKILL_GROUP "Martial Skills"
                SKILL "Courtesy"
                SKILL "Medicine"
                SKILL "Theology"
                TECHNIQUE_GROUP "Rank 1 Air Invocations"
                ^"Clouds Parted by Steel" [shuji]
                ^"Grasp of Earth" [invocation]
            }
            RANK 2 {
                SKILL_GROUP "Scholar Skills"
                SKILL "Martial Arts [Melee]"
                SKILL "Meditation"
                SKILL "Survival"
                TECHNIQUE_GROUP "Rank 1-2 Kata"
                ^"Beseech Togashi's Vision" [ritual]
                ^"Vanish in the Shadows" [ninjutsu]
            }
            RANK 3 {
                SKILL_GROUP "Trade Skills"
                SKILL "Fitness"
                SKILL "Martial Arts [Ranged]"
                SKILL "Theology"
                TECHNIQUE_GROUP "Rank 1-3 Earth Invocations"
                ^"Employ Terrible Thunder" [ninjutsu]
                ^"Grasp of the Air Dragon" [invocation]
            }
            RANK 4 {
                SKILL_GROUP "Martial Skills"
                SKILL "Command"
                SKILL "Sentiment"
                SKILL "Theology"
                TECHNIQUE_GROUP "Rank 1-4 Kata"
                ^"Imbue Thunder" [ritual]
                ^"Rise, Air" [invocation]
            }
            RANK 5 {
                SKILL_GROUP "Scholar Skills"
                SKILL "Fitness"
                SKILL "Martial Arts [Melee]"
                SKILL "Meditation"
                TECHNIQUE_GROUP "Rank 1-5 Air Invocations"
                ^"Ever-Changing Waves" [invocation]
                ^"Striking as Void" [kata]
            }
            RANK 6 {
                ^"Soul of Deepest Stones"
            }
        }

    }

    ^"Akodo Soldier" DEF {
        EXTENDS #L5R252wX4yZ6aB8cD0eF2g ^"School"
        APPLIES TO [^"Samurai"]

        # Lion samurai are renowned across Rokugan for their
        # prowess in war, and Akodo Soldiers are no exception.
        # Almost all are products of the Akodo War College,
        # where they specialize in having no specialization. Each
        # can fill almost any role in the clan's order of battle,
        # wielding any of Akodo's vaunted six weapons of the
        # samurai with equal expertise. They can also provide
        # battlefield medical support and tactical advice.

        PROPERTIES {
            ^"School Name" STRING "Akodo Soldier" FIXED
            ^"Clan" STRING "Lion"
            ^"Roles" LIST ["Bushi"]
            ^"Ring Increase" DEF {
                ^"Fire" INTEGER 1
                ^"Water" INTEGER 1
            }
            ^"Starting Skills" DEF { CHOOSE 5 [^"Command", ^"Fitness", ^"Martial Arts [Melee]", ^"Martial Arts [Ranged]", ^"Martial Arts [Unarmed]", ^"Medicine", ^"Tactics"] INTEGER 1 }
            ^"Starting Honor" INTEGER DEFAULT 50
            ^"Techniques Available" LIST ["Kata", "Rituals", "Shūji"]
        }


        STARTING_TECHNIQUES {
            KATA CHOOSE 1 [^"Striking as Fire", ^"Striking as Water"]
            KATA CHOOSE 1 [^"Crescent Moon Style", ^"Pelting Hail Style"]
        }

        SCHOOL_ABILITY "Drilled Precision" {
            "When making an Attack or Movement action check, you may remove an amount of strife from yourself up to your school rank. For each strife you remove this way, add one kept (ring) set to (op) to the check and receive 1 fatigue."
        }

        MASTERY_ABILITY ^"Strike Without Shadow" {
            "When you succeed at an Attack or Movement action check, you may spend 1 Void point to add bonus successes equal to your ranks in Fitness."
        }
        STARTING_OUTFIT [
            "ashigaru armor", "traveling clothes",
            "daishō (katana and wakizashi)",
            "yumi (bow) with quiver of arrows", "yari (spear)",
            "nodachi (great sword) or nagamaki or nagae yari",
            "yoroidoshi", "knife",
            "battlefield medical pack", "traveling pack"
        ]

        CURRICULUM {
            RANK 1 {
                SKILL_GROUP "Martial Skills"
                SKILL "Command"
                SKILL "Courtesy"
                SKILL "Government"
                TECHNIQUE_GROUP "Rank 1 Kata"
                ^"Tactical Assessment" [kata]
                ^"Righteous Example" [shuji]
            }
            RANK 2 {
                SKILL_GROUP "Social Skills"
                SKILL "Fitness"
                SKILL "Martial Arts [Melee]"
                SKILL "Tactics"
                TECHNIQUE_GROUP "Rank 1-2 Kata"
                ^"Flowing Water Strike" [kata]
                ^"Preserve Strength" [shuji]
            }
            RANK 3 {
                SKILL_GROUP "Martial Skills"
                SKILL "Culture"
                SKILL "Medicine"
                SKILL "Smithing"
                TECHNIQUE_GROUP "Rank 1-3 Kata"
                ^"To Smash the Heart" [shuji]
                ^"Rallying Cry" [shuji]
            }
            RANK 4 {
                SKILL_GROUP "Scholar Skills"
                SKILL "Courtesy"
                SKILL "Martial Arts [Ranged]"
                SKILL "Tactics"
                TECHNIQUE_GROUP "Rank 1-4 Fire Shūji"
                ^"Pin the Fan" [kata]
                ^"Disappearing World Style" [kata]
            }
            RANK 5 {
                SKILL_GROUP "Martial Skills"
                SKILL "Command"
                SKILL "Government"
                SKILL "Sentiment"
                TECHNIQUE_GROUP "Rank 1-5 Kata"
                ^"Moment of Glory" [shuji]
                ^"Striking as Void" [kata]
            }
            RANK 6 {
                ^"Strike Without Shadow"
            }
        }

    }

    ^"Daidoji Harrier" DEF {
        EXTENDS #L5R252wX4yZ6aB8cD0eF2g ^"School"
        APPLIES TO [^"Samurai"]

        # Rumors have long run of Daidoji battlefield agents who
        # gather intelligence and disrupt enemy supply lines. Under
        # the leadership of the most recent Daidoji daimyo, the
        # Harrier corps has become far more effective at ending
        # conflicts before they begin. Through sabotage,
        # assassination, and forgery, a single harrier might negate
        # tens, if not hundreds, of enemy warriors and ensure the
        # Crane Clan is well defended.

        PROPERTIES {
            ^"School Name" STRING "Daidoji Harrier" FIXED
            ^"Clan" STRING "Crane"
            ^"Roles" LIST ["Bushi", "Shinobi"]
            ^"Ring Increase" DEF {
                ^"Air" INTEGER 1
                ^"Fire" INTEGER 1
            }
            ^"Starting Skills" DEF { CHOOSE 5 [^"Culture", ^"Fitness", ^"Martial Arts [Melee]", ^"Martial Arts [Ranged]", ^"Medicine", ^"Sentiment", ^"Skulduggery"] INTEGER 1 }
            ^"Starting Honor" INTEGER DEFAULT 40
            ^"Techniques Available" LIST ["Kata", "Rituals", "Shūji"]
        }


        STARTING_TECHNIQUES {
            KATA CHOOSE 1 [^"Soaring Slice", ^"Striking as Air"]
            NINJUTSU ^"Skulk"
        }

        SCHOOL_ABILITY "Explosive Arrival" {
            "After you perform an Attack action against a target who is Dazed or unaware of your presence, that target receives strife equal to your school rank. If your target is an enemy leader's cohort in a mass battle, the enemy army also receives that much panic."
        }

        MASTERY_ABILITY ^"Spreading Chaos" {
            "After you use your school ability during a duel or skirmish, your target and each other character friendly to them at range 0-3 suffers the Dazed condition. After you use your school ability in a mass battle, the leader of the cohort you targeted suffers the Dazed condition."
        }
        STARTING_OUTFIT [
            "traveling clothes", "common clothes",
            "daishō (katana and wakizashi)",
            "any one weapon of rarity 6 or lower",
            "knife", "traveling pack"
        ]

        CURRICULUM {
            RANK 1 {
                SKILL_GROUP "Trade Skills"
                SKILL "Fitness"
                SKILL "Martial Arts [Melee]"
                SKILL "Martial Arts [Ranged]"
                TECHNIQUE_GROUP "Rank 1 Kata"
                ^"Clouds Parted by Steel" [shuji]
                ^"Swift Scouting" [ninjutsu]
            }
            RANK 2 {
                SKILL_GROUP "Martial Skills"
                SKILL "Government"
                SKILL "Medicine"
                SKILL "Skulduggery"
                TECHNIQUE_GROUP "Rank 1-2 Kata"
                ^"The Patient Viper" [ninjutsu]
                ^"Employ Terrible Thunder" [ninjutsu]
            }
            RANK 3 {
                SKILL_GROUP "Scholar Skills"
                SKILL "Labor"
                SKILL "Martial Arts [Melee]"
                SKILL "Tactics"
                TECHNIQUE_GROUP "Rank 1-3 Air Shūji"
                ^"Imbue Outburst" [ritual]
                ^"Vanish in the Shadows" [ninjutsu]
            }
            RANK 4 {
                SKILL_GROUP "Trade Skills"
                SKILL "Martial Arts [Ranged]"
                SKILL "Medicine"
                SKILL "Sentiment"
                TECHNIQUE_GROUP "Rank 1-4 Kata"
                ^"Wreak Havoc" [ninjutsu]
                ^"Beseech Bayushi's Absolution" [ritual]
            }
            RANK 5 {
                SKILL_GROUP "Martial Skills"
                SKILL "Courtesy"
                SKILL "Medicine"
                SKILL "Survival"
                TECHNIQUE_GROUP "Rank 1-5 Fire Shūji"
                ^"Pin the Fan" [kata]
                ^"Silencing Stroke" [ninjutsu]
            }
            RANK 6 {
                ^"Spreading Chaos"
            }
        }

    }

    ^"Hida Battle Leader" DEF {
        EXTENDS #L5R252wX4yZ6aB8cD0eF2g ^"School"
        APPLIES TO [^"Samurai"]

        # Unlike all other clans, the Crab are continually at war.
        # The Shadowlands never sleeps, so neither can the
        # stalwart samurai who are the primary defenders along
        # the Wall. Hida Battle Leaders oversee this war, and
        # must rely on tactics and sheer grit to counter the
        # overwhelming forces of Fu Leng. These are the most
        # respected commanders of the Crab Clan, as adept on
        # a tactical board as they are on the field of battle.

        PROPERTIES {
            ^"School Name" STRING "Hida Battle Leader" FIXED
            ^"Clan" STRING "Crab"
            ^"Roles" LIST ["Bushi", "Courtier"]
            ^"Ring Increase" DEF {
                ^"Earth" INTEGER 1
                ^"Void" INTEGER 1
            }
            ^"Starting Skills" DEF { CHOOSE 5 [^"Command", ^"Fitness", ^"Games", ^"Government", ^"Martial Arts [Melee]", ^"Sentiment", ^"Tactics"] INTEGER 1 }
            ^"Starting Honor" INTEGER DEFAULT 55
            ^"Techniques Available" LIST ["Kata", "Rituals", "Shūji"]
        }


        STARTING_TECHNIQUES {
            KATA ^"Tactical Assessment"
            SHUJI CHOOSE 1 [^"Fortress of Necessity", ^"Stonewall Tactics", ^"Weight of Duty"]
        }

        SCHOOL_ABILITY "Thunderous Courage" {
            "Once per scene after you perform a Support action, you may choose any number of characters within a number of range bands equal to your ranks in Command. Each chosen character treats their composure as increased by your school rank. This effect persists until the end of the scene. During a mass battle, if you are a leader, your army treats its discipline as increased by your school rank."
        }

        MASTERY_ABILITY ^"Unbreakable Resolve" {
            "Compromised characters affected by your school ability can keep a number of dice containing (st) up to your ranks in Command."
        }
        STARTING_OUTFIT [
            "lacquered armor", "traveling clothes",
            "daishō (katana and wakizashi)",
            "any two weapons of rarity 7 or lower",
            "finger of jade", "tessen or gunbai",
            "several scrolls of battle tactics", "traveling pack"
        ]

        CURRICULUM {
            RANK 1 {
                SKILL_GROUP "Social Skills"
                SKILL "Fitness"
                SKILL "Martial Arts [Melee]"
                SKILL "Tactics"
                TECHNIQUE_GROUP "Rank 1 Kata"
                ^"Beseech Hida's Might" [ritual]
                ^"Battle of No Escape" [shuji]
            }
            RANK 2 {
                SKILL_GROUP "Martial Skills"
                SKILL "Command"
                SKILL "Games"
                SKILL "Sentiment"
                TECHNIQUE_GROUP "Rank 1-2 Earth Shūji"
                ^"Great Anvil's Measure" [shuji]
                ^"Beseech Shiba's Calm" [ritual]
            }
            RANK 3 {
                SKILL_GROUP "Trade Skills"
                SKILL "Command"
                SKILL "Performance"
                SKILL "Tactics"
                TECHNIQUE_GROUP "Rank 1-3 Kata"
                ^"The Patient Viper" [ninjutsu]
                ^"Beseech Akodo's Judgment" [ritual]
            }
            RANK 4 {
                SKILL_GROUP "Martial Skills"
                SKILL "Command"
                SKILL "Medicine"
                SKILL "Smithing"
                TECHNIQUE_GROUP "Rank 1-4 Void Shūji"
                ^"Striking as Void" [kata]
                ^"Steady the Hammer" [shuji]
            }
            RANK 5 {
                SKILL_GROUP "Social Skills"
                SKILL "Fitness"
                SKILL "Sentiment"
                SKILL "Tactics"
                TECHNIQUE_GROUP "Rank 1-5 Earth Shūji"
                ^"Rouse the Soul" [shuji]
                ^"The Immovable Hand of Peace" [shuji]
            }
            RANK 6 {
                ^"Unbreakable Resolve"
            }
        }

    }

    ^"Ichiro Grappler" DEF {
        EXTENDS #L5R252wX4yZ6aB8cD0eF2g ^"School"
        APPLIES TO [^"Samurai"]

        # Sumai is a very serious sport in most of Rokugan, with
        # traditions and rituals that date back hundreds of years.
        # Few are as devoted to it as the Badger and Crab Clans.
        # Those who train exclusively as Ichiro Grapplers apply
        # their skills in all aspects of their lives, fending off gaijin
        # invaders just as they stand firm against their opponents
        # in wrestling matches. In battle, a skilled Grappler needs
        # no weapons other than their tenacious grip and
        # immovable body to ensure none of their foes pass.

        PROPERTIES {
            ^"School Name" STRING "Ichiro Grappler" FIXED
            ^"Clan" STRING "Badger"
            ^"Roles" LIST ["Bushi"]
            ^"Ring Increase" DEF {
                ^"Earth" INTEGER 1
                ^"Water" INTEGER 1
            }
            ^"Starting Skills" DEF { CHOOSE 5 [^"Fitness", ^"Games", ^"Martial Arts [Unarmed]", ^"Meditation", ^"Performance", ^"Survival", ^"Tactics"] INTEGER 1 }
            ^"Starting Honor" INTEGER DEFAULT 45
            ^"Techniques Available" LIST ["Kata", "Rituals", "Shūji"]
        }


        STARTING_TECHNIQUES {
            KATA ^"Fierce Badger Style"
            SHUJI CHOOSE 1 [^"All in Jest", ^"Honest Assessment"]
        }

        SCHOOL_ABILITY "Badger's Hold" {
            "After you succeed at an Attack action check using the Martial Arts [Unarmed] skill, if the target is Immobilized or Prone, they also receive fatigue equal to your school rank."
        }

        MASTERY_ABILITY ^"Killing Grip" {
            "When you inflict a critical strike on a target, if the target is Immobilized or Prone, you may receive 3 fatigue to increase the severity of the critical strike by two times your ranks in Fitness."
        }
        STARTING_OUTFIT [
            "ashigaru armor", "traveling clothes",
            "daishō (katana and wakizashi)", "sumai garb",
            "small drum", "Ichiro sapper ax",
            "traveling pack"
        ]

        CURRICULUM {
            RANK 1 {
                SKILL_GROUP "Martial Skills"
                SKILL "Games"
                SKILL "Labor"
                SKILL "Theology"
                TECHNIQUE_GROUP "Rank 1 Kata"
                ^"Lord Hida's Grip" [kata]
                ^"Open-Hand Style" [kata]
            }
            RANK 2 {
                SKILL_GROUP "Social Skills"
                SKILL "Fitness"
                SKILL "Martial Arts [Unarmed]"
                SKILL "Medicine"
                TECHNIQUE_GROUP "Rank 1-2 Earth Shūji"
                ^"Beseech Hida's Might" [ritual]
                ^"Thicket's Embrace Style" [kata]
            }
            RANK 3 {
                SKILL_GROUP "Scholar Skills"
                SKILL "Fitness"
                SKILL "Meditation"
                SKILL "Performance"
                TECHNIQUE_GROUP "Rank 1-3 Kata"
                ^"Your Enemy's Arrows" [shuji]
                ^"Shattering Tide Style" [kata]
            }
            RANK 4 {
                SKILL_GROUP "Martial Skills"
                SKILL "Games"
                SKILL "Sentiment"
                SKILL "Theology"
                TECHNIQUE_GROUP "Rank 1-4 Water Shūji"
                ^"The Patient Viper" [ninjutsu]
                ^"Steady the Hammer" [shuji]
            }
            RANK 5 {
                SKILL_GROUP "Social Skills"
                SKILL "Culture"
                SKILL "Fitness"
                SKILL "Martial Arts [Unarmed]"
                TECHNIQUE_GROUP "Rank 1-5 Kata"
                ^"Victory Without a Sword" [shuji]
                ^"Soul Sunder" [kata]
            }
            RANK 6 {
                ^"Killing Grip"
            }
        }

    }

    ^"Ichiro Ironsmith" DEF {
        EXTENDS #L5R252wX4yZ6aB8cD0eF2g ^"School"
        APPLIES TO [^"Samurai"]

        # While the Kakita and other swordsmith schools produce
        # weapons that are unparalleled works of art, the hard
        # realities of life in the mountains means a different path
        # for the Ichiro. There is little call for art in this school,
        # which concentrates on weapons and armor as tough and
        # reliable as the rugged hills the Badger call home. Ichiro
        # Ironsmiths are also famous for the speed with which
        # they produce weaponry, something the Lion Clan relies
        # upon greatly to arm its legions of ashigaru.

        PROPERTIES {
            ^"School Name" STRING "Ichiro Ironsmith" FIXED
            ^"Clan" STRING "Badger"
            ^"Roles" LIST ["Artisan", "Courtier"]
            ^"Ring Increase" DEF {
                ^"Water" INTEGER 1
                ^"Void" INTEGER 1
            }
            ^"Starting Skills" DEF { CHOOSE 5 [^"Commerce", ^"Courtesy", ^"Fitness", ^"Labor", ^"Martial Arts [Melee]", ^"Martial Arts [Unarmed]", ^"Smithing"] INTEGER 1 }
            ^"Starting Honor" INTEGER DEFAULT 40
            ^"Techniques Available" LIST ["Kata", "Rituals", "Shūji"]
            ^"Starting Patterns" STRING "Ichiro Pattern"
        }


        STARTING_TECHNIQUES {
            SHUJI CHOOSE 2 [^"Coursing March Chant", ^"Courtier's Resolve", ^"Honest Assessment", ^"Stirring the Embers"]
        }

        SCHOOL_ABILITY "Hide of Iron" {
            "Once per game session when you make a check to craft, improve, or maintain a weapon or set of armor, you may receive an amount of fatigue up to your school rank to reroll that many dice."
        }

        MASTERY_ABILITY ^"Tenacity of the Forge" {
            "When you create a new set of armor, you may apply two different patterns you know to it (instead of one)."
        }
        STARTING_OUTFIT [
            "traveling clothes", "common clothes",
            "wakizashi (short sword)",
            "any one weapon of rarity 6 or lower",
            "smithing hammer", "Ichiro sapper axe",
            "traveling pack"
        ]

        CURRICULUM {
            RANK 1 {
                SKILL_GROUP "Artisan Skills"
                SKILL "Fitness"
                SKILL "Martial Arts [Unarmed]"
                SKILL "Survival"
                TECHNIQUE_GROUP "Rank 1 Water Shūji"
                ^"Fierce Badger Style" [kata]
                ^"Fortress of Necessity" [shuji]
            }
            RANK 2 {
                SKILL_GROUP "Social Skills"
                SKILL "Commerce"
                SKILL "Fitness"
                SKILL "Smithing"
                TECHNIQUE_GROUP "Rank 1-2 Kata"
                ^"Shattering Tide Style" [kata]
                ^"Great Anvil's Measure" [shuji]
            }
            RANK 3 {
                SKILL_GROUP "Artisan Skills"
                SKILL "Culture"
                SKILL "Labor"
                SKILL "Survival"
                TECHNIQUE_GROUP "Rank 1-3 Rituals"
                ^"A Samurai's Fate" [shuji]
                ^"Thicket's Embrace Style" [kata]
            }
            RANK 4 {
                SKILL_GROUP "Martial Skills"
                SKILL "Command"
                SKILL "Government"
                SKILL "Smithing"
                TECHNIQUE_GROUP "Rank 1-4 Void Shūji"
                ^"Striking as Void" [kata]
                ^"Your Enemy's Arrows" [shuji]
            }
            RANK 5 {
                SKILL_GROUP "Artisan Skills"
                SKILL "Courtesy"
                SKILL "Fitness"
                SKILL "Martial Arts [Melee]"
                TECHNIQUE_GROUP "Rank 1-5 Water Shūji"
                ^"Wreak Havoc" [ninjutsu]
                ^"Rouse the Soul" [shuji]
            }
            RANK 6 {
                ^"Tenacity of the Forge"
            }
        }

    }

    ^"Ide Messenger" DEF {
        EXTENDS #L5R252wX4yZ6aB8cD0eF2g ^"School"
        APPLIES TO [^"Samurai"]

        # Ide Messengers call upon the powerful steeds of the
        # Unicorn Clan to allow them to traverse the Emerald
        # Empire with information useful to their clan. They do
        # more than simply carry messages. They carefully
        # interpret these messages so as to ensure that
        # information can convey multiple layers of meaning for
        # both originator and recipient. The grace and subtlety
        # these diplomats display is legendary, as the Messengers
        # use their travels to gather information useful for the
        # Unicorn in both courts and battlefields.

        PROPERTIES {
            ^"School Name" STRING "Ide Messenger" FIXED
            ^"Clan" STRING "Unicorn"
            ^"Roles" LIST ["Courtier"]
            ^"Ring Increase" DEF {
                ^"Earth" INTEGER 1
                ^"Void" INTEGER 1
            }
            ^"Starting Skills" DEF { CHOOSE 5 [^"Courtesy", ^"Fitness", ^"Government", ^"Martial Arts [Ranged]", ^"Performance", ^"Sentiment", ^"Survival"] INTEGER 1 }
            ^"Starting Honor" INTEGER DEFAULT 50
            ^"Techniques Available" LIST ["Kata", "Rituals", "Shūji"]
        }


        STARTING_TECHNIQUES {
            SHUJI ^"Lady Shinjo's Speed"
            SHUJI CHOOSE 1 [^"Courtier's Resolve", ^"Honest Assessment"]
        }

        SCHOOL_ABILITY "Sympathetic Bearing" {
            "After you make a check for Initiative (or enter the scene, for a narrative scene), you may choose another character in the scene. That character removes strife equal to your school rank, and you reduce the TN of your next Social skill check targeting that character by 2."
        }

        MASTERY_ABILITY ^"The Herd Flourishes Together" {
            "When you make a Social skill check, you may spend (op) as follows: (op)(op): Choose another character's social objective that you know. You may transfer any number of momentum points you have accrued to the completion of their objective. After that character completes their objective, you gain the Support of [That Character's Group] advantage if you do not have it already."
        }
        STARTING_OUTFIT [
            "traveling clothes", "wakizashi (short sword)",
            "yumi (bow) and quiver of arrows",
            "satchel of messages", "calligraphy set",
            "knife", "Unicorn warhorse", "traveling pack"
        ]

        CURRICULUM {
            RANK 1 {
                SKILL_GROUP "Social Skills"
                SKILL "Composition"
                SKILL "Fitness"
                SKILL "Survival"
                TECHNIQUE_GROUP "Rank 1 Earth Shūji"
                ^"Beseech Shinjo's Empathy" [ritual]
                ^"Swift Scouting" [ninjutsu]
            }
            RANK 2 {
                SKILL_GROUP "Trade Skills"
                SKILL "Martial Arts [Melee]"
                SKILL "Performance"
                SKILL "Sentiment"
                TECHNIQUE_GROUP "Rank 1-2 Water Shūji"
                ^"Call the Wild" [shuji]
                ^"Beseech Doji's Wisdom" [ritual]
            }
            RANK 3 {
                SKILL_GROUP "Artisan Skills"
                SKILL "Courtesy"
                SKILL "Performance"
                SKILL "Survival"
                TECHNIQUE_GROUP "Rank 1-3 Rituals"
                ^"Regal Bearing" [shuji]
                ^"Rallying Cry" [shuji]
            }
            RANK 4 {
                SKILL_GROUP "Scholar Skills"
                SKILL "Command"
                SKILL "Composition"
                SKILL "Martial Arts [Ranged]"
                TECHNIQUE_GROUP "Rank 1-4 Void Shūji"
                ^"Rouse the Soul" [shuji]
                ^"Vanish in the Shadows" [ninjutsu]
            }
            RANK 5 {
                SKILL_GROUP "Social Skills"
                SKILL "Culture"
                SKILL "Fitness"
                SKILL "Survival"
                TECHNIQUE_GROUP "Rank 1-5 Air Shūji"
                ^"Buoyant Arrival" [shuji]
                ^"Striking as Void" [kata]
            }
            RANK 6 {
                ^"The Herd Flourishes Together"
            }
        }

    }

    ^"Isawa Tensai" DEF {
        EXTENDS #L5R252wX4yZ6aB8cD0eF2g ^"School"
        APPLIES TO [^"Samurai"]

        # The shugenja of the Isawa Tensai School practice an
        # even more elite and specialized path than other Isawa
        # schools. Isawa Tensai concentrate on a single element
        # with which they have a natural affinity. This allows them
        # to focus their energies upon that element and develop
        # a unique link to the kami who embody it, letting them
        # wield powers few can match.

        PROPERTIES {
            ^"School Name" STRING "Isawa Tensai" FIXED
            ^"Clan" STRING "Phoenix"
            ^"Roles" LIST ["Shugenja"]
            ^"Ring Increase" DEF { CHOOSE 1 [^"Air", ^"Earth", ^"Fire", ^"Water", ^"Void"] INTEGER 2 }
            ^"Starting Skills" DEF { CHOOSE 3 [^"Courtesy", ^"Martial Arts [Unarmed]", ^"Meditation", ^"Sentiment", ^"Survival", ^"Theology"] INTEGER 1 }
            ^"Starting Honor" INTEGER DEFAULT 50
            ^"Techniques Available" LIST ["Invocations", "Rituals", "Shūji"]
        }


        STARTING_TECHNIQUES {
            INVOCATION CHOOSE 1 [^"Any one rank 1 invocation of your inspired element"]
            RITUAL CHOOSE 2 [^"Cleansing Rite", ^"Commune with the Spirits", ^"Threshold Barrier"]
            SHUJI CHOOSE 2 [^"Ancestry Unearthed", ^"Borrowed Courage", ^"Truth Burns through Lies", ^"Shallow Waters"]
        }

        SCHOOL_ABILITY "Elemental Inspiration" {
            "Choose one: Air, Earth, Water, or Fire. This is your inspired element. When making a check to activate an invocation of your inspired element, add a number of rolled (ring) set to (op) results equal to your school rank. When making a check to activate an invocation of your inspired element, you trigger spiritual backlash only if you keep four or more dice containing (st) symbols (instead of three or more). When making a check to activate an invocation not of your inspired element, you trigger spiritual backlash if you keep two or more dice containing (st) symbols (instead of three or more)."
        }

        MASTERY_ABILITY ^"Attuned Invocation" {
            "Once per scene, when making a check to activate an invocation of your inspired element, you may spend 1 Void point. If you do, you may keep any number of your rolled dice (instead of a number up to your ring value)."
        }
        STARTING_OUTFIT [
            "sanctified robes", "traveling clothes",
            "wakizashi (short sword)", "scroll satchel",
            "traveling pack"
        ]

        CURRICULUM {
            RANK 1 {
                SKILL_GROUP "Scholar Skills"
                SKILL "Courtesy"
                SKILL "Meditation"
                SKILL "Survival"
                TECHNIQUE_GROUP "Rank 1-2 Inspired Element Invocations"
                ^"Sting of Warrior's Pride" [shuji]
                ^"Divination" [ritual]
            }
            RANK 2 {
                SKILL_GROUP "Social Skills"
                SKILL "Culture"
                SKILL "Martial Arts [Unarmed]"
                SKILL "Theology"
                TECHNIQUE_GROUP "Rank 1-3 Inspired Element Invocations"
                ^"Beseech Shiba's Calm" [ritual]
                ^"Open-Hand Style" [kata]
            }
            RANK 3 {
                SKILL_GROUP "Martial Skills"
                SKILL "Performance"
                SKILL "Sentiment"
                SKILL "Theology"
                TECHNIQUE_GROUP "Rank 1-4 Inspired Element Invocations"
                ^"Incite True Nature" [shuji]
                ^"Battle in the Mind" [kata]
            }
            RANK 4 {
                SKILL_GROUP "Scholar Skills"
                SKILL "Fitness"
                SKILL "Meditation"
                SKILL "Survival"
                TECHNIQUE_GROUP "Rank 1-5 Inspired Element Invocations"
                ^"A Samurai's Fate" [shuji]
                ^"Pillar of Calm" [shuji]
            }
            RANK 5 {
                SKILL_GROUP "Social Skills"
                SKILL "Government"
                SKILL "Sentiment"
                SKILL "Theology"
                TECHNIQUE_GROUP "Rank 1-5 Inspired Element Invocations"
                ^"Rouse the Soul" [shuji]
                ^"Striking as Void" [kata]
            }
            RANK 6 {
                ^"Attuned Invocation"
            }
        }

    }

    ^"Matsu Beastmaster" DEF {
        EXTENDS #L5R252wX4yZ6aB8cD0eF2g ^"School"
        APPLIES TO [^"Samurai"]

        # All Matsu bushi are ferocious warriors, but Beastmasters
        # are doubly dangerous, for they always have devoted
        # animal companions fighting at their sides. This school
        # teaches how to strengthen what could be an existing
        # bond between human and beast. Their combined roar
        # as they charge into battle is often enough to send
        # lesser samurai running before steel or fang have even
        # reached them.

        PROPERTIES {
            ^"School Name" STRING "Matsu Beastmaster" FIXED
            ^"Clan" STRING "Lion"
            ^"Roles" LIST ["Bushi"]
            ^"Ring Increase" DEF {
                ^"Fire" INTEGER 1
                ^"Water" INTEGER 1
            }
            ^"Starting Skills" DEF { CHOOSE 5 [^"Fitness", ^"Martial Arts [Melee]", ^"Medicine", ^"Meditation", ^"Performance", ^"Sentiment", ^"Survival"] INTEGER 1 }
            ^"Starting Honor" INTEGER DEFAULT 45
            ^"Techniques Available" LIST ["Kata", "Rituals", "Shūji"]
            ^"Starting Advantage" STRING "Animal Bond"
        }


        STARTING_TECHNIQUES {
            KATA ^"Warrior's Resolve"
            SHUJI CHOOSE 2 [^"Coursing March Chant", ^"Righteous Example", ^"Sensational Distraction"]
        }

        SCHOOL_ABILITY "One with the Pride" {
            "Increase each of your bonded animals' endurance, composure, and ranks in Martial skill group by an amount equal to your school rank (its skill ranks still cannot exceed 5). If a bonded animal is a minion, it becomes an adversary instead."
        }

        MASTERY_ABILITY ^"With the Soul of a Lion" {
            "After you perform an Attack action, each of your bonded animals may perform an Attack action against the same target, if able. If your attack action did not succeed, reduce the TN of each of your bonded animals' Attack action check by 2."
        }
        STARTING_OUTFIT [
            "ashigaru armor", "traveling clothes",
            "daishō (katana and wakizashi)",
            "zanbato or nagae yari or nagamaki",
            "yoroidoshi", "1-2 bonded animals",
            "traveling pack"
        ]

        CURRICULUM {
            RANK 1 {
                SKILL_GROUP "Martial Skills"
                SKILL "Command"
                SKILL "Culture"
                SKILL "Survival"
                TECHNIQUE_GROUP "Rank 1 Kata"
                ^"Lightning Raid" [shuji]
                ^"Beseech Shinjo's Empathy" [ritual]
            }
            RANK 2 {
                SKILL_GROUP "Trade Skills"
                SKILL "Fitness"
                SKILL "Martial Arts [Melee]"
                SKILL "Sentiment"
                TECHNIQUE_GROUP "Rank 1-2 Fire Shūji"
                ^"Call the Wild" [shuji]
                ^"Lord Akodo's Roar" [shuji]
            }
            RANK 3 {
                SKILL_GROUP "Martial Skills"
                SKILL "Courtesy"
                SKILL "Medicine"
                SKILL "Performance"
                TECHNIQUE_GROUP "Rank 1-3 Kata"
                ^"Beseech Akodo's Judgment" [ritual]
                ^"Swift Scouting" [ninjutsu]
            }
            RANK 4 {
                SKILL_GROUP "Scholar Skills"
                SKILL "Command"
                SKILL "Martial Arts [Unarmed]"
                SKILL "Survival"
                TECHNIQUE_GROUP "Rank 1-4 Water Shūji"
                ^"To Smash the Heart" [shuji]
                ^"Vanish in the Shadows" [ninjutsu]
            }
            RANK 5 {
                SKILL_GROUP "Martial Skills"
                SKILL "Culture"
                SKILL "Survival"
                SKILL "Theology"
                TECHNIQUE_GROUP "Rank 1-5 Kata"
                ^"Sear the Wound" [shuji]
                ^"Wreak Havoc" [ninjutsu]
            }
            RANK 6 {
                ^"With the Soul of a Lion"
            }
        }

    }

    ^"Yogo Penitent Order" DEF {
        EXTENDS #L5R252wX4yZ6aB8cD0eF2g ^"School"
        APPLIES TO [^"Samurai"]

        # Stories say that when the Yogo curse comes to pass
        # in a betrayal too painful to bear, the betrayer may be
        # offered a place in the Penitent Order. In monasteries
        # scattered across Scorpion lands, these monks train
        # their skills to a razor's edge. Unlike many other monks,
        # who look inward for Enlightenment, those belonging
        # to the Yogo Penitent Order seek redemption through
        # service. Anyone who makes the pilgrimage to one of
        # these hidden monasteries may plead their case to the
        # Order. If the Order agrees the cause serves the good
        # of Rokugan, it dispatches a deadly agent who serves
        # that person's cause, even unto death.

        PROPERTIES {
            ^"School Name" STRING "Yogo Penitent Order" FIXED
            ^"Clan" STRING "Scorpion"
            ^"Roles" LIST ["Bushi", "Monk"]
            ^"Ring Increase" DEF {
                ^"Air" INTEGER 1
                ^"Void" INTEGER 1
            }
            ^"Starting Skills" DEF { CHOOSE 4 [^"Fitness", ^"Martial Arts [Melee]", ^"Martial Arts [Unarmed]", ^"Meditation", ^"Survival", ^"Theology"] INTEGER 1 }
            ^"Starting Honor" INTEGER DEFAULT 40
            ^"Techniques Available" LIST ["Kata", "Kihō", "Rituals"]
            ^"Starting Disadvantage" STRING "Dark Secret or another disadvantage suitable to your past betrayal"
        }


        STARTING_TECHNIQUES {
            KATA CHOOSE 1 [^"Iron Forest Style", ^"Veiled Menace Style"]
            KIHO CHOOSE 1 [^"Air Fist", ^"The Great Silence"]
            RITUAL ^"Divination"
            RITUAL ^"Threshold Barrier"
        }

        SCHOOL_ABILITY "Oath of Sacrifice" {
            "Once per scene, after you defend against damage or suffer a critical strike, you may unleash your current kihō. Immediately end its enhancement effect, then resolve its burst effect as if you had a number of bonus successes equal to your school rank plus the amount of fatigue you received or the severity of the critical strike you suffered. If the burst effect has one or more targets, you may choose appropriate targets in range. If you have used this ability already this scene, you may spend 1 Void point to use it again this scene (you can do this any number of times, provided you have Void points to spend)."
        }

        MASTERY_ABILITY ^"Empty Soul Ki" {
            "When you defend against damage, if all your Void Points are spent, treat your physical and supernatural resistances as being equal to your Void ring."
        }
        STARTING_OUTFIT [
            "common clothes", "bō (staff) or yari (spear)",
            "3 shuriken (throwing stars)", "knife",
            "traveling pack"
        ]

        CURRICULUM {
            RANK 1 {
                SKILL_GROUP "Martial Skills"
                SKILL "Labor"
                SKILL "Skulduggery"
                SKILL "Theology"
                TECHNIQUE_GROUP "Rank 1 Kata"
                ^"Skulk" [ninjutsu]
                ^"Swift Scouting" [ninjutsu]
            }
            RANK 2 {
                SKILL_GROUP "Scholar Skills"
                SKILL "Command"
                SKILL "Martial Arts [Unarmed]"
                SKILL "Meditation"
                TECHNIQUE_GROUP "Rank 1-2 Air Kihō"
                ^"Beseech Bayushi's Absolution" [ritual]
                ^"The Patient Viper" [ninjutsu]
            }
            RANK 3 {
                SKILL_GROUP "Artisan Skills"
                SKILL "Fitness"
                SKILL "Martial Arts [Melee]"
                SKILL "Skulduggery"
                TECHNIQUE_GROUP "Rank 1-3 Kata"
                ^"Entice with Falsehoods" [shuji]
                ^"Still the Elements" [kiho]
            }
            RANK 4 {
                SKILL_GROUP "Scholar Skills"
                SKILL "Martial Arts [Unarmed]"
                SKILL "Meditation"
                SKILL "Survival"
                TECHNIQUE_GROUP "Rank 1-4 Kata"
                ^"Vanish in the Shadows" [ninjutsu]
                ^"Moment of Glory" [shuji]
            }
            RANK 5 {
                SKILL_GROUP "Martial Skills"
                SKILL "Courtesy"
                SKILL "Culture"
                SKILL "Theology"
                TECHNIQUE_GROUP "Rank 1-5 Void Kihō"
                ^"Silencing Stroke" [ninjutsu]
                ^"Striking as Void" [kata]
            }
            RANK 6 {
                ^"Empty Soul Ki"
            }
        }

    }

    # ===========================
    # NEW ADVANTAGES: DISTINCTIONS
    # ===========================

    ^"Guiding Ancestor" DEF {
        EXTENDS #L5R266oP8qR0sT2uV4wX6y ^"Distinction"

        PROPERTIES {
            ^"Ring" STRING "Void"
            ^"Types" LIST ["Spiritual"]
        }

        EFFECT {
            "You are watched over by a benevolent ancestor spirit, or sorei, who has high hopes for you and your deeds. The spirit cannot communicate directly but may send cryptic omens in dreams and strange phenomena to help you achieve a great destiny."
            "When you make a check to interpret omens or to intuit a course of action (such as a Theology [Void] check to understand your dreams or a Tactics [Void] check to guess the plans of an unknown enemy general), you may reroll up to two dice."
        }
    }

    ^"Traditional Adherent" DEF {
        EXTENDS #L5R266oP8qR0sT2uV4wX6y ^"Distinction"

        PROPERTIES {
            ^"Ring" STRING "Earth"
            ^"Types" LIST ["Mental"]
        }

        EFFECT {
            "You have a mastery of tradition and routine, and are able to perform ceremonies and social functions exactly as you were taught without variation, even under trying circumstances."
            "When you make a check to maintain the traditions of the past (such as a Performance [Earth] check to recite a poem in a style long-since out of fashion in the courts, or a Composition [Earth] check to examine a historical account for inconsistencies), you may reroll up to two dice."
        }
    }

    # ===========================
    # NEW ADVANTAGES: PASSIONS
    # ===========================

    ^"Ancestry" DEF {
        EXTENDS #L5R267zA9bC1dE3fG5hI7j ^"Passion"

        PROPERTIES {
            ^"Ring" STRING "Earth"
            ^"Types" LIST ["Mental"]
        }

        EFFECT {
            "The recollection of lineages comes easily to you. You know your own family history as far back as it has been recorded, and can swiftly recall the lineages of notable figures in Rokugan's history."
            "After performing a check to recall or determine the family history of another character (such as a Government [Earth] check to remember a past daimyo of a family, or a Command [Earth] check to remind a subordinate of the expectations their ancestors would have of them), you remove 3 strife."
        }
    }

    ^"Glorious Deeds" DEF {
        EXTENDS #L5R267zA9bC1dE3fG5hI7j ^"Passion"

        PROPERTIES {
            ^"Ring" STRING "Fire"
            ^"Types" LIST ["Martial", "Social"]
        }

        EFFECT {
            "You find risking your life to be a simple matter, as long as there is a witness to remember your bravery. No threat or challenge deters you if you might be remembered for it, making even the most daunting tasks easy ones for which to prepare."
            "After performing a check to improve your reputation or gain fame as a great samurai (such as a Performance [Fire] check to impress a court with your new melody, or a Tactics [Fire] check to execute a daring raid on the enemy), you remove 3 strife."
        }
    }

    # ===========================
    # NEW DISADVANTAGES: ADVERSITIES
    # ===========================

    ^"Blood Feud" DEF {
        EXTENDS #L5R268kL0mN2oP4qR6sT8u ^"Adversity"

        PROPERTIES {
            ^"Ring" STRING "Water"
            ^"Types" LIST ["Interpersonal", "Social"]
        }

        EFFECT {
            "Your bloodline is locked in a deadly struggle with another family or group, which makes members of that group hostile when they learn your affiliation. They may bar you from their courts and homes, refuse to meet with you, or even challenge you to duels over slights in which you had no personal involvement. Confer with the GM to select a campaign-appropriate family or group."
            "When performing a check to interact with the chosen group that relies on their goodwill toward members of your family (such as a Courtesy [Water] check to seek hospitality or a Performance [Water] check to impress them with a song attributed to your family name), you must choose and reroll two dice containing (su) or (ex). After resolving the check, if you failed, you gain 1 Void point."
        }
    }

    # ===========================
    # NEW DISADVANTAGES: ANXIETIES
    # ===========================

    ^"Belligerent" DEF {
        EXTENDS #L5R269vW1xY3zA5bC7dE9f ^"Anxiety"

        PROPERTIES {
            ^"Ring" STRING "Earth"
            ^"Types" LIST ["Interpersonal"]
        }

        EFFECT {
            "You find it nearly impossible to keep your cool when provoked, and may even look for an excuse to fight with people you consider deserving of a good thrashing."
            "After performing a check to respond to provocation without resorting to violence or threats (such as a Performance [Earth] check to calmly sing a song that was originally composed to paint your lineage in an unflattering light or a Meditation [Earth] check to stay in formation when you spot a rival across the battlefield), you receive 3 strife. If this is the first time this scene, gain 1 Void point."
        }
    }

    ^"Braggart" DEF {
        EXTENDS #L5R269vW1xY3zA5bC7dE9f ^"Anxiety"

        PROPERTIES {
            ^"Ring" STRING "Water"
            ^"Types" LIST ["Interpersonal"]
        }

        EFFECT {
            "You can't resist an opportunity to share your great deeds with others, and you grow distressed when your audience isn't impressed by your accomplishments."
            "After performing a check to share your past deeds with others without emphasizing your own accomplishments or trying to impress your audience with your story (such as a Courtesy [Water] check to allow a superior to take credit for your deeds or a Performance [Water] check when recounting a tale in which you played a part), you receive 3 strife. If this is the first time this scene, gain 1 Void point."
        }
    }

    # ===========================
    # NEW SAMURAI HERITAGES
    # ===========================

    ^"Fields of Victory Heritages" DEF {
        APPLIES TO [^"Samurai"]

        # New heritages for samurai with ancestral connections
        # to the Lion Clan or to famous masters of the battlefield.
        # Used instead of the core rulebook heritage table.

        ENTRIES {
            ^"Born on the Battlefield (Roll 1)" {
                ^"Description" STRING "One of your ancestors was born amid war and bloodshed, even if not literally on the front lines. The omens of your birth reflect an affinity for that ancestor."
                ^"Modifier" STRING "Decrease glory by 3"
                ^"Effect" STRING "You gain the Guiding Ancestor (Void) distinction."
            }

            ^"Strategic Mastermind (Roll 2)" {
                ^"Description" STRING "You are descended from a warrior known for their cunning and wartime acumen."
                ^"Modifier" STRING "Increase glory by 5, decrease honor by 5"
                ^"Effect" STRING "Roll d10 for skill: 1-2 Tactics, 3-4 Command, 5-6 Government, 7-8 Culture, 9 Commerce, 10 Theology; gain +1 rank in that skill."
            }

            ^"Victory against the Crane (Roll 3)" {
                ^"Description" STRING "In your family, one of your ancestors held a decisive victory over the Crane."
                ^"Modifier" STRING "Increase glory by 3"
                ^"Effect" STRING "Roll d10 for family heirloom: 1-3 a weapon, 4-6 a game set of your choice, 7-8 some other item relevant to your ancestor's victory, 9 a horse or other animal, 10 the deed to a small piece of land on the border of Crane territory. This item is a battlefield heirloom."
            }

            ^"Victory against Invaders (Roll 4)" {
                ^"Description" STRING "The Lion Clan's foremost duty is to protect the Empire from outside threats, and one of your kin acquitted themselves honorably in this endeavor long ago."
                ^"Modifier" STRING "Increase honor by 3"
                ^"Effect" STRING "Roll d10 for skill: 1-2 Command, 3-4 Government, 5-6 Tactics, 7-8 Survival, 9 Theology, 10 Meditation; gain +1 rank in that skill."
            }

            ^"Shamed by Defeat (Roll 5)" {
                ^"Description" STRING "Among your kin is one who failed the clan. Whether beaten in battle or a duel, humiliated in court, or something else, the need to redeem your line burns within you."
                ^"Modifier" STRING "Decrease glory by 3"
                ^"Effect" STRING "Choose one of the starting skills for your school in which your character has no ranks; gain +1 rank in that skill."
            }

            ^"Blade of 10,000 Battles (Roll 6)" {
                ^"Description" STRING "You have been entrusted with a storied weapon with an ancient history and lineage, and you must prove yourself worthy to continue its legacy."
                ^"Modifier" STRING "Increase glory by 3"
                ^"Effect" STRING "Choose a weapon and add it to your starting outfit. This item is a battlefield heirloom."
            }

            ^"Lost Heirloom (Roll 7)" {
                ^"Description" STRING "An ancestor of yours was once entrusted with a peerless weapon, but through their own failure, they lost it. It has fallen to you to recover it."
                ^"Modifier" STRING "Increase honor by 5, decrease glory by 3"
                ^"Effect" STRING "Choose a weapon to be the lost heirloom, now held by some individual or group hostile to you or your clan. This item is a battlefield heirloom."
            }

            ^"Selfless Sentinel (Roll 8)" {
                ^"Description" STRING "Your ancestor was not well-known or highly favored, but they served with honor, if not glory, and protected Lion lands from attack for all their life."
                ^"Modifier" STRING "Increase honor by 5, decrease glory by 3"
                ^"Effect" STRING "Gain the Traditional Adherent (Earth) distinction."
            }

            ^"Mighty Conqueror (Roll 9)" {
                ^"Description" STRING "One of your ancestors once seized a valuable prize for the Lion Clan in a past war, such as a village, castle, or valuable hostage."
                ^"Modifier" STRING "Increase glory by 3, decrease honor by 3"
                ^"Effect" STRING "Choose one: double your starting koku, add one item of rarity 6 or lower to your starting items that is a battlefield heirloom, or gain the Glorious Deeds passion."
            }

            ^"Right Hand of the Emperor (Roll 10)" {
                ^"Description" STRING "The crowning glory of your line is the victory one of your ancestors won in the name of a past Emperor."
                ^"Modifier" STRING "Increase status by 3"
                ^"Effect" STRING "Gain the Support of [One Group] distinction. The group chosen must be the Seppun, Otomo, or Miya family, or the Imperial Legions."
            }
        }

        RULES {
            #L5RFV31sT2uV4wX6yZ8aB0c: fov_heritages_lion_and_battlefield_connections
        }
    }

    # ===========================
    # WEAPONS
    # ===========================

    ^"Fields of Victory Weapons" DEF {
        APPLIES TO [^"Samurai"]

        ENTRIES {
            ^"Ichiro Sapper Ax" {
                ^"Category" STRING "Axe"
                ^"Skill" STRING "Martial Arts [Melee]"
                ^"Range" STRING "1"
                ^"Damage" INTEGER 3
                ^"Deadliness" INTEGER 4
                ^"Grips" STRING "1-hand: -; 1-hand (Blunt): Damage +2, Deadliness -3"
                ^"Qualities" LIST OF STRING ["Durable"]
                ^"Rarity" INTEGER 2
                ^"Cost" STRING "3 koku"
                ^"Special" STRING "Counts as an axe when wielded with its standard 1-hand profile, and as a blunt weapon when wielded with its blunt profile."
            }

            ^"Magari Yari" {
                ^"Category" STRING "Polearm"
                ^"Skill" STRING "Martial Arts [Melee]"
                ^"Range" STRING "2"
                ^"Damage" INTEGER 7
                ^"Deadliness" INTEGER 4
                ^"Grips" STRING "2-hand: -"
                ^"Qualities" LIST OF STRING ["Cumbersome", "Razor-Edged", "Wargear"]
                ^"Rarity" INTEGER 6
                ^"Cost" STRING "20 koku"
                ^"Special" STRING "After performing an Attack action check with a magari yari, a character suffers the Disoriented condition unless they choose to receive 3 fatigue."
            }

            ^"Nagae Yari" {
                ^"Category" STRING "Polearm"
                ^"Skill" STRING "Martial Arts [Melee]"
                ^"Range" STRING "2"
                ^"Damage" INTEGER 5
                ^"Deadliness" INTEGER 2
                ^"Grips" STRING "2-hand: -"
                ^"Qualities" LIST OF STRING ["Wargear"]
                ^"Rarity" INTEGER 2
                ^"Cost" STRING "1 koku"
                ^"Special" STRING "Before performing an Attack action check using a nagae yari, a character may choose to suffer the Immobilized condition. If they do and succeed on the check, they add 2 bonus successes."
            }

            ^"Nagamaki" {
                ^"Category" STRING "Polearm"
                ^"Skill" STRING "Martial Arts [Melee]"
                ^"Range" STRING "1-2"
                ^"Damage" INTEGER 3
                ^"Deadliness" INTEGER 5
                ^"Grips" STRING "1-hand: Cumbersome; 2-hand: Damage +2, Deadliness +2"
                ^"Qualities" LIST OF STRING ["Razor-Edged", "Wargear"]
                ^"Rarity" INTEGER 4
                ^"Cost" STRING "30 koku"
            }

            ^"Yoroi-Doshi" {
                ^"Category" STRING "Hand Weapon"
                ^"Skill" STRING "Martial Arts [Melee]"
                ^"Range" STRING "0"
                ^"Damage" INTEGER 2
                ^"Deadliness" INTEGER 4
                ^"Grips" STRING "1-hand: -; 2-hand: Deadliness +3"
                ^"Qualities" LIST OF STRING ["Concealable", "Razor-Edged", "Wargear"]
                ^"Rarity" INTEGER 5
                ^"Cost" STRING "10 koku"
                ^"Special" STRING "When performing an Attack action check with a yoroi-doshi, a character may spend (op) as follows: (op): Your target treats their physical resistance as 2 lower. This effect persists until the end of your next turn."
            }
        }

        RULES {
            #L5RFV32dE3fG5hI7jK9lM1n: fov_weapons_extend_core
        }
    }

    # ===========================
    # YAJIRI (SPECIALIZED ARROWHEADS)
    # ===========================

    ^"Fields of Victory Yajiri" DEF {
        APPLIES TO [^"Samurai"]

        # When used with a bow, these arrows modify the
        # weapon's profile as follows.

        ENTRIES {
            ^"Steel-Tip Yajiri" {
                ^"Effect" STRING "Adds Razor-Edged quality"
                ^"Rarity" INTEGER 3
                ^"Cost" STRING "1 koku each"
            }

            ^"Jade Inlay Yajiri" {
                ^"Effect" STRING "Adds Sacred quality"
                ^"Rarity" INTEGER 8
                ^"Cost" STRING "1 koku each"
            }

            ^"Obsidian Splinter Yajiri" {
                ^"Effect" STRING "+4 deadliness; adds Forbidden, Razor-Edged, and Unholy qualities"
                ^"Rarity" INTEGER 9
                ^"Cost" STRING "10 koku each"
            }
        }

        RULES {
            #L5RFV33oP4qR6sT8uV0wX2y: fov_yajiri_modify_bow_profile
        }
    }

    # ===========================
    # PERSONAL EFFECTS
    # ===========================

    ^"Fields of Victory Personal Effects" DEF {
        APPLIES TO [^"Samurai"]

        ENTRIES {
            ^"Animal Helm" {
                ^"Category" STRING "Personal Effect"
                ^"Cost" STRING "1 koku"
                ^"Rarity" INTEGER 5
                ^"Qualities" LIST OF STRING ["Wargear"]
                ^"Effect" STRING "When a character who wears an animal helm while leading an army or cohort in a mass battle is removed via the Cut Off the Head strategic objective, reduce the panic the cohort receives by half (rounding up)."
            }

            ^"Blasting Powder (1 Charge)" {
                ^"Category" STRING "Personal Effect"
                ^"Cost" STRING "20 koku"
                ^"Rarity" INTEGER 9
                ^"Qualities" LIST OF STRING ["Ceremonial", "Forbidden to non-shugenja"]
                ^"Effect" STRING "If a charge of blasting powder is ignited by a stray spark, the charge explodes and each character at range 0-2 suffers 10 physical damage, items at range 0-2 gain the Damaged quality, and each character at range 0-4 suffers the Disoriented condition."
            }

            ^"Battlefield Heirloom" {
                ^"Category" STRING "Personal Effect"
                ^"Cost" STRING "Unique (cannot be purchased)"
                ^"Rarity" INTEGER 0
                ^"Effect" STRING "Once per game session, a character with a battlefield heirloom may reflect on the item as a Support action. If they do, they increase their composure (and their army's discipline, during a mass battle) by 2 until the end of the scene."
            }

            ^"Battlefield Medical Pack" {
                ^"Category" STRING "Personal Effect"
                ^"Cost" STRING "2 bu"
                ^"Rarity" INTEGER 3
                ^"Effect" STRING "Once per scene as a Support action, a character with a battlefield medical pack may remove the Bleeding condition from another character at range 0-1."
            }

            ^"Brilliant Flare" {
                ^"Category" STRING "Personal Effect"
                ^"Cost" STRING "1 koku"
                ^"Rarity" INTEGER 6
                ^"Qualities" LIST OF STRING ["Wargear"]
                ^"Effect" STRING "As a Support action, a character may make a TN 3 Martial Arts (Ranged) check to fire a flare. The flare is generally visible to all characters at range 0-6."
            }

            ^"Gunbai" {
                ^"Category" STRING "Personal Effect"
                ^"Cost" STRING "3 koku"
                ^"Rarity" INTEGER 4
                ^"Qualities" LIST OF STRING ["Ceremonial", "Wargear"]
                ^"Effect" STRING "Can be wielded as a one-handed Martial Arts [Melee] weapon: Range 1, Damage 2, Deadliness 2. During a skirmish, a character with a gunbai readied can perform shūji targeting characters who can see them at range 0-6. During a mass battle, for each of an army's leaders equipped with a gunbai, the army increases its discipline by 2."
            }

            ^"Mempo" {
                ^"Category" STRING "Personal Effect"
                ^"Cost" STRING "5 koku"
                ^"Rarity" INTEGER 4
                ^"Qualities" LIST OF STRING ["Ceremonial", "Wargear"]
            }

            ^"Saihai" {
                ^"Category" STRING "Personal Effect"
                ^"Cost" STRING "4 bu"
                ^"Rarity" INTEGER 3
                ^"Qualities" LIST OF STRING ["Ceremonial", "Wargear"]
                ^"Effect" STRING "During a mass battle, if an army's commander carries a saihai, increase the army's discipline by 2."
            }

            ^"Sashimono" {
                ^"Category" STRING "Personal Effect"
                ^"Cost" STRING "6 bu"
                ^"Rarity" INTEGER 2
                ^"Qualities" LIST OF STRING ["Wargear"]
            }

            ^"Smoking Pipe" {
                ^"Category" STRING "Personal Effect"
                ^"Cost" STRING "1 bu"
                ^"Rarity" INTEGER 2
            }

            ^"Tetsubishi" {
                ^"Category" STRING "Personal Effect"
                ^"Cost" STRING "5 bu per handful"
                ^"Rarity" INTEGER 4
                ^"Effect" STRING "As an Attack and Support action, a character may scatter a handful of tetsubishi targeting a patch of ground at range 0-2. The terrain at range 0-1 from the point of impact gains the Dangerous and Ensnaring terrain quality."
            }

            ^"Uma-Jirushi" {
                ^"Category" STRING "Personal Effect"
                ^"Cost" STRING "3 koku"
                ^"Rarity" INTEGER 7
                ^"Qualities" LIST OF STRING ["Resplendent", "Wargear"]
                ^"Effect" STRING "When making a Command check, a leader in a mass battle who displays a personal uma-jirushi adds one kept (ring) set to (op). Should the bearer of an uma-jirushi be killed via the Cut Off the Head or Challenge action, their army receives 4 additional panic."
            }
        }

        RULES {
            #L5RFV34zA5bC7dE9fG1hI3j: fov_personal_effects_extend_core
        }
    }

    # ===========================
    # BLESSED TREASURES (NEMURANAI)
    # ===========================

    ^"Fields of Victory Blessed Treasures" DEF {
        APPLIES TO [^"Samurai"]

        ENTRIES {
            ^"Banner of Amaterasu" {
                ^"Category" STRING "Nemuranai"
                ^"Qualities" LIST OF STRING ["Durable", "Sacred"]
                ^"Effect" STRING "A character wielding this banner adds a kept (ring) set to an (op) result when making Command checks."
                ^"Quirk" STRING "While the banner is exposed to direct sunlight, all friendly forces hear battlefield orders in the voice of their first martial instructor."
                ^"Sealed Invocation" STRING "Courage of Seven Thunders, which the wielder may perform once per session using the Command skill instead of Theology."
            }

            ^"Claws of the Kitsu" {
                ^"Category" STRING "Nemuranai"
                ^"Qualities" LIST OF STRING ["Durable", "Sacred"]
                ^"Quirk" STRING "While carried in a pouch or wrapped cloth, a claw struggles as if trying to escape."
                ^"Sealed Invocation" STRING "Vapor of Nightmares, which the wielder may perform once per session using the Courtesy skill instead of Theology."
            }

            ^"Five Akodo Daggers" {
                ^"Category" STRING "Nemuranai"
                ^"Qualities" LIST OF STRING ["Durable", "Sacred"]
                ^"Effect" STRING "These knives have +2 deadliness."
                ^"Quirk" STRING "The Akodo Daggers grow uncomfortably hot if the blades of two or more of them come into contact with each other."
                ^"Sealed Invocation" STRING "Biting Steel, which the wielder may perform once per session using the Martial Arts [Melee] skill instead of Theology."
            }

            ^"Leadership Scrolls" {
                ^"Category" STRING "Blessed Treasure"
                ^"Qualities" LIST OF STRING ["Durable", "Sacred"]
                ^"Effect" STRING "As a support action, a character may spend one Void point and read from the scroll. If they do, they may use the Tactics skill instead of the skill they would normally use when making Social skill checks. This effect persists until the end of the scene."
            }
        }

        RULES {
            #L5RFV35kL6mN8oP0qR2sT4u: fov_blessed_treasures_nemuranai
        }
    }

    # ===========================
    # ITEM PATTERNS
    # ===========================

    ^"Fields of Victory Item Patterns" DEF {
        APPLIES TO [^"Samurai"]

        ENTRIES {
            ^"Akodo Pattern" {
                ^"XP Cost" INTEGER 6
                ^"Rarity Modifier" STRING "+4"
                ^"Applies To" STRING "Weapon or armor"
                ^"Effect" STRING "A character carrying or wearing one or more items made in the Akodo pattern increases the discipline of any army of which they are the commander by 5."
            }

            ^"Burning Water Pattern" {
                ^"XP Cost" INTEGER 6
                ^"Rarity Modifier" STRING "+4"
                ^"Applies To" STRING "Blasting powder"
                ^"Effect" STRING "Blasting powder fashioned using the burning water pattern has its damage reduced by 1. Blasting powder fashioned using the burning water pattern can be used when wet or even underwater."
            }

            ^"Concealment Pattern" {
                ^"XP Cost" INTEGER 6
                ^"Rarity Modifier" STRING "+4"
                ^"Applies To" STRING "Armor"
                ^"Effect" STRING "Armor produced with the concealment pattern gains the Wargear quality, and loses the Ceremonial and Resplendent qualities; it cannot gain those qualities. Reduce its supernatural resistance by 1 (to a minimum of 0). While a character wearing it is in Obscuring terrain, they increase the TN of Attack action checks targeting them by an additional 1 (to a total of +2)."
            }

            ^"Deadly Fangs Pattern" {
                ^"XP Cost" INTEGER 7
                ^"Rarity Modifier" STRING "+4"
                ^"Applies To" STRING "Polearm"
                ^"Effect" STRING "A polearm made in the deadly fangs pattern gains the Cumbersome quality and increases its deadliness by 1. If an entire cohort is equipped with polearms with the deadly fangs pattern, its leader reduces the TN of the Reinforce action by 1 (to a minimum of 1)."
            }

            ^"Fearsome Snarl Pattern" {
                ^"XP Cost" INTEGER 3
                ^"Rarity Modifier" STRING "+1"
                ^"Applies To" STRING "Weapon or armor"
                ^"Effect" STRING "The fearsome snarl pattern can be applied to a weapon or set of armor. It loses the Concealable quality (if it has it) and gains the Wargear quality."
            }

            ^"Ichiro Pattern" {
                ^"XP Cost" INTEGER 4
                ^"Rarity Modifier" STRING "-1 (to a minimum of 1)"
                ^"Applies To" STRING "Weapon or armor"
                ^"Effect" STRING "Weapons or armor produced with the Ichiro pattern halve their price (rounding up) and lose the Ceremonial and Resplendent item qualities. Such items can never gain either quality. Ichiro pattern weapons and armor are also produced in half the time (rounding up) it would otherwise take to make them."
            }

            ^"Mountain Silk Pattern" {
                ^"XP Cost" INTEGER 6
                ^"Rarity Modifier" STRING "+3"
                ^"Applies To" STRING "Armor"
                ^"Effect" STRING "When a character wearing armor made with mountain silk succeeds at a check to resist a critical strike, they add one bonus success. Armor with physical resistance 2 or lower made using mountain silk loses the Cumbersome quality (if it has it) and gains the Durable quality. Armor with physical resistance 3 or higher made using mountain silk gains the Durable quality and reduces its physical resistance by 1."
            }

            ^"Screaming Fire Pattern" {
                ^"XP Cost" INTEGER 6
                ^"Rarity Modifier" STRING "+4"
                ^"Applies To" STRING "Blasting powder"
                ^"Effect" STRING "Blasting powder fashioned using the screaming fire pattern has its damage reduced by 2. When it causes an army to receive 1 or more panic during a Mass Battle, that army receives that amount of panic plus 3 instead. Additionally, the area it affects becomes Imbalanced (All Elements) for 1 week."
            }

            ^"Toriyama's Endurance Pattern" {
                ^"XP Cost" INTEGER 3
                ^"Rarity Modifier" STRING "+3"
                ^"Applies To" STRING "Parchment and scrolls"
                ^"Effect" STRING "Parchment and scrolls that are made with Toriyama's endurance pattern gain the Durable item quality, but only against the effects of fire and water."
            }
        }

        RULES {
            #L5RFV36vW7xY9zA1bC3dE5f: fov_item_patterns_crafting_secrets
        }
    }

    # ===========================
    # NEW TECHNIQUES
    # ===========================

    ^"Fields of Victory Techniques" DEF {
        APPLIES TO [^"Samurai"]

        ENTRIES {
            # --- CLOSE COMBAT KATA ---

            ^"Fierce Badger Style" {
                ^"Type" STRING "Kata"
                ^"Subtype" STRING "Close Combat Kata"
                ^"Rank" INTEGER 2
                ^"Activation" STRING "When you make a Martial Arts [Unarmed] check targeting a character at range 0"
                ^"Opportunities" STRING "(op)+: If the target is Immobilized, they receive 1 strife per (op) spent this way. (op)+: If the target's silhouette and vigilance both are lower than or equal to (op) spent this way, the target is thrown 2 range bands in a direction of your choice and suffers 3 fatigue."
            }

            ^"Thicket's Embrace Style" {
                ^"Type" STRING "Kata"
                ^"Subtype" STRING "Close Combat Kata"
                ^"Rank" INTEGER 3
                ^"Activation" STRING "When you make a Martial Arts [Unarmed] or Fitness check"
                ^"Opportunities" STRING "(op): If you are in Entangling or Obscuring terrain, reduce the TN of the next attack check you make by 1 (to a minimum of 1). This effect persists until the end of your next turn. (op)(op): If you are in Entangling or Obscuring terrain, you may ignore its negative effects. This effect persists until the end of your next turn."
            }

            ^"Shattering Tide Style" {
                ^"Type" STRING "Kata"
                ^"Subtype" STRING "Close Combat Kata"
                ^"Rank" INTEGER 3
                ^"Activation" STRING "When you make a Martial Arts [Unarmed] check"
                ^"Opportunities" STRING "(op): If you succeed, and both you and your target are in Confining or Dangerous terrain, treat the damage and deadliness of the weapon you used as 1 higher for each kept (st) result on your check. (op)(op): If both you and your target are in Confining or Dangerous terrain, your target suffers the Dazed condition."
            }

            # --- RITUALS ---

            ^"Beseech Akodo's Judgment" {
                ^"Type" STRING "Ritual"
                ^"Rank" INTEGER 3
                ^"Activation" STRING "Once per game session as a Support action, you may make a TN 3 Tactics (Void) check targeting one terrain feature on the battlefield (or one battle zone, if using the rules for battle zones)"
                ^"Effect" STRING "If you succeed, increase your army's discipline by your glory rank plus your ranks in Command as long as your army has at least one cohort occupying the chosen terrain feature. This effect persists until your army has no cohort occupying that feature, or until the end of the scene."
                ^"Opportunities" STRING "(op)+: If you succeed and designate a fortification, while your army occupies that fortification, increase that fortification's difficulty level by 1 per (op) spent this way. (op)(op)+: Each time your army suffers panic from battle fatigue during this scene, it suffers 1 less per (op) spent this way (to a minimum of 1)."
            }

            ^"Beseech Bayushi's Absolution" {
                ^"Type" STRING "Ritual"
                ^"Rank" INTEGER 4
                ^"Activation" STRING "Once per game session as a downtime activity, you may make a TN 3 Sentiment (Air) check targeting yourself"
                ^"Effect" STRING "If you succeed, the next time you would receive strife or fatigue, reduce the amount you receive by your focus. This effect persists until the end of the next scene."
                ^"Opportunities" STRING "(op): If you succeed, the next time you would forfeit honor, reduce the amount you forfeit by half (rounded up)."
            }

            ^"Beseech Doji's Wisdom" {
                ^"Type" STRING "Ritual"
                ^"Rank" INTEGER 2
                ^"Activation" STRING "Once per game session as a downtime activity, you may make a TN 3 Composition check to transcribe a historical event you witnessed to paper"
                ^"Effect" STRING "You write from the heart to create a record of the event that rings as a genuine account and omits no details of significance. Readers with vigilance lower than your honor rank trust the events to be true, or at least recorded in good faith."
                ^"Opportunities" STRING "Fire (op): If you succeed, each character awarded glory from the event receives that much glory plus your ranks in Culture. Earth (op): If you succeed, the text gains the Durable quality. Air (op)+: If you succeed, you may omit one detail of significance per (op) spent without creating contradictions. Water (op): If you succeed, reduce the TN of any check to copy the text by 2. Void (op)(op): The text gains the Sacred item quality."
            }

            ^"Beseech Hida's Might" {
                ^"Type" STRING "Ritual"
                ^"Rank" INTEGER 2
                ^"Activation" STRING "Once per game session as a downtime activity or Support action, you may make a TN 2 Meditation (Fire) check targeting an area encompassing 3 range bands around yourself"
                ^"Effect" STRING "If you succeed, this area becomes an arena. When a character makes a Martial Arts check in the arena during the event and does not gain strife from the check, that character reduces the TN of their next check by 1 (to a minimum of 1). This effect persists until the end of the next scene."
                ^"Opportunities" STRING "(op): If you succeed, the arena gains the Hallowed (Fire) terrain quality until the end of the scene. (op)+: If you succeed, increase the Endurance and Composure of each character fighting a duel in the arena by 1 per (op) spent this way. (op)+: Reduce the TN of checks to remove the Bleeding and Dying conditions from characters within the arena by 1 per (op) spent this way (to a minimum of 1)."
            }

            ^"Beseech Shiba's Calm" {
                ^"Type" STRING "Ritual"
                ^"Rank" INTEGER 3
                ^"Activation" STRING "Once per game session after participating in a Mass Battle or as a downtime activity, you may make a TN 3 Theology (Void) check targeting an area upon which a mass battle was fought earlier that day"
                ^"Effect" STRING "If you succeed, remove the Defiled terrain quality from the area."
                ^"Opportunities" STRING "(op): Remove one Dangerous, Entangling, or Obscuring terrain quality gained during the battle. (op)(op): Remove the Imbalanced terrain quality from the area. (op)(op): Non-Tainted beings reduce Theology check TNs in this area by 1; Tainted beings increase all check TNs by 1. (op)+: Reduce the TN of any Fitness or Meditation checks that characters in your army need to make at the end of a scene by 1 per (op) spent this way."
            }

            ^"Beseech Shinjo's Empathy" {
                ^"Type" STRING "Ritual"
                ^"Rank" INTEGER 2
                ^"Activation" STRING "Once per session as a downtime activity or Support action, you may make a Survival (Water) check targeting a friendly animal at range 0-1. TN equals the animal's conflict rank. If bonded, reduce TN by 2 (minimum 1)."
                ^"Effect" STRING "If you succeed, your target removes 3 fatigue, plus 1 additional fatigue per bonus success."
                ^"Opportunities" STRING "(op): You and the target each remove 1 strife per bonus success. (op): If you succeed, target removes additional fatigue equal to your ranks in Medicine. (op): Remove the Bleeding condition. (op)(op): Remove the Lightly Wounded condition, or reduce Severely Wounded to Lightly Wounded. (op)(op): Remove the Dying condition. (op)(op)+: Choose one additional friendly animal of the same conflict rank or lower per (op) spent."
            }

            ^"Beseech Togashi's Vision" {
                ^"Type" STRING "Ritual"
                ^"Rank" INTEGER 3
                ^"Activation" STRING "Once per game session as a downtime activity or as a Scheme and Support action during a Mass Battle, you may make a TN 3 Meditation (Void) check targeting a character you can perceive (or a leader or commander of an enemy army)"
                ^"Effect" STRING "If you succeed, you assess another character's strategy. Once before the end of the next scene, after that character performs an action, you may reveal that you were prepared for this and immediately perform one action."
                ^"Opportunities" STRING "(op): If you succeed and you are the commander of an army, you may choose a leader in your army to perform the action instead. (op): While you perform the prepared action, reduce the TN by your ranks in Tactics."
            }

            ^"Imbue Thunder" {
                ^"Type" STRING "Ritual"
                ^"Rank" INTEGER 4
                ^"Activation" STRING "Once per session as a downtime activity with proper ingredients (10 koku, rarity 6), you may make a TN 4 Medicine check to create blasting powder"
                ^"Effect" STRING "If you succeed, you create ten brilliant flares, plus ten per two bonus successes, or one blasting powder charge, plus one per two bonus successes."
                ^"Opportunities" STRING "(op)(op): When used in a skirmish, the charge inflicts the Dazed condition on all characters at range 0-4. Air (op)(op): Increase the charge's range band by 1. Earth (op)(op)+: When used, the charge inflicts 2 additional damage (or attrition) per (op)(op) spent. Fire (op)(op)+: When used, the charge inflicts 2 additional strife (or panic) per (op)(op) spent. Water (op)(op): Inflicts the Bleeding condition on all characters at range 0-2. Void (op)(op): The area becomes Imbalanced (All Elements) terrain for 1 day."
            }

            # --- AIR SHUJI ---

            ^"Borrowed Courage" {
                ^"Type" STRING "Shūji"
                ^"Subtype" STRING "Air Shūji"
                ^"Rank" INTEGER 1
                ^"Activation" STRING "As a downtime activity, you may make a TN 4 Performance (Air) check targeting an army or a number of characters who can hear you up to your ranks in Sentiment. You may stake up to 3 honor to reduce the TN by that amount (minimum 1)."
                ^"Effect" STRING "If you succeed, you spread a powerful rumor. The first time your target receives panic or strife during the next scene, they reduce the amount by your ranks in Performance, to a minimum of 0. Whether you succeed or fail, if your side loses the battle, you lose your staked honor."
                ^"Opportunities" STRING "Air (op): If you fail, nobody remembers what you said, so no narrative social consequences. Air (op): Add 1 kept (ring) set to (op) to the first Scheme action check you make during the next mass battle."
            }

            ^"Clouds Parted by Steel" {
                ^"Type" STRING "Shūji"
                ^"Subtype" STRING "Air Shūji"
                ^"Rank" INTEGER 2
                ^"Activation" STRING "When you make a check to perform a Strike action or an Assault action"
                ^"Opportunities" STRING "Air (op)+: If your target's vigilance is lower than your ranks in Sentiment plus (op) spent this way, choose one of the advantage/disadvantage types: interpersonal, mental, or physical. If your target has one or more advantages or disadvantages of that type, you learn what they are."
            }

            ^"Entice with Falsehoods" {
                ^"Type" STRING "Shūji"
                ^"Subtype" STRING "Air Shūji"
                ^"Rank" INTEGER 4
                ^"Activation" STRING "Once per scene during a mass battle as a Scheme action targeting the commander of the enemy army, you may make a Tactics (Air) check. TN equals target's vigilance. If not your army's commander, stake 5 honor and 5 glory. If your cohort is in Obscuring terrain, reduce TN by 2."
                ^"Effect" STRING "If you succeed, you immediately change your army's current strategic goal to a new goal of your choice. Momentum points from the previous goal apply to this new goal. If you fail and are not the commander, you lose staked honor and glory."
                ^"Opportunities" STRING "Air (op): Your target remains unaware of your machinations. Air (op): Gain 1 momentum point. Air (op)+: All characters in the scene with vigilance lower than or equal to (op) spent are unaware of your machinations."
            }

            # --- EARTH SHUJI ---

            ^"Fortress of Necessity" {
                ^"Type" STRING "Shūji"
                ^"Subtype" STRING "Earth Shūji"
                ^"Rank" INTEGER 1
                ^"Activation" STRING "As a downtime activity or a Support action during a mass battle, using adequate supplies and a suitable area, you may make a TN 3 Command (Earth) check targeting a position you can reach"
                ^"Effect" STRING "If you succeed, you erect a defensive structure. In a mass battle, this structure is treated as a fortification with difficulty value equal to your ranks in Labor plus your bonus successes, which reduces attrition suffered by the cohort occupying it by 2. In a skirmish, treated as Obscuring terrain by anyone attacking from outside. Temporary; degrades in a few days without maintenance."
                ^"Opportunities" STRING "Earth (op): When you perform the Reinforce action in this fortification, treat the TN as reduced by 1 (minimum 1). Earth (op)(op)+: Add one terrain quality per (op)(op) spent to range 1-3 around the building: Dangerous, Entangling, Obscuring, or Recessed."
            }

            ^"Great Anvil's Measure" {
                ^"Type" STRING "Shūji"
                ^"Subtype" STRING "Earth Shūji"
                ^"Rank" INTEGER 2
                ^"Activation" STRING "When you make a check to perform a Guard action or a Reinforce action"
                ^"Opportunities" STRING "Earth (op)+ (Guard): Choose any number of characters with focus lower than or equal to your ranks in Performance plus 2 per (op) spent. Each must receive strife equal to your ranks in Performance to perform an Attack or Scheme action targeting anyone other than you. Persists until end of your next turn. Earth (op)+ (Reinforce): Choose any number of enemy leaders with focus lower than or equal to your ranks in Performance plus 2 per (op) spent. The enemy army receives panic equal to your ranks in Performance each time any of those leaders targets any cohort other than yours. Persists until end of your next turn."
            }

            ^"Steady the Hammer" {
                ^"Type" STRING "Shūji"
                ^"Subtype" STRING "Earth Shūji"
                ^"Rank" INTEGER 4
                ^"Activation" STRING "As an Attack and Support action during a mass battle, you may make a TN 5 Tactics (Earth) check targeting one enemy leader's cohort that performed an Attack action check targeting your cohort this round. If that cohort is in Confining, Entangling, or Recessed terrain, reduce TN to 2."
                ^"Effect" STRING "If you succeed, decrease the TN of the next Attack action check made by a friendly leader targeting that cohort by 1 plus your bonus successes (minimum 1). If that check succeeds, add additional bonus successes equal to your ranks in Command. Persists until end of round."
                ^"Opportunities" STRING "Earth (op)+: This effect applies to one additional Attack action check per (op) spent before the end of the round."
            }

            # --- FIRE SHUJI ---

            ^"Call the Wild" {
                ^"Type" STRING "Shūji"
                ^"Subtype" STRING "Fire Shūji"
                ^"Rank" INTEGER 3
                ^"Activation" STRING "As a Support action, you may make a Survival (Fire) check targeting one friendly animal or manifest kami at range 0-2. TN equals the animal or kami's conflict rank."
                ^"Effect" STRING "If you succeed, increase the damage and deadliness of the animal or kami's weapon profiles by 1, plus 1 for every two bonus successes. Persists until end of scene."
                ^"Opportunities" STRING "(op)+: Target one additional friendly animal or manifest kami per (op) spent. (op)+: The target removes 1 fatigue per (op) spent. (op): The animal gains the Enraged condition, then removes all strife."
            }

            ^"Righteous Example" {
                ^"Type" STRING "Shūji"
                ^"Subtype" STRING "Fire Shūji"
                ^"Rank" INTEGER 1
                ^"Activation" STRING "As an Attack and Support action during a mass battle, you may make a TN 3 Martial Arts (Fire) check targeting an enemy leader's cohort"
                ^"Effect" STRING "If you succeed, the enemy army suffers attrition and panic equal to 1 plus your bonus successes. Other leaders in your army reduce the TN of their Attack action checks by 1 until end of your next turn. If you fail, reduce the TN of Attack and Scheme action checks targeting your cohort by 1 until end of your next turn."
                ^"Opportunities" STRING "Fire (op)(op): If you are both the commander and a leader, your army gains 1 momentum point toward its current strategic objective."
            }

            ^"Sting of Warrior's Pride" {
                ^"Type" STRING "Shūji"
                ^"Subtype" STRING "Fire Shūji"
                ^"Rank" INTEGER 2
                ^"Activation" STRING "As a downtime activity, you may make a TN 4 Performance (Fire) check targeting an army or one character who can hear you. You may stake up to 3 glory to reduce the TN by that amount (minimum 1)."
                ^"Effect" STRING "If you succeed, you spur your target to greater courage. The first time your target is dealt attrition or damage during the next scene, they reduce the amount by your ranks in Performance, to a minimum of 0. Whether you succeed or fail, if observed acting in a cowardly manner by your target, you lose any staked glory."
            }

            ^"To Smash the Heart" {
                ^"Type" STRING "Shūji"
                ^"Subtype" STRING "Fire Shūji"
                ^"Rank" INTEGER 4
                ^"Activation" STRING "Once per scene, after a character in the scene (or enemy leader, in a mass battle) becomes Compromised or is killed, you may immediately make a TN 4 Tactics (Fire) check targeting that character"
                ^"Effect" STRING "If you succeed in an intrigue, skirmish, or duel, each character allied with your target who has lower status receives strife equal to your bonus successes plus your ranks in Sentiment. If you succeed in a mass battle, the enemy army receives panic equal to your bonus successes plus your ranks in Sentiment."
            }

            # --- WATER SHUJI ---

            ^"Coursing March Chant" {
                ^"Type" STRING "Shūji"
                ^"Subtype" STRING "Water Shūji"
                ^"Rank" INTEGER 1
                ^"Activation" STRING "As a downtime activity, you may make a TN 4 Performance (Water) check targeting an army or a number of characters traveling with you up to your ranks in Command. You may expend an additional day's rations to reduce the TN by 2 (minimum 1)."
                ^"Effect" STRING "If you succeed, you and your targets can march twice the distance they normally could in that time."
                ^"Opportunities" STRING "Water (op): Army removes attrition up to your ranks in Medicine. Water (op): Army removes panic up to your ranks in Culture. Water (op)+: One individual target per (op) spent removes fatigue up to your ranks in Medicine. Water (op)+: One individual target per (op) spent removes strife up to your ranks in Culture. Water (op)(op)+: Choose one mundane terrain quality per (op)(op) spent; each target ignores it during the march."
            }

            ^"Preserve Strength" {
                ^"Type" STRING "Shūji"
                ^"Subtype" STRING "Water Shūji"
                ^"Rank" INTEGER 2
                ^"Activation" STRING "Once per scene as a Support action or as a downtime activity, you may make a TN 3 Medicine (Water) check targeting a friendly army or a number of characters at range 0-3 up to your ranks in Command"
                ^"Effect" STRING "If you succeed during a mass battle, your target removes 5 casualties, plus 1 for every two bonus successes. If you succeed during a skirmish, each target reduces the TN of their next Medicine check by 2, plus 1 for every two bonus successes (minimum 1)."
                ^"Opportunities" STRING "Water (op)(op) (Mass Battle): Choose a friendly leader; remove Bleeding, Burning, or Dying condition. Water (op)(op) (Skirmish): Each target may immediately move 1 range band, or 2 range bands toward a character who is Bleeding, Burning, or Dying."
            }

            ^"Your Enemy's Arrows" {
                ^"Type" STRING "Shūji"
                ^"Subtype" STRING "Water Shūji"
                ^"Rank" INTEGER 4
                ^"Activation" STRING "Once per scene as a Scheme action targeting another character who can perceive you or your cohort, you may make a Tactics (Water) check. TN equals target's focus. You may stake up to 3 glory to reduce TN by that amount."
                ^"Effect" STRING "If you succeed, the next time your target accrues momentum points toward an objective, add those momentum points to your objective instead. If you fail, you lose the glory you staked."
                ^"Opportunities" STRING "Water (op): Your target remains unaware of your machinations. If you failed, regain your staked glory. Water (op): Gain 1 momentum point. Water (op)+: All characters in the scene with vigilance lower than or equal to (op) spent are unaware of your machinations."
            }

            # --- VOID SHUJI ---

            ^"Battle of No Escape" {
                ^"Type" STRING "Shūji"
                ^"Subtype" STRING "Void Shūji"
                ^"Rank" INTEGER 2
                ^"Activation" STRING "Once per scene as a Support action, you may make a TN 5 Command (Void) check targeting your cohort or a number of characters who can hear you up to your ranks in Meditation. Reduce TN to 2 if all targets are in Confining or Entangling terrain."
                ^"Effect" STRING "If you succeed during a mass battle, your army does not suffer morale collapse if its panic exceeds its discipline, and continues to function normally. Persists for one round, plus one round for every three bonus successes. If you succeed during an intrigue, duel, or skirmish, each target ignores the effects of the Compromised condition. Persists for one round, plus one round for every two bonus successes."
                ^"Opportunities" STRING "Void (op)+ (Intrigue, Duel, or Skirmish): Choose one additional target per (op) spent. Void (op)(op) (Intrigue, Duel, or Skirmish): If you succeed, each target also ignores the effects of the Incapacitated condition for one round, plus one round for every two bonus successes."
            }

            ^"Moment of Glory" {
                ^"Type" STRING "Shūji"
                ^"Subtype" STRING "Void Shūji"
                ^"Rank" INTEGER 3
                ^"Activation" STRING "Once per scene as a Movement and Support action during a mass battle, you may make a TN 4 Meditation (Void) check. Reduce TN to 2 if your cohort is in Confining or Obscuring terrain."
                ^"Effect" STRING "If you succeed, whenever your cohort is targeted with an Attack action check, reduce any attrition it inflicts on your army to 0, and receive that much fatigue yourself instead. If fatigue received causes you to suffer a critical strike, the severity is 16. Persists until start of your next turn."
                ^"Opportunities" STRING "Void (op)+: While this effect persists, reduce any fatigue you receive by 1 per (op) spent (minimum 0). Void (op)(op): If you suffer a critical strike this way, it is not applied until the end of the scene. Void (op): If you succeed and survive, double any glory you are awarded."
            }

            ^"Victory Without a Sword" {
                ^"Type" STRING "Shūji"
                ^"Subtype" STRING "Void Shūji"
                ^"Rank" INTEGER 6
                ^"Activation" STRING "As an Attack, Movement, Scheme, and Support action during a mass battle, you may make a TN 6 Tactics (Void) check targeting the enemy commander. Reduce TN to 4 if all enemy cohorts are in Dangerous, Entangling, or Obscuring terrain. Can only be attempted once per army per scene."
                ^"Effect" STRING "If you succeed, the enemy commander immediately resists with a TN 5 Command check (Void 3), adding 1 to the TN for every 10 strength your army has in excess of theirs. If the enemy commander fails, the enemy army suffers 10 panic for each point of their shortfall. If the enemy army collapses this way, its forces surrender. If you fail, reduce the TN of Attack action checks targeting the cohorts of leaders in your army by 2 (minimum 1) until end of scene."
            }

            # --- NINJUTSU ---

            ^"Employ Terrible Thunder" {
                ^"Type" STRING "Ninjutsu"
                ^"Rank" INTEGER 2
                ^"Activation" STRING "As a Movement and Support action, you may make a TN 4 Skulduggery check and expend 1 charge of blasting powder to place it at a target position at range 0-1. You must forfeit honor equal to half your honor rank (rounded up)."
                ^"Effect" STRING "If you succeed, the blasting powder explodes at the end of the next round. (Mass Battle) Nearby cohort's army receives 5 attrition and 5 panic, plus 1 per bonus success. If placed inside a fortification, reduce its difficulty value by 1 plus 1 per bonus success. One affected cohort leader suffers Immobilized and Lightly Wounded. (Other Scene) Each character at range 0-2 suffers 10 physical damage plus 1 per bonus success, suffers Dazed, and receives 5 strife. Items at range 0-2 gain Damaged. Structures at range 0-1 gain Damaged."
                ^"Opportunities" STRING "(op): Any item or structure damaged gains the Destroyed quality instead. (op)(op): Area at range 0-2 gains Dangerous and Obscuring terrain qualities. (op)+: The blasting powder does not detonate for one additional round per (op) spent."
            }

            ^"Swift Scouting" {
                ^"Type" STRING "Ninjutsu"
                ^"Rank" INTEGER 1
                ^"Activation" STRING "As a downtime activity, or once per scene as a Movement and Support action, you may make a TN 3 Survival (Water) check to scout the terrain. In urban environments use Skulduggery; on the ocean use Seafaring."
                ^"Effect" STRING "If you succeed, you discover all terrain qualities of the area around you (several miles during downtime, or entire scene area), as well as any fortifications. Characters with vigilance lower than your Air Ring plus bonus successes do not detect you."
                ^"Opportunities" STRING "Water (op)(op) (Downtime or Mass Battle): Choose one area and add one terrain quality: Confining, Dangerous, Entangling, Obscuring. Water (op)(op) (Other Scene): Choose a position; up to three range bands surrounding it gain one terrain quality. Water (op)+: Discover location and composition of enemy forces led by characters with Air Ring lower than your vigilance plus (op) spent. Water (op)(op)(op): During your next turn, if you target an enemy cohort, ignore any fortification it is occupying."
            }

            ^"The Patient Viper" {
                ^"Type" STRING "Ninjutsu"
                ^"Rank" INTEGER 2
                ^"Activation" STRING "As a downtime activity, you may make a TN 4 Fitness (Earth) check targeting your cohort or yourself and a number of characters up to your ranks in Command who are within Dangerous, Entangling, or Obscuring terrain"
                ^"Effect" STRING "If you succeed, all targets become hidden and are not noticed by characters with vigilance lower than or equal to your Earth Ring plus bonus successes. Hidden characters cannot be targeted by Attack actions. Persists until end of your next turn, or until any target performs an Attack or Movement action."
                ^"Opportunities" STRING "Earth (op)+: Persists for one additional round per (op) spent. Earth (op)+: Reduce the TN of the first Attack action check one of your targets makes against another character in the terrain by 1 per (op) spent."
            }

            ^"Vanish in the Shadows" {
                ^"Type" STRING "Ninjutsu"
                ^"Rank" INTEGER 3
                ^"Activation" STRING "As a downtime activity or once per scene as a Movement and Support action, you may make a TN 5 Survival (Air) check targeting your cohort or yourself and a number of characters up to your ranks in Command who are within Confining, Entangling, or Obscuring terrain. In urban environments use Skulduggery; on the ocean use Seafaring."
                ^"Effect" STRING "If you succeed, all targets become hidden and are not noticed by characters with vigilance lower than or equal to your Air Ring plus bonus successes. Hidden characters cannot be targeted by or perform Attack actions. Persists until end of your next turn, or until any target performs an Attack action."
                ^"Opportunities" STRING "Air (op)+ (Mass Battle): If you succeed, enemy army receives 1 panic per (op) spent. Air (op)+ (Other Scene): Each non-targeted character within the terrain receives 1 strife per (op) spent. Air (op)(op)(op): If you failed, increase the TN of Attack action checks targeting each of your targets by 2. Persists until any target performs an Attack action or leaves the terrain."
            }

            ^"Wreak Havoc" {
                ^"Type" STRING "Ninjutsu"
                ^"Rank" INTEGER 4
                ^"Activation" STRING "Once per game session as an Attack and Movement action during a mass battle, you may make a Skulduggery (Fire) check targeting one enemy leader's cohort. TN equals that leader's vigilance. You may expend 1 charge of blasting powder and forfeit honor equal to half your honor rank (rounded up) to reduce TN by 2 (minimum 1)."
                ^"Effect" STRING "If you succeed, achieve one: reduce a fortification's difficulty value by 4 plus bonus successes (destroying it if reduced to 0 or lower); remove Confining and Entangling terrain but add Dangerous and Obscuring; or remove one cohort ability from the target cohort. Additionally, the target leader must resist with TN 5 Command check (Air 6, Water 3) or their army suffers panic equal to your ranks in Performance plus their shortfall."
                ^"Opportunities" STRING "Fire (op): Target cohort's leader suffers a critical strike with severity equal to 6 plus bonus successes. Fire (op)(op): Target cohort's leader suffers Dazed. Fire (op)+: Expend additional charges of blasting powder up to (op) spent to add two bonus successes per charge expended."
            }
        }

        RULES {
            #L5RFV37gH8iJ0kL2mN4oP6q: fov_techniques_extend_core
        }
    }

    # ===========================
    # TITLES
    # ===========================

    ^"Fields of Victory Titles" DEF {
        APPLIES TO [^"Samurai"]

        ENTRIES {
            ^"Ashigaru" {
                ^"Assigned By" STRING "Any samurai officer. You must survive at least one mass battle to receive this title."
                ^"Glory Award" STRING "+5 (to a maximum of 29)"
                ^"Status Award" STRING "+3 (to a maximum of 19)"
                ^"XP to Completion" INTEGER 20
                ^"Title Ability" STRING "A Thousand Stinging Cuts"
                ^"Title Ability Effect" STRING "When you provide assistance on the Martial Arts [Melee] Attack action check of another character at range 0-2, the character you are assisting treats their target's physical resistance as 1 lower for each assisting character with this ability."
                ^"Advancement" LIST OF STRING [
                    "Martial Skills (Skill Group)",
                    "Courtesy (Skill)",
                    "Command (Skill)",
                    "Survival (Skill)",
                    "Rank 1-2 Kata (kata) (Tech Group)",
                    "Thicket's Embrace Style (kata)",
                    "Slippery Maneuvers (shuji)"
                ]
            }

            ^"Deathseeker" {
                ^"Assigned By" STRING "Disgraced Lion Clan samurai may take this title upon themselves, pending approval from the GM."
                ^"Status Award" STRING "-25 (to a minimum of 20)"
                ^"XP to Completion" INTEGER 8
                ^"Immediate Effects" STRING "You give up any positions you hold and your worldly possessions, save one weapon and a set of ceremonial robes."
                ^"Title Ability" STRING "Kirifu's Oath"
                ^"Title Ability Effect" STRING "As a Support action, you may suffer the Enraged condition. While you are Enraged, you can perform Attack actions even while Incapacitated."
                ^"Advancement" LIST OF STRING [
                    "Martial Skills (Skill Group)",
                    "Command (Skill)",
                    "Government (Skill)",
                    "Medicine (Skill)",
                    "Beseech Shiba's Calm (ritual)",
                    "Tactical Assessment (kata)",
                    "Warrior's Resolve (kata)"
                ]
            }

            ^"Elemental Guard" {
                ^"Assigned By" STRING "An Elemental Master."
                ^"Glory Award" STRING "+10"
                ^"Status Award" STRING "+10"
                ^"XP to Completion" INTEGER 20
                ^"Title Ability" STRING "Wrath of the Elements"
                ^"Title Ability Effect" STRING "Choose one: Air, Earth, Fire, or Water. This is your elemental specialty. Once per scene after making a Martial skill check that uses the ring of your elemental specialty, you may inflict an amount of strife or panic equal to your ranks in that ring against a target at range 0-3 or a cohort in the scene."
                ^"Advancement" LIST OF STRING [
                    "Martial Skills (Skill Group)",
                    "Courtesy (Skill)",
                    "Labor (Skill)",
                    "Theology (Skill)",
                    "Rank 1-3 Kata (kata) (Tech Group)",
                    "A Samurai's Fate (shuji)",
                    "Moment of Glory (shuji)"
                ]
            }

            ^"Elemental Legionnaire" {
                ^"Assigned By" STRING "A daimyo of the Shiba family or the Phoenix Clan Champion, with permission from a member of the Elemental Council."
                ^"Glory Award" STRING "+10"
                ^"Status Award" STRING "+10"
                ^"XP to Completion" INTEGER 24
                ^"Title Ability" STRING "Strength of the Elements"
                ^"Title Ability Effect" STRING "Choose one: Air, Earth, Fire, or Water. This is your elemental specialty. Once per scene after making a Martial skill check that uses the ring of your elemental specialty, you and a number of targets at range 0-3 (or other cohort leaders in the scene) up to your ranks in Command may remove strife equal to your ranks in that ring."
                ^"Advancement" LIST OF STRING [
                    "Martial Skills (Skill Group)",
                    "Command (Skill)",
                    "Medicine (Skill)",
                    "Smithing (Skill)",
                    "Rank 1-3 Kata (kata) (Tech Group)",
                    "Great Anvil's Measure (shuji)",
                    "Moment of Glory (shuji)"
                ]
            }

            ^"General" {
                ^"Assigned By" STRING "A clan or family daimyo with a status of 60 or higher, often following a great military achievement."
                ^"Glory Award" STRING "+10"
                ^"Status Award" STRING "+25 (to a maximum of 85)"
                ^"XP to Completion" INTEGER 50
                ^"Title Ability" STRING "Superior Command"
                ^"Title Ability Effect" STRING "While you are the commander of an army during a mass battle, your army's discipline value is increased by your ranks in Command. Additionally, when making an Initiative check during a mass battle, increase the result by your ranks in Tactics."
                ^"Advancement" LIST OF STRING [
                    "Social Skills (Skill Group)",
                    "Martial Skills (Skill Group)",
                    "Government (Skill)",
                    "Survival (Skill)",
                    "Rank 1-2 Kata (kata) (Tech Group)",
                    "Rank 1-3 Rituals (ritual) (Tech Group)",
                    "Rank 1-4 Shūji (shuji) (Tech Group)"
                ]
            }

            ^"Lion's Pride Warrior" {
                ^"Assigned By" STRING "An existing member of the Lion's Pride."
                ^"Glory Award" STRING "+10"
                ^"Status Award" STRING "+20 (to a maximum of 59)"
                ^"XP to Completion" INTEGER 24
                ^"Title Ability" STRING "Fury of Matsu"
                ^"Title Ability Effect" STRING "Once per scene, when you deal damage to a target or deal attrition to an enemy leader's cohort, increase the damage or attrition by an amount equal to the difference between your honor rank and the target's honor rank."
                ^"Advancement" LIST OF STRING [
                    "Martial Skills (Skill Group)",
                    "Command (Skill)",
                    "Sentiment (Skill)",
                    "Survival (Skill)",
                    "Rank 1-3 Kata (kata) (Tech Group)",
                    "A Samurai's Fate (shuji)",
                    "Battle of No Escape (shuji)"
                ]
            }

            ^"Master Saboteur" {
                ^"Assigned By" STRING "Three other master saboteurs, who are usually members of a general's command staff or found leading specialized clandestine units."
                ^"Status Award" STRING "None"
                ^"XP to Completion" INTEGER 40
                ^"Title Ability" STRING "Ender of Works"
                ^"Title Ability Effect" STRING "When a fortification's difficulty value would be reduced during a mass battle, the value is lowered by that amount plus your ranks in Labor instead. If there is a cohort occupying it, that cohort's army suffers panic equal to your ranks in Skulduggery."
                ^"Advancement" LIST OF STRING [
                    "Trade Skills (Skill Group)",
                    "Government (Skill)",
                    "Martial Arts [Unarmed] (Skill)",
                    "Medicine (Skill)",
                    "Rank 1-2 Ninjutsu (ninjutsu) (Tech Group)",
                    "Imbue Thunder (ritual)",
                    "Wreak Havoc (ninjutsu)"
                ]
            }

            ^"Poet of War" {
                ^"Assigned By" STRING "A general or other officer with status 50 or higher."
                ^"Glory Award" STRING "+10 (to a maximum of 55)"
                ^"XP to Completion" INTEGER 20
                ^"Title Ability" STRING "The Hand of Our Ancestors"
                ^"Title Ability Effect" STRING "After you perform a successful Rally action, the targeted cohort deals 1 additional attrition when its leader performs a successful Attack action check. This effect persists for one round."
                ^"Advancement" LIST OF STRING [
                    "Social Skills (Skill Group)",
                    "Composition (Skill)",
                    "Culture (Skill)",
                    "Sentiment (Skill)",
                    "Rank 1-2 Fire Shūji (shuji) (Tech Group)",
                    "Borrowed Courage (shuji)",
                    "Coursing March Chant (shuji)"
                ]
            }

            ^"Quartermaster" {
                ^"Assigned By" STRING "Clan or castle daimyo, army general, or other officer of sufficient rank."
                ^"Status Award" STRING "+5 (to a maximum of 35)"
                ^"XP to Completion" INTEGER 24
                ^"Title Ability" STRING "Procurement and Supply"
                ^"Title Ability Effect" STRING "When you make a check as a downtime activity to provision an army, you may spend (op) as follows: (op)+: If you succeed, your army increases its discipline and strength each by 1 per (op) spent. This effect persists until the end of the next mass battle scene."
                ^"Advancement" LIST OF STRING [
                    "Trade Skills (Skill Group)",
                    "Courtesy (Skill)",
                    "Government (Skill)",
                    "Tactics (Skill)",
                    "Rank 1-2 Air Shūji (shuji) (Tech Group)",
                    "Rank 1-2 Water Shūji (shuji) (Tech Group)",
                    "Fortress of Necessity (shuji)"
                ]
            }

            ^"Renowned Warrior" {
                ^"Assigned By" STRING "A daimyo or army commander with status 60 or higher after you have been part of a mass battle in which your cohort completed at least one strategic objective."
                ^"Glory Award" STRING "+5"
                ^"Status Award" STRING "+5 (to a maximum of 40)"
                ^"XP to Completion" INTEGER 16
                ^"Title Ability" STRING "Behold the Legend"
                ^"Title Ability Effect" STRING "Once per scene, after you make a successful Martial Arts check that inflicts fatigue or a critical strike on the target, you may have each friendly character at range 0-3 of you or the target remove an amount of strife equal to the TN of the check."
                ^"Advancement" LIST OF STRING [
                    "Martial Skills (Skill Group)",
                    "Command (Skill)",
                    "Culture (Skill)",
                    "Performance (Skill)",
                    "Rank 1-2 Kata (kata) (Tech Group)",
                    "Heartpiercing Strike (kata)",
                    "Righteous Example (shuji)"
                ]
            }

            ^"Spirit Caller" {
                ^"Assigned By" STRING "An instructor of a Kitsu school or other appropriate spiritual leader."
                ^"Status Award" STRING "+15 (to a maximum of 40)"
                ^"XP to Completion" INTEGER 38
                ^"Title Ability" STRING "Eyes of the Ancestors"
                ^"Title Ability Effect" STRING "Once per game session as a Support action, you may spend 1 Void point to summon the spirit of an ancestor to partially possess you until the end of the scene. Choose a ring and a skill from that ancestor's profile; while possessed, you count as an Otherworldly being and use your ancestor's ring value and skill rank in place of your own, as well as your ancestor's honor value. Your ancestor can use any non-unique human NPC profile (or a kitsu's or other supernatural being's profile, if appropriate). The higher of this NPC's conflict ranks cannot exceed your school rank plus your ranks in Meditation. The ancestor spirit may divulge pertinent information at the GM's discretion. Afterward, you have only a hazy memory of anything you experienced while possessed."
                ^"Advancement" LIST OF STRING [
                    "Scholar Skills (Skill Group)",
                    "Courtesy (Skill)",
                    "Meditation (Skill)",
                    "Performance (Skill)",
                    "Rank 1-2 Rituals (ritual) (Tech Group)",
                    "Ancestry Unearthed (shuji)",
                    "Preserve Strength (shuji)"
                ]
            }

            ^"Sumai Master" {
                ^"Assigned By" STRING "An existing sumai master, once you have proven your ability to them."
                ^"Glory Award" STRING "+10 (to a maximum of 50)"
                ^"Status Award" STRING "+10 (to a minimum of 35)"
                ^"XP to Completion" INTEGER 30
                ^"Title Ability" STRING "Unsurpassed Soul"
                ^"Title Ability Effect" STRING "When you make a Martial Arts [Unarmed] check targeting another character, if your Void ring is higher than or equal to your target's Void ring, reduce the TN by 2 (to a minimum of 1)."
                ^"Advancement" LIST OF STRING [
                    "Social Skills (Skill Group)",
                    "Culture (Skill)",
                    "Martial Arts [Unarmed] (Skill)",
                    "Theology (Skill)",
                    "Rank 1-2 Kata (kata) (Tech Group)",
                    "Beseech Hida's Might (ritual)",
                    "Fierce Badger Style (kata)"
                ]
            }

            ^"Sword-Saint" {
                ^"Assigned By" STRING "A clan champion or the Emperor. Alternately, the title can be assigned by an existing sword-saint who is slain by the character in an honorable duel to the death."
                ^"Glory Award" STRING "+20 (to a maximum of 100)"
                ^"XP to Completion" INTEGER 24
                ^"Title Ability" STRING "Invincible Blade"
                ^"Title Ability Effect" STRING "When you perform an Attack or Support action check that uses a sword, you may spend (op) as follows: Void (op)+: Reduce the severity of the next critical strike you would suffer (before your Fitness check to resist) by your ranks in Meditation plus 1 per (op) spent. Persists until start of your next turn. Any (op)(op): Increase the base damage and deadliness of your weapon by 3. Persists until end of scene. Cumulative if activated multiple times."
                ^"Advancement" LIST OF STRING [
                    "Martial Arts [Melee] (Skill)",
                    "Meditation (Skill)",
                    "Smithing (Skill)",
                    "Tactics (Skill)",
                    "Rank 1-5 Close Combat Kata (kata) (Tech Group)",
                    "Soul Sunder (kata)",
                    "Victory Without a Sword (shuji)"
                ]
            }

            ^"War College Graduate" {
                ^"Assigned By" STRING "An instructor at the Akodo War College."
                ^"Glory Award" STRING "+5 (to a maximum of 60)"
                ^"Status Award" STRING "+10 (to a maximum of 40)"
                ^"XP to Completion" INTEGER 36
                ^"Title Ability" STRING "Learned from History"
                ^"Title Ability Effect" STRING "During a mass battle, when you accrue 1 or more momentum points toward the Draw Them In or Seize Victory strategic objective, you accrue that many momentum points plus 1 instead. Additionally, if your action completes that strategic objective, the enemy army receives additional casualties and panic equal to your ranks in Tactics."
                ^"Advancement" LIST OF STRING [
                    "Martial Skills (Skill Group)",
                    "Command (Skill)",
                    "Culture (Skill)",
                    "Government (Skill)",
                    "Rank 1-3 Kata (kata) (Tech Group)",
                    "Rank 1-3 Shūji (shuji) (Tech Group)",
                    "Beseech Akodo's Judgment (ritual)"
                ]
            }
        }

        RULES {
            #L5RFV38rS9tU1vW3xY5zA7b: fov_titles_narrative_advancement
            #L5RFV39cD0eF2gH4iJ6kL8m: fov_titles_grant_ability_on_completion
        }
    }

    # ===========================
    # NEW DEMEANOR
    # ===========================

    ^"Honorable Demeanor" DEF {
        APPLIES TO [^"Samurai"]

        # The Honorable demeanor reflects a personality often
        # found in Lion Clan members and in other samurai who
        # value the tenet of Meiyo (Honor) above all others. Such
        # characters do not hesitate to overcome their fear and
        # act correctly regardless of the consequences.

        PROPERTIES {
            ^"Demeanor" STRING "Honorable"
            ^"Social Skill Check TN Modifiers" STRING "Fire +2, Earth -2"
            ^"Common Way of Unmasking" STRING "Honor's Challenge: The NPC holds to very high standards of behavior and expects others around them to do the same. When they observe breaches of integrity, they are quick to judge what should be the correct action and insist that it be followed."
        }

        RULES {
            #L5RFV40nO1pQ3rS5tU7vW9x: honorable_demeanor_fire_plus_two_earth_minus_two
        }
    }

