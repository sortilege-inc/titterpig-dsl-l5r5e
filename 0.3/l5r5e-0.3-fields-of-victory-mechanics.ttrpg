    # ===========================
    # OPPORTUNITY TABLES
    # ===========================

    ^"Fields of Victory Opportunity Tables" DEF {
        APPLIES TO [^"Samurai"]

        ^"Mass Battle Opportunities" DEF {
            # Table 3-9: Spending Opportunity in Mass Battles
            # Air (op)+: Choose an allied leader. Reduce TN of their next Scheme action by 1 per (op) spent. Persists until end of scene.
            # Air (op)(op): Choose a leader in a fortification. That leader's cohort loses the benefits of the fortification until the beginning of your next turn.
            # Earth (op)+: Remove 1 panic from your army per (op) spent.
            # Earth (op)(op): Choose an allied leader. That leader's cohort cannot be targeted by Attack actions until the beginning of your next turn.
            # Fire (op)+: The enemy army suffers 1 panic per (op) spent.
            # Fire (op)+: When performing an Attack action against a cohort of an enemy leader with vigilance lower than or equal to (op) spent, after effects resolved, inflict a critical strike with severity equal to the deadliness of one of your weapons on that leader.
            # Water (op)+: Choose an allied leader. Reduce TN of their next Movement action by 1 per (op) spent.
            # Water (op)(op): Choose an enemy leader. That leader's cohort cannot perform Movement actions until the beginning of your next turn.
            # Void (op)+: Your army and each enemy army suffer 2 attrition per (op) spent.
            # Void (op)(op): When you perform a Support action, after effects resolved, you may immediately perform a Challenge action targeting an enemy cohort's leader.
            # Void (op)(op): Increase the army's strength and discipline by 3. Persists until end of scene.
        }

        ^"Contested Territory Opportunities" DEF {
            # Table 3-10: Spending Opportunity in Contested Territory
            # Air (op): Discern signs of incoming trouble. Next conflict scene this session, add a kept die showing (op) to your Initiative check.
            # Air (op)(op) or (op)(op)(op): Create a clever disguise or ruse. Next conflict scene, after Initiative, choose one character; on their next check, they must reroll all results containing (su).
            # Earth (op): Reduce TN of next check dealing with unfamiliar situation or opponent by 1.
            # Earth (op): Remove 1 strife for each condition you are currently suffering.
            # Fire (op)(op): Immediately attempt a Scholar skill check to learn about current situation or present NPC, lowering TN by 1 (minimum 1).
            # Fire (op)+: Any number of allies may remove 1 strife per (op) spent; for each character affected, you receive 1 strife.
            # Water (op)(op)+: For each (op)(op) spent, one hostile character becomes friendlier toward you.
            # Water (op)(op): Learn of one key feature, fortification, or terrain quality, and whether enemies have passed through recently.
            # Void (op)+: You and a hostile character each recover 2 strife per (op) spent.
            # Void (op)(op): Discover a neutral meeting place, protective legal precedent, or similar safe haven.
        }

        RULES {
            #L5RFV42jK3lM5nO7pQ9rS1t: fov_opportunity_tables_mass_battle_and_territory
        }
    }

    # ===========================
    # OPTIONAL RULES: TRIFLING BREACHES & SMALL SACRIFICES
    # ===========================

    ^"Honor Rules" DEF {
        APPLIES TO [^"Samurai"]

        # Optional additions to the core honor and glory forfeits/awards table.

        ^"Trifling Breaches" DEF {
            # When a character wishes to commit a breach of honor
            # judged less serious than a minor breach, they must first
            # forfeit 1 honor. Examples include:
            # - Telling a half-truth to make a story more interesting
            # - Carrying out your lord's orders in a less expedient manner for personal convenience
            # - Privately, but verbally, cursing the actions of a higher-status samurai
        }

        ^"Small Sacrifices" DEF {
            # When a character makes a sacrifice in the name of
            # honor judged less significant than a minor sacrifice,
            # they are awarded 1 honor. Examples include:
            # - Allowing a verbal insult directed at you to pass without reprisal
            # - Refusing to use information overheard from behind a closed door as testimony
            # - Aiding a friend who has been publicly disgraced but you know to be innocent
        }

        RULES {
            #L5RFV43uV4wX6yZ8aB0cD2e: trifling_breach_forfeit_one_honor
            #L5RFV44fG5hI7jK9lM1nO3p: small_sacrifice_gain_one_honor
        }
    }
}
