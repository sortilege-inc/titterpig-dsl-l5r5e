EXTENSION "L5R5e_Emerald_Empire" EXTENDS "L5R5e_Core_Character" {
    NAME "Legend of the Five Rings 5th Edition - Emerald Empire: New Player Options"
    VERSION "0.3"
    RELEASE_DATE "2026-03-01"

    # Emerald Empire (Chapter 7): Imperial families, new schools,
    # advantages, disadvantages, techniques, and titles.
    # This extension adds options from the Emerald Empire sourcebook
    # to the core character creation and advancement systems.

    # ===========================
    # IMPERIAL FAMILIES
    # ===========================

    ^"Imperial Families" DEF {
        EXTENDS #L5R250aB2cD4eF6gH8iJ0k ^"Clan"
        APPLIES TO [^"Samurai"]

        # The Imperial families serve the Emperor directly.
        # They function as a clan for mechanical purposes but
        # are not part of any Great Clan. They hold special
        # authority and responsibilities within the Celestial Order.

        PROPERTIES {
            ^"Clan Name" STRING "Imperial" FIXED
            ^"Clan Type" STRING "Imperial"
            ^"Clan Ring Bonus" DEF { ^"Air" INTEGER 1 }
            ^"Clan Skill Bonus" DEF { ^"Government" INTEGER 1 }
            ^"Clan Status" INTEGER DEFAULT 40
        }

        FAMILIES {
            ^"Miya"
            ^"Otomo"
            ^"Seppun"
        }

    }


    # ===========================
    # IMPERIAL FAMILIES
    # ===========================

    #L5REE50hI5jK7lM9nO1pQ3r ^"Miya" DEF {
        EXTENDS #L5R251lM3nO5pQ7rS9tU1v ^"Family"
        APPLIES TO [^"Samurai"]

        PROPERTIES {
            ^"Family Name"     STRING "Miya" FIXED
            ^"Clan"            STRING "Imperial"
            ^"Ring Increase" DEF { CHOOSE 1 [^"Air", ^"Earth"] INTEGER 1 }
            ^"Skill Increases" DEF {
                ^"Courtesy" INTEGER 1
                ^"Culture" INTEGER 1
            }
            ^"Glory"           INTEGER 44
            ^"Starting Wealth" INTEGER 8
        }
    }

    #L5REE51sT6uV8wX0yZ2aB4c ^"Otomo" DEF {
        EXTENDS #L5R251lM3nO5pQ7rS9tU1v ^"Family"
        APPLIES TO [^"Samurai"]

        PROPERTIES {
            ^"Family Name"     STRING "Otomo" FIXED
            ^"Clan"            STRING "Imperial"
            ^"Ring Increase" DEF { CHOOSE 1 [^"Air", ^"Water"] INTEGER 1 }
            ^"Skill Increases" DEF {
                ^"Culture" INTEGER 1
                ^"Sentiment" INTEGER 1
            }
            ^"Glory"           INTEGER 43
            ^"Starting Wealth" INTEGER 9
        }
    }

    #L5REE52dE7fG9hI1jK3lM5n ^"Seppun" DEF {
        EXTENDS #L5R251lM3nO5pQ7rS9tU1v ^"Family"
        APPLIES TO [^"Samurai"]

        PROPERTIES {
            ^"Family Name"     STRING "Seppun" FIXED
            ^"Clan"            STRING "Imperial"
            ^"Ring Increase" DEF { CHOOSE 1 [^"Earth", ^"Void"] INTEGER 1 }
            ^"Skill Increases" DEF {
                ^"Meditation" INTEGER 1
                ^"Theology" INTEGER 1
            }
            ^"Glory"           INTEGER 45
            ^"Starting Wealth" INTEGER 6
        }
    }


    # ===========================
    # NEW SCHOOLS
    # ===========================

    ^"Miya Cartographer" DEF {
        EXTENDS #L5R252wX4yZ6aB8cD0eF2g ^"School"
        APPLIES TO [^"Samurai"]

        # Imperial cartographers who travel throughout the Empire
        # mapping territories. They have standing authority to cross
        # clan boundaries freely. Trained in both academic and
        # wilderness survival skills.

        PROPERTIES {
            ^"Clan" STRING "Imperial"
            ^"School Name" STRING "Miya Cartographer" FIXED
            ^"Roles" LIST ["Artisan", "Courtier"]
            ^"Ring Increase" DEF {
                ^"Air" INTEGER 1
                ^"Earth" INTEGER 1
            }
            ^"Starting Skills" DEF { CHOOSE 5 [^"Aesthetics", ^"Composition", ^"Culture", ^"Fitness", ^"Government", ^"Seafaring", ^"Survival"] INTEGER 1 }
            ^"Starting Honor" INTEGER DEFAULT 50
            ^"Techniques Available" LIST ["Kata", "Rituals", "Shūji"]
        }


        STARTING_TECHNIQUES {
            KATA CHOOSE 1 [^"Striking as Earth", ^"Warrior's Resolve"]
            SHUJI CHOOSE 1 [^"Artisan's Appraisal", ^"Civility Foremost"]
        }

        SCHOOL_ABILITY "Well Traveled" {
            "You always know which way is north and can always find a useful navigation landmark. When making a check to recall or ascertain geographical, political, or societal information, add kept (ring) set to (op) or (su) results equal to your school rank."
        }

        MASTERY_ABILITY ^"Emerald Explorer" {
            "Once per scene as a Support action, make a TN 1 Survival (Earth) check targeting one character. If you succeed, that character and additional characters equal to your bonus successes ignore all negative effects of terrain qualities until end of scene."
        }
        STARTING_OUTFIT [
            "traveling clothes", "wakizashi (short sword)",
            "yumi (bow) and quiver of arrows", "knife",
            "calligraphy set", "traveling pack", "personal chop",
            "an assortment of maps in scroll cases",
            "an attendant or Rokugani pony"
        ]

        CURRICULUM {
            RANK 1 {
                SKILL_GROUP "Artisan Skills"
                SKILL "Culture"
                SKILL "Fitness"
                SKILL "Survival"
                TECHNIQUE_GROUP "Rank 1 Earth Shūji"
                ^"Slippery Maneuvers" [shuji]
                ^"Threshold Barrier" [ritual]
            }
            RANK 2 {
                SKILL_GROUP "Scholar Skills"
                SKILL "Games"
                SKILL "Martial Arts [Melee]"
                SKILL "Survival"
                TECHNIQUE_GROUP "Rank 1-2 Kata"
                ^"The Wind Blows Both Ways" [shuji]
                ^"Feigned Opening" [shuji]
            }
            RANK 3 {
                SKILL_GROUP "Trade Skills"
                SKILL "Courtesy"
                SKILL "Culture"
                SKILL "Martial Arts [Ranged]"
                TECHNIQUE_GROUP "Rank 1-3 Air Shūji"
                ^"Crimson Leaves Strike" [kata]
                ^"All Arts Are One" [shuji]
            }
            RANK 4 {
                SKILL_GROUP "Scholar Skills"
                SKILL "Courtesy"
                SKILL "Martial Arts [Unarmed]"
                SKILL "Meditation"
                TECHNIQUE_GROUP "Rank 1-4 Kata"
                ^"Bend with the Storm" [shuji]
                ^"Regal Bearing" [shuji]
            }
            RANK 5 {
                SKILL_GROUP "Artisan Skills"
                SKILL "Command"
                SKILL "Culture"
                SKILL "Seafaring"
                TECHNIQUE_GROUP "Rank 1-5 Earth Shūji"
                ^"Awe of Heaven" [shuji]
                ^"Bravado" [shuji]
            }
            RANK 6 {
                ^"Emerald Explorer"
            }
        }

    }

    ^"Miya Herald" DEF {
        EXTENDS #L5R252wX4yZ6aB8cD0eF2g ^"School"
        APPLIES TO [^"Samurai"]

        # Imperial messengers who deliver edicts and messages
        # throughout the Empire. They speak with the Emperor's
        # authority and travel freely across all boundaries. Known
        # for speed, objectivity, and strict reporting.

        PROPERTIES {
            ^"Clan" STRING "Imperial"
            ^"School Name" STRING "Miya Herald" FIXED
            ^"Roles" LIST ["Courtier"]
            ^"Ring Increase" DEF {
                ^"Air" INTEGER 1
                ^"Water" INTEGER 1
            }
            ^"Starting Skills" DEF { CHOOSE 5 [^"Command", ^"Composition", ^"Courtesy", ^"Fitness", ^"Seafaring", ^"Sentiment", ^"Survival"] INTEGER 1 }
            ^"Starting Honor" INTEGER DEFAULT 50
            ^"Techniques Available" LIST ["Kata", "Rituals", "Shūji"]
        }


        STARTING_TECHNIQUES {
            SHUJI CHOOSE 1 [^"Cadence", ^"Honest Assessment"]
            SHUJI CHOOSE 1 [^"Shallow Waters", ^"Weight of Duty"]
        }

        SCHOOL_ABILITY "Voice of the Emperor" {
            "Once per round, after a character at range 0-4 succeeds on an Attack or Scheme action check, you may cause them to receive strife equal to your school rank."
        }

        MASTERY_ABILITY ^"Blessings of the Emperor" {
            "Once per scene as a Scheme action, make a TN 4 Command (Air) check targeting up to your glory rank characters. If you succeed, targets must forfeit honor equal to twice their honor rank and glory equal to twice their glory rank before targeting you with Attack actions, and increase TN of Attack actions targeting you by 2. Persists until end of scene or until you attack an affected character or their allies. (op)+: Effects also apply to targets' attacks against one chosen ally per (op) spent."
        }
        STARTING_OUTFIT [
            "traveling clothes", "ceremonial clothes",
            "wakizashi (short sword)",
            "yumi (bow) and quiver of arrows or tessen (war fan)",
            "calligraphy set", "traveling pack",
            "satchel of Imperial proclamations",
            "personal chop", "an attendant or Rokugani pony"
        ]

        CURRICULUM {
            RANK 1 {
                SKILL_GROUP "Social Skills"
                SKILL "Culture"
                SKILL "Fitness"
                SKILL "Survival"
                TECHNIQUE_GROUP "Rank 1 Water Shūji"
                ^"Feigned Opening" [shuji]
                ^"Courtier's Resolve" [shuji]
            }
            RANK 2 {
                SKILL_GROUP "Trade Skills"
                SKILL "Courtesy"
                SKILL "Culture"
                SKILL "Martial Arts [Melee]"
                TECHNIQUE_GROUP "Rank 1-2 Air Shūji"
                ^"Ebb and Flow" [shuji]
                ^"Tributaries of Trade" [shuji]
            }
            RANK 3 {
                SKILL_GROUP "Scholar Skills"
                SKILL "Command"
                SKILL "Courtesy"
                SKILL "Survival"
                TECHNIQUE_GROUP "Rank 1-3 Earth Shūji"
                ^"Awe of Heaven" [shuji]
                ^"The Wind Blows Both Ways" [shuji]
            }
            RANK 4 {
                SKILL_GROUP "Artisan Skills"
                SKILL "Command"
                SKILL "Fitness"
                SKILL "Survival"
                TECHNIQUE_GROUP "Rank 1-4 Water Shūji"
                ^"Buoyant Arrival" [shuji]
                ^"Pillar of Calm" [shuji]
            }
            RANK 5 {
                SKILL_GROUP "Social Skills"
                SKILL "Culture"
                SKILL "Sentiment"
                SKILL "Survival"
                TECHNIQUE_GROUP "Rank 1-5 Void Shūji"
                ^"Sear the Wound" [shuji]
                ^"The Immovable Hand of Peace" [shuji]
            }
            RANK 6 {
                ^"Blessings of the Emperor"
            }
        }

    }

    ^"Otomo Schemer" DEF {
        EXTENDS #L5R252wX4yZ6aB8cD0eF2g ^"School"
        APPLIES TO [^"Samurai"]

        # Consummate politicians who advance Imperial agendas
        # across the courts of the Empire. They earn favors,
        # cultivate allies, and destroy enemies with ruthless
        # political acumen. The ends justify the means.

        PROPERTIES {
            ^"Clan" STRING "Imperial"
            ^"School Name" STRING "Otomo Schemer" FIXED
            ^"Roles" LIST ["Courtier"]
            ^"Ring Increase" DEF {
                ^"Air" INTEGER 1
                ^"Fire" INTEGER 1
            }
            ^"Starting Skills" DEF { CHOOSE 5 [^"Command", ^"Composition", ^"Courtesy", ^"Culture", ^"Design", ^"Government", ^"Sentiment"] INTEGER 1 }
            ^"Starting Honor" INTEGER DEFAULT 45
            ^"Techniques Available" LIST ["Kata", "Rituals", "Shūji"]
        }


        STARTING_TECHNIQUES {
            SHUJI CHOOSE 1 [^"Courtier's Resolve", ^"Stirring the Embers"]
            SHUJI ^"Slippery Maneuvers"
        }

        SCHOOL_ABILITY "Necessary Actions" {
            "You never forfeit honor or glory to lie or deceive for the good of the Emperor and Empire (in your opinion). However, you must forfeit twice as much honor or glory to lie for your personal gain (in your opinion). When a character stakes or forfeits honor or glory to act against your desires, you may force them to increase that amount by your school rank."
        }

        MASTERY_ABILITY ^"Majesty of the Throne" {
            "Once per scene as a Scheme action, make a Command (Water) check targeting any number of characters at range 0-5. TN equals the highest status rank among your targets. If you succeed, all targets suffer the Dazed and Disoriented conditions."
        }
        STARTING_OUTFIT [
            "ceremonial clothes", "wakizashi (short sword)",
            "any one weapon of rarity 6 or lower",
            "calligraphy set", "traveling pack",
            "a trustworthy attendant"
        ]

        CURRICULUM {
            RANK 1 {
                SKILL_GROUP "Social Skills"
                SKILL "Composition"
                SKILL "Culture"
                SKILL "Government"
                TECHNIQUE_GROUP "Rank 1 Air Shūji"
                ^"Civility Foremost" [shuji]
                ^"Tea Ceremony" [ritual]
            }
            RANK 2 {
                SKILL_GROUP "Scholar Skills"
                SKILL "Command"
                SKILL "Courtesy"
                SKILL "Martial Arts [Melee]"
                TECHNIQUE_GROUP "Rank 1-2 Water Shūji"
                ^"Awe of Heaven" [shuji]
                ^"Prey on the Weak" [shuji]
            }
            RANK 3 {
                SKILL_GROUP "Artisan Skills"
                SKILL "Commerce"
                SKILL "Courtesy"
                SKILL "Sentiment"
                TECHNIQUE_GROUP "Rank 1-3 Fire Shūji"
                ^"Regal Bearing" [shuji]
                ^"The Wind Blows Both Ways" [shuji]
            }
            RANK 4 {
                SKILL_GROUP "Scholar Skills"
                SKILL "Aesthetics"
                SKILL "Command"
                SKILL "Skulduggery"
                TECHNIQUE_GROUP "Rank 1-4 Fire Shūji"
                ^"Buoyant Arrival" [shuji]
                ^"Wolf's Proposal" [shuji]
            }
            RANK 5 {
                SKILL_GROUP "Social Skills"
                SKILL "Composition"
                SKILL "Culture"
                SKILL "Design"
                TECHNIQUE_GROUP "Rank 1-5 Air Shūji"
                ^"Sear the Wound" [shuji]
                ^"The Immovable Hand of Peace" [shuji]
            }
            RANK 6 {
                ^"Majesty of the Throne"
            }
        }

    }

    ^"Seppun Astrologer" DEF {
        EXTENDS #L5R252wX4yZ6aB8cD0eF2g ^"School"
        APPLIES TO [^"Samurai"]

        # The spiritual protectors of the Emperor, specializing in
        # astrology, divination, fortune-telling, and ward creation.
        # They anticipate and preempt supernatural threats, working
        # closely with the Palace Guard.

        PROPERTIES {
            ^"Clan" STRING "Imperial"
            ^"School Name" STRING "Seppun Astrologer" FIXED
            ^"Roles" LIST ["Shugenja", "Artisan"]
            ^"Ring Increase" DEF {
                ^"Air" INTEGER 1
                ^"Water" INTEGER 1
            }
            ^"Starting Skills" DEF { CHOOSE 3 [^"Composition", ^"Government", ^"Medicine", ^"Meditation", ^"Sentiment", ^"Theology"] INTEGER 1 }
            ^"Starting Honor" INTEGER DEFAULT 40
            ^"Techniques Available" LIST ["Invocations", "Rituals", "Shūji"]
        }


        STARTING_TECHNIQUES {
            INVOCATION ^"Bind the Shadow"
            INVOCATION CHOOSE 1 [^"Dominion of Suijin", ^"Jade Strike"]
            RITUAL ^"Divination"
            RITUAL ^"Commune with the Spirits"
            RITUAL ^"Threshold Barrier"
        }

        SCHOOL_ABILITY "Just as Predicted" {
            "At the beginning of a game session or as a downtime activity, make a TN 1 Theology check using any ring. If you succeed, choose a number of kept dice up to your school rank to reserve. Until end of session or next downtime scene, when any character makes a skill check using the chosen ring, you may replace one or more kept dice with the same number of reserved dice of the same type."
        }

        MASTERY_ABILITY ^"Foreseen in the Stars" {
            "Once per game session, spend 1 Void point to reveal you have foreseen an event in the current scene. Retroactively declare one or more preparations you have taken, subject to GM approval. If preparations require a skill check, make it when you use this ability."
        }
        STARTING_OUTFIT [
            "sanctified robes", "concealed armor",
            "wakizashi (short sword)", "bo (staff) or knife",
            "calligraphy set", "traveling pack",
            "scroll satchel", "divination kit"
        ]

        CURRICULUM {
            RANK 1 {
                SKILL_GROUP "Scholar Skills"
                SKILL "Composition"
                SKILL "Skulduggery"
                SKILL "Tactics"
                TECHNIQUE_GROUP "Rank 1 Water Invocations"
                ^"Heart of the Water Dragon" [invocation]
                ^"Ancestry Unearthed" [shuji]
            }
            RANK 2 {
                SKILL_GROUP "Scholar Skills"
                SKILL "Command"
                SKILL "Composition"
                SKILL "Meditation"
                TECHNIQUE_GROUP "Rank 1-2 Air Invocations"
                ^"Ebb and Flow" [shuji]
                ^"Symbol of Earth" [invocation]
            }
            RANK 3 {
                SKILL_GROUP "Martial Skills"
                SKILL "Sentiment"
                SKILL "Smithing"
                SKILL "Theology"
                TECHNIQUE_GROUP "Rank 1-3 Earth Invocations"
                ^"False Realm of the Fox Spirits" [invocation]
                ^"Vapor of Nightmares" [invocation]
            }
            RANK 4 {
                SKILL_GROUP "Artisan Skills"
                SKILL "Sentiment"
                SKILL "Survival"
                SKILL "Theology"
                TECHNIQUE_GROUP "Rank 1-4 Air Invocations"
                ^"Tomb of Jade" [invocation]
                ^"A Samurai's Fate" [shuji]
            }
            RANK 5 {
                SKILL_GROUP "Scholar Skills"
                SKILL "Composition"
                SKILL "Skulduggery"
                SKILL "Tactics"
                TECHNIQUE_GROUP "Rank 1-5 Water Invocations"
                ^"Sear the Wound" [shuji]
                ^"The Soul's Blade" [invocation]
            }
            RANK 6 {
                ^"Foreseen in the Stars"
            }
        }

    }

    ^"Seppun Palace Guard" DEF {
        EXTENDS #L5R252wX4yZ6aB8cD0eF2g ^"School"
        APPLIES TO [^"Samurai"]

        # The Emperor's personal bodyguards, among the most
        # accomplished warriors in the Empire. Trained for defense,
        # they react instantly to threats with supreme patience and
        # awareness. Their iaijutsu skill serves only to counter
        # sudden attacks, not for formal dueling.

        PROPERTIES {
            ^"Clan" STRING "Imperial"
            ^"School Name" STRING "Seppun Palace Guard" FIXED
            ^"Roles" LIST ["Bushi"]
            ^"Ring Increase" DEF {
                ^"Earth" INTEGER 1
                ^"Void" INTEGER 1
            }
            ^"Starting Skills" DEF { CHOOSE 5 [^"Fitness", ^"Martial Arts [Melee]", ^"Martial Arts [Ranged]", ^"Martial Arts [Unarmed]", ^"Meditation", ^"Sentiment", ^"Tactics"] INTEGER 1 }
            ^"Starting Honor" INTEGER DEFAULT 50
            ^"Techniques Available" LIST ["Kata", "Rituals", "Shūji"]
        }


        STARTING_TECHNIQUES {
            KATA CHOOSE 1 [^"Iaijutsu Cut: Crossing Blade", ^"Iaijutsu Cut: Rising Blade"]
            SHUJI CHOOSE 1 [^"Ancestry Unearthed", ^"Honest Assessment"]
        }

        SCHOOL_ABILITY "Speed of Heaven" {
            "When you succeed on an Initiative check during a skirmish or duel, add bonus successes equal to your school rank."
        }

        MASTERY_ABILITY ^"The Clouds Part" {
            "Once per round, spend 1 Void point to add bonus successes equal to your honor rank to a successful Attack or Support action check."
        }
        STARTING_OUTFIT [
            "lacquered armor", "sanctified robes",
            "daishō (katana and wakizashi)", "naginata or bisento",
            "knife", "traveling pack"
        ]

        CURRICULUM {
            RANK 1 {
                SKILL_GROUP "Martial Skills"
                SKILL "Command"
                SKILL "Government"
                SKILL "Sentiment"
                TECHNIQUE_GROUP "Rank 1 Kata"
                ^"Crescent Moon Style" [kata]
                ^"Weight of Duty" [shuji]
            }
            RANK 2 {
                SKILL_GROUP "Martial Skills"
                SKILL "Courtesy"
                SKILL "Culture"
                SKILL "Games"
                TECHNIQUE_GROUP "Rank 1-2 Kata"
                ^"Crimson Leaves Strike" [kata]
                ^"Touchstone of Courage" [shuji]
            }
            RANK 3 {
                SKILL_GROUP "Scholar Skills"
                SKILL "Martial Arts [Melee]"
                SKILL "Command"
                SKILL "Skulduggery"
                TECHNIQUE_GROUP "Rank 1-3 Kata"
                ^"Iron in the Mountains Style" [kata]
                ^"Threshold Barrier" [ritual]
            }
            RANK 4 {
                SKILL_GROUP "Martial Skills"
                SKILL "Command"
                SKILL "Government"
                SKILL "Theology"
                TECHNIQUE_GROUP "Rank 1-4 Kata"
                ^"Soul Sunder" [kata]
                ^"A Samurai's Fate" [shuji]
            }
            RANK 5 {
                SKILL_GROUP "Martial Skills"
                SKILL "Sentiment"
                SKILL "Skulduggery"
                SKILL "Survival"
                TECHNIQUE_GROUP "Rank 1-5 Kata"
                ^"Rouse the Soul" [shuji]
                ^"The Immovable Hand of Peace" [shuji]
            }
            RANK 6 {
                ^"The Clouds Part"
            }
        }

    }

    ^"Fortunist Monk Order" DEF {
        EXTENDS #L5R252wX4yZ6aB8cD0eF2g ^"School"
        APPLIES TO [^"Samurai"]

        # Monks who revere the Fortunes, seeking to understand the
        # surrounding world through service to divine spirits. They
        # cannot commune with kami like shugenja, but earn the favor
        # of a Fortune who grants them invocations with bonus successes.

        PROPERTIES {
            ^"School Name" STRING "Fortunist Monk Order" FIXED
            ^"Roles" LIST ["Monk"]
            ^"Ring Increase" DEF {
                ^"Earth" INTEGER 1
                ^"Water" INTEGER 1
            }
            ^"Starting Skills" DEF { CHOOSE 4 [^"Courtesy", ^"Culture", ^"Martial Arts [Unarmed]", ^"Meditation", ^"Survival", ^"Theology"] INTEGER 1 }
            ^"Starting Honor" INTEGER DEFAULT 40
            ^"Techniques Available" LIST ["Kata", "Rituals", "Shūji"]
        }


        STARTING_TECHNIQUES {
            KATA ^"Open-Hand Style"
            RITUAL ^"Cleansing Rite"
            RITUAL ^"Threshold Barrier"
            SHUJI CHOOSE 1 [^"Shallow Waters", ^"Stirring the Embers"]
        }

        SCHOOL_ABILITY "Blessing of the Fortunes" {
            "You have gained the goodwill of a Fortune who grants you invocations. When making a check to use an invocation learned this way, add additional bonus successes equal to your school rank. Select a Fortune as the primary object of your veneration and choose one appropriate invocation for which you meet the rank prerequisite. You learn that invocation without paying its XP cost. Each time your school rank increases, you gain one additional invocation this way."
        }

        MASTERY_ABILITY ^"Favor of the Fortunes" {
            "Once per scene, you may importune one invocation without making the sacrifices usually required and without the usual TN increase. Use the Meditation skill in place of the skill check normally required (you must still use the ring required for the invocation)."
        }
        STARTING_OUTFIT [
            "sanctified robes", "ceremonial clothes",
            "bo (staff)", "traveling pack", "scroll satchel"
        ]

        CURRICULUM {
            RANK 1 {
                SKILL_GROUP "Scholar Skills"
                SKILL "Courtesy"
                SKILL "Labor"
                SKILL "Meditation"
                TECHNIQUE_GROUP "Rank 1 Earth Shūji"
                ^"Crescent Moon Style" [kata]
                ^"Commune with the Spirits" [ritual]
            }
            RANK 2 {
                SKILL_GROUP "Social Skills"
                SKILL "Aesthetics"
                SKILL "Meditation"
                SKILL "Theology"
                TECHNIQUE_GROUP "Rank 1-2 Water Shūji"
                ^"All Arts Are One" [shuji]
                ^"Rushing Avalanche Style" [kata]
            }
            RANK 3 {
                SKILL_GROUP "Artisan Skills"
                SKILL "Martial Arts [Unarmed]"
                SKILL "Meditation"
                SKILL "Theology"
                TECHNIQUE_GROUP "Rank 1-3 Kata"
                ^"Regal Bearing" [shuji]
                ^"Ebb and Flow" [shuji]
            }
            RANK 4 {
                SKILL_GROUP "Social Skills"
                SKILL "Culture"
                SKILL "Fitness"
                SKILL "Theology"
                TECHNIQUE_GROUP "Rank 1-4 Air Shūji"
                ^"Buoyant Arrival" [shuji]
                ^"Pillar of Calm" [shuji]
            }
            RANK 5 {
                SKILL_GROUP "Scholar Skills"
                SKILL "Composition"
                SKILL "Meditation"
                SKILL "Performance"
                TECHNIQUE_GROUP "Rank 1-5 Earth Shūji"
                ^"Rouse the Soul" [shuji]
                ^"Soul Sunder" [kata]
            }
            RANK 6 {
                ^"Favor of the Fortunes"
            }
        }

    }

    ^"Shinseist Monk Order" DEF {
        EXTENDS #L5R252wX4yZ6aB8cD0eF2g ^"School"
        APPLIES TO [^"Samurai"]

        # Devotees of Shinsei's inward-looking philosophy, seeking
        # Enlightenment by understanding that all divisions between
        # elements are illusory. They overcome these illusory
        # limitations to create seemingly supernatural effects
        # through kihō techniques.

        PROPERTIES {
            ^"School Name" STRING "Shinseist Monk Order" FIXED
            ^"Roles" LIST ["Monk"]
            ^"Ring Increase" DEF {
                ^"Earth" INTEGER 1
                ^"Void" INTEGER 1
            }
            ^"Starting Skills" DEF { CHOOSE 4 [^"Aesthetics", ^"Composition", ^"Fitness", ^"Martial Arts [Unarmed]", ^"Meditation", ^"Theology"] INTEGER 1 }
            ^"Starting Honor" INTEGER DEFAULT 40
            ^"Techniques Available" LIST ["Kata", "Kihō", "Rituals"]
        }


        STARTING_TECHNIQUES {
            KATA ^"Striking as Earth"
            KIHO CHOOSE 2 [^"Cleansing Spirit", ^"Earth Needs No Eyes", ^"or Ki Protection"]
        }

        SCHOOL_ABILITY "Embrace the Void" {
            "When you spend a Void point to Seize the Moment, you may also treat your ranks in the skill you are using as being equal to your school rank. If your ranks in the skill are equal to or higher than your school rank, or if you have 5 ranks in the skill, you may add one kept (ring) set to an (op) result instead."
        }

        MASTERY_ABILITY ^"One with the Void" {
            "Once per scene, you may use one kihō technique you do not know. You may use the Meditation skill in place of the skill check normally required (you must still use the ring required for the kihō)."
        }
        STARTING_OUTFIT [
            "common clothes", "bo (staff) or nunchaku (linked staff)",
            "knife", "traveling pack"
        ]

        CURRICULUM {
            RANK 1 {
                SKILL_GROUP "Martial Skills"
                SKILL "Composition"
                SKILL "Survival"
                SKILL "Theology"
                TECHNIQUE_GROUP "Rank 1 Kata"
                ^"Riding the Clouds" [kiho]
                ^"Earthen Fist" [kiho]
            }
            RANK 2 {
                SKILL_GROUP "Scholar Skills"
                SKILL "Aesthetics"
                SKILL "Courtesy"
                SKILL "Meditation"
                TECHNIQUE_GROUP "Rank 1-2 Earth Kihō"
                TECHNIQUE_GROUP "Rank 1-2 Rituals"
                ^"All Arts Are One" [shuji]
            }
            RANK 3 {
                SKILL_GROUP "Martial Skills"
                SKILL "Command"
                SKILL "Games"
                SKILL "Theology"
                TECHNIQUE_GROUP "Rank 1-3 Kata"
                ^"Grasp the Earth Dragon" [kiho]
                ^"Way of the Willow" [kiho]
            }
            RANK 4 {
                SKILL_GROUP "Martial Skills"
                SKILL "Courtesy"
                SKILL "Survival"
                SKILL "Theology"
                TECHNIQUE_GROUP "Rank 1-4 Water Kihō"
                ^"Pillar of Calm" [shuji]
                ^"Way of the Falling Star" [kiho]
            }
            RANK 5 {
                SKILL_GROUP "[Choose one skill group] Skills"
                SKILL "Martial Arts [Unarmed]"
                SKILL "Meditation"
                SKILL "Theology"
                TECHNIQUE_GROUP "Rank 1-5 Void Kihō"
                ^"Rouse the Soul" [shuji]
                ^"The Immovable Hand of Peace" [shuji]
            }
            RANK 6 {
                ^"One with the Void"
            }
        }

    }

    ^"Kitsune Impersonator Tradition" DEF {
        EXTENDS #L5R252wX4yZ6aB8cD0eF2g ^"School"
        APPLIES TO [^"Samurai"]

        # Fox spirits from Chikushudo who have chosen to live as
        # humans in the mortal world. They may be full-blooded
        # kitsune or descendants of a kitsune-human union. They
        # can shapeshift between forms and possess innate magical
        # abilities. Not a formal samurai school.

        PROPERTIES {
            ^"School Name" STRING "Kitsune Impersonator" FIXED
            ^"Clan" STRING "Fox"
            ^"Roles" LIST ["Courtier", "Shugenja"]
            ^"Ring Increase" DEF {
                ^"Air" INTEGER 1
                ^"Fire" INTEGER 1
            }
            ^"Starting Skills" DEF { CHOOSE 3 [^"Courtesy", ^"Games", ^"Performance", ^"Martial Arts [Unarmed]", ^"Survival", ^"Theology"] INTEGER 1 }
            ^"Starting Honor" INTEGER DEFAULT 30
            ^"Techniques Available" LIST ["Invocations", "Rituals", "Shūji"]
            ^"Starting Disadvantage" STRING "False Identity"
        }


        STARTING_TECHNIQUES {
            INVOCATION ^"Nature's Touch"
            INVOCATION ^"Token of Memory"
            RITUAL ^"Commune with the Spirits"
        }

        SCHOOL_ABILITY "Fox Spirit" {
            "Your true form is that of a large fox with up to eight tails (full-blooded kitsune) or a human with vulpine traits (human ancestry). As a Scheme and Support action, transform between human and true forms, or into another silhouette 1 or 2 natural creature (GM discretion; cannot mimic specific individuals). Observers with vigilance lower than or equal to your school rank plus your ranks in Performance do not detect flaws. Certain features persist across all forms. If you become Compromised, your disguise slips, revealing true tails, ears, feet, or shadow. Must forfeit 1 honor to appear as a samurai of higher status."
        }

        MASTERY_ABILITY ^"Ninth Tail Ascension" {
            "Your true form now has nine tails. While in true form, supernatural resistance and physical resistance each increase by 2, and when you make a skill check, you may alter the result of one die containing (su) to a result containing (ex). While in true form, Attack action checks gain: (op)(op): After resolving, if target is Incapacitated or Unconscious, you devour or banish their body or soul, instantly killing them."
        }
        STARTING_OUTFIT ["Take the starting outfit of any one other school as appropriate to your false identity"]

        CURRICULUM {
            RANK 1 {
                SKILL_GROUP "Martial Skills"
                SKILL "Performance"
                SKILL "Survival"
                SKILL "Theology"
                TECHNIQUE_GROUP "Rank 1 Air Invocations"
                ^"Fanning the Flames" [shuji]
                ^"All in Jest" [shuji]
            }
            RANK 2 {
                SKILL_GROUP "Social Skills"
                SKILL "Skulduggery"
                SKILL "Survival"
                SKILL "Theology"
                TECHNIQUE_GROUP "Rank 1-2 Air Shūji"
                ^"Dazzling Performance" [invocation]
                ^"False Realm of the Fox Spirits" [invocation]
            }
            RANK 3 {
                SKILL_GROUP "Artisan Skills"
                SKILL "Culture"
                SKILL "Meditation"
                SKILL "Theology"
                TECHNIQUE_GROUP "Rank 1-3 Air Invocations"
                ^"Crashing Wave Style" [kata]
                ^"Regal Bearing" [shuji]
            }
            RANK 4 {
                SKILL_GROUP "Social Skills"
                SKILL "Meditation"
                SKILL "Sentiment"
                SKILL "Skulduggery"
                TECHNIQUE_GROUP "Rank 1-4 Air Shūji"
                ^"Disappearing World Style" [kata]
                ^"Bravado" [shuji]
            }
            RANK 5 {
                SKILL_GROUP "Scholar Skills"
                SKILL "Martial Arts [Unarmed]"
                SKILL "Meditation"
                SKILL "Survival"
                TECHNIQUE_GROUP "Rank 1-5 Air Invocations"
                ^"Soul Sunder" [kata]
                ^"Buoyant Arrival" [shuji]
            }
            RANK 6 {
                ^"Ninth Tail Ascension"
            }
        }

    }

    ^"Kolat Saboteur Conspiracy" DEF {
        EXTENDS #L5R252wX4yZ6aB8cD0eF2g ^"School"
        APPLIES TO [^"Samurai"]

        # Secret agents of the Kolat conspiracy devoted to ending
        # Rokugani reverence for the Celestial Heavens and establishing
        # humanity as its own ruler. They operate as assassins for hire,
        # with earnings funding the conspiracy. Not a formal school.

        PROPERTIES {
            ^"School Name" STRING "Kolat Saboteur" FIXED
            ^"Roles" LIST ["Shinobi"]
            ^"Ring Increase" DEF {
                ^"Air" INTEGER 1
                ^"Water" INTEGER 1
            }
            ^"Starting Skills" DEF { CHOOSE 5 [^"Commerce", ^"Fitness", ^"Martial Arts [Melee]", ^"Martial Arts [Ranged]", ^"Medicine", ^"Meditation", ^"Skulduggery"] INTEGER 1 }
            ^"Starting Honor" INTEGER DEFAULT 20
            ^"Starting Disadvantage" STRING "False Identity"
            ^"Techniques Available" LIST ["Kata", "Shūji"]
        }


        STARTING_TECHNIQUES {
            KATA ^"Veiled Menace Style"
            NINJUTSU ^"Skulk"
            SHUJI ^"Cadence"
        }

        SCHOOL_ABILITY "Professional Saboteur" {
            "Once per game session at the beginning of a scene, reveal that an NPC in that scene is the target of your current assignment. The GM decides what the assignment entails (sabotage, framing, killing, or ensuring survival). Until the end of the session, when you make a skill check targeting the chosen NPC, you may reroll a number of dice up to your school rank."
        }

        MASTERY_ABILITY ^"Usher In the New Age" {
            "As a downtime activity, overcome or bypass an NPC's guards or security measures. Make a Skulduggery (Air) check targeting the NPC, TN equal to their highest conflict rank. If you succeed and the NPC is a minion or non-essential adversary (GM discretion), you accomplish your goal. If the NPC is important, you confront them alone, likely beginning a conflict scene. (op)(op): Your efforts go completely unnoticed. (op)(op): If you kill the target, death appears accidental or natural."
        }
        STARTING_OUTFIT [
            "ceremonial clothes", "common clothes", "traveling clothes",
            "daishō (katana and wakizashi)", "knife", "five shuriken",
            "one vial of poison", "traveling pack"
        ]

        CURRICULUM {
            RANK 1 {
                SKILL_GROUP "Martial Skills"
                SKILL "Courtesy"
                SKILL "Performance"
                SKILL "Skulduggery"
                TECHNIQUE_GROUP "Rank 1 Kata"
                ^"Deadly Sting" [ninjutsu]
                ^"Shallow Waters" [shuji]
            }
            RANK 2 {
                SKILL_GROUP "Martial Skills"
                SKILL "Commerce"
                SKILL "Medicine"
                SKILL "Skulduggery"
                TECHNIQUE_GROUP "Rank 1-2 Kata"
                ^"Noxious Cloud" [ninjutsu]
                ^"Tributaries of Trade" [shuji]
            }
            RANK 3 {
                SKILL_GROUP "Scholar Skills"
                SKILL "Composition"
                SKILL "Smithing"
                SKILL "Survival"
                TECHNIQUE_GROUP "Rank 1-3 Kata"
                ^"Ebb and Flow" [shuji]
                ^"Spin the Web" [shuji]
            }
            RANK 4 {
                SKILL_GROUP "Martial Skills"
                SKILL "Commerce"
                SKILL "Skulduggery"
                SKILL "Survival"
                TECHNIQUE_GROUP "Rank 1-4 Kata"
                ^"Silencing Stroke" [ninjutsu]
                ^"Wolf's Proposal" [shuji]
            }
            RANK 5 {
                SKILL_GROUP "Martial Skills"
                SKILL "Command"
                SKILL "Commerce"
                SKILL "Skulduggery"
                TECHNIQUE_GROUP "Rank 1-5 Kata"
                TECHNIQUE_GROUP "Rank 1-5 Ninjutsu"
                ^"Buoyant Arrival" [shuji]
            }
            RANK 6 {
                ^"Usher In the New Age"
            }
        }

    }

