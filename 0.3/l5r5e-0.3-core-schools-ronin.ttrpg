BASE "L5R5e_Core_Schools_Ronin" {
    NAME "Legend of the Five Rings 5th Edition - Rōnin Schools"
    VERSION "0.3"
    RELEASE_DATE "2026-03-01"

    # Core Rulebook: Rōnin Schools (page 87)
    # Individuals may come to walk the rōnin's path for many reasons. These
    # 'wave men' adrift upon the sea of fate may be former clan samurai fallen
    # from grace, or children born under contentious circumstances.

    # ===========================
    # WORLDLY RŌNIN PATH [Bushi, Courtier]
    # ===========================

    ^"Worldly Rōnin Path" DEF {
        EXTENDS ^"School"
        APPLIES TO [^"Samurai"]

        # Individuals may come to walk the rōnin's path for many reasons. These
        # "wave men" adrift upon the sea of fate may be former clan samurai fallen
        # from grace, unlucky samurai whose master was killed or demoted, or even
        # children born to samurai parents out of wedlock or under other contentious
        # circumstances. Many do not have a formal sensei anymore — if they ever
        # did — and so the world itself is their teacher. As they must adapt to
        # survive, many rōnin rely on a particular skill to make their way in the
        # world, whether that be as mercenaries, as traveling merchants or
        # performers, or as guides or guardians for specific roads, rivers, or
        # mountain passes.

        PROPERTIES {
            ^"School Name" STRING "Worldly Rōnin Path" FIXED
            ^"Clan" STRING "Rōnin"
            ^"Roles" LIST ["Bushi", "Courtier"]
            ^"Ring Increase" STRING "+1 any two different rings"
            ^"Starting Skills" STRING "choose 5: +1 Command, +1 Fitness, +1 Labor, +1 Martial Arts [Melee], +1 Martial Arts [Ranged], +1 Martial Arts [Unarmed], +1 Skulduggery"
            ^"Starting Honor" INTEGER DEFAULT 30
            ^"Techniques Available" LIST ["Kata", "Rituals", "Shūji"]
        }

        STARTING_TECHNIQUES {
            KATA CHOOSE 1 [^"Pelting Hail Style", ^"Crescent Moon Style"]
            SHUJI CHOOSE 1 [^"All in Jest", ^"Honest Assessment", ^"Stirring the Embers", ^"Rustling of Leaves"]
        }

        SCHOOL_ABILITY "School of Waves" {
            "Choose one bonus curriculum skill; this skill henceforth counts as part of the Worldly Rōnin Path curriculum for you at all ranks. Each time your school rank increases, choose one additional bonus curriculum skill this way."
            "When you make a check using one of your bonus curriculum skills, you may negate 1 (st) symbol."
        }

        MASTERY_ABILITY ^"A Bottomless Ocean" {
            "You can increase your bonus curriculum skills to rank 6 (paying 12 XP per skill raised from rank 5 to rank 6 this way)."
        }

        STARTING_OUTFIT [
            "Traveling clothes",
            "any one weapon of rarity 6 or lower",
            "katana (long sword) or yumi (bow)",
            "wakizashi (short sword)",
            "any two items of rarity 4 or lower"
        ]

        CURRICULUM {
            RANK 1 {
                SKILL_GROUP "Trade Skills"
                SKILL "Fitness"
                SKILL "Martial Arts [Choose One]"
                SKILL "Performance"
                TECHNIQUE_GROUP "Rank 1 Kata"
                ^"Open-Hand Style" [kata]
                ^"Shallow Waters" [shuji]
            }
            RANK 2 {
                SKILL_GROUP "Martial Skills"
                SKILL "Command"
                SKILL "Labor"
                SKILL "Medicine"
                TECHNIQUE_GROUP "Rank 1-2 Shūji"
                ^"All Arts are One" [shuji]
                ^"Iron Forest Style" [kata]
            }
            RANK 3 {
                SKILL_GROUP "Social Skills"
                SKILL "Martial Arts [Choose One]"
                SKILL "Sentiment"
                SKILL "Skulduggery"
                TECHNIQUE_GROUP "Rank 1-3 Kata"
                ^"A Samurai's Fate" [shuji]
                ^"Dazzling Performance" [shuji]
            }
            RANK 4 {
                SKILL_GROUP "Artisan Skills"
                SKILL "Labor"
                SKILL "Martial Arts [Choose One]"
                SKILL "Survival"
                TECHNIQUE_GROUP "Rank 1-4 Shūji"
                ^"Striking as Void" [kata]
                ^"Crimson Leaves Strike" [kata]
            }
            RANK 5 {
                SKILL_GROUP "Scholar Skills"
                SKILL "Composition"
                SKILL "Martial Arts [Choose One]"
                SKILL "Meditation"
                TECHNIQUE_GROUP "Rank 1-5 Kata"
                ^"Buoyant Arrival" [shuji]
                ^"Sear the Wound" [shuji]
            }
            RANK 6 {
                ^"A Bottomless Ocean"
            }
        }
    }
}
