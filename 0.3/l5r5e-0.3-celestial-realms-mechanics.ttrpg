    # --- Inversions ---
    # Inversions are a new technique type unique to Void wielders.
    # They use blank die results (magnitude) to trigger additional
    # effects. Cosmic strain: 1 fatigue per kept strife result.
    # Default XP cost: 6 XP instead of usual 3 XP.

    ^"One within the Void" DEF {
        APPLIES TO [^"Technique"]
        PROPERTIES {
            ^"Technique Type" STRING "Inversion" FIXED
            ^"Rank" INTEGER DEFAULT 1
            ^"Activation" STRING "Support action, TN 2 Sentiment (Void), target yourself and one other character at range 0-3"
            ^"Effect" STRING "Augment targets with wordless communication; any target may receive 2 fatigue to assist another regardless of distance; persists until end of scene"
            ^"Magnitude" STRING "1+: strife can be redirected to another target; 3+: choose ring or skill, any target may use another target's rank"
        }
    }

    ^"Sight beyond Existence" DEF {
        APPLIES TO [^"Technique"]
        PROPERTIES {
            ^"Technique Type" STRING "Inversion" FIXED
            ^"Rank" INTEGER DEFAULT 1
            ^"Activation" STRING "Once per session, immediately after an action of great consequence, TN 2 Theology (Void), target that character at range 0-3"
            ^"Effect" STRING "Scry for another outcome; return to the moment before the action; all effects undone; only you and target are aware. If you are the target, choose same or different action. If another character is the target, say up to five words before they act"
            ^"Magnitude" STRING "1+: see one consequence before end of scene; 2+: see consequence in next year; 3+: see consequence in decades"
        }
    }

    ^"Whispered Blade" DEF {
        APPLIES TO [^"Technique"]
        PROPERTIES {
            ^"Technique Type" STRING "Inversion" FIXED
            ^"Rank" INTEGER DEFAULT 1
            ^"Activation" STRING "Support action, TN 2 Theology (Void)"
            ^"Effect" STRING "Summon a rift in reality usable as a knife that ignores all resistances; persists until end of scene"
            ^"Magnitude" STRING "1+: after Attack, rift echoes summoned at range 0 of target for magnitude rounds; in skirmish when they end, each character (not you) at range 0-1 suffers critical strike equal to deadliness times number of echoes; in other conflicts, targets treat all terrain as Dangerous while echoes persist"
        }
    }

    ^"Witness the End" DEF {
        APPLIES TO [^"Technique"]
        PROPERTIES {
            ^"Technique Type" STRING "Inversion" FIXED
            ^"Rank" INTEGER DEFAULT 1
            ^"Activation" STRING "Scheme and Support action, Theology (Void), TN = target's vigilance (or 2 for objects), target one character or object at range 0-1"
            ^"Effect" STRING "Scry for the ways target can be undone; TN of next check to damage/sabotage/attack it becomes 1 (cannot be increased); persists until end of next turn"
            ^"Magnitude" STRING "1-3: persists additional rounds equal to magnitude; 2+: can also target metaphysical objects; 4+: persists until end of scene"
        }
    }

    ^"Distance Distorted" DEF {
        APPLIES TO [^"Technique"]
        PROPERTIES {
            ^"Technique Type" STRING "Inversion" FIXED
            ^"Rank" INTEGER DEFAULT 2
            ^"Activation" STRING "Scheme and Support action, TN 3 Theology (Void), target two objects/characters at range 0-3"
            ^"Effect" STRING "Augment and curse targets; choose range 0, 1, 2, or 3; targets always treat each other as that distance; each character target receives 2 fatigue; persists until end of next turn"
            ^"Magnitude" STRING "1-2: persists additional rounds; 3+: persists until end of scene"
        }
    }

    ^"Ethereal Flicker" DEF {
        APPLIES TO [^"Technique"]
        PROPERTIES {
            ^"Technique Type" STRING "Inversion" FIXED
            ^"Rank" INTEGER DEFAULT 2
            ^"Activation" STRING "Scheme and Support action, TN 3 Theology (Void), target yourself"
            ^"Effect" STRING "Augment and curse self to be out of phase; use Theology instead of Fitness to reduce critical strike severity; if reduced to 0, do not suffer it; persists until start of next turn"
            ^"Magnitude" STRING "1-2: persists additional rounds; 2+: redirect critical strike (severity before reductions) to character at range 0-1 with vigilance <= magnitude; 3+: persists until end of scene"
        }
    }

    ^"The Lotus Blooms" DEF {
        APPLIES TO [^"Technique"]
        PROPERTIES {
            ^"Technique Type" STRING "Inversion" FIXED
            ^"Rank" INTEGER DEFAULT 2
            ^"Activation" STRING "Scheme and Support action, TN 3 Theology (Void), target one character at range 0-1"
            ^"Effect" STRING "Augment and curse target; they keep dice up to Void Ring instead of ring used (must keep as many as possible); no strife from kept strife results, but receive 1 fatigue per strife instead; if Incapacitated this way, also gain Exhausted; persists until end of target's next turn"
            ^"Magnitude" STRING "1-2: persists additional rounds; 3+: persists until end of scene"
        }
    }

    ^"Hurl from the Stream" DEF {
        APPLIES TO [^"Technique"]
        PROPERTIES {
            ^"Technique Type" STRING "Inversion" FIXED
            ^"Rank" INTEGER DEFAULT 3
            ^"Activation" STRING "Once per scene, Scheme action, Theology (Void), TN = target's vigilance + silhouette (silhouette only for objects), target one character or object at range 0-3"
            ^"Effect" STRING "Bind target outside reality; unaffected by everything and affects nothing; returns after 1 round"
            ^"Magnitude" STRING "1-3: removed for additional rounds; 4+: Adversary/PC removed until end of scene; Minion/mundane object ceases to exist permanently"
        }
    }

    ^"Moon on the Shifting Sea" DEF {
        APPLIES TO [^"Technique"]
        PROPERTIES {
            ^"Technique Type" STRING "Inversion" FIXED
            ^"Rank" INTEGER DEFAULT 3
            ^"Activation" STRING "Once per scene, Scheme and Support action, TN 3 Theology (Void), target position at range 0-2"
            ^"Effect" STRING "Simultaneously exist at current position and target position (must be reachable by normal movement); can receive 2 fatigue to choose additional targets or target same target multiple times from multiple positions; persists for rounds equal to Meditation ranks; when effect ends, choose one position and cease to occupy all others"
            ^"Magnitude" STRING "1-2: persists additional rounds; 1+: one additional position per magnitude; 3+: persists until end of scene (1 fatigue per position per round)"
        }
    }

    ^"Shroud in Solitude" DEF {
        APPLIES TO [^"Technique"]
        PROPERTIES {
            ^"Technique Type" STRING "Inversion" FIXED
            ^"Rank" INTEGER DEFAULT 3
            ^"Activation" STRING "Support action, TN 3 Theology (Void), target one character at range 0"
            ^"Effect" STRING "Augment and curse target; use Void Ring to reduce damage instead of normal resistance; fatigue becomes strife instead; persists until end of next turn"
            ^"Magnitude" STRING "1-2: persists additional rounds; 3+: persists until end of scene; if target becomes Compromised, must resist with TN 5 Meditation (Void 3) or body is pulled into Void permanently"
        }
    }

    ^"Reality Stitch" DEF {
        APPLIES TO [^"Technique"]
        PROPERTIES {
            ^"Technique Type" STRING "Inversion" FIXED
            ^"Rank" INTEGER DEFAULT 4
            ^"Activation" STRING "Scheme action, Theology (Void), TN = highest vigilance among targets, target up to Meditation ranks characters at range 0-2"
            ^"Effect" STRING "Curse targets; whenever one receives strife or fatigue, all targets receive same amount; persists until end of scene"
            ^"Magnitude" STRING "1+: conditions shared; 2+: critical strikes shared; 3+: persistent effects shared and removed together"
        }
    }

    ^"Shattering Caress" DEF {
        APPLIES TO [^"Technique"]
        PROPERTIES {
            ^"Technique Type" STRING "Inversion" FIXED
            ^"Rank" INTEGER DEFAULT 4
            ^"Activation" STRING "Attack action with readied melee weapon, TN 3 Martial Arts [Melee or Unarmed] (Void), target one character or mundane object in range"
            ^"Effect" STRING "Mundane object gains Destroyed quality. Character takes supernatural damage equal to weapon's base damage; if Incapacitated, suffer Dying [3 rounds]"
            ^"Magnitude" STRING "1-2: reduce Dying duration by magnitude; 3+: target killed outright instead of Dying"
        }
    }

    ^"Three Heartbeats" DEF {
        APPLIES TO [^"Technique"]
        PROPERTIES {
            ^"Technique Type" STRING "Inversion" FIXED
            ^"Rank" INTEGER DEFAULT 4
            ^"Activation" STRING "Support action, TN 4 Theology (Void), target yourself"
            ^"Effect" STRING "Receive 3 fatigue, then take an additional turn immediately; others count as unaware of you and cannot react, but still make checks to resist effects and defend against damage"
            ^"Magnitude" STRING "1+: take additional turns equal to magnitude; each additional turn beyond the first costs 3 more fatigue; if Incapacitated, suffer Dying [3 rounds] and Exhausted"
        }
    }

    ^"Essence Eternal" DEF {
        APPLIES TO [^"Technique"]
        PROPERTIES {
            ^"Technique Type" STRING "Inversion" FIXED
            ^"Rank" INTEGER DEFAULT 5
            ^"Activation" STRING "Support action, TN 4 Theology (Void), target one character or object at range 0-2"
            ^"Effect" STRING "Bind target to current state and location (note fatigue, strife, conditions, persistent effects, critical strikes suffered, position); when effect ends, target returns to noted state even if no longer existing; target remembers everything; persists until end of next turn"
            ^"Magnitude" STRING "1-3: persists additional rounds; 4+: target returns to noted state at end of each of your turns for rest of scene"
        }
    }

    ^"Slip the Cycle" DEF {
        APPLIES TO [^"Technique"]
        PROPERTIES {
            ^"Technique Type" STRING "Inversion" FIXED
            ^"Rank" INTEGER DEFAULT 5
            ^"Activation" STRING "Once per session, Movement and Support action, TN 3 Theology (Void); can be made even if restrained, Incapacitated, Unconscious, dead, or nonexistent"
            ^"Effect" STRING "Purify self; remove all conditions and persistent effects; fatigue and strife become 0; move to position at range 0-2 ignoring obstacles; if dead or nonexistent, return for 1 round"
            ^"Magnitude" STRING "1: return until end of scene; 2-3: return until end of session; 4+: return permanently (permanently increase TN by 1)"
        }
    }

    ^"Unweave" DEF {
        APPLIES TO [^"Technique"]
        PROPERTIES {
            ^"Technique Type" STRING "Inversion" FIXED
            ^"Rank" INTEGER DEFAULT 5
            ^"Activation" STRING "Attack and Scheme action, TN 4 Theology (Void), target one character or object silhouette 0-3 at range 0-2"
            ^"Effect" STRING "Mundane object or Minion NPC ceases to exist (receive fatigue = silhouette + conflict rank). Mystical object gains Damaged/Destroyed. Adversary/PC suffers supernatural damage equal to Theology ranks ignoring all resistances"
            ^"Magnitude" STRING "1+: additional damage equal to magnitude; 2+: terrain within magnitude range bands loses all qualities; 2+: if target gets critical/Destroyed, ceases to exist; 3+: all characters with vigilance <= magnitude become targets"
        }
    }

    # ===========================
    # INVERSION MECHANICS
    # ===========================

    ^"Inversion System Rules" DEF {
        APPLIES TO [^"Mechanic"]

        # Magnitude: Equal to the number of kept blank results.
        # Resolved during Step 6 of a check, after resolving
        # success symbols. Effects trigger at exact value or
        # within listed range. Not optional; multiple apply.
        #
        # Cosmic Strain: Character receives 1 fatigue per kept
        # strife result. Support actions targeting others also
        # inflict 1 fatigue per kept strife on the target.
        # Magnitude 3+: if 1+ strife kept, area around wielder
        # extending kept-strife range bands becomes Dangerous
        # and Imbalanced (Void) terrain permanently with
        # inexplicable phenomena.
        #
        # Channeling: Same as invocations (core rulebook p189).
        # XP Cost: 6 XP per inversion (instead of usual 3 XP).
        # New Keywords: Curse (lasting negative effect),
        # Bind (ties characters/things/places together).

        RULES {
            #L5RCR30gH1iJ3kL5mN7oP9q: inversions_magnitude_equals_kept_blank_results
            #L5RCR31rS2tU4vW6xY8zA0b: inversions_cosmic_strain_fatigue_per_kept_strife
            #L5RCR32cD3eF5gH7iJ9kL1m: inversions_magnitude_3_plus_dangerous_imbalanced_void_terrain
            #L5RCR33nO4pQ6rS8tU0vW2x: inversions_xp_cost_6_instead_of_3
        }
    }

    # ===========================
    # POTION RULES
    # ===========================

    ^"Potion (Prepared Invocations)" DEF {
        APPLIES TO [^"Mechanic"]

        # Potions are a form of prepared invocation with
        # modifications: Preparation Skill: Medicine.
        # Ingredients: blessed glass container + supplies worth
        # bu equal to invocation's rank.
        # Activation: drink as action (affects imbiber) or throw
        # at target as action with Martial Arts [Ranged] check
        # TN = number of range bands (min 1).

        RULES {
            #L5RCR34yZ5aB7cD9eF1gH3i: potions_preparation_skill_medicine
            #L5RCR35jK6lM8nO0pQ2rS4t: potions_can_be_drunk_or_thrown
        }
    }

    # ===========================
    # ATTUNING TO ANCESTRAL BLADES
    # ===========================

    ^"Ancestral Blade Attunement" DEF {
        APPLIES TO [^"Mechanic"]

        # First time readying an ancestral blade, make a TN 3
        # Meditation (Void) check using Artisan approach (Attune).
        # Success: aligned, can use sealed inversions and properties.
        # Failure: not aligned, increase TN of all checks with weapon
        # by 2, cannot use sealed inversions or properties.
        # May retry as a downtime activity using Meditation or
        # another skill at GM discretion. Deeds contrary to the
        # blade's character may cause loss of alignment.

        RULES {
            #L5RCR36uV7wX9yZ1aB3cD5e: ancestral_blade_tn3_meditation_void_to_attune
            #L5RCR37fG8hI0jK2lM4nO6p: ancestral_blade_failure_increases_tn_by_2
        }
    }
}
