EXTENSION "L5R5e_Celestial_Realms" EXTENDS "L5R5e_Core_Character" {
    NAME "Legend of the Five Rings 5th Edition - Celestial Realms: New Player Options"
    VERSION "0.3"
    RELEASE_DATE "2026-03-01"

    # Celestial Realms (Chapter 2): Centipede Minor Clan, Moshi family,
    # new schools, advantages, disadvantages, heritages, weapons, arrows,
    # spiritual artifacts, omamori, ancestral swords, item pattern,
    # invocations, rituals, inversions (new technique type), titles.

    # ===========================
    # CENTIPEDE MINOR CLAN
    # ===========================

    ^"Centipede Minor Clan" DEF {
        EXTENDS #L5R250aB2cD4eF6gH8iJ0k ^"Clan"
        APPLIES TO [^"Samurai"]

        # Founded by Isawa Moshi, one of the Eleven Daughters
        # of the Centipede, the Centipede Clan is devoted to the
        # worship and protection of Amaterasu, the Sun Goddess.
        # They maintain the greatest shrine to Lady Sun and greet
        # her each morning with song so she may awaken and rise.

        PROPERTIES {
            ^"Clan Name" STRING "Centipede" FIXED
            ^"Clan Type" STRING "Minor Clan"
            ^"Clan Ring Bonus" STRING "+1 Fire"
            ^"Clan Skill Bonus" STRING "+1 Theology"
            ^"Clan Status" INTEGER DEFAULT 30
        }

        FAMILIES {
            ^"Moshi"
        }

        RULES {
            #L5RCR01aB2cD4eF6gH8iJ0: centipede_devoted_to_amaterasu
            #L5RCR02kL3mN5oP7qR9sT1u: centipede_maintain_shrine_to_lady_sun
        }
    }


    # ===========================
    # CENTIPEDE FAMILIES
    # ===========================

    #L5RCR50aB2cD4eF6gH8iJ0k ^"Moshi" DEF {
        EXTENDS #L5R251lM3nO5pQ7rS9tU1v ^"Family"
        APPLIES TO [^"Samurai"]

        PROPERTIES {
            ^"Family Name"     STRING "Moshi" FIXED
            ^"Clan"            STRING "Centipede"
            ^"Ring Increase"   STRING "+1 Air or Fire"
            ^"Skill Increases" STRING "+1 Fitness, +1 Meditation"
            ^"Glory"           INTEGER 40
            ^"Starting Wealth" STRING "3 koku"
        }
    }


    # ===========================
    # NEW SCHOOLS
    # ===========================

    ^"Agasha Alchemist School" DEF {
        EXTENDS #L5R252wX4yZ6aB8cD0eF2g ^"School"
        APPLIES TO [^"Samurai"]

        # Agasha-led researchers who condense and blend prayers
        # and effects of elemental kami invocations. They believe
        # calling upon spirits is as much science as art, and with
        # careful preparation they can coax kami into weaving
        # powers together to create expanded effects via potions.

        PROPERTIES {
            ^"School Name" STRING "Agasha Alchemist" FIXED
            ^"Roles" LIST ["Shugenja"]
            ^"Ring Increase" STRING "+1 Fire, +1 Water"
            ^"Starting Skills" STRING "Choose three: +1 Martial Arts [Ranged], +1 Medicine, +1 Meditation, +1 Performance, +1 Survival, +1 Theology"
            ^"Starting Honor" INTEGER DEFAULT 40
            ^"Techniques Available" LIST ["Invocations (invocation)", "Rituals (ritual)", "Shuji (shuji)"]
            ^"Starting Techniques" STRING "Invocations (choose three): Amaterasu's Gaze, Fukurokujin's Wit, Path to Inner Peace, The Cleansing Fire, The Fires from Within; Shuji (choose two): Shallow Waters, Stirring the Embers, Truth Burns through Lies"
            ^"School Ability" STRING "Flesh of the Elements"
            ^"Mastery Ability" STRING "Experimental Concoction"
        }

        ^"Flesh of the Elements" DEF {
            # You can have a number of additional potions with
            # prepared invocations equal to your school rank. When
            # you spend a downtime activity creating a potion, you
            # may make supplemental checks after the first equal to
            # your school rank, but each must be for a different
            # invocation.
        }

        STARTING_OUTFIT [
            "traveling clothes", "one weapon of rarity 7 or lower",
            "blowgun and pouch of darts", "wakizashi (short sword)",
            "medicine kit", "one omamori (your choice)",
            "a pouch of 5 blessed glass vials",
            "small satchel of ingredients worth 10 bu"
        ]

        CURRICULUM {
            RANK 1 {
                SKILL_GROUP "Scholar Skills"
                SKILL "Martial Arts [Ranged]"
                SKILL "Performance"
                SKILL "Smithing"
                TECHNIQUE_GROUP "Rank 1 Fire & Water Invocations"
                ^"Hawk's Precision" [kata]
                ^"Fires of Purity" [invocation]
            }
            RANK 2 {
                SKILL_GROUP "Scholar Skills"
                SKILL "Martial Arts [Ranged]"
                SKILL "Performance"
                SKILL "Survival"
                TECHNIQUE_GROUP "Rank 1-2 Earth & Air Invocations"
                ^"Dazzling Performance" [shuji]
                ^"Pelting Hail Style" [kata]
            }
            RANK 3 {
                SKILL_GROUP "Social Skills"
                SKILL "Commerce"
                SKILL "Medicine"
                SKILL "Sentiment"
                TECHNIQUE_GROUP "Rank 1-3 Shuji"
                ^"Bravado" [shuji]
                ^"Path of Beasts" [invocation]
            }
            RANK 4 {
                SKILL_GROUP "Scholar Skills"
                SKILL "Martial Arts [Ranged]"
                SKILL "Performance"
                SKILL "Smithing"
                TECHNIQUE_GROUP "Rank 1-4 Invocations"
                ^"Rank 1-4 Ranged Combat Kata" [kata]
                ^"Rain of Ten Thousand Lotuses" [invocation]
            }
            RANK 5 {
                SKILL_GROUP "Social Skills"
                SKILL "Commerce"
                SKILL "Martial Arts [Ranged]"
                SKILL "Survival"
                TECHNIQUE_GROUP "Rank 1-5 Invocations"
                ^"Heart of the Lady Sun" [invocation]
                ^"Sear the Wound" [shuji]
            }
            RANK 6 {
                "Experimental Concoction (Mastery Ability, Action): Once per game session as a Support action, you may make a TN 4 Medicine (Water) check to combine two of your potions that share at least one invocation effect keyword (mend, purify, smite, etc.) If you succeed, the two potions become a single concoction with both properties; when this concoction is used, resolve the effects of both prepared invocations. A concoction cannot be combined with another potion or concoction."
            }
        }

        RULES {
            #L5RCR05rS6tU8vW0xY2zA4b: alchemist_potion_science
            #L5RCR06cD7eF9gH1iJ3kL5m: alchemist_additional_potions_equal_school_rank
        }
    }

    ^"Asahina Envoy School" DEF {
        EXTENDS #L5R252wX4yZ6aB8cD0eF2g ^"School"
        APPLIES TO [^"Samurai"]

        # Honest arbiters of harmony, the Asahina train a select
        # few as specialized priests. These envoys travel to other
        # clans to offer aid and foster positive relations. They
        # officiate weddings, conduct funerals, and bless newborns.

        PROPERTIES {
            ^"School Name" STRING "Asahina Envoy" FIXED
            ^"Roles" LIST ["Courtier"]
            ^"Ring Increase" STRING "+1 Air, +1 Void"
            ^"Starting Skills" STRING "Choose five: +1 Aesthetics, +1 Courtesy, +1 Culture, +1 Meditation, +1 Performance, +1 Sentiment, +1 Theology"
            ^"Starting Honor" INTEGER DEFAULT 50
            ^"Techniques Available" LIST ["Kata (kata)", "Rituals (ritual)", "Shuji (shuji)"]
            ^"Starting Techniques" STRING "Rituals: = Tea Ceremony; Shuji (choose one): Cadence, Shallow Waters, Weight of Duty"
            ^"School Ability" STRING "Soul of Ceremony"
            ^"Mastery Ability" STRING "Favored Counselor"
        }

        ^"Soul of Ceremony" DEF {
            # When you make a check to perform a ritual, you may
            # add kept ring dice set to opportunity results equal to
            # your school rank. You may spend these opportunity as
            # if the ritual were also a Social skill check of your choice.
        }

        STARTING_OUTFIT [
            "traveling clothes", "ceremonial clothes",
            "sanctified robes", "wakizashi (short sword)",
            "knife or bo (staff)", "scroll satchel",
            "calligraphy set", "tea set",
            "traveling pack", "attendant", "Rokugani pony"
        ]

        CURRICULUM {
            RANK 1 {
                SKILL_GROUP "Social Skills"
                SKILL "Aesthetics"
                SKILL "Culture"
                SKILL "Government"
                TECHNIQUE_GROUP "Rank 1 Air Shuji"
                ^"Lady Doji's Decree" [shuji]
                ^"Divination" [ritual]
            }
            RANK 2 {
                SKILL_GROUP "Scholar Skills"
                SKILL "Command"
                SKILL "Design"
                SKILL "Performance"
                TECHNIQUE_GROUP "Rank 1-2 Fire Shuji"
                ^"Dazzling Performance" [shuji]
                ^"Blessing of the Dance" [ritual]
            }
            RANK 3 {
                SKILL_GROUP "Social Skills"
                SKILL "Commerce"
                SKILL "Culture"
                SKILL "Theology"
                TECHNIQUE_GROUP "Rank 1-3 Air Shuji"
                ^"Blessed Union" [ritual]
                ^"Prayer of Protection" [ritual]
            }
            RANK 4 {
                SKILL_GROUP "Artisan Skills"
                SKILL "Courtesy"
                SKILL "Performance"
                SKILL "Sentiment"
                TECHNIQUE_GROUP "Rank 1-4 Water Shuji"
                TECHNIQUE_GROUP "Rank 1-5 Rituals"
                ^"Buoyant Arrival" [shuji]
            }
            RANK 5 {
                SKILL_GROUP "Social Skills"
                SKILL "Aesthetics"
                SKILL "Culture"
                SKILL "Design"
                TECHNIQUE_GROUP "Rank 1-5 Void Shuji"
                ^"Bend with the Storm" [shuji]
                ^"The Immovable Hand of Peace" [shuji]
            }
            RANK 6 {
                "Favored Counselor (Mastery Ability): When making a check to perform a ritual, you may spend opportunity as follows: (op)+: One participant in the ritual with vigilance lower than or equal to opportunity spent this way feels especially indebted to you. You gain the Ally [that character] advantage."
            }
        }

        RULES {
            #L5RCR07nO8pQ0rS2tU4vW6x: envoy_honest_arbiter_of_harmony
            #L5RCR08yZ9aB1cD3eF5gH7i: envoy_soul_of_ceremony_ritual_social
        }
    }

    ^"Ishiken Initiate School" DEF {
        EXTENDS #L5R252wX4yZ6aB8cD0eF2g ^"School"
        APPLIES TO [^"Samurai"]

        # Vanishingly rare individuals who can call upon the Void.
        # Trained at the Starry Heaven Sanctuary by the Phoenix Clan.
        # They use inversions, a new technique type that manipulates
        # blank die results via magnitude effects, at cost of cosmic strain.

        PROPERTIES {
            ^"School Name" STRING "Ishiken Initiate" FIXED
            ^"Roles" LIST ["Sage", "Shugenja"]
            ^"Ring Increase" STRING "+1 Void, +1 any other ring"
            ^"Starting Skills" STRING "Choose three: +1 Fitness, +1 Medicine, +1 Meditation, +1 Sentiment, +1 Survival, +1 Theology"
            ^"Starting Honor" INTEGER DEFAULT 40
            ^"Techniques Available" LIST ["Inversions (inversion)", "Rituals (ritual)", "Shuji (shuji)"]
            ^"Starting Techniques" STRING "Inversions (choose one): One within the Void, Sight beyond Existence, Whispered Blade, Witness the End; Rituals (choose one): Commune with the Spirits, Divination, Threshold Barrier; Shuji (choose one): All in Jest, Ancestry Unearthed, Cadence, Truth Burns through Lies"
            ^"School Ability" STRING "Way of the Void"
            ^"Mastery Ability" STRING "Essence of Emptiness"
        }

        ^"Way of the Void" DEF {
            # When you make a check using your Void Ring, after
            # rolling dice, you may receive fatigue up to your school
            # rank. If you push, choose that many blank dice and alter
            # each to a non-blank result of your choice. If you pull,
            # choose that many non-blank dice and alter each to blank.
        }

        STARTING_OUTFIT [
            "sanctified robes", "wakizashi (short sword)",
            "knife or bo (staff)", "scroll satchel",
            "traveling pack"
        ]

        CURRICULUM {
            RANK 1 {
                SKILL_GROUP "Scholar Skills"
                SKILL "Fitness"
                SKILL "Meditation"
                SKILL "Skulduggery"
                TECHNIQUE_GROUP "Rank 1 Air Invocations"
                ^"Rank 1 Inversions" [inversion]
                ^"Tea Ceremony" [ritual]
            }
            RANK 2 {
                SKILL_GROUP "Martial Skills"
                SKILL "Command"
                SKILL "Composition"
                SKILL "Theology"
                TECHNIQUE_GROUP "Rank 1-2 Fire Invocations"
                ^"Rank 1-2 Inversions" [inversion]
                ^"All Arts Are One" [shuji]
            }
            RANK 3 {
                SKILL_GROUP "Social Skills"
                SKILL "Government"
                SKILL "Meditation"
                SKILL "Theology"
                TECHNIQUE_GROUP "Rank 1-3 Water Invocations"
                ^"Rank 1-3 Inversions" [inversion]
                ^"A Samurai's Fate" [shuji]
            }
            RANK 4 {
                SKILL_GROUP "Trade Skills"
                SKILL "Courtesy"
                SKILL "Meditation"
                SKILL "Theology"
                TECHNIQUE_GROUP "Rank 1-4 Earth Invocations"
                ^"Rank 1-4 Inversions" [inversion]
                ^"The Immovable Hand of Peace" [shuji]
            }
            RANK 5 {
                SKILL_GROUP "Scholar Skills"
                SKILL "Fitness"
                SKILL "Meditation"
                SKILL "Survival"
                TECHNIQUE_GROUP "Rank 1-5 Invocations"
                TECHNIQUE_GROUP "Rank 1-5 Inversions"
                ^"Rouse the Soul" [shuji]
            }
            RANK 6 {
                "Essence of Emptiness (Mastery Ability): Once per scene, after a character rolls dice, you may receive 3 fatigue to alter any number of their rolled dice to blank results."
            }
        }

        RULES {
            #L5RCR09jK0lM2nO4pQ6rS8t: ishiken_void_wielder_push_pull
            #L5RCR10uV1wX3yZ5aB7cD9e: ishiken_inversions_use_magnitude
        }
    }

    ^"Kaito Spirit Seeker School" DEF {
        EXTENDS #L5R252wX4yZ6aB8cD0eF2g ^"School"
        APPLIES TO [^"Samurai"]

        # Spiritual diplomats of the Phoenix Clan's Kaito family.
        # They relocate kami from places of abundance to places
        # in need, acting as safe vessels by inviting kami to dwell
        # within their bodies until they can be released.

        PROPERTIES {
            ^"School Name" STRING "Kaito Spirit Seeker" FIXED
            ^"Roles" LIST ["Bushi", "Shugenja"]
            ^"Ring Increase" STRING "+1 Earth, +1 Water"
            ^"Starting Skills" STRING "Choose five: +1 Composition, +1 Courtesy, +1 Games, +1 Martial Arts [Ranged], +1 Performance, +1 Sentiment, +1 Theology"
            ^"Starting Honor" INTEGER DEFAULT 45
            ^"Techniques Available" LIST ["Invocations (invocation)", "Kata (kata)", "Rituals (ritual)"]
            ^"Starting Techniques" STRING "Invocations (choose two): Armor of Earth, Extinguish, Dominion of Suijin, Tempest of Air; Kata (choose two): Striking as Air, Striking as Earth, Striking as Fire, Striking as Water"
            ^"School Ability" STRING "The Body Is a Shrine"
            ^"Mastery Ability" STRING "Temple of the Heart"
        }

        ^"The Body Is a Shrine" DEF {
            # In the presence of a kami, make a TN 4 Courtesy check
            # using the kami's element. If you succeed, the kami uses
            # your body as a vessel: reroll dice up to school rank on
            # checks using its element, but increase TN by 1 and add
            # kept ring set to opportunity+strife on opposing element
            # checks. If you unmask, the kami is released.
        }

        STARTING_OUTFIT [
            "traveling clothes", "sanctified robes",
            "yumi (bow)", "quiver of arrows",
            "wakizashi (short sword)", "knife",
            "bowyer's kit or divination kit"
        ]

        CURRICULUM {
            RANK 1 {
                SKILL_GROUP "Social Skills"
                SKILL "Composition"
                SKILL "Medicine"
                SKILL "Theology"
                TECHNIQUE_GROUP "Rank 1 Kata"
                ^"Commune with the Spirits" [ritual]
                ^"Civility Foremost" [shuji]
            }
            RANK 2 {
                SKILL_GROUP "Martial Skills"
                SKILL "Courtesy"
                SKILL "Games"
                SKILL "Survival"
                TECHNIQUE_GROUP "Rank 1-2 Invocations"
                ^"Crimson Leaves Strike" [kata]
                ^"Artisan's Appraisal" [shuji]
            }
            RANK 3 {
                SKILL_GROUP "Martial Skills"
                SKILL "Courtesy"
                SKILL "Performance"
                SKILL "Theology"
                TECHNIQUE_GROUP "Rank 1-3 Kata"
                TECHNIQUE_GROUP "Rank 1-3 Invocations"
                ^"Bond of the Realms" [invocation]
            }
            RANK 4 {
                SKILL_GROUP "Scholar Skills"
                SKILL "Martial Arts [Ranged]"
                SKILL "Meditation"
                SKILL "Survival"
                TECHNIQUE_GROUP "Rank 1-4 Kata"
                ^"Guardian of the Secret Gate" [invocation]
                ^"Buoyant Arrival" [shuji]
            }
            RANK 5 {
                SKILL_GROUP "Martial Skills"
                SKILL "Courtesy"
                SKILL "Sentiment"
                SKILL "Theology"
                TECHNIQUE_GROUP "Rank 1-5 Kata"
                TECHNIQUE_GROUP "Rank 1-5 Invocations"
                ^"Rouse the Soul" [shuji]
            }
            RANK 6 {
                "Temple of the Heart (Mastery Ability): You may keep two kami within you at once instead of one. All effects of The Body Is a Shrine still apply. If two kami share an element, the effects do not stack for that element."
            }
        }

        RULES {
            #L5RCR11fG2hI4jK6lM8nO0p: spirit_seeker_body_is_shrine
            #L5RCR12qR3sT5uV7wX9yZ1a: spirit_seeker_releases_kami_via_unmask
        }
    }

    ^"Kaiu Architect School" DEF {
        EXTENDS #L5R252wX4yZ6aB8cD0eF2g ^"School"
        APPLIES TO [^"Samurai"]

        # Trained to manipulate their environment to various purposes.
        # Masters can design fortress corridors that confound attackers
        # and maneuver the spiritual properties of a space via fu sui,
        # repelling unholy entities. They also maintain the Kaiu Wall.

        PROPERTIES {
            ^"School Name" STRING "Kaiu Architect" FIXED
            ^"Roles" LIST ["Artisan", "Courtier"]
            ^"Ring Increase" STRING "+1 Earth, +1 Void"
            ^"Starting Skills" STRING "Choose five: +1 Aesthetics, +1 Command, +1 Design, +1 Government, +1 Labor, +1 Martial Arts [Unarmed], +1 Tactics"
            ^"Starting Honor" INTEGER DEFAULT 45
            ^"Techniques Available" LIST ["Kata (kata)", "Rituals (ritual)", "Shuji (shuji)"]
            ^"Starting Techniques" STRING "Rituals: Commune with the Spirits; Shuji (choose one): Courtier's Resolve, Honest Assessment"
            ^"School Ability" STRING "Every Stone Serves"
            ^"Mastery Ability" STRING "The Flower Binds the Room"
        }

        ^"Every Stone Serves" DEF {
            # Reduce the TN of checks for downtime activities that
            # alter your environment by your school rank (to a minimum
            # of 1). When you succeed, choose mundane terrain
            # qualities equal to your school rank and add or remove
            # those terrain qualities from the area you affect.
        }

        STARTING_OUTFIT [
            "traveling clothes", "ceremonial clothes",
            "wakizashi (short sword)", "hammer or bo (staff)",
            "calligraphy set", "drafting paper",
            "fine set of chisels"
        ]

        CURRICULUM {
            RANK 1 {
                SKILL_GROUP "Martial Skills"
                SKILL "Aesthetics"
                SKILL "Commerce"
                SKILL "Labor"
                TECHNIQUE_GROUP "Rank 1 Earth Shuji"
                ^"Rite of the Wheel" [ritual]
                ^"Threshold Barrier" [ritual]
            }
            RANK 2 {
                SKILL_GROUP "Artisan Skills"
                SKILL "Fitness"
                SKILL "Martial Arts [Unarmed]"
                SKILL "Tactics"
                TECHNIQUE_GROUP "Rank 1-2 Water Shuji"
                ^"Ebb and Flow" [shuji]
                ^"Open-Hand Style" [kata]
            }
            RANK 3 {
                SKILL_GROUP "Trade Skills"
                SKILL "Aesthetics"
                SKILL "Fitness"
                SKILL "Martial Arts [Unarmed]"
                TECHNIQUE_GROUP "Rank 1-3 Earth Shuji"
                ^"Pillar of Calm" [shuji]
                ^"Lord Hida's Grip" [kata]
            }
            RANK 4 {
                SKILL_GROUP "Social Skills"
                SKILL "Aesthetics"
                SKILL "Labor"
                SKILL "Meditation"
                TECHNIQUE_GROUP "Rank 1-4 Fire Shuji"
                ^"Sear the Wound" [shuji]
                ^"Rouse the Soul" [shuji]
            }
            RANK 5 {
                SKILL_GROUP "Scholar Skills"
                SKILL "Aesthetics"
                SKILL "Survival"
                SKILL "Tactics"
                TECHNIQUE_GROUP "Rank 1-5 Void Shuji"
                ^"Soul Sunder" [kata]
                ^"Bend with the Storm" [shuji]
            }
            RANK 6 {
                "The Flower Binds the Room (Mastery Ability): Once per game session, you can use your school ability on any check (action or downtime activity) to alter your environment. When you do, you may also add or remove one supernatural terrain quality from the area you affect."
            }
        }

        RULES {
            #L5RCR13bC4dE6fG8hI0jK2l: architect_environment_manipulation
            #L5RCR14mN5oP7qR9sT1uV3w: architect_maintains_kaiu_wall
        }
    }

    ^"Kitsu Realm Wanderer School" DEF {
        EXTENDS #L5R252wX4yZ6aB8cD0eF2g ^"School"
        APPLIES TO [^"Samurai"]

        # Kitsu family members with innate ability to call upon ties
        # that bind the realms and bid them move closer, creating
        # places of power that overlap with the Mortal Realm. They
        # seek wisdom and secrets of the realms, though doing so
        # may attract the ravenous baku.

        PROPERTIES {
            ^"School Name" STRING "Kitsu Realm Wanderer" FIXED
            ^"Roles" LIST ["Shugenja", "Bushi"]
            ^"Ring Increase" STRING "+1 Void, +1 Water"
            ^"Starting Skills" STRING "Choose three: +1 Fitness, +1 Martial Arts [Melee], +1 Meditation, +1 Sentiment, +1 Survival, +1 Theology"
            ^"Starting Honor" INTEGER DEFAULT 50
            ^"Techniques Available" LIST ["Kata (kata)", "Rituals (ritual)", "Shuji (shuji)"]
            ^"Starting Techniques" STRING "Invocations (choose three): = Biting Steel, = Blessed Wind, = Courage of Seven Thunders, = Nature's Touch, = The Rushing Wave; Kata: Striking as Water; Rituals: Commune with the Spirits, Divination"
            ^"School Ability" STRING "Celestial Alignment"
            ^"Mastery Ability" STRING "Walk the Hidden Ways"
        }

        ^"Celestial Alignment" DEF {
            # As a Support action, make a TN 2 Meditation (Void) check
            # to draw one of the Spirit Realms closer to your location.
            # A number of range bands around your position up to your
            # school rank become a place of power of the realm you
            # choose. This effect persists until the end of the scene.
        }

        STARTING_OUTFIT [
            "traveling clothes", "ceremonial clothes",
            "daisho (katana and wakizashi)",
            "yari (spear) or bo (staff)", "scroll satchel",
            "pouch of incense", "traveling pack"
        ]

        CURRICULUM {
            RANK 1 {
                SKILL_GROUP "Martial Skills"
                SKILL "Sentiment"
                SKILL "Survival"
                SKILL "Theology"
                TECHNIQUE_GROUP "Rank 1 Water Invocations"
                ^"Rite of the Wheel" [ritual]
                ^"Warrior's Resolve" [kata]
            }
            RANK 2 {
                SKILL_GROUP "Trade Skills"
                SKILL "Martial Arts [Melee]"
                SKILL "Meditation"
                SKILL "Theology"
                TECHNIQUE_GROUP "Rank 1-2 Earth Invocations"
                ^"Messenger of Chikusho-do" [invocation]
                ^"Iron Forest Style" [kata]
            }
            RANK 3 {
                SKILL_GROUP "Scholar Skills"
                SKILL "Composition"
                SKILL "Meditation"
                SKILL "Tactics"
                TECHNIQUE_GROUP "Rank 1-3 Fire Invocations"
                ^"Bond of the Realms" [invocation]
                ^"Thunderclap Strike" [kata]
            }
            RANK 4 {
                SKILL_GROUP "Social Skills"
                SKILL "Commerce"
                SKILL "Meditation"
                SKILL "Theology"
                TECHNIQUE_GROUP "Rank 1-4 Air Invocations"
                ^"Crashing Wave Style" [kata]
                ^"Prayer of Protection" [ritual]
            }
            RANK 5 {
                SKILL_GROUP "Artisan Skills"
                SKILL "Martial Arts [Melee]"
                SKILL "Meditation"
                SKILL "Theology"
                TECHNIQUE_GROUP "Rank 1-5 Water Invocations"
                ^"Soul Sunder" [kata]
                ^"Rain of Ten Thousand Lotuses" [invocation]
            }
            RANK 6 {
                "Walk the Hidden Ways (Mastery Ability): When you use your school ability in a place already linked to a particular realm, you may move yourself and a number of characters up to your ranks in Meditation into that realm fully, leaving the Mortal Realm. As a Support action, you may make a TN 2 Meditation (Void) check to return yourself and a number of characters up to your ranks in Meditation to the Mortal Realm."
            }
        }

        RULES {
            #L5RCR15xY6zA8bC0dE2fG4h: realm_wanderer_creates_places_of_power
            #L5RCR16iJ7kL9mN1oP3qR5s: realm_wanderer_walks_between_realms
        }
    }

    ^"Moshi Sun Sentinel School" DEF {
        EXTENDS #L5R252wX4yZ6aB8cD0eF2g ^"School"
        APPLIES TO [^"Samurai"]

        # The foremost duty of the Moshi Sun Sentinels is to maintain
        # and protect Amaterasu's shrine. Lady Sun directly answers
        # their prayers, empowering their songs with radiant light.
        # Their flames will not burn the righteous, searing only
        # enemies of humanity.

        PROPERTIES {
            ^"School Name" STRING "Moshi Sun Sentinel" FIXED
            ^"Roles" LIST ["Bushi", "Shugenja"]
            ^"Ring Increase" STRING "+2 Fire"
            ^"Starting Skills" STRING "Choose three: +1 Courtesy, +1 Fitness, +1 Martial Arts [Melee], +1 Martial Arts [Unarmed], +1 Sentiment, +1 Theology"
            ^"Starting Honor" INTEGER DEFAULT 55
            ^"Techniques Available" LIST ["Kata (kata)", "Rituals (ritual)", "Shuji (shuji)"]
            ^"Starting Techniques" STRING "Invocations: = Armor of Radiance, = Biting Steel, = Extinguish, = Katana of Fire; Rituals: Cleansing Rite, Commune with the Spirits"
            ^"School Ability" STRING "Blazing Tears of Lady Sun"
            ^"Mastery Ability" STRING "Rippling Flame"
        }

        ^"Blazing Tears of Lady Sun" DEF {
            # Damage inflicted by your Fire invocations is treated as
            # having the Sacred item quality. Items you augment or
            # summon with Fire invocations have the Sacred quality.
            # When you affect a non-Tainted human with a Fire
            # invocation, it does not deal damage or inflict negative
            # conditions. Instead, the character removes fatigue equal
            # to your school rank plus the damage you would have
            # dealt. Each character can only benefit once per scene.
        }

        STARTING_OUTFIT [
            "sanctified robes", "daisho (katana and wakizashi)",
            "bo (staff)", "scroll satchel",
            "traveling pack", "religious texts"
        ]

        CURRICULUM {
            RANK 1 {
                SKILL_GROUP "Martial Skills"
                SKILL "Courtesy"
                SKILL "Sentiment"
                SKILL "Theology"
                TECHNIQUE_GROUP "Rank 1 Fire Invocations"
                ^"Striking as Fire" [kata]
                ^"Fires of Purity" [invocation]
            }
            RANK 2 {
                SKILL_GROUP "Scholar Skills"
                SKILL "Fitness"
                SKILL "Martial Arts [Melee]"
                SKILL "Tactics"
                TECHNIQUE_GROUP "Rank 1-2 Fire Invocations"
                ^"Crescent Moon Style" [kata]
                ^"Iron Forest Style" [kata]
            }
            RANK 3 {
                SKILL_GROUP "Martial Skills"
                SKILL "Command"
                SKILL "Government"
                SKILL "Theology"
                TECHNIQUE_GROUP "Rank 1-3 Fire Invocations"
                ^"Thunderclap Strike" [kata]
                ^"Crimson Leaves Strike" [kata]
            }
            RANK 4 {
                SKILL_GROUP "Scholar Skills"
                SKILL "Aesthetics"
                SKILL "Martial Arts [Melee]"
                SKILL "Performance"
                TECHNIQUE_GROUP "Rank 1-4 Fire Invocations"
                ^"Battle in the Mind" [kata]
                ^"Heart of the Lady Sun" [invocation]
            }
            RANK 5 {
                SKILL_GROUP "Social Skills"
                SKILL "Aesthetics"
                SKILL "Martial Arts [Melee]"
                SKILL "Theology"
                TECHNIQUE_GROUP "Rank 1-5 Fire Invocations"
                ^"Iron in the Mountains Style" [kata]
                ^"Striking as Void" [kata]
            }
            RANK 6 {
                "Rippling Flame (Mastery Ability): While performing a Fire invocation, you may spend a Void point to target additional characters equal to your ranks in Theology or to increase the maximum range of the technique by 1 range band."
            }
        }

        RULES {
            #L5RCR17tU8vW0xY2zA4bC6d: sun_sentinel_sacred_fire_damage
            #L5RCR18eF9gH1iJ3kL5mN7o: sun_sentinel_fire_heals_righteous
        }
    }

    ^"Shosuro Shadowweaver School" DEF {
        EXTENDS #L5R252wX4yZ6aB8cD0eF2g ^"School"
        APPLIES TO [^"Samurai"]

        # Trained not only to operate from darkness but to craft it.
        # A sibling school of the Soshi Illusionist School. Students
        # become masters of creating confusion, distractions, or
        # the cover their allies need to finish a job.

        PROPERTIES {
            ^"School Name" STRING "Shosuro Shadowweaver" FIXED
            ^"Roles" LIST ["Shugenja", "Bushi", "Shinobi"]
            ^"Ring Increase" STRING "+1 Air, +1 Fire"
            ^"Starting Skills" STRING "Choose three: +1 Courtesy, +1 Culture, +1 Fitness, +1 Government, +1 Martial Arts [Ranged], +1 Skulduggery"
            ^"Starting Honor" INTEGER DEFAULT 30
            ^"Techniques Available" LIST ["Invocations (invocation)", "Kata (kata)", "Rituals (ritual)"]
            ^"Starting Techniques" STRING "Invocations: By the Light of the Lord Moon, Cloak of Night, Fukurokujin's Wit; Rituals: Commune with the Spirits; Shuji: = Prey on the Weak"
            ^"School Ability" STRING "Sudden Nightfall"
            ^"Mastery Ability" STRING "Shadow Assassin"
        }

        ^"Sudden Nightfall" DEF {
            # You do not suffer ill effects of Obscuring terrain from
            # darkness. When you perform an Attack or Scheme action
            # against a target in darkness-Obscuring terrain, reduce
            # the TN by your school rank (minimum 1). As a Support
            # action, summon supernatural darkness at range 0-2;
            # area extending Air Ring range bands becomes Obscuring,
            # persisting a number of rounds equal to school rank.
        }

        STARTING_OUTFIT [
            "concealed armor", "sanctified robes",
            "wakizashi (short sword)", "six shuriken (throwing stars)",
            "three vials of poison",
            "any one item of rarity 4 or lower"
        ]

        CURRICULUM {
            RANK 1 {
                SKILL_GROUP "Social Skills"
                SKILL "Fitness"
                SKILL "Government"
                SKILL "Martial Arts [Ranged]"
                TECHNIQUE_GROUP "Rank 1 Shuji"
                ^"Skulk" [ninjutsu]
                ^"Deadly Sting" [ninjutsu]
            }
            RANK 2 {
                SKILL_GROUP "Scholar Skills"
                SKILL "Courtesy"
                SKILL "Martial Arts [Ranged]"
                SKILL "Skulduggery"
                TECHNIQUE_GROUP "Rank 1-2 Invocations"
                ^"Fluid Shadows" [invocation]
                ^"Lord Bayushi's Whispers" [shuji]
            }
            RANK 3 {
                SKILL_GROUP "Martial Skills"
                SKILL "Government"
                SKILL "Sentiment"
                SKILL "Skulduggery"
                TECHNIQUE_GROUP "Rank 1-3 Shuji"
                ^"Dream Painter" [invocation]
                ^"Noxious Cloud" [ninjutsu]
            }
            RANK 4 {
                SKILL_GROUP "Social Skills"
                SKILL "Culture"
                SKILL "Martial Arts [Ranged]"
                SKILL "Theology"
                TECHNIQUE_GROUP "Rank 1-4 Invocations"
                ^"Wolf's Proposal" [shuji]
                ^"Pin the Fan" [kata]
            }
            RANK 5 {
                SKILL_GROUP "Martial Skills"
                SKILL "Culture"
                SKILL "Medicine"
                SKILL "Skulduggery"
                TECHNIQUE_GROUP "Rank 1-5 Shuji"
                ^"The Fading Dream" [invocation]
                ^"Silencing Stroke" [ninjutsu]
            }
            RANK 6 {
                "Shadow Assassin (Mastery Ability, Action): Once per scene as an Attack and Movement action, summon a shadow assassin with no corporeal form that cannot be harmed. At the end of each of your turns, perform a Strike action using a readied weapon targeting any character in Obscuring terrain regardless of range. Damage dealt is supernatural. Persists until end of scene."
            }
        }

        RULES {
            #L5RCR19pQ0rS2tU4vW6xY8z: shadowweaver_immune_to_darkness_obscuring
            #L5RCR20aB1cD3eF5gH7iJ9k: shadowweaver_summons_supernatural_darkness
        }
    }

    ^"Utaku Stablemaster School" DEF {
        EXTENDS #L5R252wX4yZ6aB8cD0eF2g ^"School"
        APPLIES TO [^"Samurai"]

        # Extremely adept masters who pair students with steeds.
        # Known for dangerous prowess with a whip, used to protect
        # horses against threats while mounted. They have a genuine,
        # spiritual connection to the beasts.

        PROPERTIES {
            ^"School Name" STRING "Utaku Stablemaster" FIXED
            ^"Roles" LIST ["Bushi", "Sage"]
            ^"Ring Increase" STRING "+1 Air, +1 Water"
            ^"Starting Skills" STRING "Choose five: +1 Command, +1 Fitness, +1 Martial Arts [Melee], +1 Martial Arts [Ranged], +1 Sentiment, +1 Smithing, +1 Survival"
            ^"Starting Honor" INTEGER DEFAULT 55
            ^"Techniques Available" LIST ["Kata (kata)", "Rituals (ritual)", "Water and Air Invocations (invocation)"]
            ^"Starting Techniques" STRING "Invocations: Nature's Touch; Kata: = Crescent Moon Style, Striking as Air, Striking as Water"
            ^"School Ability" STRING "Steed of the Kami"
            ^"Mastery Ability" STRING "Master of Beasts"
        }

        ^"Steed of the Kami" DEF {
            # When you make a check to handle, calm, or instruct an
            # animal, negate strife results up to your school rank.
            # Once per scene as a Support action, make a TN 2
            # Survival (Water) or Theology (Water) check. If you
            # succeed, discover a ridable animal of combat rank 3 or
            # lower appropriate to the environment. It is friendly and
            # grants mount benefits, with Water Ring increased by
            # bonus successes (max 6).
        }

        STARTING_OUTFIT [
            "ashigaru armor", "traveling clothes",
            "daisho (katana or scimitar, wakizashi)",
            "yumi (bow)", "quiver of arrows",
            "knife", "whip", "traveling pack",
            "bag of horse treats"
        ]

        CURRICULUM {
            RANK 1 {
                SKILL_GROUP "Martial Skills"
                SKILL "Command"
                SKILL "Sentiment"
                SKILL "Survival"
                TECHNIQUE_GROUP "Rank 1 Kata"
                ^"Call Upon the Wind" [invocation]
                ^"Blessing of Fertile Fields" [ritual]
            }
            RANK 2 {
                SKILL_GROUP "Trade Skills"
                SKILL "Fitness"
                SKILL "Martial Arts [Melee]"
                SKILL "Theology"
                TECHNIQUE_GROUP "Rank 1-2 Kata"
                TECHNIQUE_GROUP "Rank 1-2 Rituals"
                ^"Emboldened Steed" [invocation]
            }
            RANK 3 {
                SKILL_GROUP "Martial Skills"
                SKILL "Medicine"
                SKILL "Smithing"
                SKILL "Survival"
                TECHNIQUE_GROUP "Rank 1-3 Kata"
                ^"Messenger of Chikusho-do" [invocation]
                ^"Path of Beasts" [invocation]
            }
            RANK 4 {
                SKILL_GROUP "Social Skills"
                SKILL "Commerce"
                SKILL "Sentiment"
                SKILL "Survival"
                TECHNIQUE_GROUP "Rank 1-4 Kata"
                TECHNIQUE_GROUP "Rank 1-4 Rituals"
                ^"Guardian of the Secret Gate" [invocation]
            }
            RANK 5 {
                SKILL_GROUP "Trade Skills"
                SKILL "Martial Arts [Melee]"
                SKILL "Martial Arts [Ranged]"
                SKILL "Medicine"
                TECHNIQUE_GROUP "Rank 1-5 Kata"
                TECHNIQUE_GROUP "Rank 1-5 Rituals"
                ^"Rain of Ten Thousand Lotuses" [invocation]
            }
            RANK 6 {
                "Master of Beasts (Mastery Ability, Action): Once per game as a Support action, summon a number of animals equal to your Water Ring that are combat rank 3 or lower. They are friendly and fulfill your commands until end of scene. If an animal becomes Compromised or incapacitated, it flees."
            }
        }

        RULES {
            #L5RCR21lM2nO4pQ6rS8tU0v: stablemaster_spiritual_bond_with_beasts
            #L5RCR22wX3yZ5aB7cD9eF1g: stablemaster_discovers_mounts_in_environment
        }
    }

