    # --- Pilgrimage Road (Kolat) ---

    ^"Aotora Akira, Pilgrim" DEF {
        APPLIES TO [^"NPC"]

        # A man posing as a pilgrim who is actually a
        # poisoner and Kolat agent. Shrewd and patient,
        # he conceals his true nature behind courtly robes
        # and a dark secret.

        PROPERTIES {
            ^"Type" STRING "Adversary" FIXED
            ^"Combat Conflict Rank" INTEGER 2
            ^"Intrigue Conflict Rank" INTEGER 3
            ^"Rings" DEF {
                ^"Air" INTEGER 2
                ^"Earth" INTEGER 4
                ^"Fire" INTEGER 2
                ^"Water" INTEGER 3
                ^"Void" INTEGER 2
            }
            ^"Demeanor" STRING "Shrewd"
            ^"Social Skill Check TN Modifiers" STRING "Air +2, Fire -2"
            ^"Endurance" INTEGER 10
            ^"Composure" INTEGER 8
            ^"Focus" INTEGER 5
            ^"Vigilance" INTEGER 3
            ^"Honor" INTEGER 15
            ^"Glory" INTEGER 35
            ^"Status" INTEGER 35
            ^"Skills" LIST OF STRING ["Artisan 0", "Martial 2", "Scholar 1", "Social 3", "Trade 2"]
            ^"Advantages" LIST OF STRING ["Patient and Subtle (Air) [Trade; Mental]"]
            ^"Disadvantages" LIST OF STRING ["Dark Secret (Void) [Social; Interpersonal]"]
            ^"Favored Weapons" LIST OF STRING ["Wakizashi: Range 0-1, Damage 4, Deadliness 5/7, Ceremonial, Concealable, Razor-Edged"]
            ^"Gear" LIST OF STRING ["Courtly robes (Physical 1, Ceremonial, Resplendent)", "Satchel of poisons", "Two knives"]
        }

        ^"Poisoner" DEF {
            # For purposes of identifying, preparing, or using
            # poisons, treat Akira's ranks in Medicine as 4.
            # When Akira makes an Attack action check using a
            # poisoned weapon, he may spend (op) as follows:
            # (op): The weapon remains poisoned. (The effects of
            # the poison still apply to this attack.)
        }

        RULES {
            #L5REE22sT2uV4wX6yZ8aB0cD: akira_pilgrim
        }
    }

    # --- Temple (Fortunist) ---

    ^"Dai, Fortunist Monk" DEF {
        APPLIES TO [^"NPC"]

        # A Fortunist monk and herbalist who uses her
        # knowledge of medicine and herbs to tend to the
        # sick and injured. Assertive and strong-willed,
