            ^"Disadvantages" LIST OF STRING ["Hot-Tempered (Fire) [Social; Mental]"]
            ^"Favored Weapons" LIST OF STRING ["Bestial Claws: Range 0, Damage 4, Deadliness 4, Razor-Edged"]
            ^"Gear" LIST OF STRING ["Ragged robes (Physical 2, Supernatural 2)"]
        }

        ^"Inhuman Resilience" DEF {
            # Attacks targeting Shu treat their Deadliness as
