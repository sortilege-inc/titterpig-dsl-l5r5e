    ^"Shu, Possessed Monk" DEF {
        APPLIES TO [^"NPC"]

        # A monk who has been possessed by an evil spirit,
        # transforming him into a feral, dangerous creature.
        # His inhuman resilience makes him extremely difficult
        # to put down in combat.

        PROPERTIES {
            ^"Type" STRING "Adversary" FIXED
