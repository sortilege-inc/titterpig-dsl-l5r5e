            # spent this way.
        }

        RULES {
            #L5REE23eF3gH5iJ7kL9mN1oP: dai_fortunist
        }
    }

    # -----------------------------------------------
    # Chapter 6: Wilds of Rokugan
    # -----------------------------------------------

    # --- Wilderness (Crab) ---

    ^"Kuni Haruna, Sinister Witch Hunter" DEF {
        APPLIES TO [^"NPC"]

        # A Crab witch hunter whose intimidating presence
        # and merciless pursuit of the Taint's corruption
        # make her feared even by her allies. Her nightmares
        # hint at the toll her work has taken on her spirit.

        PROPERTIES {
            ^"Type" STRING "Adversary" FIXED
            ^"Combat Conflict Rank" INTEGER 4
            ^"Intrigue Conflict Rank" INTEGER 1
            ^"Rings" DEF {
                ^"Air" INTEGER 4
                ^"Earth" INTEGER 3
                ^"Fire" INTEGER 3
                ^"Water" INTEGER 3
                ^"Void" INTEGER 3
            }
            ^"Demeanor" STRING "Intimidating"
            ^"Social Skill Check TN Modifiers" STRING "Fire +2, Air -2"
            ^"Endurance" INTEGER 14
            ^"Composure" INTEGER 14
            ^"Focus" INTEGER 6
            ^"Vigilance" INTEGER 3
            ^"Honor" INTEGER 40
            ^"Glory" INTEGER 50
            ^"Status" INTEGER 39
            ^"Skills" LIST OF STRING ["Artisan 0", "Martial 3", "Scholar 4", "Social 3", "Trade 2"]
            ^"Advantages" LIST OF STRING ["Fearsome Presence (Fire) [Social; Interpersonal]"]
            ^"Disadvantages" LIST OF STRING ["Nightmares (Earth) [Scholar; Spiritual]"]
            ^"Favored Weapons" LIST OF STRING ["Naginata: Range 2, Damage 6, Deadliness 6, Cumbersome, Razor-Edged, Wargear"]
            ^"Gear" LIST OF STRING ["Warded robes (Physical 2, Supernatural 4, Sacred)", "Wakizashi", "Prayer strips", "Sacred scrolls"]
        }

        ^"Merciless Hunter" DEF {
            # When Kuni Haruna makes an Attack action targeting
            # a character that she has not previously attacked
            # during this scene, she may spend (op) as follows:
            # (op)+: Increase the deadliness of the attack by 1
            # for each (op) spent this way.
            # (op)+: Increase the damage of the attack by 1 for
            # each (op) spent this way.
        }

        RULES {
            #L5REE24qR4sT6uV8wX0yZ2aB: haruna_witch_hunter
        }
    }

    # --- Wilderness (Phoenix) ---

    ^"Asako Takahiro, Insightful Inquisitor" DEF {
        APPLIES TO [^"NPC"]

        # A Phoenix inquisitor with a keen eye for detail
        # and an uncanny ability to read people. His shrewd
        # observations and briefings can prepare allies
        # against dangers they would otherwise miss.

        PROPERTIES {
            ^"Type" STRING "Adversary" FIXED
            ^"Combat Conflict Rank" INTEGER 3
            ^"Intrigue Conflict Rank" INTEGER 4
            ^"Rings" DEF {
                ^"Air" INTEGER 4
                ^"Earth" INTEGER 4
                ^"Fire" INTEGER 3
                ^"Water" INTEGER 2
                ^"Void" INTEGER 3
            }
            ^"Demeanor" STRING "Shrewd"
            ^"Social Skill Check TN Modifiers" STRING "Air +2, Fire -2"
            ^"Endurance" INTEGER 12
            ^"Composure" INTEGER 14
            ^"Focus" INTEGER 6
            ^"Vigilance" INTEGER 5
            ^"Honor" INTEGER 45
            ^"Glory" INTEGER 50
            ^"Status" INTEGER 40
            ^"Skills" LIST OF STRING ["Artisan 2", "Martial 3", "Scholar 4", "Social 4", "Trade 0"]
            ^"Advantages" LIST OF STRING ["Excellent Liar (Air) [Social; Interpersonal]"]
            ^"Disadvantages" LIST OF STRING ["Know-It-All (Water) [Social; Mental]"]
            ^"Favored Weapons" LIST OF STRING ["Jitte: Range 0, Damage 3, Deadliness 2, Concealable, Snaring"]
            ^"Gear" LIST OF STRING ["Sanctified robes (Physical 1, Supernatural 3, Ceremonial)", "Wakizashi", "Incense", "Sacred scrolls"]
        }

        ^"Keep One Eye Open" DEF {
            # Once per game session as a downtime activity,
            # Asako Takahiro can brief any number of characters
            # regarding his observations and suspicions about
            # the nearby area. Each character who heeds his
            # words increases their Vigilance by 2 until the
            # end of the game session.
        }

        RULES {
            #L5REE25cD5eF7gH9iJ1kL3mN: takahiro_inquisitor
        }
    }

    # --- Wilderness (Dragon) ---

    ^"Agasha Susumu, Scholar and Guide" DEF {
        APPLIES TO [^"NPC"]

        # A Dragon clan scholar and herbalist who serves as
        # a guide through the wilderness. Cantankerous but
        # deeply knowledgeable, his herbal remedies can calm
        # even the most frayed nerves.

        PROPERTIES {
            ^"Type" STRING "Adversary" FIXED
            ^"Combat Conflict Rank" INTEGER 1
            ^"Intrigue Conflict Rank" INTEGER 2
            ^"Rings" DEF {
                ^"Air" INTEGER 3
                ^"Earth" INTEGER 2
                ^"Fire" INTEGER 4
                ^"Water" INTEGER 3
                ^"Void" INTEGER 3
            }
            ^"Demeanor" STRING "Assertive"
            ^"Social Skill Check TN Modifiers" STRING "Earth +2, Water -2"
            ^"Endurance" INTEGER 12
            ^"Composure" INTEGER 14
            ^"Focus" INTEGER 6
            ^"Vigilance" INTEGER 3
            ^"Honor" INTEGER 45
            ^"Glory" INTEGER 50
            ^"Status" INTEGER 39
            ^"Skills" LIST OF STRING ["Artisan 0", "Martial 2", "Scholar 4", "Social 1", "Trade 3"]
            ^"Advantages" LIST OF STRING ["Exact Memory (Earth) [Scholar; Mental]"]
            ^"Disadvantages" LIST OF STRING ["Cantankerous (Water) [Social; Interpersonal]"]
            ^"Favored Weapons" LIST OF STRING ["Kiseru: Range 0, Damage 2, Deadliness 2, Concealable, Mundane"]
            ^"Gear" LIST OF STRING ["Rugged clothes", "Satchel of herbs"]
        }

        ^"Calming Remedy" DEF {
            # Once per game session as a downtime activity,
            # Susumu may share his personal admixture of
            # mountain herbs with up to five characters. Those
            # who partake increase their composure by 2 but
            # reduce their vigilance by 1 until the end of the
            # game session.
        }

        RULES {
            #L5REE26oP6qR8sT0uV2wX4yZ: susumu_guide
        }
    }

    # --- Shinomen Forest (Kitsune) ---

    ^"Ha Iwa, Kitsune Spirit" DEF {
        APPLIES TO [^"NPC"]

        # A kitsune (fox spirit) who can shift between fox
        # and human form. Mischievous and curious about
        # human ways, but also impatient and prone to
        # showing off. Her true nature is revealed when
        # she becomes compromised.

        PROPERTIES {
            ^"Type" STRING "Adversary" FIXED
            ^"Combat Conflict Rank" INTEGER 4
            ^"Intrigue Conflict Rank" INTEGER 5
            ^"Rings" DEF {
                ^"Air" INTEGER 1
                ^"Earth" INTEGER 5
                ^"Fire" INTEGER 3
                ^"Water" INTEGER 4
                ^"Void" INTEGER 3
            }
            ^"Demeanor" STRING "Mischievous"
            ^"Social Skill Check TN Modifiers" STRING "Fire +2, Air -2"
            ^"Endurance" INTEGER 14
            ^"Composure" INTEGER 8
            ^"Focus" INTEGER 9
            ^"Vigilance" INTEGER 4
            ^"Honor" INTEGER 5
            ^"Glory" INTEGER 25
            ^"Status" INTEGER 10
            ^"Skills" LIST OF STRING ["Artisan 0", "Martial 3", "Scholar 3", "Social 4", "Trade 3"]
            ^"Advantages" LIST OF STRING ["Dangerous Allure (Fire) [Social; Interpersonal]"]
            ^"Disadvantages" LIST OF STRING ["Impatience (Earth) [Scholar; Mental]", "Showoff (Air) [Social; Interpersonal]"]
            ^"Favored Weapons" LIST OF STRING ["Teeth: Range 0, Damage 3, Deadliness 5, Natural"]
            ^"Gear" LIST OF STRING []
        }

        ^"Shapeshifter" DEF {
            # As a Support action, a kitsune can transform
            # into human form (or back again). While in their
            # fox form, they have silhouette 1. While in human
            # form, they are always curious and eager to learn
            # more of human ways, but also seek to hide their
            # true nature. When they become compromised, their
            # fox feet, ears, or tails reappear.
        }

        RULES {
            #L5REE27aB7cD9eF1gH3iJ5kL: haiwa_kitsune
        }
    }

    # --- Shinomen Forest (Nezumi) ---

    ^"Iht-zyk, Nezumi Forager" DEF {
        APPLIES TO [^"NPC"]

        # A nezumi (ratling) of the Tattered Ear tribe who
        # forages in the Shinomen Forest. Nurturing and wise
        # in the ways of the forest, but meek around outsiders.
        # Her knowledge of natural and spiritual dangers is
        # invaluable to those who earn her trust.

        PROPERTIES {
            ^"Type" STRING "Adversary" FIXED
            ^"Combat Conflict Rank" INTEGER 1
            ^"Intrigue Conflict Rank" INTEGER 2
            ^"Rings" DEF {
                ^"Air" INTEGER 3
                ^"Earth" INTEGER 2
                ^"Fire" INTEGER 2
                ^"Water" INTEGER 3
                ^"Void" INTEGER 1
            }
            ^"Demeanor" STRING "Nurturing"
            ^"Social Skill Check TN Modifiers" STRING "Earth +2, Fire -2"
            ^"Endurance" INTEGER 12
            ^"Composure" INTEGER 10
            ^"Focus" INTEGER 6
            ^"Vigilance" INTEGER 5
            ^"Honor" INTEGER 25
            ^"Glory" INTEGER 10
            ^"Status" INTEGER 5
            ^"Skills" LIST OF STRING ["Artisan 0", "Martial 0", "Scholar 2", "Social 3", "Trade 4"]
            ^"Advantages" LIST OF STRING ["Keen Smell (Air) [Trade; Mental]"]
            ^"Disadvantages" LIST OF STRING ["Meekness (Fire) [Social; Interpersonal]"]
            ^"Favored Weapons" LIST OF STRING ["Claws: Range 0-1, Damage 4, Deadliness 2, Razor-Edged", "Teeth: Range 0, Damage 4, Deadliness 3, Snaring"]
            ^"Gear" LIST OF STRING ["Practical clothes", "Basket of nuts and berries"]
        }

        ^"Forest Lessons" DEF {
            # Once per game session as a downtime activity,
            # Iht-zyk may impart the wisdom of the Tattered Ear
            # tribe to any number of characters. Those who choose
            # to listen and apply the knowledge may forfeit 1
            # honor to decrease the TN of checks to identify or
            # avoid natural or spiritual dangers within Shinomen
            # Forest by 1 until the end of the game session.
        }

        ^"Nezumi Instincts" DEF {
            # When Iht-zyk makes a skill check to hide, climb,
            # or move quietly, she increases her number of bonus
            # successes by 3 or decreases her shortfall by 3
            # (to a minimum of 0).
        }

        RULES {
            #L5REE28mN8oP0qR2sT4uV6wX: ihtzyk_forager
        }
    }

    # --- Shadowlands Border (Crab) ---

    ^"Kaiu Shibito Tsuneko" DEF {
        APPLIES TO [^"NPC"]

        # A Crab artisan and calligrapher haunted by her
        # connection to Meido, the Realm of the Dead. She
        # wanders the Empire making offerings and recording
        # the stories of spirits. Detached and superstitious,
        # but her gift grants her unusual insight.

        PROPERTIES {
            ^"Type" STRING "Adversary" FIXED
            ^"Combat Conflict Rank" INTEGER 2
            ^"Intrigue Conflict Rank" INTEGER 3
            ^"Rings" DEF {
                ^"Air" INTEGER 4
                ^"Earth" INTEGER 1
                ^"Fire" INTEGER 3
                ^"Water" INTEGER 3
                ^"Void" INTEGER 2
            }
            ^"Demeanor" STRING "Detached"
            ^"Social Skill Check TN Modifiers" STRING "Fire +2, Water -2"
            ^"Endurance" INTEGER 14
            ^"Composure" INTEGER 14
            ^"Focus" INTEGER 4
            ^"Vigilance" INTEGER 2
            ^"Honor" INTEGER 30
            ^"Glory" INTEGER 40
            ^"Status" INTEGER 35
            ^"Skills" LIST OF STRING ["Artisan 4", "Martial 1", "Scholar 3", "Social 1", "Trade 3"]
            ^"Advantages" LIST OF STRING ["Secrets (Void) [Social; Interpersonal]"]
            ^"Disadvantages" LIST OF STRING ["Superstitious (Void) [Scholar; Mental]"]
            ^"Favored Weapons" LIST OF STRING ["Wakizashi: Range 0-1, Damage 4, Deadliness 5/7, Ceremonial, Razor-Edged"]
            ^"Gear" LIST OF STRING ["Ragged traveling clothes", "Calligraphy set", "Scroll satchel", "Pack of offerings"]
        }

        ^"Touched by Meido" DEF {
            # Activation: When making a check pertaining to
            # spirits, Shibito may receive 3 strife to roll 1
            # additional ring die and keep 1 additional die as
            # if she had spent 1 Void point.
        }

        RULES {
            #L5REE29yZ9aB1cD3eF5gH7iJ: shibito_tsuneko
        }
    }

    # --- Wilderness (Troll) ---

    ^"Kasai, Mournful Troll" DEF {
        APPLIES TO [^"NPC"]

        # An ancient troll of immense size and surprising
        # wisdom. Morose and prone to fits of rage, but
        # possesses knowledge stretching back centuries.
        # Those who earn his trust can learn powerful
        # techniques from him.

        PROPERTIES {
            ^"Type" STRING "Adversary" FIXED
            ^"Combat Conflict Rank" INTEGER 8
            ^"Intrigue Conflict Rank" INTEGER 4
            ^"Rings" DEF {
                ^"Air" INTEGER 4
                ^"Earth" INTEGER 2
                ^"Fire" INTEGER 4
                ^"Water" INTEGER 5
                ^"Void" INTEGER 3
            }
            ^"Demeanor" STRING "Morose"
            ^"Social Skill Check TN Modifiers" STRING "Water +2, Fire -2"
            ^"Endurance" INTEGER 18
            ^"Composure" INTEGER 11
            ^"Focus" INTEGER 4
            ^"Vigilance" INTEGER 3
            ^"Honor" INTEGER 35
            ^"Glory" INTEGER 15
            ^"Status" INTEGER 5
            ^"Skills" LIST OF STRING ["Artisan 1", "Martial 3", "Scholar 6", "Social 2", "Trade 2"]
            ^"Advantages" LIST OF STRING ["Brute Strength (Air) [Martial; Physical]"]
            ^"Disadvantages" LIST OF STRING ["Pessimism (Water) [Social; Interpersonal]"]
            ^"Favored Weapons" LIST OF STRING ["Massive Cudgel: Range 2, Damage 9, Deadliness 5, Cumbersome", "Rending Grip: Range 1, Damage 4, Deadliness 6"]
            ^"Gear" LIST OF STRING ["Armor scraps and scaled hide (Physical 2, Supernatural 1)", "Stolen sake and scrolls"]
        }

        ^"Ancient and Powerful" DEF {
            # Kasai is an Otherworldly being of silhouette 4.
        }

        ^"Temper" DEF {
            # Each time Kasai suffers 1 or more fatigue, he
            # gains 1 strife. When Kasai's strife exceeds half
            # of his composure, he gains the Enraged condition.
        }

        ^"Sustaining Fury" DEF {
            # Kasai cannot suffer the Incapacitated or
            # Unconscious condition while he has the Enraged
            # condition.
        }

        ^"Primordial Wisdom" DEF {
            # As a downtime activity, Kasai can share ancient
            # secrets with characters who have earned his trust.
            # Characters who heed this wisdom can purchase the
            # Channel the Fire Dragon kiho technique regardless
            # of prerequisites.
        }

        RULES {
            #L5REE30kL0mN2oP4qR6sT8uV: kasai_troll
        }
    }

    # --- Coastal Waters (Pirate) ---

    ^"Uranaishi no Manami, Ambitious Pirate" DEF {
        APPLIES TO [^"NPC"]

        # An ambitious pirate captain who combines martial
        # prowess with shrewd cunning. Uses dirty tricks in
        # combat to disorient opponents. Despite her rough
        # profession, she has a surprising appreciation for
        # history, etiquette, and courtly romance.

        PROPERTIES {
            ^"Type" STRING "Adversary" FIXED
            ^"Combat Conflict Rank" INTEGER 4
            ^"Intrigue Conflict Rank" INTEGER 2
            ^"Rings" DEF {
                ^"Air" INTEGER 1
                ^"Earth" INTEGER 2
                ^"Fire" INTEGER 4
                ^"Water" INTEGER 3
                ^"Void" INTEGER 2
            }
            ^"Demeanor" STRING "Shrewd"
            ^"Social Skill Check TN Modifiers" STRING "Water +2, Fire -2"
            ^"Endurance" INTEGER 10
            ^"Composure" INTEGER 8
            ^"Focus" INTEGER 5
            ^"Vigilance" INTEGER 3
            ^"Honor" INTEGER 45
            ^"Glory" INTEGER 65
            ^"Status" INTEGER 30
            ^"Skills" LIST OF STRING ["Artisan 1", "Martial 4", "Scholar 2", "Social 3", "Trade 3"]
            ^"Advantages" LIST OF STRING ["Keen Sight (Water) [Trade; Physical]"]
            ^"Disadvantages" LIST OF STRING ["Bluntness (Air) [Social; Interpersonal]"]
            ^"Favored Weapons" LIST OF STRING ["Katana: Range 1, Damage 4, Deadliness 5/7, Ceremonial, Concealable, Razor-Edged"]
            ^"Gear" LIST OF STRING ["Concealed armor (Physical 2, Concealable)", "Wakizashi", "Sake jug", "Well-thumbed book on history, etiquette, or courtly romance"]
        }

        ^"Dirty Tricks" DEF {
            # When performing an Attack action check, Manami
            # may spend (op) as follows:
            # (op)+: One character at range 0-2 suffers the
            # Disoriented condition.
        }

        RULES {
            #L5REE31wX1yZ3aB5cD7eF9gH: manami_pirate
        }
    }
}
