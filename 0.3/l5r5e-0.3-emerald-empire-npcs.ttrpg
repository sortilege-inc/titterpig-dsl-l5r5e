        }

        RULES {
            #L5REE19iJ9kL1mN3oP5qR7sT: shu_possessed
        }
    }

    # --- Monastery (Shinseist) ---

    ^"Jun, Shinseist Monk" DEF {
        APPLIES TO [^"NPC"]

        # A Shinseist monk with a flippant demeanor that
        # belies his deep understanding of the Way. His
        # attunement to Shinsei's teachings makes him
        # remarkably difficult to overcome in conflict.

        PROPERTIES {
            ^"Type" STRING "Adversary" FIXED
            ^"Combat Conflict Rank" INTEGER 4
            ^"Intrigue Conflict Rank" INTEGER 2
            ^"Rings" DEF {
                ^"Air" INTEGER 2
                ^"Earth" INTEGER 4
                ^"Fire" INTEGER 3
                ^"Water" INTEGER 2
                ^"Void" INTEGER 3
            }
            ^"Demeanor" STRING "Flippant"
            ^"Social Skill Check TN Modifiers" STRING "Fire +2, Air -2"
            ^"Endurance" INTEGER 10
            ^"Composure" INTEGER 12
            ^"Focus" INTEGER 6
            ^"Vigilance" INTEGER 4
            ^"Honor" INTEGER 55
            ^"Glory" INTEGER 45
            ^"Status" INTEGER 25
            ^"Skills" LIST OF STRING ["Artisan 0", "Martial 2", "Scholar 3", "Social 3", "Trade 0"]
            ^"Advantages" LIST OF STRING ["Subtle Observer (Air) [Social; Interpersonal]"]
            ^"Disadvantages" LIST OF STRING ["Bluntness (Air) [Social; Interpersonal]"]
            ^"Favored Weapons" LIST OF STRING ["Walking Staff: Range 1-2, Damage 6, Deadliness 2, Mundane"]
            ^"Gear" LIST OF STRING ["Monk's robes (Physical 1)", "Gold lotus pendant (When performing a Meditation check add one rolled Ring die showing (op) result)"]
        }

        ^"Attuned to the Way" DEF {
            # When a character succeeds on an Attack or Scheme
            # action targeting Jun, reduce their bonus successes
            # by 3, to a minimum of 0.
        }

        RULES {
            #L5REE20uV0wX2yZ4aB6cD8eF: jun_shinseist
        }
    }

