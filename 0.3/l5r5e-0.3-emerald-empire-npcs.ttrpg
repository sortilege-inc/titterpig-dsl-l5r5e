            ^"Intrigue Conflict Rank" INTEGER 4
            ^"Rings" DEF {
                ^"Air" INTEGER 3
                ^"Earth" INTEGER 2
                ^"Fire" INTEGER 3
                ^"Water" INTEGER 2
                ^"Void" INTEGER 3
            }
            ^"Demeanor" STRING "Assertive"
            ^"Social Skill Check TN Modifiers" STRING "Earth +2, Air -2"
            ^"Endurance" INTEGER 14
            ^"Composure" INTEGER 15
            ^"Focus" INTEGER 4
            ^"Vigilance" INTEGER 3
            ^"Honor" INTEGER 50
            ^"Glory" INTEGER 45
            ^"Status" INTEGER 25
            ^"Skills" LIST OF STRING ["Artisan 3", "Martial 1", "Scholar 2", "Social 3", "Trade 0"]
            ^"Advantages" LIST OF STRING ["Indomitable Will (Air) [Social; Mental]"]
