        SCHOOL_ABILITY "Risk and Reward" {
            "You have an uncanny sense for dangerous situations. Your vigilance and focus are increased by your school rank, unless you are Compromised."
        }

        MASTERY_ABILITY ^"All Part of the Plan" {
            "Once per scene when you make a check to resist, you may spend 1 Void Point to automatically succeed. If you do, you may immediately perform an action."
        }
        STARTING_OUTFIT [
