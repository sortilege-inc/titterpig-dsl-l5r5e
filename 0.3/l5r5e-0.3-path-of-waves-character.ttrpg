                ^"Rider's Haste" [kata]
            }
            RANK 2 {
                SKILL_GROUP "Martial Skills"
                SKILL "Command"
                SKILL "Government"
                SKILL "Seafaring"
                TECHNIQUE_GROUP "Rank 1-2 Kata"
                ^"Rushing Ox Style" [kata]
                ^"Summon Mantra: [One Implement]" [mantra]
            }
            RANK 3 {
                SKILL_GROUP "Martial Skills"
                SKILL "Command"
                SKILL "Culture"
                SKILL "Seafaring"
                TECHNIQUE_GROUP "Rank 1-3 Earth and Fire Shūji"
