            ^"Techniques Available" LIST ["Kata", "Rituals", "Shūji"]
        }


        STARTING_TECHNIQUES {
            RITUAL ^"Balancing Salve"
            RITUAL ^"Cleansing Rite"
            SHUJI ^"Illuminate the Way"
            SHUJI ^"Truth Burns Through Lies"
        }

        SCHOOL_ABILITY "Creative Execution" {
            "When making a check to perform a ritual, you may receive fatigue up to your school rank to add that many kept (ring) set to (op) results."
        }

        MASTERY_ABILITY ^"Swift Creation" {
            "Once per scene you may perform a ritual that uses the Medicine skill as an action as if it were a downtime activity."
        }
        STARTING_OUTFIT [
            "traveling clothes", "one weapon of rarity 6 or lower",
            "an alchemy kit", "a book of formulae",
            "a book of mathematics", "the Qamarist holy book",
            "one item of rarity 4 or lower", "one trinket"
        ]

        CURRICULUM {
            RANK 1 {
                SKILL_GROUP "Scholar Skills"
                SKILL "Courtesy"
                SKILL "Martial Arts [Ranged]"
                SKILL "Meditation"
                TECHNIQUE_GROUP "Rank 1-2 Rituals"
                ^"Weight of Duty" [shuji]
                ^"Wanderer's Resolve" [shuji]
            }
            RANK 2 {
                SKILL_GROUP "Scholar Skills"
                SKILL "Command"
                SKILL "Labor"
                SKILL "Martial Arts [Ranged]"
                TECHNIQUE_GROUP "Rank 1-2 Shūji"
                ^"Fortitude Draught" [ritual]
                ^"Boar's Wrath Style" [kata]
            }
            RANK 3 {
                SKILL_GROUP "Scholar Skills"
                SKILL "Courtesy"
                SKILL "Martial Arts [Ranged]"
                SKILL "Sentiment"
                TECHNIQUE_GROUP "Rank 1-3 Rituals"
                ^"Breath of the Wind Style" [kata]
                ^"Look Out!" [shuji]
            }
            RANK 4 {
                SKILL_GROUP "Social Skills"
                SKILL "Government"
                SKILL "Medicine"
                SKILL "Theology"
                TECHNIQUE_GROUP "Rank 1-4 Rituals"
                ^"Restorative Transmutation" [ritual]
                ^"Pillar of Calm" [shuji]
            }
            RANK 5 {
                SKILL_GROUP "Social Skills"
                SKILL "Culture"
                SKILL "Medicine"
                SKILL "Theology"
                TECHNIQUE_GROUP "Rank 1-5 Shūji"
                ^"Mentor's Guidance" [shuji]
                ^"Void Embrace Style" [kata]
            }
            RANK 6 {
                ^"Swift Creation"
            }
        }

    }

    ^"Ivory Kingdoms Sage Tradition" DEF {
        EXTENDS #L5R252wX4yZ6aB8cD0eF2g ^"School"
        APPLIES TO [^"Gaijin"]

        # Individuals so tuned to their inner energy (lojas) that
        # they can infuse others with it. They go on long
        # pilgrimages seeking truths of the world.

        PROPERTIES {
            ^"School Name" STRING "Ivory Kingdoms Sage Tradition" FIXED
            ^"Roles" LIST ["Sage", "Bushi"]
            ^"Restricted To" STRING "Ivory Kingdoms culture (or GM exception)"
            ^"Ring Increase" DEF {
                ^"Void" INTEGER 1
                ^"Earth" INTEGER 1
            }
            ^"Starting Skills" DEF { CHOOSE 5 [^"Composition", ^"Command", ^"Courtesy", ^"Martial Arts [Melee]", ^"Martial Arts [Unarmed]", ^"Meditation", ^"Theology"] INTEGER 1 }
            ^"Starting Honor" INTEGER DEFAULT 50
            ^"Techniques Available" LIST ["Kata", "Kihō", "Rituals"]
        }


        STARTING_TECHNIQUES {
            KIHO CHOOSE 2 [^"Cleansing Spirit", ^"Earth Needs No Eyes", ^"Earthen Fist"]
            RITUAL ^"Threshold Barrier"
        }

        SCHOOL_ABILITY "Gift of Inner Power" {
            "After you perform a check to activate one of your kihō, you can receive fatigue up to your school rank and choose another character at range 0-1. If you do, that character gains the enhancement effect of your kihō in your stead (you may still resolve the burst effect, if able). This effect persists a number of rounds equal to the amount of fatigue you received plus your ranks in Meditation. Only one character can benefit from your kihō at a time."
        }

        MASTERY_ABILITY ^"Divine Protection" {
            "You can perform the Threshold Barrier ritual as an action. When a Tainted being enters an area you have warded against it with this ritual, it suffers supernatural damage equal to your ranks in Meditation and the Prone condition."
        }
        STARTING_OUTFIT [
            "sanctified robes", "traveling clothes", "a talwar",
            "one weapon of rarity 6 or lower",
            "a map showing the route from the Ivory Kingdoms to the Sand Road",
            "traveling pack", "one item of rarity 4 or lower", "one trinket"
        ]

        CURRICULUM {
            RANK 1 {
                SKILL_GROUP "Scholar Skills"
                SKILL "Command"
                SKILL "Courtesy"
                SKILL "Fitness"
                TECHNIQUE_GROUP "Rank 1 Kihō"
                ^"Landslide Strike" [kata]
                ^"Bellow of Resolve" [shuji]
            }
            RANK 2 {
                SKILL_GROUP "Martial Skills"
                SKILL "Composition"
                SKILL "Government"
                SKILL "Sentiment"
                TECHNIQUE_GROUP "Rank 1-2 Kihō"
                ^"Rider's Haste" [kata]
                ^"Lord Hida's Grip" [kata]
            }
            RANK 3 {
                SKILL_GROUP "Martial Skills"
                SKILL "Courtesy"
                SKILL "Sentiment"
                SKILL "Theology"
                TECHNIQUE_GROUP "Rank 1-3 Kata"
                ^"Thunderous Hooves Style" [kata]
                ^"Cleansing of Coral and Gold" [ritual]
            }
            RANK 4 {
                SKILL_GROUP "Social Skills"
                SKILL "Fitness"
                SKILL "Martial Arts [Melee]"
                SKILL "Martial Arts [Unarmed]"
                TECHNIQUE_GROUP "Rank 1-4 Kihō"
                ^"Striking as Void" [kata]
                ^"Mentor's Guidance" [shuji]
            }
            RANK 5 {
                SKILL_GROUP "Social Skills"
                SKILL "Martial Arts [Melee]"
                SKILL "Martial Arts [Unarmed]"
                SKILL "Meditation"
                TECHNIQUE_GROUP "Rank 1-5 Kata"
                ^"Touch the Void Dragon" [kiho]
                ^"Buoyant Arrival" [kata]
            }
            RANK 6 {
                ^"Divine Protection"
            }
        }

    }

