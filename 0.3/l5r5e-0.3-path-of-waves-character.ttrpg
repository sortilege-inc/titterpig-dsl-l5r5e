    # ===========================
    # QUESTION 4: WHAT GETS YOUR
    # CHARACTER IN AND OUT OF TROUBLE?
    # ===========================

    ^"Question 4: Trouble" DEF {
        APPLIES TO [^"Ronin", ^"Peasant", ^"Gaijin"]

        # Choose one option that best describes your character's
        # personality. This determines an additional ring increase.

        PROPERTIES {
            ^"Question" INTEGER 4 FIXED
            ^"Question Text" STRING "What gets your character in and out of trouble?" FIXED
        }

        OPTIONS {
            "Abrasive, honest, driven" "+1 Fire"
            "Empathetic, tricky, clever" "+1 Air"
            "Gregarious, adaptable, charming" "+1 Water"
            "Patient, stoic, thorough" "+1 Earth"
            "Contemplative, self-aware, insightful" "+1 Void"
        }

        RULES {
            #L5RPW45aB2cD4eF6gH8iJ0k: q4_choose_one_ring_increase
        }
    }

    # ===========================
    # QUESTION 5: WHAT IS YOUR
    # CHARACTER'S PAST?
    # (REPLACES GIRI)
    # ===========================

    ^"The Past System" DEF {
        APPLIES TO [^"Ronin", ^"Peasant", ^"Gaijin"]

        # Ronin, peasants, and gaijin do not have the same giri
        # attribute as samurai. Instead, giri is replaced by the
        # character's past. The past represents the character's
        # history and what drove them onto the path of waves.
        # It functions mechanically similar to giri but reflects
        # the character's relationship with their former life
        # rather than duty to a lord.
        #
        # Choose or roll on the Sample Pasts table (d100).
        # The past creates problems and conflicts with ninjō.
        # If you choose the "Duty" past, you may optionally use
        # the rules for giri from the core rulebook.

        RULES {
            #L5RPW42jK9lM1nO3pQ5rS7t: past_replaces_giri_for_ronin
            #L5RPW43uV0wX2yZ4aB6cD8e: past_represents_history_on_path_of_waves
        }
    }

    TABLE "Sample Pasts" {
        ROLL "d100"
        "01-06" "Spiritual Troubles: Desecrated a shrine, ignored an oath, or crossed the Fortunes. Face curses, misfortune, and distrust."
        "07-14" "Bad Family History: Family was falsely or truly accused. Too many people know and judge you."
        "15-22" "Bad Reputation: Accused of murder, authored inappropriate work, had messy affair, engaged in thievery, or voluntarily left liege."
        "23-30" "Debts to Pay: Owe a vast sum to a person or family. Must make regular payments or face a bounty."
        "31-38" "Desertion: Left your post due to cowardice or admirable reasons. Your commander intends to bring you back."
        "39-46" "Duty: Still adhere to an ideal from clan, monastic vows, government, or family. May optionally use giri rules from core."
        "47-54" "Fallen Family Legacy: Family once had name, land, and title. You have only the name."
        "55-62" "Family in Need: Family needs money, medicine, care, attention, or rescue."
        "63-70" "Forsaken Vows: Expelled from or left a monastery. Cannot return until issues resolved."
        "71-78" "Long Path of Waves: After gempuku you explored the world. Your family seeks to take you back."
        "79-86" "Lifelong Enemy: An individual or family competes against you for the same goals."
        "87-93" "Unearned Heroism: Won a duel or contest by accident or nefarious means. The master seeks you out."
        "94-100" "Witness: You know too much and the spied-upon party wants you silent permanently."
    }

    # ===========================
    # QUESTION 6: WHAT DOES YOUR
    # CHARACTER LONG FOR?
    # ===========================

    ^"Question 6: Ninjō" DEF {
        APPLIES TO [^"Ronin", ^"Peasant", ^"Gaijin"]

        # What does your character long for, and how might their
        # past impact their ninjō? Same concept as core Q6 but
        # reframed around past instead of giri. Narrative only --
        # choose or create a ninjō. The ninjō should conflict with
        # the character's past.

        PROPERTIES {
            ^"Question" INTEGER 6 FIXED
            ^"Question Text" STRING "What does your character long for, and how might their past impact their ninjō?" FIXED
        }

        RULES {
            #L5RPW46lM3nO5pQ7rS9tU1v: q6_ninjo_conflicts_with_past
        }
    }

    TABLE "Sample Ninjō" {
        ROLL "d100"
        "01-04" "Achieve Mastery: Seek to be the best at swordplay, art, calligraphy, poetry, or other pursuit."
        "05-08" "Amass Followers: Claim to be a bandit leader, crime lord, or cult head. Need an audience."
        "09-13" "Assist the Spirits: Focus on spiritual welfare of lost or abused spirits."
        "14-18" "Atonement: Did a great wrong and must make up for it through actions."
        "19-23" "Construct a Great Work: Driven to build a masterwork gate, sculpture, painting, text, or shrine."
        "24-28" "Discover a Family Heritage: Find a lost claim to greatness -- lineage scroll, relic, or art."
        "29-33" "Enact Justice: Expose a vicious secret, reveal evidence, or get a criminal to confess."
        "34-38" "Establish a Family: Begin a grand lineage with a partner who shares the goal."
        "39-43" "Find a Lord to Serve: Regain lost status, improve station, or integrate into a foreign society."
        "44-48" "Find a Sensei: Study under great masters to become one yourself."
        "49-53" "Find True Love: Seek rare and precious true love in a world that scoffs at it."
        "54-58" "Gain Mystical Power: Seek power to change reality through study or blood magic."
        "59-63" "Kill Monsters: Destroy demons and spirits of corruption."
        "64-68" "Regain Your Home: Return to or rebuild a destroyed homeland."
        "69-73" "Personal Security: Acquire land, money, or stipend to ensure your family's future."
        "74-78" "Recover a Relic: Find a relic with cultural, monetary, or spiritual power."
        "79-83" "Build a Reputation: Spread your name throughout Rokugan to samurai and heimin alike."
        "84-88" "Tame a Great Beast: Tame terrifying creatures that harass farmers and hunters."
        "89-93" "Uncover a Conspiracy: Reveal a plot to overthrow or murder those in power."
        "94-100" "Wreak Vengeance: A villain has wronged you or someone you care about."
    }

    # ===========================
    # QUESTION 7: WHAT IS YOUR
    # CHARACTER KNOWN FOR?
    # ===========================

    ^"Question 7: Known For" DEF {
        APPLIES TO [^"Ronin", ^"Peasant", ^"Gaijin"]

        # DIFFERS FROM CORE Q7 (clan relationship).
        # In PoW, Q7 asks what the character is known for in
        # their community. Choose one path:
        #
        # Path A: Known for intentional deeds, skills, or behavior
        #   that has helped others (even if shunned about it).
        #   Gain +5 Glory.
        #
        # Path B: Known for deeds perceived as wicked, harmful,
        #   or exceptionally selfish (or at odds with culture/family).
        #   Gain +1 rank in a skill currently at 0 ranks. The skill
        #   should represent the choices that upset normal order.

        PROPERTIES {
            ^"Question" INTEGER 7 FIXED
            ^"Question Text" STRING "What is your character known for?" FIXED
        }

        OPTIONS {
            "Positive deeds, skills, or helpful behavior" "+5 Glory"
            "Wicked, harmful, or selfish deeds" "+1 rank in one skill at 0 ranks"
        }

        RULES {
            #L5RPW47wX4yZ6aB8cD0eF2g: q7_glory_or_skill_choice
        }
    }

    # ===========================
    # QUESTION 8: WHAT DOES YOUR
    # CHARACTER THINK OF BUSHIDO?
    # ===========================

    ^"Question 8: Bushido" DEF {
        APPLIES TO [^"Ronin", ^"Peasant", ^"Gaijin"]

        # DIFFERS FROM CORE Q8 (two options).
        # PoW Q8 has THREE options instead of two.
        # Also choose one tenet as paramount and one as
        # less significant (same as core).
        #
        # Option A: Staunch dedication to Bushido -> +10 Honor
        # Option B: Values diverge from Bushido -> gain one item
        #   of rarity 5 or lower
        # Option C: Know little about Bushido (gaijin option) ->
        #   +1 rank in one of: Commerce, Labor, Medicine,
        #   Seafaring, Skulduggery, or Survival

        PROPERTIES {
            ^"Question" INTEGER 8 FIXED
            ^"Question Text" STRING "What does your character think of Bushido?" FIXED
        }

        OPTIONS {
            "Staunch dedication to Bushido" "+10 Honor"
            "Values diverge from Bushido" "Gain one item of rarity 5 or lower"
            "Know little about Bushido" "+1 rank in one skill: Commerce, Labor, Medicine, Seafaring, Skulduggery, or Survival"
        }

        RULES {
            #L5RPW48hI5jK7lM9nO1pQ3r: q8_three_way_bushido_choice
        }
    }

    # ===========================
    # QUESTION 9: GREATEST ACCOMPLISHMENT
    # ===========================

    ^"Question 9: Distinction" DEF {
        APPLIES TO [^"Ronin", ^"Peasant", ^"Gaijin"]

        # What is your character's greatest accomplishment so far?
        # Same structure as core Q9. Gain one Distinction advantage.
        # May choose from core distinctions or PoW distinctions.

        PROPERTIES {
            ^"Question" INTEGER 9 FIXED
            ^"Question Text" STRING "What is your character's greatest accomplishment so far?" FIXED
            ^"Gain" STRING "One Distinction advantage"
        }

        RULES {
            #L5RPW49sT6uV8wX0yZ2aB4c: q9_gain_one_distinction
        }
    }

    # ===========================
    # QUESTION 10: WHAT HOLDS YOUR
    # CHARACTER BACK?
    # ===========================

    ^"Question 10: Adversity" DEF {
        APPLIES TO [^"Ronin", ^"Peasant", ^"Gaijin"]

        # What holds your character back most in life?
        # Same structure as core Q10. Gain one Adversity disadvantage.
        # May choose from core adversities or PoW adversities.

        PROPERTIES {
            ^"Question" INTEGER 10 FIXED
            ^"Question Text" STRING "What holds your character back most in life?" FIXED
            ^"Gain" STRING "One Adversity disadvantage"
        }

        RULES {
            #L5RPW50dE7fG9hI1jK3lM5n: q10_gain_one_adversity
        }
    }

    # ===========================
    # QUESTION 11: WHAT MAKES YOUR
    # CHARACTER FEEL AT PEACE?
    # ===========================

    ^"Question 11: Passion" DEF {
        APPLIES TO [^"Ronin", ^"Peasant", ^"Gaijin"]

        # What activity most makes your character feel at peace?
        # Same structure as core Q11. Gain one Passion advantage.
        # May choose from core passions or PoW passions.

        PROPERTIES {
            ^"Question" INTEGER 11 FIXED
            ^"Question Text" STRING "What activity most makes your character feel at peace?" FIXED
            ^"Gain" STRING "One Passion advantage"
        }

        RULES {
            #L5RPW51oP8qR0sT2uV4wX6y: q11_gain_one_passion
        }
    }

    # ===========================
    # QUESTION 12: WHAT TROUBLES
    # YOUR CHARACTER?
    # ===========================

    ^"Question 12: Anxiety" DEF {
        APPLIES TO [^"Ronin", ^"Peasant", ^"Gaijin"]

        # What concern, fear, or foible troubles your character most?
        # Same structure as core Q12. Gain one Anxiety disadvantage.
        # May choose from core anxieties or PoW anxieties.

        PROPERTIES {
            ^"Question" INTEGER 12 FIXED
            ^"Question Text" STRING "What concern, fear, or foible troubles your character most?" FIXED
            ^"Gain" STRING "One Anxiety disadvantage"
        }

        RULES {
            #L5RPW52zA9bC1dE3fG5hI7j: q12_gain_one_anxiety
        }
    }

    # ===========================
    # QUESTION 13: WHO HAS YOUR
    # CHARACTER LEARNED MOST FROM?
    # ===========================

    ^"Question 13: Mentor" DEF {
        APPLIES TO [^"Ronin", ^"Peasant", ^"Gaijin"]

        # Who has your character learned the most from during
        # their life? Same structure as core Q13. Choose one:
        #
        # Option A: Gain one advantage related to your mentor.
        # Option B: Gain one disadvantage related to your mentor,
        #   AND +1 rank in a skill developed from that relationship.

        PROPERTIES {
            ^"Question" INTEGER 13 FIXED
            ^"Question Text" STRING "Who has your character learned the most from during their life?" FIXED
        }

        OPTIONS {
            "Positive relationship with mentor" "Gain one advantage"
            "Complicated relationship with mentor" "Gain one disadvantage AND +1 rank in one skill"
        }

        RULES {
            #L5RPW53kL0mN2oP4qR6sT8u: q13_advantage_or_disadvantage_plus_skill
        }
    }

    # ===========================
    # QUESTION 14: MOST PRIZED POSSESSION
    # ===========================

    ^"Question 14: Prized Possession" DEF {
        APPLIES TO [^"Ronin", ^"Peasant", ^"Gaijin"]

        # DIFFERS FROM CORE Q14 ("What do people notice first?").
        # PoW Q14: When all of your life can fit in a pack on your
        # back, what is the one item that matters most?
        #
        # Choose one item from starting outfit OR a single item of
        # rarity 5 or lower. If you choose an item from starting
        # outfit, you may add the Ceremonial or Resplendent quality.
        # Record what makes the item stand out in Personality,
        # Habits, Bonds, and Quirks.

        PROPERTIES {
            ^"Question" INTEGER 14 FIXED
            ^"Question Text" STRING "What is your character's most prized possession?" FIXED
            ^"Gain" STRING "One item (from outfit or rarity 5 or lower); may add Ceremonial or Resplendent quality"
        }

        RULES {
            #L5RPW54vW1xY3zA5bC7dE9f: q14_prized_possession_item_or_quality
        }
    }

    # ===========================
    # QUESTION 15: STRESS REACTION
    # ===========================

    ^"Question 15: Stress Reaction" DEF {
        APPLIES TO [^"Ronin", ^"Peasant", ^"Gaijin"]

        # How does your character react to stressful situations?
        # Same as core Q15 -- purely narrative. Describe a noteworthy
        # physical response during stress. Note it under Personality,
        # Habits, and Quirks. It may play a part when unmasking.

        PROPERTIES {
            ^"Question" INTEGER 15 FIXED
            ^"Question Text" STRING "How does your character react to stressful situations?" FIXED
            ^"Gain" STRING "Narrative only"
        }

        RULES {
            #L5RPW55gH2iJ4kL6mN8oP0q: q15_narrative_stress_response
        }
    }

    # ===========================
    # QUESTION 16: RELATIONSHIPS
    # ===========================

    ^"Question 16: Relationships" DEF {
        APPLIES TO [^"Ronin", ^"Peasant", ^"Gaijin"]

        # DIFFERS FROM CORE Q16 (heritage table roll).
        # PoW Q16: What are your relationships to your family,
        # the clans, peasants, and others?
        #
        # Choose one item of rarity 7 or lower that was a gift
        # from a group your character has a positive relationship
        # with. Record noteworthy history, quarrels, alliances,
        # or grievances in the Relationships section.

        PROPERTIES {
            ^"Question" INTEGER 16 FIXED
            ^"Question Text" STRING "What are your relationships to your family, the clans, peasants, and others?" FIXED
            ^"Gain" STRING "One item of rarity 7 or lower (gift from allied group)"
        }

        RULES {
            #L5RPW56rS3tU5vW7xY9zA1b: q16_relationship_item_rarity_7
        }
    }

    # ===========================
    # QUESTION 17: SHARED GROUP HISTORY
    # ===========================

    ^"Question 17: Group History" DEF {
        APPLIES TO [^"Ronin", ^"Peasant", ^"Gaijin"]

        # COMPLETELY DIFFERENT FROM CORE Q17 ("Parent's opinion").
        # PoW Q17: What shared history does your character have
        # with their group? Work with GM and group to establish
        # a shared bond/experience.
        #
        # Choose one prompt (or create with GM approval):
        # - Which PC/NPC have you gone through the unthinkable with?
        # - Which character knows a secret you'd rather forget?
        # - You owe a debt to someone in your group. To whom?
        # - You have intense feelings for someone in the group.
        # - You conquered a great beast with two other members.
        # - You are impressed/jealous of another member's skill.
        # - You share blood or history with one other member.
        #
        # After choosing, work with GM to determine an appropriate bond.

        PROPERTIES {
            ^"Question" INTEGER 17 FIXED
            ^"Question Text" STRING "What shared history does your character have with their group?" FIXED
            ^"Gain" STRING "One bond (narrative, determined with GM and group)"
        }

        RULES {
            #L5RPW57cD4eF6gH8iJ0kL2m: q17_shared_group_bond
        }
    }

    # ===========================
    # QUESTION 18: WHO RAISED YOU?
    # ===========================

    ^"Question 18: Who Raised You" DEF {
        APPLIES TO [^"Ronin", ^"Peasant", ^"Gaijin"]

        # COMPLETELY DIFFERENT FROM CORE Q18 (Samurai Heritage Table).
        # PoW Q18: Who raised your character? Record the relationship
        # with parents/guardians.
        #
        # Gain +1 rank in one skill in which your character currently
        # has 0 ranks. Determine whether parents/guardians approve
        # of this extracurricular interest or see it as a regrettable
        # deviation, and why. Record in Relationships section.

        PROPERTIES {
            ^"Question" INTEGER 18 FIXED
            ^"Question Text" STRING "Who raised your character?" FIXED
            ^"Gain" STRING "+1 rank in one skill currently at 0 ranks"
        }

        RULES {
            #L5RPW58nO5pQ7rS9tU1vW3x: q18_skill_from_upbringing
        }
    }

    # ===========================
    # QUESTION 19: PERSONAL NAME
    # ===========================

    ^"Question 19: Name" DEF {
        APPLIES TO [^"Ronin", ^"Peasant", ^"Gaijin"]

        # What is your character's personal name?
        # Same concept as core Q19. Narrative only.
        # May reference PoW name tables (pp. 228-232).

        PROPERTIES {
            ^"Question" INTEGER 19 FIXED
            ^"Question Text" STRING "What is your character's personal name?" FIXED
            ^"Gain" STRING "Narrative only"
        }

        RULES {
            #L5RPW59yZ6aB8cD0eF2gH4i: q19_choose_name
        }
    }

    # ===========================
    # QUESTION 20: HOW SHOULD YOUR
    # CHARACTER DIE?
    # ===========================

    ^"Question 20: Death" DEF {
        APPLIES TO [^"Ronin", ^"Peasant", ^"Gaijin"]

        # How should your character die?
        # Same concept as core Q20. Narrative only.
        # The death of a ronin or gaijin in a foreign land is
        # not usually remarkable. Most succumb to the elements,
        # illness, or malnutrition. But your character is different.

        PROPERTIES {
            ^"Question" INTEGER 20 FIXED
            ^"Question Text" STRING "How should your character die?" FIXED
            ^"Gain" STRING "Narrative only"
        }

        RULES {
            #L5RPW60jK7lM9nO1pQ3rS5t: q20_determine_death
        }
    }

    # ===========================
    # NEW ADVANTAGES (DISTINCTIONS)
    # ===========================

    ^"Ardent Leader" DEF {
        EXTENDS #L5R266oP8qR0sT2uV4wX6y ^"Distinction"

        PROPERTIES {
            ^"Ring" STRING "Fire"
            ^"Types" LIST ["Interpersonal", "Mental"]
        }

        EFFECT {
            "You speak with confidence that most find hard to ignore, and people are more likely to hear what you have to say, even if they are of higher status."
            "When you make a check for which your ardent leadership applies (such as a Tactics [Fire] check to deploy peasants or a Courtesy [Fire] check to excite someone into believing your plan), you may reroll up to two dice."
        }
    }

    ^"Dashing Scar" DEF {
        EXTENDS #L5R266oP8qR0sT2uV4wX6y ^"Distinction"

        PROPERTIES {
            ^"Ring" STRING "Air"
            ^"Types" LIST ["Interpersonal"]
        }

        EFFECT {
            "You have a scar or visible mark that adds to your heroic reputation. People who see it nearly always remember you positively."
            "When performing a check for which your scar could act as an asset (such as a Command [Air] check to speak with authority or a Skulduggery [Air] check to accentuate roguish charm), you may reroll up to two dice."
        }
    }

    ^"Lucky Hunter" DEF {
        EXTENDS #L5R266oP8qR0sT2uV4wX6y ^"Distinction"

        PROPERTIES {
            ^"Ring" STRING "Void"
            ^"Types" LIST ["Physical", "Spiritual"]
        }

        EFFECT {
            "You are exceptionally fortunate in hunting or fishing and can always identify the best spots."
            "When performing a check related to hunting, trapping, or fishing (such as a Survival [Void] check to locate hiding quarry or a Seafaring [Void] check to determine best fishing time), you may reroll up to two dice."
        }
    }

    ^"Scrappy" DEF {
        EXTENDS #L5R266oP8qR0sT2uV4wX6y ^"Distinction"

        PROPERTIES {
            ^"Ring" STRING "Fire"
            ^"Types" LIST ["Mental", "Physical"]
        }

        EFFECT {
            "You have experience street fighting and brawling. You know how to stealthily employ dishonorable tactics."
            "When performing a check during combat to use dishonorable tactics (such as a Sentiment [Fire] check to determine how to offend someone or a Martial Arts [Fire] check to unnerve your foe), you may reroll up to two dice."
        }
    }

    ^"Scrounger" DEF {
        EXTENDS #L5R266oP8qR0sT2uV4wX6y ^"Distinction"

        PROPERTIES {
            ^"Ring" STRING "Water"
            ^"Types" LIST ["Interpersonal", "Mental"]
        }

        EFFECT {
            "You are always able to find something to fill your belly and sustain you, though sometimes the only option is repulsive."
            "When performing a check for which your resourceful nature applies (such as a Labor [Water] check to find useful items or an Aesthetics [Water] check to find inspiration), you may reroll up to two dice."
        }
    }

    ^"Urbane and Worldly" DEF {
        EXTENDS #L5R266oP8qR0sT2uV4wX6y ^"Distinction"

        PROPERTIES {
            ^"Ring" STRING "Void"
            ^"Types" LIST ["Interpersonal", "Physical"]
        }

        EFFECT {
            "Your experience traveling abroad has prepared you to expertly emulate and adapt to unfamiliar customs."
            "When observing an unfamiliar cultural practice (such as a Performance [Void] check to emulate local customs or a Commerce [Void] check to feign awareness during negotiation), you may reroll up to two dice."
        }
    }

    # ===========================
    # NEW ADVANTAGES (PASSIONS)
    # ===========================

    ^"Attention" DEF {
        EXTENDS #L5R267zA9bC1dE3fG5hI7j ^"Passion"

        PROPERTIES {
            ^"Ring" STRING "Fire"
            ^"Types" LIST ["Mental"]
        }

        EFFECT {
            "At the start of each scene, you can determine the most effective way to gain attention."
            "After performing a check to capture attention (such as a Performance [Fire] check to entice a merchant or a Games [Fire] check to draw a crowd), you remove 3 strife."
        }
    }

    ^"Honest Work" DEF {
        EXTENDS #L5R267zA9bC1dE3fG5hI7j ^"Passion"

        PROPERTIES {
            ^"Ring" STRING "Earth"
            ^"Types" LIST ["Mental", "Interpersonal"]
        }

        EFFECT {
            "You can always determine how much work is needed for a physical task, and your work is always markedly better than others."
            "After performing a check requiring physical labor (such as a Labor [Earth] check to till a field or a Smithing [Earth] check to fix a tool), you remove 3 strife."
        }
    }

    ^"Passion for [Foreign Performing Art Form]" DEF {
        EXTENDS #L5R267zA9bC1dE3fG5hI7j ^"Passion"

        PROPERTIES {
            ^"Ring" STRING "Air"
            ^"Types" LIST ["Fame", "Interpersonal"]
        }

        EFFECT {
            "You are skilled in a foreign artistry (puppetry, miming, foreign dance, foreign instrument) and recognize common forms and intricate historical details."
            "After performing a check related to your talent (such as Performance [Air] to impress or Design [Air] to refine craft), you remove 3 strife."
        }
    }

    # ===========================
    # NEW DISADVANTAGES (ADVERSITIES)
    # ===========================

    ^"Bullheaded" DEF {
        EXTENDS #L5R268kL0mN2oP4qR6sT8u ^"Adversity"

        PROPERTIES {
            ^"Ring" STRING "Earth"
            ^"Types" LIST ["Mental"]
        }

        EFFECT {
            "When pursuing a goal related to your ninjō, you have difficulty focusing on anything unrelated."
            "When you make a check related to your goal that requires planning, subtlety, or nuance (such as Culture [Earth] to recall proper introductions or Courtesy [Earth] to reason with a stubborn merchant), you must choose and reroll two dice containing success or explosion. If you failed, gain 1 Void point."
        }
    }

    ^"Debt to [Person or Organization]" DEF {
        EXTENDS #L5R268kL0mN2oP4qR6sT8u ^"Adversity"

        PROPERTIES {
            ^"Ring" STRING "Water"
            ^"Types" LIST ["Interpersonal"]
        }

        EFFECT {
            "You are in terrible debt. If you fail to make regular payments or fulfill obligations, your debtor will hunt you down."
            "When making a check related to dodging or worsening debt (such as Commerce [Water] to purchase something unnecessary or Courtesy [Water] to get a loan), you must choose and reroll two dice containing success or explosion. If you failed, gain 1 Void point."
        }
    }

    ^"Encompassing Duty" DEF {
        EXTENDS #L5R268kL0mN2oP4qR6sT8u ^"Adversity"

        PROPERTIES {
            ^"Ring" STRING "Earth"
            ^"Types" LIST ["Mental"]
        }

        EFFECT {
            "You have a duty to something (family, friend, cause). You have difficulty relaxing or focusing on unrelated tasks."
            "When making a check related to overcoming hindrance to your duty (such as Meditation [Earth] to stay calm in ambush or Courtesy [Earth] to reason with stubborn shopkeeper), you must choose and reroll two dice containing success or explosion. If you failed, gain 1 Void point."
        }
    }

    ^"Horrible Scar" DEF {
        EXTENDS #L5R268kL0mN2oP4qR6sT8u ^"Adversity"

        PROPERTIES {
            ^"Ring" STRING "Air"
            ^"Types" LIST ["Interpersonal", "Mental"]
        }

        EFFECT {
            "You have an awful scar that hinders interactions. People stare, treat you unfairly, and judge you."
            "When performing a check to interact socially with a stranger (such as Courtesy [Air] to request information or Sentiment [Air] to calm someone), you must choose and reroll two dice containing success or explosion. If you failed, gain 1 Void point."
        }
    }

    ^"Many Mouths" DEF {
        EXTENDS #L5R268kL0mN2oP4qR6sT8u ^"Adversity"

        PROPERTIES {
            ^"Ring" STRING "Earth"
            ^"Types" LIST ["Interpersonal", "Mental"]
        }

        EFFECT {
            "You must provide for many dependents beyond your means."
            "When performing a check related to providing food, money, or care (such as Labor [Earth] to produce food or Sentiment [Earth] to soothe loved ones), you must choose and reroll two dice containing success or explosion. If you failed, gain 1 Void point."
        }
    }

    ^"Pursued by [Individual or Group]" DEF {
        EXTENDS #L5R268kL0mN2oP4qR6sT8u ^"Adversity"

        PROPERTIES {
            ^"Ring" STRING "Water"
            ^"Types" LIST ["Interpersonal", "Mental"]
        }

        EFFECT {
            "A pursuer wishes to capture or kill you. You have difficulty relaxing in public."
            "When making a check that draws attention in public (such as Commerce [Water] to trade at market or Courtesy [Water] to win favor at court), you must choose and reroll two dice containing success or explosion. If you failed, gain 1 Void point."
        }
    }

    ^"Stained Lineage" DEF {
        EXTENDS #L5R268kL0mN2oP4qR6sT8u ^"Adversity"

        PROPERTIES {
            ^"Ring" STRING "Void"
            ^"Types" LIST ["Interpersonal", "Mental"]
        }

        EFFECT {
            "Your family has a bad reputation. Most people in your region know and make negative assumptions about you."
            "When making a check to interact with anyone from your home region (such as Commerce [Void] to trade without drawing attention or Courtesy [Void] to warn of danger), you must choose and reroll two dice containing success or explosion. If you failed, gain 1 Void point."
        }
    }

    # ===========================
    # NEW DISADVANTAGES (ANXIETIES)
    # ===========================

    ^"Coming Storm" DEF {
        EXTENDS #L5R269vW1xY3zA5bC7dE9f ^"Anxiety"

        PROPERTIES {
            ^"Ring" STRING "Void"
            ^"Types" LIST ["Mental"]
        }

        EFFECT {
            "Your family has endured great recurring hardship. You are constantly vigilant for the same type of calamity."
            "When performing a check involving planning for your or your family's well-being (such as Medicine [Void] to sense ailment or Command [Void] to warn of risk), you receive 3 strife. If this is the first time this scene, gain 1 Void point."
        }
    }

    ^"Eyes of Many" DEF {
        EXTENDS #L5R269vW1xY3zA5bC7dE9f ^"Anxiety"

        PROPERTIES {
            ^"Ring" STRING "Air"
            ^"Types" LIST ["Mental"]
        }

        EFFECT {
            "You constantly worry that others are watching and judging you. You are unable to relax in crowded places."
            "After performing a check in a crowded place or where two or more strangers actively listen (such as Courtesy [Air] to lie to employer or Fitness [Air] to avoid notice), you receive 3 strife. If this is the first time this scene, gain 1 Void point."
        }
    }

    ^"Failure" DEF {
        EXTENDS #L5R269vW1xY3zA5bC7dE9f ^"Anxiety"

        PROPERTIES {
            ^"Ring" STRING "Water"
            ^"Types" LIST ["Mental"]
        }

        EFFECT {
            "You constantly worry about failing those to whom you have commitments."
            "After performing a check that shirks obligations or works against a promise (such as Courtesy [Water] to socialize pointlessly or Games [Water] to gamble needlessly), you receive 3 strife. If this is the first time this scene, gain 1 Void point."
        }
    }

    ^"Fear of Stagnation" DEF {
        EXTENDS #L5R269vW1xY3zA5bC7dE9f ^"Anxiety"

        PROPERTIES {
            ^"Ring" STRING "Earth"
            ^"Types" LIST ["Mental"]
        }

        EFFECT {
            "Staying in one place frustrates you. You fear relational commitments that tie you down."
            "After performing a check to continue a prolonged task (such as Labor [Earth] to work on same project for more than two days or Courtesy [Earth] to arrange yet another night in the same city), you receive 3 strife. If this is the first time this scene, gain 1 Void point."
        }
    }

    # ===========================
    # NEW ROLE: SAGE
    # ===========================

    ^"Sage Role" DEF {
        APPLIES TO [^"Ronin", ^"Peasant", ^"Gaijin"]

        # Like shugenja, sages wield special powers, but theirs
        # are bestowed by other means, usually outside the
        # bounds of what is considered appropriate in Rokugan.
        # A sage may wield powers granted by gods that rule
        # in lands outside the Empire's borders, or they may
        # use techniques such as kihō in unfamiliar ways.

        RULES {
            #L5RPW44fG1hI3jK5lM7nO9p: sage_role_non_rokugani_powers
        }
    }

    # ===========================
    # SCHOOL ROLE EXTENSION
    # ===========================

    MODIFY ^"School Role" {
        ENUM EXTEND ["Sage", "Artisan"]
        # Path of Waves introduces two new school roles for gaijin and ronin traditions
    }
}
