EXTENSION "L5R5e_Path_of_Waves_Character" EXTENDS "L5R5e_Core_Character" {
    NAME "Legend of the Five Rings 5th Edition - Path of Waves: Character Creation"
    VERSION "0.3"
    RELEASE_DATE "2026-03-01"

    # Path of Waves (Chapter 2): A revised Game of Twenty Questions
    # for ronin, peasant, and gaijin characters. Replaces clan/family
    # with region/upbringing. Replaces giri with "past". Introduces
    # new schools, advantages, disadvantages, and gaijin cultures.
    # This extension supplements and partially overrides the core
    # character creation system to support non-samurai PCs.

    # ===========================
    # REVISED TWENTY QUESTIONS
    # ===========================

    # The Path of Waves twenty questions replace the core
    # rulebook's twenty questions for ronin, peasant, and
    # gaijin characters. Key differences:
    # - Question 1 uses Region instead of Clan
    # - Question 2 uses Upbringing instead of Family
    # - Question 3 uses new school options
    # - Giri is replaced by Past (Question 5)
    # - Ninjō remains but is reframed around Past (Question 6)
    # - Question 7 has different flavor (positive deeds vs selfish actions)
    # - Question 8 has THREE options (Orthodox, Divergent, Ignorant) instead of two
    # - Question 14 is "Most prized possession" instead of "What do people notice first?"
    # - Question 17 is "Shared group history" instead of "Parent's opinion"
    # - Question 18 is "Who raised you? (+1 skill)" instead of heritage table
    # - Status starts lower (ronin 24, peasant 15, gaijin 0)
    # - Glory represents personal reputation, not Bushido adherence

    # ===========================
    # NEW ENTITY TYPES
    # ===========================

    ^"Ronin" DEF {
        EXTENDS #L5R003xY4zA6bC8dE0fG2hI ^"Samurai"
        # Masterless samurai who walk the Path of Waves.
        # Ronin retain samurai social standing but lack
        # a lord, clan, or formal family backing.
    }

    ^"Gaijin" DEF {
        EXTENDS #L5R001aB2cD4eF6gH8iJ0kL ^"Entity"
        # Foreigners from outside Rokugan: Ujik nomads,
        # Qamarist scholars, Ivory Kingdoms warriors, etc.
        # Begin with Status 0 in Rokugan. May have a
        # second status value for their homeland.
    }

    # ===========================
    # PATH OF WAVES CHARACTER CREATION
    # ===========================

    ^"Path of Waves Character Creation" DEF {
        APPLIES TO [^"Ronin", ^"Peasant", ^"Gaijin"]

        # Limits: rings and skills have a maximum rank of 3
        # during character creation. Starting values: 1 rank
        # in each ring, 0 ranks in each skill.

        RULES {
            #L5RPW01aB2cD4eF6gH8iJ0k: pow_rings_max_3_during_creation
            #L5RPW02lM3nO5pQ7rS9tU1v: pow_skills_max_3_during_creation
            #L5RPW03wX4yZ6aB8cD0eF2g: pow_ronin_base_status_24
            #L5RPW04hI5jK7lM9nO1pQ3r: pow_peasant_base_status_15
            #L5RPW05sT6uV8wX0yZ2aB4c: pow_gaijin_base_status_0
            #L5RPW06dE7fG9hI1jK3lM5n: pow_giri_replaced_by_past
            #L5RPW07oP8qR0sT2uV4wX6y: pow_glory_represents_personal_reputation
        }
    }

    # ===========================
    # QUESTION 1: REGIONS
    # ===========================

    ^"Urban Region" DEF {
        APPLIES TO [^"Ronin", ^"Peasant"]

        # Cities are places where trade flourishes, cultures meet,
        # and many different types of people mix and mingle.

        PROPERTIES {
            ^"Region" STRING "Urban" FIXED
            ^"Ring Increase" DEF { ^"Air" INTEGER 1 }
            ^"Skill Increase" STRING "+1 Commerce"
            ^"Glory" INTEGER DEFAULT 29
        }

        RULES {
            #L5RPW08zA9bC1dE3fG5hI7j: urban_political_awareness
            #L5RPW09kL0mN2oP4qR6sT8u: urban_cosmopolitan_connections
        }
    }

    ^"Rural Farmland Region" DEF {
        APPLIES TO [^"Ronin", ^"Peasant"]

        # Food is the core of any prosperous civilization.
        # Farmers tame the land and carry the weight of
        # civilization on their backs.

        PROPERTIES {
            ^"Region" STRING "Rural Farmland" FIXED
            ^"Ring Increase" DEF { ^"Earth" INTEGER 1 }
            ^"Skill Increase" STRING "+1 Fitness"
            ^"Glory" INTEGER DEFAULT 34
        }

        RULES {
            #L5RPW10vW1xY3zA5bC7dE9f: rural_oral_tradition
            #L5RPW11gH2iJ4kL6mN8oP0q: rural_agricultural_knowledge
        }
    }

    ^"Sea River or Lake Region" DEF {
        APPLIES TO [^"Ronin", ^"Peasant"]

        # The sea provides and takes away in equal measure.
        # Water has strong ties to trade and travel.

        PROPERTIES {
            ^"Region" STRING "Sea, River, or Lake" FIXED
            ^"Ring Increase" DEF { ^"Water" INTEGER 1 }
            ^"Skill Increase" STRING "+1 Seafaring"
            ^"Glory" INTEGER DEFAULT 32
        }

        RULES {
            #L5RPW12rS3tU5vW7xY9zA1b: sea_trade_route_awareness
            #L5RPW13cD4eF6gH8iJ0kL2m: sea_water_survival_skills
        }
    }

    ^"Forest Region" DEF {
        APPLIES TO [^"Ronin", ^"Peasant"]

        # Forests are wildernesses with trees more ancient
        # than Rokugan itself. Those who live among the trees
        # absorb a bit of that wildness into themselves.

        PROPERTIES {
            ^"Region" STRING "Forest" FIXED
            ^"Ring Increase" DEF { ^"Earth" INTEGER 1 }
            ^"Skill Increase" STRING "+1 Survival"
            ^"Glory" INTEGER DEFAULT 30
        }

        RULES {
            #L5RPW14nO5pQ7rS9tU1vW3x: forest_navigation_instincts
            #L5RPW15yZ6aB8cD0eF2gH4i: forest_foraging_hunting_knowledge
        }
    }

    ^"Mountain Region" DEF {
        APPLIES TO [^"Ronin", ^"Peasant"]

        # In the mountains, the peaks reach to the Heavens.
        # This environment is perfect for monks and those
        # seeking Enlightenment.

        PROPERTIES {
            ^"Region" STRING "Mountain" FIXED
            ^"Ring Increase" DEF { ^"Void" INTEGER 1 }
            ^"Skill Increase" STRING "+1 Meditation"
            ^"Glory" INTEGER DEFAULT 33
        }

        RULES {
            #L5RPW16jK7lM9nO1pQ3rS5t: mountain_trail_pilgrimage_knowledge
            #L5RPW17uV8wX0yZ2aB4cD6e: mountain_extreme_survival
        }
    }

    ^"Haunted Region" DEF {
        APPLIES TO [^"Ronin", ^"Peasant"]

        # Lands affected by the Taint or otherwise desecrated
        # by foul acts. Those who hail from such regions view
        # the world as a much more dangerous place.

        PROPERTIES {
            ^"Region" STRING "Haunted" FIXED
            ^"Ring Increase" DEF { ^"Fire" INTEGER 1 }
            ^"Skill Increase" STRING "+1 Command"
            ^"Glory" INTEGER DEFAULT 28
        }

        RULES {
            #L5RPW18fG9hI1jK3lM5nO7p: haunted_taint_recognition
            #L5RPW19qR0sT2uV4wX6yZ8a: haunted_pragmatism_against_supernatural
        }
    }

    # ===========================
    # GAIJIN REGIONAL OPTIONS
    # ===========================

    # Gaijin begin with status 0 in Rokugan. They also
    # have a second status value reflecting standing in
    # their homeland, determined with GM during creation.

    ^"Ujik of the Plains of Wind and Stone" DEF {
        APPLIES TO [^"Gaijin"]

        # The Ujik are a nomadic people living on expansive
        # grassy plains north and west of Rokugan. They are
        # supreme horsemen; Ujik begin play with a Unicorn
        # warhorse.

        PROPERTIES {
            ^"Region" STRING "Ujik (Plains of Wind and Stone)" FIXED
            ^"Culture" STRING "Gaijin - Ujik"
            ^"Ring Increase" DEF { ^"Water" INTEGER 1 }
            ^"Skill Increase" STRING "+1 Survival"
            ^"Glory" INTEGER DEFAULT 30
            ^"Starting Equipment Note" STRING "Ujik begin play with a Unicorn warhorse"
        }

        RULES {
            #L5RPW20bC1dE3fG5hI7jK9l: ujik_expert_horsemen
            #L5RPW21mN2oP4qR6sT8uV0w: ujik_lords_of_death_religion
        }
    }

    ^"Qamarists in the Cradle of the World" DEF {
        APPLIES TO [^"Gaijin"]

        # The Qamarist Caliphate is a powerful nation-state
        # far to the west, thriving in fertile land between two
        # great rivers. They practice a monotheistic religion
        # and possess advanced alchemical knowledge.

        PROPERTIES {
            ^"Region" STRING "Qamarist (Cradle of the World)" FIXED
            ^"Culture" STRING "Gaijin - Qamarist"
            ^"Ring Increase" DEF { ^"Fire" INTEGER 1 }
            ^"Skill Increase" STRING "+1 Theology"
            ^"Glory" INTEGER DEFAULT 29
        }

        RULES {
            #L5RPW22xY3zA5bC7dE9fG1h: qamarist_monotheistic_caliphate
            #L5RPW23iJ4kL6mN8oP0qR2s: qamarist_alchemical_knowledge
        }
    }

    ^"Yodha of the Ghostlands" DEF {
        APPLIES TO [^"Gaijin"]

        # Warriors from the Ivory Kingdoms who wage a
        # never-ending struggle against evil forces in the
        # Ghostlands (the western Shadowlands). They use
        # gold and coral against Tainted beings.

        PROPERTIES {
            ^"Region" STRING "Yodha (Ghostlands)" FIXED
            ^"Culture" STRING "Gaijin - Ivory Kingdoms"
            ^"Ring Increase" DEF { ^"Earth" INTEGER 1 }
            ^"Skill Increase" STRING "+1 Theology"
            ^"Glory" INTEGER DEFAULT 29
        }

        RULES {
            #L5RPW24tU5vW7xY9zA1bC3d: yodha_ghostlands_shadowlands_fighters
            #L5RPW25eF6gH8iJ0kL2mN4o: yodha_gold_coral_against_taint
        }
    }

    ^"Sheelavaan of Bhavyatapura" DEF {
        APPLIES TO [^"Gaijin"]

        # The people of the City of Splendor in the central
        # Ivory Kingdoms. Sophisticated, gregarious, eloquent,
        # and skilled at bargaining through complex economies.

        PROPERTIES {
            ^"Region" STRING "Sheelavaan (Bhavyatapura)" FIXED
            ^"Culture" STRING "Gaijin - Ivory Kingdoms"
            ^"Ring Increase" DEF { ^"Air" INTEGER 1 }
            ^"Skill Increase" STRING "+1 Courtesy"
            ^"Glory" INTEGER DEFAULT 28
        }

        RULES {
            #L5RPW26pQ7rS9tU1vW3xY5z: sheelavaan_urban_sophistication
            #L5RPW27aB8cD0eF2gH4iJ6k: sheelavaan_trade_and_languages
        }
    }

    # ===========================
    # QUESTION 2: UPBRINGINGS
    # ===========================

    ^"Craftsperson Upbringing" DEF {
        APPLIES TO [^"Ronin", ^"Peasant", ^"Gaijin"]

        PROPERTIES {
            ^"Upbringing" STRING "Craftsperson" FIXED
            ^"Ring Increase" DEF { CHOOSE 1 [^"Earth", ^"Void"] INTEGER 1 }
            ^"Skill Increases" DEF {
                ^"Culture" INTEGER 1
                ^"Design" INTEGER 1
            }
            ^"Status Modification" INTEGER -2
            ^"Starting Wealth" INTEGER 1
        }
    }

    ^"Fallen Noble Upbringing" DEF {
        APPLIES TO [^"Ronin", ^"Peasant", ^"Gaijin"]

        # A fallen noble may use ring and skill increases
        # based on their chosen clan, or +1 to any ring and
        # +1 to any two skills. Begins with a wakizashi or
        # gaijin equivalent.

        PROPERTIES {
            ^"Upbringing" STRING "Fallen Noble" FIXED
            ^"Ring Increase" DEF {
                FROM_CLAN ^"<Chosen Clan>"."Clan Ring Bonus" FALLBACK {
                    CHOOSE 1 [^"Air", ^"Earth", ^"Fire", ^"Water", ^"Void"] INTEGER 1
                }
            }
            ^"Skill Increases" DEF {
                FROM_CLAN ^"<Chosen Clan>"."Clan Skill Bonus" FALLBACK {
                    CHOOSE DISTINCT 2 [
                        ^"Aesthetics", ^"Command", ^"Commerce", ^"Composition",
                        ^"Courtesy", ^"Culture", ^"Design", ^"Fitness",
                        ^"Games", ^"Government", ^"Labor", ^"Martial Arts [Melee]",
                        ^"Martial Arts [Ranged]", ^"Martial Arts [Unarmed]", ^"Medicine", ^"Meditation",
                        ^"Performance", ^"Seafaring", ^"Sentiment", ^"Skulduggery",
                        ^"Smithing", ^"Survival", ^"Tactics", ^"Theology"
                    ] INTEGER 1
                }
            }
            ^"Status Modification" INTEGER 10
            ^"Starting Wealth" DEF {
                ^"Heirloom" DEF { ^"Koku" INTEGER 3 }
                ^"Wakizashi" INTEGER 1   # or gaijin equivalent
            }
        }
    }

    ^"Farmer Upbringing" DEF {
        APPLIES TO [^"Ronin", ^"Peasant", ^"Gaijin"]

        PROPERTIES {
            ^"Upbringing" STRING "Farmer" FIXED
            ^"Ring Increase" DEF { CHOOSE 1 [^"Earth", ^"Water"] INTEGER 1 }
            ^"Skill Increases" DEF {
                ^"Labor" INTEGER 1
                ^"Fitness" INTEGER 1
            }
            ^"Status Modification" INTEGER 4
            ^"Starting Wealth" DEF { ^"Bu" INTEGER 2 }
        }
    }

    ^"Geisha House Upbringing" DEF {
        APPLIES TO [^"Ronin", ^"Peasant", ^"Gaijin"]

        PROPERTIES {
            ^"Upbringing" STRING "Geisha House" FIXED
            ^"Ring Increase" DEF { CHOOSE 1 [^"Air", ^"Fire"] INTEGER 1 }
            ^"Skill Increases" DEF {
                ^"Aesthetics" INTEGER 1
                ^"Courtesy" INTEGER 1
            }
            ^"Status Modification" INTEGER -20
            ^"Starting Wealth" INTEGER 3
        }
    }

    ^"Hinin Upbringing" DEF {
        APPLIES TO [^"Ronin", ^"Peasant", ^"Gaijin"]

        PROPERTIES {
            ^"Upbringing" STRING "Hinin" FIXED
            ^"Ring Increase" DEF { CHOOSE 1 [^"Water", ^"Void"] INTEGER 1 }
            ^"Skill Increases" DEF {
                ^"Labor" INTEGER 2
                ^"Survival" INTEGER 1
            }
            ^"Status Modification" INTEGER -20
            ^"Starting Wealth" DEF { ^"Zeni" INTEGER 5 }
        }
    }

    ^"Hunter or Fisher Upbringing" DEF {
        APPLIES TO [^"Ronin", ^"Peasant", ^"Gaijin"]

        PROPERTIES {
            ^"Upbringing" STRING "Hunter or Fisher" FIXED
            ^"Ring Increase" DEF { CHOOSE 1 [^"Earth", ^"Water"] INTEGER 1 }
            ^"Skill Increases" DEF {
                ^"Labor" INTEGER 1
                CHOOSE 1 [^"Seafaring", ^"Survival"] INTEGER 1
            }
            ^"Status Modification" INTEGER 3
            ^"Starting Wealth" DEF { ^"Bu" INTEGER 4 }
        }
    }

    ^"Law Enforcement Upbringing" DEF {
        APPLIES TO [^"Ronin", ^"Peasant", ^"Gaijin"]

        PROPERTIES {
            ^"Upbringing" STRING "Law Enforcement" FIXED
            ^"Ring Increase" DEF { CHOOSE 1 [^"Earth", ^"Air"] INTEGER 1 }
            ^"Skill Increases" DEF {
                ^"Government" INTEGER 1
                ^"Command" INTEGER 1
            }
            ^"Status Modification" INTEGER 5
            ^"Starting Wealth" INTEGER 1
        }
    }

    ^"Military Upbringing" DEF {
        APPLIES TO [^"Ronin", ^"Peasant", ^"Gaijin"]

        PROPERTIES {
            ^"Upbringing" STRING "Military" FIXED
            ^"Ring Increase" DEF { CHOOSE 1 [^"Earth", ^"Fire"] INTEGER 1 }
            ^"Skill Increases" DEF {
                ^"Command" INTEGER 1
                ^"Government" INTEGER 1
            }
            ^"Status Modification" INTEGER 5
            ^"Starting Wealth" INTEGER 1
        }
    }

    ^"Ronin Family Upbringing" DEF {
        APPLIES TO [^"Ronin", ^"Peasant", ^"Gaijin"]

        PROPERTIES {
            ^"Upbringing" STRING "Ronin Family" FIXED
            ^"Ring Increase" DEF { CHOOSE 1 [^"Air", ^"Earth", ^"Fire", ^"Water", ^"Void"] INTEGER 1 }
            ^"Skill Increases" DEF {
                ^"Courtesy" INTEGER 1
                ^"Martial Arts [Melee]" INTEGER 1
            }
            ^"Status Modification" INTEGER 2
            ^"Starting Wealth" INTEGER 1
        }
    }

    ^"Organized Crime Upbringing" DEF {
        APPLIES TO [^"Ronin", ^"Peasant", ^"Gaijin"]

        PROPERTIES {
            ^"Upbringing" STRING "Organized Crime" FIXED
            ^"Ring Increase" DEF { CHOOSE 1 [^"Air", ^"Water"] INTEGER 1 }
            ^"Skill Increases" DEF {
                ^"Skulduggery" INTEGER 1
                ^"Games" INTEGER 1
            }
            ^"Status Modification" INTEGER -8
            ^"Starting Wealth" INTEGER 3
        }
    }

    ^"Street Urchin Upbringing" DEF {
        APPLIES TO [^"Ronin", ^"Peasant", ^"Gaijin"]

        PROPERTIES {
            ^"Upbringing" STRING "Street Urchin" FIXED
            ^"Ring Increase" DEF { CHOOSE 1 [^"Air", ^"Fire"] INTEGER 1 }
            ^"Skill Increases" DEF { ^"Skulduggery" INTEGER 2 }
            ^"Status Modification" INTEGER -7
            ^"Starting Wealth" DEF { ^"Bu" INTEGER 4 }
        }
    }

    ^"Temple Upbringing" DEF {
        APPLIES TO [^"Ronin", ^"Peasant", ^"Gaijin"]

        PROPERTIES {
            ^"Upbringing" STRING "Temple" FIXED
            ^"Ring Increase" DEF { CHOOSE 1 [^"Void", ^"Air"] INTEGER 1 }
            ^"Skill Increases" DEF {
                ^"Theology" INTEGER 1
                ^"Courtesy" INTEGER 1
            }
            ^"Status Modification" INTEGER 11
            ^"Starting Wealth" DEF { ^"Day's Rations" INTEGER 1 }
        }
    }

    ^"Tradesperson Upbringing" DEF {
        APPLIES TO [^"Ronin", ^"Peasant", ^"Gaijin"]

        PROPERTIES {
            ^"Upbringing" STRING "Tradesperson" FIXED
            ^"Ring Increase" DEF { CHOOSE 1 [^"Air", ^"Water"] INTEGER 1 }
            ^"Skill Increases" DEF {
                ^"Commerce" INTEGER 1
                ^"Aesthetics" INTEGER 1
            }
            ^"Status Modification" INTEGER -6
            ^"Starting Wealth" INTEGER 2
        }
    }

    # ===========================
    # QUESTION 3: SCHOOLS
    # ===========================

    # --- General Schools (open to all PoW characters) ---

    ^"Wandering Blade" DEF {
        EXTENDS #L5R252wX4yZ6aB8cD0eF2g ^"School"
        APPLIES TO [^"Ronin", ^"Peasant", ^"Gaijin"]

        # Warriors who have honed their skill with a signature
        # weapon. Their power and skill rival the training of
        # even samurai of the Great Clans.

        PROPERTIES {
            ^"School Name" STRING "Wandering Blade" FIXED
            ^"Roles" LIST ["Bushi"]
            ^"Ring Increase" DEF {
                ^"Earth" INTEGER 1
                CHOOSE 1 [^"Air", ^"Fire", ^"Water", ^"Void"] INTEGER 1
            }
            ^"Starting Skills" DEF { CHOOSE 5 [^"Fitness", ^"Martial Arts [Melee]", ^"Martial Arts [Ranged]", ^"Martial Arts [Unarmed]", ^"Meditation", ^"Performance", ^"Smithing"] INTEGER 1 }
            ^"Starting Honor" INTEGER DEFAULT 35
            ^"Techniques Available" LIST ["Kata", "Rituals", "Shūji"]
        }


        STARTING_TECHNIQUES {
            KATA CHOOSE 1 [^"Striking as Air", ^"Striking as Earth", ^"Striking as Water", ^"Striking as Fire"]
            SHUJI ^"Wanderer's Resolve"
        }

        SCHOOL_ABILITY "Signature Weapon" {
            "Choose a signature weapon category (or unarmed) with GM approval. When using a weapon from this category for an Attack action or Performance check, roll one additional skill die. Additionally, when making such a check you may suffer fatigue up to your school rank to alter that many results of your kept dice to (op) results."
        }

        MASTERY_ABILITY ^"Unseen Blade" {
            "When you perform an Attack action, you may spend (op)+ as follows: Choose a character in range of the weapon you used with vigilance lower than your original target. If you succeed, that character suffers physical damage equal to your weapon's base damage plus your ranks in Fitness."
        }
        STARTING_OUTFIT [
            "traveling clothes",
            "any one weapon of your signature weapon category of rarity 8 or lower (with GM approval)",
            "any two items of rarity 4 or lower", "one trinket"
        ]

        CURRICULUM {
            RANK 1 {
                SKILL_GROUP "Martial Skills"
                SKILL "Commerce"
                SKILL "Medicine"
                SKILL "Sentiment"
                TECHNIQUE_GROUP "Rank 1 Kata"
                ^"Bellow of Resolve" [shuji]
                ^"Tactical Assessment" [shuji]
            }
            RANK 2 {
                SKILL_GROUP "Martial Skills"
                SKILL "Courtesy"
                SKILL "Smithing"
                SKILL "Survival"
                TECHNIQUE_GROUP "Rank 1-2 Kata"
                ^"Rushing Ox Style" [kata]
                ^"Wayfarer's Path" [shuji]
            }
            RANK 3 {
                SKILL_GROUP "Trade Skills"
                SKILL "Command"
                SKILL "Culture"
                SKILL "Meditation"
                TECHNIQUE_GROUP "Rank 1-3 Kata"
                ^"Iron in the Mountains Style" [kata]
                ^"Tonight, I Am Your Opponent" [shuji]
            }
            RANK 4 {
                SKILL_GROUP "Martial Skills"
                SKILL "Games"
                SKILL "Performance"
                SKILL "Seafaring"
                TECHNIQUE_GROUP "Rank 1-4 Kata"
                ^"Bravado" [shuji]
                ^"Void's Embrace Style" [kata]
            }
            RANK 5 {
                SKILL_GROUP "Martial Skills"
                SKILL "Command"
                SKILL "Courtesy"
                SKILL "Sentiment"
                TECHNIQUE_GROUP "Rank 1-5 Kata"
                ^"Bond of Heroes" [shuji]
                ^"Roar of Encouragement" [shuji]
            }
            RANK 6 {
                ^"Unseen Blade"
            }
        }

    }

    ^"Student of the Talon" DEF {
        EXTENDS #L5R252wX4yZ6aB8cD0eF2g ^"School"
        APPLIES TO [^"Ronin", ^"Peasant", ^"Gaijin"]

        # Adept at landing critical blows from distance with
        # spears, bows, or other ranged weapons. Precision
        # reminiscent of a viper's bite.

        PROPERTIES {
            ^"School Name" STRING "Student of the Talon" FIXED
            ^"Roles" LIST ["Bushi", "Shinobi"]
            ^"Ring Increase" DEF {
                ^"Air" INTEGER 1
                ^"Water" INTEGER 1
            }
            ^"Starting Skills" DEF { CHOOSE 5 [^"Fitness", ^"Martial Arts [Melee]", ^"Martial Arts [Ranged]", ^"Meditation", ^"Sentiment", ^"Skulduggery", ^"Survival"] INTEGER 1 }
            ^"Starting Honor" INTEGER DEFAULT 30
            ^"Techniques Available" LIST ["Kata", "Rituals", "Shūji"]
        }


        STARTING_TECHNIQUES {
            KATA CHOOSE 1 [^"Soaring Slice", ^"Hawk's Precision"]
            NINJUTSU ^"Skulk"
        }

        SCHOOL_ABILITY "Piercing Insight" {
            "Once per round, in a skirmish, when you inflict a critical strike on a character at range 2-5 or a character at range 2-5 inflicts a critical strike on you, you may increase or decrease the severity by your school rank."
        }

        MASTERY_ABILITY ^"Lesson of the Hawk" {
            "Once per scene, when performing an Attack action check, you may spend 1 Void Point to have your target treat their physical resistance as 0."
        }
        STARTING_OUTFIT [
            "traveling clothes", "any one weapon of rarity 6 or lower",
            "yumi (bow) and a quiver of arrows with three special arrows (one armor-piercing, one flesh-cutter, one humming-bulb) or yari (spear)",
            "one trinket"
        ]

        CURRICULUM {
            RANK 1 {
                SKILL_GROUP "Martial Skills"
                SKILL "Commerce"
                SKILL "Courtesy"
                SKILL "Survival"
                TECHNIQUE_GROUP "Rank 1 Kata"
                ^"Flowering Deceptions" [shuji]
                ^"Chaotic Scattering" [kata]
            }
            RANK 2 {
                SKILL_GROUP "Martial Skills"
                SKILL "Medicine"
                SKILL "Sentiment"
                SKILL "Skulduggery"
                TECHNIQUE_GROUP "Rank 1-2 Kata"
                ^"Heartpiercing Strike" [kata]
                ^"Swirling Viper Style" [kata]
            }
            RANK 3 {
                SKILL_GROUP "Social Skills"
                SKILL "Martial Arts [Melee]"
                SKILL "Martial Arts [Ranged]"
                SKILL "Skulduggery"
                TECHNIQUE_GROUP "Rank 1-3 Kata"
                ^"Wasp's Spite Style" [kata]
                ^"Eyeless Sight Shot" [kata]
            }
            RANK 4 {
                SKILL_GROUP "Martial Skills"
                SKILL "Courtesy"
                SKILL "Medicine"
                SKILL "Sentiment"
                TECHNIQUE_GROUP "Rank 1-4 Kata"
                ^"Wolf's Proposal" [shuji]
                ^"Falling Heavens Shot" [kata]
            }
            RANK 5 {
                SKILL_GROUP "Martial Skills"
                SKILL "Command"
                SKILL "Medicine"
                SKILL "Skulduggery"
                TECHNIQUE_GROUP "Rank 1-5 Kata"
                ^"Deadly Sting" [ninjutsu]
                ^"Watch My Back" [shuji]
            }
            RANK 6 {
