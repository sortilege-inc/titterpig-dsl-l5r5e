    #L5RPW40nO5pQ7rS9tU1vW3x ^"Treasure Hunter" DEF {
        EXTENDS #L5R252wX4yZ6aB8cD0eF2g ^"School"
        APPLIES TO [^"Ronin", ^"Peasant", ^"Gaijin"]

        # Roguish smooth talkers adept at dodging dangerous
        # situations. Quick thinking and a discerning eye for
        # untold riches from the ancient past and dangerous present.

        PROPERTIES {
            ^"School Name" STRING "Treasure Hunter" FIXED
            ^"Roles" LIST ["Courtier", "Bushi"]
            ^"Ring Increase" DEF {
                ^"Air" INTEGER 1
