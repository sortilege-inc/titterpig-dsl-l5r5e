EXTENSION "L5R5e_Emerald_Empire" EXTENDS "L5R5e_Core_Character" {
    NAME "Legend of the Five Rings 5th Edition - Emerald Empire: New Player Options"
    VERSION "0.1"
    RELEASE_DATE "2025-06-01"

    # Emerald Empire (Chapter 7): Imperial families, new schools,
    # advantages, disadvantages, techniques, and titles.
    # This extension adds options from the Emerald Empire sourcebook
    # to the core character creation and advancement systems.

    # ===========================
    # IMPERIAL FAMILIES
    # ===========================

    ^"Imperial Families" DEF {
        EXTENDS #L5R250aB2cD4eF6gH8iJ0k ^"Clan"
        APPLIES TO [^"Samurai"]

        # The Imperial families serve the Emperor directly.
        # They function as a clan for mechanical purposes but
        # are not part of any Great Clan. They hold special
        # authority and responsibilities within the Celestial Order.

        PROPERTIES {
            ^"Clan Name" STRING "Imperial" FIXED
            ^"Clan Type" STRING "Imperial"
            ^"Clan Ring Bonus" STRING "+1 Air"
            ^"Clan Skill Bonus" STRING "+1 Government"
            ^"Clan Status" INTEGER DEFAULT 40
        }

        FAMILIES {
            ^"Miya" "+1 Air or Earth, +1 Courtesy, +1 Culture, Glory 44, 8 koku"
            ^"Otomo" "+1 Air or Water, +1 Culture, +1 Sentiment, Glory 43, 9 koku"
            ^"Seppun" "+1 Earth or Void, +1 Meditation, +1 Theology, Glory 45, 6 koku"
        }

        RULES {
            #L5REE01aB2cD4eF6gH8iJ0: imperial_families_serve_emperor_directly
            #L5REE02kL3mN5oP7qR9sT1u: imperial_families_not_clan_affiliated
        }
    }

    # ===========================
    # NEW SCHOOLS
    # ===========================

    ^"Miya Cartographer School" DEF {
        APPLIES TO [^"Samurai"]

        # Imperial cartographers who travel throughout the Empire
        # mapping territories. They have standing authority to cross
        # clan boundaries freely. Trained in both academic and
        # wilderness survival skills.

        PROPERTIES {
            ^"Clan" STRING "Imperial"
            ^"School" STRING "Miya Cartographer" FIXED
            ^"School Roles" LIST OF STRING ["Artisan", "Courtier"]
            ^"Starting Rings" STRING "+1 Air, +1 Earth"
            ^"Starting Skills" STRING "Choose five: +1 Aesthetics, +1 Composition, +1 Culture, +1 Fitness, +1 Government, +1 Seafaring, +1 Survival"
            ^"Starting Honor" INTEGER DEFAULT 50
            ^"Available Technique Groups" LIST OF STRING ["Kata (kata)", "Rituals (ritual)", "Shuji (shuji)"]
            ^"Starting Techniques" STRING "Kata (choose one): Striking as Earth or Warrior's Resolve; Shuji (choose one): Artisan's Appraisal or Civility Foremost"
            ^"School Ability" STRING "Well Traveled"
            ^"Mastery Ability" STRING "Emerald Explorer"
        }

        ^"Well Traveled" DEF {
            # You always know which way is north and can always find
            # a useful navigation landmark. When making a check to
            # recall or ascertain geographical, political, or societal
            # information, add kept (ring) set to (op) or (su) results
            # equal to your school rank.
        }

        STARTING_OUTFIT [
            "traveling clothes", "wakizashi (short sword)",
            "yumi (bow) and quiver of arrows", "knife",
            "calligraphy set", "traveling pack", "personal chop",
            "an assortment of maps in scroll cases",
            "an attendant or Rokugani pony"
        ]

        CURRICULUM {
            ^"Rank 1" {
                "Artisan" SKILL_GROUP
                "Culture" SKILL
                "Fitness" SKILL
                "Survival" SKILL
                "Rank 1 Earth Shuji (shuji)" TECH_GROUP
                "Slippery Maneuvers (shuji)" TECHNIQUE
                "Threshold Barrier (ritual)" TECHNIQUE
            }
            ^"Rank 2" {
                "Scholar" SKILL_GROUP
                "Games" SKILL
                "Martial Arts [Melee]" SKILL
                "Survival" SKILL
                "Rank 1-2 Kata (kata)" TECH_GROUP
                "The Wind Blows Both Ways (shuji)" TECHNIQUE
                "Feigned Opening (shuji)" TECHNIQUE
            }
            ^"Rank 3" {
                "Trade" SKILL_GROUP
                "Courtesy" SKILL
                "Culture" SKILL
                "Martial Arts [Ranged]" SKILL
                "Rank 1-3 Air Shuji (shuji)" TECH_GROUP
                "Crimson Leaves Strike (kata)" TECHNIQUE
                "All Arts Are One (shuji)" TECHNIQUE
            }
            ^"Rank 4" {
                "Scholar" SKILL_GROUP
                "Courtesy" SKILL
                "Martial Arts [Unarmed]" SKILL
                "Meditation" SKILL
                "Rank 1-4 Kata (kata)" TECH_GROUP
                "Bend with the Storm (shuji)" TECHNIQUE
                "Regal Bearing (shuji)" TECHNIQUE
            }
            ^"Rank 5" {
                "Artisan" SKILL_GROUP
                "Command" SKILL
                "Culture" SKILL
                "Seafaring" SKILL
                "Rank 1-5 Earth Shuji (shuji)" TECH_GROUP
                "Awe of Heaven (shuji)" TECHNIQUE
                "Bravado (shuji)" TECHNIQUE
            }
            ^"Rank 6" {
                "Emerald Explorer (Mastery Ability, Action): Once per scene as a Support action, make a TN 1 Survival (Earth) check targeting one character. If you succeed, that character and additional characters equal to your bonus successes ignore all negative effects of terrain qualities until end of scene."
            }
        }

        RULES {
            #L5REE09jK0lM2nO4pQ6rS8t: cartographer_crosses_clan_borders
            #L5REE10uV1wX3yZ5aB7cD9e: cartographer_navigation_mastery
        }
    }

    ^"Miya Herald School" DEF {
        APPLIES TO [^"Samurai"]

        # Imperial messengers who deliver edicts and messages
        # throughout the Empire. They speak with the Emperor's
        # authority and travel freely across all boundaries. Known
        # for speed, objectivity, and strict reporting.

        PROPERTIES {
            ^"Clan" STRING "Imperial"
            ^"School" STRING "Miya Herald" FIXED
            ^"School Roles" LIST OF STRING ["Courtier"]
            ^"Starting Rings" STRING "+1 Air, +1 Water"
            ^"Starting Skills" STRING "Choose five: +1 Command, +1 Composition, +1 Courtesy, +1 Fitness, +1 Seafaring, +1 Sentiment, +1 Survival"
            ^"Starting Honor" INTEGER DEFAULT 50
            ^"Available Technique Groups" LIST OF STRING ["Kata (kata)", "Rituals (ritual)", "Shuji (shuji)"]
            ^"Starting Techniques" STRING "Shuji (choose one): Cadence or Honest Assessment; Shuji (choose one): Shallow Waters or Weight of Duty"
            ^"School Ability" STRING "Voice of the Emperor"
            ^"Mastery Ability" STRING "Blessings of the Emperor"
        }

        ^"Voice of the Emperor" DEF {
            # Once per round, after a character at range 0-4 succeeds
            # on an Attack or Scheme action check, you may cause them
            # to receive strife equal to your school rank.
        }

        STARTING_OUTFIT [
            "traveling clothes", "ceremonial clothes",
            "wakizashi (short sword)",
            "yumi (bow) and quiver of arrows or tessen (war fan)",
            "calligraphy set", "traveling pack",
            "satchel of Imperial proclamations",
            "personal chop", "an attendant or Rokugani pony"
        ]

        CURRICULUM {
            ^"Rank 1" {
                "Social" SKILL_GROUP
                "Culture" SKILL
                "Fitness" SKILL
                "Survival" SKILL
                "Rank 1 Water Shuji (shuji)" TECH_GROUP
                "Feigned Opening (shuji)" TECHNIQUE
                "Courtier's Resolve (shuji)" TECHNIQUE
            }
            ^"Rank 2" {
                "Trade" SKILL_GROUP
                "Courtesy" SKILL
                "Culture" SKILL
                "Martial Arts [Melee]" SKILL
                "Rank 1-2 Air Shuji (shuji)" TECH_GROUP
                "Ebb and Flow (shuji)" TECHNIQUE
                "Tributaries of Trade (shuji)" TECHNIQUE
            }
            ^"Rank 3" {
                "Scholar" SKILL_GROUP
                "Command" SKILL
                "Courtesy" SKILL
                "Survival" SKILL
                "Rank 1-3 Earth Shuji (shuji)" TECH_GROUP
                "Awe of Heaven (shuji)" TECHNIQUE
                "The Wind Blows Both Ways (shuji)" TECHNIQUE
            }
            ^"Rank 4" {
                "Artisan" SKILL_GROUP
                "Command" SKILL
                "Fitness" SKILL
                "Survival" SKILL
                "Rank 1-4 Water Shuji (shuji)" TECH_GROUP
                "Buoyant Arrival (shuji)" TECHNIQUE
                "Pillar of Calm (shuji)" TECHNIQUE
            }
            ^"Rank 5" {
                "Social" SKILL_GROUP
                "Culture" SKILL
                "Sentiment" SKILL
                "Survival" SKILL
                "Rank 1-5 Void Shuji (shuji)" TECH_GROUP
                "Sear the Wound (shuji)" TECHNIQUE
                "The Immovable Hand of Peace (shuji)" TECHNIQUE
            }
            ^"Rank 6" {
                "Blessings of the Emperor (Mastery Ability, Action): Once per scene as a Scheme action, make a TN 4 Command (Air) check targeting up to your glory rank characters. If you succeed, targets must forfeit honor equal to twice their honor rank and glory equal to twice their glory rank before targeting you with Attack actions, and increase TN of Attack actions targeting you by 2. Persists until end of scene or until you attack an affected character or their allies. (op)+: Effects also apply to targets' attacks against one chosen ally per (op) spent."
            }
        }

        RULES {
            #L5REE11fG2hI4jK6lM8nO0p: herald_speaks_with_imperial_authority
            #L5REE12qR3sT5uV7wX9yZ1a: herald_objective_observers
        }
    }

    ^"Otomo Schemer School" DEF {
        APPLIES TO [^"Samurai"]

        # Consummate politicians who advance Imperial agendas
        # across the courts of the Empire. They earn favors,
        # cultivate allies, and destroy enemies with ruthless
        # political acumen. The ends justify the means.

        PROPERTIES {
            ^"Clan" STRING "Imperial"
            ^"School" STRING "Otomo Schemer" FIXED
            ^"School Roles" LIST OF STRING ["Courtier"]
            ^"Starting Rings" STRING "+1 Air, +1 Fire"
            ^"Starting Skills" STRING "Choose five: +1 Command, +1 Composition, +1 Courtesy, +1 Culture, +1 Design, +1 Government, +1 Sentiment"
            ^"Starting Honor" INTEGER DEFAULT 45
            ^"Available Technique Groups" LIST OF STRING ["Kata (kata)", "Rituals (ritual)", "Shuji (shuji)"]
            ^"Starting Techniques" STRING "Shuji (choose one): Courtier's Resolve or Stirring the Embers; Shuji: Slippery Maneuvers"
            ^"School Ability" STRING "Necessary Actions"
            ^"Mastery Ability" STRING "Majesty of the Throne"
        }

        ^"Necessary Actions" DEF {
            # You never forfeit honor or glory to lie or deceive
            # for the good of the Emperor and Empire (in your opinion).
            # However, you must forfeit twice as much honor or glory
            # to lie for your personal gain (in your opinion).
            # When a character stakes or forfeits honor or glory to
            # act against your desires, you may force them to increase
            # that amount by your school rank.
        }

        STARTING_OUTFIT [
            "ceremonial clothes", "wakizashi (short sword)",
            "any one weapon of rarity 6 or lower",
            "calligraphy set", "traveling pack",
            "a trustworthy attendant"
        ]

        CURRICULUM {
            ^"Rank 1" {
                "Social" SKILL_GROUP
                "Composition" SKILL
                "Culture" SKILL
                "Government" SKILL
                "Rank 1 Air Shuji (shuji)" TECH_GROUP
                "Civility Foremost (shuji)" TECHNIQUE
                "Tea Ceremony (ritual)" TECHNIQUE
            }
            ^"Rank 2" {
                "Scholar" SKILL_GROUP
                "Command" SKILL
                "Courtesy" SKILL
                "Martial Arts [Melee]" SKILL
                "Rank 1-2 Water Shuji (shuji)" TECH_GROUP
                "Awe of Heaven (shuji)" TECHNIQUE
                "Prey on the Weak (shuji)" TECHNIQUE
            }
            ^"Rank 3" {
                "Artisan" SKILL_GROUP
                "Commerce" SKILL
                "Courtesy" SKILL
                "Sentiment" SKILL
                "Rank 1-3 Fire Shuji (shuji)" TECH_GROUP
                "Regal Bearing (shuji)" TECHNIQUE
                "The Wind Blows Both Ways (shuji)" TECHNIQUE
            }
            ^"Rank 4" {
                "Scholar" SKILL_GROUP
                "Aesthetics" SKILL
                "Command" SKILL
                "Skulduggery" SKILL
                "Rank 1-4 Fire Shuji (shuji)" TECH_GROUP
                "Buoyant Arrival (shuji)" TECHNIQUE
                "Wolf's Proposal (shuji)" TECHNIQUE
            }
            ^"Rank 5" {
                "Social" SKILL_GROUP
                "Composition" SKILL
                "Culture" SKILL
                "Design" SKILL
                "Rank 1-5 Air Shuji (shuji)" TECH_GROUP
                "Sear the Wound (shuji)" TECHNIQUE
                "The Immovable Hand of Peace (shuji)" TECHNIQUE
            }
            ^"Rank 6" {
                "Majesty of the Throne (Mastery Ability, Action): Once per scene as a Scheme action, make a Command (Water) check targeting any number of characters at range 0-5. TN equals the highest status rank among your targets. If you succeed, all targets suffer the Dazed and Disoriented conditions."
            }
        }

        RULES {
            #L5REE13bC4dE6fG8hI0jK2l: schemer_imperial_political_agent
            #L5REE14mN5oP7qR9sT1uV3w: schemer_ends_justify_means
        }
    }

    ^"Seppun Astrologer School" DEF {
        APPLIES TO [^"Samurai"]

        # The spiritual protectors of the Emperor, specializing in
        # astrology, divination, fortune-telling, and ward creation.
        # They anticipate and preempt supernatural threats, working
        # closely with the Palace Guard.

        PROPERTIES {
            ^"Clan" STRING "Imperial"
            ^"School" STRING "Seppun Astrologer" FIXED
            ^"School Roles" LIST OF STRING ["Shugenja", "Artisan"]
            ^"Starting Rings" STRING "+1 Air, +1 Water"
            ^"Starting Skills" STRING "Choose three: +1 Composition, +1 Government, +1 Medicine, +1 Meditation, +1 Sentiment, +1 Theology"
            ^"Starting Honor" INTEGER DEFAULT 40
            ^"Available Technique Groups" LIST OF STRING ["Invocations (invocation)", "Rituals (ritual)", "Shuji (shuji)"]
            ^"Starting Techniques" STRING "Invocation: Bind the Shadow; Invocations (choose one): Dominion of Suijin or Jade Strike; Rituals: Divination, Commune with the Spirits, Threshold Barrier"
            ^"School Ability" STRING "Just as Predicted"
            ^"Mastery Ability" STRING "Foreseen in the Stars"
        }

        ^"Just as Predicted" DEF {
            # At the beginning of a game session or as a downtime activity,
            # make a TN 1 Theology check using any ring. If you succeed,
            # choose a number of kept dice up to your school rank to reserve.
            # Until end of session or next downtime scene, when any character
            # makes a skill check using the chosen ring, you may replace one
            # or more kept dice with the same number of reserved dice of
            # the same type.
        }

        STARTING_OUTFIT [
            "sanctified robes", "concealed armor",
            "wakizashi (short sword)", "bo (staff) or knife",
            "calligraphy set", "traveling pack",
            "scroll satchel", "divination kit"
        ]

        CURRICULUM {
            ^"Rank 1" {
                "Scholar" SKILL_GROUP
                "Composition" SKILL
                "Skulduggery" SKILL
                "Tactics" SKILL
                "Rank 1 Water Invocations (invocation)" TECH_GROUP
                "Heart of the Water Dragon (invocation)" TECHNIQUE
                "Ancestry Unearthed (shuji)" TECHNIQUE
            }
            ^"Rank 2" {
                "Scholar" SKILL_GROUP
                "Command" SKILL
                "Composition" SKILL
                "Meditation" SKILL
                "Rank 1-2 Air Invocations (invocation)" TECH_GROUP
                "Ebb and Flow (shuji)" TECHNIQUE
                "Symbol of Earth (invocation)" TECHNIQUE
            }
            ^"Rank 3" {
                "Martial" SKILL_GROUP
                "Sentiment" SKILL
                "Smithing" SKILL
                "Theology" SKILL
                "Rank 1-3 Earth Invocations (invocation)" TECH_GROUP
                "False Realm of the Fox Spirits (invocation)" TECHNIQUE
                "Vapor of Nightmares (invocation)" TECHNIQUE
            }
            ^"Rank 4" {
                "Artisan" SKILL_GROUP
                "Sentiment" SKILL
                "Survival" SKILL
                "Theology" SKILL
                "Rank 1-4 Air Invocations (invocation)" TECH_GROUP
                "Tomb of Jade (invocation)" TECHNIQUE
                "A Samurai's Fate (shuji)" TECHNIQUE
            }
            ^"Rank 5" {
                "Scholar" SKILL_GROUP
                "Composition" SKILL
                "Skulduggery" SKILL
                "Tactics" SKILL
                "Rank 1-5 Water Invocations (invocation)" TECH_GROUP
                "Sear the Wound (shuji)" TECHNIQUE
                "The Soul's Blade (invocation)" TECHNIQUE
            }
            ^"Rank 6" {
                "Foreseen in the Stars (Mastery Ability): Once per game session, spend 1 Void point to reveal you have foreseen an event in the current scene. Retroactively declare one or more preparations you have taken, subject to GM approval. If preparations require a skill check, make it when you use this ability."
            }
        }

        RULES {
            #L5REE15xY6zA8bC0dE2fG4h: astrologer_spiritual_protector
            #L5REE16iJ7kL9mN1oP3qR5s: astrologer_divination_specialist
        }
    }

    ^"Seppun Palace Guard School" DEF {
        APPLIES TO [^"Samurai"]

        # The Emperor's personal bodyguards, among the most
        # accomplished warriors in the Empire. Trained for defense,
        # they react instantly to threats with supreme patience and
        # awareness. Their iaijutsu skill serves only to counter
        # sudden attacks, not for formal dueling.

        PROPERTIES {
            ^"Clan" STRING "Imperial"
            ^"School" STRING "Seppun Palace Guard" FIXED
            ^"School Roles" LIST OF STRING ["Bushi"]
            ^"Starting Rings" STRING "+1 Earth, +1 Void"
            ^"Starting Skills" STRING "Choose five: +1 Fitness, +1 Martial Arts [Melee], +1 Martial Arts [Ranged], +1 Martial Arts [Unarmed], +1 Meditation, +1 Sentiment, +1 Tactics"
            ^"Starting Honor" INTEGER DEFAULT 50
            ^"Available Technique Groups" LIST OF STRING ["Kata (kata)", "Rituals (ritual)", "Shuji (shuji)"]
            ^"Starting Techniques" STRING "Kata (choose one): Iaijutsu Cut: Crossing Blade or Iaijutsu Cut: Rising Blade; Shuji (choose one): Ancestry Unearthed or Honest Assessment"
            ^"School Ability" STRING "Speed of Heaven"
            ^"Mastery Ability" STRING "The Clouds Part"
        }

        ^"Speed of Heaven" DEF {
            # When you succeed on an Initiative check during a
            # skirmish or duel, add bonus successes equal to your
            # school rank.
        }

        STARTING_OUTFIT [
            "lacquered armor", "sanctified robes",
            "daisho (katana and wakizashi)", "naginata or bisento",
            "knife", "traveling pack"
        ]

        CURRICULUM {
            ^"Rank 1" {
                "Martial" SKILL_GROUP
                "Command" SKILL
                "Government" SKILL
                "Sentiment" SKILL
                "Rank 1 Kata (kata)" TECH_GROUP
                "Crescent Moon Style (kata)" TECHNIQUE
                "Weight of Duty (shuji)" TECHNIQUE
            }
            ^"Rank 2" {
                "Martial" SKILL_GROUP
                "Courtesy" SKILL
                "Culture" SKILL
                "Games" SKILL
                "Rank 1-2 Kata (kata)" TECH_GROUP
                "Crimson Leaves Strike (kata)" TECHNIQUE
                "Touchstone of Courage (shuji)" TECHNIQUE
            }
            ^"Rank 3" {
                "Scholar" SKILL_GROUP
                "Martial Arts [Melee]" SKILL
                "Command" SKILL
                "Skulduggery" SKILL
                "Rank 1-3 Kata (kata)" TECH_GROUP
                "Iron in the Mountains Style (kata)" TECHNIQUE
                "Threshold Barrier (ritual)" TECHNIQUE
            }
            ^"Rank 4" {
                "Martial" SKILL_GROUP
                "Command" SKILL
                "Government" SKILL
                "Theology" SKILL
                "Rank 1-4 Kata (kata)" TECH_GROUP
                "Soul Sunder (kata)" TECHNIQUE
                "A Samurai's Fate (shuji)" TECHNIQUE
            }
            ^"Rank 5" {
                "Martial" SKILL_GROUP
                "Sentiment" SKILL
                "Skulduggery" SKILL
                "Survival" SKILL
                "Rank 1-5 Kata (kata)" TECH_GROUP
                "Rouse the Soul (shuji)" TECHNIQUE
                "The Immovable Hand of Peace (shuji)" TECHNIQUE
            }
            ^"Rank 6" {
                "The Clouds Part (Mastery Ability): Once per round, spend 1 Void point to add bonus successes equal to your honor rank to a successful Attack or Support action check."
            }
        }

        RULES {
            #L5REE17tU8vW0xY2zA4bC6d: palace_guard_emperors_bodyguard
            #L5REE18eF9gH1iJ3kL5mN7o: palace_guard_defensive_specialists
        }
    }

    ^"Fortunist Monk Order" DEF {
        APPLIES TO [^"Samurai"]

        # Monks who revere the Fortunes, seeking to understand the
        # surrounding world through service to divine spirits. They
        # cannot commune with kami like shugenja, but earn the favor
        # of a Fortune who grants them invocations with bonus successes.

        PROPERTIES {
            ^"School" STRING "Fortunist Monk Order" FIXED
            ^"School Roles" LIST OF STRING ["Monk"]
            ^"Starting Rings" STRING "+1 Earth, +1 Water"
            ^"Starting Skills" STRING "Choose four: +1 Courtesy, +1 Culture, +1 Martial Arts [Unarmed], +1 Meditation, +1 Survival, +1 Theology"
            ^"Starting Honor" INTEGER DEFAULT 40
            ^"Available Technique Groups" LIST OF STRING ["Kata (kata)", "Rituals (ritual)", "Shuji (shuji)"]
            ^"Starting Techniques" STRING "Kata: Open-Hand Style; Rituals: Cleansing Rite, Threshold Barrier; Shuji (choose one): Shallow Waters or Stirring the Embers"
            ^"School Ability" STRING "Blessing of the Fortunes"
            ^"Mastery Ability" STRING "Favor of the Fortunes"
        }

        ^"Blessing of the Fortunes" DEF {
            # You have gained the goodwill of a Fortune who grants you
            # invocations. When making a check to use an invocation
            # learned this way, add additional bonus successes equal to
            # your school rank.
            # Select a Fortune as the primary object of your veneration
            # and choose one appropriate invocation for which you meet
            # the rank prerequisite. You learn that invocation without
            # paying its XP cost. Each time your school rank increases,
            # you gain one additional invocation this way.

            FORTUNE_BLESSINGS {
                "Benten" "Call Upon the Wind, Ever-Changing Waves, Inari's Blessing, Path to Inner Peace, Stride the Waves"
                "Bishamon" "Armor of Earth, Biting Steel, Courage of Seven Thunders, Power of the Earth Dragon, Tetsubo of Earth"
                "Daikoku" "Armor of Radiance, Caress of Earth, Grasp of Earth, Ravenous Swarms, Tomb of Jade"
                "Ebisu" "Bo of Water, Hands of the Tides, Inari's Blessing, Suijin's Embrace, Token of Memory"
                "Fukurokujin" "By the Light of the Lord Moon, Cloak of Night, Fukurokujin's Wit, Secrets on the Wind, Symbol of Earth"
                "Hotei" "Dominion of Suijin, Inari's Blessing, Matsu's Battlecry, Path to Inner Peace, Sympathetic Energies"
                "Jurojin" "Dance of Seasons, Heart of the Water Dragon, Jurojin's Balm, Path to Inner Peace, Power of the Earth Dragon"
            }
        }

        STARTING_OUTFIT [
            "sanctified robes", "ceremonial clothes",
            "bo (staff)", "traveling pack", "scroll satchel"
        ]

        CURRICULUM {
            ^"Rank 1" {
                "Scholar" SKILL_GROUP
                "Courtesy" SKILL
                "Labor" SKILL
                "Meditation" SKILL
                "Rank 1 Earth Shuji (shuji)" TECH_GROUP
                "Crescent Moon Style (kata)" TECHNIQUE
                "Commune with the Spirits (ritual)" TECHNIQUE
            }
            ^"Rank 2" {
                "Social" SKILL_GROUP
                "Aesthetics" SKILL
                "Meditation" SKILL
                "Theology" SKILL
                "Rank 1-2 Water Shuji (shuji)" TECH_GROUP
                "All Arts Are One (shuji)" TECHNIQUE
                "Rushing Avalanche Style (kata)" TECHNIQUE
            }
            ^"Rank 3" {
                "Artisan" SKILL_GROUP
                "Martial Arts [Unarmed]" SKILL
                "Meditation" SKILL
                "Theology" SKILL
                "Rank 1-3 Kata (kata)" TECH_GROUP
                "Regal Bearing (shuji)" TECHNIQUE
                "Ebb and Flow (shuji)" TECHNIQUE
            }
            ^"Rank 4" {
                "Social" SKILL_GROUP
                "Culture" SKILL
                "Fitness" SKILL
                "Theology" SKILL
                "Rank 1-4 Air Shuji (shuji)" TECH_GROUP
                "Buoyant Arrival (shuji)" TECHNIQUE
                "Pillar of Calm (shuji)" TECHNIQUE
            }
            ^"Rank 5" {
                "Scholar" SKILL_GROUP
                "Composition" SKILL
                "Meditation" SKILL
                "Performance" SKILL
                "Rank 1-5 Earth Shuji (shuji)" TECH_GROUP
                "Rouse the Soul (shuji)" TECHNIQUE
                "Soul Sunder (kata)" TECHNIQUE
            }
            ^"Rank 6" {
                "Favor of the Fortunes (Mastery Ability): Once per scene, you may importune one invocation without making the sacrifices usually required and without the usual TN increase. Use the Meditation skill in place of the skill check normally required (you must still use the ring required for the invocation)."
            }
        }

        RULES {
            #L5REE19pQ0rS2tU4vW6xY8z: fortunist_fortune_grants_invocations
            #L5REE20aB1cD3eF5gH7iJ9k: fortunist_bonus_successes_on_fortune_invocations
        }
    }

    ^"Shinseist Monk Order" DEF {
        APPLIES TO [^"Samurai"]

        # Devotees of Shinsei's inward-looking philosophy, seeking
        # Enlightenment by understanding that all divisions between
        # elements are illusory. They overcome these illusory
        # limitations to create seemingly supernatural effects
        # through kiho techniques.

        PROPERTIES {
            ^"School" STRING "Shinseist Monk Order" FIXED
            ^"School Roles" LIST OF STRING ["Monk"]
            ^"Starting Rings" STRING "+1 Earth, +1 Void"
            ^"Starting Skills" STRING "Choose four: +1 Aesthetics, +1 Composition, +1 Fitness, +1 Martial Arts [Unarmed], +1 Meditation, +1 Theology"
            ^"Starting Honor" INTEGER DEFAULT 40
            ^"Available Technique Groups" LIST OF STRING ["Kata (kata)", "Kiho (kiho)", "Rituals (ritual)"]
            ^"Starting Techniques" STRING "Kata: Striking as Earth; Kiho (choose two): Cleansing Spirit, Earth Needs No Eyes, or Ki Protection"
            ^"School Ability" STRING "Embrace the Void"
            ^"Mastery Ability" STRING "One with the Void"
        }

        ^"Embrace the Void" DEF {
            # When you spend a Void point to Seize the Moment, you
            # may also treat your ranks in the skill you are using as
            # being equal to your school rank. If your ranks in the
            # skill are equal to or higher than your school rank, or if
            # you have 5 ranks in the skill, you may add one kept (ring)
            # set to an (op) result instead.
        }

        STARTING_OUTFIT [
            "common clothes", "bo (staff) or nunchaku (linked staff)",
            "knife", "traveling pack"
        ]

        CURRICULUM {
            ^"Rank 1" {
                "Martial" SKILL_GROUP
                "Composition" SKILL
                "Survival" SKILL
                "Theology" SKILL
                "Rank 1 Kata (kata)" TECH_GROUP
                "Riding the Clouds (kiho)" TECHNIQUE
                "Earthen Fist (kiho)" TECHNIQUE
            }
            ^"Rank 2" {
                "Scholar" SKILL_GROUP
                "Aesthetics" SKILL
                "Courtesy" SKILL
                "Meditation" SKILL
                "Rank 1-2 Earth Kiho (kiho)" TECH_GROUP
                "Rank 1-2 Rituals (ritual)" TECH_GROUP
                "All Arts Are One (shuji)" TECHNIQUE
            }
            ^"Rank 3" {
                "Martial" SKILL_GROUP
                "Command" SKILL
                "Games" SKILL
                "Theology" SKILL
                "Rank 1-3 Kata (kata)" TECH_GROUP
                "Grasp the Earth Dragon (kiho)" TECHNIQUE
                "Way of the Willow (kiho)" TECHNIQUE
            }
            ^"Rank 4" {
                "Martial" SKILL_GROUP
                "Courtesy" SKILL
                "Survival" SKILL
                "Theology" SKILL
                "Rank 1-4 Water Kiho (kiho)" TECH_GROUP
                "Pillar of Calm (shuji)" TECHNIQUE
                "Way of the Falling Star (kiho)" TECHNIQUE
            }
            ^"Rank 5" {
                "[Choose one skill group]" SKILL_GROUP
                "Martial Arts [Unarmed]" SKILL
                "Meditation" SKILL
                "Theology" SKILL
                "Rank 1-5 Void Kiho (kiho)" TECH_GROUP
                "Rouse the Soul (shuji)" TECHNIQUE
                "The Immovable Hand of Peace (shuji)" TECHNIQUE
            }
            ^"Rank 6" {
                "One with the Void (Mastery Ability): Once per scene, you may use one kiho technique you do not know. You may use the Meditation skill in place of the skill check normally required (you must still use the ring required for the kiho)."
            }
        }

        RULES {
            #L5REE21lM2nO4pQ6rS8tU0v: shinseist_inward_seeking_enlightenment
            #L5REE22wX3yZ5aB7cD9eF1g: shinseist_void_mastery
        }
    }

    ^"Kitsune Impersonator Tradition" DEF {
        APPLIES TO [^"Samurai"]

        # Fox spirits from Chikushudo who have chosen to live as
        # humans in the mortal world. They may be full-blooded
        # kitsune or descendants of a kitsune-human union. They
        # can shapeshift between forms and possess innate magical
        # abilities. Not a formal samurai school.

        PROPERTIES {
            ^"School" STRING "Kitsune Impersonator" FIXED
            ^"School Roles" LIST OF STRING ["Courtier", "Shugenja"]
            ^"Starting Rings" STRING "+1 Air, +1 Fire"
            ^"Starting Skills" STRING "Choose three: +1 Courtesy, +1 Games, +1 Performance, +1 Martial Arts [Unarmed], +1 Survival, +1 Theology"
            ^"Starting Honor" INTEGER DEFAULT 30
            ^"Available Technique Groups" LIST OF STRING ["Invocations (invocation)", "Rituals (ritual)", "Shuji (shuji)"]
            ^"Starting Techniques" STRING "Invocations: Nature's Touch, Token of Memory; Ritual: Commune with the Spirits"
            ^"Starting Disadvantage" STRING "False Identity"
            ^"School Ability" STRING "Fox Spirit"
            ^"Mastery Ability" STRING "Ninth Tail Ascension"
        }

        ^"Fox Spirit" DEF {
            # Your true form is that of a large fox with up to eight
            # tails (full-blooded kitsune) or a human with vulpine
            # traits (human ancestry). As a Scheme and Support action,
            # transform between human and true forms, or into another
            # silhouette 1 or 2 natural creature (GM discretion; cannot
            # mimic specific individuals). Observers with vigilance
            # lower than or equal to your school rank plus your ranks
            # in Performance do not detect flaws. Certain features
            # persist across all forms. If you become Compromised,
            # your disguise slips, revealing true tails, ears, feet,
            # or shadow.
            # Must forfeit 1 honor to appear as a samurai of higher status.
        }

        STARTING_OUTFIT ["Take the starting outfit of any one other school as appropriate to your false identity"]

        CURRICULUM {
            ^"Rank 1" {
                "Martial" SKILL_GROUP
                "Performance" SKILL
                "Survival" SKILL
                "Theology" SKILL
                "Rank 1 Air Invocations (invocation)" TECH_GROUP
                "Fanning the Flames (shuji)" TECHNIQUE
                "All in Jest (shuji)" TECHNIQUE
            }
            ^"Rank 2" {
                "Social" SKILL_GROUP
                "Skulduggery" SKILL
                "Survival" SKILL
                "Theology" SKILL
                "Rank 1-2 Air Shuji (shuji)" TECH_GROUP
                "Dazzling Performance (invocation)" TECHNIQUE
                "False Realm of the Fox Spirits (invocation)" TECHNIQUE
            }
            ^"Rank 3" {
                "Artisan" SKILL_GROUP
                "Culture" SKILL
                "Meditation" SKILL
                "Theology" SKILL
                "Rank 1-3 Air Invocations (invocation)" TECH_GROUP
                "Crashing Wave Style (kata)" TECHNIQUE
                "Regal Bearing (shuji)" TECHNIQUE
            }
            ^"Rank 4" {
                "Social" SKILL_GROUP
                "Meditation" SKILL
                "Sentiment" SKILL
                "Skulduggery" SKILL
                "Rank 1-4 Air Shuji (shuji)" TECH_GROUP
                "Disappearing World Style (kata)" TECHNIQUE
                "Bravado (shuji)" TECHNIQUE
            }
            ^"Rank 5" {
                "Scholar" SKILL_GROUP
                "Martial Arts [Unarmed]" SKILL
                "Meditation" SKILL
                "Survival" SKILL
                "Rank 1-5 Air Invocations (invocation)" TECH_GROUP
                "Soul Sunder (kata)" TECHNIQUE
                "Buoyant Arrival (shuji)" TECHNIQUE
            }
            ^"Rank 6" {
                "Ninth Tail Ascension (Mastery Ability): Your true form now has nine tails. While in true form, supernatural resistance and physical resistance each increase by 2, and when you make a skill check, you may alter the result of one die containing (su) to a result containing (ex). While in true form, Attack action checks gain: (op)(op): After resolving, if target is Incapacitated or Unconscious, you devour or banish their body or soul, instantly killing them."
            }
        }

        RULES {
            #L5REE23hI4jK6lM8nO0pQ2r: kitsune_shapeshifter_spirit
            #L5REE24sT5uV7wX9yZ1aB3c: kitsune_not_formal_samurai_school
        }
    }

    ^"Kolat Saboteur Conspiracy" DEF {
        APPLIES TO [^"Samurai"]

        # Secret agents of the Kolat conspiracy devoted to ending
        # Rokugani reverence for the Celestial Heavens and establishing
        # humanity as its own ruler. They operate as assassins for hire,
        # with earnings funding the conspiracy. Not a formal school.

        PROPERTIES {
            ^"School" STRING "Kolat Saboteur" FIXED
            ^"School Roles" LIST OF STRING ["Shinobi"]
            ^"Starting Rings" STRING "+1 Air, +1 Water"
            ^"Starting Skills" STRING "Choose five: +1 Commerce, +1 Fitness, +1 Martial Arts [Melee], +1 Martial Arts [Ranged], +1 Medicine, +1 Meditation, +1 Skulduggery"
            ^"Starting Honor" INTEGER DEFAULT 20
            ^"Starting Disadvantage" STRING "False Identity"
            ^"Available Technique Groups" LIST OF STRING ["Kata (kata)", "Shuji (shuji)"]
            ^"Starting Techniques" STRING "Kata: Veiled Menace Style; Ninjutsu: Skulk; Shuji: Cadence"
            ^"School Ability" STRING "Professional Saboteur"
            ^"Mastery Ability" STRING "Usher In the New Age"
        }

        ^"Professional Saboteur" DEF {
            # Once per game session at the beginning of a scene, reveal
            # that an NPC in that scene is the target of your current
            # assignment. The GM decides what the assignment entails
            # (sabotage, framing, killing, or ensuring survival).
            # Until the end of the session, when you make a skill check
            # targeting the chosen NPC, you may reroll a number of dice
            # up to your school rank.
        }

        STARTING_OUTFIT [
            "ceremonial clothes", "common clothes", "traveling clothes",
            "daisho (katana and wakizashi)", "knife", "five shuriken",
            "one vial of poison", "traveling pack"
        ]

        CURRICULUM {
            ^"Rank 1" {
                "Martial" SKILL_GROUP
                "Courtesy" SKILL
                "Performance" SKILL
                "Skulduggery" SKILL
                "Rank 1 Kata (kata)" TECH_GROUP
                "Deadly Sting (ninjutsu)" TECHNIQUE
                "Shallow Waters (shuji)" TECHNIQUE
            }
            ^"Rank 2" {
                "Martial" SKILL_GROUP
                "Commerce" SKILL
                "Medicine" SKILL
                "Skulduggery" SKILL
                "Rank 1-2 Kata (kata)" TECH_GROUP
                "Noxious Cloud (ninjutsu)" TECHNIQUE
                "Tributaries of Trade (shuji)" TECHNIQUE
            }
            ^"Rank 3" {
                "Scholar" SKILL_GROUP
                "Composition" SKILL
                "Smithing" SKILL
                "Survival" SKILL
                "Rank 1-3 Kata (kata)" TECH_GROUP
                "Ebb and Flow (shuji)" TECHNIQUE
                "Spin the Web (shuji)" TECHNIQUE
            }
            ^"Rank 4" {
                "Martial" SKILL_GROUP
                "Commerce" SKILL
                "Skulduggery" SKILL
                "Survival" SKILL
                "Rank 1-4 Kata (kata)" TECH_GROUP
                "Silencing Stroke (ninjutsu)" TECHNIQUE
                "Wolf's Proposal (shuji)" TECHNIQUE
            }
            ^"Rank 5" {
                "Martial" SKILL_GROUP
                "Command" SKILL
                "Commerce" SKILL
                "Skulduggery" SKILL
                "Rank 1-5 Kata (kata)" TECH_GROUP
                "Rank 1-5 Ninjutsu (ninjutsu)" TECH_GROUP
                "Buoyant Arrival (shuji)" TECHNIQUE
            }
            ^"Rank 6" {
                "Usher In the New Age (Mastery Ability): As a downtime activity, overcome or bypass an NPC's guards or security measures. Make a Skulduggery (Air) check targeting the NPC, TN equal to their highest conflict rank. If you succeed and the NPC is a minion or non-essential adversary (GM discretion), you accomplish your goal. If the NPC is important, you confront them alone, likely beginning a conflict scene. (op)(op): Your efforts go completely unnoticed. (op)(op): If you kill the target, death appears accidental or natural."
            }
        }

        RULES {
            #L5REE25dE6fG8hI0jK2lM4n: kolat_conspiracy_agent
            #L5REE26oP7qR9sT1uV3wX5y: kolat_age_of_humanity_agenda
        }
    }

    # ===========================
    # NEW ADVANTAGES: DISTINCTIONS
    # ===========================

    ^"Animal Trainer" DEF {
        EXTENDS ^"Distinction"

        PROPERTIES {
            ^"Ring" STRING "Water"
            ^"Types" LIST ["Interpersonal", "Mental"]
        }

        EFFECT {
            "You are an expert at training and caring for animals."
            "When performing a check for which your animal training expertise is a benefit (such as Medicine [Water] to diagnose a sick animal or Survival [Water] to teach an animal a command), you may reroll up to two dice."
        }
    }

    ^"Criminal Connections" DEF {
        EXTENDS ^"Distinction"

        PROPERTIES {
            ^"Ring" STRING "Air"
            ^"Types" LIST ["Interpersonal"]
        }

        EFFECT {
            "You have contacts in the criminal underworld who owe you favors."
            "When performing a check that benefits from your criminal connections (such as Skulduggery [Air] to contact the underworld in an unfamiliar city or Commerce [Air] to sell stolen items), you may reroll up to two dice."
        }
    }

    ^"Expert Tracker" DEF {
        EXTENDS ^"Distinction"

        PROPERTIES {
            ^"Ring" STRING "Air"
            ^"Types" LIST ["Mental", "Physical"]
        }

        EFFECT {
            "You are skilled at following trails and tracking prey."
            "When performing a check for which your tracking expertise applies (such as Fitness [Air] to follow an animal unnoticed or Survival [Air] to follow a trail), you may reroll up to two dice."
        }
    }

    ^"Friend of the Brotherhood" DEF {
        EXTENDS ^"Distinction"

        PROPERTIES {
            ^"Ring" STRING "Void"
            ^"Types" LIST ["Interpersonal"]
        }

        EFFECT {
            "You are known for your Shinseist piety and have friends among the Brotherhood of Shinsei."
            "When performing a check to leverage your reputation for Shinseist piety (such as Courtesy [Void] to establish a connection with a monk or Theology [Void] to glean wisdom from the Tao), you may reroll up to two dice."
        }
    }

    ^"Hero of [Village]" DEF {
        EXTENDS ^"Distinction"

        PROPERTIES {
            ^"Ring" STRING "Fire"
            ^"Types" LIST ["Fame", "Interpersonal"]
        }

        EFFECT {
            "You are celebrated as a hero in a particular village."
            "When performing a check for which your heroic reputation is a benefit (such as Command [Fire] to rally peasants or Performance [Fire] to impress with tales of heroics), you may reroll up to two dice."
        }
    }

    ^"Kuge Lineage" DEF {
        EXTENDS ^"Distinction"

        PROPERTIES {
            ^"Ring" STRING "Earth"
            ^"Types" LIST ["Interpersonal"]
        }

        EFFECT {
            "You descend from a kuge family with hereditary authority."
            "When performing a check for which your hereditary authority is a benefit (such as Command [Earth] to silence a buke samurai or Government [Earth] to cite familiarity with Imperial family practices), you may reroll up to two dice."
        }
    }

    ^"Spiritual Protector" DEF {
        EXTENDS ^"Distinction"

        PROPERTIES {
            ^"Ring" STRING "Void"
            ^"Types" LIST ["Spiritual"]
        }

        EFFECT {
            "A benevolent spirit watches over you, granting you flashes of intuition."
            "When performing a check for which your spiritual protector is a benefit (such as Fitness [Void] to avoid a surprise attack through instinct or Survival [Void] to notice an imminent hazard), you may reroll up to two dice."
        }
    }

    ^"Well Connected" DEF {
        EXTENDS ^"Distinction"

        PROPERTIES {
            ^"Ring" STRING "Water"
            ^"Types" LIST ["Interpersonal"]
        }

        EFFECT {
            "You have an extensive network of contacts across Rokugan."
            "When performing a check for which your connections are a benefit (such as Courtesy [Water] to impress someone at court or Government [Water] to identify a useful contact), you may reroll up to two dice."
        }
    }

    # ===========================
    # NEW ADVANTAGES: PASSIONS
    # ===========================

    ^"Bonsai" DEF {
        EXTENDS ^"Passion"

        PROPERTIES {
            ^"Ring" STRING "Air"
            ^"Types" LIST ["Mental"]
        }

        EFFECT {
            "You find peace and meaning in the art of bonsai."
            "After performing a check to interact with a bonsai piece (such as Aesthetics [Air] to prune a tree or Sentiment [Air] to identify emotional response to a work), you remove 3 strife."
        }
    }

    ^"City [Choose one]" DEF {
        EXTENDS ^"Passion"

        PROPERTIES {
            ^"Ring" STRING "Water"
            ^"Types" LIST ["Interpersonal", "Mental"]
        }

        EFFECT {
            "You have a deep love for a particular city and know its secrets."
            "After performing a check to learn or share knowledge of the particular city (such as Courtesy [Water] to befriend a local or Culture [Water] to find an establishment), you remove 3 strife."
        }
    }

    ^"Gourmet" DEF {
        EXTENDS ^"Passion"

        PROPERTIES {
            ^"Ring" STRING "Water"
            ^"Types" LIST ["Mental", "Interpersonal"]
        }

        EFFECT {
            "You have a refined palate and appreciation for fine cuisine."
            "After performing a check involving high-quality food (such as Culture [Water] to locate a place to dine or Labor [Water] to prepare a fine meal), you remove 3 strife."
        }
    }

    ^"Military History" DEF {
        EXTENDS ^"Passion"

        PROPERTIES {
            ^"Ring" STRING "Earth"
            ^"Types" LIST ["Mental"]
        }

        EFFECT {
            "You are well-versed in the military history of Rokugan."
            "After performing a check related to military history (such as Command [Earth] to bolster troops with a historical story or Tactics [Earth] to prepare a defense based on known strategies), you remove 3 strife."
        }
    }

    ^"Navigator" DEF {
        EXTENDS ^"Passion"

        PROPERTIES {
            ^"Ring" STRING "Fire"
            ^"Types" LIST ["Mental"]
        }

        EFFECT {
            "You are skilled at charting courses and finding your way."
            "After performing a check to navigate (such as Seafaring [Fire] to chart an unknown route or Survival [Fire] to extrapolate location from the stars), you remove 3 strife."
        }
    }

    ^"Researcher" DEF {
        EXTENDS ^"Passion"

        PROPERTIES {
            ^"Ring" STRING "Air"
            ^"Types" LIST ["Mental"]
        }

        EFFECT {
            "You are a dedicated researcher with a talent for finding information."
            "After performing a check to research a topic (such as Culture [Air] to locate a particular poem or Medicine [Air] to find records of a mysterious illness), you remove 3 strife."
        }
    }

    ^"Rock Gardening" DEF {
        EXTENDS ^"Passion"

        PROPERTIES {
            ^"Ring" STRING "Void"
            ^"Types" LIST ["Mental"]
        }

        EFFECT {
            "You find contemplative peace in the arrangement of rock gardens."
            "After performing a check related to rock gardening (such as Aesthetics [Void] to detect hidden meaning in a garden's arrangement or Meditation [Void] to make sense of events while reflecting on a rock garden), you remove 3 strife."
        }
    }

    # ===========================
    # NEW DISADVANTAGES: ADVERSITIES
    # ===========================

    ^"Adopted Peasant" DEF {
        EXTENDS ^"Adversity"

        PROPERTIES {
            ^"Ring" STRING "Fire"
            ^"Types" LIST ["Interpersonal"]
        }

        EFFECT {
            "You were born a peasant before being adopted into a samurai family, and some know your origins."
            "When you make a check to deal authoritatively with a samurai who knows of your peasant birth (such as Command [Fire] to order a subordinate or Courtesy [Fire] to impugn another's honor), you must choose and reroll two dice showing (su) or (ex). After resolving the check, if you failed, gain 1 Void point."
        }
    }

    ^"Allergy [Choose one]" DEF {
        EXTENDS ^"Adversity"

        PROPERTIES {
            ^"Ring" STRING "Air"
            ^"Types" LIST ["Physical"]
        }

        EFFECT {
            "You have a severe allergy to a common substance."
            "When you make a check that exposes you to the source of your allergy (such as Fitness [Air] to run through a swarm of bees or Courtesy [Air] to sample a dish containing your allergen), you must choose and reroll two dice showing (su) or (ex). After resolving the check, if you failed, gain 1 Void point."
        }
    }

    ^"Cursed Lineage" DEF {
        EXTENDS ^"Adversity"

        PROPERTIES {
            ^"Ring" STRING "Void"
            ^"Types" LIST ["Interpersonal", "Spiritual"]
        }

        EFFECT {
            "Your family line is cursed, and the curse manifests when you delve into your heritage."
            "When making a check that does or could invoke the curse (such as Culture [Void] to understand your family history or Theology [Void] to seek your ancestors' blessing), you must choose and reroll two dice showing (su) or (ex). After resolving the check, if you failed, gain 1 Void point."
        }
    }

    ^"Despised in [City]" DEF {
        EXTENDS ^"Adversity"

        PROPERTIES {
            ^"Ring" STRING "Water"
            ^"Types" LIST ["Fame", "Interpersonal"]
        }

        EFFECT {
            "You are despised in a particular city, and its residents are hostile toward you."
            "When performing a check to gain assistance from a resident of the city that despises you (such as Courtesy [Water] to learn rumors or Commerce [Water] to purchase goods), you must choose and reroll two dice showing (su) or (ex). After resolving the check, if you failed, gain 1 Void point."
        }
    }

    ^"Hunted by Chikushodo" DEF {
        EXTENDS ^"Adversity"

        PROPERTIES {
            ^"Ring" STRING "Earth"
            ^"Types" LIST ["Spiritual"]
        }

        EFFECT {
            "The spirits of Chikushodo have marked you, and animals are hostile toward you."
            "When performing a check to interact with an animal (such as Survival [Earth] to calm a frightened horse or Fitness [Earth] to go unnoticed by a hungry wolf), you must choose and reroll two dice showing (su) or (ex). After resolving the check, if you failed, gain 1 Void point."
        }
    }

    ^"Skepticism" DEF {
        EXTENDS ^"Adversity"

        PROPERTIES {
            ^"Ring" STRING "Void"
            ^"Types" LIST ["Mental", "Spiritual"]
        }

        EFFECT {
            "You doubt the existence of the Spirit Realms, which hinders your spiritual endeavors."
            "When you make a check that relies on the existence of the Spirit Realms (such as Medicine [Void] to diagnose a malady of the soul or Theology [Void] to detect a kami's presence), you must choose and reroll two dice showing (su) or (ex). After resolving the check, if you failed, gain 1 Void point."
        }
    }

    # ===========================
    # NEW DISADVANTAGES: ANXIETIES
    # ===========================

    ^"Accustomed to Luxury" DEF {
        EXTENDS ^"Anxiety"

        PROPERTIES {
            ^"Ring" STRING "Earth"
            ^"Types" LIST ["Mental"]
        }

        EFFECT {
            "You are accustomed to the finest accommodations and find anything less deeply distressing."
            "After performing a check that requires you to remain in unacceptable accommodations (such as Survival [Earth] to set up a campsite or Commerce [Earth] to stay at a rural inn), you receive 3 strife. If this is the first time this scene, gain 1 Void point."
        }
    }

    ^"Claustrophobia" DEF {
        EXTENDS ^"Anxiety"

        PROPERTIES {
            ^"Ring" STRING "Water"
            ^"Types" LIST ["Mental"]
        }

        EFFECT {
            "Enclosed spaces fill you with dread."
            "After making a check that requires you to enter an enclosed space (such as Fitness [Water] to crawl through a narrow passage or Survival [Water] to investigate a cave), you receive 3 strife. If this is the first time this scene, gain 1 Void point."
        }
    }

    ^"False Identity" DEF {
        EXTENDS ^"Anxiety"

        PROPERTIES {
            ^"Ring" STRING "Air"
            ^"Types" LIST ["Interpersonal"]
        }

        EFFECT {
            "You are living under a false identity, and the constant deception weighs on you."
            "After performing a check to maintain your false identity (such as Courtesy [Air] to lie about your past or Skulduggery [Air] to hide evidence of the truth), you receive 3 strife. If this is the first time this scene, gain 1 Void point."
        }
    }

    ^"Loathing for Peasants" DEF {
        EXTENDS ^"Anxiety"

        PROPERTIES {
            ^"Ring" STRING "Water"
            ^"Types" LIST ["Interpersonal", "Mental"]
        }

        EFFECT {
            "You despise peasants and find interacting with them deeply unpleasant."
            "After performing a check that requires you to interact with peasants (such as Culture [Water] to observe farmers' customs or Courtesy [Water] to question a village leader), you receive 3 strife. If this is the first time this scene, gain 1 Void point."
        }
    }

    ^"Loneliness" DEF {
        EXTENDS ^"Anxiety"

        PROPERTIES {
            ^"Ring" STRING "Void"
            ^"Types" LIST ["Interpersonal", "Mental"]
        }

        EFFECT {
            "You dread being alone, and solitude fills you with anxiety."
            "After performing a check that requires you to be alone (such as Composition [Void] to write a letter declining an invitation or Meditation [Void] to spend time in dedicated introspection), you receive 3 strife. If this is the first time this scene, gain 1 Void point."
        }
    }

    # ===========================
    # NEW TECHNIQUES
    # ===========================

    ^"Emerald Empire Techniques" DEF {
        APPLIES TO [^"Samurai"]

        ENTRIES {
            ^"Spin the Web" {
                ^"Type" STRING "Shuji"
                ^"Subtype" STRING "Air Shuji (Kolat)"
                ^"Rank" INTEGER 3
                ^"Activation" STRING "Once per game session, during a narrative scene or as a downtime activity"
                ^"Check" STRING "TN 2 Skulduggery (Air)"
                ^"Effect" STRING "If you succeed, recruit a minor or previously unknown NPC (GM discretion) as a Kolat asset. Record them under your Relationships. Once per game session you may call on one asset you can reasonably contact. The NPC aids you during a single scene or conducts a single downtime activity."
                ^"Opportunities" STRING "Air (op): If you succeed, choose one skill. The NPC has ranks in that skill equal to your school rank and can perform checks with that skill to assist you."
            }

            ^"Awe of Heaven" {
                ^"Type" STRING "Shuji"
                ^"Subtype" STRING "Void Shuji (Imperial)"
                ^"Rank" INTEGER 4
                ^"Activation" STRING "Once per scene, as an Attack and Scheme action"
                ^"Check" STRING "Command (Void) check targeting any number of characters in the scene. TN equals the highest status rank among targets."
                ^"Effect" STRING "If you succeed, each target suffers the Silenced condition."
            }
        }

        RULES {
            #L5REE33nO4pQ6rS8tU0vW2x: ee_new_techniques_extend_core
        }
    }

    # ===========================
    # TITLES
    # ===========================

    ^"Emerald Empire Titles" DEF {
        APPLIES TO [^"Samurai"]

        # Titles represent important narrative events and new duties.
        # Characters study skills and techniques outside their school
        # via the title's advancement table. Completing a title grants
        # the title ability.

        ENTRIES {
            ^"Advisor" {
                ^"Assigned By" STRING "Daimyo, Emerald Magistrates, military leaders, high-ranking courtiers"
                ^"Status Award" STRING "+10 (minimum 40)"
                ^"XP to Completion" INTEGER 36
                ^"Title Ability" STRING "Skilled Attendant"
                ^"Title Ability Effect" STRING "When you provide assistance on a Scholar skill check, the character you are assisting may roll (skill) equal to your ranks in that skill instead of their own."
                ^"Advancement" LIST OF STRING [
                    "Scholar Skills (Skill Group)",
                    "Commerce (Skill)",
                    "Courtesy (Skill)",
                    "Design (Skill)",
                    "Fanning the Flames (shuji)",
                    "Feigned Opening (shuji)",
                    "Stonewall Tactics (shuji)"
                ]
            }

            ^"Clan Magistrate" {
                ^"Assigned By" STRING "Clan champions, daimyo, and other clan leaders"
                ^"Status Award" STRING "+10 (minimum 45)"
                ^"XP to Completion" INTEGER 30
                ^"Title Ability" STRING "Justice of the Champion"
                ^"Title Ability Effect" STRING "When you make a Command or Courtesy check targeting a member of your clan, you may spend (op)+: The target receives or removes (your choice) strife equal to (op) spent this way."
                ^"Advancement" LIST OF STRING [
                    "Scholar Skills (Skill Group)",
                    "Social Skills (Skill Group)",
                    "Fitness (Skill)",
                    "Martial Arts [Melee] (Skill)",
                    "Coiling Serpent Style (kata)",
                    "Prey on the Weak (shuji)",
                    "Truth Burns through Lies (shuji)"
                ]
            }

            ^"Daimyo" {
                ^"Assigned By" STRING "Clan champions, the Emperor, and other high-ranking officials"
                ^"Status Award" STRING "+20 (minimum 55)"
                ^"XP to Completion" INTEGER 36
                ^"Title Ability" STRING "Voice of Authority"
                ^"Title Ability Effect" STRING "Reduce the TN of Command checks you make targeting your vassals by 1."
                ^"Advancement" LIST OF STRING [
                    "Social Skills (Skill Group)",
                    "Culture (Skill)",
                    "Government (Skill)",
                    "Tactics (Skill)",
                    "Courtier's Resolve (shuji)",
                    "Shallow Waters (shuji)",
                    "Stirring the Embers (shuji)"
                ]
            }

            ^"Gunso" {
                ^"Assigned By" STRING "A daimyo or superior officer within the military rank structure"
                ^"Status Award" STRING "+5 (minimum 20)"
                ^"XP to Completion" INTEGER 24
                ^"Title Ability" STRING "Lead from the Front"
                ^"Title Ability Effect" STRING "When you defeat an opponent in a clash, your cohort removes panic equal to the opponent's glory rank. Once per round when you succeed at an Attack action check during a mass battle, your cohort removes panic equal to half of the attrition you inflict."
                ^"Advancement" LIST OF STRING [
                    "Martial Skills (Skill Group)",
                    "Command (Skill)",
                    "Government (Skill)",
                    "Rank 1-4 Kata (kata) (Tech Group)",
                    "Rallying Cry (shuji)",
                    "Stirring the Embers (shuji)",
                    "Touchstone of Courage (shuji)"
                ]
            }

            ^"Monastic Acolyte" {
                ^"Assigned By" STRING "Most monasteries accept anyone who takes the required vows and shaves their head"
                ^"Status Award" STRING "Status becomes 25"
                ^"XP to Completion" INTEGER 24
                ^"Title Ability" STRING "Enlightened"
                ^"Title Ability Effect" STRING "When you are selected as a target of an action requiring a skill check, you may spend a Void point to increase or decrease the TN of the check by an amount up to your ranks in Meditation (minimum 1)."
                ^"Advancement" LIST OF STRING [
                    "Martial Skills (Skill Group)",
                    "Scholar Skills (Skill Group)",
                    "Aesthetics (Skill)",
                    "Composition (Skill)",
                    "Cleansing Spirit (kiho)",
                    "Ki Protection (kiho)",
                    "Still the Elements (kiho)"
                ]
            }

            ^"Priest" {
                ^"Assigned By" STRING "Most priests train from a young age; some are assigned by a head priest at a shrine or temple"
                ^"Status Award" STRING "+10 (minimum 40)"
                ^"XP to Completion" INTEGER 24
                ^"Title Ability" STRING "Servant of the Kami"
                ^"Title Ability Effect" STRING "You may importune invocations even if you do not know any invocations. When you importune, do not increase the TN by 1 (although you still increase TN if the invocation rank is higher than your school rank)."
                ^"Advancement" LIST OF STRING [
                    "Social Skills (Skill Group)",
                    "Composition (Skill)",
                    "Culture (Skill)",
                    "Theology (Skill)",
                    "Rank 1-5 Rituals (ritual) (Tech Group)",
                    "Civility Foremost (shuji)",
                    "Rouse the Soul (shuji)"
                ]
            }

            ^"Spy" {
                ^"Assigned By" STRING "Daimyo, clan champions, magistrates, and clandestine organizations (never announced publicly)"
                ^"Status Award" STRING "-5"
                ^"XP to Completion" INTEGER 24
                ^"Title Ability" STRING "Ears Everywhere"
                ^"Title Ability Effect" STRING "Once per game session as a Scheme and Support action or downtime activity targeting a location or social group, make a TN 4 Sentiment (Air) check. If you succeed, discover the latest relevant happenings and which current rumors are false. If discerning someone's qualities is your social objective in an intrigue, score momentum points equal to your Air Ring plus bonus successes. (op): Plant a rumor that spreads among the targeted group."
                ^"Advancement" LIST OF STRING [
                    "Social Skills (Skill Group)",
                    "Government (Skill)",
                    "Sentiment (Skill)",
                    "Skulduggery (Skill)",
                    "Rank 1-5 Air Shuji (shuji) (Tech Group)",
                    "Shallow Waters (shuji)",
                    "Skulk (ninjutsu)"
                ]
            }

            ^"Yojimbo" {
                ^"Assigned By" STRING "Daimyo, Emerald Magistrates, military leaders, high-ranking courtiers"
                ^"Status Award" STRING "+10 (minimum 40)"
                ^"XP to Completion" INTEGER 36
                ^"Title Ability" STRING "No Sacrifice Too Great"
                ^"Title Ability Effect" STRING "One character is assigned as your charge; they can order you to treat someone else as your charge until they lift this order. If your charge is at range 0-2, you may spend 1 Void point to replace your charge as the target of an Attack action. If you suffer a critical strike as a result, gain 1 Void point."
                ^"Advancement" LIST OF STRING [
                    "Martial Skills (Skill Group)",
                    "Government (Skill)",
                    "Medicine (Skill)",
                    "Sentiment (Skill)",
                    "Iaijutsu Cut: Crossing Blade (kata)",
                    "Iaijutsu Cut: Rising Blade (kata)",
                    "Warrior's Resolve (kata)"
                ]
            }

            ^"Yoriki" {
                ^"Assigned By" STRING "Magistrates of all kinds directly appoint their own yoriki"
                ^"Status Award" STRING "+5 (minimum 35)"
                ^"XP to Completion" INTEGER 24
                ^"Title Ability" STRING "Take Them Alive"
                ^"Title Ability Effect" STRING "When you make an Attack action using a weapon with the Snaring quality, you may alter any number of kept dice containing (su) or (ex) to results set to (op)."
                ^"Advancement" LIST OF STRING [
                    "Social Skills (Skill Group)",
                    "Government (Skill)",
                    "Martial Arts [Melee] (Skill)",
                    "Skulduggery (Skill)",
                    "Rank 1-3 Kata (kata) (Tech Group)",
                    "Fanning the Flames (shuji)",
                    "Shallow Waters (shuji)"
                ]
            }
        }

        RULES {
            #L5REE34yZ5aB7cD9eF1gH3i: titles_represent_narrative_advancement
            #L5REE35jK6lM8nO0pQ2rS4t: titles_grant_ability_on_completion
            #L5REE36uV7wX9yZ1aB3cD5e: retainers_limited_by_status_rank
        }
    }
}
