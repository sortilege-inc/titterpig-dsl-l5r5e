# .codex SECTION — Dark Tides (Game Master's Kit adventure). Stand-off graph over
# l5r5e-0.5-gm-kit-dark-tides.lore (spec §25). Part of the L5R5e system graph;
# DEPENDS_ON the shared schema.
#
# The adventure's large cast (defined as DEFs in l5r5e-0.5-gm-kit-dark-tides.arc,
# with statblocks in l5r5e-0.5-gm-kit-mechanics.ttrpg) is referenced via ^"...",
# not minted. Slow Tide Harbor is already in the graph (Shadowlands) — referenced
# and amended. This section gives the recurring mahō-tsukai Kitsu Sokori her home
# node (she returns as the antagonist of Mask of the Oni), plus her agent Gaku,
# the Tortoise Clan, and the primary victim Otomo Hiroshige.

CODEX "L5R5e_DarkTides_Codex" {
    NAME "Dark Tides — Lore Graph"
    VERSION "0.5.2"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-09-03"
    FOR EDITION "l5r5e"
    DEPENDS_ON "L5R5e_Codex_Schema" VERSION "0.5.9"

    # ---- The Tortoise Clan ------------------------------------------------
    ENTITY #L5RcxDkT01tortoiseclan ^"Tortoise Clan" {
        IS ^"Faction"
        SOURCE "l5r5e-0.5-gm-kit-dark-tides.lore" AT "dark-tides"
    }

    # ---- The recurring villain & her agent --------------------------------
    ENTITY #L5RcxDkT02kitsusokori ^"Kitsu Sokori" {
        IS ^"Person"
        SOURCE "l5r5e-0.5-gm-kit-dark-tides.lore" AT "dark-tides"
        RELATIONSHIPS { ^"member-of" -> ^"Kitsu" FROM "The vanished samurai are actually being kidnapped and sold to Kitsu Sokori, a mahō-tsukai who is conducting sacrifices to boost her supernatural power." }
    }
    ENTITY #L5RcxDkT03gakuagent ^"Gaku" {
        IS ^"Person"
        SOURCE "l5r5e-0.5-gm-kit-dark-tides.lore" AT "kitsu-sokoris-agent-gaku"
        RELATIONSHIPS { ^"student-of" -> ^"Kitsu Sokori" FROM "Kitsu Sokori’s Agent: Gaku" }
    }

    # ---- The primary victim ------------------------------------------------
    ENTITY #L5RcxDkT04otomohiroshige ^"Otomo Hiroshige" {
        IS ^"Person"
        SOURCE "l5r5e-0.5-gm-kit-dark-tides.lore" AT "the-inn-of-many-paths"
        RELATIONSHIPS { ^"member-of" -> ^"Otomo" FROM "Otomo Hiroshige, the first missing samurai of note, stayed here, and it is likely where the PCs begin their investigations in the town." }
    }

    # ---- Amendment to existing graph node ---------------------------------
    ENTITY #FckO1XgK6sSTBZIIjmjh9r ^"Slow Tide Harbor" {
        SOURCE "l5r5e-0.5-gm-kit-dark-tides.lore" AT "the-magistrate-kasuga-mikoto"
        RELATIONSHIPS { ^"held-by" -> ^"Tortoise Clan" FROM "The Tortoise Clan magistrate for Slow Tide Harbor is a pouch-faced woman in her late thirties named Kasuga Mikoto." }
    }
}
