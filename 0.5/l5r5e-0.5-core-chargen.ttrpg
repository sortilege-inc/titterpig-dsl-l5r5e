BASE "L5R5e_Core_Chargen" {
    NAME "Legend of the Five Rings 5th Edition - Character Creation Rules"
    VERSION "0.5.3"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-03-01"

    # Core Rulebook: Character creation process (pages 40-98)
    # The complete Game of Twenty Questions with correct mechanical
    # effects, Heritage table (Table 2-1), starting value formulas,
    # and advancement/curriculum rules (Table 2-2).
    #
    # Procedural companion to the type definitions in:
    #   l5r5e-0.5-core-character.ttrpg  (Clan/Family/School types)
    #   l5r5e-0.5-core-traits.ttrpg     (Ring/Skill definitions)
    #   l5r5e-0.5-core-schools-*.ttrpg  (Individual school definitions)
    #   l5r5e-0.5-core-distinctions.ttrpg
    #   l5r5e-0.5-core-adversities.ttrpg
    #   l5r5e-0.5-core-passions.ttrpg
    #   l5r5e-0.5-core-anxieties.ttrpg

    # ===========================
    # STARTING VALUES
    # ===========================

    #d5TG3wyXePlL9oBNKmfhBJ ^"Starting Values" DEF {
        APPLIES TO [#L5R003xY4zA6bC8dE0fG2hI ^"Samurai"]

        PROPERTIES {
            ^"All Rings" INTEGER DEFAULT 1         # Air, Earth, Fire, Water, Void
            ^"All Skills" INTEGER DEFAULT 0        # All skills start untrained
            ^"Honor" INTEGER DEFAULT 0             # Set by school (Q3)
            ^"Glory" INTEGER DEFAULT 0             # Set by family (Q2)
            ^"Status" INTEGER DEFAULT 0            # Set by clan (Q1)
            ^"Starting Void Points" FORMULA "Void ring value / 2 (rounded up)"
        }

        RULES {
            #L5R300aB2cD4eF6gH8iJ0k: ring_maximum_during_creation_is_three "Limits on Skills and Rings: All characters begin with 1 rank in each ring and 0 ranks in each skill. You cannot raise a ring or skill above rank 3 during character creation. If a choice would result in a ring rising above rank 3 during character creation, then you must choose a different ring to increase instead, as long as that ring would also not be increased above rank 3."
            #L5R301lM3nO5pQ7rS9tU1v: skill_maximum_during_creation_is_three "Similarly, if a choice would result in a skill rising above rank 3 during character creation, then you must choose a different skill that is not already at rank 3 to increase instead."
            #L5R304sT6uV8wX0yZ2aB4c: starting_values "Starting Values: When you begin to answer the Game of Twenty Questions, keep in mind the following baseline values for your character:\n\nRings: 1 rank in each ring.\n\nSkills: 0 ranks in each skill.\n\nHonor: Determined in Question 3.\n\nGlory: Determined in Question 2.\n\nStatus: Determined in Question 1.\n\nEndurance: Calculated based on your final ring values; (Earth + Fire) x 2.\n\nComposure: Calculated based on your final ring values; (Earth + Water) x 2.\n\nFocus: Calculated based on your final ring values; Fire + Air.\n\nVigilance: Calculated based on your final ring values; (Air + Water) / 2."
        }
    }

    # ===========================
    # THE GAME OF TWENTY QUESTIONS
    # ===========================

    #sBVA5r4wtxxyiSFxVx6pnZ ^"Game of Twenty Questions" DEF {
        APPLIES TO [#L5R003xY4zA6bC8dE0fG2hI ^"Samurai"]

        #
        # This replaces the abbreviated version in
        # l5r5e-0.5-core-character.ttrpg with the correct and complete
        # mechanical effects for each question.

        RULES {
            #L5R310aB2cD4eF6gH8iJ0k: the_game_of_twenty_questions "The Game of Twenty Questions: Ever since the publication of its first edition in 1997, the Legend of the Five Rings Roleplaying Game has used the Game of Twenty Questions to help players create the backgrounds and personalities of their characters. The game encourages you, the player, to ask key questions about your character: What kind of character do you want to play? What is their history like? What are their goals? What is the most important thing in the world to them?\n\nThese questions are also used to build your character mechanically. As you answer the questions, you will be instructed to note down ring and skill increases, as well as other static values to be applied to your character. You will want to keep a running tally of your current ring and skill ranks."
        }

        PHASES {

            # ---------------------------
            # PART I: CORE IDENTITY (Q1-Q2)
            # ---------------------------

            #5fh9X71tGwkZucgjyo2Gez ^"Part I: Core Identity" DEF {

                #rHldd5oLZdhgYTowZQDaiY ^"Question 1: What Clan Does Your Character Belong To?" DEF {
                    PROPERTIES {
                        ^"Question" INTEGER 1 FIXED
                        ^"Question Text" STRING "What Clan Does Your Character Belong To?" FIXED
                    }

                    RULES {
                        #L5R320aB2cD4eF6gH8iJ0k: q1_choose_clan "The seven Great Clans of Rokugan have ruled in the name of the Emperor since the founding of the Emerald Empire, and generations of legendary heroes have fought and died to maintain their power, prestige, and influence. A samurai of one of the Great Clans is inheritor to a weighty legacy. Each clan has an ancient and unique assortment of beliefs and ideals it imparts upon its members, set forth by the clan's founding Kami and developed over the centuries.\n\nWhen creating a character, you should choose a clan whose culture and values you find interesting from a storytelling standpoint. Whether your character wishes to rigidly adhere to these strictures, chafes under the pressure of them, or perhaps does a bit of both, clan identity is very important to who your character is and how they exist in the world."
                    }
                }

                #gtZPUUH8qFKmcXwKEpnz4Z ^"Question 2: What Family Does Your Character Belong To?" DEF {
                    PROPERTIES {
                        ^"Question" INTEGER 2 FIXED
                        ^"Question Text" STRING "What Family Does Your Character Belong To?" FIXED
                    }

                    #
                    # See clan definitions in l5r5e-0.5-core-character.ttrpg
                    # for family listings with ring choices, skills, glory,
                    # and wealth values.

                    RULES {
                        #L5R324sT6uV8wX0yZ2aB4c: q2_choose_family "Even within a single clan, the customs and traditions of the various families inform the creation of a wide variety of characters. Once your clan is chosen, pick which of the clan's families your character hails from."
                    }
                }
            }

            # ---------------------------
            # PART II: ROLE AND SCHOOL (Q3-Q4)
            # ---------------------------

            #uQF7LT6joxzQGHWNdu9qES ^"Part II: Role and School" DEF {
                #k8XieeGd9PUKHr37qTiWQY ^"Question 3: What Is Your Character's School, and What Roles Does That School Fall Into?" DEF {
                    PROPERTIES {
                        ^"Question" INTEGER 3 FIXED
                        ^"Question Text" STRING "What Is Your Character's School, and What Roles Does That School Fall Into?" FIXED
                    }

                    #
                    # See l5r5e-0.5-core-schools-*.ttrpg files for
                    # individual school definitions.

                    RULES {
                        #L5R329vW1xY3zA5bC7dE9f: q3_choose_school_other_clan_with_gm_permission "During this step, a player chooses a single school within their clan for their character. If you wish for your character to study at another school outside of their clan, ask your GM's permission and work out a set of circumstances that have allowed for your character to receive their unusual training."
                        #L5R330gH2iJ4kL6mN8oP0q: q3_school_rings "Rings: When you select this school, this specifies which of your character's rings you increase by the specified amount."
                        #L5R331rS3tU5vW7xY9zA1b: q3_school_starting_skills "Starting Skills: This entry specifies a collection of skills that you can elect to give your character a rank in. It also specifies the number of skills you can choose (unlike the rings, you must choose a number from the overall list)."
                        #L5R332cD4eF6gH8iJ0kL2m: q3_school_honor "Honor: This is your character's starting honor."
                        #L5R333nO5pQ7rS9tU1vW3x: q3_school_starting_techniques "Starting Techniques: These are techniques your character starts the game with. Unless the entry specifies that you must choose from a list, your character starts with everything listed here. Techniques are listed in Chapter 4."
                        #L5R334yZ6aB8cD0eF2gH4i: q3_school_ability "School Ability: Each school has a unique ability associated with it. Your character gains that ability when you choose the school."
                        #L5R335jK7lM9nO1pQ3rS5t: q3_school_starting_outfit "Starting Outfit: This is the clothing and equipment your character starts play with."
                        #UvxTTOZpkgbPhcZPNEz8E3: q3_school_techniques_available "Techniques Available: These are the types of techniques your character can purchase when they advance after character creation."
                    }
                }

                #SKMQ3MLwAKjDMlErpAJkoh ^"Question 4: How Does Your Character Stand Out Within Their School?" DEF {
                    PROPERTIES {
                        ^"Question" INTEGER 4 FIXED
                        ^"Question Text" STRING "How Does Your Character Stand Out Within Their School?" FIXED
                    }

                    RULES {
                        #L5R337fG9hI1jK3lM5nO7p: q4_choose_ring_increase_option "Choose one of the following options and increase your ring rank by the specified amount:\n\nCreativity, passion, or drive (+1 Fire Ring): Your character is recognized by their teachers and peers for their inventive ideas, their sincere love for the craft of their school, or their intense and irrepressible desire to succeed in their field. Their energy and enthusiasm inspire fellow students and galvanize rivals to put forth their best as well.\n\nGrace, eloquence, or empathy (+1 Air Ring): Your character stands out in their school for their finesse, the refinement with which they express themself in social situations, or their sensitivity to the feelings of others. To other students, their successes often appear effortless, but the truth of the matter is that their innate attention to detail means that they work as hard as anyone else, if not harder.\n\nAdaptability, friendliness, or awareness (+1 Water Ring): Your character's willingness to roll with the punches, gregariousness, or understanding of their environment stands out among their peers. Your character tends not to get stuck in mental ruts the same way many people do, or at least they have ways to get out of them.\n\nThoroughness, patience, or calm (+1 Earth Ring): Stoicism is a trait valued greatly in Rokugan, and your character bears challenges and hardships without complaint. Your character's teachers might have come to rely upon them as an assistant instructor, while their peers are likely to see them as a source of wisdom and stability.\n\nSelf-awareness, insight, or mysticism (+1 Void Ring): At a certain point, all arts become a study of the universe, oneself, and the relationship between the two, and your character is more adept at seeing things within both than most of their peers are. They might even seem to have a supernatural sense of things, and to act based on hunches about what is to come in addition to possessing insight about their place in the wider universe."
                        #L5R338qR0sT2uV4wX6yZ8a: q4_students_excel_in_different_areas "Even in a training system as regulated as that of a dōjō, different students excel in different areas. Even a pair of twins from the same family attending the same school might differ in temperament, aptitude, or inclination."
                    }
                }
            }

            # ---------------------------
            # PART III: HONOR AND GLORY (Q5-Q8)
            # ---------------------------

            #ctmpDTHXN1DpYQBUxy7yV2 ^"Part III: Honor and Glory" DEF {

                #7UjMMlsH7P7bmZZx83iqPc ^"Question 5: Who Is Your Lord, and What Is Your Character's Duty to Them?" DEF {
                    PROPERTIES {
                        ^"Question" INTEGER 5 FIXED
                        ^"Question Text" STRING "Who Is Your Lord and What Is Your Character's Duty to Them?" FIXED
                    }

                    RULES {
                        #L5R339bC1dE3fG5hI7jK9l: q5_record_giri "Write down your answer on your character sheet under \"Giri.\" Giri is how your character acquires esteem in the eyes of their lord, and thus is related to your character's reputation within the Empire, their glory. See more under Giri, on page 39 of Chapter 1: Playing the Game."
                        #L5R340mN2oP4qR6sT8uV0w: q5_selecting_giri_properly "Selecting One's Giri Properly: Giri provides characters with the first of their two primary drives within the story. You should be able to answer the following questions in the affirmative when considering your character's giri and ninjō (personal feelings) together, and if you cannot, you should talk to your GM about selecting a different giri:\n\nIs this giri something you want to see your character pursue or contend with during the story? This does not mean that your character should always enjoy the weight of their duty, but you, the player, should be excited by the prospect of getting to watch your character struggle with it.\n\nCan your character make progress toward completing this giri no matter where the campaign takes your character? A good giri has clear paths you can explore with it even when it does not tie in with the main plot, and it should be something that can influence your character's choices no matter what location they travel to or what obstacles they face.\n\nIs this giri likely to conflict with your ninjō at least occasionally? Being pulled between duty and desires is a key part of many works of samurai fiction, and even if the two are not diametrically opposed, your character should sometimes have to make hard decisions about which is more important in the moment."
                    }
                }

                #mijwxO8jdT9fL3nRIMqmVB ^"Question 6: What Does Your Character Long For, and How Might This Impede Their Duty?" DEF {
                    PROPERTIES {
                        ^"Question" INTEGER 6 FIXED
                        ^"Question Text" STRING "What Does Your Character Long For, and How Might This Impede Their Duty?" FIXED
                    }

                    RULES {
                        #L5R341xY3zA5bC7dE9fG1h: q6_record_ninjo "Write down your character's personal question, goal, or core desire on your character sheet under \"Ninjō.\" Ninjō is a challenge that you set before your character, forcing them to confront the ideals of Bushidō and the cost to uphold them as they pursue their desire—thus, it is related to their honor. Another way to look at ninjō is to ask yourself: what goal might tempt the character to disobey their lord or do other dishonorable things? What would be worth such risks to them? See more under Ninjō, on page 38 of Chapter 1: Playing the Game."
                        #L5R342iJ4kL6mN8oP0qR2s: q6_giri_and_ninjo_should_be_able_to_conflict "Samurai drama revolves around competing desires. To create quandaries for your samurai that enhance drama and make for enjoyable roleplaying, you should think about how your character's giri and ninjō might come into conflict. They do not need to be in constant opposition, but there should always be the possibility for friction between the two—and the conflict your character would feel at such times should be interesting to you!\n\nIf you can't imagine a few exciting moments that might arise from your character being forced to choose between the two (or you wouldn't enjoy roleplaying those moments), modify one or both selections until you can. The GM will be working to bring both up during the course of the campaign, which leads to difficult choices for your character (and thus, interesting choices for you, the player!)."
                    }
                }

                #MuOEGBNXqezcGSKFIpfKyN ^"Question 7: What Is Your Character's Relationship With Their Clan?" DEF {
                    PROPERTIES {
                        ^"Question" INTEGER 7 FIXED
                        ^"Question Text" STRING "What Is Your Character's Relationship With Their Clan?" FIXED
                    }

                    RULES {
                        #L5R343tU5vW7xY9zA1bC3d: q7_choose_glory_or_skill "Choose one of the following:\n\nIf your character believes firmly in the precepts of their clan and the values it holds dear, gain +5 glory based on their reputation as an upstanding member of their community.\n\nIf your character has a fundamental disagreement with their clan's beliefs, policies, or practices and has defied these in the past, gain 1 rank in a skill in which you have 0 ranks. Consider why this skill represents a divergence from the clan's training or values."
                    }
                }

                #sxJO4ACvKk9TBAbz1U8fcQ ^"Question 8: What Does Your Character Think of Bushido?" DEF {
                    PROPERTIES {
                        ^"Question" INTEGER 8 FIXED
                        ^"Question Text" STRING "What Does Your Character Think of Bushidō?" FIXED
                    }

                    RULES {
                        #L5R347lM9nO1pQ3rS5tU7v: q8_choose_honor_or_skill "Choose one of the following:\n\nIf your character's belief in living by an orthodox interpretation of Bushidō is very staunch, gain +10 honor.\n\nIf your character diverges from some or all common beliefs about how samurai should behave honorably, gain 1 rank in one of the following skills to reflect past behavior that was unbefitting of a samurai or deeply defied the norm: Commerce, Labor, Medicine, Seafaring, Skulduggery, or Survival."
                    }
                }
            }

            # ---------------------------
            # PART IV: STRENGTHS AND WEAKNESSES (Q9-Q13)
            # ---------------------------

            #7gpgTbR3LNSQcmotcdnnSX ^"Part IV: Strengths and Weaknesses" DEF {

                #ibax8gDS1C2rEhjMjrP6nA ^"Question 9: What Is Your Character's Greatest Accomplishment So Far?" DEF {
                    PROPERTIES {
                        ^"Question" INTEGER 9 FIXED
                        ^"Question Text" STRING "What Is Your Character's Greatest Accomplishment So Far?" FIXED
                    }

                    #
                    # See l5r5e-0.5-core-distinctions.ttrpg for options.

                    RULES {
                        #L5R348wX0yZ2aB4cD6eF8g: q9_grants_one_distinction "In addition to deciding on your character's greatest achievement in their life so far, choose one distinction advantage that was key to accomplishing this success, or that your character developed as a result of it. See Specific Distinctions, on page 101, for a list of options. If you want to create your own distinction, consult with your GM using the guidance in Creating Custom Advantages and Disadvantages, on page 137."
                    }
                }

                #vPccNwLP5vOLPMCp9EsTMO ^"Question 10: What Holds Your Character Back the Most in Life?" DEF {
                    PROPERTIES {
                        ^"Question" INTEGER 10 FIXED
                        ^"Question Text" STRING "What Holds Your Character Back the Most in Life?" FIXED
                    }

                    #
                    # See l5r5e-0.5-core-adversities.ttrpg for options.

                    RULES {
                        #L5R349hI1jK3lM5nO7pQ9r: q10_grants_one_adversity "Choose one adversity disadvantage for your character. See Specific Adversities, on page 116, for a list of options. If you want to create your own adversity, consult with your GM using the guidance in Creating Custom Advantages and Disadvantages, on page 137."
                    }
                }

                #K3AGtkpAPPd9uknma7dRz7 ^"Question 11: What Activity Most Makes Your Character Feel at Peace?" DEF {
                    PROPERTIES {
                        ^"Question" INTEGER 11 FIXED
                        ^"Question Text" STRING "What Activity Most Makes Your Character Feel at Peace?" FIXED
                    }

                    #
                    # See l5r5e-0.5-core-passions.ttrpg for options.

                    RULES {
                        #L5R350sT2uV4wX6yZ8aB0c: q11_grants_one_passion "Choose one passion advantage related to your character's interests or hobbies. See Specific Passions, on page 111, for a list of options. If you want to create your own passion, consult with your GM using the guidance in Creating Custom Advantages and Disadvantages, on page 137."
                    }
                }

                #EpzDnCtSpXeFodpIKS6M20 ^"Question 12: What Concern, Fear, or Foible Troubles Your Character the Most?" DEF {
                    PROPERTIES {
                        ^"Question" INTEGER 12 FIXED
                        ^"Question Text" STRING "What Concern, Fear, or Foible Troubles Your Character the Most?" FIXED
                    }

                    #
                    # See l5r5e-0.5-core-anxieties.ttrpg for options.

                    RULES {
                        #L5R351dE3fG5hI7jK9lM1n: q12_grants_one_anxiety "Choose one anxiety disadvantage for your character. See Specific Anxieties, on page 130, for a list of options. If you want to create your own anxiety, consult with your GM using the guidance in Creating Custom Advantages and Disadvantages, on page 137."
                    }
                }

                #dmqMio4en5LWJqncacuDph ^"Question 13: Who Has Your Character Learned the Most From During Their Life?" DEF {
                    PROPERTIES {
                        ^"Question" INTEGER 13 FIXED
                        ^"Question Text" STRING "Who Has Your Character Learned the Most From During Their Life?" FIXED
                    }

                    RULES {
                        #L5R352oP4qR6sT8uV0wX2y: q13_record_mentor_choose_advantage_or_disadvantage_and_skill "In the Relationships section of the character sheet, record the name of the person from whom your character has learned the most, along with the nature of their relationship. Then, choose one of the following options and gain the listed feature:\n\nOne advantage related to your character's mentor and their relationship.\n\nOne disadvantage related to your character's mentor and their relationship, and 1 rank in a skill that your character developed as a result of your character's closest confidante and their relationship.\n\nIf you want to create your own advantage or disadvantage, consult with your GM using the guidance in Creating Custom Advantages and Disadvantages, on page 137."
                    }
                }
            }

            # ---------------------------
            # PART V: PERSONALITY AND BEHAVIOR (Q14-Q20)
            # ---------------------------

            #9Sy0K4f8WV1uZYQa2l7MUo ^"Part V: Personality and Behavior" DEF {

                #l235hAsr4GlXQHTq5NC0kw ^"Question 14: What Do People Notice First Upon Encountering Your Character?" DEF {
                    PROPERTIES {
                        ^"Question" INTEGER 14 FIXED
                        ^"Question Text" STRING "What Do People Notice First Upon Encountering Your Character?" FIXED
                    }

                    #
                    # Core Rulebook pp. 93-94. The question does NOT set a
                    # Demeanor: Demeanor is an NPC statblock field (see
                    # ^"Core NPCs"), not an output of character creation.

                    RULES {
                        #L5RUJzt0ASYmGCRLUS8WpfO6k: q14_records_personality_habits_quirks "Record the answer in the Personality, Habits and Quirks section of your character sheet."
                        #L5R354kL6mN8oP0qR2sT4u: q14_grants_aesthetic_item "Additionally, choose one distinctive aesthetic accoutrement that your character carries or wears most of the time (e.g. a scarf, hair ornament, engraved scabbard, eyepatch, etc). This bit of personal flair might accent their striking features or stand in contrast to them."
                    }
                }

                #BoRytr4QtvUXE2BavfXYaL ^"Question 15: How Does Your Character React to Stressful Situations?" DEF {
                    PROPERTIES {
                        ^"Question" INTEGER 15 FIXED
                        ^"Question Text" STRING "How Does Your Character React to Stressful Situations?" FIXED
                    }

                    RULES {
                        #L5R355vW7xY9zA1bC3dE5f: q15_narrative_stress_response "Describe a noteworthy physical response that your character has during times of stress and note it under the Personality, Habits, and Quirks section of the character sheet. As your character's strife approaches their composure, your character might display this behavior, and it could play a part any time they unmask."
                    }
                }

                #olAUl13NBcid0CcSaXLFtU ^"Question 16: What Are Your Character's Preexisting Relationships With Other Clans, Families, Organizations, and Traditions?" DEF {
                    PROPERTIES {
                        ^"Question" INTEGER 16 FIXED
                        ^"Question Text" STRING "What Are Your Character's Preexisting Relationships With Other Clans, Families, Organizations, and Traditions?" FIXED
                    }

                    RULES {
                        #L5R356gH8iJ0kL2mN4oP6q: q16_record_relationships_with_other_groups "Record any noteworthy history, quarrels, alliances, or grievances your character has with other groups in the Relationships section of your character sheet."
                        #L5R357rS9tU1vW3xY5zA7b: q16_grants_item_rarity_seven_or_lower "Additionally, choose one item of rarity 7 or lower that your character received as a gift from one such group, took in battle fighting against them, or that otherwise relates to or symbolizes the character's past and ongoing relationship with them. Add this item to your starting outfit."
                    }
                }

                #pfwvvMLBT3vAN1FAsfxEBr ^"Question 17: How Would Your Character's Parents Describe Them?" DEF {
                    PROPERTIES {
                        ^"Question" INTEGER 17 FIXED
                        ^"Question Text" STRING "How Would Your Character's Parents Describe Them?" FIXED
                    }

                    RULES {
                        #L5R358cD0eF2gH4iJ6kL8m: q17_grants_skill_at_rank_zero "Additionally, gain one rank of one skill in which your character has 0 ranks, and determine whether your character's parents approve of this extracurricular interest or see it as a regrettable deviation, and why."
                        #L5R359nO1pQ3rS5tU7vW9x: q17_record_relationship_with_parents "Record the nature of the relationship between your character and their parents or immediate family members in the Relationships section of your character sheet."
                    }
                }

                #pi5x1kMbeENOQ8HXc57Sfp ^"Question 18: Who Was Your Character Named to Honor?" DEF {
                    PROPERTIES {
                        ^"Question" INTEGER 18 FIXED
                        ^"Question Text" STRING "Who Was Your Character Named to Honor?" FIXED
                    }

                    #
                    # See ^"Samurai Heritage Table" below for full details.

                    RULES {
                        #L5R360yZ2aB4cD6eF8gH0i: q18_roll_heritage_twice_choose_one "First, roll a ten-sided die twice. Consult those numbers in Table 2–1: Samurai Heritage on the next page to see entries on two potential famous relatives from the last few generations. Choose one of those two options as the relative for whom your character is named. Then, roll a ten-sided die again as specified by that entry."
                        #L5R361jK3lM5nO7pQ9rS1t: q18_gm_may_allow_either_or_both_results "At the GM's discretion, all players in a game may choose the first result, the second result, or both results."
                    }
                }

                #mPklGt4uWcNYARqYnVHBRm ^"Question 19: What Is Your Character's Personal Name?" DEF {
                    PROPERTIES {
                        ^"Question" INTEGER 19 FIXED
                        ^"Question Text" STRING "What Is Your Character's Personal Name?" FIXED
                    }

                    RULES {
                        #L5R362uV4wX6yZ8aB0cD2e: q19_choose_personal_name "After you have chosen the name of the ancestor your character's name honors, choose the personal name derived from it that your character is be known by. It might be the same name or an alteration with significance to your character. This is the name that is recorded in the family register, replacing the name they used as a child. In the Rokugani style, the character typically is addressed by their family name (chosen in Question 18), with the appropriate honorific, but close associates may refer to them simply by their personal name.\n\nWhat does your character's name mean? Does your character's appearance fit with their name, or are the two incongruous?"
                    }
                }

                #7Lbkz5PIKq8PwiTgL6pcGX ^"Question 20: How Should Your Character Die?" DEF {
                    PROPERTIES {
                        ^"Question" INTEGER 20 FIXED
                        ^"Question Text" STRING "How Should Your Character Die?" FIXED
                    }

                    RULES {
                        #L5R363fG5hI7jK9lM1nO3p: q20_narrative_only "This has no mechanical implications, but you should keep it in mind. Your GM certainly will…"
                    }
                }
            }

        }
    }

    # ===========================
    # SAMURAI HERITAGE TABLE (Table 2-1)
    # ===========================

    #wVK0PkfGrV9hJy8gcgHB6x ^"Samurai Heritage Table" DEF {
        APPLIES TO [#L5R003xY4zA6bC8dE0fG2hI ^"Samurai"]

        # Table 2-1: Samurai Heritage (page 96)
        # Used in Question 18 of the Twenty Questions.
        #

        HERITAGE_TABLE {

            # Table 2-1 as printed on page 96. Every sub-table below had been
            # rewritten with different roll ranges, and several with different
            # or missing results, so each entry's odds and some of its outcomes
            # differed from the book. Restored from the page.

            1 ^"Famous Deed" DEF {

                MODIFIERS {
                    ^"Glory" "+3"
                }

                EFFECT {
                    "Roll a ten-sided die again and add the resulting family heirloom to your starting items (1–3: a weapon, 4–6: a set of armor, 7–8: another item, 9: a horse or other animal, 10: a boat or estate). You choose one quality and the GM chooses one quality from the list of item qualities, on page 240; these are applied to the item."
                }

                SUB_TABLE "1d10" {
                    "1-3" "A weapon"
                    "4-6" "A set of armor"
                    "7-8" "Another item"
                    "9" "A horse or other animal"
                    "10" "A boat or estate"
                }
            }

            2 ^"Glorious Sacrifice" DEF {

                MODIFIERS {
                    ^"Honor" "+5"
                    ^"Glory" "+5"
                }

                EFFECT {
                    "Roll a ten-sided die again to determine your lost family heirloom (1–3: a weapon, 4–6: a set of armor, 7–8: another item, 9: a horse or other animal, 10: a boat or estate), which exists somewhere in the world. You choose one quality and the GM chooses one quality; these are applied to the item. You do not know where the heirloom is, but you could later reclaim it during the campaign."
                }

                SUB_TABLE "1d10" {
                    "1-3" "A weapon"
                    "4-6" "A set of armor"
                    "7-8" "Another item"
                    "9" "A horse or other animal"
                    "10" "A boat or estate"
                }
            }

            3 ^"Wondrous Work" DEF {

                MODIFIERS {
                    ^"Glory" "+5"
                }

                EFFECT {
                    "Roll a ten-sided die again to determine an Artisan skill (1–3: Aesthetics, 4–6: Composition, 7–8: Design, 9–10: Smithing); gain +1 rank in that skill."
                }

                SUB_TABLE "1d10" {
                    "1-3" "Gain +1 ^\"Aesthetics\""
                    "4-6" "Gain +1 ^\"Composition\""
                    "7-8" "Gain +1 ^\"Design\""
                    "9-10" "Gain +1 ^\"Smithing\""
                }
            }

            4 ^"Dynasty Builder" DEF {

                MODIFIERS {
                    ^"Glory" "-3"
                }

                EFFECT {
                    "Roll a ten-sided die again to determine a Social skill (1–3: Command, 4–6: Courtesy, 7–8: Games, 9–10: Performance); gain +1 rank in that skill."
                }

                SUB_TABLE "1d10" {
                    "1-3" "Gain +1 ^\"Command\""
                    "4-6" "Gain +1 ^\"Courtesy\""
                    "7-8" "Gain +1 ^\"Games\""
                    "9-10" "Gain +1 ^\"Performance\""
                }
            }

            5 ^"Discovery" DEF {

                MODIFIERS {
                    ^"Glory" "+3"
                }

                EFFECT {
                    "Roll a ten-sided die again to determine a Scholar skill (1–3: Culture, 4–5: Sentiment, 6–7: Government, 8–9: Medicine, 10: Theology); gain +1 rank in that skill."
                }

                SUB_TABLE "1d10" {
                    "1-3" "Gain +1 ^\"Culture\""
                    "4-5" "Gain +1 ^\"Sentiment\""
                    "6-7" "Gain +1 ^\"Government\""
                    "8-9" "Gain +1 ^\"Medicine\""
                    "10" "Gain +1 ^\"Theology\""
                }
            }

            6 ^"Ruthless Victor" DEF {

                MODIFIERS {
                    ^"Honor" "-5"
                }

                EFFECT {
                    "Roll a ten-sided die again to determine a Martial skill (1–3: Fitness, 4–5: Martial Arts [Melee], 6–7: Martial Arts [Ranged], 8: Martial Arts [Unarmed], 9: Tactics, 10: Meditation); gain +1 rank in that skill."
                }

                SUB_TABLE "1d10" {
                    "1-3" "Gain +1 ^\"Fitness\""
                    "4-5" "Gain +1 ^\"Martial Arts [Melee]\""
                    "6-7" "Gain +1 ^\"Martial Arts [Ranged]\""
                    "8" "Gain +1 ^\"Martial Arts [Unarmed]\""
                    "9" "Gain +1 ^\"Tactics\""
                    "10" "Gain +1 ^\"Meditation\""
                }
            }

            7 ^"Elevated for Service" DEF {

                MODIFIERS {
                    ^"Glory" "-3"
                    ^"Honor" "+3"
                }

                EFFECT {
                    "Roll a ten-sided die again to determine a Trade skill (1–3: Commerce, 4–5: Labor, 6–7: Seafaring, 8: Skulduggery, 9–10: Survival); gain +1 rank in that skill."
                }

                SUB_TABLE "1d10" {
                    "1-3" "Gain +1 ^\"Commerce\""
                    "4-5" "Gain +1 ^\"Labor\""
                    "6-7" "Gain +1 ^\"Seafaring\""
                    "8" "Gain +1 ^\"Skulduggery\""
                    "9-10" "Gain +1 ^\"Survival\""
                }
            }

            8 ^"Stolen Knowledge" DEF {

                MODIFIERS {
                    ^"Honor" "-5"
                }

                EFFECT {
                    "You know one additional technique. Roll a ten-sided die again to determine the category (1–3: kata, 4–6: shūji, 7: ritual, 8: invocation, 9: kihō, 10: mahō or ninjutsu), and then select one technique with a prerequisite of school rank 1 and learn that technique. You can perform that technique even if it is not normally allowed by your school."
                }

                SUB_TABLE "1d10" {
                    "1-3" "Kata"
                    "4-6" "Shūji"
                    "7" "Ritual"
                    "8" "Invocation"
                    "9" "Kihō"
                    "10" "Mahō or ninjutsu"
                }
            }

            9 ^"Imperial Heritage" DEF {

                MODIFIERS {
                    ^"Status" "+10"
                }

                EFFECT {
                    "You gain the ^\"Blessed Lineage\" advantage (see page 103) (this can be assigned in excess of the normal limitations on advantages at character creation)."
                }
            }

            10 ^"Unusual Name Origin" DEF {

                MODIFIERS {
                    ^"Glory" "-3"
                }

                # A choice, not a further roll.
                EFFECT {
                    "Choose two of your character's rings; you may reduce the value of one of these rings by 1 to increase the value of the other by 1 (this still cannot raise a ring above 3). If you do not do so, choose one item of rarity 6 or lower and assign it to your starting outfit."
                }
            }
        }

        RULES {
            #pF0VEDiidERBiVMiAt1Pnq: heritage_famous_deed "Famous Deed: One of your ancestors won a great victory for their clan or even the Emperor, and was rewarded with an item of incredible quality."
            #VFlS7X19crey8ERWBDHois: heritage_glorious_sacrifice "Glorious Sacrifice: One of your ancestors perished nobly in battle, and one of their signature items vanished with them or was lost in the subsequent years."
            #yrJyJhiSxYCPiMiRKzMif5: heritage_wondrous_work "Wondrous Work: One of your ancestors crafted a piece of great beauty that won renown for your family, and others expect you to live up to that legacy."
            #kJhzAHvuY7K46OCoyX505d: heritage_dynasty_builder "Dynasty Builder: One of your ancestors was instrumental in the rise of a powerful lord, using cunning stratagems and shrewd advice to secure their ascension. You have heard this story many times and know the importance of power subtly wielded."
            #e2hFysBdTn4m3Wsc73yqLR: heritage_discovery "Discovery: One of your ancestors made an incredible discovery, invented something of great importance, or uncovered an ancient secret. Thanks to family lore, you have at least a rudimentary understanding of the subject of their discovery."
            #vp8kZctH8qoiEGjfOd4eUC: heritage_ruthless_victor "Ruthless Victor: One of your ancestors claimed a bloody victory over a rival, smashing their forces with a cunning maneuver or seizing their domain after vanquishing them in battle. From this relative or their story, you learned well the importance of brute force."
            #kf2SsSrcdN781zMoMsLlN6: heritage_elevated_for_service "Elevated for Service: One of your ancestors was a jizamurai or even a commoner who served with such distinction that their position was elevated to that of a Great Clan samurai by marriage or mandate of a daimyō. As a child, you learned the basics of the skills for which they won their esteem."
            #fTRorjyQn7pcknIyFLo4C0: heritage_stolen_knowledge "Stolen Knowledge: One of your ancestors learned a secret of another school and clandestinely passed it down through the ages; now, it has reached you."
            #s4YN9xISUKjOtZmzfserGn: heritage_imperial_heritage "Imperial Heritage: You can trace your lineage back to the Imperial line."
            #yjQsLYgpA8wUATd6lIuGfZ: heritage_unusual_name_origin "Unusual Name Origin: Your character was not named for an ancestor—perhaps they were named for an outsider who did a great service to the clan, perhaps their name was bestowed upon them for a unique deed, or perhaps someone was trying to send a specific message in the selection of their name."
        }
    }

    # ===========================
    # ADVANCEMENT SYSTEM (Table 2-2)
    # ===========================

    #qLicpynLdNu07y2a636A0M ^"Advancement" DEF {
        APPLIES TO [#L5R003xY4zA6bC8dE0fG2hI ^"Samurai"]

        # Table 2-2: Advancement (page 97)

        ADVANCEMENT_COSTS {

            ^"Skill Rank Increase" COST "2 XP x rank purchased" {
                "Rank 0 → 1" "2 XP"
                "Rank 1 → 2" "4 XP"
                "Rank 2 → 3" "6 XP"
                "Rank 3 → 4" "8 XP"
                "Rank 4 → 5" "10 XP"
            }

            ^"Ring Increase" COST "3 XP x value purchased" {
                "Ring 1 → 2" "6 XP"
                "Ring 2 → 3" "9 XP"
                "Ring 3 → 4" "12 XP"
                "Ring 4 → 5" "15 XP"
            }

            ^"Technique" COST "3 XP, or other listed value" {
            }
        }

        RULES {
            #L5R380aB2cD4eF6gH8iJ0k: ring_increase_restrictions "Ring value +1: Cannot increase a ring to a value greater than lowest ring + Void Ring. Maximum 5."
            #L5R382wX4yZ6aB8cD0eF2g: skill_max_is_five "Skill rank +1: Maximum 5."
            #L5R383hI5jK7lM9nO1pQ3r: technique_restrictions "Technique: Category must be listed among available techniques or technique must appear on your curriculum (denoted by = symbol)."
            #L5R384sT6uV8wX0yZ2aB4c: restrictions_and_prerequisites "Restrictions and Prerequisites: Advancements also have certain restrictions, also listed in Table 2–2: Advancement Costs and Restrictions. A character cannot make a purchase that exceeds these restrictions.\n\nAdditionally, techniques have prerequisites, special requirements to that a character has to meet before they buy individual techniques. Prerequisites are listed in the same line as the technique's name, and are usually character traits such as a certain school rank or clan affiliation. To purchase a technique, a character must meet all of its prerequisites.\n\nIf a technique is listed by name or as part of a technique group for the current rank in their curriculum table (or as one of their starting techniques), it is a special exception. They can buy it without meeting the prerequisites, and it is indicated with the = symbol."
            #L5R385dE7fG9hI1jK3lM5n: real_world_experience_versus_school_secrets "Real-World Experience versus School Secrets: A little bit of practical experience can be as potent as years of training. Characters in any campaign should be allowed to spend their experience on skills and rings during play as they desire, as one can learn through practice no matter their circumstances.\n\nIn the fiction of the setting, a character is usually taught school secrets, like techniques, by an instructor in their school or another individual who knows the technique. Advancing to the next school rank might be a more involved process, requiring the character to undertake tests or visit specific locations and meet with particular instructors of their tradition.\n\nIn practice, many campaigns are not conducive to having characters return to their dōjō as frequently as they would like to spend experience or increase their school rank. As a result, the game's default assumption is that characters can learn techniques and increase school rank wherever they go, presumably receiving foundational methods to practice on their travels or scrolls containing deeper mysteries for them to decipher during their journeys. A character might need to return to their school to formally verify their newly elevated rank within their school from a thematic standpoint, but they can use its mechanical benefits as soon as they earn it.\n\nIf you, as a GM, want to maintain the narrative element of learning techniques and advancing school ranks, you can do so by specifying that a character must use a downtime activity to visit their dōjō or search for an NPC who knows the technique. School ranks can only be increased after visiting the proper dōjō and passing the requisite test or training under an individual who has attained a higher rank in that school. If you decide to take this route for your game, be sure that you inform your players before the game begins and provide the PCs with sufficient opportunities to spend their hard-earned experience on techniques."
            #vJoKQtuBqBRiPiyYzX6puB: purchasing_advancements "Purchasing Advancements: The ways a character can improve themself by spending experience are collectively called advancements. These include ring ranks, skill ranks, and techniques.\n\nA character may purchase any advancement by paying its listed cost, so long as it fits within the listed restrictions. Table 2–2: Advancement Costs provides the costs and restrictions for each advancement type.\n\nEach character also has a curriculum table (see tables beginning on page 57), the collected wisdom of their school, to guide them in their specialized role. A character receives extra benefits for purchasing advancements listed there (but remember, they can buy any advancement that they're not restricted from purchasing). Note that rings are not included in any curriculum."
        }
    }

    # ===========================
    # CURRICULUM PROGRESSION
    # ===========================

    #PuaP9IozHhy6NKt64uSgfF ^"Curriculum Progression" DEF {
        APPLIES TO [#L5R003xY4zA6bC8dE0fG2hI ^"Samurai"]

        #E66cTpExtzQC0GJO4mfxgg ^"Curriculum XP Contribution" DEF {

            RULES {
                #L5R386oP8qR0sT2uV4wX6y: in_curriculum_full_xp_contribution "Spending XP in Curriculum: Any XP spent on advances that appear on one's current school rank curriculum table fully contributes to the current rank. Record the full value of this XP as part of the total needed to complete the current rank."
                #L5R387zA9bC1dE3fG5hI7j: out_of_curriculum_half_xp_rounded_up "Spending XP out of Curriculum: Any XP spent on advances that do not appear on one's current school rank curriculum table (including any purchases of Ring advancements) partially contributes to the current rank. Record half the value of this XP (rounded up) as part of the total needed to complete the current rank."
            }
        }

        #5KddVBouTMQJLFzaNHxTjq ^"Rank Advancement Thresholds" DEF {

            THRESHOLDS {
                "Rank 1 → Rank 2" "20 curriculum XP"
                "Rank 2 → Rank 3" "24 curriculum XP"
                "Rank 3 → Rank 4" "32 curriculum XP"
                "Rank 4 → Rank 5" "44 curriculum XP"
                "Rank 5 → Rank 6" "60 curriculum XP"
            }

            RULES {
                #L5R388kL0mN2oP4qR6sT8u: curriculum_xp_resets_each_rank "Once a character completes a rank, their school rank increases and they move on to the next rank in their curriculum table. Further experience they spend now counts toward completing their new rank. After a character completes a rank, they do not count the XP spent to complete previous ranks as part of their progress to complete their new rank."
                #L5R389vW1xY3zA5bC7dE9f: completing_school_ranks "Completing School Ranks: To complete their current school rank, a character must spend XP on advancements listed on the curriculum table for that rank. The amount of XP to complete each school rank varies: 20 for Rank 1, 24 for Rank 2, 32 for Rank 3, 44 for Rank 4, and 60 for Rank 5. Advances that do not appear on the curriculum table at that rank contribute only half their XP cost."
            }
        }

        #PkFvvgyWSvREZEdmIzrmds ^"Rank 6 Mastery" DEF {
            #
            # See individual school definitions for Mastery Abilities.

            RULES {
                #L5R390gH2iJ4kL6mN8oP0q: mastery_ability_unlocked_at_rank_six "Unlocking Mastery Abilities: Once a character finishes the fifth rank in their school, they are invited to learn its deepest mysteries. They unlock and gain a Rank 6 Mastery ability that is the capstone to the samurai's studies and allows them to unlock their true potential."
            }
        }

        RULES {
            #L5R392cD4eF6gH8iJ0kL2m: advancing_in_a_school "Advancing in a School: Each dōjō has developed a school curriculum over the centuries that represents its tried-and-true method. A school curriculum consists of a set of tables, each of which corresponds to one of the first five school ranks of a character's school, and a Mastery Ability (Rank 6) that a character unlocks upon completing the first five ranks."
            #L5R394yZ6aB8cD0eF2gH4i: rank_tests_and_ceremonies "Rank Tests and Ceremonies: Some GMs prefer to require that PCs must return to their dōjō to be tested by their teachers to begin each new school rank. Others simply let PCs \"rank up\" immediately. See Real World Experience versus School Secrets for advice on these two methods."
        }
    }
}
