EXTENSION "L5R5e_Mantis_Clan" EXTENDS "L5R5e_Core_Character" {
    NAME "Legend of the Five Rings 5th Edition - The Mantis Clan: Rules for Playing Characters from the Islands of Spice and Silk"
    VERSION "0.5.3"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-03-01"

    # The Mantis Clan expansion: new minor clan, two schools,
    # one new technique, advantages, disadvantages, weapons,
    # armor, equipment, and aquatic NPCs.
    # Published by Fantasy Flight Games.
    # Designed by Max Brooke.

    # ===========================
    # MANTIS CLAN
    # ===========================

    #yON2hrYKfoaLSf0QlFLEc8 ^"Mantis Clan" DEF {
        EXTENDS #L5R250aB2cD4eF6gH8iJ0k ^"Clan"
        APPLIES TO [#L5R003xY4zA6bC8dE0fG2hI ^"Samurai"]

        PROPERTIES {
            ^"Clan Name" STRING "Mantis" FIXED
            ^"Clan Type" STRING "Minor Clan"
            ^"Clan Ring Bonus" DEF { ^"Water" INTEGER 1 }
            ^"Clan Skill Bonus" DEF { ^"Seafaring" INTEGER 1 }
            ^"Clan Status" INTEGER DEFAULT 25
        }

        FAMILIES {
            ^"Families of the Fleet"
        }

        RULES {
            #L5RMC01aB2cD4eF6gH8iJ0k: mantis_clan_minor_clan_traits "The Mantis Minor Clan: The Mantis minor clan are a group of rugged sailors, having grown from a loose alliance of merchants, rōnin, and castoff members of the Great Clans to a massive organization that operates along Rokugan's coastline. While the Crane Clan has historically been one of the Mantis' major clients, recent political turmoil has pushed them apart, and the Mantis have sought allies elsewhere in the Empire. They sail from mainland ports to the Isles of Silk and Spice and beyond, and rival the Unicorn Clan in their exposure to foreign cultures. Having risen from less than the Great Clans, they are not so quick to look down upon those of lower station—but humble origins do nothing to quell the ambitions of their dashing and piratical leader, Mantis Clan Champion Yoritomo."
        }
    }

    # ===========================
    # MANTIS FAMILIES
    # ===========================

    #L5RMC40kL0mN2oP4qR6sT8u ^"Families of the Fleet" DEF {
        EXTENDS #L5R251lM3nO5pQ7rS9tU1v ^"Family"
        APPLIES TO [#L5R003xY4zA6bC8dE0fG2hI ^"Samurai"]

        PROPERTIES {
            ^"Family Name"     STRING "Families of the Fleet" FIXED
            ^"Clan"            STRING "Mantis"
            ^"Ring Increase" DEF { CHOOSE 1 [^"Fire", ^"Water"] INTEGER 1 }
            ^"Skill Increases" DEF {
                ^"Commerce" INTEGER 1
                ^"Survival" INTEGER 1
            }
            ^"Glory"           INTEGER 36
            ^"Wealth" DEF { ^"Count" INTEGER 7  ^"Type" STRING "koku"  ^"Starting" BOOLEAN true }
        }

        RULES {
            #YffJEMfn7fg6BRimt7Ei53: families_of_the_fleet_names "The Families of the Fleet: For complicated historical reasons, the Mantis do not have a family name. Its samurai all belong to the Mantis Clan fleet, however, and so they take their names from the kobune ships they sail with. Tsuraikaze no Kudaka (Kudaka of the Bitter Wind) or Susano-o no Hitoshi (Hitoshi of the Susano-o) are how they style themselves, changing their names as they sign on with different crews. Those Mantis who stay on land are known by the port where they live, such as Kinushima no Miaka or Tokigogachu no Tōya."
        }
    }

    # ===========================
    # SCHOOLS
    # ===========================

    #WiqXym0uFWjtB6DHEtL0BP ^"Storm Fleet Sailor" DEF {
        EXTENDS #L5R252wX4yZ6aB8cD0eF2g ^"School"
        APPLIES TO [#L5R003xY4zA6bC8dE0fG2hI ^"Samurai"]

        PROPERTIES {
            ^"School Name" STRING "Storm Fleet Sailor" FIXED
            ^"Clan" STRING "Mantis"
            ^"Roles" LIST ["Bushi"]
            ^"Ring Increase" DEF {
                ^"Fire" INTEGER 1
                ^"Water" INTEGER 1
            }
            ^"Starting Skills" DEF { CHOOSE 5 [^"Commerce", ^"Fitness", ^"Games", ^"Labor", ^"Martial Arts [Melee]", ^"Martial Arts [Ranged]", ^"Seafaring"] INTEGER 1 }
            ^"Starting Honor" INTEGER DEFAULT 35
            ^"Techniques Available" LIST ["Kata", "Rituals", "Shūji"]
        }

        STARTING_TECHNIQUES {
            KATA ^"Pelting Hail Style"
            SHUJI CHOOSE 1 [^"All in Jest", ^"Stirring the Embers"]
        }

        SCHOOL_ABILITY "Sailor's Fortune" {
            "Once per round when making a Trade skill check, if you are not Compromised, you may receive a number of strife up to your school rank to reroll that many rolled dice."
        }

        MASTERY_ABILITY ^"Storm Lord's Gambit" {
            "You may receive 1 additional strife to use your Sailor's Fortune ability on any check instead of only a Trade skill check."
        }

        STARTING_OUTFIT [
            "Sailor's garb",
            "wakizashi (short sword)",
            "knife",
            "any two weapons of rarity 6 or lower",
            "yumi (bow)",
            "quiver of arrows",
            "traveling pack",
            "rope (twenty feet)",
            "gambling set (cards or dice)",
            "fishing rod and line"
        ]

        CURRICULUM {
            RANK 1 {
                SKILL_GROUP "Trade Skills"
                SKILL "Fitness"
                SKILL "Games"
                SKILL "Martial Arts [Ranged]"
                TECHNIQUE_GROUP "Rank 1 Kata"
                ^"Skulk" [ninjutsu]
                ^"Shallow Waters" [shuji]
            }
            RANK 2 {
                SKILL_GROUP "Martial Skills"
                SKILL "Commerce"
                SKILL "Seafaring"
                SKILL "Survival"
                TECHNIQUE_GROUP "Rank 1-2 Fire Shūji"
                ^"Flowing Water Strike" [kata]
                #TusdWEftluYxKO91YVPB60 ^"Osano-wo's Boast" [shuji]
            }
            RANK 3 {
                SKILL_GROUP "Social Skills"
                SKILL "Martial Arts [Melee]"
                SKILL "Martial Arts [Ranged]"
                SKILL "Seafaring"
                TECHNIQUE_GROUP "Rank 1-3 Water Shūji"
                ^"Bravado" [shuji]
                ^"Heartpiercing Strike" [kata]
            }
            RANK 4 {
                SKILL_GROUP "Trade Skills"
                SKILL "Command"
                SKILL "Martial Arts [Ranged]"
                SKILL "Tactics"
                TECHNIQUE_GROUP "Rank 1-4 Kata"
                ^"Buoyant Arrival" [shuji]
                ^"Crashing Wave Style" [kata]
            }
            RANK 5 {
                SKILL_GROUP "Martial Skills"
                SKILL "Commerce"
                SKILL "Seafaring"
                SKILL "Sentiment"
                TECHNIQUE_GROUP "Rank 1-5 Kata"
                ^"Rouse the Soul" [shuji]
                ^"Sear the Wound" [shuji]
            }
            RANK 6 {
                ^"Storm Lord's Gambit"
            }
        }

        RULES {
            #bDrfN65jjwRLHkfoX4Yg0O: storm_fleet_sailor_description "Storm Fleet Sailor School [Bushi]: Life on the seas between and beyond the Isles of Silk and Spice has made the Mantis Clan practical. Its sailors know most true fights do not take place in a dōjō, but in wild ambushes and on the rocking decks of kobune. A sailor must know when to push their luck—and when to settle for what they have. Opportunists to the core, the warriors of the Mantis Storm Fleet eschew no weapon, push every advantage, and yield only to the rolling sea."
        }
    }

    #t9s2lFRMRlh3a44VUB4y2K ^"Storm Fleet Tide Seer" DEF {
        EXTENDS #L5R252wX4yZ6aB8cD0eF2g ^"School"
        APPLIES TO [#L5R003xY4zA6bC8dE0fG2hI ^"Samurai"]

        PROPERTIES {
            ^"School Name" STRING "Storm Fleet Tide Seer" FIXED
            ^"Clan" STRING "Mantis"
            ^"Roles" LIST ["Shugenja"]
            ^"Ring Increase" DEF {
                ^"Air" INTEGER 1
                ^"Water" INTEGER 1
            }
            ^"Starting Skills" DEF { CHOOSE 3 [^"Commerce", ^"Fitness", ^"Games", ^"Labor", ^"Martial Arts [Melee]", ^"Seafaring", ^"Theology"] INTEGER 1 }
            ^"Starting Honor" INTEGER DEFAULT 40
            ^"Techniques Available" LIST ["Air and Water Invocations", "Rituals", "Shūji"]
        }

        STARTING_TECHNIQUES {
            INVOCATION ^"Dominion of Suijin"
            INVOCATION ^"Tempest of Air"
            INVOCATION CHOOSE 1 [^"Bō of Water", ^"Path to Inner Peace", ^"Yari of Air"]
            RITUAL ^"Commune with the Spirits"
            RITUAL ^"Divination"
        }

        SCHOOL_ABILITY "Eye of the Storm" {
            "When an invocation technique you perform would affect \"each character\" or \"each other character\" at a specified range, you may exclude a number of characters up to your school rank from all effects of the invocation except for spiritual backlash (see page 190 of the core rulebook)."
        }

        MASTERY_ABILITY ^"Storm Surge" {
            "When you perform an invocation that smites one or more targets, treat each target's supernatural resistance as 1 lower per kept (st) symbol on the check."
        }

        STARTING_OUTFIT [
            "Sailor's garb",
            "wakizashi (short sword)",
            "knife",
            "any one weapon of rarity 6 or lower",
            "traveling pack",
            "divination set (cards, shells, or dice)"
        ]

        CURRICULUM {
            RANK 1 {
                SKILL_GROUP "Scholar Skills"
                SKILL "Fitness"
                SKILL "Labor"
                SKILL "Seafaring"
                TECHNIQUE_GROUP "Rank 1 Water Shūji"
                ^"Summon Fog" [invocation]
                ^"Reflections of P'an Ku" [invocation]
            }
            RANK 2 {
                SKILL_GROUP "Trade Skills"
                SKILL "Fitness"
                SKILL "Tactics"
                SKILL "Theology"
                TECHNIQUE_GROUP "Rank 1-2 Air Invocations"
                ^"Hand of the Tides" [invocation]
                ^"Call upon the Wind" [invocation]
            }
            RANK 3 {
                SKILL_GROUP "Scholar Skills"
                SKILL "Performance"
                SKILL "Seafaring"
                SKILL "Survival"
                TECHNIQUE_GROUP "Rank 1-3 Rituals"
                ^"Fury of Osano-wo" [invocation]
                #TusdWEftluYxKO91YVPB60 ^"Osano-wo's Boast" [shuji]
            }
            RANK 4 {
                SKILL_GROUP "Trade Skills"
                SKILL "Command"
                SKILL "Games"
                SKILL "Theology"
                TECHNIQUE_GROUP "Rank 1-4 Water Invocations"
                ^"Wrath of Kaze-no-Kami" [invocation]
                ^"Rise, Water" [invocation]
            }
            RANK 5 {
                SKILL_GROUP "Scholar Skills"
                SKILL "Courtesy"
                SKILL "Seafaring"
                SKILL "Survival"
                TECHNIQUE_GROUP "Rank 1-5 Void Shūji"
                ^"Ever-Changing Waves" [invocation]
                ^"Rise, Air" [invocation]
            }
            RANK 6 {
                ^"Storm Surge"
            }
        }

        RULES {
            #S89rdGgdjLiLG65dPnLuCq: storm_fleet_tide_seer_description "Storm Fleet Tide Seer [Shugenja]: The tenkinja are priests of the tide, trained in the ways of reading the sea and appeasing the kami of wave and storm. These seers have served the Mantis Clan for generations, and without their blessing at the outset of a journey, even the most seasoned of Mantis sailors are uneasy to take to the open ocean. As with most Mantis traditions, the tenkinja have no formal center of learning, instead training individual apprentices during their journeys and periodically congregating in the Isles of Silk and Spice to share the wisdom they have attained."
        }
    }

    # ===========================
    # NEW TECHNIQUES
    # ===========================

    #TusdWEftluYxKO91YVPB60 ^"Osano-wo's Boast" DEF {
        APPLIES TO [#L5R003xY4zA6bC8dE0fG2hI ^"Samurai"]

        PROPERTIES {
            ^"Technique Type" STRING "Shūji" FIXED
            ^"Technique Subtype" STRING "Mantis" FIXED
            ^"Rank" INTEGER DEFAULT 3
            ^"Activation" STRING "Once per game session as a Support action, you may make a TN 2 Command or Performance (Fire) check to boast of a deed you will attempt."
        }

        RULES {
            #L5RMC09kL0mN2oP4qR6sT8u: osanowos_boast_effects "Effects: If you succeed, increase your composure and your endurance by 3. This effect persists until the end of the scene or until you complete the deed of which you boasted. At the end of the scene, if you have not completed the deed, suffer 3 fatigue and 3 strife.\n\nIf you succeed or fail, after you perform this action, any other character in the scene who knows this technique may immediately perform this action (if they have not done so already)."
            #AbALboiSvBStkuVpK2kcII: osanowos_boast_description "Osano-wo's Boast: Like their fabled founder, members of the Mantis Clan often boast of their future glory, to strengthen their own resolve and drive their comrades to greater heights."
        }
    }

    # ===========================
    # ADVANTAGES
    # ===========================

    #USCGyfF0EfsVecCxotQUjL ^"Blood of Osano-wo" DEF {
        EXTENDS #L5R266oP8qR0sT2uV4wX6y ^"Distinction"

        PROPERTIES {
            ^"Ring" STRING "Fire"
            ^"Types" LIST ["Mental", "Spiritual"]
        }

        EFFECT {
            "The Fortune of Storms grants you boldness and a desire not easily satisfied. You cannot be killed by storms (such as by lightning or going overboard in a tempest). If you would die this way, you instead wake up later in a place of the GM's choice, miraculously safe and with 0 Void points."
            "When performing a check for which you need to take a great risk (such as a Games [Fire] check to wager the game on a single gambit or a Seafaring [Fire] check to chart a route through a deadly region) you may reroll up to two dice."
        }
    }

    #8eOTHGRNp0rjxYHunkWgpV ^"Sea Legs" DEF {
        EXTENDS #L5R266oP8qR0sT2uV4wX6y ^"Distinction"

        PROPERTIES {
            ^"Ring" STRING "Water"
            ^"Types" LIST ["Physical"]
        }

        EFFECT {
            "You never get seasick, and can maintain your balance easily on a rocking ship. You always feel slightly disconcerted on stable ground, however."
            "When performing a check for which you need stay balanced on a shifting surface (such as a Martial Arts [Ranged] [Water] check to make a bow shot during a boarding attack or Seafaring [Water] check to adjust the sails during a storm), you may reroll up to two dice."
        }
    }

    #vaQayqiGYHrD5faCk4kdgP ^"Knotwork" DEF {
        EXTENDS #L5R267zA9bC1dE3fG5hI7j ^"Passion"

        PROPERTIES {
            ^"Ring" STRING "Air"
            ^"Types" LIST ["Mental"]
        }

        EFFECT {
            "You can identify and tie dozens of different knots, and know their appropriate uses and the meanings each one carries."
            "After performing a check to interact with a knot (such as a Design [Air] check to add a decorative knot to your garb or a Seafaring [Air] check to secure your vessel's rigging), you remove 3 strife."
        }
    }

    # ===========================
    # DISADVANTAGES
    # ===========================

    #spD8tY0uLzqoQ1kitnO8cE ^"Sailor's Tongue" DEF {
        EXTENDS #L5R268kL0mN2oP4qR6sT8u ^"Adversity"

        PROPERTIES {
            ^"Ring" STRING "Air"
            ^"Types" LIST ["Mental", "Interpersonal"]
        }

        EFFECT {
            "Your speech is often punctuated by a combative tone or idioms that others find difficult to understand or even vulgar."
            "When performing a check to speak politely (such as a Courtesy [Air] check to pay a compliment at court or a Culture [Air] check to know if something is rude to discuss), you must choose and reroll two dice containing (su) or (ex). After resolving the check, if you failed, you gain 1 Void point."
        }
    }

    # ===========================
    # WEAPONS
    # ===========================

    #H5TEd13s8Z7rn756iT4KOC ^"Butterfly Sword" DEF {
        APPLIES TO [#t15d6e712d575d4eb481da ^"Equipment"]

        PROPERTIES {
            ^"Category" STRING "Swords" FIXED
            ^"Skill" STRING "Martial Arts [Melee]"
            ^"Range" STRING "0-1"
            ^"Damage" INTEGER DEFAULT 3
            ^"Deadliness" INTEGER DEFAULT 5
            ^"Grips" STRING "1-hand: -"
            ^"Qualities" STRING "Concealable, Snaring"
            ^"Rarity" INTEGER DEFAULT 6
            ^"Cost" STRING "10 koku"
        }

        RULES {
            #L5RMC14nO5pQ7rS9tU1vW3x: weapon_butterfly_sword "Butterfly Sword: Short, slashing blades often designed with hooks above the guard, these blades are extremely versatile—easily concealed on one's person, offensively and defensively potent, and useful as a tool. Often wielded in pairs and usually custom-made for an individual wielder, butterfly swords are a favorite of many Mantis sailors."
        }
    }

    #RcwfpyBYcmBeEJFrBmq3D7 ^"Sai" DEF {
        APPLIES TO [#t15d6e712d575d4eb481da ^"Equipment"]

        PROPERTIES {
            ^"Category" STRING "Hand Weapons" FIXED
            ^"Skill" STRING "Martial Arts [Melee]"
            ^"Range" STRING "0"
            ^"Damage" INTEGER DEFAULT 2
            ^"Deadliness" INTEGER DEFAULT 2
            ^"Grips" STRING "1-hand: -"
            ^"Qualities" STRING "Concealable, Snaring"
            ^"Rarity" INTEGER DEFAULT 6
            ^"Cost" STRING "2 koku"
        }

        RULES {
            #L5RMC15yZ6aB8cD0eF2gH4i: weapon_sai "Sai: A sai is a forked weapon that appears in many places and may be an ancestor of the jitte. Unicorn travelers have even reported seeing such weapons in the Ivory Kingdoms, and some archives in Rokugan from ancient days contain drawings of similar designs. The sai is commonly used in the Isles of Silk and Spice, wielded as a pair and usually blunted at the tips to allow a warrior to trap, control, punch, and jab to subdue a foe.\n\nWhile you have a pair of sai readied, reduce the (op) you must spend to activate their Snaring quality by 1."
        }
    }

    #A5743sqlm8tP14tUgmtItb ^"Tonfa" DEF {
        APPLIES TO [#t15d6e712d575d4eb481da ^"Equipment"]

        PROPERTIES {
            ^"Category" STRING "Hand Weapons" FIXED
            ^"Skill" STRING "Martial Arts [Melee]"
            ^"Range" STRING "0-1"
            ^"Damage" INTEGER DEFAULT 3
            ^"Deadliness" INTEGER DEFAULT 3
            ^"Grips" STRING "1-hand: -"
            ^"Qualities" STRING "Concealable, Durable"
            ^"Rarity" INTEGER DEFAULT 5
            ^"Cost" STRING "4 koku"
        }

        RULES {
            #L5RMC16jK7lM9nO1pQ3rS5t: weapon_tonfa "Tonfa: Another ancient design of uncertain origins, the tonfa is a thick stock attached at a 90-degree angle to a handle that allows it to spin freely. An incredibly versatile defensive weapon, a tonfa can be used to reinforce blocks and launch blisteringly fast short circular attacks. Tonfa are often wielded in pairs, or alongside an open hand.\n\nAs a Movement and Support action, if you have a tonfa readied, you may increase the TN of the next Attack action check targeting you by 1 and decrease the TN of your next Attack action check using a tonfa by 1. This effect persists until the end of your next turn."
        }
    }

    #hxyvuCVLcgokyyrFOxiXUj ^"Eku" DEF {
        APPLIES TO [#t15d6e712d575d4eb481da ^"Equipment"]

        PROPERTIES {
            ^"Category" STRING "Polearms" FIXED
            ^"Skill" STRING "Martial Arts [Melee]"
            ^"Range" STRING "2"
            ^"Damage" INTEGER DEFAULT 6
            ^"Deadliness" INTEGER DEFAULT 4
            ^"Grips" STRING "2-hand: -"
            ^"Qualities" STRING "Cumbersome, Durable, Mundane"
            ^"Rarity" INTEGER DEFAULT 5
            ^"Cost" STRING "3 koku"
        }

        RULES {
            #L5RMC17uV8wX0yZ2aB4cD6e: weapon_eku "Eku: An eku is a weaponized oar, wielded as a polearm. Like the smith's hammer or the farmer's hoe, it likely came into being as a tool and was turned to violent purpose when seafarers came under attack and needed something with which to defend themselves. Heavier than a staff and harder to wield, the eku is a surprisingly dangerous weapon, best used for sweeping attacks. Mantis sailors tell of similar weapons made of wood or even whale-bone wielded by warriors of other seafaring cultures they have encountered."
        }
    }

    #Mqx0rCJKH0GmZ9doD8Je3D ^"Tinbe" DEF {
        APPLIES TO [#t15d6e712d575d4eb481da ^"Equipment"]

        PROPERTIES {
            ^"Category" STRING "Polearms" FIXED
            ^"Skill" STRING "Martial Arts [Melee]"
            ^"Range" STRING "0-1"
            ^"Damage" INTEGER DEFAULT 3
            ^"Deadliness" INTEGER DEFAULT 5
            ^"Grips" STRING "1-hand: -"
            ^"Qualities" STRING "-"
            ^"Rarity" INTEGER DEFAULT 6
            ^"Cost" STRING "15 koku"
        }

        RULES {
            #L5RMC18fG9hI1jK3lM5nO7p: weapon_tinbe "Tinbe-Rochin: A tinbe-rochin is actually two weapons wielded as a pair: a short spear (the tinbe) and a small shield (the rochin), both excellent for close quarters or the rolling deck of a ship. The haft of the tinbe is cut short, and the head is often shaped to accommodate both stabbing and slashing motions. The rochin can be made of many different materials, including wood or turtle shell, and is generally used to deflect rather than block with full force. If executed properly, this allows the wielder to open their opponent to a killing strike with the tinbe."
        }
    }

    #WJPY4OX3mwYEhJeVBRRzQ7 ^"Rochin" DEF {
        APPLIES TO [#t15d6e712d575d4eb481da ^"Equipment"]

        PROPERTIES {
            ^"Category" STRING "Shields" FIXED
            ^"Skill" STRING "Martial Arts [Melee]"
            ^"Range" STRING "0"
            ^"Damage" INTEGER DEFAULT 2
            ^"Deadliness" INTEGER DEFAULT 2
            ^"Grips" STRING "1-hand: -"
            ^"Qualities" STRING "Durable"
            ^"Rarity" INTEGER DEFAULT 6
            ^"Cost" STRING "25 koku"
        }

        RULES {
            #L5RMC19qR0sT2uV4wX6yZ8a: weapon_rochin_shield "Tinbe-Rochin: A rochin is a shield, and a character can only wield one shield at a time. As a Movement and Support action, if you have a rochin readied, you may increase the TN of the next Attack action check made targeting you by 1 and decrease the TN of your next Attack action check using a tinbe by 1. This effect persists until the end of your next turn."
        }
    }

    # ===========================
    # ARMOR
    # ===========================

    #Xod50M2Fm8sIe7sWbgAxN7 ^"Sailor's Garb" DEF {
        APPLIES TO [#t15d6e712d575d4eb481da ^"Equipment"]

        PROPERTIES {
            ^"Category" STRING "Armor" FIXED
            ^"Resistance Values" STRING "Physical 1"
            ^"Qualities" STRING "Durable, Mundane"
            ^"Rarity" INTEGER DEFAULT 2
            ^"Cost" STRING "1 bu"
        }

        RULES {
            #L5RMC20bC1dE3fG5hI7jK9l: armor_sailors_garb "Sailor's Garb: Mantis sailors generally dress in practical clothes made of sturdy, resilient cloth that will not fall apart when soaked by the sea or baked by the sun. These clothes are also generally easy to repair, even aboard a ship where supplies are often very scare.\n\nReduce the TN of checks to repair or maintain sailor's garb by 1."
        }
    }

    #0qHUDumEa580UVyIsw5f4x ^"Shark Leather Armor" DEF {
        APPLIES TO [#t15d6e712d575d4eb481da ^"Equipment"]

        PROPERTIES {
            ^"Category" STRING "Armor" FIXED
            ^"Resistance Values" STRING "Physical 2"
            ^"Qualities" STRING "Resplendent"
            ^"Rarity" INTEGER DEFAULT 7
            ^"Cost" STRING "12 koku"
        }

        RULES {
            #L5RMC21mN2oP4qR6sT8uV0w: armor_shark_leather "Shark Leather Armor: While the flesh of beasts is considered unclean by some traditionalist samurai, leather can also be harvested from fish such as sharks and rays. Rokugani swords often incorporate this leather in their grip, and through special treatment, it can be used to make lightweight armor, especially if reinforced with wood or metal bands. Leather does little to deflect oncoming attacks, but it is hard to pierce, protecting the wearer against telling blows. Many Mantis samurai who can afford it favor its light weight and striking looks.\n\nWhen you succeed at a check to resist a critical strike while wearing this armor, add two bonus successes."
        }
    }

    # ===========================
    # EQUIPMENT
    # ===========================

    #4WGxb1fuRy3Sn3qgNKg6pv ^"Astrolabe" DEF {
        APPLIES TO [#t15d6e712d575d4eb481da ^"Equipment"]

        PROPERTIES {
            ^"Category" STRING "Equipment" FIXED
            ^"Rarity" INTEGER DEFAULT 10
            ^"Cost" STRING "30 koku"
        }

        RULES {
            #L5RMC22xY3zA5bC7dE9fG1h: equipment_astrolabe "Astrolabe: Rokugani scholars have long studied the sky and the movement of celestial bodies, and their records date back to the start of the Empire, but the refined use of this information for navigation has been refined even further in other lands. Traders who encounter vessels from the Qamarist Caliphate often go to great lengths to acquire the navigation devices called astrolabes, or star-takers. Developed using advanced mathematics to identify and precisely note the position of celestial bodies in the sky, these devices are costly to acquire—but invaluable to any sea captain who ventures into waters uncharted. (Cost: 30 koku. Rarity: 10.)"
        }
    }

    #tuCeS1vaPDkbVmH7Pew0wz ^"Fishing Rod and Line" DEF {
        APPLIES TO [#t15d6e712d575d4eb481da ^"Equipment"]

        PROPERTIES {
            ^"Category" STRING "Equipment" FIXED
            ^"Rarity" INTEGER DEFAULT 1
            ^"Cost" STRING "1 bu"
        }

        RULES {
            #L5RMC23iJ4kL6mN8oP0qR2s: equipment_fishing_rod "Fishing Rod and Line: On long voyages or while moored at far-flung ports, fishing is not only a profitable activity, but also a way to pass the time in quiet contemplation. As such, many members of the Mantis Clan carry a fishing rod, and spend their spare time tying or cutting lures. So popular a pastime is fishing that an old story claims the iconic, sickle-shaped kama was first picked up by a curious Mantis captain who mistook it for a fishhook. (Cost: 1 bu. Rarity: 1.)"
        }
    }

    #KOzTpU6HhSZyLnBCWimhXP ^"Taraibune" DEF {
        APPLIES TO [#t15d6e712d575d4eb481da ^"Equipment"]

        PROPERTIES {
            ^"Category" STRING "Equipment" FIXED
            ^"Rarity" INTEGER DEFAULT 4
            ^"Cost" STRING "1 koku"
        }

        RULES {
            #L5RMC24tU5vW7xY9zA1bC3d: equipment_taraibune "Taraibune: Sometimes called \"tub boats,\" taraibune are small, barrel-shaped, circular vessels five to six feet in diameter, designed for one operator who steers by oar. Sturdy and cheap to build, they serve as additional vessels for families in many fishing villages across Rokugan, and as single-person landing craft aboard some Mantis vessels. (Cost: 1 koku. Rarity: 4.)"
        }
    }

    # ===========================
    # AQUATIC NPCs
    # ===========================

    #Tl5ocxMgVcPkQJ3FhlTmND ^"Eel" DEF {
        EXTENDS #t4540de6f35155c46f41f0 ^"NPC"

        PROPERTIES {
            ^"Type" STRING "Minion" FIXED
            ^"Category" STRING "Animal"
            ^"Combat Conflict Rank" INTEGER 1
            ^"Intrigue Conflict Rank" INTEGER 0
            ^"Description" STRING "Eels are long, slippery fish. Scavengers or predators, they can be aggressive if provoked, but generally prefer to hide within crevasses, striking at smaller prey when the time is right. Eel is a popular food in Rokugan."
            ^"Rings" DEF {
                ^"Air" INTEGER 1
                ^"Earth" INTEGER 1
                ^"Fire" INTEGER 1
                ^"Water" INTEGER 2
                ^"Void" INTEGER 1
            }
            ^"Endurance" INTEGER 3
            ^"Composure" INTEGER 4
            ^"Focus" INTEGER 2
            ^"Vigilance" INTEGER 1
            ^"Silhouette" INTEGER 1
            ^"Demeanor" STRING "Skittish"
            ^"Social Skill Check TN Modifiers" STRING "Fire +2, Earth -2"
            ^"Skills" LIST OF STRING []
            ^"Advantages" LIST OF STRING ["Slippery (Void) [Martial; Physical]"]
            ^"Disadvantages" LIST OF STRING ["Easily Baited (Earth) [Interpersonal; Mental]"]
            ^"Favored Weapons" LIST OF STRING ["Razor Teeth: Range 0, Damage 2, Deadliness 4"]
        }

        #rZK2E4bQCWBBCQI20UExPm ^"Swarming Hunter" DEF {

            RULES {
                #cF7dR8ohQAeiEXdx2KuJEO: swarming_hunter "Swarming Hunter: An eel is a silhouette 1 aquatic animal. When making an Attack action check with assistance, an eel may spend (op) as follows:\n\n(op)+: One character other than the target at range 0–2 suffers 2 physical damage. This (op) can be activated a number of times per round equal to the number of eels assisting with the check."
            }
        }

        RULES {
            #L5RMC25eF6gH8iJ0kL2mN4o: npc_eel "Eels are long, slippery fish. Scavengers or predators, they can be aggressive if provoked, but generally prefer to hide within crevasses, striking at smaller prey when the time is right. Eel is a popular food in Rokugan."
        }
    }

    #kghRAWLpRvhlL0isjNv3la ^"Octopus" DEF {
        EXTENDS #t4540de6f35155c46f41f0 ^"NPC"

        PROPERTIES {
            ^"Type" STRING "Minion" FIXED
            ^"Category" STRING "Animal"
            ^"Combat Conflict Rank" INTEGER 3
            ^"Intrigue Conflict Rank" INTEGER 1
            ^"Description" STRING "One of the strangest creatures of the sea, the octopus is remarkably intelligent, capable of changing its skin color and even texture to blend into its environment and getting into or out of nearly any enclosure. These creatures are short-lived, but their curiosity and cunning is legendary. Ranging in size from tiny specimens to behemoths nearly as large as a person, their strangeness makes them the subject of fascination for humans. Octopus is also a delicacy in coastal Rokugan."
            ^"Rings" DEF {
                ^"Air" INTEGER 3
                ^"Earth" INTEGER 1
                ^"Fire" INTEGER 3
                ^"Water" INTEGER 3
                ^"Void" INTEGER 1
            }
            ^"Endurance" INTEGER 3
            ^"Composure" INTEGER 6
            ^"Focus" INTEGER 6
            ^"Vigilance" INTEGER 3
            ^"Silhouette" INTEGER 1
            ^"Demeanor" STRING "Curious"
            ^"Social Skill Check TN Modifiers" STRING "Air +2, Void -2"
            ^"Skills" LIST OF STRING ["Martial 1"]
            ^"Advantages" LIST OF STRING ["Flexibility of Form (Void) [Martial, Trade; Physical]"]
            ^"Disadvantages" LIST OF STRING ["Easily Startled (Earth) [Martial; Mental]"]
            ^"Favored Weapons" LIST OF STRING ["Sharp Beak: Range 0, Damage 1, Deadliness 4, Razor-edged", "Arms: Range 0, Damage 3, Deadliness 2, Snaring"]
        }

        #ywyIu7xdQSIZj5QTaH2ZBd ^"Master of Disguise" DEF {

            RULES {
                #JWOlG1sTRxOmumktZHB1l5: master_of_disguise "Master of Disguise: An octopus is a silhouette 1 aquatic animal. When performing a check, an octopus may spend (op) as follows:\n\n(op)+: The octopus disguises itself in its environment, causing each character with vigilance lower than or equal to the (op) spent this way to lose sight of it."
            }
        }

        RULES {
            #L5RMC26pQ7rS9tU1vW3xY5z: npc_octopus "One of the strangest creatures of the sea, the octopus is remarkably intelligent, capable of changing its skin color and even texture to blend into its environment and getting into or out of nearly any enclosure. These creatures are short-lived, but their curiosity and cunning is legendary. Ranging in size from tiny specimens to behemoths nearly as large as a person, their strangeness makes them the subject of fascination for humans. Octopus is also a delicacy in coastal Rokugan."
        }
    }

    #FGcoPXSxwkvLA7tQZYowBY ^"Shark" DEF {
        EXTENDS #t4540de6f35155c46f41f0 ^"NPC"

        PROPERTIES {
            ^"Type" STRING "Minion" FIXED
            ^"Category" STRING "Animal"
            ^"Combat Conflict Rank" INTEGER 7
            ^"Intrigue Conflict Rank" INTEGER 0
            ^"Description" STRING "The triangle fin of a shark cutting through the waves sends chills down many a sailor's spine. Despite the fear they evoke, even large sharks rarely hunt humans. By contrast, shark fishing is common, and hunting a shark is a rite of passage in the Isles of Silk and Spice."
            ^"Rings" DEF {
                ^"Air" INTEGER 2
                ^"Earth" INTEGER 2
                ^"Fire" INTEGER 4
                ^"Water" INTEGER 4
                ^"Void" INTEGER 3
            }
            ^"Endurance" INTEGER 12
            ^"Composure" INTEGER 9
            ^"Focus" INTEGER 8
            ^"Vigilance" INTEGER 2
            ^"Silhouette" INTEGER 3
            ^"Demeanor" STRING "Intimidating"
            ^"Social Skill Check TN Modifiers" STRING "Fire +2, Water -2"
            ^"Skills" LIST OF STRING ["Martial 3"]
            ^"Advantages" LIST OF STRING ["Blood Tracker (Water) [Trade; Mental]", "Sinuous Power (Void) [Martial; Physical]"]
            ^"Disadvantages" LIST OF STRING ["Feeding Frenzy (Earth) [Trade; Mental]"]
            ^"Favored Weapons" LIST OF STRING ["Bite: Range 0, Damage 6, Deadliness 6, Razor-edged"]
        }

        #cS3lc0HIs9Wyrh7UFZOsDH ^"Apex Hunter of the Seas" DEF {

            RULES {
                #TjtHZnlkSRz4nam1mFJxTQ: apex_hunter_of_the_seas "Apex Hunter of the Seas: A shark is a silhouette 3 aquatic animal. Increase the deadliness of its bite against a Bleeding target by 4."
            }
        }

        #CjQczKB1kuoWM1lwdMCiQA ^"Blood in the Water" DEF {

            RULES {
                #S56Yy2VyT0CA1BrjTjCGs5: blood_in_the_water "Blood in the Water: As an Attack and Movement action, a shark may make a TN 2 Fitness (Water) check to slam a target at range 0–1. If it succeeds, the target suffers the Dazed condition, and must resist with a TN 3 Fitness check (Earth 2, Fire 5) or suffer the Bleeding condition."
            }
        }

        RULES {
            #L5RMC27aB8cD0eF2gH4iJ6k: npc_shark "The triangle fin of a shark cutting through the waves sends chills down many a sailor's spine. Despite the fear they evoke, even large sharks rarely hunt humans. By contrast, shark fishing is common, and hunting a shark is a rite of passage in the Isles of Silk and Spice."
        }
    }

    #5BxDMOhZ3NXYi9OJHezqvL ^"Ningyo" DEF {
        EXTENDS #t4540de6f35155c46f41f0 ^"NPC"

        PROPERTIES {
            ^"Type" STRING "Adversary" FIXED
            ^"Category" STRING "Spirit"
            ^"Combat Conflict Rank" INTEGER 4
            ^"Intrigue Conflict Rank" INTEGER 5
            ^"Description" STRING "To most Rokugani, the idea of a city beneath the waves, filled with piscine folk called ningyo, seems nothing more than a fanciful tale—a myth of ancient days. The Kami Shiba was said to have visited such a place during his mythic journeys, but if such a place exists, it has been forgotten. Sailors claim to have seen ningyo; in their stories, sometimes ningyo are friendly despite their predatory appearance—and other times they are merciless hunters."
            ^"Rings" DEF {
                ^"Air" INTEGER 3
                ^"Earth" INTEGER 1
                ^"Fire" INTEGER 2
                ^"Water" INTEGER 4
                ^"Void" INTEGER 2
            }
            ^"Endurance" INTEGER 7
            ^"Composure" INTEGER 12
            ^"Focus" INTEGER 6
            ^"Vigilance" INTEGER 2
            ^"Silhouette" INTEGER 2
            ^"Honor" INTEGER 40
            ^"Glory" INTEGER 12
            ^"Status" INTEGER 6
            ^"Demeanor" STRING "Curious"
            ^"Social Skill Check TN Modifiers" STRING "Air +2, Void -2"
            ^"Skills" LIST OF STRING ["Artisan 1", "Martial 1", "Scholar 2", "Social 3", "Trade 2"]
            ^"Advantages" LIST OF STRING ["Natural Swimmer (Void) [Martial; Physical]"]
            ^"Disadvantages" LIST OF STRING ["Distrustful of Humans (Void) [Social; Interpersonal]"]
            ^"Favored Weapons" LIST OF STRING ["Coral-tipped Spear: Range 1, Damage 5, Deadliness 4, Ceremonial, Durable"]
            ^"Gear" LIST OF STRING ["Shark leather armor (Physical 2)", "Valuable shells", "Etched bones"]
        }

        #Odg1KrBJdbRTK86Gn3d1D0 ^"Aquatic Humanoid" DEF {

            RULES {
                #MriCWJxcEAl2zi398kyJbh: aquatic_humanoid "Aquatic Humanoid: A ningyo is an aquatic being of silhouette 2."
            }
        }

        #SEZV033SDdvHsqtSB8whSx ^"Drag Under" DEF {

            RULES {
                #ffROsubMnKZloCTjM4sDhP: drag_under "Drag Under: Activation: When making an attack action check, a ningyo may spend (op) as follows:\n\nWater (op)+: The ningyo attempt to drag one of its targets with vigilance lower than or equal to the (op) spent this way beneath the waves. If it succeeds, the target must resist with a TN 3 Fitness check (Earth 1, Fire 4) or be pulled 1 range band under water and begin to suffocate (see p. 269 of the core rulebook)."
            }
        }

        RULES {
            #L5RMC28lM9nO1pQ3rS5tU7v: npc_ningyo "To most Rokugani, the idea of a city beneath the waves, filled with piscine folk called ningyo, seems nothing more than a fanciful tale—a myth of ancient days. The Kami Shiba was said to have visited such a place during his mythic journeys, but if such a place exists, it has been forgotten. Sailors claim to have seen ningyo; in their stories, sometimes ningyo are friendly despite their predatory appearance—and other times they are merciless hunters."
        }
    }

    #rAjh3vro5Fz7OxTNop0C0j ^"Sea Troll" DEF {
        EXTENDS #t4540de6f35155c46f41f0 ^"NPC"

        PROPERTIES {
            ^"Type" STRING "Adversary" FIXED
            ^"Category" STRING "Otherworldly"
            ^"Combat Conflict Rank" INTEGER 7
            ^"Intrigue Conflict Rank" INTEGER 4
            ^"Description" STRING "Trolls are ancient and mysterious beings—intelligent but often belligerent, wise but often short-tempered. Whether sea trolls are the same species as their landborne cousins or merely superficially similar in the manner of humans and ningyo remains a topic of debate by those few scholars who even believe they exist."
            ^"Rings" DEF {
                ^"Air" INTEGER 2
                ^"Earth" INTEGER 3
                ^"Fire" INTEGER 4
                ^"Water" INTEGER 5
                ^"Void" INTEGER 4
            }
            ^"Endurance" INTEGER 14
            ^"Composure" INTEGER 9
            ^"Focus" INTEGER 4
            ^"Vigilance" INTEGER 3
            ^"Silhouette" INTEGER 4
            ^"Honor" INTEGER 25
            ^"Glory" INTEGER 10
            ^"Status" INTEGER 5
            ^"Demeanor" STRING "Covetous"
            ^"Social Skill Check TN Modifiers" STRING "Earth +2, Water -2"
            ^"Skills" LIST OF STRING ["Artisan 1", "Martial 3", "Scholar 3", "Social 1", "Trade 1"]
            ^"Advantages" LIST OF STRING ["Surprisingly Stealthy (Water) [Martial; Physical]"]
            ^"Disadvantages" LIST OF STRING ["Insatiable Appetite (Void) [Social; Physical]"]
            ^"Favored Weapons" LIST OF STRING ["Rending Grip: Range 1, Damage 4, Deadliness 6"]
            ^"Gear" LIST OF STRING ["Rough hide (Physical 2, Supernatural 2)", "Collection of detritus"]
        }

        #wXTva4r4CxVXVZdxfX8M8H ^"Ancient and Powerful" DEF {

            RULES {
                #b9wN5l5Vp5pxizalMQr7IR: ancient_and_powerful "Ancient and Powerful: A sea troll is an aquatic Otherworldly being of silhouette 4."
            }
        }

        #7ABnMMTHhJGma7D7Mq9KBa ^"Mystical Diffusion" DEF {

            RULES {
                #b0HXkmqXTfyV8LmQJEe6o9: mystical_diffusion "Mystical Diffusion: While a sea troll is fully submerged in the water, its supernatural resistance is 8."
            }
        }

        RULES {
            #L5RMC29wX0yZ2aB4cD6eF8g: npc_sea_troll "Trolls are ancient and mysterious beings—intelligent but often belligerent, wise but often short-tempered. Whether sea trolls are the same species as their landborne cousins or merely superficially similar in the manner of humans and ningyo remains a topic of debate by those few scholars who even believe they exist."
        }
    }
}
