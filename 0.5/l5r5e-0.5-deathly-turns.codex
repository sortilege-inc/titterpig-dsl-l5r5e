# .codex SECTION — Deathly Turns (supplemental encounters). Stand-off graph over
# l5r5e-0.5-deathly-turns.lore (spec §25). Part of the L5R5e system graph;
# DEPENDS_ON the shared schema.
#
# The cast (l5r5e-0.5-deathly-turns-cast.ttrpg) and the two new traditions
# (l5r5e-0.5-deathly-turns-mechanics.ttrpg) are DEFs — referenced via ^"...", never
# minted. Jigoku, Gaki-dō, Ningen-dō, Emma-Ō, the Falcon Clan, and Lonely Shore
# City are already in the graph — referenced, and Jigoku / Gaki-dō / Emma-Ō / the
# Falcon Clan / Lonely Shore City amended. This section mints the Spirit-Realm
# places (the Bleak Place, Hiniku's Estate), the Fel Mantle artifact, the Phantom
# Hunters, and the lore-only figures (the maō Burakakin, Hagane's victims Kakita
# Sadao and Doji Yūdai, his target Shiba Akifusa, and the magistrate Daidoji
# Himanari).

CODEX "L5R5e_DeathlyTurns_Codex" {
    NAME "Deathly Turns — Lore Graph"
    VERSION "0.5.2"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-09-03"
    FOR EDITION "l5r5e"
    DEPENDS_ON "L5R5e_Codex_Schema" VERSION "0.5.9"

    # ---- Spirit-Realm places ----------------------------------------------
    ENTITY #L5RcxDT01bleakplace ^"The Bleak Place" {
        IS ^"Landmark"
        SOURCE "l5r5e-0.5-deathly-turns.lore" AT "the-bleak-place"
        RELATIONSHIPS { ^"located-in" -> ^"Jigoku" FROM "Jya-Aku has chosen to meet the Brute here because she knows that the denizens of Jigoku shun the Bleak Place, making it as “safe”" }
    }
    ENTITY #L5RcxDT02hinikuestate ^"Hiniku's Estate" {
        IS ^"Building"
        SOURCE "l5r5e-0.5-deathly-turns.lore" AT "a-hungry-swarm"
        RELATIONSHIPS { ^"located-in" -> ^"Gaki-dō" FROM "them per the instructions on page 14 of Wheel of Judgment; they reappear at the threshold between Jigoku and Gaki-dō near Hiniku’s estate, rather than in Jigoku." }
    }

    # ---- The artifact ------------------------------------------------------
    ENTITY #L5RcxDT03felmantle ^"Fel Mantle" {
        IS ^"Artifact"
        SOURCE "l5r5e-0.5-deathly-turns.lore" AT "mahō-master"
        RELATIONSHIPS { ^"wielded-by" -> ^"Jya-Aku" FROM "Jya-Aku is a Tainted being, and while wearing the Fel Mantle she is also an Otherworldly being." }
    }

    # ---- The Falcon Clan's hunters -----------------------------------------
    ENTITY #L5RcxDT04phantomhunters ^"Phantom Hunters" {
        IS ^"Organization"
        SOURCE "l5r5e-0.5-deathly-turns.lore" AT "lady-mazoku"
        RELATIONSHIPS {
            ^"operated-by" -> ^"Falcon Clan"
            ^"led-by"      -> ^"Lady Mazoku (Deathly Turns)" }
    }

    # ---- Lore-only figures -------------------------------------------------
    ENTITY #L5RcxDT05burakakin ^"Burakakin" {
        IS ^"Person"
        SOURCE "l5r5e-0.5-deathly-turns.lore" AT "blood-and-magic"
    }
    ENTITY #L5RcxDT06kakitasadao ^"Kakita Sadao" {
        IS ^"Person"
        SOURCE "l5r5e-0.5-deathly-turns.lore" AT "the-first-victim"
        RELATIONSHIPS {
            ^"member-of" -> ^"Kakita" FROM "Kakita Sadao, the old instructor of the city’s Whispering Blade Dōjō, was recently found dead, apparently cut down by some unknown opponent during what appears to have been an unsanctioned duel."
            ^"enemy-of"  -> ^"Hagane" }
    }
    ENTITY #L5RcxDT07dojiyudai ^"Doji Yūdai" {
        IS ^"Person"
        SOURCE "l5r5e-0.5-deathly-turns.lore" AT "the-first-victim"
        RELATIONSHIPS {
            ^"member-of" -> ^"Doji"   FROM "The other victim was an aged duelist named Doji Yūdai, in a dōjō in the Eastern Petal Village, near Otosan Uchi."
            ^"enemy-of"  -> ^"Hagane" }
    }
    ENTITY #L5RcxDT08shibaakifusa ^"Shiba Akifusa" {
        IS ^"Person"
        SOURCE "l5r5e-0.5-deathly-turns.lore" AT "the-common-thread"
        RELATIONSHIPS { ^"member-of" -> ^"Shiba" FROM "The PCs can eliminate all of the letter writers as potential new victims except for one: Shiba Akifusa, who lives in Nikesake, in Phoenix lands." }
    }
    ENTITY #L5RcxDT09daidojihimanari ^"Daidoji Himanari" {
        IS ^"Person"
        SOURCE "l5r5e-0.5-deathly-turns.lore" AT "a-mission-from-lady-mazoku"
        RELATIONSHIPS {
            ^"member-of" -> ^"Daidoji"           FROM "If the PCs are less involved with the supernatural (or if this is the jumping-off point for a new afterlife-themed campaign), the encounter can begin at The First Victim (see page 16) with Lonely Shore City Magistrate Daidoji Himanari asking the PCs to investigate a murder that others have deemed a simple vendetta."
            ^"oversees"  -> ^"Lonely Shore City" FROM "If the PCs are less involved with the supernatural (or if this is the jumping-off point for a new afterlife-themed campaign), the encounter can begin at The First Victim (see page 16) with Lonely Shore City Magistrate Daidoji Himanari asking the PCs to investigate a murder that others have deemed a simple vendetta." }
    }

    # ---- Amendments to existing graph nodes --------------------------------
    ENTITY #dxZqma7ZjHAchU0QH68gsw ^"Jigoku" {
        SOURCE "l5r5e-0.5-deathly-turns.lore" AT "importantif-you-intend-to-be-a-player-in-wheel-of-judgment-you-should-not-read-past-this-point-doing-so-will-spoil-the-adventure-for-you"
    }
    ENTITY #RqYnjyPUJCpWX1PDhv7Cyq ^"Gaki-dō" {
        SOURCE "l5r5e-0.5-deathly-turns.lore" AT "importantif-you-intend-to-be-a-player-in-wheel-of-judgment-you-should-not-read-past-this-point-doing-so-will-spoil-the-adventure-for-you"
    }
    ENTITY #ochgDY2Xtf8ZuzKVlnYPUV ^"Emma-Ō" {
        SOURCE "l5r5e-0.5-deathly-turns.lore" AT "blood-and-magic"
    }
    ENTITY #7T7QyRQtJRniiLFd2LhClw ^"Falcon Clan" {
        SOURCE "l5r5e-0.5-deathly-turns.lore" AT "a-mission-from-lady-mazoku"
    }
    ENTITY #9R1cVpF7d3uRxtN1hJsAKf ^"Lonely Shore City" {
        SOURCE "l5r5e-0.5-deathly-turns.lore" AT "a-mission-from-lady-mazoku"
    }
}
