                SKILL_GROUP "Scholar Skills"
                SKILL "Fitness"
                SKILL "Martial Arts [Melee]"
                SKILL "Survival"
                TECHNIQUE_GROUP "Rank 1-2 Earth and Water Shūji"
                ^"Tail Sweep" [kata]
                ^"Razor Bite" [kata]
            }
            RANK 3 {
                SKILL_GROUP "Social Skills"
                SKILL "Martial Arts [Melee]"
                SKILL "Survival"
                SKILL "Theology"
                TECHNIQUE_GROUP "Rank 1-3 Kata"
                ^"Tumbling Oak Style" [kata]
                ^"Ebb and Flow" [shuji]
            }
            RANK 4 {
                SKILL_GROUP "Martial Skills"
                SKILL "Culture"
                SKILL "Sentiment"
                SKILL "Theology"
                TECHNIQUE_GROUP "Rank 1-4 Shūji"
                ^"The Immovable Hand of Peace" [shuji]
                ^"Crashing Wave Style" [kata]
            }
            RANK 5 {
                SKILL_GROUP "Social Skills"
                SKILL "Martial Arts [Melee]"
                SKILL "Medicine"
                SKILL "Theology"
                TECHNIQUE_GROUP "Rank 1-4 Kata"
                TECHNIQUE_GROUP "Rank 1-5 Shūji"
                ^"Ever-Changing Waves" [invocation]
            }
            RANK 6 {
