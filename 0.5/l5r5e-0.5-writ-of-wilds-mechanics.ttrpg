EXTENSION "L5R5e_Writ_of_Wilds" EXTENDS "L5R5e_Core_Character" {
    NAME "Legend of the Five Rings 5th Edition - Writ of the Wilds: New Player Options"
    VERSION "0.5.2"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-03-01"

    # Writ of the Wilds (Chapter 2): Dragonfly Minor Clan, new schools
    # (including traditions for Naga, Nezumi, Tengu, Yobanjin, and
    # Dragonfly), new advantages (distinctions & passions), new
    # disadvantages (adversities & anxieties), new samurai heritages,
    # upbringings, woolly pony mount, and items.

    # ===========================
    # DRAGONFLY MINOR CLAN
    # ===========================

    # source stat block (page 85)
    #t295c4127ce3654396d647 ^"Dragonfly Clan" DEF {
        EXTENDS #L5R250aB2cD4eF6gH8iJ0k ^"Clan"
        APPLIES TO [#L5R003xY4zA6bC8dE0fG2hI ^"Samurai"]

        PROPERTIES {
            ^"Clan Name" STRING "Dragonfly" FIXED
            ^"Clan Type" STRING "Minor Clan"
            ^"Clan Ring Bonus" DEF { ^"Earth" INTEGER 1 }
            ^"Clan Skill Bonus" DEF { ^"Sentiment" INTEGER 1 }
            ^"Clan Status" INTEGER DEFAULT 30
        }

        FAMILIES {
            ^"Tonbo"
        }

        RULES {
            #L5RWW00aB1cD3eF5gH7iJ9kL: dragonfly_minor_clan "The Dragonfly Minor Clan: The Dragonfly seek knowledge and understanding. During their time as gatekeepers for the Dragon, they have met and mingled with a vast array of samurai and peasants alike. These interactions have stoked the clan's desire to gather as much information as possible so that they can compare and contrast the differing views of the Great Clans and others in the Empire."
            #bsiGoYrNp5jSw2MpzFr304: what_does_your_character_know "What Does Your Character Know?: All Dragonfly characters have a greater awareness of the following topics:\n\nYou have a strong awareness of the multitude of political dealings that happen with the small lands of the Dragonfly, as well as a general awareness of the happenings with the lands of the Dragon and Phoenix.\n\nYou know the general state of the relationship between the Phoenix and the Dragon, as well as the movements of nearby Lion Clan armies.\n\nYou are comfortable navigating The Great Climb and most mountainous areas."
            #IXP7FzbG9OZvEjP4fXM5Ge: what_does_bushido_mean_to_your_clan "What Does Bushidō Mean to Your Clan?: To the Dragonfly, the most important tenets of Bushidō are Courtesy and Duty, which they consider to be inexorably linked. It is their duty to stay courteous in the face of disdain and fiery tempers, as well as to serve the Dragon and perform their duty as messengers and gatekeepers to the best of their ability."
        }
    }

    # ===========================
    # DRAGONFLY FAMILIES
    # ===========================

    #L5RWW50gH2iJ4kL6mN8oP0q ^"Tonbo" DEF {
        EXTENDS #L5R251lM3nO5pQ7rS9tU1v ^"Family"
        APPLIES TO [#L5R003xY4zA6bC8dE0fG2hI ^"Samurai"]

        PROPERTIES {
            ^"Family Name"     STRING "Tonbo" FIXED
            ^"Clan"            STRING "Dragonfly"
            ^"Ring Increase" DEF { CHOOSE 1 [^"Air", ^"Water"] INTEGER 1 }
            ^"Skill Increases" DEF {
                ^"Courtesy" INTEGER 1
                ^"Culture" INTEGER 1
            }
            ^"Glory"           INTEGER 35
            ^"Wealth" DEF { ^"Count" INTEGER 1  ^"Type" STRING "koku"  ^"Starting" BOOLEAN true }
            ^"Item" DEF { ^"Count" INTEGER 2  ^"Description" STRING "Dragonfly glass ornaments"  ^"Starting" BOOLEAN true }
        }
    }

    # ===========================
    # NEW SCHOOLS
    # ===========================

    ^"Dragonfly Grace of the Spirits" DEF {
        EXTENDS #L5R252wX4yZ6aB8cD0eF2g ^"School"
        APPLIES TO [#L5R003xY4zA6bC8dE0fG2hI ^"Samurai"]

        PROPERTIES {
            ^"School Name" STRING "Dragonfly Grace of the Spirits" FIXED
            ^"Clan" STRING "Dragonfly"
            ^"Roles" LIST ["Courtier", "Shugenja"]
            ^"Ring Increase" DEF {
                ^"Air" INTEGER 1
                ^"Water" INTEGER 1
            }
            ^"Starting Skills" DEF { CHOOSE 5 [^"Command", ^"Courtesy", ^"Culture", ^"Games", ^"Government", ^"Martial Arts [Melee]", ^"Theology"] INTEGER 1 }
            ^"Starting Honor" INTEGER DEFAULT 40
            ^"Techniques Available" LIST ["Invocations", "Rituals", "Shūji"]
        }

        STARTING_TECHNIQUES {
            INVOCATION ^"Dominion of Suijin"
            INVOCATION ^"Reflections of P'an Ku"
            RITUAL CHOOSE 3 [^"Cleansing Rite", ^"Commune with the Spirits", ^"Divination", ^"Threshold Barrier"]
        }

        SCHOOL_ABILITY "May the Spirits Show the Path" {
            "Once per scene if you would fail a Social check, you may immediately make a TN 5 Theology check, with the TN being reduced by a number equal to your school rank (to a minimum of 1). If you succeed, you may change any kept (ring) on that Social check to (su) results instead."
        }

        MASTERY_ABILITY ^"Whispers of the Kami" {
            "You may spend 1 Void point to use your school ability an additional time this scene. You may do this multiple times."
        }
        STARTING_OUTFIT [
            "traveling clothes", "sanctified robes",
            "wakizashi (short sword)", "any one weapon of rarity 6 or lower",
            "scroll satchel", "calligraphy set",
            "list of observations", "traveling pack"
        ]

        CURRICULUM {
            RANK 1 {
                SKILL_GROUP "Social Skills"
                SKILL "Culture"
                SKILL "Government"
                SKILL "Theology"
                TECHNIQUE_GROUP "Rank 1-2 Air and Water Shūji"
                ^"Heart of the Water Dragon" [invocation]
                ^"By the Light of the Lord Moon" [invocation]
            }
            RANK 2 {
                SKILL_GROUP "Social Skills"
                SKILL "Government"
                SKILL "Sentiment"
                SKILL "Theology"
                TECHNIQUE_GROUP "Rank 1-2 Air and Water Invocations"
                ^"The Wind Blows Both Ways" [shuji]
                ^"Tea Ceremony" [ritual]
            }
            RANK 3 {
                SKILL_GROUP "Scholar Skills"
                SKILL "Courtesy"
                SKILL "Performance"
                SKILL "Martial Arts [Melee]"
                TECHNIQUE_GROUP "Rank 1-3 Air and Water Invocations"
                ^"Rise, Water" [invocation]
                ^"Touchstone of Courage" [shuji]
            }
            RANK 4 {
                SKILL_GROUP "Social Skills"
                SKILL "Culture"
                SKILL "Martial Arts [Melee]"
                SKILL "Theology"
                TECHNIQUE_GROUP "Rank 1-4 Invocations"
                ^"Bend with the Storm" [shuji]
                ^"Regal Bearing" [shuji]
            }
            RANK 5 {
                SKILL_GROUP "Social Skills"
                SKILL "Government"
                SKILL "Martial Arts [Melee]"
                SKILL "Theology"
                TECHNIQUE_GROUP "Rank 1-5 Invocations"
                ^"Buoyant Arrival" [shuji]
                ^"Rouse the Soul" [shuji]
            }
            RANK 6 {
                ^"Whispers of the Kami"
            }
        }

    }

