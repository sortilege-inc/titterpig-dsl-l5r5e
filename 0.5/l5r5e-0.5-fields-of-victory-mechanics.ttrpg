    # ===========================
    # OPPORTUNITY TABLES
    # ===========================

    # source (pages 138-139)
    #uW6kP3R72Qq4DD54tMBIdU ^"Fields of Victory Opportunity Tables" DEF {
        APPLIES TO [#L5R003xY4zA6bC8dE0fG2hI ^"Samurai"]

        #Me2HuXZae5HjT8H7Zw8LGF ^"Mass Battle Opportunities" DEF {
            # Table 3-9: Spending Opportunity in Mass Battles

            RULES {
                #YeM3lns2eUQ1uh5RAwah59: mass_battle_air_op_plus "Air (op)+: Choose an allied leader other than yourself. Reduce the TN of that leader's next check for a Scheme action by 1 per (op) spent this way. This persists until the end of the scene."
                #i96HB4NpfkEUZupphbFOEN: mass_battle_air_op_op "Air (op)(op): Choose a leader in a fortification. That leader's cohort loses the benefits of the fortification until the beginning of your next turn."
                #hjLIZRRtqVYEc6oAfTuDoz: mass_battle_earth_op_plus "Earth (op)+: Remove 1 panic from your army per (op) spent this way."
                #i9CedAGZn4guhENsasgJfK: mass_battle_earth_op_op "Earth (op)(op): Choose an allied leader other than yourself. That leader's cohort cannot be targeted by Attack actions until the beginning of your next turn."
                #kHeXiPVqXbxWaQRQKF3Td2: mass_battle_fire_op_plus_panic "Fire (op)+: The enemy army suffers 1 panic per (op) spent this way."
                #XWndl8dDfEVf8JenUJr0l0: mass_battle_fire_op_plus_critical_strike "Fire (op)+: When performing an Attack action against the cohort of an enemy leader with vigilance lower than or equal to (op) spent this way, after its effects are resolved, inflict a critical strike with severity equal to the deadliness of one of your weapons on that leader."
                #Klay2HhGoJX5LDQIb2FJ45: mass_battle_water_op_plus "Water (op)+: Choose an allied leader other than yourself. Reduce the TN of that leader's next check for a Movement action by 1 per (op) spent this way."
                #GtaGv52eYHFlVOPllexH4z: mass_battle_water_op_op "Water (op)(op): Choose an enemy leader. That leader's cohort cannot perform Movement actions until the beginning of your next turn."
                #NRZ538gX2nlRN3nEqJ1EV4: mass_battle_void_op_plus "Void (op)+: Your army and each enemy army suffer 2 attrition per (op) spent this way."
                #r02H6rJi1yrMObu4mihmy2: mass_battle_void_op_op_challenge "Void (op)(op): When you perform a Support action, after its effects are resolved, you may immediately perform a Challenge action targeting an enemy cohort's leader."
                #ZsX09asvAruASIDNkv1Lrg: mass_battle_void_op_op_strength_discipline "Void (op)(op): Increase the army's strength and discipline by 3. This persists until the end of the scene."
            }
        }

        #tm54zcyfLfFLyYCRWyd1Kp ^"Contested Territory Opportunities" DEF {
            # Table 3-10: Spending Opportunity in Contested Territory

            RULES {
                #tWv7nAszVUIwoNBJqTp8YC: contested_territory_air_op "Air (op): You discern subtle signs of incoming trouble and can take steps to avoid it. The next time you enter a conflict scene this session, you may add a kept die showing (op) to your Initiative check."
                #qtauHUnfGQoyfwO9zBf9RK: contested_territory_air_op_op "Air (op)(op) or (op)(op)(op): You create a clever disguise or ruse to get the jump on potential foes. The next time you enter a conflict scene this game session, after Initiative has been determined, choose one character in the scene. On that character's next check, they must reroll all results containing (su) symbols."
                #oU1pT0XngisYzWmX8webp8: contested_territory_earth_op_unfamiliar "Earth (op): Not even the chaos of war or the strangeness of foreign lands can faze you. Reduce the TN of the next check you make to deal with an unfamiliar situation or opponent by 1."
                #XdwJs0sGer0nsr6r9gD0sH: contested_territory_earth_op_conditions "Earth (op): You hold fast to the thought of home while in distant locales and dangerous situations. You may remove 1 strife for each condition you are currently suffering."
                #pecXHiPwa0dvIbMUkQGjmo: contested_territory_fire_op_op "Fire (op)(op): A clever theory fills in the gaps in your knowledge. You may immediately attempt a Scholar skill check of your choice to learn about your current situation or an NPC who is present, lowering the TN by 1 (to a minimum of 1)."
                #fE58fAlAOarl01VdQZ0ZFU: contested_territory_fire_op_plus "Fire (op)+: As you incite your allies to great fervor, any number of them may remove 1 strife for each (op) you spend. For each character affected, you receive 1 strife as you let your passion overtake you."
                #Tsts8rw7uHE6b1DFwqrYYF: contested_territory_water_op_op_plus "Water (op)(op)+: Your charm wins over even enemies. For each (op)(op) spent, one hostile character within the scene becomes friendlier toward you. What exactly that means depends on context—it may defuse an imminent conflict, or encourage your foes to try to take you alive, but it won't stop bloodshed altogether once blades have been drawn."
                #hgQrbA4JyghBnm86ErqYiE: contested_territory_water_op_op "Water (op)(op): With cunning, you flow smoothly from one conclusion to the next. You learn of one key feature, fortification, or terrain quality present in the surrounding area, and whether or not enemies have passed through recently."
                #dKUu9X8AaHvAXKGhvW5frd: contested_territory_void_op_plus "Void (op)+: In all things, one can find balance, even in a duel of words or blades. You and a hostile character of the GM's choice in the same scene each recover 2 strife for each (op) spent in this way."
                #jh8zDTjywZbj11QmwxMdH5: contested_territory_void_op_op "Void (op)(op): You find serenity amid adversity. You discover a neutral meeting place, protective legal precedent, or similar safe haven applicable to your situation."
            }
        }

        RULES {
            #L5RFV42jK3lM5nO7pQ9rS1t: spending_opportunity_in_times_of_war "Spending Opportunity in Times of War: The unprepared rarely survive war, and only those with the drive to seize an advantage when it presents itself thrive amid war's chaos and danger. Whether driven by honor, glory, or merely survival, samurai at war must make use of every weapon in their arsenal.\n\nGMs running war-focused games may use Table 3–9: Spending Opportunity in Mass Battles to give players additional means of spending (op) in their games, or as inspiration for new options of their devising. The table focuses on the rules for Mass Battles found on page 274 of the core rulebook, but similar results could be used in other types of conflict scenes."
        }
    }

    # ===========================
    # OPTIONAL RULES: TRIFLING BREACHES & SMALL SACRIFICES
    # ===========================

    # source (page 142)
    #2ONb3wTQvYPmo0eKT3Pvcp ^"Honor Rules" DEF {
        APPLIES TO [#L5R003xY4zA6bC8dE0fG2hI ^"Samurai"]

        RULES {
            #L5RFV43uV4wX6yZ8aB0cD2e: trifling_breaches "Trifling Breaches: When a character wishes to commit a breach of honor that is judged to be less serious than a minor breach, they must first forfeit 1 honor.\n\nExamples of trifling breaches of honor:\n\nTelling a half-truth to make a story more interesting.\n\nCarrying out your lord's orders in a less expedient manner for personal convenience.\n\nPrivately, but verbally, cursing the actions of a higher-status samurai."
            #L5RFV44fG5hI7jK9lM1nO3p: small_sacrifices "Small Sacrifices: When a character makes a sacrifice in the name of honor, but it is judged to be less significant than a minor sacrifice, they are awarded 1 honor.\n\nExamples of small sacrifices of honor:\n\nAllowing a verbal insult directed at you (one that causes you to forfeit 1 glory or more to ignore) to pass without reprisal.\n\nRefusing to use information overheard from behind a closed door as testimony.\n\nAiding a friend who has been publicly disgraced but you know to be innocent."
            #uTFf2szkEKHjdQxeuh208P: trifling_breaches_and_small_sacrifices "Trifling Breaches and Small Sacrifices: The Legend of the Five Rings core rulebook contains guidelines for gaining honor for virtuous deeds, as well as guidelines for forfeiting honor in order to act disgracefully. However, minor acts can affect a character's honor as well. A samurai strives to adhere to Bushidō in all aspects of their life, and many small positive or negative demonstrations eventually add up.\n\nWhat follows are optional additions to Table 7–1: Honor and Glory Forfeits/Awards, on page 300 of the core rulebook, and to the examples related to honor on page 303 of the core rulebook."
        }
    }
}
