EXTENSION "L5R5e_Fields_of_Victory" EXTENDS "L5R5e_Core_Character" {
    NAME "Legend of the Five Rings 5th Edition - Fields of Victory: New Player Options"
    VERSION "0.5.3"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-03-01"

    # Fields of Victory (Chapters 2 and 3): Badger Minor Clan, Ichiro family,
    # new schools, advantages, disadvantages, heritages, weapons, personal effects,
    # blessed treasures (nemuranai), item patterns, techniques (kata, ninjutsu,
    # rituals, shūji), titles, demeanor, NPC templates, opportunity tables,
    # and honor rules for warfare-focused campaigns.

    # ===========================
    # BADGER MINOR CLAN
    # ===========================

    # source stat block (page 71)
    #c4m372yAVTcX9I1SWJ7v6X ^"Badger Minor Clan" DEF {
        EXTENDS #L5R250aB2cD4eF6gH8iJ0k ^"Clan"
        APPLIES TO [#L5R003xY4zA6bC8dE0fG2hI ^"Samurai"]

        PROPERTIES {
            ^"Clan Name" STRING "Badger" FIXED
            ^"Clan Type" STRING "Minor Clan"
            ^"Clan Ring Bonus" DEF { ^"Earth" INTEGER 1 }
            ^"Clan Skill Bonus" DEF { ^"Martial Arts [Unarmed]" INTEGER 1 }
            ^"Clan Status" INTEGER DEFAULT 25
        }

        FAMILIES {
            ^"Ichirō"
        }

        RULES {
            #L5RFV01aB2cD4eF6gH8iJ0k: badger_minor_clan "The Badger Minor Clan: While most clans seem to spend all their time fighting each other, the Badger steadfastly defend the northwest border of the Emerald Empire. The trivialities of courtly life and interclan intrigue are less than important—and not even interesting. Only the Crab face a more constant threat. Still, although the Badger readily admit that no gaijin invader rivals the terrors of the Shadowlands, this doesn't diminish the importance of their duty deep in the Great Wall of the North mountains. Often forgotten by most of the major powers of the Empire, the Badger continue their charged duty with little to no outside support. Only by being as strong, resilient, and self-reliant as the mountains themselves can the Badger ensure no invaders gain entrance to Rokugan through the mountainous terrain they guard."
            #L5RFV02lM3nO5pQ7rS9tU1v: badger_bushido_righteousness_gi_important "What Does Bushidō Mean to Your Clan?: The Badger are one of the most isolated clans in the Empire, and their samurai are as direct and hard as the mountains themselves. Sumai teaches them that strength comes from honest application of muscle and skill, not from honeyed words or blind acceptance. For this clan, to defend the border is to protect the Empire, and there can be no weakness in this area. When truth and honesty are forgotten, there is little to separate samurai from foreigners. For this reason, Righteousness (Gi) holds a special place for the Badger."
            #L5RFV03wX4yZ6aB8cD0eF2g: badger_bushido_courtesy_rei_less_important "The Badger rarely leave their mountains, and while they are lively and enjoy games of all sorts, there is rarely need for mannered behavior within their lands. Every time they visit another court, they see only deceit and underhanded ways of twisting the truth for political gains. For a clan that prizes strength and iron, those samurai who rely on words instead of muscle are to be frowned upon at best. Thus, the Bushidō tenet of Courtesy (Rei) is less important to members of the Badger Clan.\n\nSee page 301 of the core rulebook for more information on how these can affect your honor and glory."
        }
    }

    # ===========================
    # BADGER FAMILIES
    # ===========================

    #L5RFV50oP8qR0sT2uV4wX6y ^"Ichirō" DEF {
        EXTENDS #L5R251lM3nO5pQ7rS9tU1v ^"Family"
        APPLIES TO [#L5R003xY4zA6bC8dE0fG2hI ^"Samurai"]
        ALIAS "Ichiro"

        PROPERTIES {
            ^"Family Name"     STRING "Ichirō" FIXED
            ^"Clan"            STRING "Badger"
            ^"Ring Increase" DEF { CHOOSE 1 [^"Earth", ^"Fire"] INTEGER 1 }
            ^"Skill Increases" DEF {
                ^"Fitness" INTEGER 1
                ^"Tactics" INTEGER 1
            }
            ^"Glory"           INTEGER 35
            ^"Wealth" DEF { ^"Count" INTEGER 3  ^"Type" STRING "koku"  ^"Starting" BOOLEAN true }
        }
    }

    # ===========================
    # NEW SCHOOLS
    # ===========================

    # source (page 72)
    #bdu4pB5ax013OA1byi5e3P ^"Agasha Ascetic" DEF {
        EXTENDS #L5R252wX4yZ6aB8cD0eF2g ^"School"
        APPLIES TO [#L5R003xY4zA6bC8dE0fG2hI ^"Samurai"]

        PROPERTIES {
            ^"School Name" STRING "Agasha Ascetic" FIXED
            ^"Clan" STRING "Dragon"
            ^"Roles" LIST ["Shugenja", "Bushi"]
            ^"Ring Increase" DEF {
                ^"Air" INTEGER 1
                ^"Earth" INTEGER 1
            }
            ^"Starting Skills" DEF { CHOOSE 5 [^"Fitness", ^"Martial Arts [Ranged]", ^"Martial Arts [Melee]", ^"Meditation", ^"Sentiment", ^"Tactics", ^"Theology"] INTEGER 1 }
            ^"Starting Honor" INTEGER DEFAULT 45
            ^"Techniques Available" LIST ["Invocations", "Kata", "Rituals"]
        }

        STARTING_TECHNIQUES {
            INVOCATION CHOOSE 2 [^"Caress of Earth", ^"Cloak of Night", ^"Wall of Earth", ^"Yari of Air"]
            KATA CHOOSE 1 [^"Striking as Air", ^"Striking as Earth"]
            RITUAL ^"Cleansing Rite"
            RITUAL ^"Commune with the Spirits"
        }

        SCHOOL_ABILITY "Stand as the Mountain" {
            "After you channel an invocation, increase your physical and supernatural resistances by an amount equal to the number of dice you reserved, to a maximum of your school rank. This effect persists until the start of your next turn."
        }

        MASTERY_ABILITY ^"Soul of Deepest Stones" {
            "When you successfully make a check to augment or mend a target, add a number of bonus successes equal to your ranks in Fitness."
        }
        STARTING_OUTFIT [
            "sanctified robes", "traveling clothes",
            "daishō (katana and wakizashi)", "scroll satchel",
            "journal", "traveling pack"
        ]

        CURRICULUM {
            RANK 1 {
                SKILL_GROUP "Martial Skills"
                SKILL "Courtesy"
                SKILL "Medicine"
                SKILL "Theology"
                TECHNIQUE_GROUP "Rank 1 Air Invocations"
                ^"Clouds Parted by Steel" [shuji]
                ^"Grasp of Earth" [invocation]
            }
            RANK 2 {
                SKILL_GROUP "Scholar Skills"
                SKILL "Martial Arts [Melee]"
                SKILL "Meditation"
                SKILL "Survival"
                TECHNIQUE_GROUP "Rank 1-2 Kata"
                ^"Beseech Togashi's Vision" [ritual]
                ^"Vanish in the Shadows" [ninjutsu]
            }
            RANK 3 {
                SKILL_GROUP "Trade Skills"
                SKILL "Fitness"
                SKILL "Martial Arts [Ranged]"
                SKILL "Theology"
                TECHNIQUE_GROUP "Rank 1-3 Earth Invocations"
                ^"Employ Terrible Thunder" [ninjutsu]
                ^"Grasp of the Air Dragon" [invocation]
            }
            RANK 4 {
                SKILL_GROUP "Martial Skills"
                SKILL "Command"
                SKILL "Sentiment"
                SKILL "Theology"
                TECHNIQUE_GROUP "Rank 1-4 Kata"
                ^"Imbue Thunder" [ritual]
                ^"Rise, Air" [invocation]
            }
            RANK 5 {
                SKILL_GROUP "Scholar Skills"
                SKILL "Fitness"
                SKILL "Martial Arts [Melee]"
                SKILL "Meditation"
                TECHNIQUE_GROUP "Rank 1-5 Air Invocations"
                ^"Ever-Changing Waves" [invocation]
                ^"Striking as Void" [kata]
            }
            RANK 6 {
                ^"Soul of Deepest Stones"
            }
        }

    }

    # source stat block (page 73)
    #jTEgKxIphNPmR8VbNAjbWp ^"Akodo Soldier" DEF {
        EXTENDS #L5R252wX4yZ6aB8cD0eF2g ^"School"
        APPLIES TO [#L5R003xY4zA6bC8dE0fG2hI ^"Samurai"]

        PROPERTIES {
