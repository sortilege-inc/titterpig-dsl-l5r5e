    # source (pages 86-87)
    #B1OVbHpQZHJxqekuaePsOz ^"Fields of Victory Heritages" DEF {
        APPLIES TO [#L5R003xY4zA6bC8dE0fG2hI ^"Samurai"]

        HERITAGE_TABLE {

            1 #0SK0L6ks5W2WD8kM6OrdPa ^"Born on the Battlefield" DEF {

                MODIFIERS {
                    ^"Glory" "-3"
                }

                EFFECT {
                    "You gain the Guiding Ancestor (Void) distinction"
                }
            }

            2 #iIQZVjxDNrycKFXhdMG7Hj ^"Strategic Mastermind" DEF {

                MODIFIERS {
                    ^"Glory" "+5"
                    ^"Honor" "-5"
                }

                EFFECT {
                    "Roll a ten-sided die to determine a skill you learned by studying your ancestor's deeds (1–2: Tactics, 3–4: Command, 5–6: Government, 7–8: Culture, 9: Commerce, 10: Theology); gain +1 rank in that skill."
                }

                SUB_TABLE "1d10" {
                    "1-2" "Tactics"
                    "3-4" "Command"
                    "5-6" "Government"
                    "7-8" "Culture"
                    "9" "Commerce"
                    "10" "Theology"
                }
            }

            3 #UoXZRWG1ytFoEZdC6nporA ^"Victory against the Crane" DEF {

                MODIFIERS {
                    ^"Glory" "+3"
                }

                EFFECT {
                    "Roll a ten-sided die and add the following family heirloom to your starting items (1–3: a weapon, 4–6: a game set of your choice, 7–8: some other item relevant to your ancestor's victory, 9: a horse or other animal, 10: the deed to a small piece of land on the border of Crane territory). In addition to its other properties, this item is a battlefield heirloom (see page 90)."
                }

                SUB_TABLE "1d10" {
                    "1-3" "a weapon"
                    "4-6" "a game set of your choice"
                    "7-8" "some other item relevant to your ancestor's victory"
                    "9" "a horse or other animal"
                    "10" "the deed to a small piece of land on the border of Crane territory"
                }
            }

            4 #XScIgfsSgDKDaKU0n7aYn3 ^"Victory against Invaders" DEF {

                MODIFIERS {
                    ^"Honor" "+3"
                }

                EFFECT {
                    "Roll a ten-sided die to determine a skill you learned to honor your ancestor (1–2: Command, 3–4: Government, 5–6: Tactics, 7–8: Survival, 9: Theology, 10: Meditation); gain +1 rank in that skill."
                }

                SUB_TABLE "1d10" {
                    "1-2" "Command"
                    "3-4" "Government"
                    "5-6" "Tactics"
                    "7-8" "Survival"
                    "9" "Theology"
                    "10" "Meditation"
                }
            }

            5 #NzTSDxYLs8FeZuG1bs5wg9 ^"Shamed by Defeat" DEF {

