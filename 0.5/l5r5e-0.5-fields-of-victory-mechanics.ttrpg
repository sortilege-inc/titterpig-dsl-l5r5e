            ^"Combat Rank Modifier" STRING "+1"
            ^"Ring Modifier" STRING "+1 Void"
            ^"Skill Modifier" STRING "+1 Martial and Trade skills"
            ^"Replace Advantages" STRING "0-2: Bishamon's Blessing (Water) [Martial; Physical, Spiritual], Flexibility (Water) [Martial; Physical], Keen Balance (Earth) [Martial; Mental, Physical]"
            ^"Replace Disadvantages" STRING "0-2: Disdain for Courtesy (Air) [Social; Flaw, Mental], Overly Suspicious (Fire) [Social; Interpersonal], Whispers of Poverty (Water) [Social; Interpersonal, Infamy]"
            ^"Add Techniques" STRING "0-2: Kata, Rituals"
            ^"Replace Demeanor" STRING "1: Gruff, Shrewd"
        }

        RULES {
            #L5RFV41yZ2aB4cD6eF8gH0i: fov_badger_clan_samurai_template "Badger Clan Samurai: This template can be used with any clan samurai profile."
        }
    }

    # source stat block (page 143)
