            }
            ^"Starting Skills" DEF { CHOOSE 5 [^"Command", ^"Fitness", ^"Martial Arts [Melee]", ^"Martial Arts [Ranged]", ^"Martial Arts [Unarmed]", ^"Medicine", ^"Tactics"] INTEGER 1 }
            ^"Starting Honor" INTEGER DEFAULT 50
            ^"Techniques Available" LIST ["Kata", "Rituals", "Shūji"]
        }

        STARTING_TECHNIQUES {
            KATA CHOOSE 1 [^"Striking as Fire", ^"Striking as Water"]
            KATA CHOOSE 1 [^"Crescent Moon Style", ^"Pelting Hail Style"]
        }

        SCHOOL_ABILITY "Drilled Precision" {
            "When making an Attack or Movement action check, you may remove an amount of strife from yourself up to your school rank. For each strife you remove this way, add one kept (ring) set to (op) to the check and receive 1 fatigue."
        }

        MASTERY_ABILITY ^"Strike Without Shadow" {
            "When you succeed at an Attack or Movement action check, you may spend 1 Void point to add bonus successes equal to your ranks in Fitness."
        }
        STARTING_OUTFIT [
            "ashigaru armor", "traveling clothes",
            "daishō (katana and wakizashi)",
            "yumi (bow) with quiver of arrows", "yari (spear)",
            "nodachi (great sword) or nagamaki (see page 88) or nagae yari (page 88)",
            "yoroidoshi", "knife",
            "battlefield medical pack", "traveling pack"
        ]

        CURRICULUM {
            RANK 1 {
                SKILL_GROUP "Martial Skills"
                SKILL "Command"
                SKILL "Courtesy"
                SKILL "Government"
                TECHNIQUE_GROUP "Rank 1 Kata"
