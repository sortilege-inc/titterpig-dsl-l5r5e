    # source stat block (page 143)
    #IYD33uCht0U0eBBkRU0mya ^"Instructor Template" DEF {
        APPLIES TO [#t2513b5e05d845f4411465 ^"NPC Template"]
        PROPERTIES {
            ^"Base Profile" STRING "Apply this template to someone who is passing their skills on to someone else."
            ^"Combat Rank Modifier" STRING "+1"
            ^"Intrigue Rank Modifier" STRING "+1"
            ^"Ring Modifier" STRING "+1 Air"
            ^"Skill Modifier" STRING "+1 Martial and Scholar skills"
            ^"Replace Advantages" STRING "0-2: Keen Hearing (Air) [Martial; Physical], Seasoned (Void) [Social; Interpersonal], Subtle Observer (Air) [Social; Interpersonal]"
            ^"Replace Disadvantages" STRING "0-2: Calcified Thinking (Earth) [Social; Mental], Impatience (Earth) [Social; Mental]"
            ^"Add Techniques" STRING "0-2: Kata, Rituals"
            ^"Replace Demeanor" STRING "1: Assertive, Gruff"
        }

        RULES {
            #L5RFV44yZ5aB7cD9eF1gH3iJ: fov_instructor_template "Instructor: Apply this template to someone who is passing their skills on to someone else."
        }
    }

