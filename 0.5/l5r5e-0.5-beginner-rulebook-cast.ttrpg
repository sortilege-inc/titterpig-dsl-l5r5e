        #6AHp7W1AVmz6OgwxqqPOm5 ^"Sworn Protector" DEF { ^"Effect" STRING "Once per round, when an Attack action check targeting another character at range 0–1 succeeds, the bushi may use this technique to spend 1 Void point to intervene. The bushi becomes the target of the attack instead of the original target." }
        #JhgxNZjSpB1qnvNUK53kMi ^"Striking As Fire" DEF { ^"Effect" STRING "When the bushi makes a Martial Arts [Melee, Ranged, or Unarmed] (Fire) check, they may spend (op) to cause one target who would have suffered 1 or more fatigue to suffer a critical strike instead." }
