        #pfd2cJFiwX8wYn6FcGa2J5 ^"Brash Adventurer" DEF {
            ^"Description" STRING "Once per scene after making a check involving sailing or exploring, Byakko may choose to re-roll all dice in the check before deciding which to keep. If he does so, any strife suffered as a result of the check is doubled."
        }

        RULES {
            #L5REE28byakkoTakarabako1: byakko_takarabako "Captain Byakko is fifth cousin to Mantis Clan Champion Yoritomo, and the two spent a fair amount of time together as boys. Despite Byakko's relative inexperience, his powerful cousin favors him. Byakko captains the Takarabako, a gleaming new three-masted kobune ship. Yoritomo has assigned Lady Aguri, a young but gifted shugenja adopted by his uncle, to watch over Byakko and keep him out of trouble.\n\nByakko has much more interest in exploration than in piracy or running Yoritomo's errands, though he is fiercely loyal to his cousin and desperate for his approval. He hopes that if he can amass enough status, he can convince Yoritomo to approve an expedition south, to a rumored land of vast deserts, endless coral reefs, and savage creatures that drop from trees and emerge from the seas in hordes. Byakko hopes to be the first to map its coast."
        }
    }
    # --- Friendly Traveler Village (Imperial) ---
    # source stat block (page 89)
    #Nea6kcoUhT6cDM2a5xvQIx ^"Imperial Governor Miya Tetsua" DEF {
