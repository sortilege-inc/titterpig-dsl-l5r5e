            ^"Gear" LIST OF STRING ["Bark Hide (Physical 4, Sacred)"]
        }

        #9frENn2uTtKsFLm9jSyVn8 ^"Kodama's Blessing" DEF {
            ^"Description" STRING "Once per scene, as a Support action the willow kodama may target any number of characters within range 0-5. Each character targeted removes 4 fatigue, and one condition of the kodama's choice."
        }

        #RYUETw1bRTMyU8cYBfuZNn ^"Living Willow Spirit" DEF {
            ^"Description" STRING "The willow kodama is an Otherworldly being of silhouette 2. Additionally, once per scene as an action of the appropriate types, the willow kodama may perform any one Earth or Water invocation of rank 1 or 2. It counts as succeeding with 3 bonus successes and 2 (op)."
