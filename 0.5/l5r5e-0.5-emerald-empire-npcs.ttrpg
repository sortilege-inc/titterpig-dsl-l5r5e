                ^"Void" INTEGER 3
            }
            ^"Demeanor" STRING "Detached"
            ^"Social Skill Check TN Modifiers" STRING "Earth +1, Fire +1, Void -2"
            ^"Endurance" INTEGER 10
            ^"Composure" INTEGER 10
            ^"Focus" INTEGER 3
            ^"Vigilance" INTEGER 3
            ^"Honor" INTEGER 45
            ^"Glory" INTEGER 45
            ^"Status" INTEGER 45
            ^"Skills" LIST OF STRING ["Artisan 0", "Martial 1", "Scholar 3", "Social 2", "Trade 0"]
            ^"Advantages" LIST OF STRING ["Seeker of Enlightenment (Void) [Scholar; Mental]"]
            ^"Disadvantages" LIST OF STRING ["Fanaticism (Fire) [Social; Mental]"]
            ^"Favored Weapons" LIST OF STRING ["Wakizashi: Range 0-1, Damage 4, Deadliness 5/7, Ceremonial, Concealable, Razor-Edged"]
            ^"Gear" LIST OF STRING ["Simple kimono (Physical 1)", "Knife"]
        }

        #y1mhhJ2utZxAaqkUk1YSjZ ^"Fateful Blessing" DEF {
            ^"Description" STRING "When Chikako spends a Void point as part of a check, she may spend (op) in the following way:\n\nVoid (op): Gain 1 Void point."
        }

        RULES {
            #L5REE21gH1iJ3kL5mN7oP9qR: chikako_initiate "A girl devoted to studying the Tao of Shinsei, Chikako is determined to enter the High House of Light. Chikako is her given name; she has simply dropped her family name. She has been \"called\" to the monastery and is determined to stay there. She was raised as a samurai, so she has some knowledge of court games and combat. She is small but quick, quiet but willful. Despite her youth, she has a spiritual aura, and fate seems to favor her as though she has been chosen. She speaks with the wisdom and confidence of a more experienced monk, and if words aren't enough, she isn't afraid to fight for what she believes in."
        }
    }

    # --- Pilgrimage Road (Kolat) ---

    # source stat block (page 194)
    #YBAAnGzyd7AfyHqAwoCYOy ^"Aotora Akira, Pilgrim" DEF {
        EXTENDS #t4540de6f35155c46f41f0 ^"NPC"

        PROPERTIES {
