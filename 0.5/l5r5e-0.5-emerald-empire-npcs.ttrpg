EXTENSION "L5R5e_Emerald_Empire_NPCs" EXTENDS "L5R5e_Emerald_Empire" {
    NAME "Legend of the Five Rings 5th Edition - Emerald Empire: NPCs"
    VERSION "0.5.3"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-03-01"

    # Emerald Empire: NPCs from across the sourcebook,
    # organized by chapter and location.

    # ===========================
    # NPCs / ADVERSARIES
    # ===========================

    # -----------------------------------------------
    # Chapter 1: Strongholds of Power
    # -----------------------------------------------

    # --- Toshi Ranbo (Imperial) ---

    # source stat block (page 40)
    #jUvr47RJykTsfWy7tYt1wU ^"Kakita Sukenobu, Steward of Toshi Ranbo" DEF {
        EXTENDS #t4540de6f35155c46f41f0 ^"NPC"

        PROPERTIES {
            ^"Type" STRING "Adversary" FIXED
            ^"Combat Conflict Rank" INTEGER 2
            ^"Intrigue Conflict Rank" INTEGER 4
            ^"Rings" DEF {
                ^"Air" INTEGER 4
                ^"Earth" INTEGER 2
                ^"Fire" INTEGER 3
                ^"Water" INTEGER 3
                ^"Void" INTEGER 3
            }
            ^"Demeanor" STRING "Shrewd"
            ^"Social Skill Check TN Modifiers" STRING "Air +2, Fire -2"
            ^"Endurance" INTEGER 10
            ^"Composure" INTEGER 10
            ^"Focus" INTEGER 7
            ^"Vigilance" INTEGER 3
            ^"Honor" INTEGER 60
            ^"Glory" INTEGER 50
            ^"Status" INTEGER 45
            ^"Skills" LIST OF STRING ["Artisan 3", "Martial 2", "Scholar 2", "Social 3", "Trade 0"]
            ^"Advantages" LIST OF STRING ["Impeccable Brushwork (Air) [Artisan; Mental]"]
            ^"Disadvantages" LIST OF STRING ["Hopeless Romantic (Earth) [Social; Interpersonal]"]
            ^"Favored Weapons" LIST OF STRING ["Katana: Range 1, Damage 4, Deadliness 5/7, Ceremonial, Razor-Edged"]
            ^"Gear" LIST OF STRING ["Wakizashi", "Elegant kimono (Physical 1, Ceremonial)", "Lacquered armor (Physical 4, Ceremonial, Wargear)", "Yumi"]
        }

        #EhjZKkcySAV3L3NbtPo54C ^"Peaceful Heart" DEF {
            ^"Description" STRING "When Kakita Sukenobu or an ally at range 0-4 fails an Attack check using a weapon, they remove 2 strife."
        }

        RULES {
            #L5REE01aB1cD3eF5gH7iJ9kL: sukenobu_steward "Kakita Sukenobu is the current steward of Toshi Ranbo. A handsome young man just a few years past his gempuku, Sukenobu wears the traditional long, white-dyed hair of his clan. Sukenobu was thrust into a position of power suddenly and unexpectedly after the recent ouster of Daidoji Yoshiya, the castle's previous steward. In stark contrast to the militaristic Daidoji, Sukenobu has the soul of an artist and a romantic, and few think him prepared for the weighty duties he now holds.\n\nHaving inherited a court of belligerent tacticians and responsibility for a castle under siege, Sukenobu finds himself bombarded by advice that runs contrary to his own inclinations. Torn between a desire for peace—and a life of artistic pursuits and leisure—and his own duty, Sukenobu is eager to build his own circle of companions and advisors. He seeks the acquaintance of samurai who show an artistic temperament or who seem similarly repelled by the militant attitudes that dominate the court of Toshi Ranbo."
        }
    }

    # source stat block (page 42)
    #DwpkaHOLEuagqdmDehlETY ^"Shosuro Sanae, Go Master" DEF {
        EXTENDS #t4540de6f35155c46f41f0 ^"NPC"

        PROPERTIES {
            ^"Type" STRING "Adversary" FIXED
            ^"Combat Conflict Rank" INTEGER 2
            ^"Intrigue Conflict Rank" INTEGER 4
            ^"Rings" DEF {
                ^"Air" INTEGER 4
                ^"Earth" INTEGER 2
                ^"Fire" INTEGER 3
                ^"Water" INTEGER 3
                ^"Void" INTEGER 3
            }
            ^"Demeanor" STRING "Shrewd"
            ^"Social Skill Check TN Modifiers" STRING "Water +2, Fire -2"
            ^"Endurance" INTEGER 10
            ^"Composure" INTEGER 12
            ^"Focus" INTEGER 7
            ^"Vigilance" INTEGER 3
            ^"Honor" INTEGER 25
            ^"Glory" INTEGER 65
            ^"Status" INTEGER 20
            ^"Skills" LIST OF STRING ["Artisan 3", "Martial 1", "Scholar 2", "Social 4", "Trade 0"]
            ^"Advantages" LIST OF STRING ["Small Stature (Air) [Martial; Physical]"]
            ^"Disadvantages" LIST OF STRING ["Disdain for Compassion (Water) [Social; Mental]"]
            ^"Favored Weapons" LIST OF STRING ["Wakizashi: Range 0-1, Damage 4, Deadliness 5/7, Ceremonial, Concealable, Razor-Edged"]
            ^"Gear" LIST OF STRING ["Extravagant robes (Physical 1, Ceremonial)", "Go set"]
        }

        #VkrI24zCagFvCl2CwuQWo8 ^"Master of Games" DEF {
            ^"Description" STRING "When Shosuro Sanae exploits an opponent's disadavantage during a game of any kind, she may reroll up to four dice (instead of just two)."
        }

        RULES {
            #L5REE02mN2oP4qR6sT8uV0wX: sanae_go_master "Though less than a decade past her gempuku, Shosuro Sanae is one of the top Go players in Rokugan. She regularly travels around the Empire to represent her clan in tournaments for the game. She usually wears a full face mask that shows only her eyes and mouth. Sanae is a charming conversationalist, but her glib tongue hides an underlying inner conflict. Though she shares the general Scorpion view of Bushidō as a nicety for idealistic samurai and possesses a deep underlying cynicism toward humanity, she also feels a certain envy and even a touch of admiration toward those who can sustain a more idealistic outlook. As a result, she often seeks out such people for conversation. She is a loyal ally to those who impress her, but anyone who betrays their own ideals will find her an especially dire enemy, as she punishes them for confirming her dour view of the world.\n\nBecause of her life as a traveling Go player, Sanae has friends and contacts across the Empire, including daimyō, magistrates, courtiers, and fellow Go players. She can be an outstanding friend, capable of offering all manner of help and information…or a terrifying enemy, able to call down trouble on her foes in lands far beyond her own home."
        }
    }

    # source stat block (page 44)
    #ihjCSDD2mBKjQKKNLd6hty ^"Kakita Shijin, Famed Poet" DEF {
        EXTENDS #t4540de6f35155c46f41f0 ^"NPC"

        PROPERTIES {
            ^"Type" STRING "Adversary" FIXED
            ^"Combat Conflict Rank" INTEGER 2
            ^"Intrigue Conflict Rank" INTEGER 4
            ^"Rings" DEF {
                ^"Air" INTEGER 4
                ^"Earth" INTEGER 2
                ^"Fire" INTEGER 3
                ^"Water" INTEGER 3
                ^"Void" INTEGER 4
            }
            ^"Demeanor" STRING "Detached"
            ^"Social Skill Check TN Modifiers" STRING "Fire +1, Water +1, Void -2"
            ^"Endurance" INTEGER 10
            ^"Composure" INTEGER 10
            ^"Focus" INTEGER 7
            ^"Vigilance" INTEGER 3
            ^"Honor" INTEGER 60
            ^"Glory" INTEGER 70
            ^"Status" INTEGER 25
            ^"Skills" LIST OF STRING ["Artisan 5", "Martial 0", "Scholar 3", "Social 4", "Trade 0"]
            ^"Advantages" LIST OF STRING ["Famously Successful (Fire) [Artisan; Interpersonal]"]
            ^"Disadvantages" LIST OF STRING ["Incurable Illness: Old Age (Water) [Martial; Physical]"]
            ^"Favored Weapons" LIST OF STRING ["Wakizashi: Range 0-1, Damage 4, Deadliness 5/7, Ceremonial, Concealable, Razor-Edged"]
            ^"Gear" LIST OF STRING ["Extravagant robes (Physical 1, Ceremonial)", "Writing kit"]
        }

        #KD6ERyuYolxdvv0uPY7qJ3 ^"Worthy Apprentice" DEF {
            ^"Description" STRING "Once per session as a downtime event, Kakita Shijin may spend several weeks mentoring a student who suitably impresses him. A character who commits themselves to the master's lessons gains 3 glory and may purchase the All Arts Are One shūji technique regardless of the normal prerequisites"
        }

        RULES {
            #L5REE03yZ3aB5cD7eF9gH1iJ: shijin_poet "The elderly Shijin is one of the most famous living poets in the Empire, having spent a long lifetime perfecting his art. Stooped and thin, with a long wispy goatee, Shijin spends most of his days in Kyūden Doji's famous gardens, meditating on the beauty around him and writing down the poems it inspires. Although he prefers to avoid the distractions of politics, his long and successful life as a poet has brought him into contact with thousands of samurai from across the Empire, and he can call on innumerable allies and favors at need.\n\nShijin is rumored to be seeking a student, a personal apprentice he can teach in the ways of poetry. Whether this rumor is true or not, it has made him a focus of attention; his infrequent visits to court always result in samurai eagerly (or desperately) maneuvering for his attention and friendship."
        }
    }

    # source stat block (page 47)
    #mdkuESrHQHYAaZHE30SzQF ^"Seppun Ishikawa, Captain of the Seppun Honor Guard" DEF {
        EXTENDS #t4540de6f35155c46f41f0 ^"NPC"

        PROPERTIES {
            ^"Type" STRING "Adversary" FIXED
            ^"Combat Conflict Rank" INTEGER 5
            ^"Intrigue Conflict Rank" INTEGER 4
            ^"Rings" DEF {
                ^"Air" INTEGER 3
                ^"Earth" INTEGER 4
                ^"Fire" INTEGER 3
                ^"Water" INTEGER 4
                ^"Void" INTEGER 3
            }
            ^"Demeanor" STRING "Detached"
            ^"Social Skill Check TN Modifiers" STRING "Fire +1, Water +1, Void -2"
            ^"Endurance" INTEGER 16
            ^"Composure" INTEGER 12
            ^"Focus" INTEGER 5
            ^"Vigilance" INTEGER 4
            ^"Honor" INTEGER 60
            ^"Glory" INTEGER 70
            ^"Status" INTEGER 45
            ^"Skills" LIST OF STRING ["Artisan 2", "Martial 4", "Scholar 1", "Social 3", "Trade 0"]
            ^"Advantages" LIST OF STRING ["Paragon of Compassion (Water) [Martial; Courtesy]"]
            ^"Disadvantages" LIST OF STRING ["Painful Honesty (Air) [Social; Interpersonal]"]
            ^"Favored Weapons" LIST OF STRING ["Katana: Range 1, Damage 4, Deadliness 5/7, Ceremonial, Razor-Edged"]
            ^"Gear" LIST OF STRING ["Lacquered armor (Physical 4, Ceremonial, Wargear)", "Badge of office", "Formal kimono (Physical 1, Ceremonial)", "Yumi", "Wakizashi", "Steed"]
        }

        #T2gHBXQPcplOlxpkKDuedq ^"Never in Darkness" DEF {
            ^"Description" STRING "When resisting a Social skill effect that would distract him from his duty, Seppun Ishikawa rolls two additional Skill dice."
        }

        RULES {
            #L5REE04kL4mN6oP8qR0sT2uV: ishikawa_captain "Born in Otosan Uchi during a New Year's festival, Seppun Ishikawa showed martial skill from an early age, and his parents arranged for him to be trained by the Kakita. Initially posted as an ordinary member of the Imperial House Guard, he soon drew positive notice from his superiors, especially Emerald Champion Doji Satsume. Satsume appointed him as an Emerald Magistrate and, after Ishikawa distinguished himself in that role, named him captain of the Seppun Honor Guard.\n\nIshikawa is a deceptively ordinary-looking man and a surprisingly gentle one, noted during his tenure as an Emerald Magistrate for the consideration he showed to the lower castes. A romantic at heart, he secretly longs for a woman who is already betrothed to another—though he knows such emotions could compromise him in his duties. Nevertheless, he is an honorable and dedicated bushi and takes his duty to the Hantei Family extremely seriously. Due to his past experience as a magistrate, he knows the value of having trustworthy allies and contacts throughout the Empire and is always on the lookout for more, assessing honorable visitors (perhaps including the PCs) from this viewpoint."
        }
    }

    # source stat block (page 48)
    #FAaTeWeTWWJMcXCtjSqYad ^"Koharu, Mantis Mercenary" DEF {
        EXTENDS #t4540de6f35155c46f41f0 ^"NPC"

        PROPERTIES {
            ^"Type" STRING "Adversary" FIXED
            ^"Combat Conflict Rank" INTEGER 3
            ^"Intrigue Conflict Rank" INTEGER 2
            ^"Rings" DEF {
                ^"Air" INTEGER 3
                ^"Earth" INTEGER 3
                ^"Fire" INTEGER 3
                ^"Water" INTEGER 2
                ^"Void" INTEGER 2
            }
            ^"Demeanor" STRING "Ambitious"
            ^"Social Skill Check TN Modifiers" STRING "Fire +2, Earth -2"
            ^"Endurance" INTEGER 10
            ^"Composure" INTEGER 12
            ^"Focus" INTEGER 6
            ^"Vigilance" INTEGER 3
            ^"Honor" INTEGER 35
            ^"Glory" INTEGER 30
            ^"Status" INTEGER 30
            ^"Skills" LIST OF STRING ["Artisan 0", "Martial 3", "Scholar 0", "Social 1", "Trade 2"]
            ^"Advantages" LIST OF STRING ["Famously Professional (Water) [Social; Interpersonal]"]
            ^"Disadvantages" LIST OF STRING ["Covetous (Earth) [Social; Interpersonal]"]
            ^"Favored Weapons" LIST OF STRING ["Kusari-gama: Range 1 [2–3 two-handed], Damage 3, Deadliness 3; Concealable, Snaring, Wargear"]
            ^"Gear" LIST OF STRING ["Ashigaru armor (Physical 3, Wargear)", "Wakizashi", "Coin string", "Lucky cricket", "Katana"]
        }

        #KOgjY9tpQNyp1ZBrd8VZat ^"Sailor's Legs" DEF {
            ^"Description" STRING "While on the deck of a ship, when performing a check or targeted by a check, Koharu may suffer up to 2 strain and choose 2 rolled dice. Those dice are rerolled."
        }

        RULES {
            #L5REE05wX5yZ7aB9cD1eF3gH: koharu_mercenary "The muscular and sun-bronzed Koharu was born a rōnin and spent her youth as a pirate and a sword-for-hire, alternating roles as opportunity dictated. She attracted a following of other rōnin drawn to her combination of charisma and ruthless skill. Eventually, her success drew the attention of the Mantis Clan, who recruited Koharu and her followers. Koharu has not changed her lifestyle since swearing fealty to the Mantis, but now has the clan's support behind her when things go wrong.\n\nKoharu can be encountered in many parts of the Empire, working as a mercenary or conducting pirate raids. She judges people as individuals, admiring those who are strong or successful while showing contempt for weakness; she is a deadly enemy to those who personally hurt her or her friends, but otherwise she views her mercenary work as purely business and free of any emotional commitment. She is an untrustworthy ally, ready to switch sides at the drop of a coin bag, but a loyal personal friend who will fight to the death for those she actually cares about."
        }
    }

