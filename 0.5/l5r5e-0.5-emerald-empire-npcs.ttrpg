            }
            ^"Demeanor" STRING "Intimidating"
            ^"Social Skill Check TN Modifiers" STRING "Fire +2, Air -2"
            ^"Endurance" INTEGER 12
            ^"Composure" INTEGER 14
            ^"Focus" INTEGER 6
            ^"Vigilance" INTEGER 3
            ^"Honor" INTEGER 28
            ^"Glory" INTEGER 25
            ^"Status" INTEGER 30
            ^"Skills" LIST OF STRING ["Artisan 3", "Martial 3", "Scholar 2", "Social 4", "Trade 4"]
            ^"Advantages" LIST OF STRING ["Dangerous Allure (Fire) [Social; Interpersonal]"]
            ^"Disadvantages" LIST OF STRING ["Dark Secret (Void) [Social; Interpersonal]"]
            ^"Favored Weapons" LIST OF STRING ["Tessen: Range 0-1, Damage 4, Deadliness 3, Ceremonial, Concealable"]
            ^"Gear" LIST OF STRING ["Silk kimono", "Expensive perfume", "Knife", "Three vials of Night Milk poison"]
        }

        #o1RBKsEtrNQJrMUc4YScKU ^"Discomforting Hints" DEF {
            ^"Description" STRING "When making a Social skill check, Chinoko may spend (op) in the following way:\n\nAir (op)+: One target within earshot suffers the Disoriented condition until the end of the following round, plus one additional round for every (op) spent this way beyond the first."
        }

        #Af48mrdsaynFNCSazL0lhN ^"Unexpected Demise" DEF {
            ^"Description" STRING "When making an Attack action against a Disoriented or unaware target, Chinoko may spend (op) in the following way:\n\n(op)+: If she succeeds, the target suffers a critical strike with severity equal to twice the deadliness of her weapon plus 1 per (op) spent this way beyond the first."
        }

        RULES {
            #L5REE08gH8iJ0kL2mN4oP6qR: chinoko_geisha "Born in the poverty of the slums, Chinoko naturally took to the crimes and intrigues of the streets. She loathed the Celestial Order that kept her and hers down. The Kolat became her second home, and they trained her in the arts of assassination and intelligence. Chinoko wraps her muscular frame in fine black silks, and she wears exotic Unicorn jewelry. Her skills as a geisha rival those of any in the Empire—but this respectable occupation is only a disguise for her true activities. From Red Horn Village, she controls a small criminal empire: gambling houses, opium dens, and prostitution rings. A number of sleeper agents throughout the northern Empire serve as Chinoko's eyes and ears and—when occasion warrants—her murderous hands."
        }
    }

