        #ePaj02QwvvEzrlN0a8b0GE ^"Benten's Favor" DEF {
            ^"Description" STRING "When Suzume Hinagiku speaks of her beloved or her emotions, she counts as having rank 3 in social skills. Once per scene, characters who hear Hinagiku speak from the heart may recover 3 strife."
        }

        RULES {
            #L5REE15mN5oP7qR9sT1uV3wX: hinagiku_wayward "Hailing from a rustic valley, the Sparrow Hinagiku is a bright youth with her whole life ahead of her. That is why it is so puzzling to see her sadly stalking the worship hall of Benten Seidō, speaking to no one. Her breaths are heavy sighs, her faint smiles are wistful, and her words are short and brief—quite unlike the long-winded rambling for which her family is famous. Whatever makes her haunt these sacred halls of the Fortune of Arts and Romantic Love, she will not say. But neither will she leave, not until she can make sense of whatever twists her heart."
        }
    }

    # --- Shrine of the Willow-Healing Kami (Crab) ---

    # source stat block (page 161)
    #nFrI1WJgb0lFfMQHvnQNET ^"Kuni Kayo, the Willow Gardener" DEF {
        EXTENDS #t4540de6f35155c46f41f0 ^"NPC"

        PROPERTIES {
            ^"Type" STRING "Adversary" FIXED
            ^"Combat Conflict Rank" INTEGER 5
            ^"Intrigue Conflict Rank" INTEGER 3
            ^"Rings" DEF {
                ^"Air" INTEGER 1
