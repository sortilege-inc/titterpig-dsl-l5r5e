                ^"Fire" INTEGER 3
                ^"Water" INTEGER 2
                ^"Void" INTEGER 3
            }
            ^"Demeanor" STRING "Gruff"
            ^"Social Skill Check TN Modifiers" STRING "Air +2, Earth -2"
            ^"Endurance" INTEGER 12
            ^"Composure" INTEGER 14
            ^"Focus" INTEGER 4
            ^"Vigilance" INTEGER 1
            ^"Honor" INTEGER 40
            ^"Glory" INTEGER 40
            ^"Status" INTEGER 25
            ^"Skills" LIST OF STRING ["Artisan 0", "Martial 2", "Scholar 4", "Social 0", "Trade 0"]
            ^"Advantages" LIST OF STRING ["Analytical Mind (Fire) [Social; Mental]"]
            ^"Disadvantages" LIST OF STRING ["Can't Get a Break (Air) [Social; Interpersonal]"]
            ^"Favored Weapons" LIST OF STRING ["Bo: Range 1-2, Damage 6, Deadliness 2, Mundane"]
