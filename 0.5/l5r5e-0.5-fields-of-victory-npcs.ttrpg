        #E0XYp946XcFT2UbPJq6XPZ ^"Possession" DEF {
            ^"Description" STRING "Once per game session, Ginchiyo can become possessed by an ancestor spirit. Apply any one appropriate NPC template to Ginchiyo's profile and adjust her conflict ranks by +1. This effect persists until the end of the scene."
        }

        RULES {
            #L5RFV09sT9uV1wX3yZ5aB7cD: kitsu_ginchiyo "Kitsu Ginchiyo, Medium-in-Training: Not yet having reached gempuku, Ginchiyo is nonetheless one of the most powerful Kitsu Mediums (sōdan-senzo) in generations. Ginchiyo wants only to be a painter and storyteller, but to leave one's abilities undeveloped is unthinkable to the Kitsu. The family believes the child's own wishes are secondary to the preservation of their dying traditions. If they knew that some of the spirits Ginchiyo has been communing with aren't honored ancestors, but vengeful ghosts, perhaps they would think otherwise."
        }
    }

    # -----------------------------------------------
    # Chapter 2: Defenders of the Empire
    # -----------------------------------------------

    # --- The Badger Clan ---

