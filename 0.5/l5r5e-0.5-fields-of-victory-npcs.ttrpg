        #afD5zNSlEdzmKL0IiDrxRr ^"Disciple of Secret Lore" DEF {
            ^"Description" STRING "Choose four invocations (see page 189 of the core rulebook) and up to three rituals (see page 212 of the core rulebook). Ginchiyo can perform these invocations and rituals."
