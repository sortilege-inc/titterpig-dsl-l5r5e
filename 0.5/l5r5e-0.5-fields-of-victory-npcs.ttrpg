EXTENSION "L5R5e_Fields_of_Victory_NPCs" EXTENDS "L5R5e_Fields_of_Victory" {
    NAME "Legend of the Five Rings 5th Edition - Fields of Victory: NPCs"
    VERSION "0.5.3"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-03-01"

    # Fields of Victory: Named NPCs from across the sourcebook,
    # organized by chapter and section.

    # ===========================
    # NPCs / ADVERSARIES
    # ===========================

    # -----------------------------------------------
    # Chapter 1: Glorious Histories
    # -----------------------------------------------

    # --- The Imperial Legions ---

    # source stat block (page 11)
    #qQScWFffmLWSeVYxiybINZ ^"Sakae, Dedicated Ashigaru" DEF {
        EXTENDS #t4540de6f35155c46f41f0 ^"NPC"

        PROPERTIES {
            ^"Type" STRING "Adversary" FIXED
            ^"Combat Conflict Rank" INTEGER 3
            ^"Intrigue Conflict Rank" INTEGER 4
            ^"Rings" DEF {
                ^"Air" INTEGER 2
                ^"Earth" INTEGER 3
                ^"Fire" INTEGER 1
                ^"Water" INTEGER 1
                ^"Void" INTEGER 2
            }
            ^"Demeanor" STRING "Assertive"
            ^"Social Skill Check TN Modifiers" STRING "Earth +2, Air -2"
            ^"Endurance" INTEGER 8
            ^"Composure" INTEGER 12
            ^"Focus" INTEGER 3
            ^"Vigilance" INTEGER 3
            ^"Honor" INTEGER 30
            ^"Glory" INTEGER 32
            ^"Status" INTEGER 21
            ^"Skills" LIST OF STRING ["Artisan 1", "Martial 3", "Scholar 0", "Social 1", "Trade 1"]
            ^"Advantages" LIST OF STRING ["Indomitable Will (Earth) [Social; Mental, Interpersonal]"]
            ^"Disadvantages" LIST OF STRING ["Intolerance (Air) [Social; Interpersonal]"]
            ^"Favored Weapons" LIST OF STRING ["Katana: Range 1, Damage 4, Deadliness 5/7, Ceremonial, Razor-edged", "Yari: Range 2, Damage 5, Deadliness 3, Wargear", "Yumi: Range 2-5, Damage 5, Deadliness 3"]
            ^"Gear" LIST OF STRING ["Ashigaru armor (Physical 3, Wargear)", "Traveling rations", "Tent (medium)", "a small doll stuffed with rye in the likeness of Sakae's brother"]
        }

        #ZSMXzw5ugqqPhwb4qhjcOb ^"Ashigaru Veteran" DEF {
            ^"Description" STRING "As a Support action during a mass battle, Sakae may make a TN 1 Tactics (Earth) check targeting up to two cohorts with the Rank Formation ability. If Sakae succeeds, each of those cohorts' leaders adds 1 kept (ring) set to (op) to the next check they make."
        }

        RULES {
            #L5RFV01aB1cD3eF5gH7iJ9kL: sakae_ashigaru "Sakae, Dedicated Ashigaru: The child of a humble farmer, Sakae was conscripted into a Great Clan army at an early age. Despite their inexperience, Sakae showed unexpected skill on the battlefield and lived long enough to develop the courage and cleverness associated with samurai. They became part of an ashigaru force garrisoned along the border between two clans. After a long period of service as a spear ashigaru, they were promoted to kachigashira, or infantry leader. They have served their clan with distinction ever since, engaging their opponents with direct, unflinching violence in several prominent battles.\n\nEarlier in their career, Sakae had accepted their new life, but when they learned that their younger brother Ryota had been captured in a raid by an opposing clan, they were conflicted about whether they should return to support their aging parents. Sakae finally decided that fighting for the clan would raise their family's standing more than begging permission to return to their village. Sakae's focus has made them an incredibly capable soldier, well known and highly respected. Solidly built thanks to a steady ration of rice, they have a kind face that immediately hardens into fierce determination as they prepare for battle."
        }
    }

    # source stat block (page 13)
    #R6A2yEUbK6FCQFk8UYgipN ^"Seppun Genshin, Captain" DEF {
        EXTENDS #t4540de6f35155c46f41f0 ^"NPC"

        PROPERTIES {
            ^"Type" STRING "Adversary" FIXED
            ^"Combat Conflict Rank" INTEGER 6
            ^"Intrigue Conflict Rank" INTEGER 6
            ^"Rings" DEF {
                ^"Air" INTEGER 2
                ^"Earth" INTEGER 4
                ^"Fire" INTEGER 3
                ^"Water" INTEGER 2
                ^"Void" INTEGER 3
            }
            ^"Demeanor" STRING "Gruff"
            ^"Social Skill Check TN Modifiers" STRING "Water +2, Earth -2"
            ^"Endurance" INTEGER 14
            ^"Composure" INTEGER 12
            ^"Focus" INTEGER 5
            ^"Vigilance" INTEGER 2
            ^"Honor" INTEGER 55
            ^"Glory" INTEGER 61
            ^"Status" INTEGER 51
            ^"Skills" LIST OF STRING ["Artisan 0", "Martial 5", "Scholar 2", "Social 3", "Trade 2"]
            ^"Advantages" LIST OF STRING ["Seasoned (Void) [Social; Mental, Interpersonal]"]
            ^"Disadvantages" LIST OF STRING ["Bluntness (Air) [Social; Interpersonal]"]
            ^"Favored Weapons" LIST OF STRING ["Katana: Range 1, Damage 4, Deadliness 5/7, Ceremonial, Razor-edged", "Wakizashi: Range 0-1, Damage 3, Deadliness 5/7, Ceremonial, Razor-edged"]
            ^"Gear" LIST OF STRING ["Lacquered armor (Physical 4, Ceremonial, Cumbersome, Wargear)", "Smoking pipe"]
        }

        #LJJxhGTYbIEMmDi0t2GILN ^"Authoritative Negotiation" DEF {
            ^"Description" STRING "When making a Social skill check to pursue Imperial interests or the Emperor's agenda, Seppun Genshin may receive up to 3 strife in order to reroll that many (ring) showing blank results."
        }

        RULES {
            #L5RFV02mN2oP4qR6sT8uV0wX: seppun_genshin "Seppun Genshin, Captain: Seppun Genshin has made a name for himself executing orders with incredible efficiency. Raised at Kyūden Seppun and recruited into the legions immediately after his gempuku, Genshin found a new home among his fellow soldiers of the Seventh Legion. His direct, no-nonsense demeanor and sincerity have inspired others to trust in his leadership wherever he is posted. Genshin's tactical prowess, combined with his schooling and family ties, has propelled him to the rank of captain. As a leader within the Seventh Legion, he directs public works projects and helped spearhead the reconstruction efforts of the Crane coast after the tsunami of 1120. While many citizens consider him a fair mediator, Genshin's ambitions have not been satisfied by his current role. He is actively seeking the next success that will ensure his ascendancy to Commander of the Seventh Legion, where he would report directly to the Emerald Champion."
        }
    }

    # --- Sanctioned Conflicts ---

    # source stat block (page 18)
    #f0jsjEYxxQfA2HYsvQU4MT ^"Ikoma Hiroshika, Advocate at Court" DEF {
        EXTENDS #t4540de6f35155c46f41f0 ^"NPC"

        PROPERTIES {
            ^"Type" STRING "Adversary" FIXED
            ^"Combat Conflict Rank" INTEGER 3
            ^"Intrigue Conflict Rank" INTEGER 5
            ^"Rings" DEF {
                ^"Air" INTEGER 4
                ^"Earth" INTEGER 2
                ^"Fire" INTEGER 3
                ^"Water" INTEGER 4
                ^"Void" INTEGER 3
            }
            ^"Demeanor" STRING "Reserved"
            ^"Social Skill Check TN Modifiers" STRING "Earth +2, Water -2"
            ^"Endurance" INTEGER 14
            ^"Composure" INTEGER 12
            ^"Focus" INTEGER 7
            ^"Vigilance" INTEGER 3
            ^"Honor" INTEGER 70
            ^"Glory" INTEGER 65
            ^"Status" INTEGER 39
            ^"Skills" LIST OF STRING ["Artisan 1", "Martial 1", "Scholar 4", "Social 3", "Trade 1"]
            ^"Advantages" LIST OF STRING ["Legal Expert (Air) [Social; Mental]"]
            ^"Disadvantages" LIST OF STRING ["Frailty (Earth) [Martial; Physical]"]
            ^"Favored Weapons" LIST OF STRING ["Wakizashi: Range 0–1, Damage 4, Deadliness 5/7, Ceremonial, Concealable, Razor-edged"]
            ^"Gear" LIST OF STRING ["Courtly finery (Physical 1, Ceremonial)", "Legal scrolls and texts", "Go set"]
        }

        #E64Vctod0pFUTPicOJ6Qem ^"Powerful Arguments" DEF {
            ^"Description" STRING "When making a Courtesy check, if Hiroshika does not keep any dice with results containing (st) symbols, she may spend (op) in the following manner: (op)+: The target of the check receives strife equal to (op) spent this way."
        }

        RULES {
            #L5RFV03yZ3aB5cD7eF9gH1iJ: ikoma_hiroshika "Ikoma Hiroshika, Advocate at Court: Ikoma Hiroshika is a familiar face in the Imperial Court in Otosan Uchi, appearing frequently before the Throne to argue the finer points of what qualifies as war within the Empire. Few Rokugani know the sprawling body of edicts, petitions, and precedents on sanctioned interclan war as well as she. Hiroshika's is a crucial role, especially given her clan's penchant for launching itself into military conflict. Whether a dispute centers on land, resources, or a real or perceived injustice or insult, the Lion Clan is eager to demonstrate it is not to be trifled with. When its targets bring their grievances to court, Hiroshika is well prepared to argue that what they claim is a war is nothing more than a disagreement, a skirmish, or a \"matter of restoring honor,\" requiring no Imperial involvement. Rarely do others find cracks in the armor of this elder courtier's reasoned, yet passionate arguments; to date, Hiroshika has been successful far more often than not."
        }
    }

    # --- High Histories of the Ikoma ---

    # source stat block (page 21)
    #MZiMBey0UWGoxUuwE1eWWn ^"Ikoma Nakidori" DEF {
        EXTENDS #t4540de6f35155c46f41f0 ^"NPC"

        PROPERTIES {
            ^"Type" STRING "Adversary" FIXED
            ^"Combat Conflict Rank" INTEGER 2
            ^"Intrigue Conflict Rank" INTEGER 1
            ^"Rings" DEF {
                ^"Air" INTEGER 2
                ^"Earth" INTEGER 1
                ^"Fire" INTEGER 3
                ^"Water" INTEGER 3
                ^"Void" INTEGER 2
            }
            ^"Demeanor" STRING "Passionate"
            ^"Social Skill Check TN Modifiers" STRING "Earth +2, Air -2"
            ^"Endurance" INTEGER 8
            ^"Composure" INTEGER 8
            ^"Focus" INTEGER 5
            ^"Vigilance" INTEGER 3
            ^"Honor" INTEGER 50
            ^"Glory" INTEGER 44
            ^"Status" INTEGER 35
            ^"Skills" LIST OF STRING ["Artisan 1", "Martial 1", "Scholar 3", "Social 2", "Trade 0"]
            ^"Advantages" LIST OF STRING ["Inspiring Presence (Fire) [Martial; Interpersonal]", "Historian (Earth) [Scholar; Mental]"]
            ^"Disadvantages" LIST OF STRING ["War Injury (Earth) [Martial; Physical]"]
            ^"Favored Weapons" LIST OF STRING ["Wakizashi: Range 0–1, Damage 4, Deadliness 5/7, Ceremonial, Concealable, Razor-edged"]
            ^"Gear" LIST OF STRING ["Scholar's robes (Physical 1)", "Shamisen", "Calligraphy set", "Scroll satchel"]
        }

        #VCFW7ZyB7xurctKWyKERZe ^"Lion Expertise" DEF {
            ^"Description" STRING "When Ikoma Nakidori assists another character making a Scholar check involving military or Lion Clan history, the character may roll two additional (ring) instead of just one."
        }

        RULES {
            #L5RFV04kL4mN6oP8qR0sT2uV: ikoma_nakidori "Ikoma Nakidori: Longing for adventure, Ikoma Nakidori considers herself to be a songbird locked away in the gilded cage of the High Histories, also called the Ikoma Libraries. Having been trained as a battle crier, Nakidori earned early commendations on the battlefield and walked with pride and glory alongside bushi. She was known to be fearless, and her war songs were fuel for the fire raging in the soldiers of her company. One overzealous charge and a grievous leg injury ended her career afield and forced her instead to an assignment in the High Histories. There, she is both elated and tormented by the sorting, writing, and memorizing of the tactical history of the Lion, her spirit endlessly charged with stories of glorious warfare, and forever reminded of what she will never again be a part of. Ever dutiful, Nakidori is glad to help any patron of the libraries with their studies of history and tactics, though she yearns for a day she might escape to once again stand beside warriors and light their souls aflame."
        }
    }

    # --- Akodo War College ---

    # source stat block (page 25)
    #oxtPCxLGSwJXLzjVjdnoCd ^"Matsu Doju" DEF {
        EXTENDS #t4540de6f35155c46f41f0 ^"NPC"

        PROPERTIES {
            ^"Type" STRING "Adversary" FIXED
            ^"Combat Conflict Rank" INTEGER 5
            ^"Intrigue Conflict Rank" INTEGER 2
            ^"Rings" DEF {
                ^"Air" INTEGER 2
                ^"Earth" INTEGER 3
                ^"Fire" INTEGER 4
                ^"Water" INTEGER 2
                ^"Void" INTEGER 2
            }
            ^"Demeanor" STRING "Aggressive"
            ^"Social Skill Check TN Modifiers" STRING "Fire +2, Water -2"
            ^"Endurance" INTEGER 14
            ^"Composure" INTEGER 10
            ^"Focus" INTEGER 6
            ^"Vigilance" INTEGER 2
            ^"Honor" INTEGER 60
            ^"Glory" INTEGER 75
            ^"Status" INTEGER 45
            ^"Skills" LIST OF STRING ["Artisan 0", "Martial 3", "Scholar 3", "Social 2", "Trade 0"]
            ^"Advantages" LIST OF STRING ["Inspiring Presence (Fire) [Martial; Interpersonal]", "Rounded Education (Earth) [Scholar; Mental]"]
            ^"Disadvantages" LIST OF STRING ["Flamboyant (Air) [Social; Interpersonal]"]
            ^"Favored Weapons" LIST OF STRING ["Graduate's Katana: Range 1, Damage 4, Deadliness 5/7, Ceremonial, Durable, Razor-edged"]
            ^"Gear" LIST OF STRING ["Personalized armor (Physical 3, Resplendent, Wargear)", "Wakizashi"]
        }

        #FGb5anSXOYiAjr7tAxQ2uD ^"Roar of the Lion" DEF {
            ^"Description" STRING "As a Scheme and Support action during a skirmish, Doju may receive up to 3 strife to force the same number of enemy characters at range 0-3 to make a TN 2 Meditation check (Earth 1, Air 3). Each character who fails suffers the Dazed condition."
        }

        RULES {
            #L5RFV05wX5yZ7aB9cD1eF3gH: matsu_doju "Matsu Doju: A graduate of the Akodo War College who combines the fury of his Matsu mother and the braggadocio of his Ikoma father, Matsu Doju encompasses all the skill and passion of the Lion Clan. Doju's ostentatious nature; his hair, colored radiant gold like a Lion's mane; and his kimono, adorned with outlandish animal imagery, make him no friends in court or among the more conservative ranking officers of the Lion Clan. Having the good sense to stay away from formal affairs, Doju can usually be found showing off his battle prowess in the dōjō or talking up his military victories in sake houses. He adores his mother more than anyone and takes her aggressive combat training to heart. However, from his father, Doju has inherited a love of dramatic histories and an unusually warm and open manner toward his friends.\n\nAmong the small contingent of soldiers under his command, Doju is known as a demanding but generous and gregarious leader. To his superior officers, he's known as \"that one who keeps making unsupported charges into enemy lines, but somehow manages to come back alive.\" Friend and foe alike know him for his deafening war cries on the battlefield, instilling hope in his allies and terror in the opposition. Ikoma Tsanuri said of him after the last battle for Toshi Ranbo, \"There is no Lion who roars louder.\""
        }
    }

    # --- Castle of the Swift Sword / Akodo ---

    # source stat block (page 50)
    #ASaLa1s3slorD5oHJdwyIG ^"Akodo Shosuke" DEF {
        EXTENDS #t4540de6f35155c46f41f0 ^"NPC"

        PROPERTIES {
            ^"Type" STRING "Adversary" FIXED
            ^"Combat Conflict Rank" INTEGER 4
            ^"Intrigue Conflict Rank" INTEGER 2
            ^"Rings" DEF {
                ^"Air" INTEGER 1
                ^"Earth" INTEGER 3
                ^"Fire" INTEGER 2
                ^"Water" INTEGER 3
                ^"Void" INTEGER 3
            }
            ^"Demeanor" STRING "Determined"
            ^"Social Skill Check TN Modifiers" STRING "Earth +2, Air -2"
            ^"Endurance" INTEGER 10
            ^"Composure" INTEGER 12
            ^"Focus" INTEGER 3
            ^"Vigilance" INTEGER 2
            ^"Honor" INTEGER 60
            ^"Glory" INTEGER 30
            ^"Status" INTEGER 37
            ^"Skills" LIST OF STRING ["Artisan 3", "Martial 3", "Scholar 2", "Social 1", "Trade 1"]
            ^"Advantages" LIST OF STRING ["Unflappable (Water) [Social; Mental]", "Patient (Earth) [Social; Mental]"]
            ^"Disadvantages" LIST OF STRING ["Unassuming (Water) [Social; Mental]"]
            ^"Favored Weapons" LIST OF STRING ["Self-Forged Katana: Range 1, Damage 4, Deadliness 5/7, Ceremonial, Razor-edged, Resplendent"]
            ^"Gear" LIST OF STRING ["Lacquered armor (Physical 4, Ceremonial, Cumbersome, Wargear)", "Wakizashi", "Offerings for the ancestor spirits", "Knife", "Small hammer", "Plain robes", "Forging equipment"]
        }

        #j9GAcmP8Hak5Z2jzBUiQLs ^"Detailed Precision" DEF {
            ^"Description" STRING "When making an Attack or Movement action check, Akodo Shosuke may remove 2 strife. For each strife he removes this way, he adds one kept (ring) set to (op) to the check and receives 1 fatigue."
        }

        #wCGx3J7XuSPMizpUZGZ88T ^"Quick Fix" DEF {
            ^"Description" STRING "As a Support action, Shosuke may receive 3 fatigue and 3 strife to remove the Damaged item quality from one weapon or set of armor at range 0-1."
        }

        RULES {
            #L5RFV06iJ6kL8mN0oP2qR4sT: akodo_shosuke "Akodo Shosuke: Akodo Shosuke is the second-born scion of the Itagawa vassal family, whose purpose as a \"forge family\" is to supply the clan with weapons and armor. But Shosuke isn't content with merely forging the Empire's weapons—he is determined to become an expert in wielding them as well. His dream is to one day be anointed with the honorary title of kensei, or swordsaint. In the meantime, he is a dutiful quartermaster serving at the Castle of the Swift Sword, but he relishes the chance to practice his skills against any who are willing to test him."
        }
    }

