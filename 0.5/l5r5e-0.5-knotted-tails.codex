# .codex SECTION — The Knotted Tails (adventure). Stand-off graph over
# l5r5e-0.5-knotted-tails.lore (spec §25). Part of the L5R5e system graph;
# DEPENDS_ON the shared schema.
#
# The 7 cast NPCs (cast.ttrpg) are DEFs — referenced via ^"...", never minted.
# Nezumi, Transcendents, Shadowlands, Yume-dō, and Fu Leng are already in the
# graph (referenced; Transcendents amended). Hiruma is a family DEF (referenced).
# One Eye's former name Twitching Tail is the same being as the cast DEF and is
# not re-minted. Mask of the Oni cast (Hida Kurumi, Hida Nagahide, Kitsu Sokori)
# belong to that adventure and are not minted here. This section mints the
# Knotted Tails tribe, its village and graveyard, Shiro Hiruma, and the tribe's
# lore-only figures.

CODEX "L5R5e_KnottedTails_Codex" {
    NAME "The Knotted Tails — Lore Graph"
    VERSION "0.5.2"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-09-03"
    FOR EDITION "l5r5e"
    DEPENDS_ON "L5R5e_Codex_Schema" VERSION "0.5.9"

    # ---- The tribe --------------------------------------------------------
    ENTITY #L5RcxKnt01knottedtails ^"Knotted Tails" {
        IS ^"Faction"
        SOURCE "l5r5e-0.5-knotted-tails.lore" AT "the-knotted-tails"
        RELATIONSHIPS {
            ^"part-of"  -> ^"Nezumi"        FROM "The Knotted Tails, a nezumi tribe that prides itself on remembering the past"
            ^"led-by"   -> ^"Lucky Silver"  FROM "Lucky Silver, Leader of the Knotted Tails"
            ^"ally-of"  -> ^"Hiruma"        FROM "believe their ancestors were once close allies of the Hiruma family"
            ^"enemy-of" -> ^"Frayed Whisker" FROM "If Frayed Whisker dies during the confrontation, the other outcast nezumi scatter and the Knotted Tails are safe." }
    }
    ENTITY #L5RcxKnt02village ^"The Knotted Tails Village" {
        IS ^"Village"
        SOURCE "l5r5e-0.5-knotted-tails.lore" AT "part-3-knotted-tails-village"
        RELATIONSHIPS {
            ^"held-by"    -> ^"Knotted Tails" FROM "your first view of the nezumi village, a scattering of mismatched tents hidden amongst the rocks"
            ^"located-in" -> ^"Shadowlands" }
    }
    ENTITY #L5RcxKnt03graveyard ^"The Nezumi Graveyard" {
        IS ^"Landmark"
        SOURCE "l5r5e-0.5-knotted-tails.lore" AT "part-4-the-nezumi-graveyard"
        RELATIONSHIPS { ^"located-in" -> ^"Shadowlands" FROM "a natural pit the nezumi have filled with the corpses of their dead over the centuries" }
    }
    ENTITY #L5RcxKnt04shirohiruma ^"Shiro Hiruma" {
        IS ^"Castle"
        SOURCE "l5r5e-0.5-knotted-tails.lore" AT "the-knotted-tails"
        RELATIONSHIPS {
            ^"held-by"    -> ^"Hiruma"      FROM "They whisper that he was actually there at the fall of Shiro Hiruma, he is so long lived."
            ^"located-in" -> ^"Shadowlands" FROM "When the PCs move close to Shiro Hiruma, whether the castle is their destination or not, a patrol of nezumi warriors follows them through the Shadowlands, watching and waiting (see page 6 for the Knotted Tails warrior profile)." }
    }

    # ---- Lore-only figures -------------------------------------------------
    ENTITY #L5RcxKnt05silverears ^"Silver Ears" {
        IS ^"Person"
        SOURCE "l5r5e-0.5-knotted-tails.lore" AT "transcendent-advice"
        RELATIONSHIPS {
            ^"member-of" -> ^"Knotted Tails" FROM "The Transcendent is Silver Ears, once leader of the Knotted Tails."
            ^"leads"     -> ^"Knotted Tails" FROM "The Transcendent is Silver Ears, once leader of the Knotted Tails." }
    }
    ENTITY #L5RcxKnt06quickshadow ^"Quick Shadow" {
        IS ^"Person"
        SOURCE "l5r5e-0.5-knotted-tails.lore" AT "meeting-the-rememberer"
        RELATIONSHIPS { ^"member-of" -> ^"Knotted Tails" }
    }
    ENTITY #L5RcxKnt07nineclaws ^"Nine Claws" {
        IS ^"Person"
        SOURCE "l5r5e-0.5-knotted-tails.lore" AT "part-2-being-watched"
        RELATIONSHIPS { ^"member-of" -> ^"Knotted Tails" }
    }

    # ---- Amendment ---------------------------------------------------------
    ENTITY #dzMtU0vgAsLQ7xmk72Ge4p ^"Transcendents" {
        SOURCE "l5r5e-0.5-knotted-tails.lore" AT "the-knotted-tails-gm-only-beyond-this-point"
        RELATIONSHIPS { ^"member-of" -> ^"Knotted Tails" FROM "believe their ancestors were once close allies of the Hiruma family. Some of these ancestors are now Transcendents" }
    }
}
