    # source stat block (page 41)
    #c5nkLKlV4e1TTLs9ueYQPt ^"Asako Hisa, Inquisitor" DEF {
        EXTENDS #t4540de6f35155c46f41f0 ^"NPC"
        PROPERTIES {
            ^"Type" STRING "Adversary" FIXED
            ^"Combat Conflict Rank" INTEGER 5
            ^"Intrigue Conflict Rank" INTEGER 5
            ^"Rings" DEF {
                ^"Air" INTEGER 4
                ^"Earth" INTEGER 3
                ^"Fire" INTEGER 3
                ^"Water" INTEGER 3
                ^"Void" INTEGER 4
            }
            ^"Demeanor" STRING "Zealous"
            ^"Social Skill Check TN Modifiers" STRING "Earth +2, Fire -2"
            ^"Endurance" INTEGER 12
            ^"Composure" INTEGER 12
            ^"Focus" INTEGER 7
            ^"Vigilance" INTEGER 4
            ^"Honor" INTEGER 35
            ^"Glory" INTEGER 45
            ^"Status" INTEGER 45
            ^"Skills" LIST OF STRING ["Artisan 2", "Martial 2", "Scholar 4", "Social 2", "Trade 1"]
            ^"Advantages" LIST OF STRING ["Elemental Insight (Void) [Scholar; Mental]"]
            ^"Disadvantages" LIST OF STRING ["Dour (Air) [Social; Interpersonal]"]
            ^"Favored Weapons" LIST OF STRING ["Wakizashi: Range 0–1, Damage 3, Deadliness 5/7, Ceremonial, Razor-Edged"]
            ^"Gear" LIST OF STRING ["Sacred garments (Physical 1, Supernatural 4, Ceremonial, Sacred)", "personal chop"]
        }
        DESCRIPTION "An older woman with greying hair and a somewhat furtive nature, Asako Hisa is an Inquisitor, a member of her family’s secretive sect devoted to finding and destroying illegal magics in the Empire—particularly the evil blood magic known as mahō. She recently arrived unannounced in Sanpuku Seidō, accompanied only by a dour burakumin attendant named Surudoi, which simply (and ominously) means “sharp.” Hisa has visited the shrine proper several times and has otherwise spent the hours walking the winding streets of the monastery, appearing to observe the comings and goings of the Kaito. If asked the reason for her presence, Hisa simply says she is conducting business on behalf of the Council of Elemental Masters. It may be that Hisa is ensuring that no blasphemous thoughts or practices have taken root among the Kaito, now that they are a much more prominent part of the clan. If so, the enigmatic Asako is apparently not yet satisfied that this is the case."
        RULES {
            #ZgpXru2pOlNj5iVVAw2bC2: maho_hunter "Mahō Hunter: Hisa knows the following invocations: Jade Strike, Mask of Wind, Path to Inner Peace, and Yari of Air. Additionally, once per scene as a Support action, Hisa can grant one weapon at range 0–1 the Sacred quality until the end of the scene."
        }
    }

    # source stat block (page 43)
    #7EsC4A4HMWm54Zhe2mEKdF ^"The Forgotten Spirit" DEF {
        EXTENDS #t4540de6f35155c46f41f0 ^"NPC"
        PROPERTIES {
            ^"Type" STRING "Adversary" FIXED
            ^"Combat Conflict Rank" INTEGER 10
            ^"Intrigue Conflict Rank" INTEGER 4
            ^"Rings" DEF {
                ^"Air" INTEGER 3
                ^"Earth" INTEGER 3
                ^"Fire" INTEGER 3
                ^"Water" INTEGER 3
                ^"Void" INTEGER 5
            }
            ^"Demeanor" STRING "Wrathful"
            ^"Social Skill Check TN Modifiers" STRING "Fire +2, Earth -2"
            ^"Endurance" INTEGER 24
            ^"Composure" INTEGER 8
            ^"Focus" INTEGER 8
            ^"Vigilance" INTEGER 8
            ^"Honor" INTEGER 0
            ^"Glory" INTEGER 5
            ^"Status" INTEGER 0
            ^"Skills" LIST OF STRING ["Artisan 0", "Martial 3", "Scholar 3", "Social 0", "Trade 2"]
            ^"Advantages" LIST OF STRING ["Horrifying Appearance (Fire) [Martial, Social; Interpersonal, Physical]"]
            ^"Disadvantages" LIST OF STRING ["Singular Purpose (Air) [Scholar, Social; Mental]"]
            ^"Favored Weapons" LIST OF STRING ["Grasping Claws: Range 0–1, Damage 4, Deadliness 5, Snaring", "Venomous Fangs: Range 0, Damage 2, Deadliness 9, Razor-Edged"]
            ^"Gear" LIST OF STRING ["Chitinous carapace (Physical 4, Supernatural 4)"]
        }
        DESCRIPTION "The Forgotten Spirit has been driven into an all-consuming rage by centuries of neglect. Its original purpose or nature is no longer clear; whatever beneficence it once may have offered has been replaced by bitterness and anger. That said, unless a visitor to the Lost Shrine passes through the torii gate, the Forgotten Spirit remains a pervasive and disturbing background presence. If the visitor passes through the gate, however, the Forgotten Spirit appears in the shrine as a huge spider. The size of a pony, it is black, chitinous, and hairy—similar to a tarantula—with a cluster of glowing, reddish eyes and jagged, clashing mandibles. Unless the visitor immediately accedes to the spirit’s demands for worship, it attacks. Worshipping it as described in The Practice of Worship (see page 37) mollifies it, at least until the visitor tries to cease worshipping or leave, whereupon it again attacks. If the visitor defeats the Forgotten Spirit, it vanishes, but it returns to the Lost Shrine a day later, apparently unharmed. It may be possible to pacify the spirit for a longer period or perhaps even put it to rest entirely, but determining how to do so requires considerable research—its affinity for spiders may be a place to begin such study—and would likely involve a specially designed ritual conducted by an appropriate holy person."
        RULES {
            #EFYtx1AvohgC497uq231OM: manifest_spirit "Manifest Spirit: The Forgotten Spirit is an Otherworldly being of silhouette 3. It ignores the effects of mundane terrain qualities."
            #r7Pn60tg3LRBNZ1bfd1KuD: potent_venom "Potent Venom: Activation: When The Forgotten Spirit makes a successful Attack action check using their venomous fangs, they may spend (op) (op) in the following way:\n\nVoid (op) (op): The target suffers one of the following conditions: Bleeding, Disoriented, Exhausted, Intoxicated, or Lightly Wounded [Void]."
            #Px0Xt35tKnbZKCTxw3dMgj: ensnaring_webs "Ensnaring Webs: Once per scene as a Attack action, the Forgotten Spirit may target up to two characters at range 1–4 of itself. Each target must resist with a TN 3 Fitness check (Earth 2, Fire 5) or suffer the Immobilized condition."
        }
    }

    # source stat block (page 48)
    #0tIR0h11W9hYWJq4PwOwlI ^"Shun, Inspired Moon Cultist" DEF {
        EXTENDS #t4540de6f35155c46f41f0 ^"NPC"
        PROPERTIES {
            ^"Type" STRING "Adversary" FIXED
            ^"Combat Conflict Rank" INTEGER 3
            ^"Intrigue Conflict Rank" INTEGER 4
            ^"Rings" DEF {
                ^"Air" INTEGER 3
                ^"Earth" INTEGER 3
                ^"Fire" INTEGER 2
                ^"Water" INTEGER 3
                ^"Void" INTEGER 4
            }
            ^"Demeanor" STRING "Moon-blessed"
            ^"Social Skill Check TN Modifiers" STRING "Water +2, Fire -2"
            ^"Endurance" INTEGER 8
            ^"Composure" INTEGER 12
            ^"Focus" INTEGER 5
            ^"Vigilance" INTEGER 3
            ^"Honor" INTEGER 45
            ^"Glory" INTEGER 60
            ^"Status" INTEGER 35
            ^"Skills" LIST OF STRING ["Artisan 2", "Martial 2", "Scholar 2", "Social 3", "Trade 1"]
            ^"Advantages" LIST OF STRING ["Devoted Adherent of Onnotangu (Air) [Scholar; Mental]"]
            ^"Disadvantages" LIST OF STRING ["Obstinate (Fire) [Social; Interpersonal]"]
            ^"Favored Weapons" LIST OF STRING ["Bō: Range 1–2, Damage 6, Deadliness 2, Mundane"]
            ^"Gear" LIST OF STRING ["Traveling clothes (Physical 2, Durable, Mundane, Subtle)"]
        }
        DESCRIPTION "Shun is an enigmatic peasant. She firmly believes that every mortal’s path to Enlightenment is their own, but also that this fact incorporates an essential problem. Onnotangu was fundamentally important in the creation of the world, so in order to truly understand the world—a prerequisite of Enlightenment—one must correspondingly understand Lord Moon. Shun is charming but pushy, and considers herself to be the savior of those who lack her insight. Her belief in the powers of Onnotangu come from her inherent shugenja abilities, specifically ones related to water. Shun also possesses the ability to temporarily grant others access to her powers, but the blessings of Onnotangu cause those who wield them great emotional drain."
        RULES {
            #SUSfeWcLxQHakkkJft8fnv: the_gifts_of_the_moon_s_light "The Gifts of the Moon’s Light: Once per scene as a Support action, Shun may make a TN 2 Theology (Water) check targeting one character in the scene other than herself.\n\nIf she succeeds, she grants the target the ability to use one of the following invocations once (her choice): By the Light of Lord Moon; Rise, Water; or Strike the Tsunami. The TN of the check to perform the selected invocation is reduced to 2.\n\nIf a character uses one of these invocations (because it was granted by Shun), they suffer 6 strife after it is cast and, until the end of the scene, their Water Ring increases by 1, and their Fire Ring decreases by 1."
        }
    }

    # source stat block (page 52)
    #io11ofvQrUtf5ELQsgHis9 ^"Akiara, Chilling Bloodspeaker" DEF {
        EXTENDS #t4540de6f35155c46f41f0 ^"NPC"
        PROPERTIES {
            ^"Type" STRING "Adversary" FIXED
            ^"Combat Conflict Rank" INTEGER 5
            ^"Intrigue Conflict Rank" INTEGER 6
            ^"Rings" DEF {
                ^"Air" INTEGER 4
                ^"Earth" INTEGER 3
                ^"Fire" INTEGER 3
                ^"Water" INTEGER 3
                ^"Void" INTEGER 4
            }
            ^"Demeanor" STRING "Alluring"
            ^"Social Skill Check TN Modifiers" STRING "Air +2, Earth -1, Fire -1"
            ^"Endurance" INTEGER 14
            ^"Composure" INTEGER 14
            ^"Focus" INTEGER 7
            ^"Vigilance" INTEGER 4
            ^"Honor" INTEGER 0
            ^"Glory" INTEGER 10
            ^"Status" INTEGER 0
            ^"Skills" LIST OF STRING ["Artisan 1", "Martial 2", "Scholar 3", "Social 4", "Trade 1"]
            ^"Advantages" LIST OF STRING ["Forbidden Knowledge (Fire) [Scholar; Mental]"]
            ^"Disadvantages" LIST OF STRING ["Strange Corruption (Earth) [Martial; Spiritual]"]
            ^"Favored Weapons" LIST OF STRING ["Knife: Range 0, Damage 2, Deadliness 4/6, Concealable, Mundane, Razor-Edged"]
            ^"Gear" LIST OF STRING ["Sorcerous robes (Physical 2, Supernatural 4)", "second knife", "wakizashi", "personal chop"]
        }
        DESCRIPTION "Essentially nothing is known about Akiara, aside from the fact that they exist. Their name, which means “bright person,” is almost certainly a pseudonym. It isn’t even certain whether Akiara is a samurai or a commoner. All that is known is that Akiara is a Bloodspeaker, utterly devoted to the worship of Iuchiban in anticipation of the glorious triumph of his release from bondage and return to rule the world. If Akiara belongs to an existing cell, they make no mention of it, instead seeming intent on swaying people they believe may be open to the worship of Iuchiban. And Akiara is terrifyingly effective to that end, exuding an aura of suave, sinister charm with a terrifying sense of restrained power. This is almost enough to make the hints and suggestions of cosmic horror that thread their way through Akiara’s sibilant words tolerable…almost."
        RULES {
            #lV8vatiRe5L30C3B3nMvub: whispers_of_horror "Whispers of Horror: Once per scene as a Support action, when speaking of Iuchiban or the abominations that will enable him to take over the world, Akiara may make a Theology (Air) check targeting one person, with a TN equal to the target’s vigilance. If Akiara succeeds, the target immediately suffers 12 strife and becomes Dazed."
            #nxabmBqqeRsRR1e3Ouwifg: master_of_knives "Master of Knives: Akiara may wield two knives without penalty. When Akiara makes an Attack action check with a readied knife against a target, they may immediately make a second Attack action check against the same target with another readied knife."
        }
    }

    # source stat block (page 57)
    #jINcte3WkEsw1wz96ujGkG ^"Isawa Manami, Destined Shugenja" DEF {
        EXTENDS #t4540de6f35155c46f41f0 ^"NPC"
        PROPERTIES {
            ^"Type" STRING "Adversary" FIXED
            ^"Combat Conflict Rank" INTEGER 4
            ^"Intrigue Conflict Rank" INTEGER 7
            ^"Rings" DEF {
                ^"Air" INTEGER 3
                ^"Earth" INTEGER 3
                ^"Fire" INTEGER 4
                ^"Water" INTEGER 3
                ^"Void" INTEGER 3
            }
            ^"Demeanor" STRING "Reserved"
            ^"Social Skill Check TN Modifiers" STRING "Earth +2, Water -2"
            ^"Endurance" INTEGER 14
            ^"Composure" INTEGER 12
            ^"Focus" INTEGER 7
            ^"Vigilance" INTEGER 3
            ^"Honor" INTEGER 70
            ^"Glory" INTEGER 65
            ^"Status" INTEGER 39
            ^"Skills" LIST OF STRING ["Artisan 1", "Martial 1", "Scholar 4", "Social 3", "Trade 1"]
            ^"Advantages" LIST OF STRING ["Mystical Insight (Void) [Scholar; Mental]"]
            ^"Disadvantages" LIST OF STRING ["Lack of Physical Training (Earth) [Martial; Physical]"]
            ^"Favored Weapons" LIST OF STRING ["Wakizashi: Range 0–1, Damage 3, Deadliness 5/7, Ceremonial, Razor-Edged"]
            ^"Gear" LIST OF STRING ["Sanctified robes (Physical 1, Supernatural 3, Ceremonial)", "calligraphy set", "scroll satchel"]
        }
        DESCRIPTION "Isawa Manami’s teachers are not surprised that she has become a supremely accomplished practitioner of shugendō. During her gempuku, when she spent a requisite night in the mysterious gloom of the Isawa Mori, she disappeared. Her mentor and family feared that she was dead or, worse, had been taken off to some other realm by hostile spirits. But after three days, she was found sleeping in the same clearing where she had been left. She remembered little, but thereafter, her ability to commune with the elemental spirits burgeoned dramatically. Where other young shugenja had to work hard at memorizing the correct words, gestures, and other aspects of performing elemental invocations, Manami seemed to know them by instinct alone, and some Isawa wondered if she had been taught by the kami themselves. She even improvised on established practices, refining and improving them in ways that worked well for her, but that even much more senior shugenja simply didn’t understand. It is widely believed that Manami will someday become an Elemental Master—although those missing three days, and what happened to her during them, remains an issue that causes even the Masters to frown."
        RULES {
            #qtOUq8zPXCwJGIDwwARe2Y: adept_of_the_elements "Adept of the Elements: At the start of each game session, choose 0–2 invocations for each element (Air, Fire, Water, and Earth). Manami can perform those invocations this game session."
        }
    }

    # source stat block (page 61)
    #0oMbiO3SkuTDMtaRor3lhR ^"Kyōrinrin of the Library" DEF {
        EXTENDS #t4540de6f35155c46f41f0 ^"NPC"
        PROPERTIES {
            ^"Type" STRING "Adversary" FIXED
            ^"Combat Conflict Rank" INTEGER 8
