            ^"Demeanor" STRING "Effusive"
            ^"Social Skill Check TN Modifiers" STRING "Air +2, Earth -2"
            ^"Endurance" INTEGER 10
            ^"Composure" INTEGER 14
            ^"Focus" INTEGER 6
            ^"Vigilance" INTEGER 3
            ^"Honor" INTEGER 60
            ^"Glory" INTEGER 40
            ^"Status" INTEGER 40
            ^"Skills" LIST OF STRING ["Artisan 2", "Martial 1", "Scholar 2", "Social 3", "Trade 2"]
            ^"Advantages" LIST OF STRING ["Well-Spoken (Air) [Social; Interpersonal]"]
            ^"Disadvantages" LIST OF STRING ["Fear of Failure (Fire) [Social, Martial; Mental, Physical]"]
            ^"Favored Weapons" LIST OF STRING ["Wakizashi: Range 0–1, Damage 3, Deadliness 5/7, Ceremonial, Razor-Edged"]
