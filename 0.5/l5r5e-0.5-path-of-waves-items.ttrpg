EXTENSION "L5R5e_Path_of_Waves_Items" EXTENDS "L5R5e_Core_Systems" {
    NAME "Legend of the Five Rings 5th Edition - Path of Waves: New Gear, Weapons, and Items"
    VERSION "0.5.3"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-03-01"

    # Path of Waves (Chapter 3): New weapons (Rokugani peasant,
    # Ivory Kingdoms, shields, improvised), personal effects,
    # profession kits, forbidden effects, item patterns,
    # and the Hand to Mouth economic subsystem.

    # ===========================
    # NEW WEAPONS
    # ===========================

    # --- AXES ---

    # source stat block (page 110)
    #MY4cdybQ7E9XDyuu9fI9h7 ^"Kuwa" DEF {
        APPLIES TO [#t2eb48f120feed79eefc02 ^"Weapon"]
        PROPERTIES {
            ^"Category" STRING "Axes"
            ^"Skills" STRING "Melee"
            ^"Range" STRING "1"
            ^"Damage" INTEGER 4
            ^"Deadliness" INTEGER 2
            ^"Grips" STRING "1-hand: no bonus; 2-hand: Damage +2, Deadliness +2, Range 1-2"
            ^"Qualities" LIST OF STRING ["Cumbersome", "Mundane"]
            ^"Rarity" INTEGER 3
            ^"Cost" STRING "4 koku"
            ^"Description" STRING "Like many weapons associated with the peasantry, the kuwa is a weaponized farming implement. Based on the hoe, it is a chopping weapon that is wielded similarly to a two-handed axe. The wielder uses the sharp end to fling dirt into an opponent's face before following up with a devastating chop. The butt end of the handle is also utilized in most kuwa fighting styles as a blunt ramming weapon or to block an assailant's initial attack."
        }
    }

    # --- BLUNT WEAPONS ---

    # source stat block (page 110)
    #mDGnsiMij0k583cJQpii4h ^"Gada" DEF {
        APPLIES TO [#t2eb48f120feed79eefc02 ^"Weapon"]
        PROPERTIES {
            ^"Category" STRING "Blunt Weapons"
            ^"Skills" STRING "Melee"
            ^"Range" STRING "1"
            ^"Damage" INTEGER 6
            ^"Deadliness" INTEGER 3
            ^"Grips" STRING "1-hand: no bonus; 2-hand: Deadliness +3"
            ^"Qualities" LIST OF STRING ["Ceremonial", "Cumbersome", "Wargear"]
            ^"Rarity" INTEGER 9
            ^"Cost" STRING "50 koku"
            ^"Description" STRING "A common heavy weapon in the Ivory Kingdoms, especially among caravan guards along the Sand Road, the gada consists of a long shaft capped with a spherical head with a pointed spike at the very top. Most gada are made of iron, but ceremonial versions are often gilded or dipped in molten gold. Red-coral gada are especially effective against the rakshasa of the Ghostlands and are highly prized weapons associated with the Ivory Kingdoms' greatest warriors. Gada come in massive sizes designed to crush the skulls of charging mounts and in smaller versions designed to be wielded in pairs."
        }
    }

    # --- SWORDS ---

    # source stat block (page 110)
    #oYUbQK0rHD3kfONpju7JYW ^"Talwar" DEF {
        APPLIES TO [#t2eb48f120feed79eefc02 ^"Weapon"]
        PROPERTIES {
            ^"Category" STRING "Swords"
            ^"Skills" STRING "Melee"
            ^"Range" STRING "1"
            ^"Damage" INTEGER 4
            ^"Deadliness" INTEGER 6
            ^"Grips" STRING "1-hand: no bonus"
            ^"Qualities" LIST OF STRING ["Cumbersome", "Durable", "Razor-Edged"]
            ^"Rarity" INTEGER 8
            ^"Cost" STRING "35 koku"
            ^"Description" STRING "The Ivory Kingdoms sidearm is the talwar, or \"single-edged sword.\" A curved saber with one sharp edge and a cross-guarded hilt with a knuckle-bow, it is designed to be wielded in a specialized one-handed grip. The sword's hilt is bulb shaped, requiring that the sword be held differently than those forged by Rokugani. This and the blade's unusual balance means that talwar fighting requires special training; attempting to use the sword as one might a Rokugani blade can break the talwar or injure one's wrist. However, when a talwar is wielded correctly, the wider cutting tip at the end of its blade affords it more cutting power, making this sidearm an especially deadly weapon."
        }
    }

    # source stat block (page 111)
    #q3wxu1RBgvYUMsOOOtyKLk ^"Urumi" DEF {
        APPLIES TO [#t2eb48f120feed79eefc02 ^"Weapon"]
        PROPERTIES {
            ^"Category" STRING "Swords"
            ^"Skills" STRING "Melee"
            ^"Range" STRING "1-2"
            ^"Damage" INTEGER 4
            ^"Deadliness" INTEGER 5
            ^"Grips" STRING "1-hand: no bonus"
            ^"Qualities" LIST OF STRING ["Cumbersome", "Razor-Edged", "Snaring"]
            ^"Rarity" INTEGER 9
            ^"Cost" STRING "50 koku"
            ^"Description" STRING "Considered one of the most challenging weapons to train with, the urumi, or \"whip sword,\" is a specialized weapon. Even just to start learning to use it, a person must first know both swordfighting and chain weaponry. An urumi consists of one to three flexible whip blades made from thin steel and mounted to a talwar's handle. Similar to the bullwhip, the urumi excels at keeping multiple foes at bay, but it poses a significant risk of self-injury should anything go awry. This risk does little to dissuade those who study the urumi, however. Due to this weapon's difficulty, wielders who master it are venerated as unparalleled martial artists."
        }
    }

    # --- SPECIALIST WEAPONS ---

    # source stat block (page 110)
    #tHo13TE9EqomAMo4mQ0XKO ^"Chain Whip" DEF {
        APPLIES TO [#t2eb48f120feed79eefc02 ^"Weapon"]
        PROPERTIES {
            ^"Category" STRING "Specialist Weapons"
            ^"Skills" STRING "Melee"
            ^"Range" STRING "1-2"
            ^"Damage" INTEGER 3
            ^"Deadliness" INTEGER 5
            ^"Grips" STRING "1-hand: no bonus"
            ^"Qualities" LIST OF STRING ["Razor-Edged", "Snaring"]
            ^"Rarity" INTEGER 6
            ^"Cost" STRING "4 koku"
            ^"Description" STRING "A specialized weapon made from a series of several stiff metal rods connected by chain loops. This long, flexible whip is used single-handed, with a wooden or metal grip on one end and a sharp metal dart on the other. Non-combat whips also exist, though very sparsely, in Rokugan. Such whips are typically made of a thick leather cord and are used by Unicorn farmers in remote areas to manage livestock."
        }
    }

    # source stat block (page 110)
    #vXVpxoJrfjCX90HixgI6FQ ^"Sling" DEF {
        APPLIES TO [#t2eb48f120feed79eefc02 ^"Weapon"]
        PROPERTIES {
            ^"Category" STRING "Specialist Weapons"
            ^"Skills" STRING "Ranged"
            ^"Range" STRING "2-3"
            ^"Damage" INTEGER 3
            ^"Deadliness" INTEGER 3
            ^"Grips" STRING "1-hand: no bonus"
            ^"Qualities" LIST OF STRING ["Concealable", "Mundane"]
            ^"Rarity" INTEGER 2
            ^"Cost" STRING "1 bu"
            ^"Description" STRING "Perhaps the humblest of projectile weapons, the sling is a length of braided cord with a pouch for holding a stone. The wielder swings the stone within the sling for momentum, then releases one end of the sling to propel the stone a great distance. Many samurai underestimate a sling's usefulness, considering it a peasant weapon at best and a toy at worst. But in the right hands, a sling's range is greater than that of a bow, and a slung stone can kill an unarmored foe instantly on impact. In addition to being popular among rōnin and peasants, the sling is favored by the Sparrow Clan due to its inexpensive production and the ease of acquiring ammunition."
        }
    }

    # --- SHIELDS ---

    # source stat block (page 111)
    #Xt1qc6tIzDCvPK6RzaE249 ^"Buckler" DEF {
        APPLIES TO [#t2eb48f120feed79eefc02 ^"Weapon"]
        PROPERTIES {
            ^"Category" STRING "Shields"
            ^"Skills" STRING "Melee"
            ^"Range" STRING "0"
            ^"Damage" INTEGER 2
            ^"Deadliness" INTEGER 2
            ^"Grips" STRING "1-hand: no bonus"
            ^"Qualities" LIST OF STRING ["Ceremonial", "Wargear"]
            ^"Rarity" INTEGER 7
            ^"Cost" STRING "4 koku"
            ^"Description" STRING "A buckler is a small, round, oval, or rectangular shield typically a foot and a half across. It provides the wearer several benefits, including increased defense against projectiles, safety for the sword hand, and can also be used as a powerful bludgeoning tool."
        }
        RULES {
            #L5RPW08sR7mJ6mX4eW6lE5rN5jJ: buckler_resistance "While you have a readied buckler, treat your physical resistance as 3."
            #L5RPW08zQ3kP3fY9vE9aT6uV2bE: buckler_defense "As a Movement and Support action, if you have a buckler readied, you may increase the TN of the next attack action check made targeting you by 1. This effect persists until the end of your next turn."
        }
    }

    # source stat block (page 111)
    #R39UvgElkfnNxmyQEPxjqa ^"Qamarist Heavy Shield" DEF {
        APPLIES TO [#t2eb48f120feed79eefc02 ^"Weapon"]
        PROPERTIES {
            ^"Category" STRING "Shields"
            ^"Skills" STRING "Melee"
            ^"Range" STRING "0"
            ^"Damage" INTEGER 4
            ^"Deadliness" INTEGER 2
            ^"Grips" STRING "1-hand: no bonus"
            ^"Qualities" LIST OF STRING ["Durable", "Cumbersome", "Wargear"]
            ^"Rarity" INTEGER 9
            ^"Cost" STRING "50 koku"
            ^"Description" STRING "The Qamarists of al-Zawira have a force of specially trained guards who are adept at maneuvering and working with the heavy, advanced shields produced by the master crafters and alchemists of the caliph. These shields cover nearly two-thirds of an average warrior's body, and are extremely heavy. Not only do they offer increased protection from both ranged and melee assault, but these massive shields can be used to bull rush opponents and knock over multiple enemies if used by a skilled combatant. These shields are also created to ward off supernatural effects using the secretive methods of the caliph's alchemists."
        }
        RULES {
            #L5RPW08yI9gD2xV7jF6aQ2lM4kL: qamarist_shield_resistance "While you have a readied Qamarist Heavy Shield, treat your physical resistance as 4 and your supernatural resistance as 2."
            #L5RPW08lE5uZ3hZ3bN3qF4dM4iW: qamarist_shield_defense "As a Movement and Support action, if you have a heavy shield readied, you may increase the TN of Attack action checks made targeting you by 3. This persists until the start of your next turn."
        }
    }

