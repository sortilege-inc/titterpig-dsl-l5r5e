            }
            ^"Starting Skills" DEF { CHOOSE 3 [^"Fitness", ^"Martial Arts [Melee]", ^"Meditation", ^"Sentiment", ^"Survival", ^"Theology"] INTEGER 1 }
            ^"Starting Honor" INTEGER DEFAULT 50
            ^"Techniques Available" LIST ["Kata", "Rituals", "Shūji"]
        }

        STARTING_TECHNIQUES {
            INVOCATION CHOOSE 3 [^"Biting Steel", ^"Blessed Wind", ^"Courage of Seven Thunders", ^"Nature's Touch", ^"The Rushing Wave"]
            KATA ^"Striking as Water"
