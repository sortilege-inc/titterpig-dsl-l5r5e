            "You are a seasoned viewer of (or participant in) Kabuki, and you have many connections in the world of theater."
            "After performing a check to engage with Kabuki (such as a Culture [Air] check to make an insightful comment about a performance or a Performance [Air] check to put on an impromptu show to distract someone), you remove 3 strife."
        }
    }

    # source stat block (page 90)
    #Pf16lOrYTUZouoFpY0BtSD ^"Kyudo" DEF {
        EXTENDS #L5R267zA9bC1dE3fG5hI7j ^"Passion"

        PROPERTIES {
            ^"Ring" STRING "Void"
            ^"Types" LIST ["Mental", "Physical"]
        }

