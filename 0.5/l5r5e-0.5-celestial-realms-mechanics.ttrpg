            ^"Roles" LIST ["Bushi", "Shugenja"]
            ^"Ring Increase" DEF {
                ^"Earth" INTEGER 1
                ^"Water" INTEGER 1
            }
            ^"Starting Skills" DEF { CHOOSE 5 [^"Composition", ^"Courtesy", ^"Games", ^"Martial Arts [Ranged]", ^"Performance", ^"Sentiment", ^"Theology"] INTEGER 1 }
            ^"Starting Honor" INTEGER DEFAULT 45
            ^"Techniques Available" LIST ["Invocations", "Kata", "Rituals"]
        }

        STARTING_TECHNIQUES {
            INVOCATION CHOOSE 2 [^"Armor of Earth", ^"Extinguish", ^"Dominion of Suijin", ^"Tempest of Air"]
            KATA CHOOSE 2 [^"Striking as Air", ^"Striking as Earth", ^"Striking as Fire", ^"Striking as Water"]
        }

        SCHOOL_ABILITY "The Body Is a Shrine" {
            "When you are in the presence of a kami (such as an elemental kami or other Supernatural being the GM deems appropriate), you may make a TN 4 Courtesy check using a ring associated with the kami's element (its highest ring) or one of its elements (if it has multiple highest rings). If you fail, you suffer 3 fatigue and 3 strife and cannot attempt to act as a vessel again this session.\n\nIf you succeed, you convince the kami to use your body as a vessel. This grants you the following:\n\nAny time you make a check using one of the kami's elements, you may reroll a number of dice up to your school rank.\n\nAny time you make a check using one of the kami's opposing elements, increase the TN by 1 and add one kept (ring) set to (op) (st).\n\nIf you unmask, the kami is released (see Releasing Kami)."
        }

        MASTERY_ABILITY ^"Temple of the Heart" {
            "You may keep two kami within you at once instead of one. All effects of The Body Is a Shrine still apply. If two kami share an element, the effects do not stack for that element."
        }
        STARTING_OUTFIT [
            "traveling clothes", "sanctified robes",
            "yumi (bow)", "quiver of arrows",
            "wakizashi (short sword)", "knife",
            "bowyer's kit or divination kit"
        ]

        CURRICULUM {
            RANK 1 {
                SKILL_GROUP "Social Skills"
                SKILL "Composition"
                SKILL "Medicine"
                SKILL "Theology"
                TECHNIQUE_GROUP "Rank 1 Kata"
