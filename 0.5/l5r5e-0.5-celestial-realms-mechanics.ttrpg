EXTENSION "L5R5e_Celestial_Realms" EXTENDS "L5R5e_Core_Character" {
    NAME "Legend of the Five Rings 5th Edition - Celestial Realms: New Player Options"
    VERSION "0.5.3"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-03-01"

    # Celestial Realms (Chapter 2): Centipede Minor Clan, Moshi family,
    # new schools, advantages, disadvantages, heritages, weapons, arrows,
    # spiritual artifacts, omamori, ancestral swords, item pattern,
    # invocations, rituals, inversions (new technique type), titles.

    # ===========================
    # CENTIPEDE MINOR CLAN
    # ===========================

    #kc0ImAAPTCRD7aDcwBSHru ^"Centipede Minor Clan" DEF {
        EXTENDS #L5R250aB2cD4eF6gH8iJ0k ^"Clan"
        APPLIES TO [#L5R003xY4zA6bC8dE0fG2hI ^"Samurai"]

        PROPERTIES {
            ^"Clan Name" STRING "Centipede" FIXED
            ^"Clan Type" STRING "Minor Clan"
            ^"Clan Ring Bonus" DEF { ^"Fire" INTEGER 1 }
            ^"Clan Skill Bonus" DEF { ^"Theology" INTEGER 1 }
            ^"Clan Status" INTEGER DEFAULT 30
        }

        FAMILIES {
            ^"Moshi"
        }

        RULES {
            #L5RCR01aB2cD4eF6gH8iJ0: foremost_followers_of_amaterasu "The Centipede Clan are the foremost followers of Amaterasu, and they view themselves as bulwarks of sacred traditions. They sing their greetings to Amaterasu each morning and tend to one of the most revered locations in all of Rokugan, the place where it is said Amaterasu herself descended from the Heavens to speak with their founder. The stone on which Amaterasu once trod now serves as the site of the Shrine of the Lady Sun, which is centered on a massive gilded statue of the goddess welcoming travelers with open arms."
            #jgaDorPZNeHTATx2wI8ZVB: the_founding_of_the_moshi "The Founding of the Moshi: Centuries ago, Isawa Azami, a shugenja of the Phoenix Clan, traversed the Mountains of Regret with his wife, Isawa Kichi. There they found a lush and fertile valley hidden from the rest of Rokugan. Azami and Kichi settled their family in this serene paradise, naming it Mukade no Tani. They then had eleven daughters, lived a good life, and quietly passed away.\n\nAfter Azami and Kichi passed away, the duty of heading the family passed to their eldest daughter, Isawa Moshi. Moshi, distraught over the death of her parents and feeling burdened by her new responsibilities, climbed to the top of what would soon become known as the Mountain of the Sun Goddess to meditate. It was then that Amaterasu descended from the Heavens to speak with Moshi.\n\nThe goddess told the young woman that she had chosen Moshi's family to be her acolytes, and that Moshi herself was destined to lead them. It is said that Amaterasu then revealed the secrets of the cosmos to Moshi, who in turn became Enlightened. The goddess placed her blessing on Isawa Moshi and her sisters, a gift that meant all of the women in their family would have a chance to hear the goddess as Moshi had, should their hearts and minds remain open to her wisdom. Isawa Moshi in return pledged the loyalty of her family to the Lady Sun.\n\nIsawa Moshi then changed her name to Moshi Azami and the family's name to Moshi. She kept her father's name to honor him, but she chose to forsake the Isawa name in favor of her own. This decision, once the news reached the other Isawa, was regarded as an act of arrogance, earning the family much scorn and condemnation from within the Phoenix for abandoning the name of Isawa. However, Moshi Azami did not mean this to be an offense, having chosen the name to reflect the family's position as acolytes who speak to a higher power: the word Moshi is a greeting of deference to a person higher in station. Moshi Azami also arranged for the construction of the Shrine of the Lady Sun, built at the very site of her fateful encounter with Amaterasu."
        }
    }

    # ===========================
    # CENTIPEDE FAMILIES
    # ===========================

    #L5RCR50aB2cD4eF6gH8iJ0k ^"Moshi" DEF {
        EXTENDS #L5R251lM3nO5pQ7rS9tU1v ^"Family"
        APPLIES TO [#L5R003xY4zA6bC8dE0fG2hI ^"Samurai"]

        PROPERTIES {
            ^"Family Name"     STRING "Moshi" FIXED
            ^"Clan"            STRING "Centipede"
            ^"Ring Increase" DEF { CHOOSE 1 [^"Air", ^"Fire"] INTEGER 1 }
            ^"Skill Increases" DEF {
                ^"Fitness" INTEGER 1
                ^"Meditation" INTEGER 1
            }
            ^"Glory"           INTEGER 40
            ^"Wealth" DEF { ^"Count" INTEGER 3  ^"Type" STRING "koku"  ^"Starting" BOOLEAN true }
        }
    }

    # ===========================
    # NEW SCHOOLS
    # ===========================

    # source stat block (page 80)
    #H0vMqbrjHeaKmJEWQRvxK5 ^"Agasha Alchemist" DEF {
        EXTENDS #L5R252wX4yZ6aB8cD0eF2g ^"School"
        APPLIES TO [#L5R003xY4zA6bC8dE0fG2hI ^"Samurai"]

        PROPERTIES {
            ^"School Name" STRING "Agasha Alchemist" FIXED
            ^"Clan" STRING "Dragon"
            ^"Roles" LIST ["Shugenja"]
            ^"Ring Increase" DEF {
                ^"Fire" INTEGER 1
                ^"Water" INTEGER 1
            }
            ^"Starting Skills" DEF { CHOOSE 3 [^"Martial Arts [Ranged]", ^"Medicine", ^"Meditation", ^"Performance", ^"Survival", ^"Theology"] INTEGER 1 }
            ^"Starting Honor" INTEGER DEFAULT 40
            ^"Techniques Available" LIST ["Invocations", "Rituals", "Shūji"]
        }

        STARTING_TECHNIQUES {
            INVOCATION CHOOSE 3 [#StycJ659E01uLV5IC41HMB ^"Amaterasu's Gaze", ^"Fukurokujin's Wit", ^"Path to Inner Peace", ^"The Cleansing Fire", ^"The Fires from Within"]
            SHUJI CHOOSE 2 [^"Shallow Waters", ^"Stirring the Embers", ^"Truth Burns through Lies"]
        }

        SCHOOL_ABILITY "Flesh of the Elements" {
            "You can have a number of additional potions with prepared invocations (see page 190 of the core rulebook) equal to your school rank. When you spend a downtime activity creating a potion, you may make a number of supplemental checks after the first to create additional potions equal to your school rank, but each check must be for a different invocation."
        }

        MASTERY_ABILITY ^"Experimental Concoction" {
            "Once per game session as a Support action, you may make a TN 4 Medicine (Water) check to combine two of your potions that share at least one invocation effect keyword (mend, purify, smite, etc.) If you succeed, the two potions become a single concoction with both properties; when this concoction is used, resolve the effects of both of the prepared invocations that are part of it. A concoction cannot be combined with another potion or concoction."
        }
        STARTING_OUTFIT [
            "traveling clothes", "one weapon of rarity 7 or lower",
            "blowgun and pouch of darts", "wakizashi (short sword)",
            "medicine kit", "one omamori (your choice)",
            "a pouch of 5 blessed glass vials",
            "small satchel of ingredients worth 10 bu"
        ]

        CURRICULUM {
            RANK 1 {
                SKILL_GROUP "Scholar Skills"
                SKILL "Martial Arts [Ranged]"
                SKILL "Performance"
                SKILL "Smithing"
                TECHNIQUE_GROUP "Rank 1 Fire & Water Invocations"
                ^"Hawk's Precision" [kata]
                #QetgKdkKHD7pRlKZC8xbaJ ^"Fires of Purity" [invocation]
            }
            RANK 2 {
                SKILL_GROUP "Scholar Skills"
                SKILL "Martial Arts [Ranged]"
                SKILL "Performance"
                SKILL "Survival"
                TECHNIQUE_GROUP "Rank 1-2 Earth & Air Invocations"
                ^"Dazzling Performance" [shuji]
                ^"Pelting Hail Style" [kata]
            }
            RANK 3 {
                SKILL_GROUP "Social Skills"
                SKILL "Commerce"
                SKILL "Medicine"
                SKILL "Sentiment"
                TECHNIQUE_GROUP "Rank 1-3 Shūji"
                ^"Bravado" [shuji]
                #AivIuaq7l2mMDb0Vo20Wnq ^"Path of Beasts" [invocation]
            }
            RANK 4 {
                SKILL_GROUP "Scholar Skills"
                SKILL "Martial Arts [Ranged]"
                SKILL "Performance"
                SKILL "Smithing"
                TECHNIQUE_GROUP "Rank 1-4 Invocations"
                TECHNIQUE_GROUP "Rank 1-4 Ranged Kata"
                ^"Rain of Ten Thousand Lotuses" [invocation]
            }
            RANK 5 {
                SKILL_GROUP "Social Skills"
                SKILL "Commerce"
                SKILL "Martial Arts [Ranged]"
                SKILL "Survival"
                TECHNIQUE_GROUP "Rank 1-5 Invocations"
                ^"Heart of the Lady Sun" [invocation]
                ^"Sear the Wound" [shuji]
            }
            RANK 6 {
                ^"Experimental Concoction"
            }
        }

    }

    #Myw3km1AAZDGBCI3IV0BKc ^"Asahina Envoy" DEF {
        EXTENDS #L5R252wX4yZ6aB8cD0eF2g ^"School"
        APPLIES TO [#L5R003xY4zA6bC8dE0fG2hI ^"Samurai"]

        PROPERTIES {
            ^"School Name" STRING "Asahina Envoy" FIXED
            ^"Clan" STRING "Crane"
            ^"Roles" LIST ["Courtier"]
            ^"Ring Increase" DEF {
                ^"Air" INTEGER 1
                ^"Void" INTEGER 1
            }
            ^"Starting Skills" DEF { CHOOSE 5 [^"Aesthetics", ^"Courtesy", ^"Culture", ^"Meditation", ^"Performance", ^"Sentiment", ^"Theology"] INTEGER 1 }
            ^"Starting Honor" INTEGER DEFAULT 50
            ^"Techniques Available" LIST ["Kata", "Rituals", "Shūji"]
        }

        STARTING_TECHNIQUES {
            RITUAL ^"Tea Ceremony"
            SHUJI CHOOSE 1 [^"Cadence", ^"Shallow Waters", ^"Weight of Duty"]
        }

        SCHOOL_ABILITY "Soul of Ceremony" {
            "When you make a check to perform a ritual, you may add kept (ring) set to (op) results equal to your school rank. You may spend these (op) as if the ritual were also a Social skill check of your choice (such as to activate a shūji, etc.)."
        }

        MASTERY_ABILITY ^"Favored Counselor" {
            "When making a check to perform a ritual, you may spend (op) as follows:\n\n(op)+: One participant in the ritual with vigilance lower than or equal to (op) spent this way feels especially indebted to you. You gain the Ally [that character] advantage (see page 101 of the core rulebook)."
        }
        STARTING_OUTFIT [
            "traveling clothes", "ceremonial clothes",
            "sanctified robes", "wakizashi (short sword)",
            "knife or bō (staff)", "scroll satchel",
            "calligraphy set", "tea set",
            "traveling pack", "attendant", "Rokugani pony"
        ]

        CURRICULUM {
            RANK 1 {
                SKILL_GROUP "Social Skills"
                SKILL "Aesthetics"
                SKILL "Culture"
                SKILL "Government"
                TECHNIQUE_GROUP "Rank 1 Air Shūji"
                ^"Lady Doji's Decree" [shuji]
                ^"Divination" [ritual]
            }
            RANK 2 {
                SKILL_GROUP "Scholar Skills"
                SKILL "Command"
                SKILL "Design"
                SKILL "Performance"
                TECHNIQUE_GROUP "Rank 1-2 Fire Shūji"
                ^"Dazzling Performance" [shuji]
                #yk2aTaiUkeh7RPqDPSLYe3 ^"Blessing of the Dance" [ritual]
            }
            RANK 3 {
                SKILL_GROUP "Social Skills"
                SKILL "Commerce"
                SKILL "Culture"
                SKILL "Theology"
                TECHNIQUE_GROUP "Rank 1-3 Air Shūji"
                ^"Blessed Union" [ritual]
                #dZ2xdKlMcwCRtosnqJJ8uw ^"Prayer of Protection" [ritual]
            }
            RANK 4 {
                SKILL_GROUP "Artisan Skills"
                SKILL "Courtesy"
                SKILL "Performance"
                SKILL "Sentiment"
                TECHNIQUE_GROUP "Rank 1-4 Water Shūji"
                TECHNIQUE_GROUP "Rank 1-5 Rituals"
                ^"Buoyant Arrival" [shuji]
            }
            RANK 5 {
                SKILL_GROUP "Social Skills"
                SKILL "Aesthetics"
                SKILL "Culture"
                SKILL "Design"
                TECHNIQUE_GROUP "Rank 1-5 Void Shūji"
                ^"Bend with the Storm" [shuji]
                ^"The Immovable Hand of Peace" [shuji]
            }
            RANK 6 {
                ^"Favored Counselor"
            }
        }

        RULES {
            #SiWKpDCtwy9pqg1k90i4zY: asahina_envoy_school "Asahina Envoy School: As honest arbiters of harmony, the Asahina train a select few as specialized priests called Asahina Envoys. These envoys travel to the lands of other clans to offer aid and foster positive relations with even the most unruly of daimyō. These individuals learn how to navigate more personal visits and ceremonies involving other groups, rather than focusing on the broader political games of the courts. Among other tasks, they officiate at weddings, conduct funeral rites when priests of Emma-Ō are unavailable, and bless newborns."
        }
    }

