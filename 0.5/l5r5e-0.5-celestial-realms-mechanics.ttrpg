                CHOOSE 1 [^"Air", ^"Earth", ^"Fire", ^"Water"] INTEGER 1
            }
            ^"Starting Skills" DEF { CHOOSE 3 [^"Fitness", ^"Medicine", ^"Meditation", ^"Sentiment", ^"Survival", ^"Theology"] INTEGER 1 }
            ^"Starting Honor" INTEGER DEFAULT 40
            ^"Techniques Available" LIST ["Inversions", "Rituals", "Shūji"]
        }

        STARTING_TECHNIQUES {
            INVERSION CHOOSE 1 [#Avqr2DDV67BerlxHaFv4Pd ^"One within the Void", #oSNFgOvcypSN4OVr8Hhc1F ^"Sight beyond Existence", #HPzA4KcJxI6pICFEIMbAmg ^"Whispered Blade", #80W0AsD6ip7Y27629JL6mq ^"Witness the End"]
            RITUAL CHOOSE 1 [^"Commune with the Spirits", ^"Divination", ^"Threshold Barrier"]
