                TECHNIQUE_GROUP "Rank 1-3 Inversions"
                ^"A Samurai's Fate" [shuji]
            }
            RANK 4 {
                SKILL_GROUP "Trade Skills"
                SKILL "Courtesy"
                SKILL "Meditation"
                SKILL "Theology"
                TECHNIQUE_GROUP "Rank 1-4 Earth Invocations"
                TECHNIQUE_GROUP "Rank 1-4 Inversions"
