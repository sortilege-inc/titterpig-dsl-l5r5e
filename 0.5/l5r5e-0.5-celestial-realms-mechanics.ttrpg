    # --- Ancestral Swords ---

    # source stat block (page 99)
    #flcf7F9kXKTGYd5H21ooDr ^"Chikara (Ancestral Sword of the Crab)" DEF {
        APPLIES TO [#te28b9de1d70883d12c080 ^"Item"]
        PROPERTIES {
            ^"Item Type" STRING "Ancestral Sword (Nemuranai)" FIXED
            ^"Clan" STRING "Crab"
            ^"Weapon Type" STRING "Chokuto (straight sword)"
            ^"Profile" STRING "Range 0-1, Damage 4, Deadliness 7, Ceremonial, Razor-Edged, Sacred"
            ^"Quirk" STRING "Chikara never rusts, never dulls, and cannot be taken apart (not even to be reforged). Unlike typical swords, it can be cleansed by ladling ordinary water across its surface, any dirt or viscera washing away without scrubbing. Chikara was forged with jade sand folded into the metal in a process lost to history, making it a bane to the Shadowlands."
            ^"Special" STRING "Vigilant Blade: Chikara cannot become Damaged or Destroyed, and its wielder is immune to the Afflicted condition."
            ^"Sealed Inversion" STRING "Chikara contains the Essence Eternal inversion (see page 119), which is activated using Fitness (Void) instead of Theology (Void). Additionally, the inversion can target only the wielder of Chikara."
        }
    }

    # source stat block (page 100)
    #AxGsYYLilQm6vTKkbAuALQ ^"Shukujo (Ancestral Sword of the Crane)" DEF {
        APPLIES TO [#te28b9de1d70883d12c080 ^"Item"]
        PROPERTIES {
            ^"Item Type" STRING "Ancestral Sword (Nemuranai)" FIXED
            ^"Clan" STRING "Crane"
            ^"Weapon Type" STRING "Uchigatana"
            ^"Profile" STRING "Range 1, Damage 5, Deadliness 5, Ceremonial, Durable, Sacred"
            ^"Quirk" STRING "Shukujo sings a brilliant note when drawn by a person who can trace their bloodline to Doji."
            ^"Sealed Inversion" STRING "Shukujo contains the Witness the End inversion (see page 116), which is activated with Meditation (Void) instead of Theology (Void). Instead of being activated during a character's turn, this inversion can be activated only at the end of the staredown in a duel or clash, and the TN to activate it is always 1."
        }
    }

    # source stat block (page 100)
    #yK8KVHnKEfhgWEnJLG2Lyc ^"Blade with No Name (Ancestral Sword of the Dragon)" DEF {
        APPLIES TO [#te28b9de1d70883d12c080 ^"Item"]
        PROPERTIES {
            ^"Item Type" STRING "Ancestral Sword (Nemuranai)" FIXED
            ^"Clan" STRING "Dragon"
            ^"Weapon Type" STRING "Any sword (philosophical concept)"
            ^"Quirk" STRING "From time to time, kōan come to your mind unbidden. These paradoxical riddles particularly pop into your head when you are just about to fall asleep."
            ^"Sealed Inversion" STRING "Mastering the Blade with No Name grants the character the inversion The Lotus Blooms (see page 117), which they can use once per game session and is activated using Meditation (Void) instead of Theology (Void)."
            ^"Note" STRING "Only a handful within the Dragon Clan know that the ancestral sword of the Dragon is not a literal blade, but a philosophic concept, one uttered by Togashi himself to Mirumoto's heir: \"Kill a thousand warriors, master one blade. Kill the self, master all blades.\"\n\nTo one who has mastered themself, any sword they grip is the Blade with No Name."
        }
    }

    #bqSJ8g7gTpEXqWXhRuHqL4 ^"Shori (Ancestral Sword of the Lion)" DEF {
        APPLIES TO [#te28b9de1d70883d12c080 ^"Item"]
        PROPERTIES {
            ^"Item Type" STRING "Ancestral Sword (Nemuranai)" FIXED
            ^"Clan" STRING "Lion"
            ^"Weapon Type" STRING "Tachi"
            ^"Profile" STRING "Range 1, Damage 6, Deadliness 6/7, Ceremonial, Durable, Sacred"
            ^"Quirk" STRING "If Shori's wielder commits a dishonorable act, the blade fills their head with the roars of ten thousand Lions."
            ^"Special" STRING "Mandate of the Chrysanthemum: While in possession of Shori at the sanction of the Emperor, the wielder does not forfeit glory for major or massive glory breaches."
            ^"Sealed Inversion" STRING "Shori contains the Three Heartbeats inversion (see page 119), which is activated using Command (Void) instead of Theology (Void)."
        }
    }

    # source stat block (page 102)
    #N3NHgAYkj3Ki7xnOhR69Wr ^"Ofushikai (Ancestral Sword of the Phoenix)" DEF {
        APPLIES TO [#te28b9de1d70883d12c080 ^"Item"]
        PROPERTIES {
            ^"Item Type" STRING "Ancestral Sword (Nemuranai)" FIXED
            ^"Clan" STRING "Phoenix"
            ^"Weapon Type" STRING "Ancient Tachi"
            ^"Profile" STRING "Range 1, Damage 5, Deadliness 4, Ceremonial, Durable, Sacred"
            ^"Quirk" STRING "Ofushikai is home to generations of Phoenix Clan Champions. Only the Shiba it has chosen as clan champion can draw it, and that daimyō can call it into their hand from any distance. In the hands of anyone who does not have the ghosts' sanction, it is useless."
            ^"Special" STRING "Tsamaru's Love: The wielder of Ofushikai can breathe and speak underwater as though they were on land."
            ^"Sealed Inversion" STRING "Ofushikai contains the One within the Void inversion (see page 114), which is activated using Theology (Void) instead of Sentiment (Void). Additionally, the inversion can target only the past wielders of Ofushikai who inhabit the blade. These ancient spirits use the Venerable Provincial Daimyō profile (see page 315 of the core rulebook) with the rules for spirits (on page 287 of the core rulebook), or another appropriate profile at the GM's discretion."
        }
    }

    # source stat block (page 103)
    #MqvmTks0Ok8qNZJZmJQp8R ^"Itsuwari (Ancestral Sword of the Scorpion)" DEF {
        APPLIES TO [#te28b9de1d70883d12c080 ^"Item"]
        PROPERTIES {
            ^"Item Type" STRING "Ancestral Sword (Nemuranai)" FIXED
            ^"Clan" STRING "Scorpion"
            ^"Weapon Type" STRING "Short Jian"
            ^"Profile" STRING "Range 0-1, Damage 4, Deadliness 7/8, Ceremonial, Concealable, Durable, Sacred"
            ^"Quirk" STRING "The shadow ink on the blade shifts to show the Scorpion Clan Champion's current location."
            ^"Special" STRING "The Shadow's Judge: After its wielder makes a successful Attack action check targeting the Scorpion Clan Champion, the champion suffers a critical strike with severity 16 and automatically counts as failing their check to resist it."
            ^"Sealed Inversion" STRING "Itsuwari contains the Ethereal Flicker inversion (see page 116), which is activated using Skulduggery (Void) instead of Theology (Void)."
            ^"Note" STRING "To all appearances, the Scorpion Clan Champion carries Itsuwari, but keen-eyed observers note that the sword is never actually drawn. That is because the Itsuwari worn by the champion is a fake.\n\nThis is because the purpose of Itsuwari is to kill the Scorpion Clan Champion should they ever betray the Empire."
        }
    }

