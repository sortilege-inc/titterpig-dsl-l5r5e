# .codex SECTION — Mask of the Oni (adventure). Stand-off graph over
# l5r5e-0.5-mask-of-the-oni.lore (spec §25). Part of the L5R5e system graph;
# DEPENDS_ON the shared schema.
#
# The adventure's cast (Kitsu Sokori, Atsumari no Oni, Hida Nagahide in
# l5r5e-0.5-mask-of-the-oni-cast.ttrpg) are DEFs — referenced via ^"...", never
# minted. Shiro Hiruma (Knotted Tails), the Kaiu Wall (Highwayman), Slow Tide
# Harbor (Shadowlands), and the Maw are already in the graph — referenced, and
# Shiro Hiruma / the Kaiu Wall / Slow Tide Harbor / the Maw amended. This section
# mints the historical figures: the Moth/Kaikoga shugenja Hiruma Masami, the
# cartographer Yasuki Keiji, and the Hiruma rōnin Hozumi whom Sokori tortured for
# the castle's secrets.

CODEX "L5R5e_MaskOfTheOni_Codex" {
    NAME "Mask of the Oni — Lore Graph"
    VERSION "0.5.2"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-09-03"
    FOR EDITION "l5r5e"
    DEPENDS_ON "L5R5e_Codex_Schema" VERSION "0.5.9"

    # ---- The Moth Clan family ---------------------------------------------
    ENTITY #L5RcxMoO04kaikogafamily ^"Kaikoga" {
        IS ^"Faction"
        SOURCE "l5r5e-0.5-mask-of-the-oni.lore" AT "the-fate-of-the-hiruma-gm-only"
    }

    # ---- Historical & lore-only figures -----------------------------------
    ENTITY #L5RcxMoO01hirumamasami ^"Hiruma Masami" {
        IS ^"Person"
        SOURCE "l5r5e-0.5-mask-of-the-oni.lore" AT "the-samurai-quarters"
        RELATIONSHIPS {
            ^"member-of" -> ^"Kaikoga"
            ^"enemy-of"  -> ^"Atsumari no Oni"   FROM "He was taken alive by Atsumari no Oni, who, in a fit of rage over being stymied by Hiruma Masami, imprisoned and kept Tomoharu alive by means of the twisted sorcery of the iron cage." }
    }
    ENTITY #L5RcxMoO02yasukikeiji ^"Yasuki Keiji" {
        IS ^"Person"
        SOURCE "l5r5e-0.5-mask-of-the-oni.lore" AT "if-the-pcs-have-played-dark-tides"
        RELATIONSHIPS { ^"member-of" -> ^"Yasuki" FROM "As a final clue, Crab magistrates in Clear Water Village report the theft of ancient maps from a samurai named Yasuki Keiji." }
    }
    ENTITY #L5RcxMoO03hozumironin ^"Hozumi" {
        IS ^"Person"
        SOURCE "l5r5e-0.5-mask-of-the-oni.lore" AT "part-one-adventure-background"
        RELATIONSHIPS {
            ^"member-of" -> ^"Hiruma"        FROM "In Soft Breeze Village, a rather grubby coastal town in the Crane lands, she happened upon a washed-up rōnin named Hozumi, who had once belonged to the Hiruma family."
            ^"enemy-of"  -> ^"Kitsu Sokori"  FROM "Hozumi was last seen alive speaking with a mysterious woman matching descriptions of Kitsu Sokori (obtained from witnesses in Slow Tide Harbor either by the PCs or other investigators)." }
    }

    # ---- Amendments to existing graph nodes --------------------------------
    ENTITY #HfpS0mwWcNggGn4LbpFYJj ^"Shiro Hiruma" {
        SOURCE "l5r5e-0.5-mask-of-the-oni.lore" AT "mask-of-the-oni"
        RELATIONSHIPS {
            ^"seat-of"     -> ^"Hiruma"          FROM "Entering Shiro Hiruma"
            ^"haunted-by"  -> ^"Atsumari no Oni" FROM "While instrumental in conquering Shiro Hiruma, Atsumari no Oni was never again seen after the castle’s fall, due to a ritual performed by a shugenja whose name has been lost to history—Hiruma Masami." }
    }
    ENTITY #H21xYNNhIDYRnQDFEJ3r1x ^"The Maw" {
        SOURCE "l5r5e-0.5-mask-of-the-oni.lore" AT "the-fall-of-daylight-castle-public-knowledge"
    }
    ENTITY #N1WnfOBOWrGonxKItB6LDA ^"Slow Tide Harbor" {
        SOURCE "l5r5e-0.5-mask-of-the-oni.lore" AT "the-involvement-of-kitsu-sokori-gm-only"
    }
    ENTITY #vYRQSaECZpWt7nmleTn86t ^"Kaiu Wall" {
        SOURCE "l5r5e-0.5-mask-of-the-oni.lore" AT "the-fall-of-daylight-castle-public-knowledge"
    }
}
