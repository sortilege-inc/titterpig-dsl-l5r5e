# .codex SECTION — The Highwayman (adventure). Stand-off graph over
# l5r5e-0.5-highwayman.lore (spec §25). Part of the L5R5e system graph;
# DEPENDS_ON the shared schema.
#
# The adventure's cast (5 NPCs in l5r5e-0.5-highwayman-cast.ttrpg) and the 6
# pregens (l5r5e-0.5-highwayman-pregens.actor) are DEFs — referenced via ^"...",
# never minted. The Shinomen Forest, Ivory Kingdoms, Burning Sands, Shadowlands,
# Jigoku, Khanbulak, Mountains of Regret, and the Yodha order are already in the
# graph (referenced; Shinomen, Yodha, and Mountains of Regret amended). Matsu is
# a family DEF (Maki Haruko was born Matsu Megumi — the same person as the pregen
# DEF, not re-minted). Bataar the haunting spirit and Od the hawk relate to the
# pregen Otgontogoch Turgen (a DEF). This section mints the adventure's places,
# the Hidetaka family, and its lore-only figures.

CODEX "L5R5e_Highwayman_Codex" {
    NAME "The Highwayman — Lore Graph"
    VERSION "0.5.2"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-09-02"
    FOR EDITION "l5r5e"
    DEPENDS_ON "L5R5e_Codex_Schema" VERSION "0.5.9"

    # ---- Places -----------------------------------------------------------
    ENTITY #L5RcxHwy01kawacho ^"Kawacho" {
        IS ^"Town"
        SOURCE "l5r5e-0.5-highwayman.lore" AT "who-are-you"
        RELATIONSHIPS {
            ^"held-by"      -> ^"Soshi"           FROM "Kawacho is a small town controlled by the Soshi through a vassal family."
            ^"located-near" -> ^"Shinomen Forest" }
    }
    ENTITY #L5RcxHwy02estate ^"Yukiko's Estate" {
        IS ^"Building"
        SOURCE "l5r5e-0.5-highwayman.lore" AT "approaching-the-entrance"
        RELATIONSHIPS {
            ^"located-in" -> ^"Shinomen Forest"
            ^"held-by"    -> ^"Lady Yukiko"      FROM "you are welcome in the estate of Lady Kuriyama Yukiko" }
    }
    ENTITY #L5RcxHwy03ghostlnd ^"Ghostlands" {
        IS ^"Region"
        SOURCE "l5r5e-0.5-highwayman.lore" AT "lady-yukiko-cunning-rakshasa"
        RELATIONSHIPS {
            ^"part-of"      -> ^"Shadowlands"    FROM "the Ghostland's forests (the southern region of the Shadowlands)"
            ^"located-near" -> ^"Ivory Kingdoms" FROM "Yukiko is a rakshasa of Ghostlands that plague the Ivory Kingdoms." }
    }
    ENTITY #L5RcxHwy04kaiuwall ^"Kaiu Wall" {
        IS ^"Wall"
        SOURCE "l5r5e-0.5-highwayman-handouts.lore" AT "playing-the-talented-artisan-with-a-secret"
        RELATIONSHIPS { ^"located-near" -> ^"Shadowlands" }
    }
    ENTITY #L5RcxHwy05redlotus ^"Red Lotus" {
        IS ^"Building"
        SOURCE "l5r5e-0.5-highwayman-handouts.lore" AT "playing-the-ambitious-former-geisha"
    }

    # ---- The Hidetaka family & Kawacho folk -------------------------------
    ENTITY #L5RcxHwy06hidetaka ^"Hidetaka" {
        IS ^"Faction"
        SOURCE "l5r5e-0.5-highwayman.lore" AT "who-are-you"
        RELATIONSHIPS { ^"located-in" -> ^"Kawacho" FROM "Hidetaka Nori was meant to leave about five-and-a-half days before the PCs arrive in Kawacho." }
    }
    ENTITY #L5RcxHwy07noricourier ^"Hidetaka Nori" {
        IS ^"Person"
        SOURCE "l5r5e-0.5-highwayman.lore" AT "the-highwayman"
        RELATIONSHIPS {
            ^"member-of"  -> ^"Hidetaka"         FROM "The adventure begins when the PCs arrive at a small town outside of the Shinomen in search of the missing courier Hidetaka Nori and, more importantly, the exorbitantly expensive sake he was supposed to deliver to Moronoka."
            ^"sibling-of" -> ^"Hidetaka Sasuke"  FROM "He was last seen leaving the village by his brother, Sasuke" }
    }
    ENTITY #L5RcxHwy08sazuko ^"Hidetaka Sazuko" {
        IS ^"Person"
        SOURCE "l5r5e-0.5-highwayman.lore" AT "act-1-the-missing-courier"
        RELATIONSHIPS { ^"member-of" -> ^"Hidetaka" FROM "Hidetaka Sazuko, Nori’s Mother: An aging woman who is quick to defend her son, but weary of angering anyone with a weapon." }
    }
    ENTITY #L5RcxHwy09sasami ^"Hidetaka Sasami" {
        IS ^"Person"
        SOURCE "l5r5e-0.5-highwayman.lore" AT "act-1-the-missing-courier"
        RELATIONSHIPS {
            ^"member-of"  -> ^"Hidetaka"      FROM "Hidetaka Sasami, Nori’s Sister: A spry, airy young woman with a mischievous affect."
            ^"sibling-of" -> ^"Hidetaka Nori" }
    }

    # ---- Other lore-only figures ------------------------------------------
    ENTITY #L5RcxHwy10moronoka ^"Ito Moronoka" {
        IS ^"Person"
        SOURCE "l5r5e-0.5-highwayman.lore" AT "the-highwayman"
        RELATIONSHIPS { ^"ally-of" -> ^"Ahuja Mishti" }
    }
    ENTITY #L5RcxHwy11asukaworker ^"Asuka" {
        IS ^"Person"
        SOURCE "l5r5e-0.5-highwayman.lore" AT "moronokas-shop"
        RELATIONSHIPS { ^"ally-of" -> ^"Ito Moronoka" }
    }
    ENTITY #L5RcxHwy12nakamura ^"Nakamura Jun'ichi" {
        IS ^"Person"
        SOURCE "l5r5e-0.5-highwayman-handouts.lore" AT "playing-the-ambitious-former-geisha"
        RELATIONSHIPS { ^"enemy-of" -> ^"Hiyabayashi Kenshin" }
    }
    ENTITY #L5RcxHwy13sukhbatar ^"Sukhbatar" {
        IS ^"Person"
        SOURCE "l5r5e-0.5-highwayman-handouts.lore" AT "playing-the-haunted-ujik"
        RELATIONSHIPS {
            ^"sibling-of" -> ^"Otgontogoch Turgen" FROM "Otgontogoch Turgen [Ought-gone-tog-otch Tur-gen] left his homeland in the Burning Sands a little over a year ago with his brother, Sukhbatar, after incurring the wrath of an angry shaman."
            ^"located-in" -> ^"Burning Sands"       FROM "Otgontogoch Turgen [Ought-gone-tog-otch Tur-gen] left his homeland in the Burning Sands a little over a year ago with his brother, Sukhbatar, after incurring the wrath of an angry shaman." }
    }
    ENTITY #L5RcxHwy14bataar ^"Bataar" {
        IS ^"Spirit"
        SOURCE "l5r5e-0.5-highwayman.lore" AT "sayaka-curious-trader"
    }

    # ---- Amendments to entities already in the graph ----------------------
    ENTITY #seywGtdaK0pWhjvppaBZPr ^"Shinomen Forest" {
        SOURCE "l5r5e-0.5-highwayman.lore" AT "the-highwayman"
        RELATIONSHIPS { ^"corrupted-by" -> ^"Lady Yukiko" }
    }
    ENTITY #gx6ICKU9JRkKvGzPc1VR2j ^"Yodha" {
        SOURCE "l5r5e-0.5-highwayman-handouts.lore" AT "playing-the-ivory-kingdoms-sage"
        RELATIONSHIPS { ^"enemy-of" -> ^"Lady Yukiko" FROM "One of the Yodha's greatest enemies are the rakshasa, shapeshifting demons that revel in tricking and eating unsuspecting humans" }
    }
    ENTITY #Q3OReesXNOH2Fbg5i0BMon ^"Mountains of Regret" {
        SOURCE "l5r5e-0.5-highwayman-handouts.lore" AT "playing-the-mystic-of-the-mountain"
    }
}
