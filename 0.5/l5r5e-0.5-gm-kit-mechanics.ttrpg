    # --- Ruffian (Desperate Bandit profile modification) ---

    #dRBNx0y5nBqM8kq25h0xo7 ^"Ruffian (GM Kit)" DEF {
        EXTENDS #t4540de6f35155c46f41f0 ^"NPC"
        PROPERTIES {
            ^"Source" STRING "GM Kit: Dark Tides"
            ^"Type" STRING "Adversary"
            ^"Conflict Rank (Combat)" INTEGER 1
            ^"Conflict Rank (Intrigue)" INTEGER 1
            ^"Base Profile" STRING "Desperate Bandit (Core Rulebook p. 315)"
        }
        PROPERTIES {
            ^"Demeanor" STRING "Assertive (Earth +2, Water -2)"
        }

        RULES {
            #VZncQPVCw5QJoCxY7PkNcd: warehouse_guards "The Guards: The ruffians should be numerous enough to offer some challenge to the PCs, but not so many as to pose a real threat of defeat—perhaps an encounter rank equal to half or two-thirds of the group rank (see page Constructing Conflicts on page 310 of the Core Rulebook). Their default action is to fight. Once it becomes clear they are outmatched, though, those who can flee do so, preferably via whichever entrance(s) the PCs did not use. This can lead to a chase, since the PCs probably want to take at least one prisoner for interrogation. (Alternatively, PCs who employ clever tactics in combat may be able to defeat one or more of the gang members without using lethal force, removing the need for a chase.)"
        }
    }

    # --- Gaijin Smuggler/Sailor (Desperate Bandit profile modification) ---

    #vl4mQyyN0BObur4rjf5GSO ^"Gaijin Smuggler/Sailor" DEF {
        EXTENDS #t4540de6f35155c46f41f0 ^"NPC"
        PROPERTIES {
            ^"Source" STRING "GM Kit: Dark Tides"
            ^"Type" STRING "Minion"
            ^"Conflict Rank (Combat)" INTEGER 1
            ^"Conflict Rank (Intrigue)" INTEGER 1
            ^"Base Profile" STRING "Desperate Bandit (Core Rulebook p. 315)"
        }
        PROPERTIES {
            ^"Demeanor" STRING "Shrewd (Fire -2, Water +2)"
            ^"Skills Override" STRING "Martial 3, Trade 2"
            ^"Advantages" STRING "Salt of the Sea (Fire) [Trade; Physical]"
            ^"Disadvantages" STRING "Cultural Ignorance (Water) [Social; Mental], Gaijin Appearance (Fire) [Physical; Interpersonal]"
            ^"Gear" STRING "Rigging daggers (Range 0, Damage 3, Deadliness 4, Concealable, Durable, Mundane; can be thrown [Range 1–3]), gaijin clothing (Physical 2), coil of rope, sake jug (half empty), pouch containing several gaijin coins and bu"
        }
    }

