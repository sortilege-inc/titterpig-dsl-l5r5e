# L5R 5E - GAME MASTER'S KIT: DARK TIDES - MECHANICS
#
# Source: Legend of the Five Rings 5th Edition - Game Master's Kit (Dark Tides adventure booklet, Part Two)
# Publisher: Fantasy Flight Games
# ISBN: 978-1-63344-338-9
# Product Code: L5R05
#
# Contains: Tortoise Minor Clan, Kasuga Family, Kasuga Smuggler School,
# and NPC profiles specific to the Dark Tides adventure.
#
# Note: The GM Kit Reference and GM Kit Screen Reference are
# consolidated in l5r5e-0.5-gm-screen-reference.ttrpg, as they
# contain only core rulebook content.

EXTENSION "L5R5e_GM_Kit_Mechanics" EXTENDS "L5R5e_Core_Character" {
    NAME "Legend of the Five Rings 5th Edition - Game Master's Kit Mechanics"
    VERSION "0.5.3"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-03-01"

    # ===========================
    # TORTOISE MINOR CLAN
    # ===========================

    #yCburGyj2hd96fURE2RWAm ^"Tortoise Minor Clan" DEF {
        EXTENDS #L5R250aB2cD4eF6gH8iJ0k ^"Clan"
        APPLIES TO [#L5R003xY4zA6bC8dE0fG2hI ^"Samurai"]

        PROPERTIES {
            ^"Clan Name" STRING "Tortoise" FIXED
            ^"Clan Type" STRING "Minor Clan"
            ^"Clan Ring Bonus" DEF { ^"Air" INTEGER 1 }
            ^"Clan Skill Bonus" DEF { ^"Commerce" INTEGER 1 }
            ^"Clan Status" INTEGER DEFAULT 25
        }

        FAMILIES {
            ^"Kasuga"
        }

        RULES {
            #L5RGMK00aB2cD4eF6gH8iJ0k: tortoise_gaijin_trade "In actuality, the Tortoise Clan has a secret and unique duty: it is tasked with monitoring and covertly trading with the gaijin, in order to ensure the tragedy of White Stag is never repeated. Tortoise ships sail across the Sea of Amaterasu, visiting gaijin ports, where their crews learn about (and keep watch on) foreign cultures and trade for exotic goods to bring back to Rokugan. As a result, the Tortoise Clan more closely resembles a smuggling cartel than a proper clan. The Tortoise do not have a conventional program of training for their samurai in the manner of other clans. On the contrary, the second Tortoise Clan Champion, Kasuga Genjiko, told her people to each follow their own path as they saw fit."
            #mRgIRR4ELC1Mz3JbrQJj0F: tortoise_clan_official_charge "The Tortoise Clan: Of all the minor clans of Rokugan, the clan of the Tortoise is perhaps both the most obscure and the most bizarre. Founded in the aftermath of the Battle of White Stag in the fifth century, the Tortoise Clan is—officially—merely a tiny clan charged with maintaining the ancient walls of Otosan Uchi. It was granted land in a modest territory northwest of the Imperial City, and has established small holdings across that area. The Tortoise are known to be quite eccentric, living alongside peasants and following an individualistic ethos that most samurai would consider odd and even shameful."
            #ORvPtow21vTIhsxtckJLRr: tortoise_clan_imperial_protection "Unsurprisingly, the Great Clans view the Tortoise with contempt when they bother to think about them at all. The curious might ask how the Tortoise survive while routinely breaking the Empire's laws and customs. There are two answers. The first is that when this Tortoise Clan was established, it was done under the direct authority and protection of the Emperor; this impedes any samurai who might otherwise cut them down or lead an army to exterminate them. The second is that it is a small clan whose members avoid notice and keep their worst activities well out of sight. Many Rokugani do not even know the clan exists, and most have never met a Tortoise samurai. The Tortoise Clan's true purpose—to keep watch on the gaijin—is known only to its members and to the Emperor. Most Emerald Magistrates are unaware of the deal, although the Emerald Champion might be."
        }
    }

    # ===========================
    # TORTOISE FAMILIES
    # ===========================

    #L5RGMK20zA9bC1dE3fG5hI7j ^"Kasuga" DEF {
        EXTENDS #L5R251lM3nO5pQ7rS9tU1v ^"Family"
        APPLIES TO [#L5R003xY4zA6bC8dE0fG2hI ^"Samurai"]

        PROPERTIES {
            ^"Family Name"     STRING "Kasuga" FIXED
            ^"Clan"            STRING "Tortoise"
            ^"Ring Increase" DEF { CHOOSE 1 [^"Earth", ^"Water"] INTEGER 1 }
            ^"Skill Increases" DEF {
                ^"Skulduggery" INTEGER 1
                ^"Government" INTEGER 1
            }
            ^"Glory"           INTEGER 33
            ^"Wealth" DEF { ^"Count" INTEGER 9  ^"Type" STRING "koku"  ^"Starting" BOOLEAN true }
        }
    }

    # ===========================
    # KASUGA SMUGGLER SCHOOL
    # ===========================

    #BYqZxKFj46JFtZLNCKuZGK ^"Kasuga Smuggler" DEF {
        EXTENDS #L5R252wX4yZ6aB8cD0eF2g ^"School"
        APPLIES TO [#L5R003xY4zA6bC8dE0fG2hI ^"Samurai"]

        PROPERTIES {
            ^"School Name" STRING "Kasuga Smuggler" FIXED
            ^"Clan" STRING "Tortoise"
            ^"Roles" LIST ["Courtier"]
            ^"Ring Increase" DEF {
                ^"Air" INTEGER 1
                ^"Water" INTEGER 1
            }
            ^"Starting Skills" DEF { CHOOSE 5 [^"Commerce", ^"Culture", ^"Courtesy", ^"Martial Arts [Melee]", ^"Seafaring", ^"Skulduggery"] INTEGER 1 }
            ^"Starting Honor" INTEGER DEFAULT 29
            ^"Techniques Available" LIST ["Kata", "Rituals", "Shūji"]
        }

        STARTING_TECHNIQUES {
            KATA ^"Rushing Avalanche Style"
            SHUJI CHOOSE 1 [^"Honest Assessment", ^"Well of Desire"]
        }

        SCHOOL_ABILITY "Way of the Tortoise" {
            "You never need to stake glory to publicly use a Trade skill, so long as you are doing so as part of your duty to your clan."
            "Once per scene, you may add a number of kept (ring) set to (op) results equal to your school rank to a check to interact with one or more gaijin, peasants, merchants, burakumin, or any other character with status of 20 or lower."
        }

        MASTERY_ABILITY ^"Shell of the Tortoise" {
            "Once per game session as an action, you may invoke the shell of the Tortoise: the Emperor's remit to operate as you deem necessary. Until the end of the scene, treat your status as 90, and other characters must forfeit honor and glory equal to the difference between your status rank and their status rank to accuse you of wrongdoing related to the acquisition or transport of goods, illicit or otherwise."
        }

        STARTING_OUTFIT [
            "Traveling clothes", "wakizashi (short sword)",
            "any one weapon of rarity 6 or lower",
            "calligraphy set", "knife", "kiseru",
            "abacus or gaijin compass", "traveling pack",
            "pouch of gaijin coins"
        ]

        CURRICULUM {
            RANK 1 {
                SKILL_GROUP "Trade Skills"
                SKILL "Culture"
                SKILL "Courtesy"
                SKILL "Martial Arts [Melee]"
                TECHNIQUE_GROUP "Rank 1 Water Shūji"
                ^"Coiling Serpent Style" [kata]
                ^"Courtier's Resolve" [shuji]
            }
            RANK 2 {
                SKILL_GROUP "Social Skills"
                SKILL "Commerce"
                SKILL "Seafaring"
                SKILL "Skulduggery"
                TECHNIQUE_GROUP "Rank 1-2 Kata"
                ^"Ebb and Flow" [shuji]
                ^"Tributaries of Trade" [shuji]
            }
            RANK 3 {
                SKILL_GROUP "Trade Skills"
                SKILL "Fitness"
                SKILL "Government"
                SKILL "Martial Arts [Ranged]"
                TECHNIQUE_GROUP "Rank 1-3 Air Shūji"
                ^"All Arts Are One" [shuji]
                ^"Breath of Wind Style" [kata]
            }
            RANK 4 {
                SKILL_GROUP "Scholar Skills"
                SKILL "Design"
                SKILL "Martial Arts [Unarmed]"
                SKILL "Skulduggery"
                TECHNIQUE_GROUP "Rank 1-4 Kata"
                ^"Buoyant Arrival" [shuji]
                ^"Regal Bearing" [shuji]
            }
            RANK 5 {
                SKILL_GROUP "Trade Skills"
                SKILL "Aesthetics"
                SKILL "Courtesy"
                SKILL "Sentiment"
                TECHNIQUE_GROUP "Rank 1-5 Water Shūji"
                ^"Bend with the Storm" [shuji]
                ^"The Immovable Hand of Peace" [shuji]
            }
            RANK 6 {
                ^"Shell of the Tortoise"
            }
        }

        RULES {
            #t5d0tA5KcU93nnORW9b5M8: kasuga_smuggler_school_description "Kasuga Smuggler School [Courtier]: The Kasuga have several schools that are the public faces of the Tortoise. Outsiders who are even aware of the Smuggler school believe it to be linked to tawdry merchant affairs, and thus beneath their notice. The Tortoise do their best to foster this misconception, for it actually trains their samurai who oversee the clan's extensive smuggling and covert trading operations.\n\nKasuga smugglers must be proficient in a wide range of activities, from simple deception and disguise to negotiating with gaijin traders and Rokugani criminals. Many travel to gaijin lands and might spend long periods at sea.\n\nAs they rise through the school, their focus can shift from base smuggling and dockside brawls to more refined operations as they interact with wider stratas of Rokugani society of various legitimacies. At the height of their power, they may acquire foreign works of art for Rokugani collectors or command large trading concerns that interact with many other clans. Some even \"retire\" to small merchant concerns, using their years of experience to better monitor gaijin activities and gaijin goods at a lower level. No loyal Kasuga ever forgets the true reason for the Tortoise, after all, and all know the price should they fail."
        }
    }

    # ===========================
    # DARK TIDES NPC PROFILES
    # ===========================

    # --- Boss Yaguro (full stat block) ---

    #WWqQ08Lt5ysMQ2cMX3w8ji ^"Boss Yaguro, Gang Leader" DEF {
        EXTENDS #t4540de6f35155c46f41f0 ^"NPC"
        PROPERTIES {
            ^"Source" STRING "GM Kit: Dark Tides"
            ^"Type" STRING "Adversary"
            ^"Conflict Rank (Combat)" INTEGER 3
            ^"Conflict Rank (Intrigue)" INTEGER 4
            ^"Rings" DEF {
                ^"Air"   INTEGER 2
                ^"Earth" INTEGER 3
                ^"Fire"  INTEGER 3
                ^"Water" INTEGER 3
                ^"Void"  INTEGER 1
            }
            ^"Honor" INTEGER 22
            ^"Glory" INTEGER 12
            ^"Status" INTEGER 9
            ^"Endurance" INTEGER 19
            ^"Composure" INTEGER 12
            ^"Focus" INTEGER 5
            ^"Vigilance" INTEGER 3
            ^"Skills" DEF {
                ^"Artisan" INTEGER 0
                ^"Martial" INTEGER 2
                ^"Scholar" INTEGER 0
                ^"Social"  INTEGER 2
                ^"Trade"   INTEGER 3
            }
            ^"Demeanor" STRING "Ambitious (Fire +2, Earth -2)"
            ^"Advantages" STRING "Knows This Town (Earth) [Scholar; Interpersonal]"
            ^"Disadvantages" STRING "Bad Liar (Water) [Social; Interpersonal]"
            ^"Favored Weapons" STRING "Staff: Range 1-2, Damage 6, Deadliness 2, 2-handed, Mundane"
            ^"Gear" STRING "Thick clothing (Physical 2), stained pipe, pouch containing several koku and bu"
        }
        RULES {
            #L5RGMK03aB2cD4eF6gH8iJ0k: desperate_act "Desperate Act: When Yaguro performs an Attack action check, he may spend (op) in the following ways: (op)+: Suffer 2 strife to increase the damage of the attack by 1 per (op) spent this way. (op)(op): Suffer 2 strife to increase the deadliness of the attack by 2."
        }
    }

    # --- Boss Hana (Experienced Bandit profile modification) ---

    #f6nHJ23PDZw0FL4uyCj9Jo ^"Boss Hana, Gang Leader" DEF {
        EXTENDS #t4540de6f35155c46f41f0 ^"NPC"
        PROPERTIES {
            ^"Source" STRING "GM Kit: Dark Tides"
            ^"Type" STRING "Adversary"
            ^"Conflict Rank (Combat)" INTEGER 3
            ^"Conflict Rank (Intrigue)" INTEGER 2
            ^"Base Profile" STRING "Experienced Bandit (Core Rulebook p. 316)"
        }
        PROPERTIES {
            ^"Demeanor" STRING "Gruff (Air +2, Earth -2)"
            ^"Gear" STRING "Gaijin dagger (Range 0, Damage 3, Deadliness 5, Concealable, Durable), elegant clothing (Physical 1), pipe, a pouch containing a handful of bu"
        }
        RULES {
            #L5RGMK04aB2cD4eF6gH8iJ0k: cruel_cunning "Cruel Cunning: When performing a Social skill check, Hana may spend (op) (op) in the following way: (op) (op): One target gains the Dazed condition."
        }
    }

    # --- Boss Kizo (Experienced Bandit profile modification) ---

    #1eAxRYJzlTw9BHyAhHZKQV ^"Boss Kizo, Gang Leader" DEF {
        EXTENDS #t4540de6f35155c46f41f0 ^"NPC"
        PROPERTIES {
            ^"Source" STRING "GM Kit: Dark Tides"
            ^"Type" STRING "Adversary"
            ^"Conflict Rank (Combat)" INTEGER 3
            ^"Conflict Rank (Intrigue)" INTEGER 2
            ^"Base Profile" STRING "Experienced Bandit (Core Rulebook p. 316)"
        }
        PROPERTIES {
            ^"Demeanor" STRING "Shrewd (Water +2, Fire -2)"
            ^"Gear" STRING "Faded clothing (Physical 1), a pouch containing small candies and toys"
        }
        RULES {
            #L5RGMK05aB2cD4eF6gH8iJ0k: amused_at_failure "Amused at Failure: When an opponent suffers strife in a failed Social skill check targeting him, Kizo recovers the same amount of strife"
        }
    }

    # --- Azif the Smooth (full stat block) ---

    #JA3Wu1D5Ih2g8OQmc5GYo1 ^"Azif the Smooth, Gaijin Smuggler" DEF {
        EXTENDS #t4540de6f35155c46f41f0 ^"NPC"
        PROPERTIES {
            ^"Source" STRING "GM Kit: Dark Tides"
            ^"Type" STRING "Adversary"
            ^"Conflict Rank (Combat)" INTEGER 4
            ^"Conflict Rank (Intrigue)" INTEGER 3
            ^"Rings" DEF {
                ^"Air"   INTEGER 3
                ^"Earth" INTEGER 2
                ^"Fire"  INTEGER 4
                ^"Water" INTEGER 3
                ^"Void"  INTEGER 1
            }
            ^"Honor" INTEGER 11
            ^"Glory" INTEGER 12
            ^"Status" INTEGER 1
            ^"Endurance" INTEGER 12
            ^"Composure" INTEGER 10
            ^"Focus" INTEGER 7
            ^"Vigilance" INTEGER 3
            ^"Skills" DEF {
                ^"Artisan" INTEGER 0
                ^"Martial" INTEGER 3
                ^"Scholar" INTEGER 0
                ^"Social"  INTEGER 2
                ^"Trade"   INTEGER 3
            }
            ^"Demeanor" STRING "Assertive (Earth +2, Void -2)"
            ^"Advantages" STRING "Good Liar (Water) [Social; Interpersonal], Haggling (Void) [Trade; Interpersonal]"
            ^"Disadvantages" STRING "Arrogance (Fire) [Social; Interpersonal], Gaijin Appearance (Fire) [Physical; Interpersonal]"
            ^"Favored Weapons" STRING "Rigging daggers: Range 0, Damage 3, Deadliness 4, Concealable, Durable, Mundane; can be thrown (Range 1-3)"
            ^"Gear" STRING "Gaijin clothing (Physical 2), sake jug (full), pouch stuffed with bu"
        }
        RULES {
            #L5RGMK06aB2cD4eF6gH8iJ0k: get_them "...Get Them!: As an action, Azif may have up to two of his allies within range 2 of him immediately move 1 range band. If they have not already acted this round, they may also perform a Strike action. These allies count as having skilled assistance (see page 26 of the Core Rulebook) on their check."
            #L5RGMK07aB2cD4eF6gH8iJ0k: acrobatic_fighter "Acrobatic Fighter: When performing an Attack action check, Azif may spend (op) in the following ways:\n\n(op): If at range 0 from the target, Azif may move two range bands away from that opponent.\n\n(op)+: Azif may kick any opponent at range 0–1 and then move two range bands away from that opponent. The kick deals 3 damage with a deadliness of 1 plus the (op) spent."
        }
    }

    # --- Kasuga Yumiko (Loyal Bushi profile modification) ---

    #48ZsPuaFNuB8tGiXAy9APs ^"Kasuga Yumiko, Renegade Samurai" DEF {
