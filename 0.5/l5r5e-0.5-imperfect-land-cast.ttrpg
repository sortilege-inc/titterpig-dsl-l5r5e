# L5R 5E — Imperfect Land: Dramatis Personae (cast NPCs / adversaries)
# "Imperfect Land" — an adventure uncovering the secrets of the Perfect Land Sect
# (FFG). This file holds three tiers of NPC, all transcribed VERBATIM from the
# source:
#   1. Four full ADVERSARY statblocks (rings, conflict ranks, derived attributes,
#      honor/glory/status, skill-group ranks, advantages/disadvantages, favored
#      weapons & gear, abilities) — read from the statblock page images.
#   2. Five profile-based leaders — modeled the way the source presents them, by
#      naming a core-rulebook profile + template + adjustments (^"Profile").
#   3. Nine "Undecided" conclave delegates (Part One persuasion targets), each
#      given as the source lists them: an Order, a Vigilance (the persuasion TN),
#      a Demeanor with its unmasking modifiers, and the Check that best sways them.
# Ability text is reproduced verbatim in nested ^"Name" DEF { ^"Effect" ... }.
# This adventure uses the players' own characters — there are no pregens. Purely
# narrative figures (Senzai, Yohori, Satto, Fuchō's fellow scholars, the historical
# Yuzue / Gatai / Togashi Kazue) and generic foes (monks as Trained Ashigaru,
# Desperate Bandits) live in the .lore / .codex.

EXTENSION "L5R5e_ImperfectLand_Cast" {
    VERSION "0.5.2"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-09-03"
    DEPENDS_ON "L5R5e_Core_Core"

    # ═══════════════ FULL STATBLOCKS ═══════════════════════════════════════

    ^"Iwa" DEF {
        EXTENDS #t4540de6f35155c46f41f0 ^"NPC"
        PROPERTIES {
            ^"Type" STRING "Adversary" FIXED
            ^"Combat Conflict Rank" INTEGER 9
            ^"Intrigue Conflict Rank" INTEGER 4
            ^"Rings" DEF { ^"Air" INTEGER 2 ^"Earth" INTEGER 4 ^"Fire" INTEGER 4 ^"Water" INTEGER 2 ^"Void" INTEGER 3 }
            ^"Demeanor" STRING "Fanatical"
            ^"Endurance" INTEGER 12
            ^"Composure" INTEGER 10
            ^"Focus" INTEGER 8
            ^"Vigilance" INTEGER 4
            ^"Honor" INTEGER 54
            ^"Glory" INTEGER 56
            ^"Status" INTEGER 27
            ^"Skills" LIST OF STRING ["Artisan 0", "Martial 5", "Scholar 2", "Social 2", "Trade 2"]
            ^"Advantages" LIST OF STRING ["Paragon of Strength — Martial; Mental, Physical, Spiritual", "Unrelenting — Social; Interpersonal, Mental"]
            ^"Disadvantages" LIST OF STRING ["Inflexible — Scholar; Mental", "Old Wounds — Martial; Physical"]
            ^"Favored Weapons" LIST OF STRING ["Vicious Bisentō: Range 2, Damage 4/6, Deadliness 6, Cumbersome, Durable, Razor-Edged, Wargear"]
            ^"Gear" LIST OF STRING ["Gear (equipped): Sōhei robes (Supernatural 2, Durable)"]
        }
        DESCRIPTION "Note: If the PC party is small, has a low group rank, or is not combat oriented, replace her bisentō with a bō, remove the Trial of Fire ability, or reduce her Earth and Fire rings from 4 to 3."
        REFERENCES {
            "Trial of Fire" -> #te1429a15a1b6afd84f528 ^"Trial of Fire"
        }
        ^"Master Sōhei" DEF { ^"Effect" STRING "Iwa may sustain two kihō enhancement effects at the same time and may perform any polearm-related kata." }
        ^"Conquering the Mountain" DEF { ^"Effect" STRING "Iwa's blows make the world tremble. She starts any duel, skirmish, or mass battle conflict scene with the Way of the Earthquake kihō's enhancement effect activated." }
        #te1429a15a1b6afd84f528 ^"Trial of Fire" DEF { ^"Effect" STRING "The first time Iwa would otherwise become Incapacitated during a scene, she refuses to accept defeat and is able to activate the effects of the kihō The Body Is an Anvil, with its burst effect aimed at whoever has dared to approach her. Then, she removes fatigue until it equals half her endurance." }

        RULES {
            #a76VwRxCzPI7cmbpOpRaBY: background "This militant sōhei, likewise born into the Phoenix Clan, has long since tied her fate to Naigen's. It was through his support that she rose to become the abbot of the southern branch of the Four Temples, and she takes all her political cues from him—to the point that some refer to her as Naigen's attack dog, though never where she can hear. She believes even more strongly than he does that the Perfect Land Sect should be stamped out, because where he is inclined to work through political channels, Iwa stands ready to crush the sect with force."
        }
    }

    ^"Ichirō (Imperfect Land)" DEF {
        EXTENDS #t4540de6f35155c46f41f0 ^"NPC"
        PROPERTIES {
            ^"Type" STRING "Adversary" FIXED
            ^"Combat Conflict Rank" INTEGER 7
            ^"Intrigue Conflict Rank" INTEGER 4
            ^"Rings" DEF { ^"Air" INTEGER 2 ^"Earth" INTEGER 3 ^"Fire" INTEGER 4 ^"Water" INTEGER 4 ^"Void" INTEGER 2 }
            ^"Demeanor" STRING "Idealistic"
            ^"Endurance" INTEGER 14
            ^"Composure" INTEGER 12
            ^"Focus" INTEGER 7
            ^"Vigilance" INTEGER 3
            ^"Honor" INTEGER 25
            ^"Glory" INTEGER 28
            ^"Status" INTEGER 22
            ^"Skills" LIST OF STRING ["Artisan 1", "Martial 4", "Scholar 1", "Social 4", "Trade 2"]
            ^"Advantages" LIST OF STRING ["Burning Conviction — Social; Interpersonal, Mental", "Pragmatist — Martial; Mental, Physical"]
            ^"Disadvantages" LIST OF STRING ["Bitter — Social; Interpersonal, Mental"]
            ^"Favored Weapons" LIST OF STRING ["Pure Earth Dao: Range 1, Damage 3, Deadliness 6, Ceremonial, Durable, Razor-Edged", "Pure Heavens Gao: Range 1, Damage 5, Deadliness 3, Ceremonial, Durable, Snaring", "Wakizashi: Range 0–1, Damage 3, Deadliness 5/7, Ceremonial, Razor-Edged"]
            ^"Gear" LIST OF STRING ["Gear (equipped): Austere robes (Physical 2, Ceremonial, Durable)"]
        }
        DESCRIPTION "ADVERSARY. Conflict Rank — Combat 7, Intrigue 4. Adopted son of Mirumoto Masashige; now a Perfect Land adherent."
        REFERENCES {
            "Mirumoto Masashige" -> #te90b9e3d93bb1dc0748b0 ^"Mirumoto Masashige"
        }
        ^"Twin Dragons Striking" DEF { ^"Effect" STRING "Ichirō may perform any Iaijutsu kata. Once per scene when dual wielding, he may reduce the cost of activating a kata to (op)." }
        ^"Empathic Objection" DEF { ^"Effect" STRING "Once per scene, when the Pure Land Sect or his faith are being challenged, Ichirō may vocally object and reduce his strife by a number equal to his focus. Any character who voices support of his objection also receives this benefit. In an intrigue, this ability cancels 1 momentum point gained from attacking or discrediting the sect." }

        RULES {
            #TbfpmlbJeIDbQlf9Rv3TZm: background "This passionate young man grew up believing he was the biological son of Mirumoto Masashige and believing firmly in the karmic right of samurai to rule over heimin. Once Ichirō reached his gempuku, Masashige confessed the truth—that Ichirō was adopted from a peasant family—and Ichirō's world shattered.\n\nWith everything he believed in revealed as a lie, Ichirō renounced the name he had taken and the family that had adopted him, turning to the Perfect Land for meaning. He has convinced himself that his father is a manipulative hypocrite, but the love between them is not so easily erased. If Masashige either gives his support to the sect or, conversely, persuades Ichirō that the \"spiritual merit\" that justified his adoption is real, that rift might yet be bridged."
        }
    }

    ^"Yuki (Shosuro Miyako)" DEF {
        EXTENDS #t4540de6f35155c46f41f0 ^"NPC"
        PROPERTIES {
            ^"Type" STRING "Adversary" FIXED
            ^"Combat Conflict Rank" INTEGER 4
            ^"Intrigue Conflict Rank" INTEGER 6
            ^"Rings" DEF { ^"Air" INTEGER 3 ^"Earth" INTEGER 3 ^"Fire" INTEGER 2 ^"Water" INTEGER 2 ^"Void" INTEGER 2 }
            ^"Demeanor" STRING "Cautious"
            ^"Endurance" INTEGER 8
            ^"Composure" INTEGER 14
            ^"Focus" INTEGER 7
            ^"Vigilance" INTEGER 3
            ^"Honor" INTEGER 45
            ^"Glory" STRING "44 (as Yuki) / 25 (revealed)"
            ^"Status" STRING "15 (as Yuki) / 37 (revealed)"
            ^"Skills" LIST OF STRING ["Artisan 1", "Martial 2", "Scholar 1", "Social 3", "Trade 4"]
            ^"Advantages" LIST OF STRING ["Low Profile — Social; Interpersonal", "Attentive to Detail — Scholar; Mental"]
            ^"Disadvantages" LIST OF STRING ["Risk Averse — Martial; Interpersonal, Mental"]
            ^"Favored Weapons" LIST OF STRING ["Shuriken: Range 0/1–3, Damage 2, Deadliness 4, Concealable"]
            ^"Gear" LIST OF STRING ["Gear (equipped): Inconspicuous clothes (Physical 1, Mundane, Subtle)", "Gear (unequipped): Shinobi outfit (Physical 2, Concealable, Subtle)"]
        }
        DESCRIPTION "ADVERSARY. Conflict Rank — Combat 4, Intrigue 6. A Scorpion shinobi (Shosuro Miyako) undercover as the peasant 'Yuki'."
        ^"Master Infiltrator" DEF { ^"Effect" STRING "Miyako is a crafty operative with a wide arsenal of tricks. She may perform any ninjutsu techniques and any Air shūji. When doing so, she may suffer 1 fatigue and 1 strife to count her target's vigilance as 1 lower." }
        ^"Snowpetal of No Importance" DEF { ^"Effect" STRING "When Miyako is disguised, any character who does not know her true identity and has no reason to pay attention to her treats their own vigilance as 1 lower." }
        ^"Clean Escape" DEF { ^"Effect" STRING "Once per scene, Miyako can use servants' tools to create improvised Obscuring terrain that extends around her up to range 1 and lasts one round." }

        RULES {
            #Abu9MSomz5a3eqZs9avvoT: background "Seemingly one of the many peasants who have flocked to Hige and the Perfect Land, Yuki is in truth Shosuro Miyako, a Scorpion shinobi sent by Yogo Hiroue to investigate the sect, with a particular eye toward its relationship with the Dragon Clan. In her time among them, however, she's developed fond feelings toward the grandfatherly Hige. Although she's aware of Ichirō's and Kanbei's secrets, she is reluctant to act without orders from her superior—the exception being if Hige's life is threatened. Miyako's first glory and status values reflect when she is acting as Yuki; the second values reflect when her identity is revealed."
        }
    }

    ^"Ajari" DEF {
        EXTENDS #t4540de6f35155c46f41f0 ^"NPC"
        PROPERTIES {
            ^"Type" STRING "Adversary" FIXED
            ^"Combat Conflict Rank" INTEGER 7
            ^"Intrigue Conflict Rank" INTEGER 7
            ^"Rings" DEF { ^"Air" INTEGER 4 ^"Earth" INTEGER 2 ^"Fire" INTEGER 2 ^"Water" INTEGER 4 ^"Void" INTEGER 4 }
            ^"Demeanor" STRING "Otherworldly"
            ^"Endurance" INTEGER 11
            ^"Composure" INTEGER 13
            ^"Focus" INTEGER 9
            ^"Vigilance" INTEGER 4
            ^"Honor" INTEGER 26
            ^"Glory" INTEGER 35
            ^"Status" INTEGER 28
            ^"Skills" LIST OF STRING ["Artisan 3", "Martial 4", "Scholar 3", "Social 4", "Trade 2"]
            ^"Advantages" LIST OF STRING ["Elusive — Martial; Interpersonal, Physical", "Good-Hearted — Social; Interpersonal, Mental"]
            ^"Disadvantages" LIST OF STRING ["Indirect — Martial; Interpersonal, Mental, Physical", "Hollow-Boned — Martial; Physical"]
            ^"Favored Weapons" LIST OF STRING ["Bō: Range 1–2, Damage 6, Deadliness 2, Mundane"]
            ^"Gear" LIST OF STRING ["Gear (equipped): Traveling clothes (Physical 2, Durable, Mundane, Subtle)"]
        }
        DESCRIPTION "ADVERSARY. Conflict Rank — Combat 7, Intrigue 7. A tengu of the wilderness around the Mountain Song Temple; secret protector of Senzai."
        REFERENCES {
            "Mountain Song Temple" -> #te4013301f2fe7da3be2ff ^"Mountain Song Temple"
        }
        ^"Trickster Tengu" DEF { ^"Effect" STRING "Ajari is especially aligned with Air. He can perform any Air shūji, Air kihō, Air ninjutsu, or Air invocation. However, he may not repeat techniques obtained this way within the same scene, as his tricks grow thin." }
        ^"Crafty Visage" DEF { ^"Effect" STRING "Ajari's Mask of Wind invocation is especially refined, allowing him to impersonate a specific individual." }
        ^"Master of the Staff" DEF { ^"Effect" STRING "Ajari can use a staff to perform any polearm or blunt weapon kata." }
        ^"Carried by the Wind" DEF { ^"Effect" STRING "During his turn, Ajari may choose to replace his current enhancement effect with the Riding the Clouds or Way of the Willow kihō. He can also move vertically and ignore the negative effects of terrain." }

        RULES {
            #FfU7jmf4gO0NFAbf4LT1nM: background "This solitary tengu has haunted the wilderness surrounding the Mountain Song Temple for many years, listening to the music of the winds and contemplating the mysteries of reality. From time to time, he visits the temple itself, disguising himself as a human monk or scholar and conversing with people there before returning to his solitary life. These long years of ascetic contemplation give him a spiritual attunement that recognizes Senzai as Shinsei, but he does not believe it is his place to reveal that secret. Instead, he acts only to protect her so that events may take their own course.\n\nAjari has an unusually powerful command of illusion magic for a tengu, allowing him to take on the appearance of a specific individual rather than only a generic human form. He is a capable fighter as well, though he prefers not to kill if it can be avoided. His spiritual gifts also give him a resilience that makes healing easier if he is wounded."
        }
    }

    # ═══════════════ PROFILE-BASED LEADERS ═════════════════════════════════

    ^"Hige" DEF {
        EXTENDS #t4540de6f35155c46f41f0 ^"NPC"
        PROPERTIES {
            ^"Type" STRING "Adversary" FIXED
            ^"Profile" STRING "Hige can be represented using the Seasoned Courtier profile (see page 313 of the core rulebook) with the Spiritualist template (page 311 of the core rulebook), adjusting his skills to Artisan 0, Trade 3."
            ^"Demeanor" STRING "Generous and humble"
        }
        DESCRIPTION "There may be few truly good-hearted people in the world, but the old man who leads the Perfect Land Sect (insofar as such a far-flung and decentralized group can be led) is one of them. Generous and humble, Hige used to be a monk of the Brotherhood, serving in a small shrine dedicated to the Fortune of Compassion and Forgiveness. Now, despite his leadership position, he refuses the fine robes and ostentation of many established orders and instead regularly labors alongside his followers to keep their community fed and clothed.\n\nBehind that kindly exterior, however, lies a firm will. Hige believes with every shred of his soul in Shinsei's benevolence, especially after his dream five years ago (actually a distorted echo of Togashi Kazue's interaction with Senzai). He will not back down from his belief, and under subtle pressure from Kanbei, it has steadily become a more strident opposition to samurai rule and Fortunist worship. Nothing short of meeting the Little Teacher herself will change his faith."
    }

    ^"Kanbei" DEF {
        EXTENDS #t4540de6f35155c46f41f0 ^"NPC"
        PROPERTIES {
            ^"Type" STRING "Adversary" FIXED
            ^"Profile" STRING "Kanbei can be represented using the Seasoned Courtier profile (see page 313 of the core rulebook) with the Trickster template (page 311 of the core rulebook)."
            ^"Demeanor" STRING "Ruthless"
        }
        DESCRIPTION "The wealthy merchant Kanbei almost wishes the Kolat could take credit for the creation of Perfect Land theology, as he finds it so conducive to his goals. He is the master of the Mountain Sect, a Kolat organization dedicated to controlling the Perfect Land movement and directing it toward the overthrow of the current samurai order.\n\nIn pursuit of this goal, he has been steadily encouraging Hige to condemn the samurai outright, and also to forbid the worship of the Fortunes by his followers (on the grounds that they should need only Shinsei's mercy). He is utterly ruthless and does not hesitate to shed blood if someone threatens his efforts."
    }

    ^"Anmoku" DEF {
        EXTENDS #t4540de6f35155c46f41f0 ^"NPC"
        PROPERTIES {
            ^"Type" STRING "Adversary" FIXED
            ^"Profile" STRING "Anmoku can be represented using the Scholarly Shugenja profile (see page 314 of the core rulebook), replacing the invocations with kihō and adding the Sage template (see page 311 of the core rulebook)."
            ^"Demeanor" STRING "Open-minded"
        }
        DESCRIPTION "Through her devotion to the Fortune of Wisdom and Mercy, Anmoku has come to have an enlightened view of wisdom: however much humans know, there is always more that lies beyond their ken. She and the Stone Sages order she leads embody the Dragon philosophy of mental openness, and she fears that the Brotherhood of Shinsei and Rokugani society as a whole have become too entrenched in the comforts of what they know. Because of this, she supports the Perfect Land Sect and wants to see it admitted to the Brotherhood as an order—though she is understandably troubled by Hige's growing tendency to demand that his followers abandon the worship of the Fortunes. Anmoku hopes he can be persuaded to agree that there is benefit in showing proper respect to the powers of the world, even if escape from the wheel of rebirth comes through Shinsei."
    }

    ^"Naigen" DEF {
        EXTENDS #t4540de6f35155c46f41f0 ^"NPC"
        PROPERTIES {
            ^"Type" STRING "Adversary" FIXED
            ^"Profile" STRING "Naigen can be represented using the Scholarly Shugenja profile (see page 314 of the core rulebook), replacing the invocations with kihō and adding the Socialite template (see page 311 of the core rulebook)."
            ^"Demeanor" STRING "Rigid"
        }
        DESCRIPTION "The Phoenix-born abbot of the eastern branch of the Four Temples is not an evil man. He is, however, entrenched in a theology that happens to support the status quo and his comfortable position within it. Therefore, he rejects out of hand anything that threatens to upset the balance of Rokugan, while justifying that rejection to himself as being grounded in unassailable wisdom.\n\nTo him, the Perfect Land is the greatest threat of his generation. Because he condemns it as a heresy, every critique its members make of Rokugani society is a priori invalid, and any faction that tolerates them—such as the Dragon Clan—is tainted by their heresy. Tragically for Naigen, this rigid worldview means he cannot recognize the Little Teacher, even when she stands before him."
    }

    #te90b9e3d93bb1dc0748b0 ^"Mirumoto Masashige" DEF {
        EXTENDS #t4540de6f35155c46f41f0 ^"NPC"
        PROPERTIES {
            ^"Type" STRING "Adversary" FIXED
            ^"Profile" STRING "Masashige can be represented using the Venerable Provincial Daimyō profile (see page 315 of the core rulebook), with two kata of the GM's choosing."
            ^"Demeanor" STRING "Careworn"
        }
        DESCRIPTION "Many cares weigh down the shoulders of the Mirumoto family daimyō. His Clan Champion having left the fastness of the High House of Light, leadership of the Dragon falls to Masashige at a time when the Empire is in the greatest state of upheaval it has seen since the Day of Thunder. And thanks to the behind-the-scenes machinations of the Perfect Land Sect, he finds himself with the responsibility of hosting the Brotherhood's conclave.\n\nMasashige's feelings toward the sect are complicated. He has long been worried about its destabilizing potential, but because his Clan Champion's policy has been one of toleration, Masashige has taken no direct action against the Perfect Land. When his son—for he truly considers Ichirō to be his son—abandoned him to join its ranks, Masashige's heart was thrown into even more turmoil. Although his official position is one of neutrality toward the sect, the Empire's ongoing troubles mean he's open to being persuaded that the Perfect Land is correct about the Age of Declining Virtue and reconciling with his son.\n\nIf he were to be persuaded, his support would carry weight with the conclave, even though he is not a member of the Brotherhood of Shinsei."
        REFERENCES {
            "Mountain Song Temple" -> #te4013301f2fe7da3be2ff ^"Mountain Song Temple"
        }
    }

    # ═══════════════ PART ONE — "THE UNDECIDED" CONCLAVE DELEGATES ═════════

    ^"Kaimoku" DEF {
        EXTENDS #t4540de6f35155c46f41f0 ^"NPC"
        PROPERTIES {
            ^"Type" STRING "Persuasion Target" FIXED
            ^"Order" STRING "Four Temples, northern branch"
            ^"Vigilance" INTEGER 5
            ^"Demeanor" STRING "Meticulous (+1 Fire, +1 Water, –1 Air, –1 Earth)"
            ^"Persuasion Check" STRING "TN 3 Government"
        }
        DESCRIPTION "As the northern temple is dedicated to understanding the world, Kaimoku seeks to understand how the Perfect Land fits into Rokugani society. They are interested in hearing tales of peasant resistance and rebellion, whether justified or otherwise. Because of their influential position, swaying Kaimoku has double the usual effect on Sympathy."
    }

    ^"Kūen" DEF {
        EXTENDS #t4540de6f35155c46f41f0 ^"NPC"
        PROPERTIES {
            ^"Type" STRING "Persuasion Target" FIXED
            ^"Order" STRING "Order of Eternity"
            ^"Vigilance" INTEGER 4
            ^"Demeanor" STRING "Watchful (+2 Fire, –1 Earth, –1 Void)"
            ^"Persuasion Check" STRING "TN 2 Meditation (Earth 1, Void 1, Fire 4)"
        }
        DESCRIPTION "A woman of few words, Kūen embodies her order's philosophy of seeking the right moment to act. She will listen to those who show their patience by first meditating with her."
    }

    ^"Rekigan" DEF {
        EXTENDS #t4540de6f35155c46f41f0 ^"NPC"
        PROPERTIES {
            ^"Type" STRING "Persuasion Target" FIXED
            ^"Order" STRING "Order of Osano-wo"
            ^"Vigilance" INTEGER 4
            ^"Demeanor" STRING "Direct (+2 Air, –1 Fire, –1 Water)"
            ^"Persuasion Check" STRING "Sparring bout duel"
            ^"Profile" STRING "use the Skillful Rōnin profile with the Spiritualist template for Rekigan; see pages 316 and 311 of the core rulebook"
        }
        DESCRIPTION "This scarred and heavily muscled sōhei respects those who show their strength. He is more willing to heed those who first acquit themselves well in a bout of sparring (use the Skillful Rōnin profile with the Spiritualist template for Rekigan; see pages 316 and 311 of the core rulebook)."
    }

    ^"Fuchō" DEF {
        EXTENDS #t4540de6f35155c46f41f0 ^"NPC"
        PROPERTIES {
            ^"Type" STRING "Persuasion Target" FIXED
            ^"Order" STRING "Temple of Celestial Knowledge"
            ^"Vigilance" INTEGER 4
            ^"Demeanor" STRING "Fervent (+1 Air, +1 Water, –1 Fire, –1 Void)"
            ^"Persuasion Check" STRING "TN 3 Theology"
        }
        DESCRIPTION "This scholarly woman wants to bring everyone to Shinsei's way. Fuchō appreciates theological arguments about the dangers of heresy or the possibility that Perfect Land practices will redirect peasant attention from the Fortunes to the Tao."
    }

    ^"Shōka" DEF {
        EXTENDS #t4540de6f35155c46f41f0 ^"NPC"
        PROPERTIES {
            ^"Type" STRING "Persuasion Target" FIXED
            ^"Order" STRING "Heaven's Fist"
            ^"Vigilance" INTEGER 3
            ^"Demeanor" STRING "Sociable (+1 Air, +1 Earth, –1 Fire, –1 Water)"
            ^"Persuasion Check" STRING "TN 3 Fitness (Water or Earth 2)"
        }
        DESCRIPTION "Not all monks are contemplative and ascetic. Shōka still likes to drink, and this elder sōhei will happily discuss the Perfect Land with someone who can hold their sake."
    }

    ^"Tanbu" DEF {
        EXTENDS #t4540de6f35155c46f41f0 ^"NPC"
        PROPERTIES {
            ^"Type" STRING "Persuasion Target" FIXED
            ^"Order" STRING "Pure Song Shrine"
            ^"Vigilance" INTEGER 4
            ^"Demeanor" STRING "Refined (+1 Earth, +1 Water, –1 Air, –1 Fire)"
            ^"Persuasion Check" STRING "TN 3 Performance"
        }
        DESCRIPTION "Clearly a former courtier, Tanbu finds his attention drawn to an argument's elegance as much as to its content. He can be persuaded by those with a flair for the dramatic."
    }

    ^"Yoshi" DEF {
        EXTENDS #t4540de6f35155c46f41f0 ^"NPC"
        PROPERTIES {
            ^"Type" STRING "Persuasion Target" FIXED
            ^"Order" STRING "Four Temples, western branch"
            ^"Vigilance" INTEGER 5
            ^"Demeanor" STRING "Meticulous (+1 Fire, +1 Water, –2 Earth)"
            ^"Persuasion Check" STRING "Scholar approach to a relevant skill, TN 3"
        }
        DESCRIPTION "Yoshi knows two of his fellow abbots are firmly set against the Perfect Land, but he has not yet made up his mind. Historical arguments are the most persuasive to him, especially ones citing previous examples of False Paths or unusual sects admitted to the Brotherhood. Because of his influential position, swaying Yoshi has double the usual effect on Sympathy."
    }

    ^"Yuro" DEF {
        EXTENDS #t4540de6f35155c46f41f0 ^"NPC"
        PROPERTIES {
            ^"Type" STRING "Persuasion Target" FIXED
            ^"Order" STRING "Order of Longevity"
            ^"Vigilance" INTEGER 4
            ^"Demeanor" STRING "Compassionate (+2 Water, –2 Void)"
            ^"Persuasion Check" STRING "TN 3 Medicine"
        }
        DESCRIPTION "Followers of Jurōjin, the Fortune of Longevity, have seen much suffering in their mission to heal the injured and sick. Yuro's heart is moved by stories of individual suffering, whether peasants hurt by samurai injustice or innocents hurt by Perfect Land fanatics."
    }

    ^"Zenjō" DEF {
        EXTENDS #t4540de6f35155c46f41f0 ^"NPC"
        PROPERTIES {
            ^"Type" STRING "Persuasion Target" FIXED
            ^"Order" STRING "Silent Ones"
            ^"Vigilance" INTEGER 4
            ^"Demeanor" STRING "Patient (+1 Fire, +1 Water, –1 Air, –1 Void)"
            ^"Persuasion Check" STRING "TN 3 Composition (Air 2, Fire 4)"
        }
        DESCRIPTION "Like others of her order, Zenjō has taken an unbreakable vow of silence, expressing herself instead through writing. While her hearing is fine, she admires fine calligraphy and gives more credence to arguments expressed through that medium."
    }
}
