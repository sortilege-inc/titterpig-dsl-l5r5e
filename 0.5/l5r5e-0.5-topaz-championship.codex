# .codex SECTION — The Topaz Championship (adventure). Stand-off graph over
# l5r5e-0.5-topaz-championship.lore (spec §25). Part of the L5R5e system graph;
# DEPENDS_ON the shared schema.
#
# The cast (Bayushi Sugai and the Ruffian in l5r5e-0.5-topaz-championship-cast.ttrpg)
# and the shared Beginner Game pregens are DEFs — referenced via ^"...", never
# minted. Tsuma, Bayushi Sugai (both minted in the Emerald Champion fold), and Doji
# Satsume are already in the graph — referenced, and Tsuma / Bayushi Sugai / Doji
# Satsume amended (this being where Satsume's ghost first appears). This section
# mints the Topaz Championship itself and its lore-only figures (the Crane sensei
# Kakita Toshimoko and his secret son Hitoshi, the framed duelist Kakita Riku, the
# Dragon investigator Kitsuki Yuikimi, the finalist Bayushi Mei Lin, and the cart-
# driver Ryu).

CODEX "L5R5e_TopazChampionship_Codex" {
    NAME "The Topaz Championship — Lore Graph"
    VERSION "0.5.2"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-09-03"
    FOR EDITION "l5r5e"
    DEPENDS_ON "L5R5e_Codex_Schema" VERSION "0.5.9"

    # ---- The tournament ---------------------------------------------------
    ENTITY #L5RcxTC01topazchampionship ^"Topaz Championship" {
        IS ^"Event"
        SOURCE "l5r5e-0.5-topaz-championship.lore" AT "the-adventure-book"
        RELATIONSHIPS {
            ^"occurred-at" -> ^"Tsuma"          FROM "Arriving in Tsuma so besoiled, on the eve of the Topaz Championship, damages their reputation: the PCs must each lose 1 glory to do this."
            ^"involved"    -> ^"Crane Clan"     FROM "His scheme to dishonor the Crane, the Topaz Championship, and Kitsuki Yuikimi seemingly foiled, Sugai now flees in hope of escaping the city."
            ^"involved"    -> ^"Scorpion Clan"  FROM "She is determined to secure the Topaz Championship for the Scorpion Clan, at any cost." }
    }

    # ---- Lore-only figures -------------------------------------------------
    ENTITY #L5RcxTC02kakitatoshimoko ^"Kakita Toshimoko" {
        IS ^"Person"
        SOURCE "l5r5e-0.5-topaz-championship.lore" AT "as-they-leave"
        RELATIONSHIPS { ^"member-of" -> ^"Kakita" FROM "It appears to be addressed to the writer’s brother-in-law, Kakita Toshimoko." }
    }
    ENTITY #L5RcxTC03kakitariku ^"Kakita Riku" {
        IS ^"Person"
        SOURCE "l5r5e-0.5-topaz-championship.lore" AT "this-house-is-not-for-you-this-house-is-for-the-great-clans"
        RELATIONSHIPS {
            ^"member-of" -> ^"Kakita"        FROM "Kakita Riku—female Crane bushi."
            ^"enemy-of"  -> ^"Bayushi Sugai" FROM "If Bayushi Sugai is defeated, the PCs can return to the dueling arena and explain things, saving Kakita Riku from being forced to commit seppuku for her action." }
    }
    ENTITY #L5RcxTC04kitsukiyuikimi ^"Kitsuki Yuikimi" {
        IS ^"Person"
        SOURCE "l5r5e-0.5-topaz-championship.lore" AT "what-do-you-know-about-the-other-competitors"
        RELATIONSHIPS { ^"member-of" -> ^"Kitsuki" FROM "Ryu was overtaken on the road by a few of the other samurai traveling to Tsuma, including the current Topaz Champion, Kitsuki Yuikimi of the Dragon Clan, who impressed him with her kindness, keen intellect, and effortless grace." }
    }
    ENTITY #L5RcxTC05hitoshi ^"Hitoshi" {
        IS ^"Person"
        SOURCE "l5r5e-0.5-topaz-championship.lore" AT "you-will-also-need"
        RELATIONSHIPS {
            ^"member-of" -> ^"Mantis Clan"        FROM "Hitoshi—male Mantis bushi."
            ^"child-of"  -> ^"Kakita Toshimoko"   FROM "Hitoshi is a bastard son of the famed Crane duelist and master sensei of the academy, Kakita Toshimoko." }
    }
    ENTITY #L5RcxTC06bayushimeilin ^"Bayushi Mei Lin" {
        IS ^"Person"
        SOURCE "l5r5e-0.5-topaz-championship.lore" AT "this-house-is-not-for-you-this-house-is-for-the-great-clans"
        RELATIONSHIPS { ^"member-of" -> ^"Bayushi" FROM "Bayushi Mei Lin—female Scorpion bushi." }
    }
    ENTITY #L5RcxTC07ryucartdriver ^"Ryu" {
        IS ^"Person"
        SOURCE "l5r5e-0.5-topaz-championship.lore" AT "scene-1-the-cart-and-the-peasant"
    }

    # ---- Amendments to existing graph nodes --------------------------------
    ENTITY #g2ay14NgyaoIAstojROyS0 ^"Bayushi Sugai" {
        SOURCE "l5r5e-0.5-topaz-championship.lore" AT "the-ghost-departs"
        RELATIONSHIPS { ^"member-of" -> ^"Bayushi" FROM "Bayushi Sugai was the runner-up in last year’s Topaz Championship and the Scorpion is still extraordinarily bitter about his failure." }
    }
    ENTITY #oZyVhhH24wnR0fYXFgE9Fv ^"Doji Satsume" {
        SOURCE "l5r5e-0.5-topaz-championship.lore" AT "who-are-you"
    }
    ENTITY #lKLjag8DrsB5csj718NJXi ^"Tsuma" {
        SOURCE "l5r5e-0.5-topaz-championship.lore" AT "map"
    }
}
