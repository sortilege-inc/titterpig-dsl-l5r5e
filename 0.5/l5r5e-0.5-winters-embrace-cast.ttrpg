    #0QEZBFPqxUdSWa4K4SVWCE ^"Susano-o no Izen" DEF {
        EXTENDS #t4540de6f35155c46f41f0 ^"NPC"
        PROPERTIES {
            ^"Type" STRING "Adversary" FIXED
            ^"Combat Conflict Rank" INTEGER 6
            ^"Intrigue Conflict Rank" INTEGER 4
            ^"Rings" DEF { ^"Air" INTEGER 2 ^"Earth" INTEGER 3 ^"Fire" INTEGER 2 ^"Water" INTEGER 4 ^"Void" INTEGER 2 }
            ^"Demeanor" STRING "Personable"
            ^"Endurance" INTEGER 12
            ^"Composure" INTEGER 14
            ^"Focus" INTEGER 5
            ^"Vigilance" INTEGER 3
            ^"Honor" INTEGER 35
            ^"Glory" INTEGER 45
            ^"Status" INTEGER 25
            ^"Skills" LIST OF STRING ["Artisan 0", "Martial 3", "Scholar 1", "Social 2", "Trade 3"]
            ^"Advantages" LIST OF STRING ["Love of the Sea — Social, Trade; Mental", "Gregarious — Social; Interpersonal"]
            ^"Disadvantages" LIST OF STRING ["Disdain for Authority — Social; Interpersonal", "Inferiority Complex — Social; Mental"]
            ^"Favored Weapons" LIST OF STRING ["Tonfa: Range 0–1, Damage 3, Deadliness 3, Concealable, Durable", "Bō: Range 1–2, Damage 6, Deadliness 2, Mundane", "Wakizashi: Range 0–1, Damage 3, Deadliness 5/7, Ceremonial, Razor-Edged"]
            ^"Gear" LIST OF STRING ["Gear (equipped): Ashigaru armor (Physical 3, Wargear)"]
        }
        DESCRIPTION "ADVERSARY. Conflict Rank — Combat 6, Intrigue 4. Storm Fleet captain and Magami's advocate."
        #UVzzuf0y3H7rmPtdf9SeNN ^"Striking as Water" DEF {
            EXTENDS #AKclPTcck4JeiWjmkYgZuF ^"Striking as Water"
            ^"Effect" STRING "Activation: When Izen make a Martial Arts [Melee, Ranged, or Unarmed] (Water) check, he may spend (op) in the following way:\n\nWater (op)+: Izen's target treats their physical resistance as 1 lower per (op) spent this way. This effect persists until the end of his next turn."
        }
        #CVyxpmvLoRhO3gm7xpXjbS ^"Spinning Blades Style" DEF {
            EXTENDS #gRerY2G6BTUOWgV93Cb9pv ^"Spinning Blades Style"
            ^"Effect" STRING "Activation: When Izen makes a Martial Arts [Melee] or Martial Arts [Unarmed] check, if he has a second readied weapon he did not use for the attack, he may spend (op) in the following way:\n\n(op)+: Izen must spend (op) equal to his target's Vigilance to activate this technique. He uses his second readied weapon against one target of his action, inflicting physical damage equal to its base damage. If that target is Dazed, increase this damage by his ranks in the skill he used for the check."
        }

        RULES {
            #UTilf4yjwXZn18WVId4Luz: background "Izen is the captain of the Storm Fleet ship the Susano-o. He was selected as part of the delegation to Kyūden Doji due to his fierce protectiveness of Lady Magami, a woman he admires greatly for her subtle and soft-spoken strength. If yōjimbō were used by the Mantis Clan, he would come close to being that for Magami. In lieu of such official titles, he is her good friend and her advocate while ashore. Izen is also highly trusted by Lord Yoritomo, which gives him leeway to conduct politics in the name of the Mantis Clan. If he perceives any Mantis sympathies among the PCs, he will seek their aid in supporting Lady Magami before, during, and after her debut.\n\nOf all the Mantis Clan sailors in attendance at Kyūden Doji, Izen is one of the most handsome and personable. His thick black hair and full beard give him a rugged look in contrast to the refinement of the court, and his bushy eyebrows and wide smile convey his zeal for life. His voice is almost too loud for his sturdily built but average-height frame. He encourages everyone he interacts with to express themselves authentically as well. He is an idealist and has a \"never-give-up\" attitude, which is rare among the usual Winter Court attendees."
        }
    }

    # ═══════════════════ SECONDARY NPCS (core profile + template) ═════════

    #9uWRT00R8UrX11XsyngoLA ^"Asahina Takako" DEF {
        EXTENDS #t4540de6f35155c46f41f0 ^"NPC"
        PROPERTIES {
            ^"Type" STRING "Adversary" FIXED
            ^"Profile" STRING "If needed, use the Scholarly Shugenja profile on page 314 of the core rulebook."
            ^"Role" STRING "Crane; priest overseeing the poetry competition ceremonies"
        }
        DESCRIPTION "As the daughter of the Asahina daimyō and an accomplished artificer in her own right, Takako is an important member of the hosting Crane Clan. Moreover, she serves as one of the chief priests overseeing religious ceremonies during the Winter Court, including the rites that take place before the poetry competition on the fifth day. Takako is gentle soul and a paragon of pacifism. She strives to represent the harmony of the kami and the elements in her works and words. She holds out hope that the conflict between the Crane and Lion can be resolved without further bloodshed, and she makes sure to treat all of the other guests with the utmost courtesy and respect—even those who are enemies of her clan."
        REFERENCES {
            "Scholarly Shugenja" -> #L5RNA7RGsi59fHjCajpYUs ^"Scholarly Shugenja"
        }

        RULES {
            #UHSmMmKQnULYnUJc9ZEO7m: background "As the daughter of the Asahina daimyō and an accomplished artificer in her own right, Takako is an important member of the hosting Crane Clan. Moreover, she serves as one of the chief priests overseeing religious ceremonies during the Winter Court, including the rites that take place before the poetry competition on the fifth day. Takako is gentle soul and a paragon of pacifism. She strives to represent the harmony of the kami and the elements in her works and words. She holds out hope that the conflict between the Crane and Lion can be resolved without further bloodshed, and she makes sure to treat all of the other guests with the utmost courtesy and respect—even those who are enemies of her clan."
        }
    }
    #MwIHCAnkwj67O51GHcL9ru ^"Doji Chiyoe" DEF {
        EXTENDS #t4540de6f35155c46f41f0 ^"NPC"
        PROPERTIES {
            ^"Type" STRING "Adversary" FIXED
            ^"Profile" STRING "If needed, use the Seasoned Courtier profile on page 313 of the core rulebook with the Spiritualist template, except her status is 55 and her glory is 49."
            ^"Role" STRING "Crane; candidate for betrothal to the crown prince"
        }
        DESCRIPTION "The beautiful, gentle Doji Chiyoe is highly versed in traditional literature, culture, and governance, as would befit a potential Empress. As a highly placed member of the Doji family—and close in age to the crown prince—she has been groomed since birth for this role, and she accepts it as her duty to her clan. As a result, she has lived a highly sheltered life and has not felt any of the hardships that have come in the wake of the tsunami. She is naïve and unconsciously insensitive to the plight of peasants—they are as foreign to her as most Imperials would be to a farmer. Nevertheless, she is concerned for their spiritual state.\n\nChiyoe is devoutly religious, and she would be glad to join the Brotherhood of Shinsei as a nun if she does not marry well. Unbeknownst to her family, Chiyoe has been exposed to some of the philosophies of the Perfect Land Sect, under the guise of extreme compassion, through her travels to local monasteries. Chiyoe believes that all mortals deserve courtesy and mercy, from the lowliest ant to the noblest Emperor, and that one day, Shinsei will return to save the faithful. As such, Chiyoe is especially interested in seeking out monks and other theologians to discuss cosmology, Enlightenment, and the salvation of the meek through faith in the Little Teacher."
        REFERENCES {
            "Seasoned Courtier" -> #L5RNBu3W8aU055B7iraBQO ^"Seasoned Courtier"
        }
    }
    #Xp0SZHXg3vuXcHndJCs3wM ^"Doji Shigeru" DEF {
        EXTENDS #t4540de6f35155c46f41f0 ^"NPC"
        PROPERTIES {
            ^"Type" STRING "Adversary" FIXED
            ^"Profile" STRING "If needed, use the Seasoned Courtier profile on page 313 of the core rulebook with the Artist template."
            ^"Role" STRING "Crane; performer, director, and the secret Lady Shike"
        }
        DESCRIPTION "Doji Shigeru is a renowned performer in his own right, but his secret persona as the inimitable Lady Shike is the true expression of his art. Shigeru specializes in portraying female characters in all manner of dramatic productions, including Nō and Kabuki. When he is not performing, Shigeru lives with his husband, Masato, a former member of the Matsu family.\n\nLady Shike's mysterious identity is part of her allure and fame; to receive a letter from the actor is a social coup, a fact that is sure to be talked about at court. Lady Shike is slated to portray the fisherman's daughter, Doji Mioko, in the upcoming Kabuki play. Doji Shigeru is the director and is in charge of casting for the production."
        REFERENCES {
            "Seasoned Courtier" -> #L5RNBu3W8aU055B7iraBQO ^"Seasoned Courtier"
        }
    }
    #2sbLoahW5crxLE2IifZ6le ^"Lady Magami" DEF {
        EXTENDS #t4540de6f35155c46f41f0 ^"NPC"
        PROPERTIES {
            ^"Type" STRING "Adversary" FIXED
            ^"Profile" STRING "If needed, use the Seasoned Courtier profile on page 313 of the core rulebook with the Sage template, except her status is 65 and her glory is 44."
            ^"Role" STRING "Mantis; candidate for betrothal to the crown prince"
        }
        DESCRIPTION "Although the Mantis Clan is known for their rebuke of tradition, Lady Magami understands the political games most Rokugani play. She is surprisingly demure for a woman raised on the Islands of Spice and Silk, which is even more surprising considering that she was not originally groomed for her current role as potential Empress. In truth, she was a very sickly child, and she was only recently healed through the intervention of a powerful fire spirit from a volcanic island—at great cost to the clan. While most of her family spent their lives at sea, Magami learned to help oversee Yoritomo's household in Gotei City. When she wasn't too ill, she made her way through the Mantis Clan's extensive library of foreign texts, which has made her fluent in not just foreign languages, but foreign literature, customs, and legends. In the three years since she recovered, she's also learned to gut a fish and sail a small boat on her own.\n\nThe decision to offer her hand in marriage is as recent as the \"invitation\" the Mantis Clan received from the Emperor—it is one of Yoritomo's impulsive and ambitious designs. If Magami becomes betrothed to the Heir, she will work with the Unicorn Clan to open Rokugan's borders and establish embassies in the major civilizations to the south and west."
        REFERENCES {
            "Seasoned Courtier" -> #L5RNBu3W8aU055B7iraBQO ^"Seasoned Courtier"
        }

        RULES {
            #tXlVikqDoooH9t1lUccDQT: background "Although the Mantis Clan is known for their rebuke of tradition, Lady Magami understands the political games most Rokugani play. She is surprisingly demure for a woman raised on the Islands of Spice and Silk, which is even more surprising considering that she was not originally groomed for her current role as potential Empress. In truth, she was a very sickly child, and she was only recently healed through the intervention of a powerful fire spirit from a volcanic island—at great cost to the clan. While most of her family spent their lives at sea, Magami learned to help oversee Yoritomo's household in Gotei City. When she wasn't too ill, she made her way through the Mantis Clan's extensive library of foreign texts, which has made her fluent in not just foreign languages, but foreign literature, customs, and legends. In the three years since she recovered, she's also learned to gut a fish and sail a small boat on her own."
        }
    }
    #dyN6riLcxqCLsj2Zx50J6f ^"Lord Yoritomo" DEF {
        EXTENDS #t4540de6f35155c46f41f0 ^"NPC"
        PROPERTIES {
            ^"Type" STRING "Adversary" FIXED
            ^"Profile" STRING "If needed, use the Venerable Provincial Daimyō profile on page 315 of the core rulebook with the Warrior template."
            ^"Role" STRING "Mantis Clan Champion; leader of the Storm Fleet"
        }
        DESCRIPTION "Known as the Son of Storms, Lord Yoritomo is the fearless leader of the Mantis Clan and a feared sea captain in his own right. Married to Linmei of the kōmori people, he honors the roots of his people while forever looking forward to the horizon. Yoritomo is among the only samurai from his delegation with enough social standing to approach the Imperials or other Great Clan leaders, and so he is often busy meeting with other lords. Once Lady Magami debuts at the poetry competition, he spends the bulk of his time introducing her to as many of the great and good of Rokugan as he can. If the PCs manage to cross paths with him, he is clearly more comfortable navigating a storm than he is trying to weather the politics of the court. Still, the admiration he inspires in his followers is enviable. Best of all, he knows how to nail a punchline."
        REFERENCES {
            "Venerable Provincial Daimyō" -> #L5RNjC0Ekju7VGMZ41Rrms ^"Venerable Provincial Daimyō"
        }
    }
}
