# L5R 5E — Winter's Embrace: Dramatis Personae (cast NPCs)
# "Winter's Embrace: An Adventure at the Winter Court" (FFG, product L5R09), a
# Crane-vs-Mantis political adventure at Kyūden Doji. Six major NPCs have full
# printed profiles (transcribed verbatim below); five secondary NPCs use a core-
# rulebook profile plus a template (captured as NPC DEFs naming the profile and
# template, with the book's status/glory overrides, rather than inventing stats).
# Ability text is reproduced verbatim in nested ^"Name" DEF { ^"Effect" ... }
# blocks. This adventure uses the players' own Winter Court characters, so there
# are no pregens; the structure is in l5r5e-0.5-winters-embrace.arc and the
# narrative in the .lore.

EXTENSION "L5R5e_WintersEmbrace_Cast" {
    VERSION "0.5.4"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-09-03"
    DEPENDS_ON "L5R5e_Core_Core"

    # ═══════════════════════ FULL PROFILES ═══════════════════════════════

    #zdhVuywGJSCX9U6hdRwmq1 ^"Doji Hatsuhina" DEF {
        EXTENDS #t4540de6f35155c46f41f0 ^"NPC"
        PROPERTIES {
            ^"Type" STRING "Adversary" FIXED
            ^"Combat Conflict Rank" INTEGER 2
            ^"Intrigue Conflict Rank" INTEGER 5
            ^"Rings" DEF { ^"Air" INTEGER 4 ^"Earth" INTEGER 2 ^"Fire" INTEGER 2 ^"Water" INTEGER 3 ^"Void" INTEGER 3 }
            ^"Demeanor" STRING "Ambitious"
            ^"Endurance" INTEGER 10
            ^"Composure" INTEGER 10
            ^"Focus" INTEGER 7
            ^"Vigilance" INTEGER 4
            ^"Honor" INTEGER 55
            ^"Glory" INTEGER 60
            ^"Status" INTEGER 40
            ^"Skills" LIST OF STRING ["Artisan 3", "Martial 0", "Scholar 2", "Social 3", "Trade 0"]
            ^"Advantages" LIST OF STRING ["Sake Connoisseur — Social; Material, Mental", "Karmic Tie (Koryusai) — Martial, Social; Interpersonal, Spiritual"]
            ^"Disadvantages" LIST OF STRING ["Vindictive — Social; Mental", "Whispers of Failure — Social; Interpersonal, Infamy"]
            ^"Favored Weapons" LIST OF STRING ["Wakizashi: Range 0–1, Damage 3, Deadliness 5/7, Ceremonial, Razor-Edged"]
            ^"Gear" LIST OF STRING ["Gear (equipped): Ceremonial clothes (Physical 1, Ceremonial, Resplendent), personal chop", "Gear (other): Calligraphy set, pillow book"]
        }
        DESCRIPTION "ADVERSARY. Conflict Rank — Combat 2, Intrigue 5. Deputy seneschal of Kyūden Doji."
        #eem1bhT0n05sMup1CDO48e ^"Speaking in Silence" DEF { ^"Effect" STRING "Once per scene when making a check to persuade or influence someone, Hatsuhina may add two kept (ring) set to (op) results." }
        #seIjvAZTiLMlSkDtIiYW1C ^"Rustling of Leaves" DEF {
            EXTENDS #byWI1ENLrPr1vx3ReJY6qJ ^"Rustling of Leaves"
            ^"Effect" STRING "Activation: When Hatsuhina makes a Social skill (Air) check to spread a rumor, she may spend (op) in the following way:\n\nAir (op)+: Increase the TN of any check to trace the rumor back to Hatsuhina by 2 per (op) spent this way."
        }

        RULES {
            #DMegqQ8ALMmWIMYytBILDx: background "Hatsuhina has become as manipulative as the very Scorpion Clan she hates. Beautiful and strikingly tall, she wears her long white hair loose during the day, but by night it is styled with extravagant hairpieces to match her ornate and ostentatious wardrobe. Her piercing brown eyes are tinged with malice. She sees people as tools that can be used to serve her purposes and then be discarded as needed. She has a penchant for alcohol, gambling, and other excesses, which she greedily partakes in when she isn't serving in the humiliating role as deputy to a seneschal who is younger—and less politically nimble—than she is. The parties she throws and outings she arranges are legendary, but at the end of the day, the relationships she forms with others are as superficial as her kindness."
        }
    }

    #kssCuIG1ODlghakgpPeBrA ^"Kakita Ryoku" DEF {
        EXTENDS #t4540de6f35155c46f41f0 ^"NPC"
        PROPERTIES {
            ^"Type" STRING "Adversary" FIXED
            ^"Combat Conflict Rank" INTEGER 3
            ^"Intrigue Conflict Rank" INTEGER 9
            ^"Rings" DEF { ^"Air" INTEGER 5 ^"Earth" INTEGER 2 ^"Fire" INTEGER 3 ^"Water" INTEGER 4 ^"Void" INTEGER 3 }
            ^"Demeanor" STRING "Assertive"
            ^"Endurance" INTEGER 4
            ^"Composure" INTEGER 19
            ^"Focus" INTEGER 8
            ^"Vigilance" INTEGER 5
            ^"Honor" INTEGER 76
            ^"Glory" INTEGER 85
            ^"Status" INTEGER 70
            ^"Skills" LIST OF STRING ["Artisan 3", "Martial 0", "Scholar 3", "Social 5", "Trade 1"]
            ^"Advantages" LIST OF STRING ["Famously Successful — Social; Interpersonal, Fame", "Love of Storytelling — Artisan; Mental"]
            ^"Disadvantages" LIST OF STRING ["Broken Hearted — Social; Mental", "Whispers of Treachery — Social; Interpersonal, Infamy"]
            ^"Favored Weapons" LIST OF STRING ["Wakizashi: Range 0–1, Damage 3, Deadliness 5/7, Ceremonial, Razor-Edged"]
            ^"Gear" LIST OF STRING ["Gear (equipped): Ceremonial clothes (Physical 1, Ceremonial, Resplendent), personal chop", "Gear (other): Pillow book, calligraphy set, omamori (a ward against vengeful spirits) given to Ryoku by Emperor Hantei XXXVII"]
        }
        DESCRIPTION "ADVERSARY. Conflict Rank — Combat 3, Intrigue 9. Legendary Crane courtier and author of Winter."
        #NgLyiq3Yqn9TyFFcnl9wjX ^"Ebb and Flow" DEF {
            EXTENDS #5yqq8PHChTMAT9MtGipsIF ^"Ebb and Flow"
            ^"Effect" STRING "Activation: As a Scheme or Support action, Ryoku may make a Courtesy (Water), Command (Water), or Games (Water) check targeting one character. The TN of this check is equal to the target's vigilance.\n\nEffects: If Ryoku succeeds (and chose Scheme action), she may choose one of the target's advantages that she knows, and whenever it applies, invert it. This effect persists until the end of the scene. If Ryoku succeeds (and chose Support action), she may choose one of the target's disadvantages she knows and, whenever it applies, invert it. This effect persists until the end of the scene."
        }
        #yTAHzXHjWXECyVYietohTm ^"I Have Met Your Like Before" DEF { ^"Effect" STRING "When performing a Scheme action, Ryoku may spend (op) in the following way:\n\n(op): Learn the target's ninjō or giri, or a single advantage or disadvantage.\n\n(op) (op): Learn the target's current goal in this scene." }
        #01KtPrg4JzqTf20Ru9Cokw ^"Speaking in Silence" DEF { ^"Effect" STRING "Once per scene when making a check to persuade or influence someone, Ryoku may add five kept (ring) set to (op)." }
        #J5T531ar1TP6F7sLoWkfbX ^"Everything Tells a Story" DEF { ^"Effect" STRING "When performing an Artisan skill check, Ryoku may add one kept (ring) set to an (op) result." }

        RULES {
            #gKhO11XEKcLeQXw8WjVEiJ: background "The honorable and elegant Kakita Ryoku is among the most distinguished—and infamous—courtiers of the Crane Clan. She is perhaps best known for her novel Winter, which is allegedly a record of her many romantic affairs and conquests, including the Emperor himself. Until recently, she served the Emperor Hantei XXXVIII as his Imperial Advisor. Before that, she served in the Imperial Capital, where she resided for nearly all of her seventy years. She is known for her mastery of diplomacy and etiquette, but she began as a storyteller in the Kakita Artisan Academy. Now that she has been released from her duties, she has ostensibly returned to her writing. In truth, this has only freed her to meddle further in politics."
        }
    }

    #3Behf4OwSDkdG4lc375iqc ^"Ikoma Rumiko" DEF {
        EXTENDS #t4540de6f35155c46f41f0 ^"NPC"
        PROPERTIES {
            ^"Type" STRING "Adversary" FIXED
            ^"Combat Conflict Rank" INTEGER 5
            ^"Intrigue Conflict Rank" INTEGER 5
            ^"Rings" DEF { ^"Air" INTEGER 3 ^"Earth" INTEGER 2 ^"Fire" INTEGER 3 ^"Water" INTEGER 4 ^"Void" INTEGER 2 }
            ^"Demeanor" STRING "Playful"
            ^"Endurance" INTEGER 10
            ^"Composure" INTEGER 12
            ^"Focus" INTEGER 6
            ^"Vigilance" INTEGER 4
            ^"Honor" INTEGER 25
            ^"Glory" INTEGER 60
            ^"Status" INTEGER 35
            ^"Skills" LIST OF STRING ["Artisan 3", "Martial 2", "Scholar 3", "Social 2", "Trade 1"]
            ^"Advantages" LIST OF STRING ["As We Say in the Theater… — Scholar; Mental", "Unparalleled Wit — Social; Interpersonal"]
            ^"Disadvantages" LIST OF STRING ["Dark Secret — Social; Material", "Disdain for Honor — Social; Mental"]
            ^"Favored Weapons" LIST OF STRING ["Kiseru: Range 0, Damage 2, Deadliness 2, Concealable, Mundane", "Knife: Range 0, Damage 2, Deadliness 4/6, Concealable, Mundane, Razor-Edged", "Wakizashi: Range 0–1, Damage 3, Deadliness 5/7, Ceremonial, Razor-Edged"]
            ^"Gear" LIST OF STRING ["Gear (equipped): Concealed armor (Physical 2, Concealable), 10 doses of fire biter poison, script for the play The Tale of the Fisherman's Daughter"]
        }
        DESCRIPTION "ADVERSARY. Conflict Rank — Combat 5, Intrigue 5. Kabuki actor; secretly a Lion shinobi."
        #AEJnhcP1us3S62c7zNpNTt ^"Heart of the Lion" DEF { ^"Effect" STRING "Once per scene, after Rumiko performs a Social skill check targeting one or more characters, she may agitate or console: If she agitates, she transfers strife up to 10 strife from herself to her targets (divided among them as she chooses). If she consoles, she transfers up to 10 strife from her targets (divided among them as she choose) to herself." }
        #p91um2fEDsZCH2sTDjccFM ^"Noxious Cloud" DEF {
            EXTENDS #5yKYfFDPSlfe5aZ8XGo6QF ^"Noxious Cloud"
            ^"Effect" STRING "Activation: As an Attack action, Rumiko may use two doses of any single poison and make a TN 2 Medicine (Air) check targeting each other character at range 0–2.\n\nEffects: If Rumiko succeeds, each target suffers 3 physical damage, ignoring their resistance. This damage counts as being inflicted by a weapon envenomed with the poison she chose (see page 244 of the core rulebook).\n\nAir (op): Move 1 range band.\n\nAir (op): Until the end of the scene, the area at range 0–2 becomes Obscuring and Dangerous terrain."
        }
        #V17j3ossZG3rjnKcXuF1E1 ^"Victory Before Honor" DEF { ^"Effect" STRING "Once per scene when performing a check, Rumiko may stake up to 5 honor to re-roll a number of dice equal to twice the amount of honor staked. For each re-rolled die result that does not contain a (su) or (ex), she forfeits one staked honor." }
    }

    #PbvEIuEOUj92dRLC7aCgdI ^"Miya Satoshi" DEF {
        EXTENDS #t4540de6f35155c46f41f0 ^"NPC"
        PROPERTIES {
            ^"Type" STRING "Adversary" FIXED
            ^"Combat Conflict Rank" INTEGER 5
            ^"Intrigue Conflict Rank" INTEGER 8
            ^"Rings" DEF { ^"Air" INTEGER 3 ^"Earth" INTEGER 4 ^"Fire" INTEGER 3 ^"Water" INTEGER 2 ^"Void" INTEGER 2 }
            ^"Demeanor" STRING "Shrewd"
            ^"Endurance" INTEGER 14
            ^"Composure" INTEGER 12
            ^"Focus" INTEGER 6
            ^"Vigilance" INTEGER 3
            ^"Honor" INTEGER 29
            ^"Glory" INTEGER 85
            ^"Status" INTEGER 75
            ^"Skills" LIST OF STRING ["Artisan 1", "Martial 2", "Scholar 3", "Social 3", "Trade 1"]
            ^"Advantages" LIST OF STRING ["Ear of the Emperor — Social; Interpersonal", "Heartless — Social; Mental"]
            ^"Disadvantages" LIST OF STRING ["Dark Secret — Social; Interpersonal", "Contrary — Social; Mental"]
            ^"Favored Weapons" LIST OF STRING ["Satoshi's War Fans: Range 0–1, Damage 5, Deadliness 4, Ceremonial, Concealable, Resplendent", "Wakizashi: Range 0–1, Damage 3, Deadliness 5/7, Ceremonial, Razor-Edged"]
            ^"Gear" LIST OF STRING ["Gear (equipped): Imperial robes (Physical 1, Supernatural 1, Ceremonial, Resplendent), scroll cases"]
        }
        DESCRIPTION "ADVERSARY. Conflict Rank — Combat 5, Intrigue 8. Imperial Herald; secretly a Kolat agent."
        #bdbtQlYuIkggNLyv1JWhR6 ^"Voice of the Emperor" DEF { ^"Effect" STRING "Once per round, after a character at range 0–4 succeeds on an Attack or Scheme action check, Satoshi may cause them to receive 5 strife." }
        #HaUNhhZAAvlmybHIuHKzDm ^"Civility Foremost" DEF {
            EXTENDS #YRrwJlgAyPpVIMmg9hKPC4 ^"Civility Foremost"
            ^"Effect" STRING "Activation: As a Scheme action, Satoshi may make a Command or Courtesy (Earth) check targeting one character to claim protection for an individual of his choice by right of honor. The TN of the check is equal to the target's vigilance.\n\nEffects: If Satoshi succeeds, the target must forfeit 4 honor, plus 1 per bonus success, and suffer that much strife to perform an Attack or Scheme action against the protected individual. This effect persists until the end of the scene, or until the target performs an Attack or Scheme action.\n\nEarth (op)+: Choose one additional target with vigilance lower than or equal to Satoshi's first target's vigilance per (op) spent this way."
        }

        RULES {
            #UAsbGof8V60OXfV5pzK6Lj: background "Miya Satoshi is descended from a long line of mortals who chose to serve the divine Hantei line, but he does not share their sympathies for the Emperor. He cannot help but fixate on the Emperor's shortcomings, his failures and foibles, believing that the Empire would be better off if it did not cling so blindly to tradition. Satoshi has succumbed to the beliefs of the Kolat, and this has affected his interactions with the Great Clans and the Imperial line. (See The True Allegiances of Miya Satoshi on page 17.)"
        }
    }

