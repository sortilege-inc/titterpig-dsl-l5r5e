                ^"Cadence" [shuji]
            }
        }

        GUIDANCE {
            ENTRY ^"errata-kakita-duelist-0" #L5RERGN33bioj6eG4R1TYq {
                CONCERNS [ #t2f4a03e3782b0a8fe51a9 ^"Kakita Duelist" ]
                TOPICS [ "errata" ]
                TEXT "p. 65–85, Curriculum Tables: A number of technique entries are redundant, and should be replaced as follows:\n\np. 65, Kakita Duelist (Rank 1): Replace Striking as Air (kata) with Cadence (shuji)"
            }
            ENTRY ^"errata-kakita-duelist-1" #L5RERG3Aax2pkALF383eUR {
                CONCERNS [ #t2f4a03e3782b0a8fe51a9 ^"Kakita Duelist" ]
