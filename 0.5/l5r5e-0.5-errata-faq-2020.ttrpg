    MODIFY #FKmujLSSs35USGKWx0VVg9 ^"Commune with Evil" {
        SET ^"Opportunities" STRING "(op): If there are any such beings, they accept your offering, and they augment you with an unholy blessing that increases the value of the ring you used for the check by 1. You can only have one unholy blessing at a time, and it persists until the end of the next scene. (op)(op)(op)+: If you receive an unholy blessing, it temporarily increases the ring's value by an additional 1 per (op)(op)(op) spent this way. (op)+: If you receive an unholy blessing, it persists for 1 additional scene per (op) spent this way."

        GUIDANCE {
            ENTRY ^"errata-commune-with-evil-0" #L5RERGg1fD2XpEJL9urTvp {
                CONCERNS [ #FKmujLSSs35USGKWx0VVg9 ^"Commune with Evil" ]
                TOPICS [ "errata" ]
                TEXT "p. 119, Commune with Evil, New Opportunities: The first opportunity's final sentence should read \"it persists until the end of the next scene\" rather than \"it persists until the end of the scene.\"\n\nAdditionally, the third opportunity should read \"...1 additional scene per (op) spent this way.\" rather than \"...1 additional round per (op) spent this way.\""
            }
        }
    }

    MODIFY #ULC2xpBdXz04vCZ3LBNsAg ^"Fiend's Retreat" {
        SET ^"Opportunities" STRING "(op)+: Choose one additional character at range 0–1 to move and one additional target per (op) spent this way. (op)+: Increase the maximum range by 1 per (op) spent this way."

        GUIDANCE {
            ENTRY ^"errata-fiend-s-retreat-0" #L5RERGJSEhbJPZ79kMM1s1 {
                CONCERNS [ #ULC2xpBdXz04vCZ3LBNsAg ^"Fiend's Retreat" ]
                TOPICS [ "errata" ]
                TEXT "p. 119, Fiend's Retreat, New Opportunities: The second opportunity for this technique this technique's header should read \"(op)+\" instead of \"(op)\" (indicating that the opportunity scales with effect)."
            }
            ENTRY ^"faq-fiend-s-retreat-1" #L5RERGe9a4awIDGraORIxj {
                CONCERNS [ #ULC2xpBdXz04vCZ3LBNsAg ^"Fiend's Retreat" ]
                TOPICS [ "faq" ]
                TEXT "Q: When must a character choose to use Fiend's Retreat, Laughing Fox Style, and other effects that change the target of an action?\n\nA: A character chooses whether to use this ability after the character making the check that incited the ability has chosen kept dice, but before symbols on kept dice are resolved (after Step 5, before Step 6)."
            }
        }
    }

    MODIFY #gXpX7wNpEpQoTTsym6jkpf ^"Spiritual Shackles" {
        SET ^"Activation" STRING "As an Attack and Scheme action, you may make a Theology (Air) check targeting one Otherworldly being at range 0–1. The TN of this check is equal to the target's vigilance and is reduced by 2 if the target is also a Tainted being."

        GUIDANCE {
            ENTRY ^"errata-spiritual-shackles-0" #L5RERGwgy8MTMLs5lZ8HbW {
                CONCERNS [ #gXpX7wNpEpQoTTsym6jkpf ^"Spiritual Shackles" ]
                TOPICS [ "errata" ]
                TEXT "p. 120, Spiritual Shackles, Activation: All instances of \"Intrigue action\" should read \"Scheme action.\""
            }
        }
    }

