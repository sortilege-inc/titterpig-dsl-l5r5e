                TOPICS [ "errata" ]
                TEXT "p. 231, Table 5–1: Weapons\n\nZanbatō entry: The damage (DMG) of this weapon should be 6. The deadliness (DLS) of this weapon should be 7."
            }
        }
    }

    MODIFY #IZsfIQRVLozVRXG7nXCO4R ^"Scheme Action" {
