                CONCERNS [ #t508bea43804b743bf7d3b ^"Utaku Battle Maiden" ]
                TOPICS [ "errata" ]
                TEXT "p. 65–85, Curriculum Tables: A number of technique entries are redundant, and should be replaced as follows:\n\np. 86, Utaku Battle Maiden (Rank 1): Replace Striking as Air (kata) with Courtier's Resolve (shuji)"
            }
