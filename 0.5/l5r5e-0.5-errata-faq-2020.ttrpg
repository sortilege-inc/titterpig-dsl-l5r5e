    }

    MODIFY #L5R350fG9hI1jK3lM5nO7p ^"Technique" {
        GUIDANCE {
            ENTRY ^"errata-technique-0" #L5RERGjxxneU5BJVlxaNJQ {
                CONCERNS [ #L5R350fG9hI1jK3lM5nO7p ^"Technique" ]
                TOPICS [ "errata" ]
                TEXT "p. 173, Prerequisites, second paragraph, first sentence should be replaced with: \"Note that all prerequisites are waived if a character is granted a technique directly during character creation (or at another time), or if the technique appears by name on their curriculum. If a technique is part of a listed group (e.g. \"= Rank 1–3 Kata\"), the character ignores school rank prerequisites, but not other prerequisites (clan, etc).\"\n\nAs an example of this principle in practice, see the Emerald Magistrate title found on page 305. The curriculum grants access to Rank 1–2 Kata, which waives the rank (2) prerequisite and the technique group prerequisite (kata).\n\nHowever, this title does not grant access to clan-specific techniques, such as Lord Hida's Grip (page 176) because that technique is limited to Crab Clan members, unless a curriculum specifically calls out that technique by name."
            }
        }
    }

    MODIFY #qvjQa6mLVO7fM30Hyv4a6x ^"Iaijutsu Cut: Rising Blade" {
        ACTIVATION "As an Attack action using one sheathed ^\"Razor-Edged\" weapon, you may make a Martial Arts [Melee] check targeting one character at range 0-1. The TN of this check is equal to the target's vigilance."

        GUIDANCE {
            ENTRY ^"errata-iaijutsu-cut-rising-blade-0" #L5RERG04cPpnQQo9l21uhb {
                CONCERNS [ #qvjQa6mLVO7fM30Hyv4a6x ^"Iaijutsu Cut: Rising Blade" ]
                TOPICS [ "errata" ]
                TEXT "p. 179, Iaijutsu Cut: Rising Blade, Activation: This should read \"As an Attack action using one sheathed Razor-Edged weapon, you may make a Martial Arts [Melee] check targeting one character at range 0–1. The TN of this check is equal to the target's vigilance.\""
            }
            ENTRY ^"faq-iaijutsu-cut-rising-blade-1" #L5RERGyIFRj86TAnikPaqJ {
                CONCERNS [ #qvjQa6mLVO7fM30Hyv4a6x ^"Iaijutsu Cut: Rising Blade" ]
                TOPICS [ "faq" ]
                TEXT "Q: Can an Iaijutsu Cut techniques on p.179 of the core rulebook be performed with a Razor-Edged weapon that has no one-handed grip (such as a naginata or nodachi) or a one-handed grip without Razor-Edged (such as the jian)?\n\nA: The short answer is that these techniques cannot be used with weapons that cannot be wielded in a one-handed grip or lack Razor-Edged for their one-handed grip.\n\nThese Iaijutsu Cut techniques instruct the character to ready the weapon in a one-handed grip. If the chosen weapon has no one-handed grip, or the one-handed grip lacks Razor-Edged, it is ineligible to be used for these techniques."
            }
        }
    }

    MODIFY #WwPkXXi4dAl9cYpp5BVJOO ^"Zanbatō" {
        SET ^"Base Damage" INTEGER 6
        SET ^"Deadliness" INTEGER 7

        GUIDANCE {
