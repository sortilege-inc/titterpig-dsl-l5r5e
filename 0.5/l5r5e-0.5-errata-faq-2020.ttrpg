    MODIFY #t94d8eaee1f03a4f4d9ec5 ^"Rhinoceros" {
        RULES {
            #L5RPW71oN4gU7xY4lR3tT0dX4gO: rhino_charge "Furious Charge: A rhinoceros is a creature of silhouette 4. As an Attack action, a rhinoceros may target a location within range 3–5. The rhinoceros charges at the targeted location, and any creatures within range 0–1 of the location must make a TN 4 Fitness check (Fire 6, Air 2) to resist. If they fail, they suffer a critical strike of severity 8 and the Unconscious condition."
        }

        GUIDANCE {
            ENTRY ^"errata-rhinoceros-0" #L5RERG1PJf8cAXMDkKPvcA {
                CONCERNS [ #t94d8eaee1f03a4f4d9ec5 ^"Rhinoceros" ]
                TOPICS [ "errata" ]
                TEXT "p. 243, Rhinoceros: The Furious Charge ability's final sentence should read \"If they fail, they suffer a critical strike of severity 8 and the Unconscious condition.\""
            }
        }
    }

    MODIFY #tcc302e1019b2f714e1efb ^"Furiribi" {
        PROPERTIES {
            ^"Burns the Soul" DEF {
                ^"Description" STRING "When a creature touches a furiribi they must make a TN 4 Fitness check (Earth 5, Fire 5, Void 2) to resist the furiribi's spiritual flame. If a creature fails, they take 5 Supernatural damage and become Exhausted. If the target is already Exhausted, they suffer the Unconscious condition."
            }
        }

        GUIDANCE {
            ENTRY ^"errata-furiribi-0" #L5RERG3gC9xsxNeb9svDIr {
                CONCERNS [ #tcc302e1019b2f714e1efb ^"Furiribi" ]
                TOPICS [ "errata" ]
                TEXT "p. 243, Furiribi: The Burns the Soul ability's final sentence should read \"If the target is already Exhausted, they suffer the Unconscious condition.\""
            }
        }
    }

    MODIFY #t517e363091d571b19bd62 ^"Void Points" {
        GUIDANCE {
            ENTRY ^"faq-void-points-0" #L5RERGhqiiNO2zTzYULNn1 {
                CONCERNS [ #t517e363091d571b19bd62 ^"Void Points" ]
                TOPICS [ "faq" ]
                TEXT "Q: When a character's advantage is inverted during a check, do they gain 2 Void points if they then fail the check (or receive strife)? Do they gain 0 Void points if the inverted advantage is canceled by a different advantage?\n\nA: A character whose advantage is inverted during a check always gains back 1 Void point after the check, regardless of their success or failure on the check, or the cancellation of the inverted advantage by another advantage."
            }
        }
    }

    MODIFY #t4540de6f35155c46f41f0 ^"NPC" {
        GUIDANCE {
            ENTRY ^"faq-npc-0" #L5RERGWDUbIjcYBcdj39Sh {
                CONCERNS [ #t4540de6f35155c46f41f0 ^"NPC" ]
                TOPICS [ "faq" ]
                TEXT "Q: How should NPC Void points be handled?\n\nA: Minion NPCs do not have (and cannot spend) Void points. Adversary NPCs have a number of Void points equal to half their Void Ring, rounded up."
            }
            ENTRY ^"faq-npc-1" #L5RERGhXFJetrBhW1gONat {
                CONCERNS [ #t4540de6f35155c46f41f0 ^"NPC" ]
                TOPICS [ "faq" ]
                TEXT "Q: When an NPC performs a Mahō technique, how many of its rings count as having the Shadowlands Taint disadvantage for the purposes of the Mahō technique's scaling effect?\n\nA: If the NPC is not a Tainted being, it counts as having no Tainted rings for the purposes of scaling effects.\n\nIf the NPC is a Tainted being but not an Otherworldly being, it counts as having two rings with the Shadowlands Taint disadvantage for the purposes of scaling effects.\n\nIf an NPC is an Otherworldly, Tainted being, it counts as having four rings with the Shadowlands Taint disadvantage for the purposes of scaling effects. If its (combat) threat rating is also 10 or higher, it may count as having five Shadowlands Taint disadvantages at the GM's discretion."
            }
        }
    }

    MODIFY #L5R252wX4yZ6aB8cD0eF2g ^"School" {
        GUIDANCE {
            ENTRY ^"faq-school-0" #L5RERGCGrAiQ0uNlbuhloU {
                CONCERNS [ #L5R252wX4yZ6aB8cD0eF2g ^"School" ]
                TOPICS [ "faq" ]
                TEXT "Q: Can a character count multiple purchases from a single entry on the current school rank of their curriculum toward their current school rank?\n\nA: Yes. A character can count any number of purchases of ranks of a skill or skill group or techniques from a listed category (e.g., Kata Rank 1–2) toward their current school rank."
            }
            ENTRY ^"faq-school-1" #L5RERGMMPnmNghBScmoRWi {
                CONCERNS [ #L5R252wX4yZ6aB8cD0eF2g ^"School" ]
                TOPICS [ "faq" ]
                TEXT "Q: If a character has access to an advancement with the = symbol that they could not normally purchase at a specific school rank or via a specific title, can they purchase it after completing that rank or title?\n\nA: No. The special access to purchase that advancement does not persist once the rank is completed."
            }
        }
    }

    MODIFY #t9add0d08a192de50e8fd9 ^"Asahina Artificer" {
        GUIDANCE {
            ENTRY ^"faq-asahina-artificer-0" #L5RERGisA8cpSxd4huuiCI {
                CONCERNS [ #t9add0d08a192de50e8fd9 ^"Asahina Artificer" ]
                TOPICS [ "faq" ]
                TEXT "Q: When does the Asahina Artificer's school ability apply?\n\nA: It applies to invocations that use the listed keywords to do the following (and other checks with related narrative function):\n\nSummon an illusion (e.g., Token of Memory, Matsu's Battlecry)\n\nSummon an object, which in this case means any manifestation of an element that is not a being like a Manifest Kami (e.g., Blessed Wind, Katana of Fire, Earthquake)\n\nAugment an object (e.g., Cloak of Night, Armor of Radiance)\n\nAwaken an object (e.g., the school's Mastery Ability)"
            }
        }
    }

    MODIFY #tb945dec1947fb7a30c601 ^"Matsu Berserker" {
        GUIDANCE {
            ENTRY ^"faq-matsu-berserker-0" #L5RERGb1cVtRC1FB8T9NY4 {
                CONCERNS [ #tb945dec1947fb7a30c601 ^"Matsu Berserker" ]
                TOPICS [ "faq" ]
                TEXT "Q: Can a Matsu Berserker's school ability (see p. 73) trigger even if that character is already suffering the Enraged condition?\n\nA: Yes. A Matsu Berserker may suffer the Enraged condition to trigger their ability even while Enraged (though they only end up with one instance of the condition, per Persistent Effects on p. 174 of the core rulebook)."
            }
        }
    }

        #ZUUl5S72ojs01qoaHaZEfI ^"GM Guidance: TN Modifiers (2020)" DEF {
        APPLIES TO [#t4bb5a837984a5a2879be0 ^"Game Rules"]
        PROPERTIES {
            ^"Source Document" STRING "L5R5e FAQ August 2020"
            ^"Guidance Type"   STRING "TN modification by narrative circumstance"
            ^"Description"     STRING "What are some guidelines on modifying the TN of a check based on circumstances?"
        }
        TN_PENALTIES {
            ^"+1" STRING "Fresh snow on a rooftop you are trying to jump across\n\nVery scarce or poorly maintained versions of necessary tools or resources\n\nLacking a shared cultural context with someone you are trying to convince of a perspective\n\nRadically different elevation or climate that you have not yet acclimated to\n\nBiting flies or mosquitoes\n\nAnother character's predisposition to distrust you based on past encounters"
            ^"+2" STRING "A tool or implement that is entirely foreign to you\n\nBeing very rushed in a task (attempting it in half the usual time or less)\n\nLife-threateningly hot or cold conditions\n\nBeing weak with hunger or thirst\n\nSignificant encumbrance, such as trying to act while carrying two silhouette 2 creatures or objects or an especially heavy or unwieldy combination of smaller creatures or objects"
            ^"+3" STRING "Not sharing a language someone you are trying to convince of a perspective\n\nStorm winds on an open sea\n\nActing overtly against the will of a celestial being (such as one of Rokugan's founding Kami or an Elemental Dragon) in that being presence"
        }
        TN_BONUSES {
            ^"-1" STRING "Uncommonly good tools or resources\n\nHaving significantly more time (double or more) than strictly needed to attempt a task\n\nA gentle downhill slope in the direction you are marching\n\nPrimary sources (rather than just later summations) on a topic you are researching\n\nActing in accordance with your own giri or ninjō immediately after unmasking\n\nAnother character's predisposition to trust you based on a few past encounters\n\nAppealing directly to another character's giri or ninjō in an offer you make to them\n\nFavorable winds on a sea journey"
            ^"-2" STRING "An entire library or institution dedicated to a topic you are researching\n\nAn attendant to carry your goods on a long march\n\nAnother character's predisposition to trust you based on many past encounters\n\nThe cover of deep shadow or significant cover when trying to sneak or hide\n\nAppealing to both a character's giri and ninjō in an offer you make to them"
            ^"-3" STRING "Access to a cart while moving objects of significant weight (objects of silhouette 3 or larger, or especially heavy small objects)\n\nActing with the blessing of a celestial being (such as one of Rokugan's founding Kami or an Elemental Dragon) in that being's presence"
        }
        RULES {
            #L5REF49iJ0kL2mN4oP6qR8s: gm_guidance_tn_modifier_penalties "TN Penalty Examples: +1 to TN\n\nFresh snow on a rooftop you are trying to jump across\n\nVery scarce or poorly maintained versions of necessary tools or resources\n\nLacking a shared cultural context with someone you are trying to convince of a perspective\n\nRadically different elevation or climate that you have not yet acclimated to\n\nBiting flies or mosquitoes\n\nAnother character's predisposition to distrust you based on past encounters\n\n+2 to TN\n\nA tool or implement that is entirely foreign to you\n\nBeing very rushed in a task (attempting it in half the usual time or less)\n\nLife-threateningly hot or cold conditions\n\nBeing weak with hunger or thirst\n\nSignificant encumbrance, such as trying to act while carrying two silhouette 2 creatures or objects or an especially heavy or unwieldy combination of smaller creatures or objects\n\n+3 to TN\n\nNot sharing a language someone you are trying to convince of a perspective\n\nStorm winds on an open sea\n\nActing overtly against the will of a celestial being (such as one of Rokugan's founding Kami or an Elemental Dragon) in that being presence"
            #L5REF50tU1vW3xY5zA7bC9d: gm_guidance_tn_modifier_bonuses "TN Bonus Examples: –1 to TN\n\nUncommonly good tools or resources\n\nHaving significantly more time (double or more) than strictly needed to attempt a task\n\nA gentle downhill slope in the direction you are marching\n\nPrimary sources (rather than just later summations) on a topic you are researching\n\nActing in accordance with your own giri or ninjō immediately after unmasking\n\nAnother character's predisposition to trust you based on a few past encounters\n\nAppealing directly to another character's giri or ninjō in an offer you make to them\n\nFavorable winds on a sea journey\n\n–2 to TN\n\nAn entire library or institution dedicated to a topic you are researching\n\nAn attendant to carry your goods on a long march\n\nAnother character's predisposition to trust you based on many past encounters\n\nThe cover of deep shadow or significant cover when trying to sneak or hide\n\nAppealing to both a character's giri and ninjō in an offer you make to them\n\n–3 to TN\n\nAccess to a cart while moving objects of significant weight (objects of silhouette 3 or larger, or especially heavy small objects)\n\nActing with the blessing of a celestial being (such as one of Rokugan's founding Kami or an Elemental Dragon) in that being's presence"
        }
    }

        #XApR5YJeT8eLLWol0Nos88 ^"GM Guidance: Staked Social Attributes (2020)" DEF {
        APPLIES TO [#t4bb5a837984a5a2879be0 ^"Game Rules"]
        PROPERTIES {
            ^"Source Document" STRING "L5R5e FAQ August 2020"
            ^"Guidance Type"   STRING "Staking honor, glory, status to convince or accomplish without checks"
            ^"Description"     STRING "What are some guidelines on staking social attributes, and the benefits characters can receive?"
            ^"Personal Oaths"  STRING "Personal oaths to other individuals require staking honor"
            ^"Public Statements" STRING "Public statements of intent require staking glory"
            ^"Guarantees"      STRING "Guarantees or contracts based on one's social position or finances require staking status"
            ^"Combined Oaths"  STRING "Any oath that combines one or more of these requires staking all attributes it invokes, and should gain added benefits for the added risk"
            ^"Failure Penalty" STRING "If a character fails to uphold the oath, statement, or their end of the contract, they lose the staked points.\n\nIf the opportunity for a character to lose their stake passes (such as if they return an item borrowed, or an oath is fulfilled), their staked points of the attribute are returned. In the case of an oath that cannot be fulfilled within one's lifetime, if the GM and player agree that it is narratively fulfilled, they may treat it as such (even if it is technically ongoing, such as a promise to keep a secret unto death)."
        }
        HONOR_STAKES {
            ^"Honor's Demand" "Convincing another samurai to uphold a particular aspect of Bushidō for yourself or another, such as hospitality to captured foes or mercy to the wounded\n\nHonor equal to the character's focus\n\nYou break any reciprocal restrictions of Bushidō that their act entails, such as violating hospitality you accepted or refusing to properly acknowledge mercy shown"
            ^"Trust My Blade" "Convincing someone of to entrust you with a task on their behalf or a specific assignment for them without a check\n\nHonor equal to that character's status rank\n\nYou give up on the task, or somehow definitively fail in accomplishing it"
            ^"I Will Return It" "Convincing someone to lend you an item of rarity without a check\n\nHonor equal to the rarity of the item\n\nYou lose the item, or otherwise render it so that it cannot be returned"
            ^"To Betray Others Betrays Oneself" "Convincing someone to put their trust in you without a check when you could benefit by betraying them\n\nHonor equal to that character's focus\n\nYou betray their trust or use their trust to act significantly against their interests"
            ^"The Wise Listen" "Convincing someone to accept your expertise on a specific matter without a check\n\nHonor equal to that character's status\n\nSee above, but it must become publicly known that you did so (whether or not this actually transpired)"
        }
        GLORY_STAKES {
            ^"This Oath I Claim" "Any of the above, but instead of approaching the matter privately or appealing to their faith in Bushidō, you appeal to the character publicly or leverage your reputation to convince them\n\nGlory instead honor, or in addition to honor at the GM's discretion\n\nSee above, but it must become publicly known that you did so (whether or not this actually transpired)"
        }
        STATUS_STAKES {
            ^"Trust My Conviction" "Convincing someone to back you or your ambitions socially or financially without a check\n\nStatus ranging from 1 for a single helpful item or connection to 10 for significant military backing, such as the use of an army\n\nYou fail to either make a gift of similar value at a later date, or otherwise answer your backer's future requests for assistance"
        }
        COMBINED_STAKES {
            ^"Hear My Plea" "Based on narrative circumstances, the GM might decide that any of the above are not appropriate without making one or more checks. If the GM rules that a character must still make one or more checks, it is recommended that the character instead be allowed stake an amount of the attribute(s) to reduce the TN of the checks required to convince that person\n\nRelevant attribute equal to the focus of the character for –1 to the TN, plus an additional 3 of the attribute for each additional –1 to the check, to a maximum of –3\n\nSee relevant entry above"
        }
        RULES {
            #L5REF51eF2gH4iJ6kL8mN0o: gm_guidance_staked_honor_examples "Honor: Honor's Demand: Convincing another samurai to uphold a particular aspect of Bushidō for yourself or another, such as hospitality to captured foes or mercy to the wounded\n\nHonor equal to the character's focus\n\nYou break any reciprocal restrictions of Bushidō that their act entails, such as violating hospitality you accepted or refusing to properly acknowledge mercy shown\n\nTrust My Blade: Convincing someone of to entrust you with a task on their behalf or a specific assignment for them without a check\n\nHonor equal to that character's status rank\n\nYou give up on the task, or somehow definitively fail in accomplishing it\n\nI Will Return It: Convincing someone to lend you an item of rarity without a check\n\nHonor equal to the rarity of the item\n\nYou lose the item, or otherwise render it so that it cannot be returned\n\nTo Betray Others Betrays Oneself: Convincing someone to put their trust in you without a check when you could benefit by betraying them\n\nHonor equal to that character's focus\n\nYou betray their trust or use their trust to act significantly against their interests\n\nThe Wise Listen: Convincing someone to accept your expertise on a specific matter without a check\n\nHonor equal to that character's status\n\nSee above, but it must become publicly known that you did so (whether or not this actually transpired)"
            #L5REF52pQ3rS5tU7vW9xY1z: gm_guidance_staked_glory_examples "Glory: This Oath I Claim: Any of the above, but instead of approaching the matter privately or appealing to their faith in Bushidō, you appeal to the character publicly or leverage your reputation to convince them\n\nGlory instead honor, or in addition to honor at the GM's discretion\n\nSee above, but it must become publicly known that you did so (whether or not this actually transpired)"
            #L5REF53aB4cD6eF8gH0iJ2k: gm_guidance_staked_status_examples "Status: Trust My Conviction: Convincing someone to back you or your ambitions socially or financially without a check\n\nStatus ranging from 1 for a single helpful item or connection to 10 for significant military backing, such as the use of an army\n\nYou fail to either make a gift of similar value at a later date, or otherwise answer your backer's future requests for assistance"
            #L5REF54lM5nO7pQ9rS1tU3v: gm_guidance_staked_combined_hear_my_plea "One or More: Hear My Plea: Based on narrative circumstances, the GM might decide that any of the above are not appropriate without making one or more checks. If the GM rules that a character must still make one or more checks, it is recommended that the character instead be allowed stake an amount of the attribute(s) to reduce the TN of the checks required to convince that person\n\nRelevant attribute equal to the focus of the character for –1 to the TN, plus an additional 3 of the attribute for each additional –1 to the check, to a maximum of –3\n\nSee relevant entry above"
        }
    }

        #cMeQ9PYfZH6qK6DzdJ28h2 ^"GM Guidance: Optional Rules Catalog (2020)" DEF {
        APPLIES TO [#t4bb5a837984a5a2879be0 ^"Game Rules"]
        PROPERTIES {
            ^"Source Document" STRING "L5R5e FAQ August 2020"
            ^"Guidance Type"   STRING "Catalog of official optional rules across published books"
        }
        CATALOG {
            ^"Bonds" "Adds rules for developing relationships mechanically (p 136 of Courts of Stone, p. 187 of Path of Waves—note that bonds are assumed to be in effect if using the campaign style presented throughout Path of Waves)"
            ^"Cross-Ring Opportunities" "Allows opportunities to be used from adjacent rings at higher cost (p. 298 of the core rulebook)"
            ^"Grittier Games" "Makes weapons deadlier and Bleeding potentially lethal (p. 288 of the core rulebook)"
            ^"Experienced PCs" "Gives newly created characters XP to spend (see p. 305 of the core rulebook)"
            ^"One-Roll Duels" "Lets duels be decided with a single dice roll per combatant p. 261 of the core rulebook)"
            ^"Range Bands on a Tactical Grid" "Adds rules for using a tactical grid (p. 266 of the core rulebook)"
            ^"Risky Checks" "Adds a risk/reward element to certain checks (p. 9 of this document)"
            ^"Ronin Honor and Glory" "Allows characters to customize their attachment to individual tenets of Bushidō (p. 181 of Path of Waves)"
            ^"Shoddy Improvised Weapons" "Causes improvised weapons to break more easily (p. 10 of this document)"
            ^"Subskills" "Adds more granular skill options to represent specialized training (p. 143 of the core rulebook)"
            ^"Trifling Breaches and Small Sacrifices" "Adds more ways to forfeit and earn honor (p. 143 of Shadowlands, p. 135 of Courts of Stone)"
            ^"Unmasking for Effect" "Allows characters to gain a mechanical bonus after unmasking (p. 135 of Courts of Stone)"
        }
        RULES {
            #L5REF55wX6yZ8aB0cD2eF4g: gm_guidance_optional_rules_catalog "Using Optional Rules: L5R seeks to empower the GM to run the game the way it will be most fun for their group (including the GM themself!). Thus, from a certain perspective, all rules are \"optional,\" insofar as each group is encouraged to find the way that the game plays best for its individual needs. If an individual school or item from a supplement does not fit the tone or themes of the campaign, for instance, the GM is free to ask a player to make a different selection. In general, the GM can always add, alter, or remove rules to best pursue everyone's enjoyment at the table.\n\nEven so, L5R specifically calls some rules out as Optional Rules, to denote the fact that they are not assumed to be in effect unless the GM has chosen to implement them for the campaign. Ideally, optional rules should be implemented at the start of a campaign so that players can make informed choices, though if a GM and group agree that implementing an optional rule mid-campaign is a good idea, there is no reason it cannot work.\n\nHere is a list of optional rules available in L5R.\n\nBonds: Adds rules for developing relationships mechanically (p 136 of Courts of Stone, p. 187 of Path of Waves—note that bonds are assumed to be in effect if using the campaign style presented throughout Path of Waves)\n\nCross-Ring Opportunities: Allows opportunities to be used from adjacent rings at higher cost (p. 298 of the core rulebook)\n\nGrittier Games: Makes weapons deadlier and Bleeding potentially lethal (p. 288 of the core rulebook)\n\nExperienced PCs: Gives newly created characters XP to spend (see p. 305 of the core rulebook)\n\nOne-Roll Duels: Lets duels be decided with a single dice roll per combatant p. 261 of the core rulebook)\n\nRange Bands on a Tactical Grid: Adds rules for using a tactical grid (p. 266 of the core rulebook)\n\nRisky Checks: Adds a risk/reward element to certain checks (p. 9 of this document)\n\nRōnin Honor and Glory: Allows characters to customize their attachment to individual tenets of Bushidō (p. 181 of Path of Waves)\n\nShoddy Improvised Weapons: Causes improvised weapons to break more easily (p. 10 of this document)\n\nSubskills: Adds more granular skill options to represent specialized training (p. 143 of the core rulebook)\n\nTrifling Breaches and Small Sacrifices: Adds more ways to forfeit and earn honor (p. 143 of Shadowlands, p. 135 of Courts of Stone)\n\nUnmasking for Effect: Allows characters to gain a mechanical bonus after unmasking (p. 135 of Courts of Stone)"
        }
    }

        #mW9BysiujxLXAslFqpwS5v ^"Optional Rule Playset: Blood and Consequences" DEF {
        APPLIES TO [#t4bb5a837984a5a2879be0 ^"Game Rules"]
        PROPERTIES {
            ^"Source Document" STRING "L5R5e FAQ August 2020"
            ^"Focus"           STRING "The goal of this playset is facilitate games focused around emotionally driven drama with high personal stakes (though not necessarily high stakes on the scale of Rokugan itself). This playset makes violence extremely deadly but also very quick to resolve, giving characters an incentive to use it judiciously and seek other solutions when possible, and expands social and emotional mechanics to give players more tools to engage with this element of the game. Player characters should be expected to die much more easily with this playset in effect, and so it works well only if the GM and players have \"buy-in\" on the idea that the transience of life is a core theme of the campaign, and creating new characters periodically will be expected."
            ^"Optional Rules Used" LIST [
                "Bonds",
                "Grittier Games",
                "Experienced PCs (+20 starting XP)",
                "One-Roll Duels",
                "Ronin Honor and Glory",
                "Trifling Breaches and Small Sacrifices",
                "Unmasking for Effect"
            ]
        }
        RULES {
            #L5REF56hI7jK9lM1nO3pQ5r: playset_blood_and_consequences "Blood and Consequences: There is vast potential for emotional storytelling that resides in the struggle between the desire for life and the knowledge of death's inevitability. By placing death at the forefront, a story can ask \"why do people live?\" In L5R, this could be found a campaign set around schemes of the Imperial Court, the daily struggles of a group of peasants, or any story in between, so long as its core themes are rooted in the fragile beauty of life and the question of how best to live it.\n\nCampaign Goals\n\nThe goal of this playset is facilitate games focused around emotionally driven drama with high personal stakes (though not necessarily high stakes on the scale of Rokugan itself). This playset makes violence extremely deadly but also very quick to resolve, giving characters an incentive to use it judiciously and seek other solutions when possible, and expands social and emotional mechanics to give players more tools to engage with this element of the game. Player characters should be expected to die much more easily with this playset in effect, and so it works well only if the GM and players have \"buy-in\" on the idea that the transience of life is a core theme of the campaign, and creating new characters periodically will be expected.\n\nOptional Rules Used\n\nBonds, Grittier Games, Experienced PCs (+20 starting XP), One-Roll Duels, Rōnin Honor and Glory, Trifling Breaches and Small Sacrifices, Unmasking for Effect"
        }
    }

        #LUxBEffznw9MBlgVJcYd5M ^"Optional Rule Playset: Courtly Fantasy" DEF {
        APPLIES TO [#t4bb5a837984a5a2879be0 ^"Game Rules"]
        PROPERTIES {
            ^"Source Document" STRING "L5R5e FAQ August 2020"
            ^"Focus"           STRING "This playset endeavors to give the GM and players tools for social roleplaying in a single environment or community."
            ^"Useful Guidance" STRING "While these sections do not strictly constitute an optional rule, the seconds of GM guidance on Assembling a Court in Seven Steps (see p. 139 of Courts of Stone) and Developing NPC Motivations Through Needs (see p. 140 of Courts of Stone) are very useful to setting up this sort of campaign."
            ^"Optional Rules Used" LIST [
                "Bonds",
                "Experienced PCs (+15 starting XP and one starting Bond)",
                "Subskills (Artisan, Social, Trade)",
                "Unmasking for Effect"
            ]
        }
        RULES {
            #L5REF57sT8uV0wX2yZ4aB6c: playset_courtly_fantasy "Courtly Fantasy: Rokugan has room for life-and-death stories, but it also has room for stories of characters living their lives, with a greater emphasis on the day-to-day than any grandiose schemes. Courtly fantasy campaigns could focus on various members of a lord's court or on the inhabitants of a small town in some far-flung province, but whatever its setting, the themes are of community, relationships between individuals, and the ways in which those two can inform one another or conflict.\n\nCampaign Goals\n\nThis playset endeavors to give the GM and players tools for social roleplaying in a single environment or community. While these sections do not strictly constitute an optional rule, the seconds of GM guidance on Assembling a Court in Seven Steps (see p. 139 of Courts of Stone) and Developing NPC Motivations Through Needs (see p. 140 of Courts of Stone) are very useful to setting up this sort of campaign.\n\nOptional Rules Used\n\nBonds, Experienced PCs (+15 starting XP and one starting Bond), Subskills (Artisan, Social, and Trade skills), Unmasking for Effect"
        }
    }

        #RmjKpwCO3g1CzP5ZbhiSMf ^"Optional Rule Playset: Heroic Action" DEF {
        APPLIES TO [#t4bb5a837984a5a2879be0 ^"Game Rules"]
        PROPERTIES {
            ^"Source Document" STRING "L5R5e FAQ August 2020"
            ^"Focus"           STRING "The goal of this playset is to empower players to take exciting, creative actions and reward them for doing so. This does not apply only to combat, but also to other types of encounters, for which it provides players have a wide number of additional tools at their disposal to cleverly solve problems and vanquish their nefarious foes."
            ^"Optional Rules Used" LIST [
                "Bonds",
                "Cross-Ring Opportunities",
                "Experienced PCs (+20 starting XP)",
                "Range Bands on a Tactical Grid",
                "Risky Checks",
                "Shoddy Improvised Weapons",
                "Unmasking for Effect"
            ]
        }
        RULES {
            #L5REF58dE9fG1hI3jK5lM7n: playset_heroic_action "Heroic Action: Rokugan is a setting defined by choice and consequence, but that does not mean that there is no room in it for stories of daring feats, grand gestures, and heroes who save the day.\n\nCampaign Goals\n\nThe goal of this playset is to empower players to take exciting, creative actions and reward them for doing so. This does not apply only to combat, but also to other types of encounters, for which it provides players have a wide number of additional tools at their disposal to cleverly solve problems and vanquish their nefarious foes.\n\nOptional Rules Used\n\nBonds, Cross-Ring Opportunities, Experienced PCs (+20 starting XP), Range Bands on a Tactical Grid, Risky Checks, Shoddier Improvised Weapons, Unmasking for Effect"
        }
    }

        #jSzImS0FsgfY5eMmKRVJwQ ^"Optional Rule Playset: Intrigue and Mediation" DEF {
        APPLIES TO [#t4bb5a837984a5a2879be0 ^"Game Rules"]
        PROPERTIES {
            ^"Source Document" STRING "L5R5e FAQ August 2020"
            ^"Focus"           STRING "The goal of this playset is to equip the GM and players to face complex problems with flexible tools, and grapple with questions of personal and societal morality as people. The interests of one group may appear to conflict with those of another, and the PCs might face hard choices, or need to find compromises. The PCs are assumed to be characters who have some sway in society, but they still cannot solve every problem they encounter through force of personality or arms alone—cleverness, creative thinking, and empathy are also needed."
            ^"Optional Rules Used" LIST [
                "Bonds",
                "Cross-Ring Opportunities",
                "Experienced PCs (+30 starting XP and the Emerald Magistrate [p. 305 of the core rulebook] or Clan Magistrate [p. 249 of Emerald Empire] title, or other suitable title for an attendant of one of these individuals)",
                "Grittier Games",
                "Risky Checks",
                "Ronin Honor and Glory",
                "Shoddy Improvised Weapons",
                "Trifling Breaches and Small Sacrifices",
                "Unmasking for Effect"
            ]
        }
        RULES {
            #L5REF59oP0qR2sT4uV6wX8y: playset_intrigue_and_mediation "Intrigue and Mediation: Many players of L5R enjoy games where all of the PCs are assumed to be ambassadors, mediators, or peacekeepers, working together to keep the people of their community safe by understanding the threats to it and finding ways to defuse them. Communities in Rokugan face challenges social, political, spiritual, economic, and supernatural, and PCs in this campaign style must help their community navigate these problems.\n\nCampaign Goals\n\nThe goal of this playset is to equip the GM and players to face complex problems with flexible tools, and grapple with questions of personal and societal morality as people. The interests of one group may appear to conflict with those of another, and the PCs might face hard choices, or need to find compromises. The PCs are assumed to be characters who have some sway in society, but they still cannot solve every problem they encounter through force of personality or arms alone—cleverness, creative thinking, and empathy are also needed.\n\nOptional Rules Used\n\nBonds, Cross-Ring Opportunities, Experienced PCs (+30 starting XP and the Emerald Magistrate [p. 305 of the core rulebook] or Clan Magistrate [p. 249 of Emerald Empire] title, or other suitable title for an attendant of one of these individuals), Grittier Games, Risky Checks, Rōnin Honor and Glory, Shoddier Improvised Weapons, Trifling Breaches and Small Sacrifices, Unmasking for Effect"
        }
    }

        #mCGVJGna8vKde5RKThJ0qj ^"Optional Rule Playset: Politics of Power" DEF {
        APPLIES TO [#t4bb5a837984a5a2879be0 ^"Game Rules"]
        PROPERTIES {
            ^"Source Document" STRING "L5R5e FAQ August 2020"
            ^"Focus"           STRING "The goal of this playset it to make characters who have substantial personal power from the outset, both in their extra XP and in the wide array of tools they have available. However, it also pursues the nuances of problems such individuals face with subskills, as well as reinforcing the perils faced by those who occupy the heights of power."
            ^"Optional Rules Used" LIST [
                "Bonds",
                "Cross-Ring Opportunities",
                "Experienced PCs (+50 starting XP and the Daimyō [p. 250 of Emerald Empire] or other suitable title)",
                "One-Roll Duels",
                "Risky Checks",
                "Subskills (Scholar and Social)",
                "Unmasking for Effect"
            ]
        }
        RULES {
            #L5REF60zA1bC3dE5fG7hI9j: playset_politics_of_power "Politics of Power: In Rokugan, samurai are atop the social hierarchy—and this campaign style asks players and GMs to explore what people with the ability with that power, and why. The PCs are assumed to be rulers of their domain, and grapple not just with questions of what they can accomplish, but what they should accomplish.\n\nCampaign Goals\n\nThe goal of this playset it to make characters who have substantial personal power from the outset, both in their extra XP and in the wide array of tools they have available. However, it also pursues the nuances of problems such individuals face with subskills, as well as reinforcing the perils faced by those who occupy the heights of power.\n\nOptional Rules Used\n\nBonds, Cross-Ring Opportunities, Experienced PCs (+50 starting XP and the Daimyō [p. 250 of Emerald Empire] or other suitable title), One-Roll Duels, Risky Checks, Subskills (Scholar and Social skills), Unmasking for Effect"
        }
    }

        #Q0yVCpwEqEZZBL06ORcMqV ^"Optional Rule Playset: Tactical Engagement" DEF {
        APPLIES TO [#t4bb5a837984a5a2879be0 ^"Game Rules"]
        PROPERTIES {
            ^"Source Document" STRING "L5R5e FAQ August 2020"
            ^"Focus"           STRING "This playset is meant to put the focus of the game on combat, maximizing the potential of the game as a team-based tactical exercise and encouraging collaborative play."
            ^"Optional Rules Used" LIST [
                "Experienced PCs (+30 starting XP)",
                "Range Bands on a Tactical Grid",
                "Shoddy Improvised Weapons"
            ]
        }
        RULES {
            #L5REF61kL2mN4oP6qR8sT0u: playset_tactical_engagement "Tactical Engagement: Sometimes, you just want to get together with your friends battle it out against the foes of Rokugan. Whether the store plunges into a war between the Great Clans, takes place on a bold venture into the Shadowlands, or concerns exploring ancient ruins in the Shinomen Forest, there are many places such a campaign could occur in Rokugan.\n\nCampaign Goals\n\nThis playset is meant to put the focus of the game on combat, maximizing the potential of the game as a team-based tactical exercise and encouraging collaborative play.\n\nOptional Rules Used\n\nExperienced PCs (+30 starting XP), Range Bands on a Tactical Grid, Shoddier Improvised Weapons"
        }
    }

        #65a1SIrc3IrWF1FolUZoDo ^"Optional Rule: Risky Checks" DEF {
        APPLIES TO [#t4bb5a837984a5a2879be0 ^"Game Rules"]
        PROPERTIES {
            ^"Source Document"     STRING "L5R5e FAQ August 2020"
            ^"Source Page"         STRING "p. 9"
            ^"Rule Type"           STRING "Optional Rule" FIXED
            ^"Recommended For"     STRING "Risky checks work best for campaigns that tend toward the dramatic, where heroic action or large swings in fortune are desirable."
            ^"Description"         STRING "Sometimes, a character's narrative circumstances don't make a task easier or harder per se, but might allow them to get more out of succeeding (or suffer worse consequences for failure). These can be reflected with RISKY CHECKS, which add extra bonus successes or shortfall to a check based on its outcome.\n\nThe RISK LEVEL of a risky check is the number of additional bonus successes a character receives for succeeding, or the additional shortfall they suffer for failing. The default risk level for a check is 0."
            ^"Procedure"           STRING "The GM announce should announce that a check is risky along with the TN, before a player rolls dice. This announcement should also include the risk level of the check. The player should be allowed to reconsider and propose another path if they think their character wouldn't take the risk.\n\nAfter success or failure is determined, if the character succeeds, add a number of bonus successes equal to the risk level. However, if the character failed, add that amount to the shortfall instead."
        }
        RISK_LEVELS {
            ^"+1" STRING "Charging an enemy down a steep incline\n\nFlirting with someone of higher status rank\n\nTrying to outfox an opponent you know very personally"
            ^"+2" STRING "Tackling an enemy by leaping onto them from the rafters\n\nSpeaking openly about your emotions in front of someone of higher status rank\n\nUsing an experimental or unconventional technique for an art piece"
            ^"+3" STRING "Jumping out a second story window to land in a bale of hay below\n\nObliquely bring up the personal failure of someone of higher status rank\n\nEschewing conventional wisdom on a matter of etiquette or artistry"
        }
        RULES {
            #L5REF62vW3xY5zA7bC9dE1f: optional_risky_checks_mechanic "Risky Checks: Sometimes, a character's narrative circumstances don't make a task easier or harder per se, but might allow them to get more out of succeeding (or suffer worse consequences for failure). These can be reflected with RISKY CHECKS, which add extra bonus successes or shortfall to a check based on its outcome.\n\nThe RISK LEVEL of a risky check is the number of additional bonus successes a character receives for succeeding, or the additional shortfall they suffer for failing. The default risk level for a check is 0.\n\nHow to Use This Rule\n\nThe GM announce should announce that a check is risky along with the TN, before a player rolls dice. This announcement should also include the risk level of the check. The player should be allowed to reconsider and propose another path if they think their character wouldn't take the risk.\n\nAfter success or failure is determined, if the character succeeds, add a number of bonus successes equal to the risk level. However, if the character failed, add that amount to the shortfall instead.\n\nWhen to Implement This Rule\n\nRisky checks work best for campaigns that tend toward the dramatic, where heroic action or large swings in fortune are desirable. Because a check being risky does not affect the TN, characters are more incentivized to attempt these checks than they would be to simply attempt checks with a higher TN, where the higher risk of shortfall is necessarily accompanied by a higher up-front chance of failure. Further, a character is actually rewarded for succeeding on a risky check, creating an even greater incentive to attempt daring feats."
            #L5REF63gH4iJ6kL8mN0oP2q: optional_risky_checks_examples "Table 1–3: Risky Check Examples: +1 bonus success/shortfall\n\nCharging an enemy down a steep incline\n\nFlirting with someone of higher status rank\n\nTrying to outfox an opponent you know very personally\n\n+2 bonus success/shortfall\n\nTackling an enemy by leaping onto them from the rafters\n\nSpeaking openly about your emotions in front of someone of higher status rank\n\nUsing an experimental or unconventional technique for an art piece\n\n+3 bonus success/shortfall\n\nJumping out a second story window to land in a bale of hay below\n\nObliquely bring up the personal failure of someone of higher status rank\n\nEschewing conventional wisdom on a matter of etiquette or artistry"
        }
    }

        #FItivzmQ38sTIoxtgu4G3R ^"Optional Rule: Shoddy Improvised Weapons" DEF {
        APPLIES TO [#t4bb5a837984a5a2879be0 ^"Game Rules"]
        PROPERTIES {
            ^"Source Document"     STRING "L5R5e FAQ August 2020"
            ^"Source Page"         STRING "p. 10"
            ^"Rule Type"           STRING "Optional Rule" FIXED
            ^"Recommended For"     STRING "This rule is good for campaigns where the GM wants the players to feel the value of their weapons and unarmed attacks, as these will not fail them."
            ^"Description"         STRING "Improvised weapons are generally less durable than forged steel or lacquered wood. As such, this rule reflects their more transient nature, and their inconvenient tendency to break when wielded.\n\nIf implemented, this applies to the improvised weapons described on page 230 of the core rulebook, the ones included with full profiles in Path of Waves, but not the ones created with the Improvised Assault technique (see page 87 of Path of Waves), which are automatically destroyed at the end of the scene already."
            ^"Procedure"           STRING "After a character performs an Attack action check using an improvised weapon, it gains the Damaged quality, or if it is already Damaged, gains the Destroyed quality instead.\n\nA character may spend (op)+ from their Attack action check to handle the improvised weapon especially carefully, preventing it from becoming Damaged as a result of this rule. The (op) spent must be greater than or equal to the number of Attack action checks performed with the improvised weapon this scene."
        }
        RULES {
            #L5REF64rS5tU7vW9xY1zA3b: optional_shoddy_improvised_weapons_mechanic "Shoddy Improvised Weapons: Improvised weapons are generally less durable than forged steel or lacquered wood. As such, this rule reflects their more transient nature, and their inconvenient tendency to break when wielded.\n\nIf implemented, this applies to the improvised weapons described on page 230 of the core rulebook, the ones included with full profiles in Path of Waves, but not the ones created with the Improvised Assault technique (see page 87 of Path of Waves), which are automatically destroyed at the end of the scene already.\n\nHow to Use This Rule\n\nAfter a character performs an Attack action check using an improvised weapon, it gains the Damaged quality, or if it is already Damaged, gains the Destroyed quality instead.\n\nA character may spend (op)+ from their Attack action check to handle the improvised weapon especially carefully, preventing it from becoming Damaged as a result of this rule. The (op) spent must be greater than or equal to the number of Attack action checks performed with the improvised weapon this scene.\n\nWhen to Implement This Rule\n\nAdding destructibility to improvised weapons keeps them a tempting option as a quick fix, but makes them less appealing than a proper weapon over the long run. This rule is good for campaigns where the GM wants the players to feel the value of their weapons and unarmed attacks, as these will not fail them. It is also good for campaigns in which the players and/or GM enjoy breaking things."
        }
    }

        #zqwcH3IsOnOjiKaHzGLyoV ^"Treasure Hunter (Alternate) School" DEF {
        EXTENDS #L5RPW40nO5pQ7rS9tU1vW3x ^"Treasure Hunter"

        PROPERTIES {
            ^"School Name" STRING "Treasure Hunter (Alternate)" FIXED
            ^"Replaces"    STRING "Risk and Reward school ability"
            ^"Requires"    STRING "Risky Checks optional rule"
        }

        SCHOOL_ABILITY "Fortune and Folly" {
            "When you succeed at a risky check or a check to which one of your disadvantages applies, you may add a number of bonus successes up to your school rank."
        }

        RULES {
            #L5REF65cD6eF8gH0iJ2kL4m: alternate_treasure_hunter_school_ability "Alternate School Ability (Treasure Hunter): For campaigns using the rules for Risky Checks, GMs may wish to have the Treasure Hunter school (see p. 50 of Path of Waves) use this alternate school ability, which replaces the printed Risk and Reward school ability:"
        }
    }

    MODIFY #L5R444improvisedweapons01 ^"Improvised Weapons" {
        GUIDANCE {
            ENTRY ^"errata-improvised-weapons-margin-note" #L5RERGimprvwpn2020aaaa {
                CONCERNS [ #L5R444improvisedweapons01 ^"Improvised Weapons" ]
                TOPICS [ "errata" ]
                TEXT "p. 230: The following margin note should be added: An improvised weapon uses the most similar weapon profile (often a club or a knife), with DMG and DLS reduced by 1, or more at the GM's discretion. They are wielded with Martial Arts [Unarmed]."
            }
        }
    }

}
