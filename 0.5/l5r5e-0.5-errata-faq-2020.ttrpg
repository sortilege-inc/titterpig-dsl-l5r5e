                TEXT "p. 65, Kakita Duelist (Rank 1): \"Iaijutsu Cut: Crossing Cut\" should read \"Iaijutsu Cut: Crossing Blade.\""
            }
        }
    }

    MODIFY #t4b65729b8e2562616aa3e ^"Asako Loremaster" {
        CURRICULUM {
            RANK 2 {
                SKILL_GROUP "Social Skills"
                SKILL "Government"
                SKILL "Medicine"
                SKILL "Sentiment"
                TECHNIQUE_GROUP "Rank 1-2 Air Shūji"
                ^"All Arts are One" [shuji]
                ^"Tea Ceremony" [ritual]
            }
        }
        SCHOOL_ABILITY "Wisdom of the Ages" {
            "When performing a Scholar skill check, you may treat your ranks in the skill as being equal to your school rank. If your ranks in that Scholar skill are equal to or higher than your school rank, or if you have 5 ranks in the skill, you may add one kept (ring) set to an (op) result instead."
        }

        GUIDANCE {
            ENTRY ^"errata-asako-loremaster-0" #L5RERGXM3qKKKFNReBGW07 {
                CONCERNS [ #t4b65729b8e2562616aa3e ^"Asako Loremaster" ]
                TOPICS [ "errata" ]
                TEXT "p. 65–85, Curriculum Tables: A number of technique entries are redundant, and should be replaced as follows:\n\np. 74, Asako Loremaster (Rank 2): Replace Civility Foremost (shuji) with Tea Ceremony (ritual)"
            }
            ENTRY ^"errata-asako-loremaster-1" #L5RERGNIJOHelWSMlrD7GI {
                CONCERNS [ #t4b65729b8e2562616aa3e ^"Asako Loremaster" ]
                TOPICS [ "errata" ]
                TEXT "p. 74, Asako Loremaster, School Ability: The first sentence should read: \"...you may treat your ranks in the skill as being equal to your school rank.\""
            }
        }
    }

