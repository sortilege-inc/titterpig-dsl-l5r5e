# .codex SECTION — The Scroll or the Blade (adventure). Stand-off graph over
# l5r5e-0.5-scroll-or-blade.lore (spec §25). Part of the L5R5e system graph;
# DEPENDS_ON the shared schema.
#
# The 9 cast NPCs (cast.ttrpg) are DEFs — referenced via ^"...", never minted.
# Kyūden Doji, the Perfect Land Sect, Kakita Ryoku, and the Deer Clan are already
# in the graph (referenced; Kyūden Doji and Kakita Ryoku amended). The family DEFs
# (Kitsuki, Shiba, Miya, Kakita) are referenced. Winter's Embrace cameo NPCs
# (Ikoma Rumiko, Susano-O no Izen, Doji Hatsuhina, Asahina Takako, Otomo
# Koryusai) belong to that adventure and are not minted here. This section mints
# the adventure's village, the Fortune Yamakaze, the Hinokami Prophecy, and its
# lore-only figures.

CODEX "L5R5e_ScrollOrBlade_Codex" {
    NAME "The Scroll or the Blade — Lore Graph"
    VERSION "0.5.2"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-09-03"
    FOR EDITION "l5r5e"
    DEPENDS_ON "L5R5e_Codex_Schema" VERSION "0.5.9"

    # ---- Place & Fortune --------------------------------------------------
    ENTITY #L5RcxSoB01chisanru ^"Chisanrū" {
        IS ^"Village"
        SOURCE "l5r5e-0.5-scroll-or-blade.lore" AT "storyline-background"
        RELATIONSHIPS { ^"dedicated-to" -> ^"Yamakaze" }
    }
    ENTITY #L5RcxSoB02yamakaze ^"Yamakaze" {
        IS ^"Fortune"
        SOURCE "l5r5e-0.5-scroll-or-blade.lore" AT "masayo-orphaned-child"
        RELATIONSHIPS { ^"companion-of" -> ^"Masayo" FROM "The Fortune has become tied to Masayo and the bond is so strong that Masayo may not even be aware of what invokes Yamakaze." }
    }
    ENTITY #L5RcxSoB03hinokami ^"Hinokami Prophecy" {
        IS ^"Document"
        SOURCE "l5r5e-0.5-scroll-or-blade.lore" AT "crane"
    }

    # ---- Lore-only figures -------------------------------------------------
    ENTITY #L5RcxSoB04miyasatoshi ^"Miya Satoshi" {
        IS ^"Person"
        SOURCE "l5r5e-0.5-scroll-or-blade.lore" AT "storyline-background"
        RELATIONSHIPS { ^"member-of" -> ^"Miya" FROM "Due in Winter Court in less than a few weeks, and realizing that calling an Emerald Magistrate would extend his stay, he decided instead to ride south with Masayo to seek the assistance of his daimyō, Miya Satoshi." }
    }
    ENTITY #L5RcxSoB05kitsukitaiki ^"Kitsuki Taiki" {
        IS ^"Person"
        SOURCE "l5r5e-0.5-scroll-or-blade.lore" AT "storyline-background"
        RELATIONSHIPS {
            ^"member-of"  -> ^"Kitsuki"     FROM "Years after its establishment, the village became the secret rendezvous location for two samurai; Kitsuki Taiki, a Dragon warrior, and Shiba Miku, a Phoenix shugenja."
            ^"married-to" -> ^"Shiba Miku"  FROM "Years after its establishment, the village became the secret rendezvous location for two samurai; Kitsuki Taiki, a Dragon warrior, and Shiba Miku, a Phoenix shugenja." }
    }
    ENTITY #L5RcxSoB06shibamiku ^"Shiba Miku" {
        IS ^"Person"
        SOURCE "l5r5e-0.5-scroll-or-blade.lore" AT "storyline-background"
        RELATIONSHIPS {
            ^"member-of"  -> ^"Shiba"          FROM "Years after its establishment, the village became the secret rendezvous location for two samurai; Kitsuki Taiki, a Dragon warrior, and Shiba Miku, a Phoenix shugenja."
            ^"married-to" -> ^"Kitsuki Taiki"  FROM "Kitsuki Taiki, a Dragon warrior, and Shiba Miku, a Phoenix shugenja"
            ^"sibling-of" -> ^"Isawa Yoshiko"  FROM "Yoshiko realized that Miku must be her half sister, and Masayo is her niece by blood" }
    }
    ENTITY #L5RcxSoB07bunjihanae ^"Hanae" {
        IS ^"Person"
        SOURCE "l5r5e-0.5-scroll-or-blade.lore" AT "miya-bunji-imperial-cartographer"
        RELATIONSHIPS { ^"married-to" -> ^"Miya Bunji" FROM "his wife Hanae and his daughter Nanako were lost to a tsunami that crushed the northern coast of the Crane Lands" }
    }
    ENTITY #L5RcxSoB08bunjinanako ^"Nanako" {
        IS ^"Person"
        SOURCE "l5r5e-0.5-scroll-or-blade.lore" AT "miya-bunji-imperial-cartographer"
        RELATIONSHIPS { ^"child-of" -> ^"Miya Bunji" FROM "his wife Hanae and his daughter Nanako were lost to a tsunami" }
    }

    # ---- Amendments to entities already in the graph ----------------------
    ENTITY #1ZLZHjeL9eEQIlBN0fAwXE ^"Kyūden Doji" {
        SOURCE "l5r5e-0.5-scroll-or-blade.lore" AT "mantis"
        RELATIONSHIPS { ^"seat-of" -> ^"Crane Clan" FROM "The Esteemed Palaces of the Crane, also known as Kyūden Doji, stands atop the white cliffs on the eastern shore of Rokugan." }
    }
    ENTITY #U6fdUjHS8oPogT8YVZOBns ^"Kakita Ryoku" {
        SOURCE "l5r5e-0.5-scroll-or-blade.lore" AT "scorpion"
        RELATIONSHIPS { ^"ally-of" -> ^"Shika Yuki" FROM "Shika Yuki recently approached Kakita Ryoku, a powerful Crane courtier, who plays a major role in Winter’s Embrace, regarding Miya Bunji’s dilemma." }
    }
}
