# L5R 5E — In the Palace of the Emerald Champion: Dramatis Personae (cast NPCs)
# The L5R Beginner Game adventure "In the Palace of the Emerald Champion" (FFG).
# These are Beginner Game *simplified* NPC profiles: they carry rings, derived
# attributes (Endurance/Composure/Focus/Vigilance), honor/glory/status, skill
# GROUP ranks (Artisan/Martial/Scholar/Social/Trade), favored weapons & gear, and
# "NPC ABILITY" blocks — but no Conflict Ranks and no Advantages/Disadvantages,
# which the simplified format omits. Every statblock value and ability text below
# is transcribed VERBATIM from the printed profile pages (read as page images).
# Doji Satsume appears only as a narrative ghost (no combat statblock) and lives
# in the .lore / .codex, as do the non-statblocked suspects Hiruma Shigeki and
# the peasant Sō. The seven pregens are in l5r5e-0.5-emerald-champion-pregens.actor.

EXTENSION "L5R5e_EmeraldChampion_Cast" {
    VERSION "0.5.4"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-09-03"
    DEPENDS_ON "L5R5e_Core_Core"

    # ═══════════════════════ ACT I — THE JOURNEY ═══════════════════════════

    #s7gusTIxD30b5PmmAaqv24 ^"Ryu" DEF {
        EXTENDS #t4540de6f35155c46f41f0 ^"NPC"
        PROPERTIES {
            ^"Type" STRING "Adversary" FIXED
            ^"Rings" DEF { ^"Air" INTEGER 1 ^"Earth" INTEGER 2 ^"Fire" INTEGER 2 ^"Water" INTEGER 2 ^"Void" INTEGER 1 }
            ^"Demeanor" STRING "Shrewd"
            ^"Endurance" INTEGER 4
            ^"Composure" INTEGER 4
            ^"Focus" INTEGER 3
            ^"Vigilance" INTEGER 2
            ^"Honor" INTEGER 20
            ^"Glory" INTEGER 25
            ^"Status" INTEGER 15
            ^"Skills" LIST OF STRING ["Artisan 0", "Martial 0", "Scholar 0", "Social 1", "Trade 2"]
            ^"Favored Weapons" LIST OF STRING ["Walking Stick: Damage 2; Range 1–2"]
            ^"Gear" LIST OF STRING ["Peasant garb, cart and pony, meager handful of zeni"]
        }
        DESCRIPTION "Beginner Game simplified profile. Ryu, Peasant Servant — the PCs' cart-driver and road guide."
        #yNAmdEgDErla84oRw1kfSX ^"Knows the Road" DEF { ^"Effect" STRING "Ryu has made the trek between the Emerald Champion's castle and Tsuma many times over his life. Should the PCs treat him well, he can offer the best spots to rest at the end while on the road. This allows each PC to remove one additional strife when removing strife at the end of each scene." }

        RULES {
            #riIFyxWKGjxoP43mEynN1Y: background "Ryu has grew up in Tsuma, but has lived most of his adult life at Shiro Yogasha in service to the Emerald Champion. He has been spending most of his time recently transporting items belonging to his late master from the castle, often to Tsuma where he met the PCs outside of the town. He remembers them well, either fondly or with apprehension depending on how things went."
        }
    }

    #t2496c476c54913e2fde85 ^"Goro the Bandit Leader" DEF {
        EXTENDS #t4540de6f35155c46f41f0 ^"NPC"
        PROPERTIES {
            ^"Type" STRING "Adversary" FIXED
            ^"Rings" DEF { ^"Air" INTEGER 2 ^"Earth" INTEGER 3 ^"Fire" INTEGER 3 ^"Water" INTEGER 3 ^"Void" INTEGER 1 }
            ^"Demeanor" STRING "Ambitious"
            ^"Endurance" INTEGER 9
            ^"Composure" INTEGER 8
            ^"Focus" INTEGER 6
            ^"Vigilance" INTEGER 3
            ^"Honor" INTEGER 10
            ^"Glory" INTEGER 15
            ^"Status" INTEGER 3
            ^"Skills" LIST OF STRING ["Artisan 0", "Martial 2", "Scholar 0", "Social 1", "Trade 1"]
            ^"Favored Weapons" LIST OF STRING ["Rusted Katana: Damage 4; Range 1"]
            ^"Gear" LIST OF STRING ["Thick traveling clothes, sake jug (full), knife, handful of bu"]
        }
        DESCRIPTION "Beginner Game simplified profile. Goro the Bandit Leader."
        REFERENCES {
            "Goro the Bandit Leader" -> #t2496c476c54913e2fde85 ^"Goro the Bandit Leader"
        }
        #hYTbYFkJFC4ot05Fn0CDxY ^"...Get Them, Fools!" DEF { ^"Effect" STRING "As an action, Goro may have up to two of his bandits who have not yet acted this round immediately move 1 range band and perform a Strike action." }

        RULES {
            #LTXzKnYfVdWytum0o26afb: background "Goro became leader of this bandit group through cunning and guile. He specializes in targeting travelers on isolated roads, his scouts identifying easy targets in advance. Sometimes, though, he accepts tougher assignments if there is enough koku involved."
        }
    }

    #sfP0Q7pQbQQULUyVb4acNK ^"Bandits" DEF {
        EXTENDS #t4540de6f35155c46f41f0 ^"NPC"
        PROPERTIES {
            ^"Type" STRING "Minion" FIXED
            ^"Rings" DEF { ^"Air" INTEGER 1 ^"Earth" INTEGER 2 ^"Fire" INTEGER 2 ^"Water" INTEGER 2 ^"Void" INTEGER 1 }
            ^"Demeanor" STRING "Intimidating"
            ^"Endurance" INTEGER 5
            ^"Composure" INTEGER 6
            ^"Focus" INTEGER 4
            ^"Vigilance" INTEGER 2
            ^"Honor" INTEGER 15
            ^"Glory" INTEGER 20
            ^"Status" INTEGER 1
            ^"Skills" LIST OF STRING ["Artisan 0", "Martial 1", "Scholar 0", "Social 1", "Trade 0"]
            ^"Favored Weapons" LIST OF STRING ["Yari (Spear): Damage 5; Range 2"]
            ^"Gear" LIST OF STRING ["Grimy traveling clothes, sake jug (empty)"]
        }
        DESCRIPTION "Beginner Game simplified profile. Minion — Goro's bandits."
        #9gBucUDIKxf1URdjjUTlgG ^"Hit Them While They're Down" DEF { ^"Effect" STRING "When one of Goro's bandits performs an Attack action against a target suffering from one or more critical strikes, increase any damage dealt by 2." }

        RULES {
            #PVIIcUvgw9esWkQm1HCzf7: background "Bandits like these are outlaws who thrive in the rural and remote regions of Rokugan. Goro was once one of them before eliminating the previous leader and taking her place."
        }
    }

    #Z2M3KpXbNN5SQFuJ1gl9RX ^"Airi the Tengu" DEF {
        EXTENDS #t4540de6f35155c46f41f0 ^"NPC"
        PROPERTIES {
            ^"Type" STRING "Adversary" FIXED
            ^"Rings" DEF { ^"Air" INTEGER 4 ^"Earth" INTEGER 2 ^"Fire" INTEGER 3 ^"Water" INTEGER 3 ^"Void" INTEGER 4 }
            ^"Demeanor" STRING "Detached"
            ^"Endurance" INTEGER 8
            ^"Composure" INTEGER 16
            ^"Focus" INTEGER 3
            ^"Vigilance" INTEGER 2
            ^"Honor" INTEGER 80
            ^"Glory" INTEGER 64
            ^"Status" INTEGER 30
            ^"Skills" LIST OF STRING ["Artisan 0", "Martial 3", "Scholar 2", "Social 2", "Trade 1"]
            ^"Favored Weapons" LIST OF STRING ["Ancient Katana: Damage 5; Range 1"]
            ^"Gear" LIST OF STRING ["Impressive robes (Resistance 2)"]
        }
        DESCRIPTION "Beginner Game simplified profile. The Mysterious Stranger — an ancient tengu sword-master."
        #2TSTgFyi2LC1auOUQe1vui ^"Master of Illusion" DEF { ^"Effect" STRING "Once per scene as a Support action, Airi can use her illusion powers to appear human or become invisible until the end of the scene. A character must make a TN 4 Theology (Void) or Survival (Void) check to detect her while she is invisible." }
        #DwYobXC9C2pd7lTciU9mvf ^"Flight" DEF { ^"Effect" STRING "While in her winged form, Airi may also move via flight vertically and ignore the negative effects of terrain." }
        #rOP98PuXX5WG8mCSXAmC4B ^"Void Points" DEF { ^"Effect" STRING "Airi has 2 Void points which can be used per the normal rules for spending Void points." }
    }

    #nHc6LNpbEQg7StnIvyXfal ^"Goblins" DEF {
        EXTENDS #t4540de6f35155c46f41f0 ^"NPC"
        PROPERTIES {
            ^"Type" STRING "Minion" FIXED
            ^"Rings" DEF { ^"Air" INTEGER 1 ^"Earth" INTEGER 2 ^"Fire" INTEGER 2 ^"Water" INTEGER 2 ^"Void" INTEGER 1 }
            ^"Demeanor" STRING "Shrewd"
            ^"Endurance" INTEGER 5
            ^"Composure" INTEGER 6
            ^"Focus" INTEGER 4
            ^"Vigilance" INTEGER 2
            ^"Honor" INTEGER 0
            ^"Glory" INTEGER 9
            ^"Status" INTEGER 0
            ^"Skills" LIST OF STRING ["Artisan 0", "Martial 1", "Scholar 0", "Social 1", "Trade 0"]
            ^"Favored Weapons" LIST OF STRING ["Goblin-sized Scavenged Yari (Spear): Damage 4; Range 1", "Goblin-sized Scavenged Yumi (Bow): Damage 4; Range 1–4"]
            ^"Gear" LIST OF STRING ["Salvaged armor (Resistance 1)"]
        }
        DESCRIPTION "The PCs should be worried and mystified about why the goblins are there, so far north of the Wall and not even in a mountainous region (a successful TN 1 Culture (Fire) check lets them know that this is unusual). With a successful TN 1 Theology (Void) check, shugenja and monk characters can detect that the kami are disturbed, which indicates that some vile magic may have been done in that area, perhaps to lure the creatures to the spot."
        #ImSLgtgk12zt1flFufdSSH ^"Small" DEF { ^"Effect" STRING "Goblins are Silhouette 1." }
        #Gqqh945oz94JMpbCaa7bvF ^"Surefooted" DEF { ^"Effect" STRING "Goblins ignore the negative effects of terrain." }

        RULES {
            #SZfi3x9fewOJfUZiBe8Iv0: background "Goblins infest much of Rokugan's mountains and wilderness areas. They are much more common in the Shadowlands, however, and seeing any along a well-traveled road may be cause for alarm."
        }
    }

    #t2059f22528a6b112ed0f4 ^"Teru the Ogre" DEF {
        EXTENDS #t4540de6f35155c46f41f0 ^"NPC"
        PROPERTIES {
            ^"Type" STRING "Adversary" FIXED
            ^"Rings" DEF { ^"Air" INTEGER 1 ^"Earth" INTEGER 3 ^"Fire" INTEGER 3 ^"Water" INTEGER 2 ^"Void" INTEGER 1 }
            ^"Demeanor" STRING "Gruff"
            ^"Endurance" INTEGER 16
            ^"Composure" INTEGER 8
            ^"Focus" INTEGER 4
            ^"Vigilance" INTEGER 2
            ^"Honor" INTEGER 0
            ^"Glory" INTEGER 5
            ^"Status" INTEGER 0
            ^"Skills" LIST OF STRING ["Artisan 0", "Martial 3", "Scholar 0", "Social 0", "Trade 1"]
            ^"Favored Weapons" LIST OF STRING ["Giant club or Tree Branch: Damage 7; Range 2"]
            ^"Gear" LIST OF STRING ["Tattered hides (Resistance 1)"]
        }
        DESCRIPTION "Wounded: Teru is currently suffering from 8 fatigue."
        REFERENCES {
            "Teru" -> #t2059f22528a6b112ed0f4 ^"Teru the Ogre"
        }
        #YAbINuJHHhN72Rw7IDMhzD ^"Crushing Blow" DEF { ^"Effect" STRING "Whenever Teru inflicts a critical strike, the target suffers the Prone condition as well as any other conditions from the critical strike. While prone, a character cannot move more than one range band during their turn (probably by crawling). At the end of their turn, if the character did not perform a Movement action, they may choose to remove the Prone condition (by standing up)." }
        #xxsJrXA3wsPJs0CyCRii40 ^"Rage of the Beast" DEF { ^"Effect" STRING "Once per scene, after Teru suffers a critical strike, it becomes Enraged (increasing the damage it both inflicts and suffers by 2) until its critical strikes are removed." }
        #Bx8aWFLzFNspshNYxSQim2 ^"Huge" DEF { ^"Effect" STRING "Ogres are Silhouette 4." }

        RULES {
            #sXK2omT8xl5jzm2raW5nXx: background "Ogres are huge, violent creatures, and Teru is no exception. It dimly remembers its home in the Shadowlands, but is now in these greener regions with no memory of how it got here. Along with a small horde of goblins, Teru has been thriving in mountain passes and remote trails, where it can prey on passersby but also raid small villages when their hunger grows too strong."
        }
    }

    # ═══════════════════════ ACT II & III — SHIRO YOGASHA ══════════════════

    #ta5848f6e8bb7d252e50e1 ^"Agasha Sumiko" DEF {
        EXTENDS #t4540de6f35155c46f41f0 ^"NPC"
        PROPERTIES {
            ^"Type" STRING "Adversary" FIXED
            ^"Rings" DEF { ^"Air" INTEGER 3 ^"Earth" INTEGER 4 ^"Fire" INTEGER 2 ^"Water" INTEGER 4 ^"Void" INTEGER 3 }
            ^"Demeanor" STRING "Shrewd"
            ^"Endurance" INTEGER 12
            ^"Composure" INTEGER 14
            ^"Focus" INTEGER 6
            ^"Vigilance" INTEGER 4
            ^"Honor" INTEGER 70
            ^"Glory" INTEGER 66
            ^"Status" INTEGER 80
            ^"Skills" LIST OF STRING ["Artisan 2", "Martial 4", "Scholar 3", "Social 3", "Trade 1"]
            ^"Favored Weapons" LIST OF STRING ["Ruby Champion's Katana: Damage 6; Range 1"]
            ^"Gear" LIST OF STRING ["Daishō, Ruby Champion's Armor (Resistance [4]), scrolls"]
        }
        DESCRIPTION "Beginner Game simplified profile. Agasha Sumiko, Ruby Champion and Acting Emerald Champion at Shiro Yogasha."
        REFERENCES {
            "Agasha Sumiko" -> #ta5848f6e8bb7d252e50e1 ^"Agasha Sumiko"
        }
        #lQCF3q9fIoRQI22jKwAQNx ^"Expert in the Dōjō" DEF { ^"Effect" STRING "Though she rarely displays it now, Sumiko is an expert at both employing and teaching Martial Arts. After sparring with her, a character may purchase Rank 1 of a single Martial skill in which they have 0 ranks for 1 XP instead of 2." }
        #BlAgqyXx4e2yOgPMaqqHEt ^"For the Good of the Empire" DEF { ^"Effect" STRING "Sumiko is a firm believer in the Emperor's divine right to rule, and thinks foremost of the Empire's well-being in each decision she makes. Increase the TN of Command or Courtesy skill checks to convince her to act against the wishes of the Emperor, even for the best of reasons, by 2." }
    }

    #t0c848834c60fb715dc0c1 ^"Kitsuki Kāgi" DEF {
        EXTENDS #t4540de6f35155c46f41f0 ^"NPC"
        PROPERTIES {
            ^"Type" STRING "Adversary" FIXED
            ^"Rings" DEF { ^"Air" INTEGER 1 ^"Earth" INTEGER 2 ^"Fire" INTEGER 2 ^"Water" INTEGER 2 ^"Void" INTEGER 1 }
            ^"Demeanor" STRING "Inquisitive"
            ^"Endurance" INTEGER 12
            ^"Composure" INTEGER 8
            ^"Focus" INTEGER 5
            ^"Vigilance" INTEGER 3
            ^"Honor" INTEGER 60
            ^"Glory" INTEGER 58
            ^"Status" INTEGER 38
            ^"Skills" LIST OF STRING ["Artisan 0", "Martial 3", "Scholar 2", "Social 1", "Trade 0"]
            ^"Favored Weapons" LIST OF STRING ["Katana: Damage 4; Range 1"]
            ^"Gear" LIST OF STRING ["Wakizashi, family armor (Resistance [3]), handful of scrolls"]
        }
        DESCRIPTION "Beginner Game simplified profile. Kitsuki Kāgi, Chief Yoriki to the Emerald Magistrate; Sumiko's personal assistant and a possible Lion spy."
        REFERENCES {
            "Kitsuki Kāgi" -> #t0c848834c60fb715dc0c1 ^"Kitsuki Kāgi"
            "Emerald Magistrate" -> #te00d8a952f43f435d9017 ^"Emerald Magistrate"
        }
        #mnSxPbK5agy9jq75YffGxl ^"Knows Everybody" DEF { ^"Effect" STRING "While Kāgi is present in the scene, any character making a Scholar skill check (such as Culture, Government, or Theology) to ascertain or remember a detail about someone in the castle may spend (op) (op). If they fail the check, Kāgi approaches and supplies the information in question." }
    }

    #t1880ce7af8fa1dd5793fc ^"Shosuro Hametsu" DEF {
        EXTENDS #t4540de6f35155c46f41f0 ^"NPC"
        PROPERTIES {
            ^"Type" STRING "Adversary" FIXED
            ^"Rings" DEF { ^"Air" INTEGER 4 ^"Earth" INTEGER 3 ^"Fire" INTEGER 3 ^"Water" INTEGER 4 ^"Void" INTEGER 2 }
            ^"Demeanor" STRING "Scheming"
            ^"Endurance" INTEGER 10
            ^"Composure" INTEGER 14
            ^"Focus" INTEGER 6
            ^"Vigilance" INTEGER 6
            ^"Honor" INTEGER 60
            ^"Glory" INTEGER 58
            ^"Status" INTEGER 70
            ^"Skills" LIST OF STRING ["Artisan 2", "Martial 3", "Scholar 4", "Social 3", "Trade 4"]
            ^"Favored Weapons" LIST OF STRING ["Katana: Damage 4; Range 1"]
            ^"Gear" LIST OF STRING ["Wakizashi, concealed armor under robes (Resistance [3]), variety of hidden vials filled with poisons"]
        }
        DESCRIPTION "Beginner Game simplified profile. Shosuro Hametsu, Family Daimyō, posing as the Emerald Magistrate 'Bayushi Ago'; brother of Bayushi Kachiko."
        REFERENCES {
            "Shosuro Hametsu" -> #t1880ce7af8fa1dd5793fc ^"Shosuro Hametsu"
            "Emerald Magistrate" -> #te00d8a952f43f435d9017 ^"Emerald Magistrate"
        }
        #RZ2jsd4A5Z0Mx4E4T5Hhxj ^"Master of Poisons" DEF { ^"Effect" STRING "As a Support action, Hametsu may make TN 2 Skulduggery (Air) check instead of a Medicine check to a apply a dose of poison to a weapon or item (see page 26 of the Rulebook). If successful, no one notices this action." }
        #xKlOGZfGDinDH56ZwLlwNW ^"Master of Disguises" DEF { ^"Effect" STRING "Hametsu may make a TN 1 Skulduggery (Water) check to adopt a disguise. The TN of checks to notice this disguise is 2 plus the number of bonus successes he gains on this check. Characters must know Hametsu personally or have seen him in person to determine he is the one in disguise, however." }
    }

    #t4120c3938e1a6324cebe1 ^"Kitsuki Tomo" DEF {
        EXTENDS #t4540de6f35155c46f41f0 ^"NPC"
        PROPERTIES {
            ^"Type" STRING "Adversary" FIXED
            ^"Rings" DEF { ^"Air" INTEGER 4 ^"Earth" INTEGER 3 ^"Fire" INTEGER 3 ^"Water" INTEGER 2 ^"Void" INTEGER 1 }
            ^"Demeanor" STRING "Fanatical"
            ^"Endurance" INTEGER 10
            ^"Composure" INTEGER 10
            ^"Focus" INTEGER 6
            ^"Vigilance" INTEGER 4
            ^"Honor" INTEGER 55
            ^"Glory" INTEGER 47
            ^"Status" INTEGER 35
            ^"Skills" LIST OF STRING ["Artisan 0", "Martial 3", "Scholar 2", "Social 2", "Trade 3"]
            ^"Favored Weapons" LIST OF STRING ["Katana: Damage 4; Range 1", "Shuriken: Damage 2; Range 1–3"]
            ^"Gear" LIST OF STRING ["Daishō, thick clothing with concealed armor (Resistance [3]), vials of poison, coil of thin rope, climbing hooks"]
        }
        DESCRIPTION "Beginner Game simplified profile. Kitsuki Tomo, Kolat Assassin — posing as one of Kāgi's assistants."
        REFERENCES {
            "Kitsuki Tomo" -> #t4120c3938e1a6324cebe1 ^"Kitsuki Tomo"
        }
        #xKEiSGqED9JsUZjDSVyATn ^"Skilled Assassin" DEF { ^"Effect" STRING "When making an Attack check, Tomo may spend (op) (op) to move 1 range band and throw a shuriken at a character at range 1–2 other than his target. That character must resist with a TN 3 Fitness (Earth) check or suffer 5 damage." }
        #uID3jbwzmErXwfj0MgNZgo ^"Single-Minded" DEF { ^"Effect" STRING "During battle scenes, Tomo does not receive strife from (st) results on his checks." }

        RULES {
            #aOHya8oPDHjzjafBTW6Ri3: background "Tomo has been a fanatical member of the Kolat for years now, ever since he witnessed one of the Emperor's heirs angrily kill a peasant who had fallen in his way. This convinced Tomo that humans needed to rule Rokugan, not the offspring of the Kami. Tomo serves as one of Kāgi's assistants, which has allowed him to discover the castle's many secrets. His Kolat superiors at Otosan Uchi determined Satsume must be eliminated, for though Satsume didn't want either Imperial heir on the throne, he did want to keep the Empire secure—something they are against. Tomo eagerly accepted the assignment, and now sets out to destabilize the Empire further by killing the Ruby Champion as well."
        }
    }
}
