# .codex SECTION — In the Palace of the Emerald Champion (adventure). Stand-off
# graph over l5r5e-0.5-emerald-champion.lore (spec §25). Part of the L5R5e system
# graph; DEPENDS_ON the shared schema.
#
# The adventure's cast (12 NPCs/creatures in l5r5e-0.5-emerald-champion-cast.ttrpg)
# and the 7 pregens (l5r5e-0.5-emerald-champion-pregens.actor) are DEFs — referenced
# via ^"...", never minted. Shiro Yogasha (Fields of Victory), the Shosuro family,
# Doji Satsume, Doji Hotaru, the Kolat, Bayushi Kachiko, and Otosan Uchi are already
# in the graph — referenced, and Shiro Yogasha / Doji Satsume / the Kolat / Bayushi
# Kachiko / Shosuro amended. This section mints the offices (Emerald Champion, Ruby
# Champion, Emerald Magistrate — Titles), the town of Tsuma, and the two lore-only
# suspects/figures Bayushi Sugai and Hiruma Shigeki.

CODEX "L5R5e_EmeraldChampion_Codex" {
    NAME "In the Palace of the Emerald Champion — Lore Graph"
    VERSION "0.5.2"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-09-03"
    FOR EDITION "l5r5e"
    DEPENDS_ON "L5R5e_Codex_Schema" VERSION "0.5.9"

    # ---- The offices (Titles) ---------------------------------------------
    ENTITY #L5RcxEmC01emeraldchampion ^"Emerald Champion" {
        IS ^"Title"
        SOURCE "l5r5e-0.5-emerald-champion.lore" AT "welcome-to-the-palace-of-the-emerald-champion-the-story-so-far"
    }
    ENTITY #L5RcxEmC02rubychampionttl ^"Ruby Champion" {
        IS ^"Title"
        SOURCE "l5r5e-0.5-emerald-champion.lore" AT "agasha-sumiko-ruby-champion-and-acting-emerald-champion"
        RELATIONSHIPS { ^"held-by-person" -> ^"Agasha Sumiko" FROM "Agasha Sumiko, Ruby Champion and Acting Emerald Champion" }
    }
    ENTITY #L5RcxEmC03emeraldmagistrate ^"Emerald Magistrate" {
        IS ^"Title"
        SOURCE "l5r5e-0.5-emerald-champion.lore" AT "if-you-are-a-hero-player-stop-reading-here"
    }

    # ---- The town ---------------------------------------------------------
    ENTITY #L5RcxEmC04tsumatown ^"Tsuma" {
        IS ^"Town"
        SOURCE "l5r5e-0.5-emerald-champion.lore" AT "adventure-structure"
    }

    # ---- Lore-only figures (suspects; the cast NPCs are DEFs, referenced) --
    ENTITY #L5RcxEmC05bayushisugai ^"Bayushi Sugai" {
        IS ^"Person"
        SOURCE "l5r5e-0.5-emerald-champion.lore" AT "the-real-story-so-far"
        RELATIONSHIPS { ^"member-of" -> ^"Bayushi" FROM "During the last adventure, the PCs engaged in the Topaz Championship and hopefully foiled Bayushi Sugai’s plot for revenge." }
    }
    ENTITY #L5RcxEmC06hirumashigeki ^"Hiruma Shigeki" {
        IS ^"Person"
        SOURCE "l5r5e-0.5-emerald-champion.lore" AT "breakfast"
        RELATIONSHIPS {
            ^"member-of"    -> ^"Hiruma"        FROM "Hiruma Shigeki, an Emerald Magistrate of the Crab Clan, is at breakfast today."
            ^"holds-title"  -> ^"Emerald Magistrate" FROM "Hiruma Shigeki, an Emerald Magistrate of the Crab Clan, is at breakfast today."
            ^"rival-of"     -> ^"Doji Satsume" }
    }

    # ---- Amendments to existing graph nodes --------------------------------
    ENTITY #RdV5riRl0XzUSW1G0lcCK7 ^"Doji Satsume" {
        SOURCE "l5r5e-0.5-emerald-champion.lore" AT "the-real-story-so-far"
        RELATIONSHIPS {
            ^"holds-title" -> ^"Emerald Champion" FROM "It concerns the death of Doji Satsume, the Emerald Champion."
            ^"parent-of"   -> ^"Doji Hotaru"      FROM "It seems that Doji Hotaru, the daughter of Doji Satsume, wishes to speak with them."
            ^"oversees"    -> ^"Shiro Yogasha"
            ^"member-of"   -> ^"Doji"             FROM "However, questions surrounding Doji Satsume, their ghostly visitor, still linger." }
    }
    ENTITY #XWHoYnkH5Tg8vklPKFJxu9 ^"Shiro Yogasha" {
        SOURCE "l5r5e-0.5-emerald-champion.lore" AT "day-1-arrival"
        RELATIONSHIPS { ^"overseen-by" -> ^"Agasha Sumiko" FROM "Sumiko is quite busy with shouldering all the duties of both Emerald Champion and Ruby Champion in the wake of Satsume's demise" }
    }
    ENTITY #UPB0THDIrvPil8LkPlVpDW ^"Kolat" {
        SOURCE "l5r5e-0.5-emerald-champion.lore" AT "kitsuki-tomo-kolat-assassin"
        RELATIONSHIPS { ^"has-member" -> ^"Kitsuki Tomo" FROM "Kitsuki Tomo, Kolat Assassin" }
    }
    ENTITY #Rd23HPaVtkPBbjH5ybXcM8 ^"Bayushi Kachiko" {
        SOURCE "l5r5e-0.5-emerald-champion.lore" AT "shosuro-hametsu-family-daimyō"
        RELATIONSHIPS { ^"sibling-of" -> ^"Shosuro Hametsu" FROM "Shosuro Hametsu is the daimyō of the Shosuro family and brother of Bayushi Kachiko." }
    }
    ENTITY #yUGSKokLiApZrjs5L62SLo ^"Shosuro" {
        SOURCE "l5r5e-0.5-emerald-champion.lore" AT "shosuro-hametsu-family-daimyō"
        RELATIONSHIPS { ^"led-by" -> ^"Shosuro Hametsu" FROM "Shosuro Hametsu, Family Daimyō" }
    }
}
