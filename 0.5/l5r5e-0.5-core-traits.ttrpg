        SKILL_GROUP "Martial"

    }

    #t687d0391cd381e870837c ^"Tactics" DEF {
        APPLIES TO [#L5R003xY4zA6bC8dE0fG2hI ^"Samurai", #L5R009mN0oP2qR4sT6uV8w ^"Adversary"]

