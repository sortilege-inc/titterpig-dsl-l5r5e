# .codex SECTION — Sins of Regret (adventure). Stand-off graph over
# l5r5e-0.5-sins-of-regret.lore (spec §25). Part of the L5R5e system graph;
# DEPENDS_ON the shared schema.
#
# The 11 cast NPCs (cast.ttrpg) are DEFs — referenced via ^"...", never minted.
# The Kyōkotsu (a cast DEF) is the undead remains of Otomo Nahoko, who is minted
# here as the person she was. Twin Blessings Village and the Perfect Land Sect
# are already in the graph (Twin Blessings amended). The Otomo, Seppun, Miya, and
# Kakita family DEFs are referenced. This section mints Closed Shell Castle and
# the other places, the Reju vassal family, and the adventure's lore-only figures.

CODEX "L5R5e_SinsOfRegret_Codex" {
    NAME "Sins of Regret — Lore Graph"
    VERSION "0.5.2"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-09-03"
    FOR EDITION "l5r5e"
    DEPENDS_ON "L5R5e_Codex_Schema" VERSION "0.5.9"

    # ---- Places -----------------------------------------------------------
    ENTITY #L5RcxSoR01closedshell ^"Closed Shell Castle" {
        IS ^"Castle"
        SOURCE "l5r5e-0.5-sins-of-regret.lore" AT "part-two-closed-shell-castle"
        RELATIONSHIPS {
            ^"held-by"      -> ^"Reju"                   FROM "Closed Shell Castle hosts a dozen Otomo guards under the command of Reju Masaru."
            ^"seat-of"      -> ^"Reju"                   FROM "Closed Shell Castle hosts a dozen Otomo guards under the command of Reju Masaru."
            ^"located-near" -> ^"Twin Blessings Village" FROM "Sins of Regret includes a fold-out map featuring both Twin Blessings Village and Closed Shell Castle." }
    }
    ENTITY #L5RcxSoR02waystation ^"The Way Station" {
        IS ^"Building"
        SOURCE "l5r5e-0.5-sins-of-regret.lore" AT "the-pilgrim"
        RELATIONSHIPS { ^"located-near" -> ^"Twin Blessings Village" }
    }
    ENTITY #L5RcxSoR03hermitage ^"The Hermitage" {
        IS ^"Building"
        SOURCE "l5r5e-0.5-sins-of-regret.lore" AT "ichirō-bandit-leader"
        RELATIONSHIPS {
            ^"located-near" -> ^"Twin Blessings Village"
            ^"held-by"      -> ^"Ichirō (Sins of Regret)"                 FROM "Ichirō is young and naïve, and if the PCs swear to keep his presence secret, he does not prevent them from leaving the Hermitage." }
    }

    # ---- The Reju vassal family -------------------------------------------
    ENTITY #L5RcxSoR04rejufamily ^"Reju" {
        IS ^"Faction"
        SOURCE "l5r5e-0.5-sins-of-regret.lore" AT "reju-jikai-daimyō"
        RELATIONSHIPS { ^"led-by" -> ^"Reju Jikai" FROM "Reju Jikai, Daimyō" }
    }

    # ---- Twin Blessings villagers ------------------------------------------
    ENTITY #YCZnLaJSWpNFJ4WfstIiBx ^"Setsuo" {
        SOURCE "l5r5e-0.5-sins-of-regret.lore" AT "arriving-at-twin-blessings-village"
        RELATIONSHIPS { ^"located-in" -> ^"Twin Blessings Village" }
    }
    ENTITY #L5RcxSoR06natsumi ^"Natsumi" {
        IS ^"Person"
        SOURCE "l5r5e-0.5-sins-of-regret.lore" AT "setsuo-village-leader"
        RELATIONSHIPS { ^"located-in" -> ^"Twin Blessings Village" }
    }
    ENTITY #3gCgfLBwl1Ib1B4H9mV32j ^"Daizō" {
        SOURCE "l5r5e-0.5-sins-of-regret.lore" AT "shrine-to-the-river-kami"
        RELATIONSHIPS {
            ^"located-in"   -> ^"Twin Blessings Village"
            ^"companion-of" -> ^"Kokoro"                 FROM "The figure Daizō saw at the shrine one night was not the ghost of his departed friend Kokoro, as he believes (see The Elemental Imbalance on page 2), but Toshio, the treacherous shugenja of Closed Shell Castle." }
    }
    ENTITY #UpIgY3H4RcdBDilnCS3Uw4 ^"Kokoro" {
        SOURCE "l5r5e-0.5-sins-of-regret.lore" AT "daizō-village-priest"
    }
    ENTITY #L5RcxSoR09shinichi ^"Shinichi" {
        IS ^"Person"
        SOURCE "l5r5e-0.5-sins-of-regret.lore" AT "shinichi-outcast-villager"
        RELATIONSHIPS { ^"located-in" -> ^"Twin Blessings Village" }
    }
    ENTITY #L5RcxSoR10naokipilgrim ^"Naoki" {
        IS ^"Person"
        SOURCE "l5r5e-0.5-sins-of-regret.lore" AT "the-pilgrim"
    }

    # ---- Jikai's bushi & the way-station dead ------------------------------
    ENTITY #L5RcxSoR11rinbushi ^"Rin" {
        IS ^"Person"
        SOURCE "l5r5e-0.5-sins-of-regret.lore" AT "the-adventure"
        RELATIONSHIPS { ^"member-of" -> ^"Reju" FROM "Sins of Regret begins with the arrival of the PCs in Twin Blessings Village, which is suffering under the governorship of a new shugo, or minor lord, Reju Jikai." }
    }
    ENTITY #L5RcxSoR12genzobushi ^"Genzo" {
        IS ^"Person"
        SOURCE "l5r5e-0.5-sins-of-regret.lore" AT "the-last-stand"
        RELATIONSHIPS { ^"member-of" -> ^"Reju" FROM "Seppun Azusa, Reju Ume, Reju Daihachi, Reju Jinzaburō Coup Forces: Otomo Nobu and two Skillful Rōnin, plus one or more of the following (if available) Reju Toshio, Reju Masaru, Rin, Genzo" }
    }
    ENTITY #L5RcxSoR13miyaemon ^"Miya Emon" {
        IS ^"Person"
        SOURCE "l5r5e-0.5-sins-of-regret.lore" AT "treasures-of-the-way-station"
        RELATIONSHIPS { ^"member-of" -> ^"Miya" FROM "Miya Emon was on his way to visit his niece, Miya Shinako, during her stay at Closed Shell Castle." }
    }
    ENTITY #L5RcxSoR14miyashinako ^"Miya Shinako" {
        IS ^"Person"
        SOURCE "l5r5e-0.5-sins-of-regret.lore" AT "treasures-of-the-way-station"
        RELATIONSHIPS { ^"member-of" -> ^"Miya" FROM "Miya Emon was on his way to visit his niece, Miya Shinako, during her stay at Closed Shell Castle." }
    }

    # ---- The castle household ----------------------------------------------
    ENTITY #L5RcxSoR15nahoko ^"Otomo Nahoko" {
        IS ^"Person"
        SOURCE "l5r5e-0.5-sins-of-regret.lore" AT "the-history-of-closed-shell-castle"
        RELATIONSHIPS {
            ^"member-of" -> ^"Otomo"      FROM "Otomo Nahoko is a name some PCs might recognize if they have studied military history."
            ^"enemy-of"  -> ^"Otomo Nobu" }
    }
    ENTITY #L5RcxSoR16jinzaburo ^"Jinzaburō" {
        IS ^"Person"
        SOURCE "l5r5e-0.5-sins-of-regret.lore" AT "reju-jinzaburō-yōjimbō"
        RELATIONSHIPS { ^"companion-of" -> ^"Reju Jikai" }
    }
    ENTITY #L5RcxSoR17chisato ^"Kakita Chisato" {
        IS ^"Person"
        SOURCE "l5r5e-0.5-sins-of-regret.lore" AT "reju-ume-duelist-and-heir"
        RELATIONSHIPS { ^"member-of" -> ^"Kakita" FROM "In Otosan Uchi she trained with a Kakita sensei, and she misses her training with Kakita Chisato." }
    }
    ENTITY #L5RcxSoR18atsuko ^"Atsuko" {
        IS ^"Person"
        SOURCE "l5r5e-0.5-sins-of-regret.lore" AT "the-elemental-imbalance"
        RELATIONSHIPS {
            ^"located-in" -> ^"Closed Shell Castle"
            ^"ally-of"    -> ^"Otomo Nobu" }
    }
    ENTITY #L5RcxSoR19daihachi ^"Reju Daihachi" {
        IS ^"Person"
        SOURCE "l5r5e-0.5-sins-of-regret.lore" AT "reju-daihachi-sensei"
        RELATIONSHIPS { ^"member-of" -> ^"Reju" FROM "Reju Daihachi, Sensei" }
    }

    # ---- The rival Otomo ---------------------------------------------------
    ENTITY #L5RcxSoR20itsuki ^"Otomo Itsuki" {
        IS ^"Person"
        SOURCE "l5r5e-0.5-sins-of-regret.lore" AT "part-two-closed-shell-castle"
        RELATIONSHIPS {
            ^"member-of" -> ^"Otomo"      FROM "The daimyō above him, Otomo Itsuki, has little sympathy for this minor lord, and would likely not deign to notice if a neighboring lord was to attempt to add Jikai’s land to their own."
            ^"enemy-of"  -> ^"Reju Jikai" FROM "Because Otomo Itsuki holds no respect for Reju Jikai, he ignores any threatening action from Otomo Osamu." }
    }
    ENTITY #L5RcxSoR21otomoosamu ^"Otomo Osamu" {
        IS ^"Person"
        SOURCE "l5r5e-0.5-sins-of-regret.lore" AT "otomo-niko-rival-courtier"
        RELATIONSHIPS {
            ^"member-of" -> ^"Otomo"      FROM "Niko represents her lord, Otomo Osamu, the nearest landholding daimyō to Reju Jikai."
            ^"enemy-of"  -> ^"Reju Jikai" FROM "Niko represents her lord, Otomo Osamu, the nearest landholding daimyō to Reju Jikai." }
    }
    ENTITY #L5RcxSoR22otomoniko ^"Otomo Niko" {
        IS ^"Person"
        SOURCE "l5r5e-0.5-sins-of-regret.lore" AT "otomo-niko-rival-courtier"
        RELATIONSHIPS {
            ^"member-of" -> ^"Otomo"      FROM "Otomo Niko, Rival Courtier"
            ^"ally-of"   -> ^"Otomo Nobu" }
    }

    # ---- Amendment ---------------------------------------------------------
    ENTITY #TsrhO6b0vfusT8W8ytYoqv ^"Twin Blessings Village" {
        SOURCE "l5r5e-0.5-sins-of-regret.lore" AT "the-adventure"
        RELATIONSHIPS { ^"held-by" -> ^"Reju" FROM "Sins of Regret begins with the arrival of the PCs in Twin Blessings Village, which is suffering under the governorship of a new shugo, or minor lord, Reju Jikai." }
    }
}
