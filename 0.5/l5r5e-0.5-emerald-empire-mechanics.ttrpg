    # source (pages 248-253)
    ^"Emerald Empire Titles" DEF {
        APPLIES TO [#L5R003xY4zA6bC8dE0fG2hI ^"Samurai"]

        ENTRIES {
            #9CQXynRmsZhECY4Lgu5sWP ^"Advisor" DEF {
                ^"Assigned By" STRING "Daimyō, Emerald Magistrates, military leaders, high-ranking courtiers, and other individuals of import can appoint Advisors, and do so at their discretion."
                ^"Status Award" STRING "+10 (minimum 40)"
                ^"XP to Completion" INTEGER 36
                ^"Title Ability" STRING "Skilled Attendant"
                ^"Title Ability Effect" STRING "When you provide assistance on a Scholar skill check, the character you are assisting may also roll (skill) equal to your ranks in that skill instead of rolling (skill) equal to their own ranks in that skill."
                ^"Advancement" LIST OF STRING [
                    "Scholar Skills (Skill Group)",
                    "Commerce (Skill)",
                    "Courtesy (Skill)",
                    "Design (Skill)",
                    "Fanning the Flames (shuji)",
                    "Feigned Opening (shuji)",
                    "Stonewall Tactics (shuji)"
                ]
            }

            #2rL7DUPKnOVgiSUClqYBUW ^"Clan Magistrate" DEF {
                ^"Assigned By" STRING "Clan champions, daimyō, and other leaders within a clan may appoint magistrates to enforce the law within the clan's territories and among its vassals."
                ^"Status Award" STRING "+10 (minimum 45)"
                ^"XP to Completion" INTEGER 30
                ^"Title Ability" STRING "Justice of the Champion"
                ^"Title Ability Effect" STRING "When you make a Command or Courtesy check targeting a member of your clan, you may spend (op) as follows:\n\n(op)+: The target receives or removes (your choice) strife equal to (op) spent this way."
                ^"Advancement" LIST OF STRING [
                    "Scholar Skills (Skill Group)",
                    "Social Skills (Skill Group)",
                    "Fitness (Skill)",
                    "Martial Arts [Melee] (Skill)",
                    "Coiling Serpent Style (kata)",
                    "Prey on the Weak (shuji)",
                    "Truth Burns through Lies (shuji)"
                ]
            }

            #78IRmlBZ01UmgddL1PIkUA ^"Daimyo" DEF {
                ^"Assigned By" STRING "Clan champions, the Emperor, and other high-ranking officials"
                ^"Status Award" STRING "+20 (minimum 55)"
                ^"XP to Completion" INTEGER 36
                ^"Title Ability" STRING "Voice of Authority"
                ^"Title Ability Effect" STRING "Reduce the TN of Command checks you make targeting your vassals by 1."
                ^"Advancement" LIST OF STRING [
                    "Social Skills (Skill Group)",
                    "Culture (Skill)",
                    "Government (Skill)",
                    "Tactics (Skill)",
                    "Courtier's Resolve (shuji)",
                    "Shallow Waters (shuji)",
                    "Stirring the Embers (shuji)"
                ]
            }

            #Q93fb38lIZlK7MrgtxkTBc ^"Gunso" DEF {
                ^"Assigned By" STRING "A daimyō may assign a samurai a rank within their military forces, and samurai serving within the military rank structure may be promoted by a superior officer."
                ^"Status Award" STRING "+5 (minimum 20)"
                ^"XP to Completion" INTEGER 24
                ^"Title Ability" STRING "Lead from the Front"
                ^"Title Ability Effect" STRING "When you defeat an opponent in a clash, your cohort removes panic equal to the opponent's glory rank. Once per round when you succeed at an Attack action check during a mass battle, your cohort removes panic equal to half of the attrition you inflict."
                ^"Advancement" LIST OF STRING [
                    "Martial Skills (Skill Group)",
                    "Command (Skill)",
                    "Government (Skill)",
                    "Rank 1-4 Kata (kata) (Tech Group)",
                    "Rallying Cry (shuji)",
                    "Stirring the Embers (shuji)",
                    "Touchstone of Courage (shuji)"
                ]
            }

            #ZDJ7xKw5n6xnfyWCHXX1aw ^"Monastic Acolyte" DEF {
                ^"Assigned By" STRING "Most monasteries accept anyone as a monk, as long as they take the required vows and shave their head. A samurai who becomes a monk leaves their old life behind, including both their clan and family identity, and takes a new name."
                ^"Status Award" STRING "Status becomes 25"
                ^"XP to Completion" INTEGER 24
                ^"Title Ability" STRING "Enlightened"
                ^"Title Ability Effect" STRING "When you are selected as a target of an action requiring a skill check, you may spend a Void point to increase or decrease the TN of the check by an amount up to your ranks in Meditation (to a minimum of 1)."
                ^"Advancement" LIST OF STRING [
                    "Martial Skills (Skill Group)",
                    "Scholar Skills (Skill Group)",
                    "Aesthetics (Skill)",
                    "Composition (Skill)",
                    "Cleansing Spirit (kiho)",
                    "Ki Protection (kiho)",
                    "Still the Elements (kiho)"
                ]
            }

            #kEHbRqdefVeY9ETA922fOI ^"Priest" DEF {
                ^"Assigned By" STRING "Most priests train for their role from a young age. In rare cases, an individual who has shown a particular devotion to or affinity for the kami may take up duties at a shrine or temple, where the head priest assigns their title."
                ^"Status Award" STRING "+10 (minimum 40)"
                ^"XP to Completion" INTEGER 24
                ^"Title Ability" STRING "Servant of the Kami"
                ^"Title Ability Effect" STRING "You may importune invocations even if you do not know any invocations. When you importune an invocation, do not increase the TN by 1 (although you still increase the TN if the rank of the invocation is higher than your school rank)."
                ^"Advancement" LIST OF STRING [
                    "Social Skills (Skill Group)",
                    "Composition (Skill)",
                    "Culture (Skill)",
                    "Theology (Skill)",
                    "Rank 1-5 Rituals (ritual) (Tech Group)",
                    "Civility Foremost (shuji)",
                    "Rouse the Soul (shuji)"
                ]
            }

            #3ZdGc94SVvP7M9TEirn2j7 ^"Spy" DEF {
                ^"Assigned By" STRING "Daimyō, clan champions, magistrates, and clandestine organizations surreptitiously task a samurai with acting as a spy. Unlike other titles, of course, this is never announced publicly."
                ^"Status Award" STRING "-5"
                ^"XP to Completion" INTEGER 24
                ^"Title Ability" STRING "Ears Everywhere"
                ^"Title Ability Effect" STRING "Once per game session as a Scheme and Support action or as a downtime activity targeting a particular location or social group, you may gather and sift through the current rumors for credible intelligence by making a TN 4 Sentiment (Air) check. If you succeed, you discover the latest happenings relevant to your current location or social group, as well as which current rumors are false. If discerning someone's qualities is your social objective in an intrigue scene, you score momentum points equal to your Air Ring plus your bonus successes.\n\n(op): You plant a rumor that spreads among the characters in the scene or the targeted group (although they don't necessarily believe it)."
                ^"Advancement" LIST OF STRING [
                    "Social Skills (Skill Group)",
                    "Government (Skill)",
                    "Sentiment (Skill)",
                    "Skulduggery (Skill)",
                    "Rank 1-5 Air Shūji (shuji) (Tech Group)",
                    "Shallow Waters (shuji)",
                    "Skulk (ninjutsu)"
                ]
            }

            #8L56PqWyoquPGtIJVM4lXO ^"Yojimbo" DEF {
                ^"Assigned By" STRING "Daimyō, Emerald Magistrates, military leaders, high-ranking courtiers, and other individuals of import can appoint yōjimbō, and do so at their discretion."
                ^"Status Award" STRING "+10 (minimum 40)"
                ^"XP to Completion" INTEGER 36
                ^"Title Ability" STRING "No Sacrifice Too Great"
                ^"Title Ability Effect" STRING "One character is assigned as your charge; this character can order you to treat someone else as your charge instead until they lift this order. If your charge is at range 0–2, you may spend 1 Void point to replace your charge as the target of an Attack action. If you suffer a critical strike as a result of this Attack action, gain 1 Void point."
                ^"Advancement" LIST OF STRING [
                    "Martial Skills (Skill Group)",
                    "Government (Skill)",
                    "Medicine (Skill)",
                    "Sentiment (Skill)",
                    "Iaijutsu Cut: Crossing Blade (kata)",
                    "Iaijutsu Cut: Rising Blade (kata)",
                    "Warrior's Resolve (kata)"
                ]
            }

            #gVTRtVXF1yhAKF6606IJmM ^"Yoriki" DEF {
                ^"Assigned By" STRING "Magistrates of all kinds directly appoint their own yoriki"
                ^"Status Award" STRING "+5 (minimum 35)"
                ^"XP to Completion" INTEGER 24
                ^"Title Ability" STRING "Take Them Alive"
                ^"Title Ability Effect" STRING "When you make an Attack action using a weapon with the Snaring quality, you may alter any number of kept dice containing (su) or (ex) to results set to (op)."
                ^"Advancement" LIST OF STRING [
