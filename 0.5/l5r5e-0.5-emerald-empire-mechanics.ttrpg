    ^"Fortunist Monk Order" DEF {
        EXTENDS #L5R252wX4yZ6aB8cD0eF2g ^"School"
        APPLIES TO [#L5R003xY4zA6bC8dE0fG2hI ^"Samurai"]

        PROPERTIES {
            ^"School Name" STRING "Fortunist Monk Order" FIXED
            ^"Roles" LIST ["Monk"]
            ^"Ring Increase" DEF {
                ^"Earth" INTEGER 1
                ^"Water" INTEGER 1
            }
            ^"Starting Skills" DEF { CHOOSE 4 [^"Courtesy", ^"Culture", ^"Martial Arts [Unarmed]", ^"Meditation", ^"Survival", ^"Theology"] INTEGER 1 }
            ^"Starting Honor" INTEGER DEFAULT 40
            ^"Techniques Available" LIST ["Kata", "Rituals", "Shūji"]
        }

        STARTING_TECHNIQUES {
            KATA ^"Open-Hand Style"
            RITUAL ^"Cleansing Rite"
            RITUAL ^"Threshold Barrier"
            SHUJI CHOOSE 1 [^"Shallow Waters", ^"Stirring the Embers"]
        }

        SCHOOL_ABILITY "Blessing of the Fortunes" {
            "You have gained the goodwill of the Fortune you serve, who grants you certain invocations. When you make a check to use an invocation you learned this way, add additional bonus successes equal to your school rank. Select a Fortune to be the primary object of your veneration and choose one appropriate invocation (see the sidebar The Fortunes and their Blessings) for which you meet the rank prerequisite. You learn that invocation (without paying its XP cost).\n\nEach time your school rank increases, you gain one additional invocation this way."
        }

        MASTERY_ABILITY ^"Favor of the Fortunes" {
            "Once per scene, you may importune one invocation without making the sacrifices usually required and without the usual TN increase. You use the Meditation skill in place of the skill check normally required to use the invocation (you must still use the ring required for the invocation)."
        }
        STARTING_OUTFIT [
            "sanctified robes", "ceremonial clothes",
            "bō (staff)", "traveling pack", "scroll satchel"
        ]

        CURRICULUM {
            RANK 1 {
                SKILL_GROUP "Scholar Skills"
                SKILL "Courtesy"
                SKILL "Labor"
                SKILL "Meditation"
                TECHNIQUE_GROUP "Rank 1 Earth Shūji"
                ^"Crescent Moon Style" [kata]
                ^"Commune with the Spirits" [ritual]
            }
            RANK 2 {
                SKILL_GROUP "Social Skills"
                SKILL "Aesthetics"
                SKILL "Meditation"
                SKILL "Theology"
                TECHNIQUE_GROUP "Rank 1-2 Water Shūji"
                ^"All Arts Are One" [shuji]
                ^"Rushing Avalanche Style" [kata]
            }
            RANK 3 {
                SKILL_GROUP "Artisan Skills"
                SKILL "Martial Arts [Unarmed]"
                SKILL "Meditation"
                SKILL "Theology"
                TECHNIQUE_GROUP "Rank 1-3 Kata"
                ^"Regal Bearing" [shuji]
                ^"Ebb and Flow" [shuji]
            }
            RANK 4 {
                SKILL_GROUP "Social Skills"
                SKILL "Culture"
                SKILL "Fitness"
                SKILL "Theology"
                TECHNIQUE_GROUP "Rank 1-4 Air Shūji"
                ^"Buoyant Arrival" [shuji]
                ^"Pillar of Calm" [shuji]
            }
            RANK 5 {
                SKILL_GROUP "Scholar Skills"
                SKILL "Composition"
                SKILL "Meditation"
                SKILL "Performance"
                TECHNIQUE_GROUP "Rank 1-5 Earth Shūji"
                ^"Rouse the Soul" [shuji]
                ^"Soul Sunder" [kata]
            }
            RANK 6 {
                ^"Favor of the Fortunes"
            }
        }

    }

    # source (page 238)
    ^"Shinseist Monk Order" DEF {
        EXTENDS #L5R252wX4yZ6aB8cD0eF2g ^"School"
        APPLIES TO [#L5R003xY4zA6bC8dE0fG2hI ^"Samurai"]

        PROPERTIES {
            ^"School Name" STRING "Shinseist Monk Order" FIXED
            ^"Roles" LIST ["Monk"]
            ^"Ring Increase" DEF {
                ^"Earth" INTEGER 1
                ^"Void" INTEGER 1
            }
            ^"Starting Skills" DEF { CHOOSE 4 [^"Aesthetics", ^"Composition", ^"Fitness", ^"Martial Arts [Unarmed]", ^"Meditation", ^"Theology"] INTEGER 1 }
            ^"Starting Honor" INTEGER DEFAULT 40
            ^"Techniques Available" LIST ["Kata", "Kihō", "Rituals"]
        }

        STARTING_TECHNIQUES {
            KATA ^"Striking as Earth"
            KIHO CHOOSE 2 [^"Cleansing Spirit", ^"Earth Needs No Eyes", ^"Ki Protection"]
        }

        SCHOOL_ABILITY "Embrace the Void" {
            "When you spend a Void point to Seize the Moment (see page 36 of the core rulebook), you may also treat your ranks in the skill you are using as being equal to your school rank. If your ranks in the skill are equal to or higher than your school rank, or if you have 5 ranks in the skill, you may add one kept (ring) set to an (op) result instead."
        }

        MASTERY_ABILITY ^"One with the Void" {
            "Once per scene, you may use one kihō technique you do not know. You may use the Meditation skill in place of the skill check normally required to use the kihō (you must still use the ring required for the kihō)."
        }
        STARTING_OUTFIT [
            "common clothes", "bō (staff) or nunchaku (linked staff)",
            "knife", "traveling pack"
        ]

        CURRICULUM {
            RANK 1 {
                SKILL_GROUP "Martial Skills"
                SKILL "Composition"
                SKILL "Survival"
                SKILL "Theology"
                TECHNIQUE_GROUP "Rank 1 Kata"
                ^"Riding the Clouds" [kiho]
                ^"Earthen Fist" [kiho]
            }
            RANK 2 {
                SKILL_GROUP "Scholar Skills"
                SKILL "Aesthetics"
                SKILL "Courtesy"
                SKILL "Meditation"
                TECHNIQUE_GROUP "Rank 1-2 Earth Kihō"
                TECHNIQUE_GROUP "Rank 1-2 Rituals"
                ^"All Arts Are One" [shuji]
            }
            RANK 3 {
                SKILL_GROUP "Martial Skills"
                SKILL "Command"
                SKILL "Games"
                SKILL "Theology"
                TECHNIQUE_GROUP "Rank 1-3 Kata"
                ^"Grasp the Earth Dragon" [kiho]
                ^"Way of the Willow" [kiho]
            }
            RANK 4 {
                SKILL_GROUP "Martial Skills"
                SKILL "Courtesy"
                SKILL "Survival"
                SKILL "Theology"
                TECHNIQUE_GROUP "Rank 1-4 Water Kihō"
                ^"Pillar of Calm" [shuji]
                ^"Way of the Falling Star" [kiho]
            }
            RANK 5 {
                SKILL_GROUP "[Choose one skill group] Skills"
                SKILL "Martial Arts [Unarmed]"
                SKILL "Meditation"
                SKILL "Theology"
                TECHNIQUE_GROUP "Rank 1-5 Void Kihō"
                ^"Rouse the Soul" [shuji]
                ^"The Immovable Hand of Peace" [shuji]
            }
            RANK 6 {
                ^"One with the Void"
            }
        }

    }

    # source (page 239)
    ^"Kitsune Impersonator Tradition" DEF {
        EXTENDS #L5R252wX4yZ6aB8cD0eF2g ^"School"
        APPLIES TO [#L5R003xY4zA6bC8dE0fG2hI ^"Samurai"]

        PROPERTIES {
            ^"School Name" STRING "Kitsune Impersonator" FIXED
            ^"Clan" STRING "Fox"
            ^"Roles" LIST ["Courtier", "Shugenja"]
            ^"Ring Increase" DEF {
                ^"Air" INTEGER 1
                ^"Fire" INTEGER 1
            }
            ^"Starting Skills" DEF { CHOOSE 3 [^"Courtesy", ^"Games", ^"Performance", ^"Martial Arts [Unarmed]", ^"Survival", ^"Theology"] INTEGER 1 }
            ^"Starting Honor" INTEGER DEFAULT 30
            ^"Techniques Available" LIST ["Invocations", "Rituals", "Shūji"]
            ^"Starting Disadvantage" STRING "False Identity"
        }

        STARTING_TECHNIQUES {
            INVOCATION ^"Nature's Touch"
            INVOCATION ^"Token of Memory"
            RITUAL ^"Commune with the Spirits"
        }

        SCHOOL_ABILITY "Fox Spirit" {
            "Your true form is that of a large fox with up to eight tails if you are a full-blooded kitsune, or a human with certain vulpine traits if you possess human ancestry as well. As a Scheme and Support action, you may transform between your human and true forms, or into another silhouette 1 or 2 natural creature at the GM’s discretion (you cannot mimic specific individuals). Observers with vigilance lower than or equal to your school rank plus your ranks in Performance do not detect any flaws in your façade. However, certain key features persist across all of your forms. If you become Compromised, your disguise slips, subtly revealing your true tails, ears, feet, or shadow."
        }

        MASTERY_ABILITY ^"Ninth Tail Ascension" {
            "Your true form now has nine tails. While you are in your true form, your supernatural resistance and physical resistance each increase by 2, and when you make a skill check, you may alter the result of one die containing (su) to a result containing (ex). While you are in your true form, your Attack action checks gain the following new opportunity:\n\n(op) (op): After resolving this action, if your target is Incapacitated or Unconscious, you devour or banish their body or soul, instantly killing them."
        }
        STARTING_OUTFIT ["Take the starting outfit of any one other school, as appropriate to your false identity."]

        CURRICULUM {
            RANK 1 {
                SKILL_GROUP "Martial Skills"
                SKILL "Performance"
                SKILL "Survival"
                SKILL "Theology"
                TECHNIQUE_GROUP "Rank 1 Air Invocations"
                ^"Fanning the Flames" [shuji]
                ^"All in Jest" [shuji]
            }
            RANK 2 {
                SKILL_GROUP "Social Skills"
                SKILL "Skulduggery"
                SKILL "Survival"
                SKILL "Theology"
                TECHNIQUE_GROUP "Rank 1-2 Air Shūji"
                ^"Dazzling Performance" [shuji]
                ^"False Realm of the Fox Spirits" [invocation]
            }
            RANK 3 {
                SKILL_GROUP "Artisan Skills"
                SKILL "Culture"
                SKILL "Meditation"
                SKILL "Theology"
                TECHNIQUE_GROUP "Rank 1-3 Air Invocations"
                ^"Crashing Wave Style" [kata]
                ^"Regal Bearing" [shuji]
            }
            RANK 4 {
                SKILL_GROUP "Social Skills"
                SKILL "Meditation"
                SKILL "Sentiment"
                SKILL "Skulduggery"
                TECHNIQUE_GROUP "Rank 1-4 Air Shūji"
                ^"Disappearing World Style" [kata]
                ^"Bravado" [shuji]
            }
            RANK 5 {
                SKILL_GROUP "Scholar Skills"
                SKILL "Martial Arts [Unarmed]"
                SKILL "Meditation"
                SKILL "Survival"
                TECHNIQUE_GROUP "Rank 1-5 Air Invocations"
                ^"Soul Sunder" [kata]
                ^"Buoyant Arrival" [shuji]
            }
            RANK 6 {
                ^"Ninth Tail Ascension"
            }
        }

    }

    # source (page 240)
    ^"Kolat Saboteur Conspiracy" DEF {
        EXTENDS #L5R252wX4yZ6aB8cD0eF2g ^"School"
        APPLIES TO [#L5R003xY4zA6bC8dE0fG2hI ^"Samurai"]

        PROPERTIES {
            ^"School Name" STRING "Kolat Saboteur" FIXED
            ^"Roles" LIST ["Shinobi"]
            ^"Ring Increase" DEF {
                ^"Air" INTEGER 1
                ^"Water" INTEGER 1
            }
            ^"Starting Skills" DEF { CHOOSE 5 [^"Commerce", ^"Fitness", ^"Martial Arts [Melee]", ^"Martial Arts [Ranged]", ^"Medicine", ^"Meditation", ^"Skulduggery"] INTEGER 1 }
            ^"Starting Honor" INTEGER DEFAULT 20
            ^"Starting Disadvantage" STRING "False Identity"
            ^"Techniques Available" LIST ["Kata", "Shūji"]
        }

        STARTING_TECHNIQUES {
            KATA ^"Veiled Menace Style"
            NINJUTSU ^"Skulk"
            SHUJI ^"Cadence"
        }

        SCHOOL_ABILITY "Professional Saboteur" {
            "Once per game session at the beginning of a scene, you may reveal that an NPC in that scene is the target of your current assignment. The GM then decides what your assignment entails, such as sabotaging the target’s current activities, framing them for a crime, killing them, or even making sure they survive to play their part in a long and sinister plot. Until the end of the session, when you make a skill check targeting the chosen NPC, you may reroll a number of dice up to your school rank."
        }

        MASTERY_ABILITY ^"Usher In the New Age" {
            "As a downtime activity, you may overcome or bypass an NPC’s guards or other security measures in order to gain access to them. Make a Skulduggery (Air) check targeting the NPC, with a TN equal to their highest conflict rank. If you succeed and the chosen NPC is a minion or an adversary the GM deems non-essential to the campaign plot, you accomplish your goal, such as assassinating the NPC or delivering an effective threat, in a method of your choosing (subject to the GM’s approval). If the NPC is an important adversary, you confront the NPC alone, likely beginning a conflict scene. (op)(op): Your efforts go completely unnoticed by anyone except possibly the target. (op)(op): If you kill the target, their death appears to be the result of an accident or natural causes (although a skilled investigator may still uncover the truth)."
        }
        STARTING_OUTFIT [
            "ceremonial clothes", "common clothes", "traveling clothes",
            "daishō (katana and wakizashi)", "knife", "five shuriken",
            "one vial of poison", "traveling pack"
        ]

        CURRICULUM {
            RANK 1 {
                SKILL_GROUP "Martial Skills"
                SKILL "Courtesy"
                SKILL "Performance"
                SKILL "Skulduggery"
                TECHNIQUE_GROUP "Rank 1 Kata"
                ^"Deadly Sting" [ninjutsu]
                ^"Shallow Waters" [shuji]
            }
            RANK 2 {
                SKILL_GROUP "Martial Skills"
                SKILL "Commerce"
                SKILL "Medicine"
                SKILL "Skulduggery"
                TECHNIQUE_GROUP "Rank 1-2 Kata"
                ^"Noxious Cloud" [ninjutsu]
                ^"Tributaries of Trade" [shuji]
            }
            RANK 3 {
                SKILL_GROUP "Scholar Skills"
                SKILL "Composition"
                SKILL "Smithing"
                SKILL "Survival"
                TECHNIQUE_GROUP "Rank 1-3 Kata"
                ^"Ebb and Flow" [shuji]
                ^"Spin the Web" [shuji]
            }
            RANK 4 {
                SKILL_GROUP "Martial Skills"
                SKILL "Commerce"
                SKILL "Skulduggery"
                SKILL "Survival"
                TECHNIQUE_GROUP "Rank 1-4 Kata"
                ^"Silencing Stroke" [ninjutsu]
                ^"Wolf's Proposal" [shuji]
            }
            RANK 5 {
                SKILL_GROUP "Martial Skills"
                SKILL "Command"
                SKILL "Commerce"
                SKILL "Skulduggery"
                TECHNIQUE_GROUP "Rank 1-5 Kata"
                TECHNIQUE_GROUP "Rank 1-5 Ninjutsu"
                ^"Buoyant Arrival" [shuji]
            }
            RANK 6 {
                ^"Usher In the New Age"
            }
        }

    }

    # ===========================
    # NEW ADVANTAGES: DISTINCTIONS
    # ===========================

    # source (page 241)
    ^"Animal Trainer" DEF {
        EXTENDS #L5R266oP8qR0sT2uV4wX6y ^"Distinction"

        PROPERTIES {
            ^"Ring" STRING "Water"
            ^"Types" LIST ["Interpersonal", "Mental"]
        }

        EFFECT {
            "You are well versed in animal behaviors and effective techniques for training animals. You also know the telltale signs of hostility in both wild and domesticated animals."
            "When performing a check for which your animal training expertise is a benefit (such as a Medicine [Water] check to diagnose a sick animal or a Survival [Water] check to teach an animal to respond to a command), you may reroll up to two dice."
        }
    }

    # source (page 241)
    ^"Criminal Connections" DEF {
        EXTENDS #L5R266oP8qR0sT2uV4wX6y ^"Distinction"

        PROPERTIES {
            ^"Ring" STRING "Air"
            ^"Types" LIST ["Interpersonal"]
        }

        EFFECT {
            "You have cultivated useful allies and associates among Rokugan’s criminal underworld. You can use these contacts to find information or obtain illicit goods and services."
            "When performing a check that benefits from your criminal connections (such as a Skulduggery [Air] check to make contact with the underworld in an unfamiliar city or a Commerce [Air] check to sell stolen items at a higher price or without attracting attention), you may reroll up to two dice."
        }
    }

    # source (page 241)
    ^"Expert Tracker" DEF {
        EXTENDS #L5R266oP8qR0sT2uV4wX6y ^"Distinction"

        PROPERTIES {
            ^"Ring" STRING "Air"
            ^"Types" LIST ["Mental", "Physical"]
        }

        EFFECT {
            "You can detect subtle signs of a person or animal’s passage that others would overlook and can follow a trail across rivers, towns, and other obstacles that would cause most trackers to lose it."
            "When performing a check for which your tracking expertise applies (such as a Fitness [Air] check to follow an animal without being noticed or a Survival [Air] check to follow someone’s trail), you may reroll up to two dice."
        }
    }

    # source (page 241)
    ^"Friend of the Brotherhood" DEF {
        EXTENDS #L5R266oP8qR0sT2uV4wX6y ^"Distinction"

        PROPERTIES {
            ^"Ring" STRING "Void"
            ^"Types" LIST ["Interpersonal"]
        }

        EFFECT {
            "You are known as a benefactor and ally of the Brotherhood of Shinsei, and others believe you to be a pious and generous person unless given evidence to the contrary."
            "When performing a check for which you need to leverage your reputation for Shinseist piety (such as a Courtesy [Void] check to establish a spiritual connection with a monk or a Theology [Void] check to glean deeper wisdom from the Tao of Shinsei), you may reroll up to two dice."
        }
    }

    # source (page 242)
    ^"Hero of [Village]" DEF {
        EXTENDS #L5R266oP8qR0sT2uV4wX6y ^"Distinction"

        PROPERTIES {
            ^"Ring" STRING "Fire"
            ^"Types" LIST ["Fame", "Interpersonal"]
        }

        EFFECT {
            "You have a heroic reputation for deeds you undertook that benefited a particular village. The residents of that village do their best to aid you with any request you make (and praise you at every opportunity)."
            "When performing a check for which your heroic reputation is a benefit (such as a Command [Fire] check to rally peasants to defend their village against bandits or a Performance [Fire] check to impress others with tales of your heroics), you may reroll up to two dice."
        }
    }

    # source (page 242)
    ^"Kuge Lineage" DEF {
        EXTENDS #L5R266oP8qR0sT2uV4wX6y ^"Distinction"

        PROPERTIES {
            ^"Ring" STRING "Earth"
            ^"Types" LIST ["Interpersonal"]
        }

        EFFECT {
            "By dint of your birth, you are a member of the kuge, Rokugan’s nobility. Samurai of the buke caste must treat you with great respect"
            "When performing a check for which your hereditary authority is a benefit (such as a Command [Earth] check to silence a buke samurai or a Government [Earth] check to cite familiarity with the practices of the Imperial families), you may reroll up to two dice."
        }
    }

    # source (page 242)
    ^"Spiritual Protector" DEF {
        EXTENDS #L5R266oP8qR0sT2uV4wX6y ^"Distinction"

        PROPERTIES {
            ^"Ring" STRING "Void"
            ^"Types" LIST ["Spiritual"]
        }

        EFFECT {
            "For reasons known or unknown, a spirit watches over you and intercedes in subtle ways to protect you from harm. It may alert you to danger or interpose a mild obstacle to those who wish you harm."
            "When performing a check for which your spiritual protector is a benefit (such as Fitness [Void] check to avoid a surprise attack through sheer instinct or a Survival [Void] check to notice an imminent hazard), you may reroll up to two dice."
        }
    }

    # source (pages 242-243)
    ^"Well Connected" DEF {
        EXTENDS #L5R266oP8qR0sT2uV4wX6y ^"Distinction"

        PROPERTIES {
            ^"Ring" STRING "Water"
            ^"Types" LIST ["Interpersonal"]
        }

        EFFECT {
            "You have a number of influential connections among the courts and leadership of Rokugan, whose names you can subtly invoke to establish your own importance."
            "When performing a check for which your connections are a benefit (such as a Courtesy [Water] check to impress someone at court or a Government [Water] check to identify a useful contact among the local aristocracy), you may reroll up to two dice."
        }
    }

    # ===========================
    # NEW ADVANTAGES: PASSIONS
    # ===========================

    # source (page 243)
    ^"Bonsai" DEF {
        EXTENDS #L5R267zA9bC1dE3fG5hI7j ^"Passion"

        PROPERTIES {
            ^"Ring" STRING "Air"
            ^"Types" LIST ["Mental"]
        }

        EFFECT {
            "You know a great deal about the art of bonsai, including the tools and techniques used in its practice. You can judge the quality of a bonsai tree and tell when a piece has been neglected."
            "After performing a check to interact with a bonsai piece (such as an Aesthetics [Air] check to prune or maintain a tree or a Sentiment [Air] check to identify someone’s emotional response to a bonsai work) you remove 3 strife."
        }
    }

    # source (page 243)
    ^"City [Choose one]" DEF {
        EXTENDS #L5R267zA9bC1dE3fG5hI7j ^"Passion"

        PROPERTIES {
            ^"Ring" STRING "Water"
            ^"Types" LIST ["Interpersonal", "Mental"]
        }

        EFFECT {
            "You know a particular city extremely well and have extensive practical knowledge about it. You know as much about the city as any lifelong resident, including the popular locations, dangerous or disreputable areas, and open secrets."
            "After performing a check to learn or share knowledge of the particular city (such as a Courtesy [Water] check to befriend a local resident or a Culture [Water] check to find an establishment offering a particular service), you remove 3 strife."
        }
    }

    # source (page 243)
    ^"Gourmet" DEF {
        EXTENDS #L5R267zA9bC1dE3fG5hI7j ^"Passion"

        PROPERTIES {
            ^"Ring" STRING "Water"
            ^"Types" LIST ["Mental", "Interpersonal"]
        }

        EFFECT {
            "You can identify regional variations in cuisine and know a great deal about techniques of food preparation. You can always identify the ingredients in a dish, including those that are potentially dangerous."
            "After performing a check involving high-quality food (such as a Culture [Water] check to locate a place to dine in an unfamiliar city or a Labor [Water] check to prepare a fine meal), you remove 3 strife."
        }
    }

    # source (page 244)
    ^"Military History" DEF {
        EXTENDS #L5R267zA9bC1dE3fG5hI7j ^"Passion"

        PROPERTIES {
            ^"Ring" STRING "Earth"
            ^"Types" LIST ["Mental"]
        }

        EFFECT {
            "You can quickly identify historical or traditional military ploys from memory and can almost always suggest an appropriate tactic for the situation at hand based on a similar historical situation."
            "After performing a check related to your knowledge of military history (such as a Command [Earth] check to bolster troops’ resolve with a story of a similar historical battle or a Tactics [Earth] check to prepare a defense based on the attacker’s known strategies), you remove 3 strife."
        }
    }

    # source (page 244)
    ^"Navigator" DEF {
        EXTENDS #L5R267zA9bC1dE3fG5hI7j ^"Passion"

        PROPERTIES {
            ^"Ring" STRING "Fire"
            ^"Types" LIST ["Mental"]
        }

        EFFECT {
            "You can quickly make sense of even the most archaic, poor, or unfamiliar maps, and you always know which direction is north."
            "After performing a check to navigate (such as a Seafaring [Fire] check to chart a formerly unknown route at sea or a Survival [Fire] check to extrapolate your location in the wilderness based on the stars), you remove 3 strife."
        }
    }

    # source (page 244)
    ^"Researcher" DEF {
        EXTENDS #L5R267zA9bC1dE3fG5hI7j ^"Passion"

        PROPERTIES {
            ^"Ring" STRING "Air"
            ^"Types" LIST ["Mental"]
        }

        EFFECT {
            "You can cite the most authoritative works on most topics from memory and are never at a loss for where to begin researching a matter."
            "After performing a check to research a topic (such as a Culture [Air] check to locate a particular poem or a Medicine [Air] check to find all known records of a mysterious illness), you remove 3 strife."
        }
    }

    # source (page 244)
    ^"Rock Gardening" DEF {
        EXTENDS #L5R267zA9bC1dE3fG5hI7j ^"Passion"

        PROPERTIES {
            ^"Ring" STRING "Void"
            ^"Types" LIST ["Mental"]
        }

        EFFECT {
            "You know the proper methods of arranging a rock garden (karesansui) according to popular manuals on the topic, and you can explain the symbolism and significance of different arrangements and features."
            "After performing a check related to rock gardening (such as an Aesthetics [Void] check to detect a hidden meaning in a rock garden’s arrangement or a Meditation [Void] check to make sense of events while reflecting on a rock garden), you remove 3 strife."
        }
    }

    # ===========================
    # NEW DISADVANTAGES: ADVERSITIES
    # ===========================

    # source (page 245)
    ^"Adopted Peasant" DEF {
        EXTENDS #L5R268kL0mN2oP4qR6sT8u ^"Adversity"

        PROPERTIES {
            ^"Ring" STRING "Fire"
            ^"Types" LIST ["Interpersonal"]
        }

        EFFECT {
            "Although adopted by a samurai family, you were born a peasant. Other samurai who know this fact are likely to look down upon you and may use this fact against you socially."
            "When you make a check to deal authoritatively or collegially with a samurai who knows of your peasant birth (such as a Command [Fire] check to give an order to a subordinate or a Courtesy [Fire] check to impugn another's honor), you must choose and reroll two dice showing (su) or (ex) results. After resolving the check, if you failed, you regain 1 Void point."
        }
    }

    # source (page 245)
    ^"Allergy [Choose one]" DEF {
        EXTENDS #L5R268kL0mN2oP4qR6sT8u ^"Adversity"

        PROPERTIES {
            ^"Ring" STRING "Air"
            ^"Types" LIST ["Physical"]
        }

        EFFECT {
            "Choose a common natural substance. You have a strong allergy to it, and exposure causes severe discomfort or even a life-threatening reaction."
            "When you make a check that exposes you to the source of your allergy (such as a Fitness [Air] check to run through a swarm of bees or a Courtesy [Air] check to sample a dish containing your allergen without offending your host), you must choose and reroll two dice showing (su) or (ex) results. After resolving the check, if you failed, you regain 1 Void point."
        }
    }

    # source (page 245)
    ^"Cursed Lineage" DEF {
        EXTENDS #L5R268kL0mN2oP4qR6sT8u ^"Adversity"

        PROPERTIES {
            ^"Ring" STRING "Void"
            ^"Types" LIST ["Interpersonal", "Spiritual"]
        }

        EFFECT {
            "Your family carries a curse. Decide with the GM how this curse manifests."
            "When making a check that does or could invoke the curse (such as a Culture [Void] check to understand your family history or a Theology [Void] check to seek your ancestors' blessing), you must choose and reroll two dice showing (su) or (ex) results. After resolving the check, if you failed, you regain 1 Void point."
        }
    }

    # source (page 246)
    ^"Despised in [City]" DEF {
        EXTENDS #L5R268kL0mN2oP4qR6sT8u ^"Adversity"

        PROPERTIES {
            ^"Ring" STRING "Water"
            ^"Types" LIST ["Fame", "Interpersonal"]
        }

        EFFECT {
            "You are infamous among the residents of a particular city (chosen with the GM). People within this city resist cooperating with you and may actively hinder your activities within the city."
            "When performing a check to gain assistance or cooperation from a resident of the city that despises you (such as a Courtesy [Water] check to learn the latest sake house rumors or a Commerce [Water] check to purchase goods within the city), you must choose and reroll two dice showing (su) or (ex) results. After resolving the check, if you failed, you regain 1 Void point."
        }
    }

    # source (page 246)
    ^"Hunted by Chikushodo" DEF {
        EXTENDS #L5R268kL0mN2oP4qR6sT8u ^"Adversity"

        PROPERTIES {
            ^"Ring" STRING "Earth"
            ^"Types" LIST ["Spiritual"]
        }

        EFFECT {
            "Animals dislike you and show it in a variety of ways. Dogs bark in your presence, cats hiss, and wild animals flee from you or become aggressive."
            "When performing a check to interact with an animal (such as a Survival [Earth] check to calm a frightened horse or a Fitness [Earth] check to go unnoticed by a hungry wolf), you must choose and reroll two dice showing (su) or (ex) results. After resolving the check, if you failed, you regain 1 Void point."
        }
    }

    # source (page 246)
    ^"Skepticism" DEF {
        EXTENDS #L5R268kL0mN2oP4qR6sT8u ^"Adversity"

        PROPERTIES {
            ^"Ring" STRING "Void"
            ^"Types" LIST ["Mental", "Spiritual"]
        }

        EFFECT {
            "You do not believe in the divinity of the Kami, the existence of spirits, or the veracity of the Celestial Order. If discovered, this constitutes grave blasphemy and might even be a crime against the Emperor."
            "When you make a check that relies on the existence of the Spirit Realms (such as a Medicine [Void] check to diagnose a malady of the soul or a Theology [Void] check to detect the presence of a kami), you must choose and reroll two dice showing (su) or (ex) results. After resolving the check, if you failed, you regain 1 Void point."
        }
    }

    # ===========================
    # NEW DISADVANTAGES: ANXIETIES
    # ===========================

    # source (page 246)
    ^"Accustomed to Luxury" DEF {
        EXTENDS #L5R269vW1xY3zA5bC7dE9f ^"Anxiety"

        PROPERTIES {
            ^"Ring" STRING "Earth"
            ^"Types" LIST ["Mental"]
        }

        EFFECT {
            "You live a life of luxury and chafe at the idea of abiding the accommodations of your lessers or sleeping in the wilderness."
            "After performing a check that requires you to remain in unacceptable accommodations for an extended period (such as a Survival [Earth] check to set up a campsite or a Commerce [Earth] check to make arrangements to stay at a rural inn), you receive 3 strife. If this is the first time this has occurred this scene, gain 1 Void point."
        }
    }

    # source (page 247)
    ^"Claustrophobia" DEF {
        EXTENDS #L5R269vW1xY3zA5bC7dE9f ^"Anxiety"

        PROPERTIES {
            ^"Ring" STRING "Water"
            ^"Types" LIST ["Mental"]
        }

        EFFECT {
            "You are intensely afraid of being enclosed in a small space or a space without an easy exit. You avoid entering such places if at all possible, and you feel anxious and distracted while in such a place."
            "After making a check that requires to you enter an enclosed space (such as a Fitness [Water] check to crawl through a narrow passage or a Survival [Water] check to investigate a cave), you receive 3 strife. If this is the first time this has occurred this scene, gain 1 Void point."
        }
    }

    # source (page 247)
    ^"False Identity" DEF {
        EXTENDS #L5R269vW1xY3zA5bC7dE9f ^"Anxiety"

        PROPERTIES {
            ^"Ring" STRING "Air"
            ^"Types" LIST ["Interpersonal"]
        }

        EFFECT {
            "You have an elaborate false identity that you have maintained over a long period of time. Many of the people you interact with regularly know you by this identity, and you may even have a family that does not know the truth."
            "After performing a check to maintain your false identity (such as a Courtesy [Air] check to lie about your past or a Skulduggery [Air] check to surreptitiously hide evidence of the truth), you receive 3 strife. If this is the first time this has occurred this scene, gain 1 Void point."
        }
    }

    # source (page 247)
    ^"Loathing for Peasants" DEF {
        EXTENDS #L5R269vW1xY3zA5bC7dE9f ^"Anxiety"

        PROPERTIES {
            ^"Ring" STRING "Water"
            ^"Types" LIST ["Interpersonal", "Mental"]
        }

        EFFECT {
            "You find peasants to be repugnant, and even being around them makes your skin crawl. You do your best to avoid interacting with peasants, and your disgust is difficult to hide."
            "After performing a check that requires you to interact with peasants (such as a Culture [Water] check to observe the customs of farmers or a Courtesy [Water] check to question a village leader), you receive 3 strife. If this is the first time this has occurred this scene, gain 1 Void point."
        }
    }

    # source (page 248)
    ^"Loneliness" DEF {
        EXTENDS #L5R269vW1xY3zA5bC7dE9f ^"Anxiety"

        PROPERTIES {
            ^"Ring" STRING "Void"
            ^"Types" LIST ["Interpersonal", "Mental"]
        }

        EFFECT {
            "You derive energy and pleasure from social interactions, and being alone makes you uncomfortable or morose. You look for excuses to avoid being alone and find it difficult to turn down any social engagement."
            "After performing a check that requires you to be alone (such as a Composition [Void] check to write a letter declining an invitation to the theater or a Meditation [Void] check to spend a prolonged time in dedicated introspection), you receive 3 strife. If this is the first time this has occurred this scene, gain 1 Void point."
        }
    }

    # ===========================
    # NEW TECHNIQUES
    # ===========================

    # source (pages 248-252)
    ^"Emerald Empire Techniques" DEF {
        APPLIES TO [#L5R003xY4zA6bC8dE0fG2hI ^"Samurai"]

        ENTRIES {
            #qx68JMVWvLSjhpW93oHMnM ^"Spin the Web" DEF {
                ^"Type" STRING "Shūji"
                ^"Subtype" STRING "Air Shūji (Kolat)"
                ^"Rank" INTEGER 3
                ^"Activation" STRING "Once per game session, during a narrative scene or as a downtime activity"
                ^"Check" STRING "TN 2 Skulduggery (Air)"
                ^"Effect" STRING "If you succeed, you recruit a minor or previously unknown NPC (at the GM's discretion) as a Kolat asset. Record them under your Relationships. From now on, once per game session you may call on one of your assets whom you can reasonably contact. The NPC can aid you during a single scene, doing their best to perform tasks you assign them, or they can conduct a single downtime activity. If a profile is required, use an appropriate NPC of the GM's choice."
                ^"Opportunities" STRING "Air (op): If you succeed, choose one skill. The NPC has a number of ranks in that skill equal to your school rank and can perform checks with that skill to assist you."
            }

            #8ImsWcnNktegB5jaUT03UR ^"Awe of Heaven" DEF {
                ^"Type" STRING "Shūji"
                ^"Subtype" STRING "Void Shūji (Imperial)"
                ^"Rank" INTEGER 4
                ^"Activation" STRING "Once per scene, as an Attack and Scheme action"
                ^"Check" STRING "you may make a Command (Void) check targeting any number of characters in the scene. The TN of the check is equal to the highest status rank among your targets."
                ^"Effect" STRING "If you succeed, each target suffers the Silenced condition."
            }
        }

    }

