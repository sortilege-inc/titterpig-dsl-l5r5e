EXTENSION "L5R5e_Emerald_Empire" EXTENDS "L5R5e_Core_Character" {
    NAME "Legend of the Five Rings 5th Edition - Emerald Empire: New Player Options"
    VERSION "0.5.2"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-03-01"

    # Emerald Empire (Chapter 7): Imperial families, new schools,
    # advantages, disadvantages, techniques, and titles.
    # This extension adds options from the Emerald Empire sourcebook
    # to the core character creation and advancement systems.

    # ===========================
    # IMPERIAL FAMILIES
    # ===========================

    # source (pages 228-231)
    ^"Imperial Families" DEF {
        EXTENDS #L5R250aB2cD4eF6gH8iJ0k ^"Clan"
        APPLIES TO [#L5R003xY4zA6bC8dE0fG2hI ^"Samurai"]

        PROPERTIES {
            ^"Clan Name" STRING "Imperial" FIXED
            ^"Clan Type" STRING "Imperial"
            ^"Clan Ring Bonus" DEF { ^"Air" INTEGER 1 }
            ^"Clan Skill Bonus" DEF { ^"Government" INTEGER 1 }
            ^"Clan Status" INTEGER DEFAULT 40
        }

        FAMILIES {
            ^"Miya"
            ^"Otomo"
            ^"Seppun"
        }

    }

    # ===========================
    # IMPERIAL FAMILIES
    # ===========================

    #L5REE50hI5jK7lM9nO1pQ3r ^"Miya" DEF {
        EXTENDS #L5R251lM3nO5pQ7rS9tU1v ^"Family"
        APPLIES TO [#L5R003xY4zA6bC8dE0fG2hI ^"Samurai"]

        PROPERTIES {
            ^"Family Name"     STRING "Miya" FIXED
            ^"Clan"            STRING "Imperial"
            ^"Ring Increase" DEF { CHOOSE 1 [^"Air", ^"Earth"] INTEGER 1 }
            ^"Skill Increases" DEF {
                ^"Courtesy" INTEGER 1
                ^"Culture" INTEGER 1
            }
            ^"Glory"           INTEGER 44
            ^"Wealth" DEF { ^"Count" INTEGER 8  ^"Type" STRING "koku"  ^"Starting" BOOLEAN true }
        }
    }

    #L5REE51sT6uV8wX0yZ2aB4c ^"Otomo" DEF {
        EXTENDS #L5R251lM3nO5pQ7rS9tU1v ^"Family"
        APPLIES TO [#L5R003xY4zA6bC8dE0fG2hI ^"Samurai"]

        PROPERTIES {
            ^"Family Name"     STRING "Otomo" FIXED
            ^"Clan"            STRING "Imperial"
            ^"Ring Increase" DEF { CHOOSE 1 [^"Air", ^"Water"] INTEGER 1 }
            ^"Skill Increases" DEF {
                ^"Culture" INTEGER 1
                ^"Sentiment" INTEGER 1
            }
            ^"Glory"           INTEGER 43
            ^"Wealth" DEF { ^"Count" INTEGER 9  ^"Type" STRING "koku"  ^"Starting" BOOLEAN true }
        }
    }

    #L5REE52dE7fG9hI1jK3lM5n ^"Seppun" DEF {
        EXTENDS #L5R251lM3nO5pQ7rS9tU1v ^"Family"
        APPLIES TO [#L5R003xY4zA6bC8dE0fG2hI ^"Samurai"]

        PROPERTIES {
            ^"Family Name"     STRING "Seppun" FIXED
            ^"Clan"            STRING "Imperial"
            ^"Ring Increase" DEF { CHOOSE 1 [^"Earth", ^"Void"] INTEGER 1 }
            ^"Skill Increases" DEF {
                ^"Meditation" INTEGER 1
                ^"Theology" INTEGER 1
            }
            ^"Glory"           INTEGER 45
            ^"Wealth" DEF { ^"Count" INTEGER 6  ^"Type" STRING "koku"  ^"Starting" BOOLEAN true }
        }
    }

    # ===========================
    # NEW SCHOOLS
    # ===========================

    # source (page 232)
    ^"Miya Cartographer" DEF {
        EXTENDS #L5R252wX4yZ6aB8cD0eF2g ^"School"
        APPLIES TO [#L5R003xY4zA6bC8dE0fG2hI ^"Samurai"]

        PROPERTIES {
            ^"Clan" STRING "Imperial"
            ^"School Name" STRING "Miya Cartographer" FIXED
            ^"Roles" LIST ["Artisan", "Courtier"]
            ^"Ring Increase" DEF {
                ^"Air" INTEGER 1
                ^"Earth" INTEGER 1
            }
            ^"Starting Skills" DEF { CHOOSE 5 [^"Aesthetics", ^"Composition", ^"Culture", ^"Fitness", ^"Government", ^"Seafaring", ^"Survival"] INTEGER 1 }
            ^"Starting Honor" INTEGER DEFAULT 50
            ^"Techniques Available" LIST ["Kata", "Rituals", "Shūji"]
        }

        STARTING_TECHNIQUES {
            KATA CHOOSE 1 [^"Striking as Earth", ^"Warrior's Resolve"]
            SHUJI CHOOSE 1 [^"Artisan's Appraisal", ^"Civility Foremost"]
        }

        SCHOOL_ABILITY "Well Traveled" {
            "You always know which way is north, and you are always able to find a landmark useful for navigation. When making a check to recall or ascertain geographical, political, or societal information, you may add a number of kept (ring) set to (op) or (su) results equal to your school rank."
        }

        MASTERY_ABILITY ^"Emerald Explorer" {
            "Once per scene as a Support action, you may make a TN 1 Survival (Earth) check targeting one character in the scene. If you succeed on the check, that character and an additional number of characters you choose equal to your bonus successes ignore all negative effects of terrain qualities until the end of the scene."
        }
        STARTING_OUTFIT [
            "traveling clothes", "wakizashi (short sword)",
            "yumi (bow) and quiver of arrows", "knife",
            "calligraphy set", "traveling pack", "personal chop",
            "an assortment of maps in scroll cases",
            "an attendant (see page 64 of the core rulebook) or Rokugani pony (see page 326 of the core rulebook)"
        ]

        CURRICULUM {
            RANK 1 {
                SKILL_GROUP "Artisan Skills"
                SKILL "Culture"
                SKILL "Fitness"
                SKILL "Survival"
                TECHNIQUE_GROUP "Rank 1 Earth Shūji"
                ^"Slippery Maneuvers" [shuji]
                ^"Threshold Barrier" [ritual]
            }
            RANK 2 {
                SKILL_GROUP "Scholar Skills"
                SKILL "Games"
                SKILL "Martial Arts [Melee]"
                SKILL "Survival"
                TECHNIQUE_GROUP "Rank 1-2 Kata"
                ^"The Wind Blows Both Ways" [shuji]
                ^"Feigned Opening" [shuji]
            }
            RANK 3 {
                SKILL_GROUP "Trade Skills"
                SKILL "Courtesy"
                SKILL "Culture"
                SKILL "Martial Arts [Ranged]"
                TECHNIQUE_GROUP "Rank 1-3 Air Shūji"
                ^"Crimson Leaves Strike" [kata]
                ^"All Arts Are One" [shuji]
            }
            RANK 4 {
                SKILL_GROUP "Scholar Skills"
                SKILL "Courtesy"
                SKILL "Martial Arts [Unarmed]"
                SKILL "Meditation"
                TECHNIQUE_GROUP "Rank 1-4 Kata"
                ^"Bend with the Storm" [shuji]
                ^"Regal Bearing" [shuji]
            }
            RANK 5 {
                SKILL_GROUP "Artisan Skills"
                SKILL "Command"
                SKILL "Culture"
                SKILL "Seafaring"
                TECHNIQUE_GROUP "Rank 1-5 Earth Shūji"
                ^"Awe of Heaven" [shuji]
                ^"Bravado" [shuji]
            }
            RANK 6 {
                ^"Emerald Explorer"
            }
        }

    }

    # source (page 233)
    ^"Miya Herald" DEF {
        EXTENDS #L5R252wX4yZ6aB8cD0eF2g ^"School"
        APPLIES TO [#L5R003xY4zA6bC8dE0fG2hI ^"Samurai"]

        PROPERTIES {
            ^"Clan" STRING "Imperial"
            ^"School Name" STRING "Miya Herald" FIXED
            ^"Roles" LIST ["Courtier"]
            ^"Ring Increase" DEF {
                ^"Air" INTEGER 1
                ^"Water" INTEGER 1
            }
            ^"Starting Skills" DEF { CHOOSE 5 [^"Command", ^"Composition", ^"Courtesy", ^"Fitness", ^"Seafaring", ^"Sentiment", ^"Survival"] INTEGER 1 }
            ^"Starting Honor" INTEGER DEFAULT 50
            ^"Techniques Available" LIST ["Kata", "Rituals", "Shūji"]
        }

        STARTING_TECHNIQUES {
            SHUJI CHOOSE 1 [^"Cadence", ^"Honest Assessment"]
            SHUJI CHOOSE 1 [^"Shallow Waters", ^"Weight of Duty"]
        }

        SCHOOL_ABILITY "Voice of the Emperor" {
            "Once per round, after a character at range 0-4 succeeds on an Attack or Scheme action check, you may cause them to receive strife equal to your school rank."
        }

        MASTERY_ABILITY ^"Blessings of the Emperor" {
            "Once per scene as a Scheme action, you may make a TN 4 Command (Air) check targeting a number of characters in the scene up to your glory rank. If you succeed, until the end of the scene, the targets must forfeit honor equal to twice their honor rank and glory equal to twice their glory rank before choosing you as the target of an Attack action, and increase the TN of their Attack actions targeting you by 2. This effect persists until the end of the scene, or until you attack an affected character or their allies. (op)+: Choose one ally per (op) spent this way. The effects of this ability also apply to targets’ attacks against the chosen allies."
        }
        STARTING_OUTFIT [
            "traveling clothes", "ceremonial clothes",
            "wakizashi (short sword)",
            "yumi (bow) and quiver of arrows or tessen (war fan)",
            "calligraphy set", "traveling pack",
            "satchel of Imperial proclamations",
            "personal chop", "an attendant (see page 64 of the core rulebook) or Rokugani pony (see page 326 of the core rulebook)"
        ]

        CURRICULUM {
            RANK 1 {
                SKILL_GROUP "Social Skills"
                SKILL "Culture"
                SKILL "Fitness"
                SKILL "Survival"
                TECHNIQUE_GROUP "Rank 1 Water Shūji"
                ^"Feigned Opening" [shuji]
                ^"Courtier's Resolve" [shuji]
            }
            RANK 2 {
                SKILL_GROUP "Trade Skills"
                SKILL "Courtesy"
                SKILL "Culture"
                SKILL "Martial Arts [Melee]"
                TECHNIQUE_GROUP "Rank 1-2 Air Shūji"
                ^"Ebb and Flow" [shuji]
                ^"Tributaries of Trade" [shuji]
            }
            RANK 3 {
                SKILL_GROUP "Scholar Skills"
                SKILL "Command"
                SKILL "Courtesy"
                SKILL "Survival"
                TECHNIQUE_GROUP "Rank 1-3 Earth Shūji"
                ^"Awe of Heaven" [shuji]
                ^"The Wind Blows Both Ways" [shuji]
            }
            RANK 4 {
                SKILL_GROUP "Artisan Skills"
                SKILL "Command"
                SKILL "Fitness"
                SKILL "Survival"
                TECHNIQUE_GROUP "Rank 1-4 Water Shūji"
                ^"Buoyant Arrival" [shuji]
                ^"Pillar of Calm" [shuji]
            }
            RANK 5 {
                SKILL_GROUP "Social Skills"
                SKILL "Culture"
                SKILL "Sentiment"
                SKILL "Survival"
                TECHNIQUE_GROUP "Rank 1-5 Void Shūji"
                ^"Sear the Wound" [shuji]
                ^"The Immovable Hand of Peace" [shuji]
            }
            RANK 6 {
                ^"Blessings of the Emperor"
            }
        }

    }

    # source (page 234)
    ^"Otomo Schemer" DEF {
        EXTENDS #L5R252wX4yZ6aB8cD0eF2g ^"School"
        APPLIES TO [#L5R003xY4zA6bC8dE0fG2hI ^"Samurai"]

        PROPERTIES {
            ^"Clan" STRING "Imperial"
            ^"School Name" STRING "Otomo Schemer" FIXED
            ^"Roles" LIST ["Courtier"]
            ^"Ring Increase" DEF {
                ^"Air" INTEGER 1
                ^"Fire" INTEGER 1
            }
            ^"Starting Skills" DEF { CHOOSE 5 [^"Command", ^"Composition", ^"Courtesy", ^"Culture", ^"Design", ^"Government", ^"Sentiment"] INTEGER 1 }
            ^"Starting Honor" INTEGER DEFAULT 45
            ^"Techniques Available" LIST ["Kata", "Rituals", "Shūji"]
        }

        STARTING_TECHNIQUES {
            SHUJI CHOOSE 1 [^"Courtier's Resolve", ^"Stirring the Embers"]
            SHUJI ^"Slippery Maneuvers"
        }

        SCHOOL_ABILITY "Necessary Actions" {
            "You never forfeit honor or glory in order to lie or deceive for the good of the Emperor and Empire (in your opinion). However, you must forfeit twice as much honor or glory to lie for your personal gain (again, in your opinion). When a character stakes or forfeits an amount of honor or glory in order to act against your desires, you may force them to increase that amount by your school rank."
        }

        MASTERY_ABILITY ^"Majesty of the Throne" {
            "Once per scene, as a Scheme action, you may make a Command (Water) check targeting any number of characters at range 0–5 of you. The TN of this check is equal to the highest status rank among your targets. If you succeed, all targets suffer the Dazed and Disoriented conditions."
        }
        STARTING_OUTFIT [
            "ceremonial clothes", "wakizashi (short sword)",
            "any one weapon of rarity 6 or lower",
            "calligraphy set", "traveling pack",
            "a trustworthy attendant"
        ]

        CURRICULUM {
            RANK 1 {
                SKILL_GROUP "Social Skills"
                SKILL "Composition"
                SKILL "Culture"
                SKILL "Government"
                TECHNIQUE_GROUP "Rank 1 Air Shūji"
                ^"Civility Foremost" [shuji]
                ^"Tea Ceremony" [ritual]
            }
            RANK 2 {
                SKILL_GROUP "Scholar Skills"
                SKILL "Command"
                SKILL "Courtesy"
                SKILL "Martial Arts [Melee]"
                TECHNIQUE_GROUP "Rank 1-2 Water Shūji"
                ^"Awe of Heaven" [shuji]
                ^"Prey on the Weak" [shuji]
            }
            RANK 3 {
                SKILL_GROUP "Artisan Skills"
                SKILL "Commerce"
                SKILL "Courtesy"
                SKILL "Sentiment"
                TECHNIQUE_GROUP "Rank 1-3 Fire Shūji"
                ^"Regal Bearing" [shuji]
                ^"The Wind Blows Both Ways" [shuji]
            }
            RANK 4 {
                SKILL_GROUP "Scholar Skills"
                SKILL "Aesthetics"
                SKILL "Command"
                SKILL "Skulduggery"
                TECHNIQUE_GROUP "Rank 1-4 Fire Shūji"
                ^"Buoyant Arrival" [shuji]
                ^"Wolf's Proposal" [shuji]
            }
            RANK 5 {
                SKILL_GROUP "Social Skills"
                SKILL "Composition"
                SKILL "Culture"
                SKILL "Design"
                TECHNIQUE_GROUP "Rank 1-5 Air Shūji"
                ^"Sear the Wound" [shuji]
                ^"The Immovable Hand of Peace" [shuji]
            }
            RANK 6 {
                ^"Majesty of the Throne"
            }
        }

    }

    # source (page 235)
    ^"Seppun Astrologer" DEF {
        EXTENDS #L5R252wX4yZ6aB8cD0eF2g ^"School"
        APPLIES TO [#L5R003xY4zA6bC8dE0fG2hI ^"Samurai"]

        PROPERTIES {
            ^"Clan" STRING "Imperial"
            ^"School Name" STRING "Seppun Astrologer" FIXED
            ^"Roles" LIST ["Shugenja", "Artisan"]
            ^"Ring Increase" DEF {
                ^"Air" INTEGER 1
                ^"Water" INTEGER 1
            }
            ^"Starting Skills" DEF { CHOOSE 3 [^"Composition", ^"Government", ^"Medicine", ^"Meditation", ^"Sentiment", ^"Theology"] INTEGER 1 }
            ^"Starting Honor" INTEGER DEFAULT 40
            ^"Techniques Available" LIST ["Invocations", "Rituals", "Shūji"]
        }

        STARTING_TECHNIQUES {
            INVOCATION ^"Bind the Shadow"
            INVOCATION CHOOSE 1 [^"Dominion of Suijin", ^"Jade Strike"]
            RITUAL ^"Divination"
            RITUAL ^"Commune with the Spirits"
            RITUAL ^"Threshold Barrier"
        }

        SCHOOL_ABILITY "Just as Predicted" {
            "At the beginning of a game session or as a downtime activity, you may make a TN 1 Theology check using any ring. If you succeed, choose a number of kept dice up to your school rank to reserve. Until the end of the game session or the next downtime scene, when any character makes a skill check using the chosen ring, you may replace one or more kept dice with the same number of reserved dice of the same type."
        }

        MASTERY_ABILITY ^"Foreseen in the Stars" {
            "Once per game session, you may spend 1 Void point to reveal that you have foreseen an event in the current scene. You may retroactively declare one or more preparations you have taken, subject to the GM's approval. If any preparations would require a skill check, such as the preparation of a ward, you make the check when you use this ability."
        }
        STARTING_OUTFIT [
            "sanctified robes", "concealed armor",
            "wakizashi (short sword)", "bō (staff) or knife",
            "calligraphy set", "traveling pack",
            "scroll satchel", "divination kit"
        ]

        CURRICULUM {
            RANK 1 {
                SKILL_GROUP "Scholar Skills"
                SKILL "Composition"
                SKILL "Skulduggery"
                SKILL "Tactics"
                TECHNIQUE_GROUP "Rank 1 Water Invocations"
                ^"Heart of the Water Dragon" [invocation]
                ^"Ancestry Unearthed" [shuji]
            }
            RANK 2 {
                SKILL_GROUP "Scholar Skills"
                SKILL "Command"
                SKILL "Composition"
                SKILL "Meditation"
                TECHNIQUE_GROUP "Rank 1-2 Air Invocations"
                ^"Ebb and Flow" [shuji]
                ^"Symbol of Earth" [invocation]
            }
            RANK 3 {
                SKILL_GROUP "Martial Skills"
                SKILL "Sentiment"
                SKILL "Smithing"
                SKILL "Theology"
                TECHNIQUE_GROUP "Rank 1-3 Earth Invocations"
                ^"False Realm of the Fox Spirits" [invocation]
                ^"Vapor of Nightmares" [invocation]
            }
            RANK 4 {
                SKILL_GROUP "Artisan Skills"
                SKILL "Sentiment"
                SKILL "Survival"
                SKILL "Theology"
                TECHNIQUE_GROUP "Rank 1-4 Air Invocations"
                ^"Tomb of Jade" [invocation]
                ^"A Samurai's Fate" [shuji]
            }
            RANK 5 {
                SKILL_GROUP "Scholar Skills"
                SKILL "Composition"
                SKILL "Skulduggery"
                SKILL "Tactics"
                TECHNIQUE_GROUP "Rank 1-5 Water Invocations"
                ^"Sear the Wound" [shuji]
                ^"The Soul's Blade" [invocation]
            }
            RANK 6 {
                ^"Foreseen in the Stars"
            }
        }

    }

