EXTENSION "L5R5e_Fields_of_Victory_Mass_Battle" EXTENDS "L5R5e_Core_Systems" {
    NAME "Legend of the Five Rings 5th Edition - Fields of Victory: Expanded Mass Battle Rules"
    VERSION "0.5.2"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-03-01"

    # Fields of Victory (Chapter 3): Expanded mass battle rules including
    # marshaling armies, supplemental forces (mercenaries, allies),
    # doctrines, equipment upgrades, army maintenance, hostages,
    # battle zones, new terrain types, and the March action.

    # ===========================
    # MARSHALING AN ARMY
    # ===========================

    # source stat block (page 109)
    ^"Marshaling an Army" DEF {
        APPLIES TO [#t9446c0a7f578c8eaf296f ^"System"]

        PROPERTIES {
            ^"Activation" STRING "Downtime activity"
            ^"Check" STRING "TN 3 Command"
            ^"Frequency" STRING "Once per month per set of holdings"
        }

        ^"Table 3-1: Determining Army Strength" DEF {

            ENTRIES {
                #fMzQPFxFcs8uUodFydAtB7 ^"Status 100" DEF    { ^"Maximum Strength" INTEGER 150 }
                #zztiG9ME34WKSwPfD8Cp4G ^"Status 90-99" DEF  { ^"Maximum Strength" INTEGER 120 }
                #xmn6Wjz7uqntYHLwaaxpwc ^"Status 80-89" DEF  { ^"Maximum Strength" INTEGER 100 }
                #F9oNje7GTQHWabs2MEw9rI ^"Status 70-79" DEF  { ^"Maximum Strength" INTEGER 80 }
                #jXSOKd0GWv9pt7soEmzFb5 ^"Status 60-69" DEF  { ^"Maximum Strength" INTEGER 65 }
                #1aYxUPoHKqAFasrY4fll13 ^"Status 50-59" DEF  { ^"Maximum Strength" INTEGER 60 }
                #YyL08tSgJuGNBcNQoMpVX5 ^"Status 40-49" DEF  { ^"Maximum Strength" INTEGER 55 }
                #lcoOXV7UVR338uKlfDvSgz ^"Status 30-39" DEF  { ^"Maximum Strength" INTEGER 35 }
                #vCDcqctLNN1ffEIrYDB0Ig ^"Status 24-29" DEF  { ^"Maximum Strength" INTEGER 20 }
                #wwblK6zDMW62ubxnrYIKB1 ^"Status 20-24" DEF  { ^"Maximum Strength" INTEGER 15 }
                #f8R8oKQooR4FIVgKrBYDrG ^"Status 0-19" DEF   { ^"Maximum Strength" INTEGER 5 }
            }

        }

        ^"Table 3-2: Determining Army Discipline" DEF {

            ENTRIES {
                #jGseV7ffipzJrGvWrpkI98 ^"4+ Bonus Successes" DEF { ^"Discipline" STRING "60 + ranks in Government + glory rank" }
                #EbXZIo9PZ69w4CoGtriUuR ^"3 Bonus Successes" DEF  { ^"Discipline" STRING "40 + ranks in Government + glory rank" }
                #Ns3pQmFnV1QKaiS2zBdv8O ^"2 Bonus Successes" DEF  { ^"Discipline" STRING "25 + ranks in Government" }
                #2kJgwGwSPt28OAYuXNdKeA ^"1 Bonus Success" DEF    { ^"Discipline" STRING "15 + ranks in Government" }
                #2CKMkI03uhdm7mHlJbtRPU ^"0 Bonus Successes" DEF  { ^"Discipline" STRING "10 + ranks in Government" }
            }

            RULES {
                #L5RFVMB03sT4uV6wX8yZ0a: discipline_from_bonus_successes "The army's discipline is set by the character's bonus successes and their honor (see Table 3–2: Determining Army Discipline)."
            }
        }

        ^"Table 3-3: Spending Opportunity while Marshaling" DEF {

            ENTRIES {
                #WNlsXl9fg7VMVYviKxRMIu ^"Any (op)+" DEF {
                    ^"Effect" STRING "Reduce the TN of your first army maintenance check (see page 115) by 1 per (op) spent this way."
                }
                #2yBIYrcjsGgjtGWw4RYqjD ^"Earth (op)" DEF {
                    ^"Effect" STRING "In addition to the army, you are given use of a fortification near your lands for the war effort. This fortification counts as an outpost (reduce attrition suffered by 2, difficulty value 6)."
                }
                #VTfSRzQekhDpizV8Nm9pLX ^"Earth (op)(op)" DEF {
                    ^"Effect" STRING "Increase the army's discipline by 5."
                }
                #xd1mrhcjwU0XXn5bVxcWIm ^"Water (op)+" DEF {
                    ^"Effect" STRING "In addition to the army, you raise 100 koku per (op) spent this way. You must forfeit 10 honor to spend this money on anything but equipment upgrades (see page 114), mercenary forces (see page 110), or other expenses that the GM deems to benefit the army or the cause."
                }
                #G3p58mBoe6t14VoIIYQECe ^"Water (op)(op)" DEF {
                    ^"Effect" STRING "The army gains one of the following equipment upgrades (see page 114): Baggage Train, Battlefield Medical Supplies."
                }
                #ws12JpLyHWws6ttCtbqINB ^"Fire (op)" DEF {
                    ^"Effect" STRING "For the first mass battle in which the army participates, reduce the TN of each of its leaders first Assault actions by 1 (to a minimum of 1)."
                }
                #4fDGc83OwEJ1rHg5u2xXJx ^"Fire (op)(op)" DEF {
                    ^"Effect" STRING "Increase the army's strength by 5."
                }
                #MqXtdkOWrDuAb00v1puPIs ^"Air (op)" DEF {
                    ^"Effect" STRING "The army assembles without attracting the attention of any local powers not currently at war with you."
                }
                #O2bYHTPdQRmSe8OXFnJB4f ^"Air (op)(op)" DEF {
                    ^"Effect" STRING "One cohort gains one of the following doctrines (see page 112): Out of Nowhere, Sappers."
                }
                #q7X4mg4vwa34r2nUqoaaCB ^"Void (op)" DEF {
                    ^"Effect" STRING "The army assembles at a place of your choosing (that a large numbers of soldiers could plausibly reach) in up to one month in the future rather than assembling immediately at your current location."
                }
                #ZWwiFzdkmGIXSciDENpAPj ^"Void (op)(op)" DEF {
                    ^"Effect" STRING "Increase the army's strength and discipline by 3."
                }
            }

            RULES {
                #L5RFVMB05kL6mN8oP0qR2s: opportunity_enhances_marshaled_army "A character can spend (op) from the check to marshal their army in a number of ways described in Table 3–3: Spending Opportunity while Marshaling an Army (see page 111)."
            }
        }

        RULES {
            #L5RFVMB07cD8eF0gH2iJ4k: marshaling_check "The Marshaling Check: To raise an army, a character must have access to their holdings and retainers (or community, for commoners), and must make a TN 3 Command check as a downtime activity. If the character succeeds, they form an army that consists of their retainers. The army's maximum strength is set by the character's status (see Table 3–1: Determining Army Strength), although a character can always choose to form a smaller army (to a minimum of 5) if they desire, as smaller armies are easier to maintain."
            #L5RFVMB08lM9nO1pQ3rS5t: once_per_month_per_holdings "Generally, a marshaling check can only be attempted once per month for a given set of holdings, though the GM may alter that restriction as the narrative dictates."
            #L5RFVMB09uV0wX2yZ4aB6c: supplies_for_one_month_included "The check to marshal an army not only gathers the troops to the field, but also the support staff required and the supplies needed (food, gear, travel equipment) to keep them fighting for one month. At the start of each subsequent month, a character must make another check to keep their army functional and loyal (see Maintaining an Army on Campaign on page 115)."
        }
    }

    # ===========================
    # SUPPLEMENTAL FORCES
    # ===========================

    # source stat block (page 110)
    ^"Supplemental Forces" DEF {
        APPLIES TO [#t9446c0a7f578c8eaf296f ^"System"]

        ^"Raising Additional Forces" DEF {

            PROPERTIES {
                ^"Activation" STRING "New marshaling check at GM discretion"
                ^"Status Modifier Examples" STRING "A large storehouse of food: +10\n\nA town's yearly taxes: +20\n\nA ship with luxury goods: +30\n\nA small city's yearly taxes: +40\n\nA large city's reserves: +50"
            }

            RULES {
                #L5RFVMB10dE1fG3hI5jK7l: raising_additional_forces "Raising Additional Forces: If a character gains access to substantial new resources or a new source of potential soldiers, the GM might allow them to make a new marshaling check, treating their status as increased by an appropriate amount for the check. For instance, if a character captures a rich city on campaign, they might be able to use the resources from that city to attempt to build an even bigger army for their next target. If the new check's result would not create a preferable army, the character can choose to simply maintain their prior army."
                #L5RFVMB11mN2oP4qR6sT8u: temporary_status_modifiers "Temporary Status Modifiers: The following examples show how the wealth a character has access to could translate into treating their status as higher for a marshaling check:\n\nA large storehouse of food: +10\n\nA town's yearly taxes: +20\n\nA ship with luxury goods: +30\n\nA small city's yearly taxes: +40\n\nA large city's reserves: +50\n\nThe GM always has the final say of whether and how such a bonus applies."
            }
        }

        ^"Table 3-4: Mercenary Forces" DEF {

            ENTRIES {
                #Qht5uXsp31C8s7MlieKntZ ^"Ashigaru Veterans" DEF {
                    ^"Base Army Stats" STRING "Strength 20, Discipline 40"
                    ^"Modifiers" STRING "Strength +10, Discipline +5"
                    ^"Rule" STRING "Rank Formation (see page 280 of the core rulebook)"
                    ^"Cost" STRING "200 koku per month"
                }
                #nI4zcpbsmU9x2vU27vDFMz ^"Foreign Sellswords" DEF {
                    ^"Base Army Stats" STRING "Strength 25, Discipline 25"
                    ^"Modifiers" STRING "Strength +15, Discipline -10"
                    ^"Rule" STRING "Elite Training: Infantry (see page 280 of the core rulebook)"
                    ^"Cost" STRING "400 koku per month"
                }
                #RApyz0NHPNnlQSShEatrug ^"Mantis Privateers" DEF {
                    ^"Base Army Stats" STRING "Strength 30, Discipline 30"
                    ^"Modifiers" STRING "Strength +20, Discipline -5"
                    ^"Rule" STRING "Strike as the Storm"
                    ^"Cost" STRING "475 koku per month"
                }
                #ebTc7NrUmiptbGrtTYQ0Lg ^"Ujik Outriders" DEF {
                    ^"Base Army Stats" STRING "Strength 35, Discipline 30"
                    ^"Modifiers" STRING "Strength +25, Discipline -5"
                    ^"Rule" STRING "Thunderous Charge"
                    ^"Cost" STRING "500 koku per month"
                }
                #LOG5saVLi5vNQGcxOzoAV6 ^"Bandits" DEF {
                    ^"Base Army Stats" STRING "Strength 20, Discipline 20"
                    ^"Modifiers" STRING "Strength +10, Discipline -15"
                    ^"Rule" STRING "Out of Nowhere"
                    ^"Cost" STRING "100 koku per month"
                }
            }

            RULES {
                #L5RFVMB12vW3xY5zA7bC9d: mercenary_forces "Mercenary Forces: A character might get the chance to hire mercenaries while on campaign, should they encounter such individuals. Mercenaries must be paid a fixed amount each month when a character makes the check to maintain their army. See Table 3–4: Mercenary Forces for various types of mercenaries a character might be able to hire. If a mercenary force is operating as an army on its own, it uses the Base Army Stats; otherwise, apply its Modifiers to the army it is joining. If the force lists a rule, it applies to the entire army if it is operating independently, or to one cohort if it has joined another army."
            }
        }

        ^"Table 3-5: Allied Forces" DEF {

            ENTRIES {
                #Q7ZpSgDM3v69V1TF0IOCTG ^"Allied Status 100" DEF {
                    ^"Base Army Stats" STRING "Strength 150, Discipline 80"
                    ^"Modifiers" STRING "Strength +135, Discipline +20"
                    ^"Rules" STRING "Elite Training (one per cohort): Cavalry, Siege Specialists, Infantry, Archers, and Mystics (see page 280 of the core rulebook), Siege Defenders (see page 114)"
                }
                #AJaN2tsg8zxkdMFa03w88c ^"Allied Status 90-99" DEF {
                    ^"Base Army Stats" STRING "Strength 120, Discipline 75"
                    ^"Modifiers" STRING "Strength +95, Discipline +15"
                    ^"Rules" STRING "Elite Training (one per cohort): Cavalry, Siege Specialists, Infantry, Archers, and Mystics (see page 280 of the core rulebook), Siege Defenders (see page 114)"
                }
                #vRmfn5X2AvnNwFGRnEmcZl ^"Allied Status 80-89" DEF {
                    ^"Base Army Stats" STRING "Strength 100, Discipline 70"
                    ^"Modifiers" STRING "Strength +75, Discipline +10"
                    ^"Rules" STRING "Clan Doctrine (see page 113), Elite Training (one per cohort): Cavalry, Siege Specialists, Infantry, Archers, and Mystics (see page 280 of the core rulebook)"
                }
                #rFJA8HG6WfLitIL0TxkguX ^"Allied Status 70-79" DEF {
                    ^"Base Army Stats" STRING "Strength 80, Discipline 65"
                    ^"Modifiers" STRING "Strength +55, Discipline +5"
                    ^"Rules" STRING "Clan Doctrine (see page 113), Elite Training (one per cohort): Cavalry, Siege Specialists, Infantry, and Archers (see page 280 of the core rulebook)"
                }
                #wvEVgFdSAEC7ZJUMu7tObJ ^"Allied Status 60-69" DEF {
                    ^"Base Army Stats" STRING "Strength 65, Discipline 60"
                    ^"Modifiers" STRING "Strength +35, Discipline +0"
                    ^"Rules" STRING "Clan Doctrine (see page 113), Elite Training (one per cohort): Cavalry, Infantry, and Archers (see p. 280 of the core rulebook)"
                }
                #gRH4zvGZF76iHI8NZz0ZM7 ^"Allied Status 50-59" DEF {
                    ^"Base Army Stats" STRING "Strength 60, Discipline 50"
                    ^"Modifiers" STRING "Strength +30, Discipline +0"
                    ^"Rules" STRING "Clan Doctrine; Rank Formation"
                }
                #edcLtnk8ZLHeafnjJeD6dQ ^"Allied Status 40-49" DEF {
                    ^"Base Army Stats" STRING "Strength 55, Discipline 40"
                    ^"Modifiers" STRING "Strength +25, Discipline +0"
                    ^"Rules" STRING "Rank Formation"
                }
                #hJXGGFHsjZNFykAOnPEtNV ^"Allied Status 30-39" DEF {
                    ^"Base Army Stats" STRING "Strength 35, Discipline 20"
                    ^"Modifiers" STRING "Strength +15, Discipline -5"
                    ^"Rules" STRING "Conscripted"
                }
                #1C1uxavdx43WENxksI4F09 ^"Allied Status 24-29" DEF {
                    ^"Base Army Stats" STRING "Strength 20, Discipline 15"
                    ^"Modifiers" STRING "Strength +10, Discipline -5"
                    ^"Rules" STRING "Conscripted"
                }
                #vYyhbOV6EwqoZ4wGS3ViV6 ^"Allied Status 20-24" DEF {
                    ^"Base Army Stats" STRING "Strength 15, Discipline 15"
                    ^"Modifiers" STRING "Strength +5, Discipline -5"
                    ^"Rules" STRING "Conscripted"
                }
                #lTevzUtbMs6DsB6ruPhyri ^"Allied Status 0-19" DEF {
                    ^"Base Army Stats" STRING "None"
                    ^"Modifiers" STRING "None"
                    ^"Rules" STRING "None"
                }
            }

            RULES {
                #L5RFVMB15vW4xY6zA8bC0d: allied_forces "Allied Forces: A character might be able to persuade another lord to commit resources to their cause. This should generally require an Intrigue or a number of significant roleplaying scenes, and a character might have to make significant offers to that lord, such as agreeing in advance to certain concessions of territory taken in battle, making pacts for favorable marriages, or promising to defeat the other lord's enemies in addition to one's own. If this effort is successful, an allied lord can offer an amount of support based on their status (see Table 3–5: Allied Forces), which are added to the character's army. If an allied force is operating as an army on its own, it uses the Base Army Stats; otherwise, apply its Modifiers to the army it is joining. If the force lists one or more rules, each rule applies to the entire army if it is operating independently, or to one cohort if it has joined another army."
            }
        }

        ^"Parting of Ways" DEF {

            RULES {
                #L5RFVMB17nO6pQ8rS0tU2v: parting_of_ways "Parting of Ways: If a force splits from an army, divide the casualties and panic as evenly as possible between the splitting forces, with the larger forces receiving the additional casualties or panic if it cannot be divided evenly. If any force cannot function with the number of casualties or panic it receives, it disperses and its members split up."
            }
        }

        RULES {
            #L5RFVMB20oP9qR1sT3uV5w: supplemental_forces_expand_army "Supplemental Forces: A character can expand their army once it has been marshaled in a number of ways, described in this section."
        }
    }

    # ===========================
    # DOCTRINES
    # ===========================

    # source stat block (page 112)
    ^"Doctrines" DEF {
        APPLIES TO [#t9446c0a7f578c8eaf296f ^"System"]

        ^"Battle-Tested" DEF {

            PROPERTIES {
                ^"Training Check" STRING "TN 4 Command (Earth)"
                ^"Narrative Requirements" STRING "The army must have survived one mass battle."
                ^"Applies To" STRING "Entire army"
                ^"Effect" STRING "Increase the army's discipline by +5."
            }

            RULES {
                #LAE61kkeAACPNSIFZvDmTp: battle_tested_description "Battle-Tested: Soldiers who have faced the enemy before as a unit are generally more reliable, as each soldier knows how their comrades will behave under the stress of battle."
            }
        }

        ^"Clan Doctrines" DEF {

            PROPERTIES {
                ^"Training Check" STRING "None"
                ^"Narrative Requirements" STRING "The army must consist primarily of the forces of a single Great Clan."
                ^"Applies To" STRING "Entire army"
            }

            ENTRIES {
                #dxKPx8PvmcrwIr7rhzX2Gc ^"Crab" DEF {
                    ^"Effect" STRING "When this army would receive panic, it receives that amount of panic minus 2 instead (to a minimum of 1)."
                }
                #0HXL64iE8cS08HBtrLh9D1 ^"Crane" DEF {
                    ^"Effect" STRING "After a leader in this army makes a successful check to perform a Challenge action, if the challenging leader wins the clash, the enemy receives panic equal to that character's glory rank. If the challenging leader loses, their army receives panic equal to their glory rank."
                }
                #rJa4ylUlNif5yhs6gU4L3A ^"Dragon" DEF {
                    ^"Effect" STRING "When performing the Rally action, if a leader in this army succeeds, add a number of bonus successes equal to that leader's ranks in Meditation."
                }
                #dlT1X6fb97x7lNFZyzLQrd ^"Lion" DEF {
                    ^"Effect" STRING "When this army would remove 1 or more casualties or panic, it may remove an amount equal to the status rank of its commander instead."
                }
                #rnBLRoZsJDb5ZHwkd7UJHe ^"Phoenix" DEF {
                    ^"Effect" STRING "After a leader in this army performs an Assault action, if they succeed, the enemy army suffers attrition equal to that leader's ranks in Theology instead of Command."
                }
                #145NPDgieeAvieL9V6gKTh ^"Scorpion" DEF {
                    ^"Effect" STRING "Reduce the TN of the first Scheme action check each leader in this army makes each mass battle by 1 (to a minimum of 1). If this army's commander is also a leader, reduce the TN of the first Scheme action check the commander makes by 2 instead (to a minimum of 1)."
                }
                #7rBgc9mj85xryQKczFFzjG ^"Unicorn" DEF {
                    ^"Effect" STRING "When performing the Rally action, a leader in this army may make a TN 1 Survival check instead of a Command check."
                }
            }

            RULES {
                #PXvyC6q3Pmk1kmyvxKhNek: clan_doctrines_description "Clan Doctrines: Each Great Clan has its own preferred strategies and tactics, and the samurai of each clan are trained to best support their commanders' methods of warfare.\n\nEffect: The entire army gains one of the following based on its clan."
            }
        }

        ^"Fervor" DEF {

            PROPERTIES {
                ^"Training Check" STRING "TN 6 Theology (Fire)"
                ^"Narrative Requirements" STRING "None"
                ^"Applies To" STRING "Entire army"
                ^"Effect" STRING "Increase the army's discipline by +10. Increase the TN of monthly checks to maintain the army by 2."
            }

            RULES {
                #gEsEp0rPbKDBfQdLR2Spdy: fervor_description "Fervor: A belief in one's own righteousness is a terrifyingly effective motivator, and convincing one's soldiers that the will of the Heavens guides their cause makes them far more motivated to stand against harsh odds—but also more likely to come to believe that they should be interpreting this will for themselves."
            }
        }

        ^"Out of Nowhere" DEF {

            PROPERTIES {
                ^"Training Check" STRING "TN 4 Skulduggery (Air)"
                ^"Narrative Requirements" STRING "The army must have access to a forest or other large piece of Obscuring terrain in which to train."
                ^"Applies To" STRING "One cohort"
                ^"Effect" STRING "When this cohort's leader performs an Assault action, if the target cohort is in Confining or Obscuring, the leader may spend (op) as follows:\n\n(op)+: The enemy army receives panic equal to the leader's ranks in Skulduggery plus (op) spent this way."
            }

            RULES {
                #wHdsHClZusbhCk6dmjXyeo: out_of_nowhere_description "Out of Nowhere: Stealth tactics are viewed by some as dishonorable, but Akodo wrote with great regard for the power of infiltrators and spies."
            }
        }

        ^"Sappers" DEF {

            PROPERTIES {
                ^"Training Check" STRING "TN 3 Labor (Air)"
                ^"Narrative Requirements" STRING "The army must have access to a fortification in which to train."
                ^"Applies To" STRING "One cohort"
                ^"Effect" STRING "When this cohort's leader generates momentum points toward a strategic objective to seize a fortification (such as the Capture a Position objective against a fortification), they generate 2 additional momentum points toward that objective."
            }

            RULES {
                #HtqSQHaP8DlH0h6e8FB3wm: sappers_description "Sappers: Capturing a fortification through direct attack is a bloody, brutal prospect most commanders prefer to avoid. Capturing a fortification with a small force by using subterfuge is a far more appealing option."
            }
        }

        ^"Siege Defenders" DEF {

            PROPERTIES {
                ^"Training Check" STRING "TN 3 Labor (Earth)"
                ^"Narrative Requirements" STRING "The army must have access to a fortification in which to train."
                ^"Applies To" STRING "One cohort"
                ^"Effect" STRING "While this cohort occupies a fortification, treat its difficulty level as 2 higher."
            }

            RULES {
                #qPMRsimDwndjVF8MIkjDGw: siege_defenders_description "Siege Defenders: Defending a fortification against attackers is preferable to facing them in the open, but specialist troops will still perform better than those without experience in defending an entrenched position."
            }
        }

        ^"Strike as the Storm" DEF {

            PROPERTIES {
                ^"Training Check" STRING "TN 4 Seafaring (Water)"
                ^"Narrative Requirements" STRING "The army must have access to at least one warship, or several smaller vessels, capable of carrying the cohort with this ability."
                ^"Applies To" STRING "One cohort"
                ^"Effect" STRING "When the leader of this cohort performs the Assault action as part of their initial landing, they may spend (op) as follows:\n\n(op): The target cohort's leader suffers the Dazed condition.\n\n(op) (op)+: One additional enemy leader per (op) (op) spent this way suffers the Dazed condition. If using the rules for Battle Zones, this can only affect leaders whose cohorts are in the same zone as the target."
            }

            RULES {
                #e2WEgLJr7Hyj0mzVJwoZEc: strike_as_the_storm_description "Strike as the Storm: While most Rokugani warfare is based around land tactics, attacks by water are not unheard of, and Mantis sailors are rightly respected as some of the most skilled at unexpected flank attacks and ambushes."
            }
        }

        ^"Thunderous Charge" DEF {

            PROPERTIES {
                ^"Training Check" STRING "TN 5 Fitness (Fire)"
                ^"Narrative Requirements" STRING "The army must have access to enough quality steeds (Unicorn warhorses or equivalent) to equip a cohort with this ability."
                ^"Applies To" STRING "One cohort"
                ^"Effect" STRING "The first time the leader of this cohort performs an Assault action during each mass battle, if the enemy cohort is in Open terrain and the leader succeeds, they inflict additional attrition and panic to the enemy army equal to their ranks in Survival."
            }

            RULES {
                #XtlDSrHY72NPDlo0ff6lW2: thunderous_charge_description "Thunderous Charge: Among the Great Clans, only the Unicorn Clan trains heavy cavalry units in significant numbers. However, since their return to Rokugan, the other Great Clans have begun to experiment with their own cavalry units."
            }
        }

        RULES {
            #L5RFVMB37lM6nO8pQ0rS2t: doctrines "Doctrines: Doctrines are army and cohort rules that characters can add to their army. As a downtime activity, a character may make the listed TRAINING CHECK to attempt to train their army in a new doctrine for which it meets the narrative requirements. Each doctrine specifies whether it applies to one cohort or to the entire army. If a doctrine applies to the entire army, it can only ever be applied once. If a doctrine applies to one cohort, it can be applied to multiple cohorts by succeeding at the training check multiple times."
        }
    }

    # ===========================
    # EQUIPMENT UPGRADES
    # ===========================

    # source stat block (page 114)
    ^"Equipment Upgrades" DEF {
        APPLIES TO [#t9446c0a7f578c8eaf296f ^"System"]

        ^"Baggage Train" DEF {

            PROPERTIES {
                ^"Rarity" INTEGER 6
                ^"Cost" STRING "2,000 koku"
                ^"Applies To" STRING "Entire army"
                ^"Effect" STRING "Reduce the TN of monthly checks to maintain this army by 2 (to a minimum of 1)."
            }

            RULES {
                #EcxcjZ0bXARJcSin9S7J3C: baggage_train_description "Baggage Train: Supply logistics are crucial to keeping an army in service for long periods of time, and without a baggage train, an army cannot operate far from its garrison."
            }
        }

        ^"Battlefield Medical Supplies" DEF {

            PROPERTIES {
                ^"Rarity" INTEGER 3
                ^"Cost" STRING "50 koku"
                ^"Applies To" STRING "One cohort"
                ^"Effect" STRING "When a character leading this cohort removes 1 or more casualties from the army, they remove that amount of casualties plus 1 instead."
            }

            RULES {
                #dKhDaMDDVeIh9cg5oYpa2P: battlefield_medical_supplies_description "Battlefield Medical Supplies: Giving soldiers the means to staunch minor injuries can help keep an army in the field, curbing infection and the spread of disease. For the rules of a single character using this item, see page 90."
            }
        }

        ^"Nagae Yari" DEF {

            PROPERTIES {
                ^"Rarity" INTEGER 6
                ^"Cost" STRING "1,000 koku"
                ^"Applies To" STRING "One cohort"
                ^"Effect" STRING "When an enemy leader performs an Attack action check against this cohort, they treat all terrain as Dangerous terrain (see page 267 of the core rulebook)."
            }

            RULES {
                #ayTS6uqCqxR9DqzzxRUrp3: nagae_yari_description "Nagae Yari: Needle-pointed spears arranged in a hedge are an imposing sight for anyone, even heavy cavalry. For the rules of a single character using this item, see page 88."
            }
        }

        ^"Tetsubishi" DEF {

            PROPERTIES {
                ^"Rarity" INTEGER 4
                ^"Cost" STRING "100 koku"
                ^"Applies To" STRING "One cohort"
                ^"Effect" STRING "As a Movement and Support action, the leader of this cohort may deploy tetsubishi. Until the end of the next round, after the leader of a cohort (or army) with the cavalry or heavy cavalry rule performs an Attack action check targeting this cohort, that leader's army receives 3 casualties and 3 panic."
            }

            RULES {
                #WjXMdVpvTqoIQAoOjfkWCA: tetsubishi_description "Tetsubishi: Designed to ruin the feet and hooves of enemy troops and horses, tetsubishi are iron caltrops make the prospect of attacking a unit extremely unpleasant. For the rules of a single character using this item, see page 91."
            }
        }

        ^"Upgraded Armor" DEF {

            PROPERTIES {
                ^"Rarity" INTEGER 7
                ^"Cost" STRING "3,000 koku"
                ^"Applies To" STRING "Entire army"
                ^"Effect" STRING "If the army's commander succeeds at the check to maintain the army, they add 2 bonus successes."
            }

            RULES {
                #Lp50KekPomYQsuB8xGpwqT: upgraded_armor_description "Upgraded Armor: While investing in one's soldiers' armor is expensive, keeping troops alive for longer allows them to gain vital experience on the battlefield, making the army stronger as its members become more skillful."
            }
        }

        RULES {
            #L5RFVMB45fG4hI6jK8lM0n: equipment_upgrades "Equipment Upgrades: Equipment upgrades can be added to an army as well, by purchasing or requisitioning them. Each equipment upgrade specifies whether it applies to one cohort or to the entire army. If an equipment upgrade applies to one cohort, it can be applied to multiple cohorts by acquiring it multiple times."
        }
    }

    # ===========================
    # ARMY MAINTENANCE
    # ===========================

    # source (pages 115-116)
    ^"Army Maintenance" DEF {
        APPLIES TO [#t9446c0a7f578c8eaf296f ^"System"]

        PROPERTIES {
            ^"Activation" STRING "Start of each month"
            ^"Check" STRING "Command"
            ^"TN Calculation" STRING "The TN of this check is equal to the 10s digit of the army's strength (or 10, if the army's strength is higher than 99), as larger formations are harder to keep organized and equipped."
        }

        ^"Table 3-6: Army Maintenance Check Results" DEF {

            ENTRIES {
                #oDWTHNnUUuUUbCd0u46cRT ^"Success with 1+ Bonus Successes" DEF {
                    ^"Effect" STRING "Remove casualties and panic from the army equal to your ranks in Government, plus 2 per bonus success."
                }
                #pm03T7MoZPJewyXegUVC8L ^"Success" DEF {
                    ^"Effect" STRING "Remove casualties and panic from the army equal to your ranks in Government."
                }
                #fKyMk49pIX3q0YV9ijElij ^"Failure with 1-3 Shortfall" DEF {
                    ^"Effect" STRING "The army receives panic equal to your shortfall. If the army's panic exceeds its discipline this way, reduce the army's panic until it is equal to its discipline. However, the army refuses to fight for the next month."
                }
                #e2cTS8Pi9ODcxnWnGyuvgH ^"Failure with 4-6 Shortfall" DEF {
                    ^"Effect" STRING "The army receives panic equal to two times your shortfall. If the army's panic exceeds its discipline this way, it breaks apart into multiple chunks. These new armies and warbands spread across the countryside, pursuing their own agendas or even turning to banditry."
                }
                #Nqj2od9Voy34DRJ3hXUO7L ^"Failure with 7+ Shortfall" DEF {
                    ^"Effect" STRING "The army revolts, and attempts to overthrow its commander and their leaders. Chaos ensues, and the commander must fight for their life, negotiate, or flee to survive!"
                }
            }

        }

        ^"Harsh Conditions" DEF {

            ENTRIES {
                #ESa26PHhOG8wpbqmW4aXEm ^"Hostile lands without resupply" DEF   { ^"TN Modifier" STRING "+1" }
                #0UFWJzxnl3XPwSXBk33AQW ^"Winter without garrison shelter" DEF  { ^"TN Modifier" STRING "+2" }
                #dLY7gdQjZCh2Xxw7s4a09I ^"Two+ weeks marching last month" DEF   { ^"TN Modifier" STRING "+1" }
                #GYb06k9uwjxqi8GAmO6gNC ^"Short on food" DEF                    { ^"TN Modifier" STRING "+1" }
                #OUOhAZTsSWSiN6ZuILC0fx ^"Short on water" DEF                   { ^"TN Modifier" STRING "+3" }
                #8TIV0Uu3XmzIk8ZxxZGavZ ^"Exceptionally hot conditions" DEF     { ^"TN Modifier" STRING "+1" }
                #PmI4oU0UAKdhYTtXuMdKaf ^"Plagued by insects and vermin" DEF    { ^"TN Modifier" STRING "+1" }
                #s8Z71rmZ70qw9BERTmeo1t ^"Plagued by disease" DEF               { ^"TN Modifier" STRING "+3" }
            }

            RULES {
                #L5RFVMB50yZ9aB1cD3eF5g: harsh_conditions "Harsh Conditions: A number of factors can negatively impact the commander's Army Maintenance check. See below for some examples:\n\nIf the army is in hostile lands without a path of resupply, increase the TN by 1.\n\nIf it is winter and the army is not garrisoned in a shelter, increase the TN by 2.\n\nIf the army has been on the march for two weeks of the last month (or more), increase the TN by 1.\n\nIf the army is short on food, increase the TN by 1.\n\nIf the army is short on water, increase the TN by 3.\n\nIf it is exceptionally hot, increase the TN by 1.\n\nIf the army is plagued by insects and other vermin, increase the TN by 1.\n\nIf the army is plagued by disease, increase the TN by 3."
            }
        }

        ^"Incentives" DEF {

            ENTRIES {
                #wfR1Tbhxzp3QDNTAeCzHwe ^"Commander status rank 6+" DEF                         { ^"TN Modifier" STRING "-2" }
                #vbcyzA7fStxSpxRlRjTJHN ^"Promoted jizamurai or ashigaru last month" DEF        { ^"TN Modifier" STRING "-2" }
                #wC0PZTjJ8V6V59NmTwU0mh ^"Troops have access to entertainment" DEF              { ^"TN Modifier" STRING "-3" }
                #yibQPtqzY4UyzJAr95E1ax ^"Victorious in mass battle last month" DEF             { ^"TN Modifier" STRING "-4" }
                #8y5uqbs7d3r5NDRolzaRx3 ^"Food is plentiful" DEF                                { ^"TN Modifier" STRING "-3" }
                #fRjRRmYvIJy1NGPyn6wI7w ^"Fighting defensively in homeland" DEF                 { ^"TN Modifier" STRING "-6" }
                #lqsjWbTZiBPEX7W162i2Iv ^"Backing of status rank 7+ character" DEF              { ^"TN Modifier" STRING "-3" }
                #G5B3RqA0DkVLqZ1m5rRycz ^"Considerable sacrifice of personal wealth" DEF        { ^"TN Modifier" STRING "-1 per 5 status forfeited" }
            }

            RULES {
                #L5RFVMB51hI0jK2lM4nO6p: incentives "Incentives: On the other hand, a number of factors can positively impact the commander's maintenance check. See below for some examples:\n\nIf the commander's status rank is 6 or higher, decrease the TN by 2 (to a minimum of 1).\n\nIf the commander has publicly promoted one or more jizamurai or ashigaru for a valorous act in the last month, decrease the TN by 2 (to a minimum of 1).\n\nIf the troops have access to entertainment provided by the commander (such as small luxuries like tea or sake, bards and other entertainers, or the opportunity to participate in activities such as hunting or contests), decrease the TN by 3 (to a minimum of 1).\n\nIf the army has been victorious in a mass battle within the last month, decrease the TN by 4 (to a minimum of 1).\n\nIf food is plentiful, decrease the TN by 3 (to a minimum of 1).\n\nIf the troops are fighting a defensive conflict in their own homeland, decrease the TN by 6 (to a minimum of 1).\n\nIf the commander has the backing or mandate of a character with status rank 7 or higher, decrease the TN by 3 (to a minimum of 1).\n\nIf the commander or their backer has made a considerable sacrifice of personal wealth (forfeiting 5 or more status), decrease the TN by 1 for every 5 status forfeited this way."
            }
        }

        ^"Dispersing an Army" DEF {

            PROPERTIES {
                ^"Check" STRING "TN 4 Command (Air)"
                ^"Requirement" STRING "Pay any mercenaries their final dues"
                ^"Success" STRING "If the commander succeeds (and any paid troops are satisfied), the forces return to their homes or prior occupations without incident."
                ^"Failure" STRING "If the commander fails (or fails to pay any unpaid mercenaries), the troops go on to cause problems for the local area or the commander."
            }

            RULES {
                #L5RFVMB53zA2bC4dE6fG8h: dispersing_an_army "Dispersing an Army: At the end of a successful campaign, a warlord's vassals and allies generally expect recompense for their efforts. While in Rokugan most samurai do not expect to be paid in spoils, they do expect compensation—titles, positions, status, and most of all, lands captured are considered to be the proper reward for shedding blood on one's lord's behalf. Soldiers of the line, on the other hand, such as ashigaru and conscripts, generally prefer to be paid in currency (or village tax exemption, for many commoners) for their labor unless they happen to be among the exceptional few elevated to the samurai class thanks to their heroism or deeds.\n\nAfter an army has served its purpose, most commanders seek to dismantle it, letting its various members return to their previous lives and reducing the strain upon their estates. To get an army to disperse properly, its commander must make a TN 4 Command (Air) check and pay any mercenaries their final dues. If the commander succeeds (and any paid troops are satisfied), the forces return to their homes or prior occupations without incident. If the commander fails (or fails to pay any unpaid mercenaries), the troops go on to cause problems for the local area or the commander."
            }
        }

        RULES {
            #L5RFVMB55rS4tU6vW8xY0z: army_maintenance_check "Army Maintenance Check: Once rallied, an army must be regularly maintained. At the start of each month, the commander must make a Command check to keep their army in order, distribute supplies, and reorganize in the wake of losses. The TN of this check is equal to the 10s digit of the army's strength (or 10, if the army's strength is higher than 99), as larger formations are harder to keep organized and equipped. Depending on the result, the army may remove casualties and panic, receive additional panic, or even rebel upon its commander. See Table 3–6: Army Maintenance Check Results for details."
            #L5RFVMB57jK6lM8nO0pQ2r: unpaid_mercenaries_may_turn_hostile "At this time, a commander must also pay any mercenaries they have hired. Unpaid mercenaries might leave, or even take their forces and turn on the army if they believe they can take valuable hostages."
        }
    }

    # ===========================
    # HOSTAGES
    # ===========================

    # source stat block (page 117)
    ^"Hostages" DEF {
        APPLIES TO [#t9446c0a7f578c8eaf296f ^"System"]

        ^"Accepting Surrender" DEF {

            PROPERTIES {
                ^"Check" STRING "TN 3 Courtesy (Air)"
                ^"Success" STRING "if the character succeeds, the target agrees to the terms and becomes their \"guest\" (hostage)."
                ^"Failure" STRING "If the character fails, the target attempts to fight on, which can be resolved with narration by the GM, or perhaps a duel if the winners are gracious."
                ^"Subduing Hostage" STRING "Taking a character hostage against their will by subduing them is a minor violation of Courtesy (Rei), and requires forfeiting honor as normal."
            }

        }

        ^"Table 3-7: Ransom Amounts" DEF {

            ENTRIES {
                #SkJoRG3rYw6kgqnBIBzxFI ^"Status 100" DEF   { ^"Ransom" STRING "N/A (decorum always demands safe return)" }
                #4BDjXnb7sqk3ffrFEfb7qD ^"Status 90-99" DEF { ^"Ransom" STRING "10,000 koku" }
                #wkVMJBYwuVH6jshM9VbWYg ^"Status 80-89" DEF { ^"Ransom" STRING "1,000 koku" }
                #EU3l3zTc450xbl7HLY7sCh ^"Status 70-79" DEF { ^"Ransom" STRING "500 koku" }
                #r2BwksEaTO9NoClwjUV5RI ^"Status 60-69" DEF { ^"Ransom" STRING "250 koku" }
                #nXmYDSwZi0UXCuBn6gQ7HS ^"Status 50-59" DEF { ^"Ransom" STRING "100 koku" }
                #D9YWzzWBct4Ta07c4CpMWq ^"Status 40-49" DEF { ^"Ransom" STRING "50 koku" }
                #PrVelj8B5Md8z7AE1tILYj ^"Status 30-39" DEF { ^"Ransom" STRING "10 koku" }
                #3nwWlyLoBK1G7VWRCXAwnY ^"Status 20-29" DEF { ^"Ransom" STRING "1 koku" }
                #1twVA5cD5bougvIcOdWcb6 ^"Status 10-19" DEF { ^"Ransom" STRING "5 bu" }
                #IPxGbDrl2MvzwFMwxYqqWE ^"Status 0-9" DEF   { ^"Ransom" STRING "2 bu" }
            }

            RULES {
                #L5RFVMB60kL7mN9oP1qR3s: returning_hostages "After a battle or campaign, it is customary to return any hostages taken in battle to their families. Generally, a hostage is returned either in exchange for a hostage of equal status rank taken by the other side, or for a number of koku described in Table 3–7: Ransom Amounts (see page 117). If a character returns a hostage without any demands (or frees them), this is considered a sacrifice in the name of Righteousness (Gi), and the character should generally be awarded honor equal to the hostage's status rank (and glory equal to the hostage's status rank if they do so publicly). After a character frees someone of higher status rank this way, they also gain the Ally [Name of Character Freed] advantage (see page 101 of the core rulebook)."
                #L5RFVMB61tU8vW0xY2zA4b: gm_modifies_based_on_importance "Of course, the GM should modify any of these amounts based on the importance of the individual to those who hold the purse-strings within their clan or faction, as well as applying appropriate modifications based on negotiations undertaken by the various parties."
            }
        }

        ^"Hostage Treatment" DEF {

            PROPERTIES {
                ^"Staking" STRING "When a samurai takes a prisoner on the battlefield, they must stake honor and glory equal to that individual's status rank."
                ^"Harm to Hostage" STRING "If their hostage comes to harm, they lose the staked honor (and glory, if their failure becomes known)"
                ^"Mistreatment" STRING "in addition to any forfeits of honor and glory they must make if they themselves treat the hostage with anything less than the expected decorum."
                ^"Refusing Return" STRING "Refusing to return a hostage in exchange for an equivalent hostage, fair price, or suitable favor to be repaid later after hostilities have ceased is also considered a breach of Courtesy (Rei) of a scale of the GM's discretion."
            }

            RULES {
                #L5RFVMB62cD9eF1gH3iJ5k: hostage_care_stake_honor_glory "A samurai is expected to care for any \"guests\" in their custody as they would any esteemed guest. When a samurai takes a prisoner on the battlefield, they must stake honor and glory equal to that individual's status rank. If their hostage comes to harm, they lose the staked honor (and glory, if their failure becomes known) in addition to any forfeits of honor and glory they must make if they themselves treat the hostage with anything less than the expected decorum. Refusing to return a hostage in exchange for an equivalent hostage, fair price, or suitable favor to be repaid later after hostilities have ceased is also considered a breach of Courtesy (Rei) of a scale of the GM's discretion."
            }
        }

        ^"Freeing Hostages" DEF {

            PROPERTIES {
                ^"Honor Award" STRING "Equal to hostage's status rank"
                ^"Glory Award" STRING "glory equal to the hostage's status rank if they do so publicly"
                ^"Bonus" STRING "After a character frees someone of higher status rank this way, they also gain the Ally [Name of Character Freed] advantage (see page 101 of the core rulebook)."
            }

        }

        RULES {
            #L5RFVMB66mN3oP5qR7sT9u: hostages "Hostages: In the purest ideals of to which many Rokugani aspire, a samurai is expected to be willing to fight to the bitter end, but an idealized samurai is also expected to offer mercy to worthy adversaries who stand defiant to the end. As such, if a small group is surrounded by the enemy, or if the outcome of a mass battle is clear (such as if an army has been routed or suffered morale collapse) and the enemy leaders cannot escape, the GM should consider whether any NPCs in that group surrender. If some of the NPCs are not inclined to surrender due to their pride or convictions, the victorious side may attempt to get them to accept their hospitality. A representative of the winning side must make a TN 3 Courtesy (Air) check; if the character succeeds, the target agrees to the terms and becomes their \"guest\" (hostage). After all, once a battle is decided, further bloodshed is pointless. If the character fails, the target attempts to fight on, which can be resolved with narration by the GM, or perhaps a duel if the winners are gracious. Taking a character hostage against their will by subduing them is a minor violation of Courtesy (Rei), and requires forfeiting honor as normal."
            #L5RFVMB67vW4xY6zA8bC0d: pcs_always_choose_whether_to_surrender "PCs Surrendering: If the PCs are defeated in a mass battle and offered a chance to surrender, their players always make the decision on whether or not they actually do. If a player wants to let the dice decide, they can ask the GM to have an NPC make the TN 3 Courtesy (Air) check to convince them to surrender."
        }
    }

    # ===========================
    # BATTLE ZONES
    # ===========================

    # source (pages 118-121)
    ^"Battle Zones" DEF {
        APPLIES TO [#t9446c0a7f578c8eaf296f ^"System"]

        ^"Mapping the Area" DEF {

            RULES {
                #L5RFVMB68eF5gH7iJ9kL1m: mapping_the_area "Mapping the area: Before the start of the Mass Battle, the GM should map out the area. To do so, the first place the key geographic features such as:\n\nFortifications such as castles, fortresses, and barricades\n\nMountains and hills\n\nHollows and valleys\n\nRoads\n\nTowns and portions of cities\n\nFields and other open areas\n\nLakes, rivers, mountains, forests, and other natural barriers\n\nKey choke points such as passes, bridges, and tunnels\n\nImpassible areas"
            }
        }

        ^"Designating Battle Zones" DEF {

            RULES {
                #L5RFVMB70wX7yZ9aB1cD3e: designating_battle_zones "Designating Battle Zones: After drawing out the map, the GM should divide the map into battle zones. Each battle zone is an abstracted area in which the battle can be fought, defined by the key geographic features it contains. Generally, each battle zone should be drawn to have one of the above key geographic features as its defining aspect, and potentially contain other features that alter it in various ways."
                #L5RFVMB71fG8hI0jK2lM4n: overlapping_edges_are_adjacent "The GM then outlines each zone, making clear where each zone overlaps with any neighboring zones, and leaving gaps for areas where passage is normally impossible. If two zones have overlapping edges, they are considered ADJACENT zones. Cohorts can move between adjacent zones and can sometimes affect other cohorts in adjacent zones, as described later in this section."
            }
        }

        ^"Table 3-8: Assigning Terrain Qualities by Feature" DEF {

            ENTRIES {
                #GdJs7lfCgjhPwfeFYBvriA ^"Cliff" DEF    { ^"Terrain Qualities" STRING "Elevated, Dangerous" }
                #vamzNkEE16o0ZIxIiTAYOO ^"Hill" DEF     { ^"Terrain Qualities" STRING "Elevated" }
                #pqdfDg4Ju2jlGp20dhnG8k ^"Hollow" DEF   { ^"Terrain Qualities" STRING "Recessed" }
                #fSqC6FxsfwYwYVY6Nb2wqu ^"Valley" DEF   { ^"Terrain Qualities" STRING "Confining, Recessed" }
                #C01zgvwwn3HkL0BsM1AJXH ^"Road" DEF     { ^"Terrain Qualities" STRING "Open" }
                #v5MzEkjNnA3h8tkY2Ot8rp ^"Town" DEF     { ^"Terrain Qualities" STRING "Confining, Obscuring" }
                #C5aH6CQBojN1B7FNIPKut3 ^"Field" DEF    { ^"Terrain Qualities" STRING "Open" }
                #FNKtoXcgu9cwCXOxAcxnlN ^"River" DEF    { ^"Terrain Qualities" STRING "Entangling, Recessed" }
                #q2k4inHH2rncLzJZgAVH0g ^"Swamp" DEF    { ^"Terrain Qualities" STRING "Entangling" }
                #p91Exyf4zocLUTA5FWKZgb ^"Forest" DEF   { ^"Terrain Qualities" STRING "Entangling, Obscuring" }
                #EtjwxwCxPLNE0JGKvtikxz ^"Bridge" DEF   { ^"Terrain Qualities" STRING "Confining" }
                #tIuzwKOZELhU2c22XVf0Ej ^"Tunnel" DEF   { ^"Terrain Qualities" STRING "Confining, Obscuring" }
                #EkvxqKHVI4mPBpkG57dPmw ^"Chasm" DEF    { ^"Terrain Qualities" STRING "Confining, Recessed" }
            }

            RULES {
                #L5RFVMB73xY0zA2bC4dE6f: terrain_qualities_assigned_by_feature "Finally, the GM should note the features within each zone and any terrain qualities that affect cohorts within those zones. See Table 3–8: Assigning Terrain Qualities by Feature for ideas."
            }
        }

        ^"Zone Restrictions and Amendments" DEF {

            ENTRIES {
                #SLcYq1WiWWz7AK1m9PYQe4 ^"Targeting Restriction" DEF {
                    ^"Rule" STRING "Cohort leaders cannot target other cohort leaders who are not in the same zone."
                }
                #02McABVO8w2dxdFYJcicAW ^"Free Movement" DEF {
                    ^"Rule" STRING "Once during each cohort leader's turn, before or after they perform an action, that leader may move their cohort to an adjacent zone."
                }
                #hZBU78Un44M4GWoR4phimY ^"Withdrawal Panic" DEF {
                    ^"Rule" STRING "After a cohort leaves a zone, if that zone was occupied by an enemy cohort, the withdrawing cohort's army suffers 5 panic."
                }
            }

            RULES {
                #L5RFVMB74gH1iJ3kL5mN7o: zone_restrictions "Zone Restrictions: When running a Mass Battle with zones, use the standard rules for Mass Battles on 274 of the core rulebook with the following amendments:\n\nCohort leaders cannot target other cohort leaders who are not in the same zone.\n\nOnce during each cohort leader's turn, before or after they perform an action, that leader may move their cohort to an adjacent zone.\n\nAfter a cohort leaves a zone, if that zone was occupied by an enemy cohort, the withdrawing cohort's army suffers 5 panic."
            }
        }

        ^"March Action" DEF {

            PROPERTIES {
                ^"Action Type" STRING "Movement"
                ^"Check" STRING "TN 3 Command"
                ^"Base Effect" STRING "Move your cohort to an adjacent zone."
                ^"Success Effect" STRING "If you made the Command check and succeeded, you may then move your cohort one additional time to an adjacent zone, plus one additional time for every three bonus successes."
            }

            RULES {
                #L5RFVMB77hI4jK6lM8nO0p: march "March: Activation: As a Movement action, you may reposition your cohort. You may make a TN 3 Command check to move further.\n\nEffects: You move your cohort to an adjacent zone. If you made the Command check and succeeded, you may then move your cohort one additional time to an adjacent zone, plus one additional time for every three bonus successes."
            }
        }

        ^"Army and Cohort Rules While Using Battle Zones" DEF {

            ENTRIES {
                #x9BbkIUqg8aaDlTggcSyzd ^"Cavalry" DEF {
                    ^"Effect" STRING "This cohort does not suffer panic when leaving a battle zone with an enemy cohort."
                }
                #N0jvnD1TnE4l92B5VAnL8V ^"Archers" DEF {
                    ^"Effect" STRING "While in Elevated terrain, this cohort can perform Assault actions targeting cohorts in an adjacent zone, increasing the TN of the check by 1. However, while performing an Assault action targeting a cohort in an adjacent zone, this cohort cannot fulfill the following strategic objectives: Capture a Position, Cut Off the Head, Seize Victory. It can still contribute momentum points to these objectives, but cannot be the action to complete them."
                }
                #J1TD8OAFtUJ0Gk9gcl6Zzu ^"Mystics" DEF {
                    ^"Effect" STRING "While in Elevated terrain, this cohort can perform Rally actions targeting cohorts in an adjacent zone, increasing the TN of the check by 1."
                }
            }

            RULES {
                #L5RFVMB79zA6bC8dE0fG2h: army_and_cohort_rules_while_using_battle_zones "Army and Cohort Rules While Using Battle Zones: Some army and cohort abilities alter how they behave when using the battle zones rules. These include:\n\nCavalry: This cohort does not suffer panic when leaving a battle zone with an enemy cohort.\n\nArchers: While in Elevated terrain, this cohort can perform Assault actions targeting cohorts in an adjacent zone, increasing the TN of the check by 1. However, while performing an Assault action targeting a cohort in an adjacent zone, this cohort cannot fulfill the following strategic objectives: Capture a Position, Cut Off the Head, Seize Victory. It can still contribute momentum points to these objectives, but cannot be the action to complete them.\n\nMystics: While in Elevated terrain, this cohort can perform Rally actions targeting cohorts in an adjacent zone, increasing the TN of the check by 1."
            }
        }

        RULES {
            #L5RFVMB82aB9cD1eF3gH5i: battle_zones "Battle Zones: The Mass Battle rules included in the core rulebook are meant to center the action on the PCs and keep the combat flowing quickly. As such, they abstract certain details, such as distance and travel time. However, for campaigns where Mass Battles will be a frequent event, having more detail can add to the flavor of the narrative and give players interesting new options based on the more tactical decisions they can make.\n\nBattle zones are an optional rule that GMs can add to their Mass Battles to more closely track the position of cohorts, fortifications, terrain, and commanders within the field."
            #L5RFVMB84sT1uV3wX5yZ7a: concealed_zones_revealed_on_entry "Concealed Battle Zones: At the GM's discretion, certain areas might be partially or fully concealed, leaving one or both commanders uncertain what lies within. The terrain qualities, cohorts, fortifications, and other elements with these areas should be revealed only when a cohort moves into the area."
        }
    }

    # ===========================
    # NEW TERRAIN TYPES
    # ===========================

    # source stat block (page 122)
    ^"New Terrain Types" DEF {
        APPLIES TO [#t2baba6626d9f2edff18f4 ^"Terrain"]

        ^"Confining" DEF {

            PROPERTIES {
                ^"Type" STRING "Mundane"
                ^"Examples" STRING "Narrow alleyways, rope-bridges across chasms, teahouse interiors, narrow passes, tunnels"
            }

            ENTRIES {
                #0D31y1V54bV8Cbin5fGI3b ^"Duel or Skirmish Effect" DEF {
                    ^"Effect" STRING "When a character makes a check to wield a weapon or activate a technique with a maximum range of 2 or higher, increase the TN by 2."
                }
                #3lCLvpIvYYiW47zc04XptG ^"Mass Battle Effect" DEF {
                    ^"Effect" STRING "When a cohort occupies Confining terrain, other cohorts cannot move into the same area of terrain. If using the rules for battle zones on page 118, other cohorts can enter the zone but cannot pass through it."
                }
            }

            RULES {
                #SqJOWPmbJhYja5lEmqJcKW: confining_description "Confining: Confining terrain is cut off from multiple angles, forcing those passing through into a file. As a result, it is effectively impassible if held by a dedicated defender. This is a mundane terrain type found in most regions.\n\nEffects: While a character is in Confining terrain, the following applies to them based on the type of scene:"
            }
        }

        ^"Elevated" DEF {

            PROPERTIES {
                ^"Type" STRING "Mundane"
                ^"Examples" STRING "Hilltops, castle towers, watchtowers, mountaintops, rooftops"
            }

            ENTRIES {
                #gN7IUtRSqs3pxbbj6i6EZQ ^"Effect" DEF {
                    ^"Effect" STRING "While within Elevated terrain, a character reduces the TN of their Martial Arts [Ranged] checks targeting characters outside of Elevated terrain by 1 (to a minimum of 1). At the GM's discretion, this benefit could extend to other ranged attacks, such as the invocations of shugenja. Depending on its height and steepness, Elevated terrain might require a check to reach."
                }
            }

            RULES {
                #QhN0ELF5Bck2tXmckmmzh8: elevated_description "Elevated: Elevated ground is significantly higher than most of the terrain around it, has a wide view of the area, and grants both line of sight and an advantage to ballistic attacks based on its relative height. This is a mundane terrain type found in most regions."
            }
        }

        ^"Open" DEF {

            PROPERTIES {
                ^"Type" STRING "Mundane"
                ^"Examples" STRING "Roads, flattened fields, cleared woodland"
            }

            ENTRIES {
                #lTqlzGZnL9YAyeI4UnM0ir ^"Effect" DEF {
                    ^"Effect" STRING "While within Open terrain, a character reduces the TN of their Movement action checks by 1 (to a minimum of 1)."
                }
            }

            RULES {
                #ULMLbFhLhRHVLzCm3HNNjm: open_description "Open: Open terrain is designed to facilitate movement, helping even large armies move quickly. This is a mundane terrain type found in most regions."
            }
        }

        ^"Recessed" DEF {

            PROPERTIES {
                ^"Type" STRING "Mundane"
                ^"Examples" STRING "Hollows, ravines"
            }

            ENTRIES {
                #nJdEmQ2h5XVkKwVU2prXZU ^"Effect" DEF {
                    ^"Effect" STRING "While a character is within Recessed terrain, the TN of each Martial Arts [Ranged] check targeting them is reduced by 1 (to a minimum of 1). At the GM's discretion, this benefit could extend to other ranged attacks, such as the invocations of shugenja. Depending on its depth and steepness, Recessed terrain might require a check to reach."
                }
            }

            RULES {
                #a4WR81aRFYnI2OjXb8tzOo: recessed_description "Recessed: Recessed terrain is significantly lower than most of the terrain around it, and is exposed to fire from all directions. This is a mundane terrain type found in most regions."
            }
        }

        RULES {
            #L5RFVMB93vW0xY2zA4bC6d: new_terrain_types "New Terrain Types: The following are new terrain types. These terrain types are especially useful for skirmishes and mass battles, but can also be used in duels at the GM's discretion."
        }
    }
}
