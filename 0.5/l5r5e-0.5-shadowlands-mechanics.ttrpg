EXTENSION "L5R5e_Shadowlands" EXTENDS "L5R5e_Core_Character" {
    NAME "Legend of the Five Rings 5th Edition - Shadowlands: New Player Options"
    VERSION "0.5.3"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-03-01"

    # Shadowlands (Chapters 2 and 3): Falcon Minor Clan, Toritaka family,
    # new schools, advantages, disadvantages, Taint disadvantages,
    # heritages, weapons, armor, personal effects, signature scrolls,
    # item patterns, artifacts, techniques, mahō, titles, opportunity
    # tables, corruption rules, oni generation, demeanors, NPC templates.

    # ===========================
    # FALCON MINOR CLAN
    # ===========================

    # source (page 87)
    #QoMbnz6k4QYlcHS9p9cK1k ^"Falcon Minor Clan" DEF {
        EXTENDS #L5R250aB2cD4eF6gH8iJ0k ^"Clan"
        APPLIES TO [#L5R003xY4zA6bC8dE0fG2hI ^"Samurai"]

        PROPERTIES {
            ^"Clan Name" STRING "Falcon" FIXED
            ^"Clan Type" STRING "Minor Clan"
            ^"Clan Ring Bonus" DEF { ^"Void" INTEGER 1 }
            ^"Clan Skill Bonus" DEF { ^"Theology" INTEGER 1 }
            ^"Clan Status" INTEGER DEFAULT 26
        }

        FAMILIES {
            ^"Toritaka"
        }

    }

    # ===========================
    # FALCON FAMILIES
    # ===========================

    #L5RSL60vW1xY3zA5bC7dE9f ^"Toritaka" DEF {
        EXTENDS #L5R251lM3nO5pQ7rS9tU1v ^"Family"
        APPLIES TO [#L5R003xY4zA6bC8dE0fG2hI ^"Samurai"]

        PROPERTIES {
            ^"Family Name"     STRING "Toritaka" FIXED
            ^"Clan"            STRING "Falcon"
            ^"Ring Increase" DEF { CHOOSE 1 [^"Earth", ^"Water"] INTEGER 1 }
            ^"Skill Increases" DEF {
                ^"Survival" INTEGER 1
                ^"Meditation" INTEGER 1
            }
            ^"Glory"           INTEGER 35
            ^"Wealth" DEF { ^"Count" INTEGER 3  ^"Type" STRING "koku"  ^"Starting" BOOLEAN true }
        }
    }

    # ===========================
    # NEW SCHOOLS
    # ===========================

    # source (page 88)
    #sIPI9Kgl79wsVgC2tIS6m5 ^"Asako Inquisitor" DEF {
        EXTENDS #L5R252wX4yZ6aB8cD0eF2g ^"School"
        APPLIES TO [#L5R003xY4zA6bC8dE0fG2hI ^"Samurai"]
        DESCRIPTION "Unlike the horrors of the Shadowlands, mahō can arise anywhere and can exist in any location as a hidden corruption. To root out and combat this, the Asako Inquisitors were formed in the third century. Originally, they concentrated on their own clan, to purge the Phoenix of any who would engage in such foul practices, but over time, their remit widened to include all of the Emerald Empire. This has brought Asako Inquisitors, who answer only to their clan's Council of Five and the Emperor, into conflict at times with people of the Kuni Purifier School."
        REFERENCES {
            "Kuni Purifier" -> #tfdc79f9cebeb227ddbef9 ^"Kuni Purifier"
        }

        PROPERTIES {
            ^"School Name" STRING "Asako Inquisitor" FIXED
            ^"Clan" STRING "Phoenix"
            ^"Roles" LIST ["Courtier", "Shugenja"]
            ^"Ring Increase" DEF {
                ^"Fire" INTEGER 1
                ^"Void" INTEGER 1
            }
            ^"Starting Skills" DEF { CHOOSE 3 [^"Courtesy", ^"Martial Arts [Melee]", ^"Martial Arts [Unarmed]", ^"Meditation", ^"Performance", ^"Theology"] INTEGER 1 }
            ^"Starting Honor" INTEGER DEFAULT 35
            ^"Techniques Available" LIST ["Invocations", "Rituals", "Shūji"]
        }

        STARTING_TECHNIQUES {
            RITUAL ^"Cleansing Rite"
            RITUAL ^"Commune with the Spirits"
            RITUAL ^"Divination"
            SHUJI ^"Cadence"
            SHUJI ^"Truth Burns through Lies"
        }

        SCHOOL_ABILITY "Traces of Passage" {
            "Once per scene as a Support action, you may scry to detect any supernatural abilities used at range 0-3 in the last day (such as invocations, mahō, and kihō). Reduce the TN of your checks to investigate this phenomenon by your school rank."
        }

        MASTERY_ABILITY ^"Resilient Readiness" {
            "When you make a check to investigate a supernatural phenomenon, you may spend (op) as follows: (op)+: Increase your resistance against that phenomenon (such as a specific invocation, kihō, mahō, or NPC ability) by an amount equal to the (op) you spend this way. This effect persists until the end of the scene."
        }
        STARTING_OUTFIT [
            "traveling clothes", "sanctified robes",
            "daishō (any one sword of rarity 7 or lower and wakizashi)",
            "scroll satchel", "traveling pack"
        ]

        CURRICULUM {
            RANK 1 {
                SKILL_GROUP "Scholar Skills"
                SKILL "Command"
                SKILL "Martial Arts [Melee]"
                SKILL "Meditation"
                TECHNIQUE_GROUP "Rank 1 Fire Invocations"
                ^"Threshold Barrier" [ritual]
                ^"Weight of Duty" [shuji]
            }
            RANK 2 {
                SKILL_GROUP "Social Skills"
                SKILL "Government"
                SKILL "Meditation"
                SKILL "Theology"
                TECHNIQUE_GROUP "Rank 1-2 Air Invocations"
                ^"Essence of Jade" [invocation]
                ^"Open-Hand Style" [kata]
            }
            RANK 3 {
                SKILL_GROUP "Martial Skills"
                SKILL "Medicine"
                SKILL "Performance"
                SKILL "Theology"
                TECHNIQUE_GROUP "Rank 1-3 Earth Invocations"
                ^"Regal Bearing" [shuji]
                ^"Touchstone of Courage" [shuji]
            }
            RANK 4 {
                SKILL_GROUP "Scholar Skills"
                SKILL "Courtesy"
                SKILL "Martial Arts [Melee]"
                SKILL "Survival"
                TECHNIQUE_GROUP "Rank 1-4 Water Invocations"
                ^"The Soul's Blade" [invocation]
                ^"Bravado" [shuji]
            }
            RANK 5 {
                SKILL_GROUP "Social Skills"
                SKILL "Composition"
                SKILL "Skulduggery"
                SKILL "Tactics"
                TECHNIQUE_GROUP "Rank 1-5 Fire Invocations"
                ^"Striking as Void" [kata]
                ^"Rouse the Soul" [shuji]
            }
            RANK 6 {
                ^"Resilient Readiness"
            }
        }

    }

    # source (page 89)
    #azdqVQmlo4C6zgjv384jCQ ^"Kakita Swordsmith" DEF {
        EXTENDS #L5R252wX4yZ6aB8cD0eF2g ^"School"
        APPLIES TO [#L5R003xY4zA6bC8dE0fG2hI ^"Samurai"]
        DESCRIPTION "Like all institutions of the Crane, the Kakita Swordsmith School emphasizes perfection and excellence. The blades they forge are renowned across Rokugan as the finest that can be made; some duelists wait long years for the opportunity to have one of these blades crafted for their use. Very rarely, a venerable swordsmith will take on a promising youth as an apprentice, though most apprentices spend decades before they are honored as \"proficient.\""

        PROPERTIES {
            ^"School Name" STRING "Kakita Swordsmith" FIXED
            ^"Clan" STRING "Crane"
            ^"Roles" LIST ["Artisan", "Courtier"]
            ^"Ring Increase" DEF {
                ^"Air" INTEGER 1
                ^"Fire" INTEGER 1
            }
            ^"Starting Skills" DEF { CHOOSE 5 [^"Aesthetics", ^"Martial Arts [Melee]", ^"Courtesy", ^"Culture", ^"Sentiment", ^"Smithing", ^"Theology"] INTEGER 1 }
            ^"Starting Honor" INTEGER DEFAULT 55
            ^"Techniques Available" LIST ["Kata", "Rituals", "Shūji"]
            ^"Patterns" STRING "Kakita Pattern"
        }

        STARTING_TECHNIQUES {
            KATA CHOOSE 1 [^"Soaring Slice", ^"Striking as Air", ^"Striking as Fire"]
            SHUJI ^"Artisan's Appraisal"
        }

        SCHOOL_ABILITY "Sacred Art of Steel" {
            "Once per game session when you make a check to craft, improve, or maintain a weapon, you may add a number of kept (ring) set to (op) results equal to your school rank."
        }

        MASTERY_ABILITY ^"Ashidaka's Method" {
            "When you create a new weapon, you may apply two different patterns that you know to it (instead of one)."
        }
        STARTING_OUTFIT [
            "traveling clothes", "ceremonial clothes",
            "daishō (a personally crafted katana with Kakita pattern [see page 109] and wakizashi)",
            "smithing hammer", "traveling pack",
            "an attendant or Rokugani pony"
        ]

        CURRICULUM {
            RANK 1 {
                SKILL_GROUP "Artisan Skills"
                SKILL "Courtesy"
                SKILL "Culture"
                SKILL "Martial Arts [Melee]"
                TECHNIQUE_GROUP "Rank 1 Kata"
                ^"Blessing of Steel" [ritual]
                ^"Well of Desire" [shuji]
            }
            RANK 2 {
                SKILL_GROUP "Scholar Skills"
                SKILL "Aesthetics"
                SKILL "Meditation"
                SKILL "Smithing"
                TECHNIQUE_GROUP "Rank 1-2 Rituals"
                ^"Ebb and Flow" [shuji]
                ^"Tributaries of Trade" [shuji]
            }
            RANK 3 {
                SKILL_GROUP "Martial Skills"
                SKILL "Sentiment"
                SKILL "Smithing"
                SKILL "Theology"
                TECHNIQUE_GROUP "Rank 1-4 Air Shūji"
                ^"All Arts are One" [shuji]
                ^"Dazzling Performance" [shuji]
            }
            RANK 4 {
                SKILL_GROUP "Artisan Skills"
                SKILL "Courtesy"
                SKILL "Martial Arts [Melee]"
                SKILL "Performance"
                TECHNIQUE_GROUP "Rank 1-4 Kata"
                ^"Soul Sunder" [kata]
                ^"Bravado" [shuji]
            }
            RANK 5 {
                SKILL_GROUP "Scholar Skills"
                SKILL "Aesthetics"
                SKILL "Design"
                SKILL "Smithing"
                TECHNIQUE_GROUP "Rank 1-5 Fire Shūji"
                ^"Buoyant Arrival" [shuji]
                ^"Striking as Void" [kata]
            }
            RANK 6 {
                ^"Ashidaka's Method"
            }
        }

    }

    # source (page 90)
    #R5QkVgnBvgmnq2Yz1hP51j ^"Kitsu Medic" DEF {
        EXTENDS #L5R252wX4yZ6aB8cD0eF2g ^"School"
        APPLIES TO [#L5R003xY4zA6bC8dE0fG2hI ^"Samurai"]
        DESCRIPTION "Though the Kitsu family is known more for its shugenja samurai, the students of the Kitsu Medic School are also of note. They are skilled in the martial arts, but their primary vocation is healing. As such, they are an important part of any Lion army going into battle. The warrior skills of Kitsu Medics mean they can be at the forefront of the fighting, killing foes as well as tending to their clan's wounded."

        PROPERTIES {
            ^"School Name" STRING "Kitsu Medic" FIXED
            ^"Clan" STRING "Lion"
            ^"Roles" LIST ["Artisan", "Bushi"]
            ^"Ring Increase" DEF {
                ^"Earth" INTEGER 1
                ^"Water" INTEGER 1
            }
            ^"Starting Skills" DEF { CHOOSE 5 [^"Command", ^"Fitness", ^"Martial Arts [Melee]", ^"Martial Arts [Unarmed]", ^"Medicine", ^"Sentiment", ^"Survival"] INTEGER 1 }
            ^"Starting Honor" INTEGER DEFAULT 44
            ^"Techniques Available" LIST ["Kata", "Rituals", "Shūji"]
        }

        STARTING_TECHNIQUES {
            KATA CHOOSE 1 [^"Crescent Moon Style", ^"Striking as Earth", ^"Striking as Water"]
            RITUAL CHOOSE 1 [^"Cleansing Rite", ^"Threshold Barrier"]
            SHUJI ^"Stonewall Tactics"
        }

        SCHOOL_ABILITY "Field Medicine" {
            "When you perform a Medicine check to remove fatigue or a condition from a friendly character, that character removes additional fatigue up to your school rank."
        }

        MASTERY_ABILITY ^"Healer's Hands" {
            "When you make a check to remove a condition from another character, you may receive 2 fatigue to treat the TN as 1."
        }
        STARTING_OUTFIT [
            "traveling clothes", "ashigaru armor",
            "daishō (katana and wakizashi)",
            "satchel of medicinal supplies", "traveling pack"
        ]

        CURRICULUM {
            RANK 1 {
                SKILL_GROUP "Scholar Skills"
                SKILL "Fitness"
                SKILL "Martial Arts [Melee]"
                SKILL "Survival"
                TECHNIQUE_GROUP "Rank 1 Kata"
                ^"Commune with the Spirits" [ritual]
                ^"Honest Assessment" [shuji]
            }
            RANK 2 {
                SKILL_GROUP "Martial Skills"
                SKILL "Medicine"
                SKILL "Survival"
                SKILL "Theology"
                TECHNIQUE_GROUP "Rank 1-2 Earth Shūji"
                ^"Flowing Water Strike" [kata]
                ^"Rushing Avalanche Style" [kata]
            }
            RANK 3 {
                SKILL_GROUP "Artisan Skills"
                SKILL "Martial Arts [Melee]"
                SKILL "Martial Arts [Unarmed]"
                SKILL "Medicine"
                TECHNIQUE_GROUP "Rank 1-3 Kata"
                ^"Iron in the Mountains Style" [kata]
                ^"Touchstone of Courage" [shuji]
            }
            RANK 4 {
                SKILL_GROUP "Scholar Skills"
                SKILL "Command"
                SKILL "Fitness"
                SKILL "Survival"
                TECHNIQUE_GROUP "Rank 1-5 Water Shūji"
                ^"A Samurai's Fate" [shuji]
                ^"Crashing Wave Style" [kata]
            }
            RANK 5 {
                SKILL_GROUP "Martial Skills"
                SKILL "Courtesy"
                SKILL "Medicine"
                SKILL "Sentiment"
                TECHNIQUE_GROUP "Rank 1-5 Kata"
                ^"Rouse the Soul" [shuji]
                ^"Sear the Wound" [shuji]
            }
            RANK 6 {
                ^"Healer's Hands"
            }
        }

    }

    # source (page 91)
    #4W8k4B1wo7xUYVbxrCSuFS ^"Kuni Warden" DEF {
        EXTENDS #L5R252wX4yZ6aB8cD0eF2g ^"School"
        APPLIES TO [#L5R003xY4zA6bC8dE0fG2hI ^"Samurai"]
        DESCRIPTION "A number of Kuni who lack the aptitude to become shugenja are trained in the tradition of the Kuni Wardens. These grim monks maintain the Barracks of the Damned, a massive hospital, laboratory, and prison that is also their temple. Experts at subduing Tainted humans and overcoming sorcery, even without weapons, many serve at or near the Wall, but some Wardens occasionally make their way into the wider world. The order sometimes sends its agents to \"tend to the spiritual needs\" of those who have been exposed to the corruption of Fu Leng. This can include offering the mercy of death, should their charge be fully consumed by the Taint."

        PROPERTIES {
            ^"School Name" STRING "Kuni Warden" FIXED
            ^"Clan" STRING "Crab"
            ^"Roles" LIST ["Monk"]
            ^"Ring Increase" DEF {
                ^"Fire" INTEGER 1
                ^"Void" INTEGER 1
            }
            ^"Starting Skills" DEF { CHOOSE 4 [^"Command", ^"Martial Arts [Melee]", ^"Martial Arts [Unarmed]", ^"Meditation", ^"Performance", ^"Theology"] INTEGER 1 }
            ^"Starting Honor" INTEGER DEFAULT 34
            ^"Techniques Available" LIST ["Kihō", "Rituals", "Shūji"]
        }

        STARTING_TECHNIQUES {
            KIHO CHOOSE 1 [^"Cleansing Spirit", ^"Flame Fist"]
            RITUAL CHOOSE 1 [^"Cleansing Rite", ^"Threshold Barrier"]
            SHUJI ^"Truth Burns through Lies"
        }

        SCHOOL_ABILITY "Suppressing Blows" {
            "When you perform an Attack action check using Martial Arts [Melee] or Martial Arts [Unarmed], you may spend (op) as follows:\n\n(op)+: One character per (op) spent this way who is in range of the weapon you used suffers the Silenced condition. You can spend a maximum number of (op) this way up to your school rank."
        }

        MASTERY_ABILITY ^"Sacred Fist" {
            "All of your kihō gain the following additional burst effect: If you have 3 or more bonus successes, your unarmed attack profiles gain the Sacred quality until the end of your next turn."
        }
        STARTING_OUTFIT [
            "sanctified robes", "concealed armor",
            "daishō (kabutowari and wakizashi)",
            "calligraphy kit", "traveling pack"
        ]

        CURRICULUM {
            RANK 1 {
                SKILL_GROUP "Scholar Skills"
                SKILL "Martial Arts [Melee]"
                SKILL "Martial Arts [Unarmed]"
                SKILL "Meditation"
                TECHNIQUE_GROUP "Rank 1 Kata"
                ^"Courtier's Resolve" [shuji]
                ^"The Body Is an Anvil" [kiho]
            }
            RANK 2 {
                SKILL_GROUP "Martial Skills"
                SKILL "Performance"
                SKILL "Sentiment"
                SKILL "Theology"
                TECHNIQUE_GROUP "Rank 1-2 Fire Kihō"
                ^"Crimson Leaves Strike" [kata]
                ^"Coiling Serpent Style" [kata]
            }
            RANK 3 {
                SKILL_GROUP "Social Skills"
                SKILL "Fitness"
                SKILL "Martial Arts [Unarmed]"
                SKILL "Theology"
                TECHNIQUE_GROUP "Rank 1-3 Earth Kihō"
                ^"Thunderclap Strike" [kata]
                ^"Rallying Cry" [shuji]
            }
            RANK 4 {
                SKILL_GROUP "Martial Skills"
                SKILL "Command"
                SKILL "Government"
                SKILL "Skulduggery"
                TECHNIQUE_GROUP "Rank 1-4 Void Shūji"
                ^"Bravado" [shuji]
                ^"Death Touch" [kiho]
            }
            RANK 5 {
                SKILL_GROUP "Scholar Skills"
                SKILL "Fitness"
                SKILL "Martial Arts [Melee]"
                SKILL "Meditation"
                TECHNIQUE_GROUP "Rank 1-5 Void Kihō"
                ^"Striking as Void" [kata]
                ^"Sear the Wound" [shuji]
            }
            RANK 6 {
                ^"Sacred Fist"
            }
        }

    }

    # source (page 92)
    #x3tXPlTB1Ntc5vdnPw6ezC ^"Mirumoto Taoist Blade" DEF {
        EXTENDS #L5R252wX4yZ6aB8cD0eF2g ^"School"
        APPLIES TO [#L5R003xY4zA6bC8dE0fG2hI ^"Samurai"]
        DESCRIPTION "As the name suggests, the monks of the Mirumoto Taoist Blade School make study of swordplay an integral part of their quest for Enlightenment. Such are their skills that their blades act as if part of their bodies, striking as easily as fists would do for others. Their isolated monastery and dōjō is nestled deep within northern mountains within Dragon lands, and it is extraordinarily rare for them to host visitors. Most Rokugani who witness their skills do so when one of these monks departs to walk the Emerald Empire in search of new insights and possibly even new lessons in the blade."

        PROPERTIES {
            ^"School Name" STRING "Mirumoto Taoist Blade" FIXED
            ^"Clan" STRING "Dragon"
            ^"Roles" LIST ["Bushi", "Monk"]
            ^"Ring Increase" DEF {
                ^"Void" INTEGER 1
                ^"Water" INTEGER 1
            }
            ^"Starting Skills" DEF { CHOOSE 4 [^"Labor", ^"Martial Arts [Melee]", ^"Martial Arts [Unarmed]", ^"Meditation", ^"Survival", ^"Theology"] INTEGER 1 }
            ^"Starting Honor" INTEGER DEFAULT 48
            ^"Techniques Available" LIST ["Kata", "Kihō", "Rituals"]
        }

        STARTING_TECHNIQUES {
            KATA CHOOSE 2 [^"Iaijutsu Cut: Rising Blade", ^"Soaring Slice", ^"Striking as Water"]
            KIHO ^"Water Fist"
        }

        SCHOOL_ABILITY "Sharpened Ki" {
            "Your kihō that affect your unarmed attack profiles also apply to weapons you wield in a one-handed grip. When you succeed on a check to activate a kihō that affects your unarmed attack profiles or a weapon you wield in a one-handed grip, add bonus successes equal to your school rank."
        }

        MASTERY_ABILITY ^"The Effortless Path" {
            "When making a check to active a kihō, you may spend (op) as follows:\n\n(op): If you succeed on this check, after you activate the kihō, you may perform a Strike action with a weapon you have readied in a one-handed grip."
        }
        STARTING_OUTFIT [
            "traveling clothes",
            "daishō (any one sword of rarity 7 or lower and wakizashi)",
            "traveling pack"
        ]

        CURRICULUM {
            RANK 1 {
                SKILL_GROUP "Martial Skills"
                SKILL "Labor"
                SKILL "Survival"
                SKILL "Theology"
                TECHNIQUE_GROUP "Rank 1 Kata"
                ^"Crescent Moon Style" [kata]
                ^"Ki Protection" [kiho]
            }
            RANK 2 {
                SKILL_GROUP "Scholar Skills"
                SKILL "Fitness"
                SKILL "Martial Arts [Melee]"
                SKILL "Meditation"
                TECHNIQUE_GROUP "Rank 1-2 Water Kihō"
                ^"Flowing Water Strike" [kata]
                ^"Iaijutsu Cut: Crossing Blade" [kata]
            }
            RANK 3 {
                SKILL_GROUP "Martial Skills"
                SKILL "Medicine"
                SKILL "Survival"
                SKILL "Theology"
                TECHNIQUE_GROUP "Rank 1-3 Earth Kihō"
                ^"Crimson Leaves Strike" [kata]
                ^"Still the Elements" [kiho]
            }
            RANK 4 {
                SKILL_GROUP "Scholar Skills"
                SKILL "Composition"
                SKILL "Martial Arts [Unarmed]"
                SKILL "Meditation"
                TECHNIQUE_GROUP "Rank 1-4 Void Kihō"
                ^"Striking as Void" [kata]
                ^"Crashing Wave Style" [kata]
            }
            RANK 5 {
                SKILL_GROUP "Martial Skills"
                SKILL "Labor"
                SKILL "Sentiment"
                SKILL "Theology"
                TECHNIQUE_GROUP "Rank 1-5 Kata"
                ^"Touch the Void Dragon" [kiho]
                ^"Way of the Edgeless Sword" [kiho]
            }
            RANK 6 {
                ^"The Effortless Path"
            }
        }

    }

    # source (page 93)
    #t84777f1d1c4c929f5f996 ^"Moto Avenger" DEF {
        EXTENDS #L5R252wX4yZ6aB8cD0eF2g ^"School"
        APPLIES TO [#L5R003xY4zA6bC8dE0fG2hI ^"Samurai"]
        DESCRIPTION "The Moto revere life, death, and the passage between the two. Life comes from the meeting of earth and sky as the rain falls to the plains; at death, the two are divided, for the body returns to the soil while the spirit returns to the sky. Moto spiritualists work to guide spirits to their proper place, that they may return to the eternal cycle, keeping the cosmos in balance. However, some beings defy the cycle through heresies such as undeath—and Moto Avengers are specialists trained to rectify such perversions of the natural order. The many Moto who have became Tainted within the Shadowlands have drawn Avengers from the distant corners of the Moto lands, that they might destroy these abominations and free the spirits of their fallen comrades."

        PROPERTIES {
            ^"School Name" STRING "Moto Avenger" FIXED
            ^"Clan" STRING "Unicorn"
            ^"Roles" LIST ["Shugenja"]
            ^"Ring Increase" DEF {
                ^"Air" INTEGER 1
                ^"Earth" INTEGER 1
            }
            ^"Starting Skills" DEF { CHOOSE 3 [^"Courtesy", ^"Culture", ^"Martial Arts [Melee]", ^"Sentiment", ^"Survival", ^"Theology"] INTEGER 1 }
            ^"Starting Honor" INTEGER DEFAULT 44
            ^"Techniques Available" LIST ["Air and Earth Invocations", "Rituals", "Shūji"]
        }

        STARTING_TECHNIQUES {
            INVOCATION ^"Grasp of Earth"
            INVOCATION ^"Tempest of Air"
            SHUJI ^"Ancestry Unearthed"
            SHUJI ^"Honest Assessment"
        }

        SCHOOL_ABILITY "Hands of Earth and Sky" {
            "When you perform an invocation that targets at least one other character, if you succeed, you may nourish or drain:\n\nIf you nourish, you may receive fatigue up to your school rank. One target removes fatigue equal to the amount you received.\n\nIf you drain, you may remove an amount of fatigue from yourself up to your school rank. One target receives fatigue equal to the amount you removed."
        }

        MASTERY_ABILITY ^"Empathic Transfer" {
            "When you nourish, you may remove one condition the target is suffering by transferring it to yourself. When you drain, you may remove one condition you are suffering by transferring it to one of your targets."
        }
        STARTING_OUTFIT [
            "traveling clothes", "ashigaru armor",
            "wakizashi", "scroll satchel",
            "finger of jade", "traveling pack",
            "Unicorn warhorse"
        ]

        CURRICULUM {
            RANK 1 {
                SKILL_GROUP "Scholar Skills"
                SKILL "Command"
                SKILL "Martial Arts [Melee]"
                SKILL "Survival"
                TECHNIQUE_GROUP "Rank 1 Rituals"
                ^"Bind the Shadow" [invocation]
                ^"Caress of Earth" [invocation]
            }
            RANK 2 {
                SKILL_GROUP "Martial Skills"
                SKILL "Culture"
                SKILL "Medicine"
                SKILL "Theology"
                TECHNIQUE_GROUP "Rank 1-2 Air Invocations"
                ^"Essence of Jade" [invocation]
                ^"Touchstone of Courage" [shuji]
            }
            RANK 3 {
                SKILL_GROUP "Trade Skills"
                SKILL "Courtesy"
                SKILL "Martial Arts [Melee]"
                SKILL "Tactics"
                TECHNIQUE_GROUP "Rank 1-3 Earth Shūji"
                ^"Earthquake" [invocation]
                ^"Earth Becomes Sky" [invocation]
            }
            RANK 4 {
                SKILL_GROUP "Social Skills"
                SKILL "Medicine"
                SKILL "Sentiment"
                SKILL "Theology"
                TECHNIQUE_GROUP "Rank 1-4 Earth Invocations"
                ^"Rise, Air" [invocation]
                ^"Wolf's Proposal" [shuji]
            }
            RANK 5 {
                SKILL_GROUP "Scholar Skills"
                SKILL "Martial Arts [Melee]"
                SKILL "Performance"
                SKILL "Survival"
                TECHNIQUE_GROUP "Rank 1-5 Air Invocations"
                ^"Rouse the Soul" [shuji]
                ^"Tomb of Jade" [invocation]
            }
            RANK 6 {
                ^"Empathic Transfer"
            }
        }

    }

    # source (page 94)
    #f4mQUgKp9rXuztSlaU1XSz ^"Toritaka Phantom Hunter" DEF {
        EXTENDS #L5R252wX4yZ6aB8cD0eF2g ^"School"
        APPLIES TO [#L5R003xY4zA6bC8dE0fG2hI ^"Samurai"]
        DESCRIPTION "From the days of the Falcon Clan founder, Toritaka Yotogi, Toritaka Phantom Hunters have sought out gaki and other malign supernatural beings, a task that is often unfortunately easy, given the clan's proximity to the haunted Shinomen Forest and the corrupted Shadowlands. Phantom Hunters often act in concert with Crab Clan warriors, using their legendary abilities to detect supernatural threats that others, even the skilled bushi stationed on the Wall, cannot perceive."
        REFERENCES {
            "Crab Clan" -> #t910bf878c97a928e45150 ^"Crab Clan"
        }

        PROPERTIES {
            ^"School Name" STRING "Toritaka Phantom Hunter" FIXED
            ^"Clan" STRING "Falcon"
            ^"Roles" LIST ["Shugenja"]
            ^"Ring Increase" DEF {
                ^"Air" INTEGER 1
                ^"Water" INTEGER 1
            }
            ^"Starting Skills" DEF { CHOOSE 3 [^"Culture", ^"Government", ^"Martial Arts [Melee]", ^"Sentiment", ^"Survival", ^"Theology"] INTEGER 1 }
            ^"Starting Honor" INTEGER DEFAULT 40
            ^"Techniques Available" LIST ["Invocations", "Rituals", "Shūji"]
        }

        STARTING_TECHNIQUES {
            INVOCATION ^"By the Light of the Lord Moon"
            RITUAL ^"Cleansing Rite"
            RITUAL ^"Commune with the Spirits"
            RITUAL ^"Tea Ceremony"
            SHUJI ^"Courtier's Resolve"
        }

        SCHOOL_ABILITY "Eyes of Yotogi" {
            "Otherworldly beings treat your vigilance as being increased by your school rank. When you make a check to search for Otherworldly beings, or make an Initiative check in a conflict against them, if you succeed, add bonus successes equal to your school rank."
        }

        MASTERY_ABILITY ^"Yotogi's Piercing Gaze" {
            "You can perceive beings that are normally invisible to human sight, such as spirits and characters concealed by supernatural abilities. When you deal damage to an Otherwordly being, you ignore an amount of its resistance up to your ranks in Meditation."
        }
        STARTING_OUTFIT [
            "traveling clothes", "sanctified robes",
            "daishō (katana and wakizashi)",
            "scroll satchel", "traveling pack"
        ]

        CURRICULUM {
            RANK 1 {
                SKILL_GROUP "Scholar Skills"
                SKILL "Courtesy"
                SKILL "Martial Arts [Melee]"
                SKILL "Survival"
                TECHNIQUE_GROUP "Rank 1 Air Invocations"
                ^"Bō of Water" [invocation]
                ^"Threshold Barrier" [ritual]
            }
            RANK 2 {
                SKILL_GROUP "Martial Skills"
                SKILL "Culture"
                SKILL "Sentiment"
                SKILL "Theology"
                TECHNIQUE_GROUP "Rank 1-2 Water Shūji"
                ^"Essence of Jade" [invocation]
                ^"Striking as Air" [kata]
            }
            RANK 3 {
                SKILL_GROUP "Social Skills"
                SKILL "Government"
                SKILL "Martial Arts [Melee]"
                SKILL "Sentiment"
                TECHNIQUE_GROUP "Rank 1-3 Water Invocations"
                ^"Rise, Water" [invocation]
                ^"Crescent Moon Style" [kata]
            }
            RANK 4 {
                SKILL_GROUP "Trade Skills"
                SKILL "Martial Arts [Melee]"
                SKILL "Performance"
                SKILL "Theology"
                TECHNIQUE_GROUP "Rank 1-4 Air Invocations"
                ^"Rouse the Soul" [shuji]
                ^"Soul Sunder" [kata]
            }
            RANK 5 {
                SKILL_GROUP "Scholar Skills"
                SKILL "Command"
                SKILL "Courtesy"
                SKILL "Survival"
                TECHNIQUE_GROUP "Rank 1-5 Air Shūji"
                ^"Flowing Water Cut" [kata]
                ^"Wrath of Kaze-no-Kami" [invocation]
            }
            RANK 6 {
                ^"Yotogi's Piercing Gaze"
            }
        }

    }

    # source (page 95)
    #t31UkIleFWhopWPp3cYwLE ^"Yogo Preserver" DEF {
        EXTENDS #L5R252wX4yZ6aB8cD0eF2g ^"School"
        APPLIES TO [#L5R003xY4zA6bC8dE0fG2hI ^"Samurai"]
        DESCRIPTION "Like all Scorpion, Yogo Preservers view their duty to the Emperor as being beyond the considerations of honor. Theirs is a special task, bound to the cursed destiny of the original Yogo—protecting shrines that contain artifacts best lost to history, such as the Black Scrolls. Using their paper servants called shikigami, these somber individuals poison, murder, and thieve—in the name of staving off the darkness that threatens all Rokugan."

        PROPERTIES {
            ^"School Name" STRING "Yogo Preserver" FIXED
            ^"Clan" STRING "Scorpion"
            ^"Roles" LIST ["Shugenja"]
            ^"Ring Increase" DEF {
                ^"Fire" INTEGER 1
                ^"Void" INTEGER 1
            }
            ^"Starting Skills" DEF { CHOOSE 3 [^"Aesthetics", ^"Courtesy", ^"Martial Arts [Melee]", ^"Sentiment", ^"Skulduggery", ^"Theology"] INTEGER 1 }
            ^"Starting Honor" INTEGER DEFAULT 38
            ^"Techniques Available" LIST ["Invocations", "Rituals", "Shūji"]
        }

        STARTING_TECHNIQUES {
            INVOCATION ^"By the Light of the Lord Moon"
            INVOCATION ^"Embrace of Kenro-Ji-Jin"
            INVOCATION ^"Yari of Air"
            RITUAL ^"Craft Shikigami"
            RITUAL ^"Threshold Barrier"
        }

        SCHOOL_ABILITY "Warded Shikigami" {
            "You can have a number of additional shikigami (see page 115) up to your school rank. Once per scene, after you perform an action, you may instruct one of your shikigami to perform an action, for which it benefits from your assistance."
        }

        MASTERY_ABILITY ^"Kingdom of Paper and Ink" {
            "When one of your shikigami performs an action, it may spend (op) as follows: (op)+: Another one of your shikigami at range 0-3 of you may perform an action. Increase the (op) cost of this ability by (op) for each of your shikigami that has acted this turn."
        }
        STARTING_OUTFIT [
            "traveling clothes", "sanctified robes",
            "concealed armor", "wakizashi",
            "bō (staff)", "traveling pack"
        ]

        CURRICULUM {
            RANK 1 {
                SKILL_GROUP "Artisan Skills"
                SKILL "Culture"
                SKILL "Martial Arts [Melee]"
                SKILL "Theology"
                TECHNIQUE_GROUP "Rank 1 Fire Invocations"
                ^"Cloak of Night" [invocation]
                ^"Reflections of P'an Ku" [invocation]
            }
            RANK 2 {
                SKILL_GROUP "Scholar Skills"
                SKILL "Aesthetics"
                SKILL "Courtesy"
                SKILL "Skulduggery"
                TECHNIQUE_GROUP "Rank 1-2 Air Invocations"
                ^"Hands of the Tides" [invocation]
                ^"Skulk" [ninjutsu]
            }
            RANK 3 {
                SKILL_GROUP "Trade Skills"
                SKILL "Government"
                SKILL "Smithing"
                SKILL "Theology"
                TECHNIQUE_GROUP "Rank 1-3 Fire Invocations"
                ^"Vapor of Nightmares" [invocation]
                ^"Wings of the Phoenix" [invocation]
            }
            RANK 4 {
                SKILL_GROUP "Social Skills"
                SKILL "Martial Arts [Melee]"
                SKILL "Performance"
                SKILL "Sentiment"
                TECHNIQUE_GROUP "Rank 1-4 Air Invocations"
                ^"Silencing Stroke" [ninjutsu]
                ^"Suijin's Embrace" [invocation]
            }
            RANK 5 {
                SKILL_GROUP "Artisan Skills"
                SKILL "Culture"
                SKILL "Government"
                SKILL "Theology"
                TECHNIQUE_GROUP "Rank 1-5 Fire Invocations"
                ^"Ever-Changing Waves" [invocation]
                ^"Tomb of Jade" [invocation]
            }
            RANK 6 {
                ^"Kingdom of Paper and Ink"
            }
        }

