    #oUyMn9yMWtdbsrBA8nM2F8 ^"Shadowlands Personal Effects" DEF {
        APPLIES TO [#L5R003xY4zA6bC8dE0fG2hI ^"Samurai"]

        ENTRIES {
            #lx6s1TCdzMu4fIqbX5vksb ^"Climbing Kit" DEF { ^"Cost" STRING "2 bu" ^"Rarity" INTEGER 3 }
            #MbsBPqYhE3aoLmz9B2Zva2 ^"Engineer's Kit" DEF { ^"Cost" STRING "3 bu" ^"Rarity" INTEGER 3 }
            #OJdvLHhsyig6vVDF9wi5cp ^"Sapper's Kit" DEF { ^"Cost" STRING "1 bu" ^"Rarity" INTEGER 3 }
            #7RrUZb18yKq6X08uA2zwJ9 ^"Smithy's Kit" DEF { ^"Cost" STRING "3 bu" ^"Rarity" INTEGER 3 ^"Special" STRING "A smithy's kit is Cumbersome and has a silhouette of 1." }
            #ESywGjv1cMp8DoP40jDPX8 ^"Smoke Arrows" DEF { ^"Cost" STRING "3 bu" ^"Rarity" INTEGER 4 ^"Special" STRING "Smoke arrows modify a bow's profile as follows: Damage –2, Deadliness –2." }
            #MrUdYvNCUIErNxvv7mz4Ba ^"Spyglass" DEF { ^"Cost" STRING "2 koku" ^"Rarity" INTEGER 5 ^"Special" STRING "A common spyglass allows a user to see small items with great clarity and detail at up to range 5. Larger versions can let the user see clearly to range 6, while smaller versions may only be useful out to range 4. What a spyglass can and cannot see is ultimately left to the game master's discretion." }
            #ZS2bffK9Ai6joonWQrLwQM ^"Taketaba" DEF { ^"Cost" STRING "4 bu" ^"Rarity" INTEGER 4 ^"Special" STRING "Taketaba are covered mobile platforms designed to give archers and crossbow users cover on the battlefield." }
            #ehAqFPgLwm14V4Aw2P77fX ^"Tate" DEF { ^"Cost" STRING "3 bu" ^"Rarity" INTEGER 3 ^"Special" STRING "A character can set up a tate as a Support action. Once set, increase the TN of all Attack action checks with projectiles (such as Martial Arts [Ranged] checks) targeting a character behind it by 2." }
        }

    }

    # ===========================
    # SIGNATURE SCROLLS
    # ===========================

    # source (page 108)
    #PmUHRotKIJGpLHffjsm6n7 ^"Shadowlands Signature Scrolls" DEF {
        APPLIES TO [#L5R003xY4zA6bC8dE0fG2hI ^"Samurai"]

        ENTRIES {
            #13dPzDyQjzNVMGUtRxW3QN ^"Ichi's Second Sight" DEF {
                ^"Prerequisites" STRING "Witch Hunter, Crab Clan"
                ^"XP Cost" INTEGER 3
                ^"Effect" STRING "After the shugenja successfully uses an invocation to scry, any Supernatural or Tainted beings they perceive as part of the invocation glow faintly with an aura visible to the shugenja, even through smoke, mist, fog, or obscured vision."
            }

            #jCsFFfkQu2obx7LWUPv3DH ^"Hasegawa's Denial" DEF {
                ^"Prerequisites" STRING "Crab Clan shugenja, school rank 3"
                ^"XP Cost" INTEGER 3
                ^"Effect" STRING "After the shugenja successfully uses an invocation to smite a target, the area at range 0–3 of the target becomes Dangerous terrain for Tainted beings. This effect persists until the start of your next turn."
            }

            #8UGMdHpxDzlEQvItDz0m94 ^"Maikara's Rebuke" DEF {
                ^"Prerequisites" STRING "Shugenja"
                ^"XP Cost" INTEGER 3
                ^"Effect" STRING "After the shugenja successfully uses a Fire invocation to smite a target, that target treats the next attack targeting them as having the Sacred quality. This effect persists until the end of the scene."
            }
        }

    }

    # ===========================
    # ITEM PATTERNS
    # ===========================

    # source (page 109) for all but Pit-Forged Obsidian, which is a page 29
    # sidebar in Chapter 1 and carries its own ^"Source Page".
    #uTykl22MdJN75g1W9UJHbF ^"Shadowlands Item Patterns" DEF {
        APPLIES TO [#L5R003xY4zA6bC8dE0fG2hI ^"Samurai"]

        ENTRIES {
            #DE2lcYB9uJii5XGWSZm1uo ^"Kakita Pattern" DEF { ^"Effect" STRING "A bladed weapon produced in the Kakita Pattern gains +1 deadliness." ^"XP Cost" INTEGER 6 ^"Rarity Modifier" STRING "+4" }
            #pkbdvHKQhxmEgZE7EDH4tP ^"Kenzo Blade" DEF { ^"Effect" STRING "A weapon produced in the Kenzō smithy gains +1 deadliness, –1 damage, and the Resplendent quality." ^"XP Cost" INTEGER 8 ^"Rarity Modifier" STRING "+5" }
            #kvDvJ5DqAQGfy9zmxGUXAT ^"Shirogane Jade Inlay" DEF { ^"Effect" STRING "Weapons and armor designed for Shirogane jade inlay gain the Sacred quality. Armor so altered loses 1 point of physical resistance, and weapons lose 1 point of deadliness. Should the item become Damaged, the jade is chipped away as well and must be reapplied. When this happens, the item loses the Sacred quality until a smith applies more jade resin by making a TN 3 Smithing (Earth) check as a downtime activity. This process consumes one finger of jade per attempt." ^"XP Cost" INTEGER 3 ^"Rarity Modifier" STRING "+2" }
            #AQf7v8DqlFv5xxX2pdbV61 ^"Uchema's Technique" DEF { ^"Effect" STRING "A suit of armor made using Uchema's technique loses the Cumbersome quality and loses 1 point of physical resistance." ^"XP Cost" INTEGER 4 ^"Rarity Modifier" STRING "+3" }
            #QfxCb0J3vLvnNuIFKc29G3 ^"Yasunori Steel" DEF { ^"Effect" STRING "A weapon made from Yasunori steel loses the Ceremonial, Cumbersome, and Resplendent qualities (and can never gain any of these). It gains the Durable quality; if the weapon already has the Durable quality, it gains +1 deadliness instead." ^"XP Cost" INTEGER 5 ^"Rarity Modifier" STRING "+4" }
            # Not printed with the other five: this one is a sidebar in
            # Chapter 1 (Dark Histories) on page 29, which cross-references
            # the pattern rules on page 109. Filed here because it is a
            # Shadowlands item pattern, with its own page recorded.
            #VDjF5H34WyhB1OLSz6V6cr ^"Pit-Forged Obsidian" DEF {
                ^"Effect" STRING "An item produced with Pit-forged obsidian gains +1 damage, +1 deadliness, and the Unholy quality. Additionally, while in possession of such an item, a character increases the TN of their Fitness and Meditation checks to prevent the Afflicted condition (see p. 271 of the Core Rulebook) from conferring the Shadowlands Taint disadvantage by 2 (to TN 6)."
                ^"XP Cost" INTEGER 4
                ^"Rarity Modifier" STRING "+4"
                ^"Source Page" INTEGER 29
            }
        }

    }

    # ===========================
    # ARTIFACTS OF JIGOKU
    # ===========================

    # source (pages 110-111)
    #Vc8DIRx0Z0iNV52OVmhXt0 ^"Artifacts of Jigoku" DEF {
        APPLIES TO [#L5R003xY4zA6bC8dE0fG2hI ^"Samurai"]

        ENTRIES {
            #ByUf7jXi0fWuVRCc8N8E0k ^"The Anvil of Despair" DEF {
                ^"Effect" STRING "The Anvil requires a proper sacrifice for mahō (see p. 224 of the core rulebook) each time you wish to perform a Smithing check using it. Any weapon forged on the Anvil of Despair gains +2 deadliness and the Unholy quality."
                ^"Unmasking Form" STRING "Honor's Challenge"
            }

            #AkKCaCdQdMDBT9goVStbbi ^"The Black Pearls of Fu Leng" DEF {
                ^"Effect" STRING "While wielding a Black Pearl of Fu Leng, you may use mahō without making a proper sacrifice (see page 224 of the core rulebook). When you perform a check to activate a mahō technique without a proper sacrifice, add two kept (ring) dice showing (op) (st) results."
                ^"Unmasking Form" STRING "Bend Principles"
            }

            #05c4H7xoogTolaauSNi7I6 ^"The Henge-Okurimono" DEF {
                ^"Effect" STRING "Each henge-okurimono depicts an animal (all of which can be found on page 325 of the core rulebook). Once per game session as a Support action, you may use a henge-okurimono to curse and augment your body, transforming it into that of the animal depicted in the artwork. While in this form, you use its ring values, derived attributes, abilities, and advantages with the physical or social type, but you use your own skill ranks and advantages with the mental or spiritual types. This effect persists until you choose to end it or are rendered unconscious, at which point your form reverts to its original state and you suffer the Afflicted condition.\n\nDo not remove any fatigue or strife you suffered in the alternate form when you return to your original; if this causes your fatigue to exceed your endurance (or your strife to exceed your composure when it did not in your alternate form, you suffer a critical strike with severity 5 (or you become Compromised, in the case of strife)."
                ^"Unmasking Form" STRING "Panicked Retreat"
            }

            #m2Co9TqM2ui1Dp4QLdIwOv ^"The Porcelain Mask of Fu Leng" DEF {
                ^"Effect" STRING "Once you don the mask, it cannot be removed until your death (or another exceptional event), and you are assigned one Shadowlands Taint disadvantage of the GM's choice.\n\nWhile wearing the mask, as a Support action, you may augment yourself, shifting the mask into an illusion of any face you wish to present; any other character must make a TN 4 Sentiment check (Earth 5, Fire 2) to find a flaw in your facade. This effect persists until you are rendered unconscious or will it to end.\n\nWhile wearing the mask, as a Scheme action, you may scry for supernatural presences, causing them to glow with sickly purple light that only you can perceive. This effect persists until the end of the scene."
                ^"Unmasking Form" STRING "Expose an Opening"
            }
        }

        RULES {
            #wskaMbQW8AEGEOilM9dA3z: the_penalty_for_power "The Penalty For Power: Carrying or using a cursed item warps the character's personality. Their composure is reduced by 2. Additionally, they can only unmask using the Unmasking Form associated with the cursed item."
        }
    }

    # ===========================
    # BLESSED TREASURES
    # ===========================

    # source (pages 112-113)
    #oCtOuQUJKxmRlc8kdHn7ND ^"Blessed Treasures" DEF {
        APPLIES TO [#L5R003xY4zA6bC8dE0fG2hI ^"Samurai"]

        ENTRIES {
            #qXP4Pxyy2JZ5VQ40BQg3pD ^"The Jade Cups of Taira" DEF {
                ^"Type" STRING "Nemuranai"
                ^"Qualities" STRING "Durable, Sacred"
                ^"Quirk" STRING "The cups glow when Otherworldly creatures are nearby (at range 0–3, if relevant)."
                ^"Sealed Invocation" STRING "Once per scene, you may perform the Jurojin's Balm invocation using your Medicine skill."
            }

            #Wk12ocGTlJC0OIfk537sAm ^"Jade Petal Tea" DEF {
                ^"Type" STRING "Consumable"
                ^"Effect" STRING "After you consume jade petal tea, remove the Afflicted condition.\n\nAdditionally, you ignore all of your Shadowlands Taint disadvantages. This effect persists until you suffer the Afflicted condition, or for one week in narrative time (whichever comes first)."
            }

            #U1WtWIhyEcUE09DLok2f0H ^"Kishu: The Oni-Cutting Sword" DEF {
                ^"Type" STRING "Nemuranai (chokoto)"
                ^"Qualities" STRING "+2 deadliness, Sacred, Durable"
                ^"Quirk" STRING "Kishu only cuts when wielded in the left hand."
                ^"Sealed Invocation" STRING "It has the Bind the Shadow invocation sealed within it, which the wielder may perform once per session using Martial Arts [Melee]."
            }

            #pzxvdWNiBhyd8xNsMBFp4X ^"Obsidian Ink" DEF {
                ^"Type" STRING "Consumable"
                ^"Effect" STRING "When preparing an a ward containing an invocation (see Prepared Invocations on page 190 of the core rulebook), if you use obsidian ink, you may receive up to 3 strife to add that many kept (ring) showing (op) results.\n\nAdditionally, you may use this ink mixed with blood to prepare a ward containing a mahō technique as if it were an invocation. If you do, you may suffer up to 3 strife to add that many kept (ring) showing (op) (st) results."
            }
        }

    }

    # ===========================
    # NEW TECHNIQUES
    # ===========================

    # source (page 114)
    #N8h46zSGk4B8NGzskCarvT ^"Shadowlands Techniques" DEF {
        APPLIES TO [#L5R003xY4zA6bC8dE0fG2hI ^"Samurai"]

        ENTRIES {
            #huaXzI41EZmcw0DoJoYvkn ^"Essence of Jade" DEF {
                ^"Type" STRING "Invocation"
                ^"Subtype" STRING "Earth Invocation"
                ^"Rank" INTEGER 3
                ^"Activation" STRING "As a Support action, you may make a TN 3 Theology (Earth) check targeting one position at range 0–2."
                ^"Effect" STRING "If you succeed, you purify the area and remove the Defiled terrain quality from an area that extends a number of range bands around the target position equal to your Earth Ring. This effect persists for one round, plus additional rounds equal to your bonus successes."
                ^"Opportunities" STRING "(op): This effect persists until the end of the scene instead.\n\n(op) (op): While the effect persists, the terrain gains the Hallowed (Earth) terrain quality.\n\n(op): While the effect persists, each Tainted being in the affected area increases the TN of all checks they make to resist effects by 2.\n\n(op): You may choose a character instead of a position. The cleansed area follows that character.\n\n(op): While the effect persists, all damage inflicted in this area has the Sacred quality."
            }

            #8Q95WXPLIapw2pwyU8PGOK ^"Blessing of Steel" DEF {
                ^"Type" STRING "Ritual"
                ^"Subtype" STRING "Artisan Ritual"
                ^"Rank" INTEGER 2
                ^"Activation" STRING "As a downtime activity, you may make a TN 2 Smithing check using any ring to undertake the maintenance of your weapons and armor."
                ^"Effect" STRING "If you succeed, apply one of the following based on the ring you used:\n\nAir: Increase the deadliness of a weapon by 1.\n\nEarth: Remove the Damaged quality from the item. If it did not have the Damaged quality, it gains the Durable quality.\n\nFire: The item gains one quality that it could logically possess. The GM is the final arbiter of what quality can be added this way, and they should inform the player of whether an option is possible before their character undertakes this downtime activity.\n\nWater: Increase the base damage of a weapon by 1 and decrease its deadliness by 1, or increase the supernatural resistance of a set of armor by 1 and reduce its physical resistance by 1.\n\nVoid: Reduce the TN of the next check the character makes with this weapon by 1.\n\nOnly one of these effects can be applied to an item. Any effect applied this way persists until the end of the next scene in which the item is used."
            }

            #y0mXJsFSTGSGuQU4k65pY1 ^"Craft Shikigami" DEF {
                ^"Type" STRING "Ritual"
                ^"Subtype" STRING "Shugenja Ritual"
                ^"Rank" INTEGER 2
                ^"Activation" STRING "As a downtime activity using a consecrated vessel of silhouette 0 or smaller, you may make an Artisan skill (Void) check to create a shikigami (see page 115). You choose the TN of the check (minimum 1)."
                ^"Effect" STRING "If you succeed, choose a number of invocations that you know up to the TN of the check. Record the selected invocations and create a unique name for the shikigami. While the shikigami exists, the chosen invocations are sealed within it—you cannot use them, but the shikigami can. You can have up to one shikigami at a time. When the shikigami's physical form is destroyed, its essence returns to you; you can re-create it by making a new physical form for it in the manner of making a new shikigami, but it retains its memories and personality. The shikigami is intelligent, can communicate with you, and generally obeys your orders. It can perform any invocations you have sealed within it as an action, using your ranks in Composition and its ring value for the skill check."
                ^"Opportunities" STRING "(op): Choose one of your advantages and one of your disadvantages. Add these to the shikigami.\n\n(op): Instead of appearing as the item or material from which it was created, the shikigami has a different form of your choosing of the same silhouette.\n\n(op)+: Increase the silhouette of the shikigami by 1 per (op) spent this way.\n\n(op)+: Choose one skill. The shikigami possesses a number of ranks in this skill equal to the (op) spent this way. You may activate this multiple times for different skills.\n\n(op)+: Increase the shikigami's endurance or composure by 2 per (op) spent this way."
            }
        }

    }

    # ===========================
    # MAHO TECHNIQUES
    # ===========================

    # source (pages 116-120)
    #kSmsjQib39DAnP8bpm9SpI ^"Mahō Techniques" DEF {
        APPLIES TO [#L5R003xY4zA6bC8dE0fG2hI ^"Samurai"]

        ENTRIES {
            #aKuW4Oy3IdcioGBRU5JrFf ^"Accursed Summoning" DEF {
                ^"Rank" INTEGER 1
                ^"Description" STRING "The mahō-tsukai spills blood and recites a foul prayer to summon a chosen oni and bind it to their will. The oni appears caught in an invisible prison, unable to act except at the summoner's direction."
                ^"XP Cost" INTEGER 3
                ^"Activation" STRING "As a downtime activity action, you may make a Theology (Void) check with TN equal to the oni's Intrigue rank."
                ^"Effect" STRING "If you succeed, you summon the desired oni and bind it to your will, unable to act without your consent.\n\nIf you fail, you summon the desired oni (or a different one, at the GM's discretion) but it breaks free of your control and curses you, causing you to suffer the Afflicted condition.\n\nIf you have 3 or more kept (st) results, the summoned oni scries and learns your name."
                ^"Opportunities" STRING "(op)+: The sight of the oni instills primal terror in any onlookers. Each character who can see the oni and is within range 3 suffers a number of strife equal to (op) spent this way. (op)(op): The oni instills a Shadowlands Taint disadvantage of your choice upon anyone within a range equal to the number of your rings with the Shadowlands Taint disadvantage attached."
            }

            #oAQtXgIZM8JjiDeJjxQXpN ^"Bind the Undead" DEF {
                ^"Rank" INTEGER 2
                ^"Description" STRING "The mahō-tsukai draws on the power of Jigoku to extend their will over the animated dead (such as skeletons or zombies). These undead then act as the mahō-tsukai commands, mimicking gestures or following simple instructions. They can attack a target or follow the mahō-tsukai like a squad of troops follows their leader. A smaller number of undead allows the practitioner greater control, and a single undead being can act naturally enough to infiltrate a town or castle, if the practitioner remains nearby and sustains the necessary concentration."
                ^"Activation" STRING "As a Scheme action, you may make a TN 2 Theology (Fire) check targeting a number of undead creatures up to your Earth Ring at range 0–4. You can only choose undead creatures with combat rank 3 or lower this way."
                ^"Effect" STRING "If you succeed, you bind each target to your will. They can now act only under your control, via simple voice commands. You can issue straightforward commands with your allocated five words per turn, or you can issue more complex commands if you dedicate your action to giving a command. If you are killed or become Unconscious due to a critical strike, all bound undead under your control cease to function, slumping to the ground as inanimate corpses. Whether you succeed or fail, an area encompassing 1 range band around each target's position gains the Defiled terrain quality."
                ^"Opportunities" STRING "(op)(op): One undead creature you choose becomes a revenant (see page 18) in addition to becoming bound. (op)+: Treat the maximum range of the technique as 1 higher per (op) spent this way. (op)+: Treat the maximum combat rank of an undead creature you can bind as 1 higher per (op) spent this way. If you bind an intelligent undead creature this way and later lose control of it, it reverts to its own goals instead of becoming inanimate."
            }

            #FKmujLSSs35USGKWx0VVg9 ^"Commune with Evil" DEF {
                PROPERTIES {
                    ^"Rank" INTEGER 1
                    ^"Description" STRING "The practitioner detects any malevolent supernatural entities in the area, senses their desires, and makes a bargain for an unholy blessing."
                    ^"Activation" STRING "As a downtime activity action, you may make a TN 1 Theology (Void) check."
                    ^"Effect" STRING "If you succeed, you scry for the presence of any Otherworldly or Tainted beings at range 0–6."
                    ^"Opportunities" STRING "(op): If there are any such beings, they accept your offering, and they augment you with an unholy blessing that increases the value of the ring you used for the check by 1. You can only have one unholy blessing at a time, and it persists until the end of the scene. (op)(op)(op)+: If you receive an unholy blessing, it temporarily increases the ring's value by an additional 1 per (op)(op)(op) spent this way. (op)+: If you receive an unholy blessing, it persists for 1 additional round per (op) spent this way."
                }
            }

            #RAAE0KVOZV2XhSYoSatg3a ^"Dark Reflection" DEF {
                ^"Rank" INTEGER 1
                ^"Description" STRING "The mahō-tsukai must obtain an obsidian mirror, pool of Tainted water, or other corrupted reflective surface. By appealing to kansen, the practitioner makes the object becomes a divinatory tool for a time. The practitioner can receive visual answers to questions or spy on a person or area. Kansen are willing to play this \"game,\" but the accuracy of images may not be reliable."
                ^"Activation" STRING "As a Support action, you may make a TN 2 Theology (Water) check targeting a person, object, or location you have encountered before."
                ^"Effect" STRING "If you succeed, you scry upon a chosen person or location. However, the image is distorted: one minor detail within it, of the GM's choosing, is always incorrect, reflecting instead the fears or desires of the mahō-tsukai."
                ^"Opportunities" STRING "(op)(op)(op): You bind the kansen within the object permanently. The object gains the Unholy quality and retains its divinatory properties after the initial use. As a Support action, a character may give the object an offering of blood to show the chosen object, person, or location again."
            }

            #BEiQjehGHikrsECdUVEtbP ^"Entreat the Shadow Steed" DEF {
                ^"Rank" INTEGER 2
                ^"Description" STRING "The mahō-tsukai compels the kansen to fetch a suitable mount. The onikage rises from the ground as a skeletal mount, or an undead horse with decaying flesh comes galloping across the Shadowlands."
                ^"Activation" STRING "As a Support action, you may make a TN 2 Theology (Earth) check. This technique can be used only in the Shadowlands, or near a place where the corpse of a horse might be found, such as an ancient or recent battlefield."
                ^"Effect" STRING "If you succeed, you summon an onikage (see page 23) and bind it to your will. It obeys your commands, allowing you to ride it as per the Mounts and Riding rules on page 326 of the core rulebook. It reacts violently if others try to ride it."
                ^"Opportunities" STRING "(op)(op): The equine creature retains enough flesh to pass as a living horse; characters with vigilance 3 or lower do not notice its undead status. (op)(op)(op): Other characters whom you designate can also ride the onikage. (op)(op)+: Summon one additional onikage per (op)(op) spent this way."
            }

            #ULC2xpBdXz04vCZ3LBNsAg ^"Fiend's Retreat" DEF {
                PROPERTIES {
                    ^"Rank" INTEGER 3
                    ^"Description" STRING "This technique allows its user to exchange positions with an unsuspecting character, leaving them to meet a miserable end. The blade descends, but the sorcerer's flesh twists like wax and melts to foul muck, revealing some unfortunate whom the mahō-tsukai left to meet the judgment they so richly deserve."
                    ^"Activation" STRING "Once per scene, as an Attack and Movement action or as an out-of-turn action when you are targeted by an attack, you may make a Theology (Air) check targeting one character at range 2–3. The target must be Incapacitated or a minion NPC, and the TN of the check is equal to the target's vigilance."
                    ^"Effect" STRING "If you succeed, you curse the target, forcing them to exchange physical locations with you. The target becomes the target of any attacks that were targeting you."
                    ^"Opportunities" STRING "(op)+: Choose one additional character at range 0–1 to move and one additional target per (op) spent this way. (op): Increase the maximum range by 1 per (op) spent this way."
                }
            }

            #KiGd5T95TxFEjjx5djW8hH ^"Shape the Flesh" DEF {
                ^"Rank" INTEGER 4
                ^"Description" STRING "The mahō-tsukai transforms their body, taking on a demonic aspect. Ragged wings or a glistening carapace sprouts from their flesh, or their form flows like befouled water, extending unnaturally. They might even fade into living shadow, becoming a creature of pure obscurity that shrugs off even the holiest of talismans and prayers."
                ^"Activation" STRING "As a Support action, you may make a TN 4 Theology check."
                ^"Effect" STRING "If you succeed, you augment and curse yourself in one of the following ways, depending on the ring you used: Talons and Fangs (Fire): The damage and deadliness of your Unarmed profile become 6, and it gains the Unholy quality. Thick Hide (Earth): Your physical resistance becomes 7. Wings (Air): You gain flight; you can move vertically and ignore the negative effects of terrain. Malleable Form (Water): The maximum range of your unarmed and melee attacks becomes 3. Shadowy Form (Void): Your supernatural resistance becomes 7. You count as an Otherworldly being."
                ^"Opportunities" STRING "(op)(op): Once before the end of the scene, as an action, you may perform this technique again with a different ring and maintain both effects."
            }

            #gXpX7wNpEpQoTTsym6jkpf ^"Spiritual Shackles" DEF {
                PROPERTIES {
                    ^"Rank" INTEGER 1
                    ^"Description" STRING "Mahō-tsukai deal constantly with powerful, dangerous beings, and those who live long enough learn that kansen can only be trusted to be untrustworthy—but deceit can be repaid in kind. Other spirits might also seek to wreak vengeance upon mahō-tsukai, from the hungering ghosts called gaki to wrathful ancestor spirits, and it pays to have protection against such beings. The mahō-tsukai uses trickery and sheer will on a kansen or other spirit, sealing it within an object."
                    ^"Activation" STRING "As an Attack and Intrigue action, you may make a Theology (Air) check targeting one Otherworldly being at range 0–1. The TN of this check is equal to the target's vigilance and is reduced by 2 if the target is also a Tainted being."
                    ^"Effect" STRING "If you succeed, you bind the spirit inside an object of silhouette 1 or less at range 0–2. If the being you bound is Tainted, the object gains the Unholy quality. If you fail, the spirit curses you, and you suffer the Afflicted condition."
                    ^"Opportunities" STRING "(op): The object gains one other quality of your choice from the following list: Concealable, Durable, Resplendent, Subtle. (op): As an action, the holder of the object may release the bound being to importune one mahō (or invocation, if you have bound an elemental spirit) without paying the usual costs or making the usual TN adjustments (see Importune Invocations on page 189 and Importune Mahō on page 225 of the core rulebook)."
                }
            }

            #h6FrAFAKdxfnVMjC8Goim3 ^"Spread Corruption" DEF {
                ^"Rank" INTEGER 2
                ^"Description" STRING "The practitioner channels their inner corruption into their skin, so that their touch becomes contagious. Anyone or anything they touch is assailed by the foul influence of the Shadowlands, which seeks any gap in their spiritual fortitude that it can grasp."
                ^"Activation" STRING "As a Support action, you may make a TN 2 Theology (Fire) check."
                ^"Effect" STRING "If you succeed, you augment your touch with a corrupting influence. Anyone whose skin you touch (such as with an unarmed attack) is cursed, and they must resist with a TN 4 Fitness or Meditation check (Earth 2, Fire 5) or suffer fatigue equal to their shortfall and the Afflicted condition. This effect persists until the end of the scene."
                ^"Opportunities" STRING "(op)(op): After you touch someone, the effect is delayed for three rounds, or about a minute in narrative time. (op): While this effect persists, any ground you walk on becomes Defiled terrain (see Terrain on page 267 of the core rulebook). (op)(op): Increase the severity of any critical strike you inflict with your unarmed attack profiles by 2 for each of your rings with the Shadowlands Taint disadvantage."
            }

            #ww1vtd8puCN5512Vr66ZO8 ^"Sword of Blood" DEF {
                ^"Rank" INTEGER 2
                ^"Description" STRING "The mahō-tsukai draws blood from an open wound, the vital fluid swirling up to their outstretched palm and congealing into a deadly weapon."
                ^"Activation" STRING "As a Support action, you may make a TN 2 Theology (Water) check. Performing this technique requires a source of blood, such as a corpse or nearby foe with the Bleeding condition. If the mahō-tsukai uses their own blood, they receive 3 fatigue."
                ^"Effect" STRING "If you succeed, you summon a weapon of your choosing made of blood. It has the Unholy quality (see page 241 of the core rulebook)."
                ^"Opportunities" STRING "(op): You may summon a pair of identical weapons instead of a single weapon. (op): At the end of each of your turns, you may transform the weapon into a different weapon. (op)(op): You may immediately perform a Strike action using the weapon you summoned. (op)(op): After you inflict a critical strike on another character with this weapon, remove fatigue from yourself equal to the severity of the critical strike (after the check to resist)."
            }

            #D15iSHCb6v8x43MeVJmyue ^"Twisted Summons" DEF {
                ^"Rank" INTEGER 3
                ^"Description" STRING "The mahō-tsukai calls forth an abomination from Jigoku, giving it a temporary cage of flesh from which to wreak carnage upon the Mortal Realm. The being that comes forth is a fused horror, an agglomeration of multiple corpses twisted into unnatural form."
                ^"Activation" STRING "As an Intrigue and Support action, you may make a TN 3 Theology (Earth) check to call upon a foul spirit to target a number of corpses at range 0–2, reshaping them into an abominable body for its use."
                ^"Effect" STRING "If you succeed, you summon an Undead Horror (see page 19) and bind it to your will. However, the summoned creature is one not easily kept shackled; if you become Compromised or Incapacitated, it breaks the binding and sets off on its own to devour the living and absorb the dead. Whether you succeed or fail, an area at range 0–2 of your target becomes Defiled terrain."
                ^"Opportunities" STRING "(op)+: The Undead Horror absorbs up to two additional corpses at range 0–2 for each (op) spent this way. Increase its endurance by 2 for each corpse it absorbs. For every five corpses the monster absorbs this way, increase its silhouette by 1."
            }
        }

        RULES {
            #mbKXJ9b5sXEIgtrq7W5ucm: new_maho_techniques "New Mahō Techniques: The following techniques are designed to supplement those in the core rulebook on page 224, allowing characters to embrace the power of mahō. They follow the same rules for proper sacrifices and requisites for learning mahō as described there as well. Fortunately, the Shadowlands boasts kansen eager to whisper to those who can hear, mahō-tsukai requiring apprentices, and the vile texts of the Lost Library."
        }
    }

    # ===========================
    # TITLES
    # ===========================

    # source (pages 128-129)
    #CiaH7xtMLxhy06RNk7v5eC ^"Shadowlands Titles" DEF {
        APPLIES TO [#L5R003xY4zA6bC8dE0fG2hI ^"Samurai"]

        ENTRIES {
            #wHOGPUXXoHU3kIkNR2wOAO ^"The Damned" DEF {
                ^"Assigned By" STRING "Kuni daimyō or other officials. Note that you must possess at least one Shadowlands Taint disadvantage to receive this title."
                ^"Status Award" STRING "-20 (to a maximum of 30)"
                ^"XP to Completion" INTEGER 20
                ^"Immediate Effects" STRING "Gain the Ferocity disadvantage."
                ^"Title Ability" STRING "Tainted Warrior"
                ^"Title Ability Effect" STRING "Increase the TN of all your non-Command Social skill checks by 1, and reduce the TN of all your Martial Arts [Any] skill checks targeting Tainted beings by 1 (to a minimum of 1). Non-Tainted beings receive 1 strife whenever they make a Social skill check targeting you."
                ^"Advancement" LIST OF STRING [
                    "Martial Skills (Skill Group)",
                    "Medicine (Skill)",
                    "Survival (Skill)",
                    "Theology (Skill)",
                    "Rank 1-2 Kata (kata) (Tech Group)",
                    "Heartpiercing Strike (kata)",
                    "Rallying Cry (shuji)"
                ]
            }

            #vxyuVel4hpdEx7jZJMfo6q ^"Harvester" DEF {
                ^"Assigned By" STRING "Hiruma or Kuni officials"
                ^"Status Award" STRING "+10 (to a maximum of 45)"
                ^"XP to Completion" INTEGER 20
                ^"Title Ability" STRING "Capture Evil"
                ^"Title Ability Effect" STRING "Reduce the TN of your Survival checks to track down a Tainted being by 1. When you inflict a critical strike on a Tainted being, you may spend (op) as follows:\n\n(op) (op): The target suffers the Dazed, Disoriented, or Immobilized condition."
                ^"Advancement" LIST OF STRING [
                    "Martial Skills (Skill Group)",
                    "Smithing (Skill)",
                    "Survival (Skill)",
                    "Theology (Skill)",
                    "Rank 1-2 Kata (kata) (Tech Group)",
                    "Rank 1-2 Rituals (ritual)",
                    "Skulk (ninjutsu)"
                ]
            }

            #ig4XUjKleA3pbeknK3fiNb ^"Twenty-Goblin Crab" DEF {
                ^"Assigned By" STRING "Hida daimyo or other officials"
                ^"Status Award" STRING "+15 (to a minimum of 30 and a maximum of 40), officially become samurai and member of Crab Clan."
                ^"XP to Completion" INTEGER 20
                ^"Title Ability" STRING "Goblin Killer"
                ^"Title Ability Effect" STRING "When making a Martial Arts [Any] check targeting a goblin, you may spend (op) as follows:\n\n(op)+: Each other goblin at range 0–2 of your target receives 1 strife per (op) that you spend this way."
                ^"Advancement" LIST OF STRING [
                    "Martial Skills (Skill Group)",
                    "Social Skills (Skill Group)",
                    "Culture (Skill)",
                    "Government (Skill)",
                    "Rank 1-2 Kata (kata) (Tech Group)",
                    "Thunderclap Strike (kata)",
                    "Stonewall Tactics (shuji)"
                ]
            }

            #nZA9jxPyNA5gcGzrOwzYKf ^"Witch Hunter" DEF {
                ^"Assigned By" STRING "Another Witch Hunter"
                ^"Status Award" STRING "+10 (to a minimum of 30)"
                ^"XP to Completion" INTEGER 45
                ^"Title Ability" STRING "Bane of Sorcerers"
                ^"Title Ability Effect" STRING "When you make a check to resist the effects of a mahō technique, you may spend (op) as follows:\n\n(op): Reduce the TN of your next check targeting the mahō practitioner who performed it by 1 per (op) spent this way.\n\n(op) (op): If you succeed on the check to resist, the mahō practitioner receives strife equal to your ranks in Theology."
                ^"Advancement" LIST OF STRING [
                    "Martial Skills (Skill Group)",
                    "Scholar Skills (Skill Group)",
                    "Command (Skill)",
                    "Skulduggery (Skill)",
                    "Rank 1-4 Kata (kata) (Tech Group)",
                    "Rank 1-5 Rituals (ritual) (Tech Group)",
                    "Honest Assessment (shuji)"
                ]
            }
        }

    }

    # ===========================
    # OPPORTUNITY TABLES
    # ===========================

    # source (pages 130-131)
    #eqOLuJMU2R6LROekXqS75X ^"Shadowlands Opportunity Tables" DEF {
        APPLIES TO [#L5R003xY4zA6bC8dE0fG2hI ^"Samurai"]

        ENTRIES {
            #gpGhJGnIazYrNtNIwm1j2s ^"Opportunity in the Shadowlands" DEF {
                ^"Air (op)+" STRING "You detect a subtle sign in your environment that lets you get your bearings, such as a stream that runs slightly less Tainted than the environment around it or the growths on the twisted trees that point toward the Festering Pit. This landmark helps guide you for one scene, plus one additional scene in the Shadowlands per (op) spent this way."
                ^"Earth (op)(op)" STRING "Your resolute nature steels you against the unstable environment of the Shadowlands. You count your vigilance as 1 higher the next time you seek to notice or avoid a hazardous situation or creature."
                ^"Fire (op)+" STRING "You spur your comrades on with pleasing encouragement or biting criticism. One other character in the scene per (op) you spend this way reduces their next TN to resist physical hardship or the influence of the Shadowlands by 1."
                ^"Water (op)(op)+" STRING "By luck or careful scavenging, you are able to find a useful item not yet corrupted by the Shadowlands. Such items have a maximum rarity of 3, plus 1 for each additional (op) (op) spent. The GM should modify this depending on the exact nature of the item as well."
                ^"Void (op)(op)(op)" STRING "Though Jigoku's power weighs heavily upon them, you are undeterred. By drawing on memories of the un-Tainted lands north of the wall, you can keep yourself focused and ignore all (st) results on your next check."
            }

            #ijCtblYAv5jrWwKuEQ4ybc ^"Opportunity Against Tainted Threats" DEF {
                ^"Air (op)(op)" STRING "Confronted with the horrors of the Taint, you remain alert and able to discern a weakness in your foe. Reduce the TN of your next check made to oppose or harm a Tainted character by 1, as you examine the threat before you and formulate an appropriate response."
                ^"Earth (op)(op)" STRING "You are able to weather such terrible things as the revelation of a secret mahō-tsukai or the summoning of an oni. The next time you suffer strife this scene, you suffer 2 fewer strife, to a minimum of 0."
                ^"Fire (op)+" STRING "The righteous fury you display can cow even the most terrible of Tainted fiends. Each Tainted being in the scene gains 1 strife, plus 1 additional strife for every (op) (op) spent. If you are unaware if another character is Tainted, the GM should record this strife secretly."
                ^"Water (op)" STRING "You adapt yourself to better fight the corrupted power before you. Once before the end of current the game session you may either reduce the TN of a check to resist a Tainted power, such as a mahō technique, assailing you by 1 or increase the TN of another character's check to target or affect you with such a power by 1."
                ^"Void (op)(op) or (op)(op)(op)" STRING "If the character spends (op) (op), they discern that the kami have fled, as well as the type of disturbance (mahō, kansen, or similar). If the character spends (op) (op) (op), they can also determine the total combat (combat) threat rating of all Tainted beings that caused the kami to flee."
            }

            #xAxyiSbelY1cpUUibGyBr0 ^"Opportunity While Tainted" DEF {
                ^"Air (op)(op)" STRING "Your newfound cunning is able to redirect attention away from you, potentially concealing your Tainted nature or letting you avoid scrutiny. The TN of the next check made to scrutinize you or your actions is increased by 1."
                ^"Earth (op)(op)" STRING "No mortal concern can slow you, as you already endure worse than most can even imagine. For the rest of the scene, whenever you suffer fatigue reduce the value suffered by 2, to a minimum of 0."
                ^"Fire (op)(op)" STRING "The furious power of Jigoku flows through you, granting you unnatural might. Add 1 kept showing a (st) result to the next Martial Arts check you make. This effect persists until the start of their next turn."
                ^"Water (op)(op)" STRING "You briefly become fluid in mind or body, shaking off disorientation or even injury. You remove one of the following conditions: Dazed, Disoriented, Immobilized, Intoxicated, Lightly Wounded, or Prone."
                ^"Void (op)+" STRING "The unnatural insights of the kansen voice themselves wordlessly to you, granting knowledge you could not possibly have known otherwise. You learn something relevant to the current situation, appropriate in scope to the number of (op) spent. For each (op) spent in this way, you receive 1 strife due to the unnatural means by which you gained this knowledge."
            }
        }

    }

    # ===========================
    # ONI GENERATION
    # ===========================

    # source (pages 134-136)
    #3Mz9VYTWsPrckpwxKLausg ^"Oni Generation" DEF {
        APPLIES TO [#t9446c0a7f578c8eaf296f ^"System"]

        ENTRIES {
            #rFh1F0e3PBKn2DwQrwTyKx ^"Vile Trickster (Lesser Oni)" DEF {
                ^"Combat Conflict Rank" INTEGER 4
                ^"Intrigue Conflict Rank" INTEGER 8
                ^"Silhouette" INTEGER 2
                ^"Max Shadowlands Powers" INTEGER 2
                ^"Restrictions" STRING "None"
            }

            #ih2HSa2oIpn7KGIsnw69H7 ^"Savage Brute (Lesser Oni)" DEF {
                ^"Combat Conflict Rank" INTEGER 10
                ^"Intrigue Conflict Rank" INTEGER 3
                ^"Silhouette" INTEGER 4
                ^"Max Shadowlands Powers" INTEGER 2
                ^"Restrictions" STRING "It may purchase up to two of the Shadowlands powers beginning on page 137, except for Captivating Voice, Human Mask, Illusion Master, or Scent of Weakness."
            }

            #m71icWululsVBXqKuZGcjf ^"Hellish Sorcerer (Powerful Oni)" DEF {
                ^"Combat Conflict Rank" INTEGER 8
                ^"Intrigue Conflict Rank" INTEGER 10
                ^"Silhouette" INTEGER 3
                ^"Max Shadowlands Powers" STRING "It automatically possesses the Tainted Sorcery Shadowlands power, and it may purchase up to two additional Shadowlands powers from those beginner on page 137."
                ^"Restrictions" STRING "None"
            }

            #HIotNN7cSwy3SK5rQbcNO0 ^"Monstrous Warrior (Powerful Oni)" DEF {
                ^"Combat Conflict Rank" INTEGER 12
                ^"Intrigue Conflict Rank" INTEGER 4
                ^"Silhouette" INTEGER 4
                ^"Max Shadowlands Powers" INTEGER 4
                ^"Restrictions" STRING "None"
            }

            #Wvd15aGdaYFhKxN0bKWebc ^"Warlord of Jigoku (Powerful Oni)" DEF {
                ^"Combat Conflict Rank" INTEGER 14
                ^"Intrigue Conflict Rank" INTEGER 10
                ^"Silhouette" INTEGER 5
                ^"Max Shadowlands Powers" INTEGER 5
                ^"Restrictions" STRING "None"
            }
        }

        RULES {
            #OdjPZLUlmw6letp1fmt0xl: hierarchy_of_oni "Hierarchy of Oni: When creating an oni antagonist, the GM should first select a profile from one of the following options. Each oni is truly a unique being—but within the mortal realm, oni are capable of splitting into multiple forms to act in several places simultaneously. Lesser oni represent small shards of an oni's soul, and are the weakest. Next are powerful oni, which are quite potent and possess a more substantial array of tricks and abilities, but still might have 1-2 other forms active. Finally, oni lords are complete beings—the full entity, with all its dread powers—and can threaten even the most powerful groups of samurai."
        }
    }

    # ===========================
    # SHADOWLANDS POWERS
    # ===========================

    # source (pages 137-140)
    #pjYabBNdgTN5MtIdcYLfeQ ^"Shadowlands Powers" DEF {
        APPLIES TO [#t9446c0a7f578c8eaf296f ^"System"]

        ENTRIES {
            #ic1JbaekbOP1spdrL8AfiQ ^"Bony Carapace" DEF { ^"Threat" STRING "(combat)+2" ^"Description" STRING "The oni is covered in thick hide, bony plates, or some other form of natural armor beyond even the substantial protection typical of its kind." ^"Restriction" STRING "Cannot be selected with Serpentine Speed." ^"First Rank" STRING "Increase the oni's physical resistance by 2 and its supernatural resistance by 1." ^"Additional Ranks" STRING "Increase the oni's physical resistance by 1." }
            #dNYmGaBabGCFOaZRkeKqI5 ^"Captivating Voice" DEF { ^"Threat" STRING "(intrigue)+2" ^"Description" STRING "Some oni speak with honeyed voices at odds with their hideous appearance, giving them the ability to cajole and coerce even stalwart samurai with their words." ^"First Rank" STRING "As a Scheme action, the oni may attempt to influence the mind of a listener by making a Social (Fire) check with a TN equal to the target's vigilance. If the oni succeeds, the target suffers 1 strife, plus 1 strife for every 2 bonus successes. If the oni is aware of the target's ninjō, it adds 4 bonus successes to the check if it succeeds. A character who becomes compromised in this manner must spend 1 Void point or immediately unmask." ^"Additional Ranks" STRING "Reduce the TN of the check by 1 (to a minimum of 0)." }
            #gkDZ5RTQgrNLVgoD7bchop ^"Dark Puppet" DEF { ^"Threat" STRING "(combat)+2, (intrigue)+2" ^"Description" STRING "By some vile art, the oni is able to act as if it is many in number. Splitting their form in this manner usually weakens them, but some can bend a suitable substitute to their will, striking through their shadow or another sinister proxy." ^"First Rank" STRING "Once per scene, the oni may perform a second action at Initiative 0." ^"Additional Ranks" STRING "The oni may use this power one addition time per scene. It can only use it once per round." }
            #gK0tW5OtH6DyXGTUQgbkCO ^"Foul Separation" DEF { ^"Threat" STRING "(combat)+1, (intrigue)+1" ^"Description" STRING "Beyond the ability to manifest as numerous lesser versions of themselves, some oni exhibit the even more disturbing power to tear out their own organs or limbs to serve as puppets for their will, allowing them to see, act, or speak at a distance. The scuttling claw of an oni can serve as a secretive assassin, its tongue could utter terrifying secrets of Jigoku or whisper lies to a samurai to tempt them into betraying their comrades, and its floating eye might be able to spy on foes who would spot the massive demon were it to approach." ^"First Rank" STRING "When purchasing this power, the GM must select a body part the oni can remove, typically an eye, hand, or tongue. The oni may tear this element of its body out or reattach it freely, but it reduces its endurance by 5 and all of its rings by 1 while the body part remains separate. The body part then acts separately from the oni, possessed of all of the oni's senses and awareness and directed by its will, using the oni fragment profile presented here. Any critical strike inflicted destroys the fragment, although the oni can regrow a body part destroyed in this way over a single month." ^"Second Rank" STRING "Choose 1 additional body part that the oni can split off." }
            #SR0FVPGkbhB6UYoPR0YeER ^"Human Mask" DEF { ^"Threat" STRING "(intrigue)+4" ^"Description" STRING "The most cunning of oni sometimes transform themselves into human guise. Though imperfect, these disguises are often capable of fooling the unwary and allow the oni to close with a victim or to bypass a foolish sentry. Closer scrutiny often reveals the truth, however, as even the cleverest of oni won't follow (or comprehend) the tenets of Bushidō properly. Less cunning oni, with little or no understanding of how to act human, behave in bizarre fashions that even gaijin would notice as not falling within Rokugani norms." ^"First Rank" STRING "As a Scheme action, oni with this power can weave an illusion of Tainted sorcery to change its apparent nature. It may only initiate this illusion while unseen by others. While under the illusion, the oni appears to be a normal human unafflicted by the Taint, its silhouette is reduced to 2, and it is unaffected by its Sickening Visage disadvantage. However, some element of the oni's inhuman nature remains, allowing careful observers to note something wrong by performing a TN 4 Medicine (Air) or Theology (Earth) check. Outside of the Shadowlands, the oni's illusions are harder to maintain, reducing the TN of the check to 3. Success reveals the horn carefully hidden in hair, the fire in the oni's eyes, or some other tell that reveals it as an inhuman monster. The oni may dismiss the illusion as a Support action and typically does so before engaging in combat." }
            #1uBLPaDYXJxJ8jCb1XN8ag ^"Illusion Master" DEF { ^"Threat" STRING "(combat)+3, (intrigue)+3" ^"Description" STRING "The treachery of oni knows no bounds, and some oni have learned vile magics that can deceive the senses and mind into perceiving that which is not there. By means of this sorcery, these oni are able to call up phantasms of lost family to torment samurai, to cloak their movements in impenetrable shadow, or to appear to be more numerous and terrible than they truly are." ^"First Rank" STRING "Oni with this power can call forth illusions of objects, people, and creatures as a Support action. Once created, an illusion remains for the duration of the scene, continuing to act in accordance with the oni's will. The oni may maintain illusions with total silhouette no greater than 8, with two silhouette 0 illusions counting as a single point of silhouette. Therefore, the oni could create the illusion of two ogres (silhouette 4 each), or it could make itself appear to be even larger (increasing its apparent silhouette by 1), wielding a sword the size of a tall human (silhouette 2), and preceded by a pack of five Tainted hounds (silhouette 1 each). The illusions the oni creates have no substance and cannot directly physically harm anyone, but they can speak if the oni wishes it, or conceal details such as deadfalls or other dangers. Touching an illusion reveals its falsehood but does not end its effects unless the illusion is brought into contact with jade. Characters who have reason to suspect an illusion can attempt to see through it or reveal it with a TN 3 check using a skill the GM deems appropriate." }
            #r7mlgiwzZsSiEInfZRdKHC ^"Obsidian Jaws" DEF { ^"Threat" STRING "(combat)+4" ^"Description" STRING "The hideous visages of some oni are further marred by massive jaws filled with teeth of obsidian shards." ^"First Rank" STRING "The oni gains the following unarmed attack profile: Obsidian Bite (Range 0, Damage 4, Deadliness 8, Razor-Edged, Unholy)." ^"Additional Ranks" STRING "After the oni inflicts a critical strike using this profile, it removes 2 fatigue per additional rank purchased." }
            #YLuQ1DH7djktjouIHTb4Ld ^"Scent of Weakness" DEF { ^"Threat" STRING "(intrigue)+3" ^"Description" STRING "The secret desires of a samurai's heart are as playthings to an oni, who may be able to see hidden weakness as if written in burning letters on the samurai's face or to smell the wants and needs the samurai keeps hidden as clearly as wafting perfume." ^"First Rank" STRING "As a Scheme Action, the oni may make a Social (Air) check targeting one character in the scene with a TN equal to the target's vigilance. Success reveals the target's ninjō to the oni, including contextual details. For example, an oni using this power against a character with a ninjō of secret love would learn not only about this hidden desire, but also whom the character longs for, what their love looks like, and similar information as the GM deems appropriate. This does not in and of itself grant the oni power over the target, but may help the oni in other ways, such as empowering the Captivating Voice power (see page 137) or enabling it to further a secret scheme. Characters who have their secrets exposed to the oni in this way have no way of knowing the extent of what it learned." ^"Additional Ranks" STRING "Reduce the TN of the check by 1 (to a minimum of 0)." }
            #0hi1OvZB8BJ2CeGXD1Tahv ^"Serpentine Speed" DEF { ^"Threat" STRING "(combat)+2" ^"Description" STRING "Oni with this power are preternaturally swift, capable of reacting and moving with blinding speed. The impossible grace of a massive and powerful oni has been the downfall of many skilled samurai." ^"Restriction" STRING "Cannot be selected with Bony Carapace." ^"First Rank" STRING "Increase the oni's focus attribute by 2 and decrease the TN of Fitness checks it makes by 1 (to a minimum of 0)." ^"Additional Ranks" STRING "Increase the oni's focus attribute by an additional 2." }
            #CyWt9AskhXfUFRjFOKI0jc ^"Shadowlands Venom" DEF { ^"Threat" STRING "(combat)+4" ^"Description" STRING "The oni's weapons or attacks carry the threat of deadly venom, smeared on a weapon or injected by its claws or bite." ^"First Rank" STRING "After the oni inflicts the Bleeding condition on a target, that target also suffers the Lightly Wounded condition for one ring of the oni's choice." ^"Additional Ranks" STRING "Increase the TN of checks to resist critical strikes inflicted by this oni by 1." }
            #WIiVw16scQbEoWRgTyiODB ^"Tainted Sorcery" DEF { ^"Threat" STRING "(combat)+5, (intrigue)+5" ^"Description" STRING "Some of the most fearsome oni wield powerful Tainted sorcery akin to mahō, cowing the kansen into submission or drawing on the power of Jigoku instead of enticing the corrupted spirits with blood offerings." ^"First Rank" STRING "An oni with this power gains up to three mahō techniques, chosen from pages 224–225 of the core rulebook and from pages 118–121 of this book. When using these powers, the oni never suffers spiritual backlash, nor does it take damage for channeling the techniques. For the purposes of using mahō, all five of the oni's rings count as having the Shadowlands Taint disadvantage attached." ^"Additional Ranks" STRING "The oni may be given 2 additional mahō techniques." }
        }

        RULES {
            #nqY55y5GqnrhBGMT1TIcdR: shadowlands_powers "Shadowlands Powers: The otherworldly powers of the oni are strange and varied, as their demonic proclivities take many different forms. Listed on the following pages are example powers, featuring some of the more common tricks and talents oni tend to wield, as well as some that are designed to provide interesting and unique antagonists for players. These powers are by no means a comprehensive list of the capabilities of every kind of oni, but they can still provide a wide array of antagonists or help inspire GMs to design their own unique Shadowlands powers.\n\nEach Shadowlands Power has a value in combat ((combat)) or intrigue ((intrigue)) threat rating (some can have both), listed alongside its name. Add these to the oni's threat values when creating an oni with new powers, then apply the changes listed under the \"First Rank\" entry to the oni's profile.\n\nPowers can also have restrictions, which prevent them from being taken alongside other Shadowlands powers. If a power has restrictions, they are listed in the \"Restrictions\" entry.\n\nSome powers can be purchased multiple times, usually for a lesser cumulative effect. If a power has an \"Additional Ranks\" entry, purchasing it another time (again applying the changes to the oni's threat rating) also confers these effects."
        }
    }

    # ===========================
    # NEW DEMEANOR
    # ===========================

    # source (page 144)
    #0MU5TAHuiXPSMKPCJdQMqB ^"Shadowlands Demeanors" DEF {
        APPLIES TO [#L5R003xY4zA6bC8dE0fG2hI ^"Samurai"]

        ENTRIES {
            #kNkgnrGxz7UEiWeRHJ9lM9 ^"Courageous" DEF {
                ^"Social Skill Check TN Modifiers" STRING "Air +2, Earth -2"
                ^"Common Way of Unmasking" STRING "Angry Dismay"
                ^"Description" STRING "The NPC loudly complains about the cowardice of others around them, especially concerning their lack of concern of Shadowlands threats and a lack of enthusiasm for going to the Wall to better serve the Empire."
            }
        }

    }

    # ===========================
    # NPC TEMPLATES
    # ===========================

    # source (page 144)
    #lbwKIiGtL1fSTKklN9remo ^"Crab Clan Samurai Template" DEF {
        APPLIES TO [#t2513b5e05d845f4411465 ^"NPC Template"]
        PROPERTIES {
            ^"Base Profile" STRING "This template can be used with any clan samurai profile."
            ^"Combat Rank Modifier" STRING "+2"
            ^"Ring Modifier" STRING "+1 Earth"
            ^"Skill Modifier" STRING "+1 Martial and Trade skills"
            ^"Replace Advantages" STRING "0-2: Expert Haggler (Water) [Social; Interpersonal], Large Stature (Earth) [Martial; Physical], Makes Things Work (Water) [Artisan; Physical], Veteran of the Shadowlands (Water) [Martial; Physical]"
            ^"Replace Disadvantages" STRING "0-2: Wall Weary (Earth) [Social; Interpersonal], Bluntness (Air) [Social; Interpersonal], Ends Justify the Means (Void) [Scholar; Mental]"
            ^"Add Techniques" STRING "0-2: Kata, Rituals"
            ^"Replace Demeanor" STRING "1: Courageous, Gruff, Shrewd"
            ^"Replace Equipment" STRING "Replace katana with tetsubō"
        }

    }

    # source (page 144)
    #VdazmuglQ8qzfZY1O2nHok ^"Falcon Clan Samurai Template" DEF {
        APPLIES TO [#t2513b5e05d845f4411465 ^"NPC Template"]
        PROPERTIES {
            ^"Base Profile" STRING "This template can be used with any clan samurai profile."
            ^"Combat Rank Modifier" STRING "+1"
            ^"Ring Modifier" STRING "+1 Void"
            ^"Skill Modifier" STRING "+2 Scholar skills"
            ^"Replace Advantages" STRING "0-2: Knowledge of Gaki (Void) [Scholar; Mental], Probing Sight (Water) [Martial; Physical], Sense for the Spirits (Void) [Martial; Spiritual]"
            ^"Replace Disadvantages" STRING "0-2: Disdain for Courtly Matters (Air) [Social; Interpersonal], Close to the Edge (Void) [Social; Spiritual], Deals with Spirits (Fire) [Social; Interpersonal]"
            ^"Add Techniques" STRING "0-2: Invocations, Rituals"
            ^"Replace Demeanor" STRING "1: Detached, Gruff"
        }

    }

    # source (page 144)
    #CxQh0icGvgzZrqPYy6cMna ^"Tainted Template" DEF {
        APPLIES TO [#t2513b5e05d845f4411465 ^"NPC Template"]
        PROPERTIES {
            ^"Base Profile" STRING "This template can be used with any clan samurai profile as well as the trained ashigaru and skillful rōnin profiles."
            ^"Combat Rank Modifier" STRING "+2"
            ^"Ring Modifier" STRING "+1 Earth"
            ^"Skill Modifier" STRING "+1 Martial skills, –1 Social skills (to minimum of 0)"
            ^"Replace Advantages" STRING "0-2: Accepts the End (Void) [Social; Mental], Knows the Enemy (Earth) [Scholar; Mental], Veteran of the Shadowlands (Water) [Martial; Physical]"
            ^"Replace Disadvantages" STRING "1-2: Shadowlands Taint (Any) [varies]. Other 0-2: Quick to Rage (Air) [Martial; Mental], Distrust of Kuni (Water) [Social; Interpersonal], any disadvantage with Mental type"
            ^"Replace Demeanor" STRING "1: Assertive, Detached, Gruff"
        }

    }

    # ===========================
    # BUSHIDO: COURAGE
    # ===========================

    # source (page 142)
    #S01KscJ7iw92rvtUqTJ8eK ^"Bushido Courage" DEF {
        APPLIES TO [#L5R003xY4zA6bC8dE0fG2hI ^"Samurai"]

        ENTRIES {
            #ah8UwhX6YC7ESlWBBWcGZk ^"Trifling Breaches of Courage" DEF {
                ^"Honor Cost" STRING "they must first forfeit 1 honor."
                ^"Examples" LIST OF STRING [
                    "Allowing fear for someone else's well-being to influence your actions",
                    "Concealing your identity in battle",
                    "Avoiding a conflict when you are in the right",
                    "Saving yourself when risking yourself would have advanced your lord's goals"
                ]
            }

            #IIQKkHopxUgJS7C03Sn5aP ^"Small Sacrifices of Courage" DEF {
                ^"Honor Award" STRING "they are awarded 1 honor."
                ^"Examples" LIST OF STRING [
                    "Accepting a challenge from an enemy of unknown skill",
                    "Enduring a minor public humiliation to right a wrong",
                    "Publicly attempting something in which you have no skill in order to serve your lord",
                    "Refusing to back down when faced with superior forces"
                ]
            }
        }

        RULES {
            #gxdO41E1VJjNFuzksgJf6R: trifling_breaches_and_small_sacrifices "Trifling Breaches and Small Sacrifices: In the Legend of the Five Rings core rulebook, there are guidelines for gaining honor for virtuous deeds, as well as for forfeiting honor to act disgracefully. However, minor acts can affect one's honor as well. A samurai ideally adheres to Bushidō in all aspects of their life, and many small demonstrations eventually add up. What follows are optional additions to Tables 7–1: Honor and Glory Forfeits/Awards on page 300 and the examples related to Courage on pages 301–302 of the core rulebook."
        }
    }
}
