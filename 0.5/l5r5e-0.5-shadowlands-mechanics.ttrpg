    # ===========================
    # NEW ADVANTAGES: DISTINCTIONS
    # ===========================

    # source (page 96)
    #UkCsgi3RCaVd6w2DWeFfKD ^"Dead Eyes" DEF {
        EXTENDS #L5R266oP8qR0sT2uV4wX6y ^"Distinction"

        PROPERTIES {
            ^"Ring" STRING "Earth"
            ^"Types" LIST ["Mental"]
        }

        EFFECT {
            "After what of you've seen, the world holds no true dread for you any more. While you are not immune to stress or fear, during battle you go \"dead in the eyes,\" allowing you to act unclouded by terror, emotion, sentiment, or hesitation even while Compromised (though you still suffer the negative mechanical effects of this state). You are also more dour at other times, and struggle to find pleasure in many of life's joys."
            "When performing a check that relies on avoiding fear or exuberant emotions (such as a Meditation [Earth] check to avoid running screaming from a monstrous oni or a Sentiment [Earth] check to avoid being caught up in a raucous crowd), you may reroll up to two dice."
        }
    }

    # source (page 96)
    #Kcn8ABMVaRfzSJedO4Sg7w ^"Friend of the Nezumi" DEF {
        EXTENDS #L5R266oP8qR0sT2uV4wX6y ^"Distinction"

        PROPERTIES {
            ^"Ring" STRING "Water"
            ^"Types" LIST ["Interpersonal"]
        }

        EFFECT {
            "Somehow you earned the respect and admiration of the nezumi, and you count them among your closest allies. You are an honorary member of a specific nezumi tribe, able to enter their warrens freely and enjoy the hospitality of their people. You speak their language at a basic level, understand their culture and customs, and may ask their leaders for favors."
            "When performing a check to interact with nezumi or one that relates to your status with them (such as a Courtesy [Water] check with a nezumi to help locate a secret tunnel near the Wall or a Performance [Water] check to convince a tribe to follow your lead), you may reroll up to two dice."
        }
    }

    # source (page 96)
    #ZaRBxpji1gXG47PojQidDR ^"Light Sleeper" DEF {
        EXTENDS #L5R266oP8qR0sT2uV4wX6y ^"Distinction"

        PROPERTIES {
            ^"Ring" STRING "Water"
            ^"Types" LIST ["Physical"]
        }

        EFFECT {
            "You rouse from sleep very easily, a trick considered essential in hostile territory. You are trained to awaken before danger arrives, sleep with your weapons ready, and pretend to be in a deep sleep to lure enemies closer. You can go from a deep sleep to fully alert and fighting in the blink of an eye."
            "When performing a check that calls on rapidly recovering from sleep (such as a Survival [Water] check to detect a threatening sound while dozing or a Fitness [Water] check to react even when someone else is standing watch), you may reroll up to two dice."
        }
    }

    # ===========================
    # NEW ADVANTAGES: PASSIONS
    # ===========================

    # source (page 97)
    #GBe9j7QB8wqggtN9iemLjy ^"Creatures" DEF {
        EXTENDS #L5R267zA9bC1dE3fG5hI7j ^"Passion"

        PROPERTIES {
            ^"Ring" STRING "Fire"
            ^"Types" LIST ["Mental"]
        }

        EFFECT {
            "You are fascinated by strange creatures, monsters, bakemono, and other such oddities. You can easily identify such creatures and know them by heart. Tales of monsters and local horror folklore transfix you, and you are always eager to build your wealth of monster lore further."
            "After performing a check to study or hear tales of odd creatures (such as a Culture [Fire] check to wonder about new creatures or a Performance [Fire] check to entice someone to offer you a tale of encounters with Shadowlands monsters), you remove 3 strife."
        }
    }

    # ===========================
    # NEW DISADVANTAGES: ADVERSITIES
    # ===========================

    # source (page 97)
    #5qGJm232wFrnJonGVA4o7e ^"Demon Wound" DEF {
        EXTENDS #L5R268kL0mN2oP4qR6sT8u ^"Adversity"

        PROPERTIES {
            ^"Ring" STRING "Earth"
            ^"Types" LIST ["Spiritual", "Scar"]
        }

        EFFECT {
            "You were wounded by an oni, and while the scar isn't Tainted (or perhaps even isn't visible anymore), it causes you to suffer from terrible nightmares."
            "When you make a check that involves your wound (such as a Fitness [Earth] check to get a good night's sleep while in the Shadowlands or a Meditation [Earth] check to refrain from crying out in pain while near an oni), you must choose and reroll two dice showing (su) or (ex) results. After resolving the check, if you failed, you gain 1 Void point."
        }
    }

    # source (page 97)
    #bbDCa12PAIg5fbGUmCE7dg ^"Lost Name" DEF {
        EXTENDS #L5R268kL0mN2oP4qR6sT8u ^"Adversity"

        PROPERTIES {
            ^"Ring" STRING "Void"
            ^"Types" LIST ["Spiritual"]
        }

        EFFECT {
            "Your name is no longer your own, and it now belongs to an oni. Perhaps it was stolen from you, taken in a moment of weakness. Or perhaps you gave it willingly in exchange for fell power. But now the oni knows your every secret, hears your every thought, and can see the world through your eyes. You are both bonded now, and it will surely end you if you cannot sever the connection."
            "When you make a check that involves personal convictions (such as a Meditation [Void] check as part of your quest for Enlightenment or a Survival [Void] check to create a spiritually harmonious rock garden), you must choose and reroll two dice showing (su) or (ex) results. After resolving the check, if you failed, you gain 1 Void point."
        }
    }

    # ===========================
    # NEW DISADVANTAGES: ANXIETIES
    # ===========================

    # source (page 98)
    #Yps0IWCyFYIV54aNdENLsE ^"Fallen Ancestor" DEF {
        EXTENDS #L5R269vW1xY3zA5bC7dE9f ^"Anxiety"

        PROPERTIES {
            ^"Ring" STRING "Void"
            ^"Types" LIST ["Spiritual", "Interpersonal"]
        }

        EFFECT {
            "Your ancestor fell to Jigoku's seductive call, giving their name to an oni or committing a terrible atrocity. Now their spirit calls to you from Jigoku's maw, tempting you into following them down the same dark path."
            "After performing a check that involves the spirits or your family history (such as a Theology [Void] check to perform a family ritual or a Sentiment [Void] check to show mercy to a wounded opponent), you receive 3 strife. If this is the first time this has occurred this scene, gain 1 Void point."
        }
    }

    # source (page 98)
    #VE9IiZz29pKSzOnbm6jBtS ^"Obtuse" DEF {
        EXTENDS #L5R269vW1xY3zA5bC7dE9f ^"Anxiety"

        PROPERTIES {
            ^"Ring" STRING "Air"
            ^"Types" LIST ["Mental"]
        }

        EFFECT {
            "Try as you may, you just cannot enjoy art, poetry, music, or other such needless frivolities. Subtlety is lost on you, beauty is something you don't comprehend, art is a waste of resources, and anything but the purely functional is meaningless in your eyes. Your dour presence can be overwhelming in social settings, and you generally forget social niceties unless reminded."
            "After performing a check to analyze or react to the emotions of others (such as a Design [Air] check to compliment someone's garb or a Sentiment (Air) to decode a double meaning in someone else's speech), you receive 3 strife. If this is the first time this has occurred this scene, gain 1 Void point."
        }
    }

    # source (page 98)
    #II6nF1W1EgpnWzWb9Q8m2W ^"Reformed Mahō-Tsukai" DEF {
        EXTENDS #L5R269vW1xY3zA5bC7dE9f ^"Anxiety"

        PROPERTIES {
            ^"Ring" STRING "Water"
            ^"Types" LIST ["Interpersonal"]
        }

        EFFECT {
            "Once you were a mahō-tsukai who wielded dreadful blood magics under the tutelage of the Bloodspeakers or your own occult study. But that was then. You have since seen the error of your ways and live a life of atonement. You've done everything you can to bury your past, but a bell cannot be unrung, and now and again it still catches up with you. The consequences of the atrocities you committed still find you out, oni you summoned still seek you, and the tsukai with whom you once consorted will stop at nothing to silence you. We cannot outrun our shadows; sooner or later, you known that yours will claim their due. If the details of this your terrible past life become public, your glory value decreases dramatically, as if you had lost staked glory (by 30 to 40). Your status value also decreases considerably by the same amount, as if you had lost staked status."
            "After performing a check that reminds you of your former life (such as a Courtesy [Water] check to speak pleasantly with a priest or religious scholar or a Meditation [Water] check to calm yourself when witnessing the aftermath of a blood magic sacrifice), you receive 3 strife. If this is the first time this has occurred this scene, gain 1 Void point."
        }
    }

    # ===========================
    # SHADOWLANDS TAINT DISADVANTAGES
    # ===========================

    # source (page 99)
    #JfyXGsK46GBfTQh5H2A743 ^"Shadowlands Taint [Kansen Whispers]" DEF {
        EXTENDS #L5R268kL0mN2oP4qR6sT8u ^"Adversity"

        PROPERTIES {
            ^"Ring" STRING "Air"
            ^"Types" LIST ["Curse", "Mental"]
        }

        EFFECT {
            "You are a Tainted being. The kansen speak to you each night, filling your dreams with secrets of Rokugani history concerning betrayals, foolish decisions, and many, many lies. Each morning, you awaken filled with anger at your society, but can you never remember the details of the revealed knowledge."
            "When you make a check to use subtlety in your communications (such as a Courtesy [Air] check to convey a double-meaning in court or a Composition [Air] check refine your letter declining an important invitation), you must choose and reroll two dice showing (su) or (ex) results. After resolving the check, if you failed, you gain 1 Void point."
        }
    }

    # source (page 99)
    #76H9zmfkVo7z4jHljq5Yf9 ^"Shadowlands Taint [Distorted Limbs]" DEF {
        EXTENDS #L5R268kL0mN2oP4qR6sT8u ^"Adversity"

        PROPERTIES {
            ^"Ring" STRING "Earth"
            ^"Types" LIST ["Curse", "Physical"]
        }

        EFFECT {
            "You are a Tainted being. One or more of your limbs or digits grew longer but became less powerful. You are able to reach things in narrow gaps and can climb faster than normal."
            "When you make a check that calls on your physical prowess (such as a Fitness [Earth] check to survive a fall or a Labor [Earth] check to exert yourself in the field), you must choose and reroll two dice showing (su) or (ex) results. After resolving the check, if you failed, you gain 1 Void point."
        }
    }

    # source (page 100)
    #2x9ScRqXFLZ0gAyygdMQRA ^"Shadowlands Taint [Unnatural Skin]" DEF {
        EXTENDS #L5R268kL0mN2oP4qR6sT8u ^"Adversity"

        PROPERTIES {
            ^"Ring" STRING "Fire"
            ^"Types" LIST ["Curse", "Physical"]
        }

        EFFECT {
            "You are a Tainted being. Your skin is leathery and thick and may even take on the coloration of a corpse. Your skin is treated as concealed armor (see page 237 of the core rulebook)."
            "When you make a check requiring rapid movements (such as a Fitness [Fire] check to vault over a falling log or a Martial Arts [Unarmed] [Fire] check to strike swiftly), you must choose and reroll two dice showing (su) or (ex) results. After resolving the check, if you failed, you gain 1 Void point."
        }
    }

    # source (page 100)
    #Y6bL1K3hVtNuLt6MVVu87P ^"Shadowlands Taint [One with the Darkness]" DEF {
        EXTENDS #L5R268kL0mN2oP4qR6sT8u ^"Adversity"

        PROPERTIES {
            ^"Ring" STRING "Void"
            ^"Types" LIST ["Curse", "Physical", "Spiritual"]
        }

        EFFECT {
            "You are a Tainted being. When fully covered by shadows or in an unlit location, you cannot be detected. You are also able to conceal nonphysical effects of the Taint from any detection."
            "When you make a check to intuit meaning (such as a Courtesy [Void] check to seek a hidden threat in a message or a Survival [Void] check to sense what crops will grow best next season), you must choose and reroll two dice showing (su) or (ex) results. After resolving the check, if you failed, you gain 1 Void point."
        }
    }

    # source (page 100)
    #PxKQqmufeREBQHe06ojbvg ^"Shadowlands Taint [Blasphemous Appetites]" DEF {
        EXTENDS #L5R268kL0mN2oP4qR6sT8u ^"Adversity"

        PROPERTIES {
            ^"Ring" STRING "Water"
            ^"Types" LIST ["Curse", "Mental", "Spiritual"]
        }

        EFFECT {
            "You are a Tainted being. Your appearance now includes fetid breath, bleeding gums, and jagged, discolored teeth. You have a near uncontrollable hunger for raw meat: the bloodier, the better. You aren't particular over the species and may even devour carrion or small chunks of obsidian if especially ravenous. Once sated with such delights, you remove all strife."
            "When you make a check to notice details about those you care about (such as a Sentiment [Water] check to detect the emotional state of a friend or a Medicine [Water] check to determine their physical state), you must choose and reroll two dice showing (su) or (ex) results. After resolving the check, if you failed, you gain 1 Void point."
        }
    }

    # ===========================
    # NEW SAMURAI HERITAGES
    # ===========================

    # source (page 101)
    #sjspnEQLKWzlue6QrU3JSb ^"Shadowlands Heritages" DEF {
        APPLIES TO [#L5R003xY4zA6bC8dE0fG2hI ^"Samurai"]

        HERITAGE_TABLE {

            1 #2NmqoZtn7CJUKF8hO4WyFa ^"Blood and Mortar" DEF {
                MODIFIERS {
                    ^"Status" "+3"
                }

                EFFECT {
                    "You gain the Blessed Lineage advantage (see page 103 of the core rulebook) This can be assigned in excess of the normal limitations on disadvantages at character creation."
                    "While on the Wall, your glory rank is treated a1 higher."
                }
            }

            2-3 #hyanImCpyOtCRSTIXhnMSH ^"Infamous Builder" DEF {
                MODIFIERS {
                    ^"Glory" "-5"
                }

                EFFECT {
                    "Roll a ten-sided die again to determine a skill to aid in restoring your ancestor's name (1–3: Government, 4–6: Labor, 7–10: Smithing); gain +1 rank in that skill."
                }

                SUB_TABLE "1d10" {
                    "1-3" "Government"
                    "4-6" "Labor"
                    "7-10" "Smithing"
                }
            }

            4-5 #84VwRxlSr08Adoy6Rhk4q7 ^"Lost in the Darkness" DEF {
                MODIFIERS {
                    ^"Honor" "+5"
                    ^"Glory" "-5"
                }

                EFFECT {
                    "Roll a ten-sided die again to determine a skill to aid in learning of your ancestor's fate (1–3: Culture, 4–6: Survival, 7–10: Theology); gain +1 rank in that skill.\n\nAdditionally, your ancestor might still be alive, in the Shadowlands...waiting."
                }

                SUB_TABLE "1d10" {
                    "1-3" "Culture"
                    "4-6" "Survival"
                    "7-10" "Theology"
                }
            }

            6-7 #m9cR6fegiA8hgMJ2dy8NPD ^"Vengeance for the Fallen" DEF {
                MODIFIERS {
                    ^"Honor" "+5"
                }

                EFFECT {
                    "You gain the Haunting (Void) adversity (see page 122 of the core rulebook). This can be assigned in excess of the normal limitations on disadvantages at character creation. Roll a ten-sided die again to determine a Martial skill (1–3: Fitness, 4–5: Martial Arts [Melee], 6–7: Martial Arts [Ranged], 8: Martial Arts [Unarmed], 9: Tactics, 10: Meditation); gain +1 rank in that skill."
                }

                SUB_TABLE "1d10" {
                    "1-3" "Fitness"
                    "4-5" "Martial Arts [Melee]"
                    "6-7" "Martial Arts [Ranged]"
                    "8" "Martial Arts [Unarmed]"
                    "9" "Tactics"
                    "10" "Meditation"
                }
            }

            8-9 #1iKq9ZKDEFk338jFlNxji5 ^"Twenty Goblin Thief" DEF {
                MODIFIERS {
                    ^"Glory" "-3"
                }

                EFFECT {
                    "Roll a ten-sided die again to determine a skill to aid in learning of your ancestor's fate (1–3: Culture, 4–6: Skulduggery, 7–10: Theology); gain +1 rank in that skill."
                }

                SUB_TABLE "1d10" {
                    "1-3" "Culture"
                    "4-6" "Skulduggery"
                    "7-10" "Theology"
                }
            }

            10 #xNOTS8vnId74g6lqsZ9RVf ^"Tainted Blood" DEF {
                MODIFIERS {
                    ^"Status" "-3"
                }

                EFFECT {
                    "You gain the Fallen Ancestor disadvantage (see 98)."
                    "Choose one of your character's rings; you may reduce the value of that ring by 1 to increase the value of your Void Ring by 1 (this still cannot raise it above 3)."
                }
            }
        }

        RULES {
            #z8W3UeBt5sTEMwrsB5BZVk: new_samurai_heritages "New Samurai Heritages: A variety of unique heritages arise from having a bloodline derived—at least in part—from the Crab. This is true even for non-Crab characters, who may bear Crab blood because of the marriage of members of that clan into their family lineage. There are also more sinister heritages that might apply, thanks to the influence of the Shadowlands and the Taint of Jigoku.\n\nTable 2–1: New Samurai Heritages represents these backgrounds when creating a new samurai PC who has ancestral connections with the Crab Clan or to Shadowlands. This table can be used instead of Table 2–1: Samurai Heritages on page 96 of the core rulebook, and is used in the same manner."
        }
    }

    # ===========================
    # NEW WEAPONS
    # ===========================

    # source (pages 102-104)
    #g9IXW2vCHvwbpZEDxhpspF ^"Shadowlands Weapons" DEF {
        APPLIES TO [#L5R003xY4zA6bC8dE0fG2hI ^"Samurai"]

        ENTRIES {
            #tBgSRsVVBDIdP1dUcGMbDh ^"Flyssa" DEF { ^"Category" STRING "Sword" ^"Skill" STRING "Martial Arts [Melee]" ^"Range" STRING "1" ^"Damage" INTEGER 4 ^"Deadliness" INTEGER 4 ^"Grips" STRING "1-hand: -; 2-hand: Razor-Edged" ^"Qualities" STRING "Wargear" ^"Rarity" INTEGER 8 ^"Cost" STRING "15 koku" ^"Special" STRING "While making an Attack action check using a flyssa, you may spend (op) as follows:\n\n(op) (op)+: Ignore 1 point of your target's physical resistance per (op) (op) spent this way." }
            #BFgjnFJU9wmxv9Oz7HDX3r ^"Kabutowari" DEF { ^"Category" STRING "Sword" ^"Skill" STRING "Martial Arts [Melee]" ^"Range" STRING "0-1" ^"Damage" INTEGER 3 ^"Deadliness" INTEGER 3 ^"Grips" STRING "1-hand: -" ^"Qualities" STRING "Durable, Snaring" ^"Rarity" INTEGER 7 ^"Cost" STRING "6 koku" }
            #leuagzC6zrrOGWF4STaBfZ ^"Tekkan" DEF { ^"Category" STRING "Sword" ^"Skill" STRING "Martial Arts [Melee]" ^"Range" STRING "1-2" ^"Damage" INTEGER 4 ^"Deadliness" INTEGER 3 ^"Grips" STRING "1-hand: Cumbersome; 2-hand: Damage +2" ^"Qualities" STRING "Durable, Wargear" ^"Rarity" INTEGER 8 ^"Cost" STRING "50 koku" }
            #CGItLx4r8lPR7OK4f3UBLo ^"Genno" DEF { ^"Category" STRING "Hammer" ^"Skill" STRING "Martial Arts [Melee]" ^"Range" STRING "0-1" ^"Damage" INTEGER 3 ^"Deadliness" INTEGER 3 ^"Grips" STRING "1-hand: -; 2-hand: Damage +4" ^"Qualities" STRING "Durable, Mundane" ^"Rarity" INTEGER 5 ^"Cost" STRING "1 koku" ^"Special" STRING "When you perform an Attack action check with this weapon, you may spend (op) as follows:\n\n(op) (op): If you succeed but your target reduces the damage of this Attack action to 0, they suffer the Dazed and Prone conditions." }
            #WOGFKsz54i88BxV0Bfxv6o ^"Tsuruhashi" DEF { ^"Category" STRING "Axe" ^"Skill" STRING "Martial Arts [Melee]" ^"Range" STRING "1" ^"Damage" INTEGER 4 ^"Deadliness" INTEGER 3 ^"Grips" STRING "1-hand: Cumbersome; 2-hand: Deadliness +2" ^"Qualities" STRING "Mundane" ^"Rarity" INTEGER 4 ^"Cost" STRING "5 bu" ^"Special" STRING "When you perform an Attack action check with this weapon, you may spend (op) as follows:\n\n(op) (op): If you succeed but your target reduces the damage of this Attack action to 0, their armor gains the Damaged quality and they suffer the Bleeding condition." }
            #gmLJffhOaTCEy7VzHLhzeO ^"Doom Crossbow" DEF { ^"Category" STRING "Crossbow" ^"Skill" STRING "Martial Arts [Ranged]" ^"Range" STRING "3-5" ^"Damage" INTEGER 8 ^"Deadliness" INTEGER 6 ^"Grips" STRING "2-hand: -" ^"Qualities" STRING "Cumbersome, Prepare, Wargear" ^"Rarity" INTEGER 10 ^"Cost" STRING "80 koku" ^"Special" STRING "When you perform an Attack action with a doom crossbow that inflicts a critical strike, increase the severity by the silhouette of the target." }
            #WMhsZeUximbOu1cNVtLw6C ^"Kaiu no Oyumi" DEF { ^"Category" STRING "Crossbow" ^"Skill" STRING "Martial Arts [Ranged]" ^"Range" STRING "2-5" ^"Damage" INTEGER 7 ^"Deadliness" INTEGER 3 ^"Grips" STRING "2-hand: -" ^"Qualities" STRING "Cumbersome, Prepare, Wargear" ^"Rarity" INTEGER 8 ^"Cost" STRING "60 koku" ^"Special" STRING "When performing an Attack action check with this weapon, you may spend (op) as follows:\n\n(op) (op): After performing the Attack action, immediately prepare this weapon for use again." }
            #7mjgYtbRHF99VmwPWby7jN ^"Storm Bow" DEF { ^"Category" STRING "Crossbow" ^"Skill" STRING "Martial Arts [Ranged]" ^"Range" STRING "1-4" ^"Damage" INTEGER 4 ^"Deadliness" INTEGER 3 ^"Grips" STRING "2-hand: -" ^"Qualities" STRING "Cumbersome, Prepare, Wargear" ^"Rarity" INTEGER 9 ^"Cost" STRING "60 koku" ^"Special" STRING "When performing an attack action check with this weapon, you may spend (op) as follows:\n\n(op): Each character at range 0–1 of your initial target also becomes a target of this attack." }
            #r30CTp40kuTjABJFMP0l61 ^"Sode" DEF { ^"Category" STRING "Shield" ^"Skill" STRING "Martial Arts [Melee]" ^"Range" STRING "0" ^"Damage" INTEGER 1 ^"Deadliness" INTEGER 1 ^"Grips" STRING "Shoulder: -" ^"Qualities" STRING "Durable, Wargear" ^"Rarity" INTEGER 8 ^"Cost" STRING "8 koku" ^"Special" STRING "A set of sode do not require free hands to wield, but cannot be wielded with another shield. While wielding readied sode, treat your physical resistance as 1 higher when reducing damage from projectile attacks (such as Martial Arts [Ranged] checks)." }
            #pOQGMeEJnFQ1EcHao6aCFz ^"Large Shield" DEF { ^"Category" STRING "Shield" ^"Skill" STRING "Martial Arts [Melee]" ^"Range" STRING "0" ^"Damage" INTEGER 3 ^"Deadliness" INTEGER 2 ^"Grips" STRING "1-hand: -" ^"Qualities" STRING "Cumbersome, Durable, Wargear" ^"Rarity" INTEGER 8 ^"Cost" STRING "10 koku" ^"Special" STRING "While you have a readied large shield, treat your physical resistance as 6.\n\nAs a Movement and Support action, if you have a shield readied, you may increase the TN of Attack action checks made targeting you by 2. This persists until the start of your next turn." }
            #wMjt9k6ubQy44RhPdYL1mi ^"Small Shield" DEF { ^"Category" STRING "Shield" ^"Skill" STRING "Martial Arts [Melee]" ^"Range" STRING "0" ^"Damage" INTEGER 2 ^"Deadliness" INTEGER 2 ^"Grips" STRING "1-hand: -" ^"Qualities" STRING "Cumbersome, Durable, Wargear" ^"Rarity" INTEGER 8 ^"Cost" STRING "6 koku" ^"Special" STRING "While you have a readied small shield, treat your physical resistance as 5.\n\nAs a Movement and Support action, if you have a shield readied, you may increase the TN of Attack action checks made targeting you by 1. This persists until the start of your next turn" }
            #uDY5pIP5bZTvQuZIIbFkpP ^"Ballista" DEF { ^"Category" STRING "Siege" ^"Skill" STRING "Martial Arts [Ranged]" ^"Range" STRING "3-5" ^"Damage" INTEGER 14 ^"Deadliness" INTEGER 8 ^"Grips" STRING "2-hand: -" ^"Qualities" STRING "Durable, Prepare (2)" ^"Rarity" INTEGER 7 ^"Cost" STRING "60 koku" ^"Special" STRING "Damage inflicted with a ballista ignores 4 points of physical resistance." }
            #4BKxa6LZIxDkOiKUtGXFRQ ^"O-Gata Dohou" DEF { ^"Category" STRING "Siege" ^"Skill" STRING "Martial Arts [Ranged]" ^"Range" STRING "4-5" ^"Damage" INTEGER 16 ^"Deadliness" INTEGER 6 ^"Grips" STRING "2-hand: -" ^"Qualities" STRING "Durable, Prepare (2)" ^"Rarity" INTEGER 7 ^"Cost" STRING "120 koku" }
        }

    }

