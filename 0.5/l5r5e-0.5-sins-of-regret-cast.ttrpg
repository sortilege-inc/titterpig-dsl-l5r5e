        #D3SiClFusCdxULMl65r72H ^"Claim the Advantage" DEF { ^"Effect" STRING "In a mass battle, each opposing commander treats the TN of their initiative check as increased by 2." }

        RULES {
            #kV98jvGaXQndpxtNOntqXU: background "Kazumi has been waiting for a chance to prove her skills for a long time, and she is willing to do whatever it takes to claim victory. Her body and mind are as keen as her weapons, and she is determined to test all on the battlefield. She has no fear of death, only obscurity."
        }
    }

    # ═══════════════════════ OTHERWORLDLY BEINGS ═════════════════════════

    #SeKQrBxBlbiAmyTJ29PTVf ^"Kyōkotsu" DEF {
        EXTENDS #t4540de6f35155c46f41f0 ^"NPC"
        PROPERTIES {
            ^"Type" STRING "Adversary" FIXED
            ^"Combat Conflict Rank" INTEGER 5
            ^"Intrigue Conflict Rank" INTEGER 1
            ^"Rings" DEF { ^"Air" INTEGER 3 ^"Earth" INTEGER 2 ^"Fire" INTEGER 4 ^"Water" INTEGER 3 ^"Void" INTEGER 1 }
            ^"Demeanor" STRING "Vengeful"
            ^"Endurance" INTEGER 14
            ^"Composure" INTEGER 6
            ^"Focus" INTEGER 6
            ^"Vigilance" INTEGER 2
            ^"Skills" LIST OF STRING ["Artisan 0", "Martial 4", "Scholar 1", "Social 2", "Trade 1"]
            ^"Advantages" LIST OF STRING ["Feels No Pain — Martial; Physical"]
            ^"Disadvantages" LIST OF STRING ["Lost and Confused — Social; Mental"]
            ^"Favored Weapons" LIST OF STRING ["Mournful Wail: Range 0–3, Damage 3, Deadliness 3, inflicts supernatural damage"]
            ^"Gear" LIST OF STRING ["Gear (equipped): Infused bones (Physical 5, Supernatural 2)"]
        }
        DESCRIPTION "ADVERSARY. Conflict Rank — Combat 5, Intrigue 1. The Remains of Nahoko. No societal scores (Otherworldly)."
        #XJWCxFaVC0vK8ZFerEqYx7 ^"Animated Bones" DEF { ^"Effect" STRING "A kyōkotsu is an Otherworldly being of silhouette 1. A critical strike of any severity scatters the bones and renders them inanimate for one round. It is only defeated when its fatigue exceeds its endurance." }
        #O3aEFbYMS19Tv14hbINAgD ^"Vengeful Touch" DEF { ^"Effect" STRING "Anyone who comes within range 0 of the spirit or otherwise directly touches it suffers the Enraged condition (see page 272 of the core rulebook)." }

        RULES {
            #Pv6YfZXudrM50TuXjvBcjp: background "The kyōkotsu manifests as a horrific spectral figure, containing the decayed and unarticulated bones of Otomo Nahoko. It screams with rage at any who draw near, a wail that bursts ears and shrives the very soul."
        }
    }

