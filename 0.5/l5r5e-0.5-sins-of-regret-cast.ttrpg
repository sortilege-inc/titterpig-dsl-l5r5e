        #UEhefozEMQpZtX0mvH1i3v ^"Protective Spirit" DEF { ^"Effect" STRING "A shachihoko is an Otherworldly being of silhouette 1 that can fly. It can move vertically and ignore the negative effects of terrain." }
    }
}
