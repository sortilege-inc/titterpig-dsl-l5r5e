# L5R 5E — Sins of Regret: Dramatis Personae (cast NPCs / adversaries)
# "Sins of Regret: An Adventure in the Forgotten Heart of the Empire" (FFG),
# a rōnin adventure at Closed Shell Castle. NPC statblocks transcribed verbatim
# from the printed profiles: rings, conflict ranks, derived attributes, honor/
# glory/status, skill-group ranks, advantages/disadvantages, favored weapons &
# gear, and abilities (verbatim in nested ^"Name" DEF { ^"Effect" ... } blocks).
# The Otherworldly beings (kyōkotsu, shachihoko) carry no societal scores. This
# adventure uses the players' own rōnin characters, so there are no pregens; the
# structure is in l5r5e-0.5-sins-of-regret.arc and the narrative in the .lore.

EXTENSION "L5R5e_SinsOfRegret_Cast" {
    VERSION "0.5.3"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-09-03"
    DEPENDS_ON "L5R5e_Core_Core"

    # ═══════════════════════ TWIN BLESSINGS VILLAGE ═══════════════════════

    #IgXuKjRwdNj1nekgSiqIO4 ^"Ichirō (Sins of Regret)" DEF {
        EXTENDS #t4540de6f35155c46f41f0 ^"NPC"
        PROPERTIES {
            ^"Type" STRING "Adversary" FIXED
            ^"Combat Conflict Rank" INTEGER 2
            ^"Intrigue Conflict Rank" INTEGER 1
            ^"Rings" DEF { ^"Air" INTEGER 2 ^"Earth" INTEGER 2 ^"Fire" INTEGER 3 ^"Water" INTEGER 2 ^"Void" INTEGER 1 }
            ^"Demeanor" STRING "Ambitious"
            ^"Endurance" INTEGER 10
            ^"Composure" INTEGER 7
            ^"Focus" INTEGER 5
            ^"Vigilance" INTEGER 2
            ^"Honor" INTEGER 10
            ^"Glory" INTEGER 10
            ^"Status" INTEGER 15
            ^"Skills" LIST OF STRING ["Artisan 0", "Martial 2", "Scholar 0", "Social 1", "Trade 1"]
            ^"Advantages" LIST OF STRING ["Wary — Martial; Physical"]
            ^"Disadvantages" LIST OF STRING ["Idealistic — Social; Mental"]
            ^"Favored Weapons" LIST OF STRING ["Kama: Range 0–1, Damage 3, Deadliness 3/5, Concealable"]
            ^"Gear" LIST OF STRING ["Gear (equipped): Peasant garb (Physical 1), bandit mask"]
        }
        DESCRIPTION "ADVERSARY. Conflict Rank — Combat 2, Intrigue 1. Bandit Leader."
        #L3ZZ6RxTS98CFN0BCanBws ^"Forest Fighter" DEF { ^"Effect" STRING "When Ichirō makes a Martial skill check while in forest, he adds one rolled (ring)." }

        RULES {
            #J0CMZHM4ZM7qjl7C9sk53A: background "Ichirō could not bear to watch his father, Setsuo, submit to Jikai's cruelty, so he abandoned the village to live in the forest. Reo the dōshin, or local law enforcer, followed him. They gathered together several of the villagers who wanted to fight rather than starve, most of whom trained with Michi (see page 11). Ichirō is young and naïve, and if the PCs swear to keep his presence secret, he does not prevent them from leaving the Hermitage. Although Ichirō tells the other bandits that the Perfect Land Sect will appear to help them one day, he cannot really know this. In the meantime, he encourages the bandits to train and hunt in secret in the forest. He hopes to ultimately help the village by overthrowing Jikai. How and when has never been established, and he fears the others will lose faith in him before he finds the resources and will to put his plan into action."
        }
    }

    #VakzLUNGNDAKSTKuL71kkN ^"Reju Tsugumasa" DEF {
        EXTENDS #t4540de6f35155c46f41f0 ^"NPC"
        PROPERTIES {
            ^"Type" STRING "Adversary" FIXED
            ^"Combat Conflict Rank" INTEGER 2
            ^"Intrigue Conflict Rank" INTEGER 3
            ^"Rings" DEF { ^"Air" INTEGER 3 ^"Earth" INTEGER 3 ^"Fire" INTEGER 1 ^"Water" INTEGER 2 ^"Void" INTEGER 2 }
            ^"Demeanor" STRING "Detached"
            ^"Endurance" INTEGER 8
            ^"Composure" INTEGER 10
            ^"Focus" INTEGER 3
            ^"Vigilance" INTEGER 3
            ^"Honor" INTEGER 34
            ^"Glory" INTEGER 42
            ^"Status" INTEGER 40
            ^"Skills" LIST OF STRING ["Artisan 0", "Martial 1", "Scholar 2", "Social 2", "Trade 1"]
            ^"Advantages" LIST OF STRING ["Analytical Thinking — Scholar; Mental"]
            ^"Disadvantages" LIST OF STRING ["Haughty — Social; Mental"]
            ^"Favored Weapons" LIST OF STRING ["Katana: Range 1, Damage 4, Deadliness 5/7, Ceremonial, Razor-Edged"]
            ^"Gear" LIST OF STRING ["Gear (equipped): Lacquered armor (Physical 4, Ceremonial, Cumbersome, Wargear), wakizashi"]
        }
        DESCRIPTION "ADVERSARY. Conflict Rank — Combat 2, Intrigue 3. Magistrate."
        #HoAlkvNTJLWJa6jOtepUyM ^"Elitist" DEF { ^"Effect" STRING "When making a check to give orders to a subordinate or other character with lower status, Tsugumasa counts his Social skill ranks as 4. After making a Social skill check targeting one or more peasants, Tsugumasa receives 2 strife." }

        RULES {
            #zpiO3PDnep8QR26in9kaGf: background "The magistrate is an aloof but honest man who's been in the daimyō's service a long time. He's trusted and works hard, but his job here is very different from when his lord lived in the capital. He is accustomed to ordering servants but doesn't like dealing with farmers. Tsugumasa would rather oversee from afar and let the bushi do the work. He does not trust the newly made samurai, but they at least attempt to behave like proper samurai when he is present. He is loyal and dedicated but has a fondness for wealth and comfort that is not satisfied in his current situation."
        }
    }

    #l61kx7lWynQSxZbxBC41Ww ^"Michi" DEF {
        EXTENDS #t4540de6f35155c46f41f0 ^"NPC"
        PROPERTIES {
            ^"Type" STRING "Adversary" FIXED
            ^"Combat Conflict Rank" INTEGER 4
            ^"Intrigue Conflict Rank" INTEGER 2
            ^"Rings" DEF { ^"Air" INTEGER 1 ^"Earth" INTEGER 3 ^"Fire" INTEGER 3 ^"Water" INTEGER 2 ^"Void" INTEGER 4 }
            ^"Demeanor" STRING "Teasing"
            ^"Endurance" INTEGER 12
            ^"Composure" INTEGER 10
            ^"Focus" INTEGER 4
            ^"Vigilance" INTEGER 6
            ^"Honor" INTEGER 25
            ^"Glory" INTEGER 36
            ^"Status" INTEGER 22
            ^"Skills" LIST OF STRING ["Artisan 0", "Martial 3", "Scholar 1", "Social 2", "Trade 0"]
            ^"Advantages" LIST OF STRING ["Quick Reflexes — Martial; Physical"]
            ^"Disadvantages" LIST OF STRING ["Poverty — Trade; Interpersonal"]
            ^"Favored Weapons" LIST OF STRING ["Sturdy Walking Stick: Range 0–1, Damage 3, Deadliness 3/5, Mundane"]
            ^"Gear" LIST OF STRING ["Gear (equipped): Monk's robes (Physical 1, Mundane)"]
        }
        DESCRIPTION "ADVERSARY. Conflict Rank — Combat 4, Intrigue 2. The Monk."
        #HgvungJbJS8CUNRnFqTFyU ^"Everything Is Connected" DEF { ^"Effect" STRING "As an action, Michi can activate any rank 1 kihō of any element but cannot use its burst effect." }
    }

    # ═══════════════════════ THE REJU FAMILY (CLOSED SHELL CASTLE) ════════

    #APx8F7vNrSmS6NscQxgJ8D ^"Reju Jikai" DEF {
        EXTENDS #t4540de6f35155c46f41f0 ^"NPC"
        PROPERTIES {
            ^"Type" STRING "Adversary" FIXED
            ^"Combat Conflict Rank" INTEGER 3
            ^"Intrigue Conflict Rank" INTEGER 5
            ^"Rings" DEF { ^"Air" INTEGER 3 ^"Earth" INTEGER 2 ^"Fire" INTEGER 2 ^"Water" INTEGER 4 ^"Void" INTEGER 3 }
            ^"Demeanor" STRING "Irritable"
            ^"Endurance" INTEGER 10
            ^"Composure" INTEGER 12
            ^"Focus" INTEGER 5
            ^"Vigilance" INTEGER 4
            ^"Honor" INTEGER 32
            ^"Glory" INTEGER 57
            ^"Status" INTEGER 58
            ^"Skills" LIST OF STRING ["Artisan 4", "Martial 2", "Scholar 4", "Social 3", "Trade 0"]
            ^"Advantages" LIST OF STRING ["Poetic Soul — Scholar; Mental"]
            ^"Disadvantages" LIST OF STRING ["Fatalistic — Social; Mental"]
            ^"Favored Weapons" LIST OF STRING ["Wakizashi: Range 0–1, Damage 3, Deadliness 5/7, Ceremonial, Razor-Edged"]
            ^"Gear" LIST OF STRING ["Gear (equipped): Ceremonial robes (Physical 1, Ceremonial, Resplendent), calligraphy set, personal chop"]
        }
        DESCRIPTION "ADVERSARY. Conflict Rank — Combat 3, Intrigue 5. Daimyō of Closed Shell Castle."
        #ibloI5M1xGsH9bwM1dtzXP ^"Selective Hearing" DEF { ^"Effect" STRING "The first time another character makes a Social skill check targeting Jikai each scene, if there are 3 or more rolled dice containing (su) or (ex), that character must reroll those results." }

        RULES {
            #Ve2nj4SctREGfAFUHYbXsT: background "Reju Jikai was once an idealist, but his recent turn of fortune and subsequent troubles have made him bitter and angry—largely with himself. Recognizing his own inexperience in governing, he defers to the steward in most things, showing little interest in the lives that depend upon his every decision. Nonetheless, the art of falconry still holds interest. Although he generally conceals the fact, Jikai has always been fascinated by gaijin cultures.\n\nJikai suffers from the Exhausted condition and is unable to remove it unless the PCs resolve his sleeping problems (see Family Quarters on page 18)."
        }
    }

    #koqrICBoGbBHpXaRu277T5 ^"Reju Toshio" DEF {
        EXTENDS #t4540de6f35155c46f41f0 ^"NPC"
        PROPERTIES {
            ^"Type" STRING "Adversary" FIXED
            ^"Combat Conflict Rank" INTEGER 4
            ^"Intrigue Conflict Rank" INTEGER 4
            ^"Rings" DEF { ^"Air" INTEGER 2 ^"Earth" INTEGER 4 ^"Fire" INTEGER 3 ^"Water" INTEGER 2 ^"Void" INTEGER 3 }
            ^"Demeanor" STRING "Fixated"
            ^"Endurance" INTEGER 10
            ^"Composure" INTEGER 12
            ^"Focus" INTEGER 5
            ^"Vigilance" INTEGER 3
            ^"Honor" INTEGER 10
            ^"Glory" INTEGER 32
            ^"Status" INTEGER 35
            ^"Skills" LIST OF STRING ["Artisan 2", "Martial 1", "Scholar 3", "Social 2", "Trade 0"]
            ^"Advantages" LIST OF STRING ["Obsessive Learning — Scholar; Mental"]
            ^"Disadvantages" LIST OF STRING ["Ingratitude — Social; Interpersonal"]
            ^"Favored Weapons" LIST OF STRING ["Wakizashi: Range 0–1, Damage 3, Deadliness 5/7, Ceremonial, Razor-Edged"]
            ^"Gear" LIST OF STRING ["Gear (equipped): Sanctified robes (Physical 1, Supernatural 3, Ceremonial), scroll satchel, enough offerings for 3 earth invocations"]
        }
        DESCRIPTION "ADVERSARY. Conflict Rank — Combat 4, Intrigue 4. Embittered Shugenja."
        #05W88Q1oNUEgfXV2Ql4i6m ^"Manipulator of Kami" DEF { ^"Effect" STRING "Each time Toshio attempts an invocation he uses a material offering, but still suffers spiritual backlash if he generates 3 or more (st). This becomes 1 or more (st) without offerings." }
        #Cda44b9CaZGcPMofoVzozF ^"Tiny Tremors" DEF { ^"Effect" STRING "Tiny Tremors (Invocation): As an Attack action, Toshio can make a TN 1 Theology (Earth) check to summon a small vibration in the floor or ground at a chosen position at range 0–3.\n\n(op)+: Each character at range 0–2 of the chosen position suffer 1 physical damage per (op) spent this way." }

        RULES {
            #ikp4JzW4LZHBtCwJSX4BtL: background "Toshio is the daimyō's spiritual advisor. He traveled with Jikai from Otosan Uchi and resents being compelled to live in this remote castle. He insists that the castle would have to be leveled and completely rebuilt to please the kami, but this is a falsehood. Rather than attempting to right the elemental imbalance, Toshio has deliberately worsened it, ensuring the kami of the land are offended. This is at the suggestion of Nobu, who has promised Toshio wealth and autonomy if he helps Nobu gain power. If the PCs discover what Toshio has been doing and prove this to the daimyō, Toshio attempts to flee rather than admit what he has done or implicate Nobu. Deliberately angering kami not only goes against the Celestial Order, as he's hindering the very lord he should be helping, but is an affront to his status as shugenja. It is a serious spiritual crime against the land itself."
        }
    }

    #ZKJd0HgKn2mEL3e0CH4G47 ^"Reju Ume" DEF {
        EXTENDS #t4540de6f35155c46f41f0 ^"NPC"
        PROPERTIES {
            ^"Type" STRING "Adversary" FIXED
            ^"Combat Conflict Rank" INTEGER 3
            ^"Intrigue Conflict Rank" INTEGER 2
            ^"Rings" DEF { ^"Air" INTEGER 2 ^"Earth" INTEGER 3 ^"Fire" INTEGER 3 ^"Water" INTEGER 2 ^"Void" INTEGER 1 }
            ^"Demeanor" STRING "Ambitious"
            ^"Endurance" INTEGER 10
            ^"Composure" INTEGER 10
            ^"Focus" INTEGER 6
            ^"Vigilance" INTEGER 3
            ^"Honor" INTEGER 56
            ^"Glory" INTEGER 49
            ^"Status" INTEGER 45
            ^"Skills" LIST OF STRING ["Artisan 2", "Martial 2", "Scholar 2", "Social 2", "Trade 0"]
            ^"Advantages" LIST OF STRING ["Dedicated — Martial, Scholar; Mental"]
            ^"Disadvantages" LIST OF STRING ["Restless — Social; Mental"]
            ^"Favored Weapons" LIST OF STRING ["Bokken: Range 1, Damage 3, Deadliness 3, Mundane"]
            ^"Gear" LIST OF STRING ["Gear (equipped): Training clothes (physical 1), katana, wakizashi"]
        }
        DESCRIPTION "ADVERSARY. Conflict Rank — Combat 3, Intrigue 2. Duelist and Heir."
        #WDGWg1k8j8Zh84VeETbkBj ^"Dramatic Duelist" DEF { ^"Effect" STRING "When performing an Attack action, Ume may spend (op) as follows:\n\n(op) (op): If she succeeds, Ume inflicts no damage, and her target receives strife equal to her weapon's base damage plus her bonus successes." }

        RULES {
            #sMzE2YN1LDco7cqG0gQfER: background "Ume is Jikai's niece and heir. A tall girl who lacks grace except when she has a sword in her hand, she performs kata beautifully. In Otosan Uchi she trained with a Kakita sensei, and she misses her training with Kakita Chisato. Though the sword is her art, the capital also contained other pastimes she enjoyed, and she resents her uncle for dragging her down with him."
        }
    }

