# ============================================================================
# .codex SCHEMA — the shared L5R5e lore-graph ontology (spec §25).
#
# Schema-only codex: the CATEGORIES type taxonomy and the RELATIONS predicate
# vocabulary, with NO entity data. Every per-book L5R5e data codex imports this
# via `DEPENDS_ON "L5R5e_Codex_Schema"` so the whole edition shares one taxonomy
# and one predicate set — no category or predicate drift across books. This is
# the BASE half of the BASE/EXTENSION split, applied to the lore graph.
#
# Category note: clans, families, and schools are NOT declared here — they are
# already DEFs in the .ttrpg corpus, and `IS`/edge objects resolve to those DEFs
# directly (lore taxonomy and mechanical types unify, §25). Only lore-native
# types live below.
# ============================================================================

CODEX "L5R5e_Codex_Schema" {
    NAME "L5R5e Lore Graph — Shared Ontology"
    VERSION "0.5.9"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-09-02"
    FOR EDITION "l5r5e"

    # ---- Category taxonomy (the "IS a ___" types) ---------------------------
    CATEGORIES {
        #tc38b9617a5c76f77f29ce ^"Person"        DEF {}
        ^"Kami"          DEF { EXTENDS #tc38b9617a5c76f77f29ce ^"Person" }
        #t8e6fe2f1f177813f20397 ^"Deity"         DEF { EXTENDS #tc38b9617a5c76f77f29ce ^"Person" }
        ^"Fortune"       DEF { EXTENDS #t8e6fe2f1f177813f20397 ^"Deity" }
        ^"Spirit"        DEF {}
        ^"Race"          DEF {}
        ^"Realm"         DEF { EXTENDS #t8644417e07d42109e26d2 ^"Place" }
        #tca810b09cde0719d8cd4f ^"Faction"       DEF {}
        #t32a813f3ed825b75b441e ^"Organization"  DEF { EXTENDS #tca810b09cde0719d8cd4f ^"Faction" }
        ^"School"        DEF { EXTENDS #t32a813f3ed825b75b441e ^"Organization" }
        #t8644417e07d42109e26d2 ^"Place"         DEF {}
        #t449cadc911670e415ff73 ^"Region"        DEF { EXTENDS #t8644417e07d42109e26d2 ^"Place" }
        ^"Province"      DEF { EXTENDS #t449cadc911670e415ff73 ^"Region" }
        ^"City"          DEF { EXTENDS #t8644417e07d42109e26d2 ^"Place" }
        ^"Town"          DEF { EXTENDS #t8644417e07d42109e26d2 ^"Place" }
        ^"Village"       DEF { EXTENDS #t8644417e07d42109e26d2 ^"Place" }
        #t56377e7078e981f328396 ^"Castle"        DEF { EXTENDS #t8644417e07d42109e26d2 ^"Place" }
        ^"Palace"        DEF { EXTENDS #t56377e7078e981f328396 ^"Castle" }
        ^"Temple"        DEF { EXTENDS #t8644417e07d42109e26d2 ^"Place" }
        ^"Forest"        DEF { EXTENDS #t8644417e07d42109e26d2 ^"Place" }
        ^"River"         DEF { EXTENDS #t8644417e07d42109e26d2 ^"Place" }
        ^"Mountain"      DEF { EXTENDS #t8644417e07d42109e26d2 ^"Place" }
        ^"Sea"           DEF { EXTENDS #t8644417e07d42109e26d2 ^"Place" }
        ^"Lake"          DEF { EXTENDS #t8644417e07d42109e26d2 ^"Place" }
        ^"Beach"         DEF { EXTENDS #t8644417e07d42109e26d2 ^"Place" }
        ^"Inlet"         DEF { EXTENDS #t8644417e07d42109e26d2 ^"Place" }
        ^"Road"          DEF { EXTENDS #t8644417e07d42109e26d2 ^"Place" }
        ^"Bridge"        DEF { EXTENDS #t8644417e07d42109e26d2 ^"Place" }
        ^"Wall"          DEF { EXTENDS #t8644417e07d42109e26d2 ^"Place" }
        ^"Building"      DEF { EXTENDS #t8644417e07d42109e26d2 ^"Place" }
        ^"Landmark"      DEF { EXTENDS #t8644417e07d42109e26d2 ^"Place" }
        ^"Artifact"      DEF {}
        ^"Vessel"        DEF {}
        ^"Document"      DEF {}
        ^"Event"         DEF {}
        ^"Tradition"     DEF {}
        ^"Title"         DEF {}
        ^"Calendar Term" DEF {}
    }

    # ---- Relationship predicate vocabulary ----------------------------------
    # Every predicate a data codex uses MUST be declared here (undeclared = a
    # coherence error). INVERSE is tool-derivable; a consumer reads both
    # directions from one asserted fact.
    RELATIONS {
        ^"founder-of"    { INVERSE ^"founded-by"  DOMAIN ^"Person"       RANGE ^"Faction" }
        ^"leads"         { INVERSE ^"led-by"      DOMAIN ^"Person"       RANGE ^"Faction" }
        ^"child-of"      { INVERSE ^"parent-of"   DOMAIN ^"Person"       RANGE ^"Person"  }
        ^"sibling-of"    { SYMMETRIC               DOMAIN ^"Person"       RANGE ^"Person"  }
        ^"rival-of"      { SYMMETRIC               DOMAIN ^"Faction"      RANGE ^"Faction" }
        ^"ally-of"       { SYMMETRIC               DOMAIN ^"Faction"      RANGE ^"Faction" }
        ^"enemy-of"      { SYMMETRIC               DOMAIN ^"Faction"      RANGE ^"Faction" }
        ^"located-in"    { INVERSE ^"contains"    DOMAIN ^"Place"        RANGE ^"Place"    TRANSITIVE }
        ^"located-near"  { SYMMETRIC               DOMAIN ^"Place"        RANGE ^"Place"   }
        ^"modeled-after" {                          DOMAIN ^"Place"        RANGE ^"Place"   }
        ^"named-after"   { INVERSE ^"namesake-of" DOMAIN ^"Place"        RANGE ^"Person"  }
        ^"seat-of"       { INVERSE ^"seated-at"   DOMAIN ^"Place"        RANGE ^"Faction" }
        ^"held-by"       { INVERSE ^"holds"       DOMAIN ^"Place"        RANGE ^"Faction" }
        ^"operated-by"   { INVERSE ^"operates"    DOMAIN ^"Organization" RANGE ^"Faction" }
        ^"forged-by"     { INVERSE ^"forged"      DOMAIN ^"Artifact"     RANGE ^"Person"  }
        ^"wielded-by"    { INVERSE ^"wielded"     DOMAIN ^"Artifact"     RANGE ^"Person"  }
        ^"sealed-beneath"{                          DOMAIN ^"Artifact"     RANGE ^"Place"   }
        ^"occurred-at"   { INVERSE ^"site-of"     DOMAIN ^"Event"        RANGE ^"Place"   }
        ^"involved"      {                          DOMAIN ^"Event"        RANGE ^"Faction" }
        ^"haunted-by"    { INVERSE ^"haunts"      DOMAIN ^"Place"        RANGE ^"Person"  }
        ^"bound-to"      {                          DOMAIN ^"Spirit"       RANGE ^"Faction" }
        ^"observed-by"   { INVERSE ^"observes"    DOMAIN ^"Tradition"    RANGE ^"Faction" }
        ^"dedicated-to"  {                          DOMAIN ^"Place"        RANGE ^"Fortune" }
        ^"member-of"     { INVERSE ^"has-member"  DOMAIN ^"Person"       RANGE ^"Faction" }
        ^"serves"        { INVERSE ^"served-by"   DOMAIN ^"Person"       RANGE ^"Faction" }
        ^"holds-title"   { INVERSE ^"held-by-person" DOMAIN ^"Person"    RANGE ^"Title"   }
        ^"betrothed-to"  { SYMMETRIC               DOMAIN ^"Person"       RANGE ^"Person"  }
        ^"married-to"    { SYMMETRIC               DOMAIN ^"Person"       RANGE ^"Person"  }
        ^"companion-of"  { SYMMETRIC               DOMAIN ^"Person"       RANGE ^"Person"  }
        ^"travels-to"    {                          DOMAIN ^"Person"       RANGE ^"Place"   }
        ^"occurs-during" {                          DOMAIN ^"Event"        RANGE ^"Calendar Term" }
        ^"part-of"       { INVERSE ^"has-part"    DOMAIN ^"Place"        RANGE ^"Place"   }
        ^"corrupted-by"  {                          DOMAIN ^"Person"       RANGE ^"Realm"   }
        ^"authored"      { INVERSE ^"authored-by"  DOMAIN ^"Person"       RANGE ^"Document" }
        ^"originated"    { INVERSE ^"originated-by" DOMAIN ^"Person"      RANGE ^"Tradition" }
        ^"student-of"    { INVERSE ^"teacher-of"   DOMAIN ^"Person"       RANGE ^"Person"  }
        ^"oversees"      { INVERSE ^"overseen-by"  DOMAIN ^"Person"       RANGE ^"Place"   }
        ^"vassal-of"     { INVERSE ^"has-vassal"   DOMAIN ^"Faction"      RANGE ^"Faction" }
    }
}
