# L5R 5E — The Knotted Tails: Dramatis Personae (cast NPCs / adversaries)
# A supplemental storyline for "Mask of the Oni" (FFG), among the nezumi of the
# Knotted Tails tribe in the Shadowlands. NPC statblocks transcribed verbatim
# from the printed profiles: rings, conflict ranks, derived attributes, honor/
# glory/status, skill-group ranks, advantages/disadvantages, favored weapons &
# gear, and abilities (verbatim in nested ^"Name" DEF { ^"Effect" ... } blocks).
# This supplement uses the players' existing Shadowlands PCs, so there are no
# pregens; the structure is in l5r5e-0.5-knotted-tails.arc and the narrative in
# l5r5e-0.5-knotted-tails.lore.

EXTENSION "L5R5e_KnottedTails_Cast" {
    VERSION "0.5.2"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-09-03"
    DEPENDS_ON "L5R5e_Core_Core"

    # ═══════════════════════ THE TRIBE ════════════════════════════════════

    ^"Lucky Silver" DEF {
        EXTENDS #t4540de6f35155c46f41f0 ^"NPC"
        PROPERTIES {
            ^"Type" STRING "Adversary" FIXED
            ^"Combat Conflict Rank" INTEGER 4
            ^"Intrigue Conflict Rank" INTEGER 2
            ^"Rings" DEF { ^"Air" INTEGER 2 ^"Earth" INTEGER 3 ^"Fire" INTEGER 4 ^"Water" INTEGER 2 ^"Void" INTEGER 2 }
            ^"Demeanor" STRING "Dedicated"
            ^"Endurance" INTEGER 12
            ^"Composure" INTEGER 10
            ^"Focus" INTEGER 6
            ^"Vigilance" INTEGER 7
            ^"Honor" INTEGER 65
            ^"Glory" INTEGER 25
            ^"Status" INTEGER 5
            ^"Skills" LIST OF STRING ["Artisan 1", "Martial 3", "Scholar 0", "Social 2", "Trade 2"]
            ^"Advantages" LIST OF STRING ["Veteran's Fortitude — Martial; Mental, Physical"]
            ^"Disadvantages" LIST OF STRING ["Hot-Tempered — Social; Mental"]
            ^"Favored Weapons" LIST OF STRING ["Kaiu Wakizashi: Range 0–1, Damage 3, Deadliness 5/7, Ceremonial, Concealable, Durable, Razor-Edged"]
            ^"Gear" LIST OF STRING ["Gear (equipped): Altered Crab armor (Physical 3)"]
        }
        DESCRIPTION "ADVERSARY. Conflict Rank — Combat 4, Intrigue 2. Leader of the Knotted Tails."
        ^"Lucky" DEF { ^"Effect" STRING "Lucky Silver is a being of silhouette 1 who can never gain the Afflicted condition or the Shadowlands Taint disadvantage. Once per scene, when making a check, Lucky Silver may reroll any number of her dice." }

        RULES {
            #IwYF7jy5FA4DhraVUpOtkC: background "The silver-furred leader of the Knotted Tails is respected and even feared within her tribe, though she is related to many of them. She is older than most nezumi, but her skill with her blade makes up for any frailties of age. She isn't merely interested in samurai, but considers herself one and tries to live up to the title. Her tribe looks up to her and is unwaveringly loyal; in turn, she sees her role as leader as a sacred duty, so the tribe always comes first."
        }
    }

    ^"One Eye" DEF {
        EXTENDS #t4540de6f35155c46f41f0 ^"NPC"
        PROPERTIES {
            ^"Type" STRING "Adversary" FIXED
            ^"Combat Conflict Rank" INTEGER 2
            ^"Intrigue Conflict Rank" INTEGER 2
            ^"Rings" DEF { ^"Air" INTEGER 2 ^"Earth" INTEGER 2 ^"Fire" INTEGER 2 ^"Water" INTEGER 3 ^"Void" INTEGER 4 }
            ^"Demeanor" STRING "Detached"
            ^"Endurance" INTEGER 7
            ^"Composure" INTEGER 11
            ^"Focus" INTEGER 4
            ^"Vigilance" INTEGER 2
            ^"Honor" INTEGER 35
            ^"Glory" INTEGER 25
            ^"Status" INTEGER 0
            ^"Skills" LIST OF STRING ["Artisan 1", "Martial 0", "Scholar 4", "Social 1", "Trade 0"]
            ^"Advantages" LIST OF STRING ["Friendly Transcendents — Scholar; Mental"]
            ^"Disadvantages" LIST OF STRING ["Distant — Social; Mental"]
            ^"Favored Weapons" LIST OF STRING ["Claws and Teeth: Range 0, Damage 2, Deadliness 3"]
            ^"Gear" LIST OF STRING ["Gear (equipped): Bandages, worn blanket"]
        }
        DESCRIPTION "ADVERSARY. Conflict Rank — Combat 2, Intrigue 2. The Dreamer of the Knotted Tails."
        ^"Dreamreader" DEF { ^"Effect" STRING "One Eye is a being of silhouette 1 who can never gain the Afflicted condition or the Shadowlands Taint disadvantage. As a Scheme action, One Eye may enter a trance state. In a trance state, he counts as being Unconscious, but may perform the actions listed below: Free the Dreamer (Support): One Eye purifies one target at range 0–2, removing the Unconscious condition and any effects that cloud its mind. Whispers of the Mind (Scheme): One Eye scrys upon the mind of a sleeping or unconscious target at range 0–4." }

        RULES {
            #FrfojGqlBo3mtILEPvPAYR: background "The One Eye's fur is white, and so bright it picks up even the dim light of the mushrooms in his home and seems to glow. The only member of his tribe to wear no clothes or armor, he merely drapes a ragged blanket upon his shoulders, pulling it over his head like a hood and hiding his single eye from the sunlight when he leaves his burrow. His tribe grants him even greater respect than their leader or Rememberer, and some seem a little afraid of him. They whisper that he was actually there at the fall of Shiro Hiruma, he is so long lived. He spends much of his time dreamdwelling and communing with Transcendents or contemplating their cryptic warnings and advice. His self-imposed solitude and extended time in the Realm of Dreams has left him disconnected from the rest of his tribe. He is easily distracted and easily frustrated."
        }
    }

    ^"Three Tooth" DEF {
        EXTENDS #t4540de6f35155c46f41f0 ^"NPC"
        PROPERTIES {
            ^"Type" STRING "Adversary" FIXED
            ^"Combat Conflict Rank" INTEGER 2
            ^"Intrigue Conflict Rank" INTEGER 1
            ^"Rings" DEF { ^"Air" INTEGER 1 ^"Earth" INTEGER 2 ^"Fire" INTEGER 2 ^"Water" INTEGER 2 ^"Void" INTEGER 1 }
            ^"Demeanor" STRING "Curious"
            ^"Endurance" INTEGER 8
            ^"Composure" INTEGER 7
            ^"Focus" INTEGER 5
            ^"Vigilance" INTEGER 8
            ^"Honor" INTEGER 30
            ^"Glory" INTEGER 20
            ^"Status" INTEGER 0
            ^"Skills" LIST OF STRING ["Artisan 0", "Martial 1", "Scholar 1", "Social 1", "Trade 2"]
            ^"Advantages" LIST OF STRING ["Fleet of Foot — Martial; Physical"]
            ^"Disadvantages" LIST OF STRING ["Opportunist — Martial; Mental"]
            ^"Favored Weapons" LIST OF STRING ["Nezumi blade: Range 0–1, Damage 3, Deadliness 3"]
            ^"Gear" LIST OF STRING ["Gear (equipped): Makeshift armor (Physical 2)"]
        }
        DESCRIPTION "ADVERSARY. Conflict Rank — Combat 2, Intrigue 1. Knotted Tails infiltrator."
        ^"Escape Artist" DEF { ^"Effect" STRING "Three Tooth is a being of silhouette 1 who can never gain the Afflicted condition or the Shadowlands Taint disadvantage. When cornered or about to be captured, the infiltrator can perform a TN 2 Survival (Fire) check to find an escape route for himself and any companions." }

        RULES {
            #uFcGqoReY9lSGK3NY3bxTU: background "While adaptable like the Knotted Tails warriors, Three Tooth is a lean, brown-furred nezumi who specializes in helping scouts on their missions and boasts that he is one of the few in his tribe to have actually entered Shiro Hiruma before, though he is known to overexaggerate. Braver than most of his tribe, he nevertheless has a keen survival instinct and will flee if he feels the odds are against him. Using his size and speed to his advantage, Three Tooth is able to hide, sneak, and run really fast."
        }
    }

    ^"Knotted Tails Warrior" DEF {
        EXTENDS #t4540de6f35155c46f41f0 ^"NPC"
        PROPERTIES {
            ^"Type" STRING "Minion" FIXED
            ^"Combat Conflict Rank" INTEGER 3
            ^"Intrigue Conflict Rank" INTEGER 1
            ^"Rings" DEF { ^"Air" INTEGER 2 ^"Earth" INTEGER 3 ^"Fire" INTEGER 2 ^"Water" INTEGER 3 ^"Void" INTEGER 2 }
            ^"Demeanor" STRING "Shrewd"
            ^"Endurance" INTEGER 9
            ^"Composure" INTEGER 7
            ^"Focus" INTEGER 5
            ^"Vigilance" INTEGER 4
            ^"Honor" INTEGER 30
            ^"Glory" INTEGER 15
            ^"Status" INTEGER 0
            ^"Skills" LIST OF STRING ["Artisan 0", "Martial 3", "Scholar 0", "Social 2", "Trade 1"]
            ^"Advantages" LIST OF STRING ["Strength in Numbers — Martial; Physical, Mental"]
            ^"Disadvantages" LIST OF STRING ["Deferential — Social; Mental"]
            ^"Favored Weapons" LIST OF STRING ["Makeshift Spear: Range 2, Damage 3, Deadliness 3, Mundane"]
            ^"Gear" LIST OF STRING ["Gear (equipped): Scrounged Armor (Physical 2), nutritional glowing fungus"]
        }
        DESCRIPTION "MINION. Conflict Rank — Combat 3, Intrigue 1. (The scout Nine Claws uses this profile.)"
        ^"For the Tribe" DEF { ^"Effect" STRING "A Knotted Tails warrior is a being of silhouette 1 who can never gain the Afflicted condition or the Shadowlands Taint disadvantage. As long as one or more of its living comrades or its village are visible, a Knotted Tails warrior treats its Endurance as 12." }

        RULES {
            #zQDZSWQTOhWi1t7qjYuKPw: background "A rag-tag bunch wielding whatever weapon or tool they can find, these warriors nonetheless take pride in their role, and might surprise the PCs by showing great courage when their tribe is threatened or if fighting becomes inevitable. After all, survivors in the Shadowlands face many terrifying threats. Nezumi society is so different to that of samurai, that they are unlikely to gain most samurai's respect. Regardless of this, PCs should be left with the impression that these are warriors with their own sense of honor and duty.\n\nSome nezumi tribes have dedicated warriors among them, trained to fight and die for the tribe from birth, but this is not the case in the Knotted Tails. Being relatively small, most of the tribe takes on different roles as necessary, and no roles are considered demeaning. The Knotted Tail warriors that make up the patrol are also scavengers, lookouts, healers, and pup-sitters. They therefore vary considerably and show no evidence of any military training and discipline that a Lion or Crab would recognize."
        }
    }

    ^"Nezumi Pup (Knotted Tails)" DEF {
        EXTENDS #t4540de6f35155c46f41f0 ^"NPC"
        PROPERTIES {
            ^"Type" STRING "Minion" FIXED
            ^"Combat Conflict Rank" INTEGER 1
            ^"Intrigue Conflict Rank" INTEGER 1
            ^"Rings" DEF { ^"Air" INTEGER 1 ^"Earth" INTEGER 1 ^"Fire" INTEGER 2 ^"Water" INTEGER 1 ^"Void" INTEGER 1 }
            ^"Demeanor" STRING "Curious"
            ^"Endurance" INTEGER 4
            ^"Composure" INTEGER 4
            ^"Focus" INTEGER 3
            ^"Vigilance" INTEGER 1
            ^"Honor" INTEGER 0
            ^"Glory" INTEGER 5
            ^"Status" INTEGER 0
            ^"Skills" LIST OF STRING ["Artisan 0", "Martial 1", "Scholar 0", "Social 1", "Trade 1"]
            ^"Advantages" LIST OF STRING ["Unnoticed — Martial; Physical"]
            ^"Disadvantages" LIST OF STRING ["Defenseless — Martial; Physical"]
            ^"Favored Weapons" LIST OF STRING ["Teeth and Claws: Range 0, Damage 1, Deadliness 2"]
            ^"Gear" LIST OF STRING []
        }
        DESCRIPTION "MINION. Conflict Rank — Combat 1, Intrigue 1."

        RULES {
            #j8SbNWeQpKcslpCAusKgb5: background "Nezumi pups begin life helpless, blind, and hairless. They develop quickly, emerging after two weeks to join older pups in training, foraging, and listening to stories. They are inquisitive and playful but know from scent markers where they can safely explore. Pups only wander away in extreme circumstances. Fear usually drives a pup back to a parent or other adult, but if its home suffers a disaster or is attacked, a pup obeys the instinct to flee. Unless found by its own or a friendly tribe, such pups either perish or become outcast nezumi."
        }
    }

    # ═══════════════════════ THE OUTCASTS & THE THREAT ════════════════════

    ^"Outcast Nezumi (Knotted Tails)" DEF {
        EXTENDS #t4540de6f35155c46f41f0 ^"NPC"
        PROPERTIES {
            ^"Type" STRING "Minion" FIXED
            ^"Combat Conflict Rank" INTEGER 2
            ^"Intrigue Conflict Rank" INTEGER 1
            ^"Rings" DEF { ^"Air" INTEGER 1 ^"Earth" INTEGER 2 ^"Fire" INTEGER 3 ^"Water" INTEGER 2 ^"Void" INTEGER 1 }
            ^"Demeanor" STRING "Feral"
            ^"Endurance" INTEGER 8
            ^"Composure" INTEGER 6
            ^"Focus" INTEGER 4
            ^"Vigilance" INTEGER 2
            ^"Honor" INTEGER 0
            ^"Glory" INTEGER 3
            ^"Status" INTEGER 0
            ^"Skills" LIST OF STRING ["Artisan 0", "Martial 2", "Scholar 0", "Social 1", "Trade 2"]
            ^"Advantages" LIST OF STRING ["Instinctive Behavior — Martial; Physical"]
            ^"Disadvantages" LIST OF STRING ["Always Hungry — Martial; Mental"]
            ^"Favored Weapons" LIST OF STRING ["Claws and Teeth: Range 0, Damage 2, Deadliness 3"]
            ^"Gear" LIST OF STRING ["Gear (equipped): Fur (Physical 1), several haunches of raw meat"]
        }
        DESCRIPTION "MINION. Conflict Rank — Combat 2, Intrigue 1."
        ^"Ferocious Defender" DEF { ^"Effect" STRING "An outcast nezumi is a being of silhouette 1 who can never gain the Afflicted condition or the Shadowlands Taint disadvantage. When it is the target of an Attack action check, it may receive 1 strife to negate 1 (op) from the attacker's check result." }

        RULES {
            #fkX2rrO5gZcxjYdCM95ykg: background "These nezumi survive by instinct, running on four paws and eating anything they find, including rotting carcasses. Their solitary life in the Shadowlands leaves them unable to communicate even with other nezumi. They recognize scent signals to keep away, so they rarely bother the tribes, but consider any Rokugani either as an enemy or potential food. Without the advantages of civilized nezumi, they are usually a threat only to a lone scout or group of wounded samurai. Occasionally, they band together to hunt, but once the prey runs out they inevitably turn on each other."
        }
    }

    ^"Frayed Whisker" DEF {
        EXTENDS #t4540de6f35155c46f41f0 ^"NPC"
        PROPERTIES {
            ^"Type" STRING "Adversary" FIXED
            ^"Combat Conflict Rank" INTEGER 3
            ^"Intrigue Conflict Rank" INTEGER 2
            ^"Rings" DEF { ^"Air" INTEGER 1 ^"Earth" INTEGER 2 ^"Fire" INTEGER 4 ^"Water" INTEGER 2 ^"Void" INTEGER 3 }
            ^"Demeanor" STRING "Fanatical"
            ^"Endurance" INTEGER 12
            ^"Composure" INTEGER 10
            ^"Focus" INTEGER 6
            ^"Vigilance" INTEGER 6
            ^"Honor" INTEGER 0
            ^"Glory" INTEGER 5
            ^"Status" INTEGER 0
            ^"Skills" LIST OF STRING ["Artisan 0", "Martial 3", "Scholar 1", "Social 2", "Trade 0"]
            ^"Advantages" LIST OF STRING ["Sneaky — Martial, Trade; Physical"]
            ^"Disadvantages" LIST OF STRING ["Arrogance — Social; Mental"]
            ^"Favored Weapons" LIST OF STRING ["Makeshift Blade: Range 0–1, Damage 4, Deadliness 3"]
            ^"Gear" LIST OF STRING ["Gear (equipped): Ragged Armored Robes (Physical 2)"]
        }
        DESCRIPTION "ADVERSARY. Conflict Rank — Combat 3, Intrigue 2. The exiled dreamwalker hunting the tribe."
        ^"Dreamwalker" DEF { ^"Effect" STRING "Frayed Whisker is a being of silhouette 1 who can never gain the Afflicted condition or the Shadowlands Taint disadvantage. Frayed Whisker can perform the actions listed below: Ensnare the Dreamer (Scheme): Frayed Whisker binds one Unconscious target at range 0–2. The target can act as if they were not Unconscious, but do so according to Frayed Whisker's will. This effect persists until the target ceases to be Unconscious. Rattle the Mind (Scheme): Frayed Whisker curses up to 2 nezumi at range 0–1. The affected nezumi immediately perform an Attack action targeting a target of Frayed Whisker's choosing (then regains control of itself)." }
    }
}
