                ^"Water" INTEGER 2
                ^"Void" INTEGER 1
            }
            ^"Demeanor" STRING "Gruff"
            ^"Social Skill Check TN Modifiers" STRING "Air +2, Earth -2"
            ^"Endurance" INTEGER 17
            ^"Composure" INTEGER 7
            ^"Focus" INTEGER 4
            ^"Vigilance" INTEGER 2
            ^"Silhouette" INTEGER 4
            ^"Honor" INTEGER 0
            ^"Glory" INTEGER 5
