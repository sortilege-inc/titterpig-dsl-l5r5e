            ^"Endurance" INTEGER 16
            ^"Composure" INTEGER 14
            ^"Focus" INTEGER 5
            ^"Vigilance" INTEGER 2
            ^"Honor" INTEGER 79
            ^"Glory" INTEGER 66
            ^"Status" INTEGER 40
            ^"Skills" LIST OF STRING ["Artisan 0", "Martial 4", "Scholar 4", "Social 1", "Trade 0"]
            ^"Advantages" LIST OF STRING ["Sixth Sense (Void) [Scholar; Spiritual]"]
            ^"Disadvantages" LIST OF STRING ["Slowing Down (Earth) [Martial; Physical]"]
            ^"Favored Weapons" LIST OF STRING ["Naginata: Range 2, Damage 6, Deadliness 6, Cumbersome, Razor-Edged, Wargear"]
            ^"Gear" LIST OF STRING ["Sanctified robes (Physical 1, Supernatural 3)", "Wakizashi", "Makeup kit", "Satchel filled with scrolls and supplies for rituals", "Traveling pack"]
        }

        ^"Fury of the Witch Hunter" DEF {
            ^"Description" STRING "The first time a character in the scene performs a mahō technique or other blasphemous act, Kuni Hatsu suffers the Enraged condition and gains 1 Void point."
        }

        RULES {
            #L5RSH33uV3wX5yZ7aB9cD1eF: kuni_hatsu "Hatsu has served as a Witch Hunter for many long years and has long since lost track of the Tainted individuals and mahō practitioners he uncovered in his travels across Rokugan. Almost as countless are the apprentices he took in for training; that many are still active speaks highly of his teaching techniques as well. His years are finally catching up with him, though, and he now spends most of his time near the Wall watching those who return from the Shadowlands for any signs of Taint or other corruption. He is also adept at scrutinizing those from other clans who wish to travel across the Wall, for he knows the lure of the corrupted lands is irresistible to those who are befouled. When Hatsu detects such horrid evidence, it is as if decades peel away from his body, and his strength is as it was for his gempuku. His fury is unstoppable if his targets refuse his commands to submit to imprisonment (or worse). His wizened body always pays a heavy toll after each battle, but that is a small price to pay in this war."
        }
    }

    # source stat block (page 65)
    ^"Yasuki Narumi, Observant Merchant" DEF {
        EXTENDS #t4540de6f35155c46f41f0 ^"NPC"

        PROPERTIES {
            ^"Type" STRING "Adversary" FIXED
            ^"Combat Conflict Rank" INTEGER 1
            ^"Intrigue Conflict Rank" INTEGER 3
            ^"Rings" DEF {
                ^"Air" INTEGER 2
                ^"Earth" INTEGER 3
                ^"Fire" INTEGER 1
                ^"Water" INTEGER 3
                ^"Void" INTEGER 2
            }
            ^"Demeanor" STRING "Ambitious"
            ^"Social Skill Check TN Modifiers" STRING "Fire +2, Earth -2"
            ^"Endurance" INTEGER 8
            ^"Composure" INTEGER 12
            ^"Focus" INTEGER 3
            ^"Vigilance" INTEGER 3
            ^"Honor" INTEGER 20
            ^"Glory" INTEGER 22
            ^"Status" INTEGER 28
            ^"Skills" LIST OF STRING ["Artisan 0", "Martial 0", "Scholar 2", "Social 3", "Trade 3"]
            ^"Advantages" LIST OF STRING ["Famously Honest (Air) [Social; Interpersonal]"]
            ^"Disadvantages" LIST OF STRING ["Dark Secret (Void) [Social; Interpersonal]"]
            ^"Favored Weapons" LIST OF STRING ["Wakizashi: Range 0-1, Damage 3, Deadliness 5/7, Ceremonial, Razor-Edged"]
            ^"Gear" LIST OF STRING ["Traveling clothes (Physical 2, Durable, Mundane, Subtle)", "Pouches of coins", "Assorted scrolls and papers", "Basic calligraphy set"]
        }

        ^"Bargains with a Price" DEF {
            ^"Description" STRING "When a character purchases or otherwise acquires an item at Narumi's stalls, reduce the rarity of the item by half (rounding up), to a minimum of 1. A character must forfeit glory equal to the rarity reduction to benefit from this service."
        }

        RULES {
            #L5RSH34gH4iJ6kL8mN0oP2qR: yasuki_narumi "Narumi runs a small series of stalls in Friendly Traveler Village. She has a good reputation in the region for the quality of wares and the expansive breadth of her offerings. Most days see her energetically negotiating prices on goods, something she appears to genuinely enjoy. Her colorful garb and cheerful voice herald her arrival seemingly from out of nowhere, and some wonder how she gets any actual sales done between long conversations with customers. While many of her competitors dabble in smuggling and petty crime, Narumi relies instead on excellent service and solid connections with traders from across the Emerald Empire and beyond. Many gaijin hired to fight along the Wall go out of their way to visit when possible, eager for a taste of their homeland and gossip. Narumi records all she hears from everyone each night, and once a week leaves a pouch filled with her observations in a special hiding place after her children are asleep. She has no idea who picks it up, but the koku that replaces it certainly helps her business."
        }
    }

    # source stat block (page 73)
    ^"Hida Etsuji, Watchtower Commander" DEF {
        EXTENDS #t4540de6f35155c46f41f0 ^"NPC"

        PROPERTIES {
            ^"Type" STRING "Adversary" FIXED
            ^"Combat Conflict Rank" INTEGER 8
            ^"Intrigue Conflict Rank" INTEGER 4
            ^"Rings" DEF {
                ^"Air" INTEGER 2
                ^"Earth" INTEGER 5
                ^"Fire" INTEGER 4
                ^"Water" INTEGER 4
                ^"Void" INTEGER 3
            }
            ^"Demeanor" STRING "Ambitious"
            ^"Social Skill Check TN Modifiers" STRING "Fire +2, Earth -2"
            ^"Endurance" INTEGER 18
            ^"Composure" INTEGER 18
            ^"Focus" INTEGER 6
            ^"Vigilance" INTEGER 3
            ^"Honor" INTEGER 66
            ^"Glory" INTEGER 88
            ^"Status" INTEGER 58
            ^"Skills" LIST OF STRING ["Artisan 0", "Martial 5", "Scholar 3", "Social 3", "Trade 3"]
            ^"Advantages" LIST OF STRING ["Famously Lucky (Void) [Social; Interpersonal]"]
            ^"Disadvantages" LIST OF STRING ["Delusions of Grandeur (Void) [Mental; Interpersonal]"]
            ^"Favored Weapons" LIST OF STRING ["Family Ōtsuchi: Range 1, Damage 8, Deadliness 4, Ceremonial, Cumbersome, Wargear"]
            ^"Gear" LIST OF STRING ["Lacquered armor (Physical 4, Ceremonial, Cumbersome, Wargear)", "Wakizashi", "Tessen"]
        }

        ^"Visible Victories" DEF {
            ^"Description" STRING "As a Hida, Etsuji ignores the Cumbersome quality of his armor and weapons. When Etsuji is part of a group that defeats Otherworldly or Tainted beings, if the group's members would gain glory from the action, they gain that amount plus 3."
        }

        RULES {
            #L5RSH35sT5uV7wX9yZ1aB3cD: hida_etsuji "Etsuji has served on the Wall for six years, and for two of them he has been commander of the Watchtower of the Iron Hammer (also known as the Second of the First Watchtower). Etsuji feels he has served long enough as commander there and is eager to continue his rise in rank. One spectacular military victory should make that happen, so he is actively watching for any opportunity to arrive. Failing that, he may be tempted to arrange for an opportunity to occur, just so that the right people see him in glorious battle."
        }
    }

    # source stat block (page 74)
    ^"Hida Nanako, Garrison Taisa" DEF {
        EXTENDS #t4540de6f35155c46f41f0 ^"NPC"

        PROPERTIES {
            ^"Type" STRING "Adversary" FIXED
            ^"Combat Conflict Rank" INTEGER 3
            ^"Intrigue Conflict Rank" INTEGER 3
            ^"Rings" DEF {
                ^"Air" INTEGER 2
                ^"Earth" INTEGER 3
                ^"Fire" INTEGER 4
                ^"Water" INTEGER 2
                ^"Void" INTEGER 2
            }
            ^"Demeanor" STRING "Uncertain"
            ^"Social Skill Check TN Modifiers" STRING "Air +2, Fire -2"
            ^"Endurance" INTEGER 14
            ^"Composure" INTEGER 10
            ^"Focus" INTEGER 6
            ^"Vigilance" INTEGER 2
            ^"Honor" INTEGER 70
            ^"Glory" INTEGER 53
            ^"Status" INTEGER 38
            ^"Skills" LIST OF STRING ["Artisan 3", "Martial 3", "Scholar 2", "Social 3", "Trade 1"]
            ^"Advantages" LIST OF STRING ["Quick Reflexes (Fire) [Martial; Physical]"]
            ^"Disadvantages" LIST OF STRING ["Inexperienced Leader (Earth) [Martial; Interpersonal]"]
            ^"Favored Weapons" LIST OF STRING ["Jade-Studded Tetsubō: Range 1-2, Damage 7, Deadliness 3, Cumbersome, Durable, Sacred, Wargear"]
            ^"Gear" LIST OF STRING ["Plated armor (Physical 5, Cumbersome, Durable, Wargear)", "Wakizashi"]
        }

        ^"Learning Quickly" DEF {
            ^"Description" STRING "As a Hida, Nanako ignores the Cumbersome quality of her armor and weapons. After Nanako fails a Tactics check, she gains 1 Void point and decreases the TN of her next Attack action check by 1."
        }

        RULES {
            #L5RSH36eF6gH8iJ0kL2mN4oP: hida_nanako "Like many taisa, Nanako gained her position as commander through family status, rather than battlefield proficiency, and she is painfully aware of that fact. She oversees the prestigious First Garrison of the Watchtower of the Emerald Dawn (more formally known as the Third of the Fourth Watchtower) which is stationed along the midpoint of the Wall. While she is a powerful fighter and as strong as any Crab, she lacks experience in leading troops. She has made many mistakes since taking command, but few have been serious, and with each one she learns, so they aren't repeated. Nanako knows her mother, who is still renowned as one of the finest tower commanders in history, arranged for her appointment, and she hopes that her mother won't one day feel her actions were in error."
        }
    }

    # source stat block (page 74)
