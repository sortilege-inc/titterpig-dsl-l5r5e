            ^"Social Skill Check TN Modifiers" STRING "Fire +2, Void -2"
            ^"Endurance" INTEGER 12
            ^"Composure" INTEGER 12
            ^"Focus" INTEGER 6
            ^"Vigilance" INTEGER 3
            ^"Honor" INTEGER 60
            ^"Glory" INTEGER 55
            ^"Status" INTEGER 45
