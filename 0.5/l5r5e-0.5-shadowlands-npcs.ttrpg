            ^"Gear" LIST OF STRING ["Demonic hide (Physical 2, Spiritual 2, Unholy)"]
        }

        ^"Trickery of Jigoku" DEF {
            ^"Description" STRING "A vile trickster oni is a Tainted, Otherworldly being of silhouette 2. It may purchase up to two of the Shadowlands powers beginning on page 137."
        }

        RULES {
            #L5RSHoniGen01vileTricksterXx: vile_trickster_oni "Though small and weak by the standards of the oni, these foul shards are no less dangerous for their lack of physical prowess. This profile represents oni that focus on misdirection, deceit, and subtle corruption instead of raw power."
        }
    }

