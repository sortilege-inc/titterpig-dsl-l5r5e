            ^"Endurance" INTEGER 8
            ^"Composure" INTEGER 8
            ^"Focus" INTEGER 4
            ^"Vigilance" INTEGER 3
            ^"Silhouette" INTEGER 1
            ^"Skills" LIST OF STRING ["Artisan 1", "Martial 1", "Scholar 2", "Social 1", "Trade 2"]
            ^"Advantages" LIST OF STRING ["Whispers of Fu Leng (Void) [Scholar; Mental]"]
            ^"Disadvantages" LIST OF STRING ["Cowardice (Earth) [Martial; Social]"]
            ^"Favored Weapons" LIST OF STRING ["Ritual Dagger: Range 0, Damage 2, Deadliness 4, Concealable, Razor-Edged, Unholy"]
            ^"Gear" LIST OF STRING ["Defiled priestly robes (Physical 1, Supernatural 2, Unholy)"]
        }

        ^"Favored of Fu Leng" DEF {
            ^"Description" STRING "A goblin accursed priest is a Tainted being of silhouette 1 who reduces the TN of Command checks they make targeting goblins by 1. Once per scene, they may call on Fu Leng's favor to change any die result containing (st) to a result containing (ex). The GM can choose 1–3 mahō (see page 224 of the core rulebook or page 118 of this book) that the goblin accursed priest can perform. Add 1 to this character's combat rank for each mahō chosen this way."
        }

        RULES {
            #L5RSH17kL7mN9oP1qR3sT5uV: goblin_accursed_priest "Goblins, or bakemono, usually only have power in numbers. Those singular goblins who achieve great power for themselves often do so by calling on the favor of Fu Leng, especially in order to become priests of their foul Kami. As accursed priests, they command cowering minions, but they know that one day they may be betrayed and sacrificed, just as they did to rise to their position."
        }
    }

    # source stat block (page 31)
    ^"The Obsidian Flower" DEF {
        EXTENDS #t4540de6f35155c46f41f0 ^"NPC"

        PROPERTIES {
            ^"Type" STRING "Adversary" FIXED
            ^"Combat Conflict Rank" INTEGER 10
            ^"Intrigue Conflict Rank" INTEGER 14
            ^"Rings" DEF {
                ^"Air" INTEGER 6
