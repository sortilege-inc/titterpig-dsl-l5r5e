        ^"Ferocious Defender" DEF {
            ^"Description" STRING "An outcast nezumi is a being of silhouette 1 who can never gain the Afflicted condition or the Shadowlands Taint disadvantage. When it is the target of an Attack action check, it may receive 1 strife to remove (op) from the attacker's check result."
        }

        RULES {
            #L5RSH29yZ9aB1cD3eF5gH7iJ: outcast_nezumi "These nezumi survive by instinct, running on four paws and eating anything they find, including rotting carcasses. Their solitary life in the Shadowlands leaves them unable to communicate even with other nezumi. They recognize scent signals to keep away, so they rarely bother the tribes, but consider any Rokugani either as an enemy or potential food. Without the advantages of civilized nezumi, they are usually a threat only to a lone scout or group of wounded samurai. Occasionally, they band together to hunt, but once the prey runs out they inevitably turn on each other."
        }
    }

    # -----------------------------------------------
    # Chapter 2: People of the Wall
    # -----------------------------------------------

    # --- Crab Clan NPCs ---

    # source stat block (page 53)
    ^"Hida Kotoe, Stout Warrior" DEF {
        EXTENDS #t4540de6f35155c46f41f0 ^"NPC"

        PROPERTIES {
            ^"Type" STRING "Adversary" FIXED
            ^"Combat Conflict Rank" INTEGER 3
            ^"Intrigue Conflict Rank" INTEGER 2
            ^"Rings" DEF {
                ^"Air" INTEGER 2
                ^"Earth" INTEGER 4
                ^"Fire" INTEGER 2
                ^"Water" INTEGER 4
                ^"Void" INTEGER 1
            }
            ^"Demeanor" STRING "Gruff"
            ^"Social Skill Check TN Modifiers" STRING "Air +2, Fire -2"
            ^"Endurance" INTEGER 12
            ^"Composure" INTEGER 16
            ^"Focus" INTEGER 4
            ^"Vigilance" INTEGER 3
            ^"Honor" INTEGER 55
            ^"Glory" INTEGER 50
            ^"Status" INTEGER 39
            ^"Skills" LIST OF STRING ["Artisan 0", "Martial 4", "Scholar 2", "Social 1", "Trade 1"]
            ^"Advantages" LIST OF STRING ["Large Stature (Earth) [Martial; Physical]"]
            ^"Disadvantages" LIST OF STRING ["Slow Moving (Earth) [Martial; Physical]"]
            ^"Favored Weapons" LIST OF STRING ["Tetsubō: Range 1-2, Damage 7, Deadliness 3, Cumbersome, Durable, Wargear"]
            ^"Gear" LIST OF STRING ["Ō-yoroi armor (Physical 6 [3 if suffering the Disoriented, Dazed, or Immobilized condition], Ceremonial, Cumbersome, Wargear)", "Wakizashi"]
        }

        ^"Defender of the Wall" DEF {
            ^"Description" STRING "As a Hida, Kotoe ignores the Cumbersome quality of any armor she wears or weapons she uses. When she makes an Attack action check, she may spend (op) in the following way: Earth (op)(op)+: Kotoe pushes the target of the attack 1 range band per (op)(op) spent this way in a direction of her choice. If it collides with an object, it suffers damage as if it had fallen the distance it moved."
        }

        RULES {
            #L5RSH30kL0mN2oP4qR6sT8uV: hida_kotoe "Kotoe has served at the Wall for many years. Long ago, her fellow Hida nicknamed her \"Thirteenth Tower\" both for her steadfast nature and her height. When outfitted in heavy ō-yoroi armor and her huge family tetsubō, she is indeed a towering figure, and many Hiruma returning from scouting missions claim they can spot her on the parapets from many miles away. She can often be found where the fighting is the thickest, especially wherever the Wall has suffered a breach. Legend has it she singlehandedly held off waves of goblins who had burrowed under the Wall until their blood made the tunnel too slippery for them to climb out—at which point she grimly waded in and killed the rest. Kotoe comes from a long line of warriors, all of whom only fell after killing so many creatures that paths had to be made through the piles of corpses to reach their bodies. She wishes nothing more than to end her days in the same manner; given her strength and prowess in battle, though, that day may be a long time coming."
        }
    }

    # source stat block (page 55)
    ^"Hiruma Izumi, Cautious Scout" DEF {
        EXTENDS #t4540de6f35155c46f41f0 ^"NPC"

        PROPERTIES {
