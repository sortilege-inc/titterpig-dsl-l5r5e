    # source stat block (page 84)
    ^"Toritaka Hatsue, the Yotogi" DEF {
        EXTENDS #t4540de6f35155c46f41f0 ^"NPC"

        PROPERTIES {
            ^"Type" STRING "Adversary" FIXED
            ^"Combat Conflict Rank" INTEGER 7
            ^"Intrigue Conflict Rank" INTEGER 7
            ^"Rings" DEF {
                ^"Air" INTEGER 4
                ^"Earth" INTEGER 4
                ^"Fire" INTEGER 3
                ^"Water" INTEGER 4
                ^"Void" INTEGER 4
            }
            ^"Demeanor" STRING "Detached"
            ^"Social Skill Check TN Modifiers" STRING "Earth +1, Fire +1, Void -1"
            ^"Endurance" INTEGER 14
            ^"Composure" INTEGER 16
            ^"Focus" INTEGER 7
            ^"Vigilance" INTEGER 4
            ^"Honor" INTEGER 60
            ^"Glory" INTEGER 70
            ^"Status" INTEGER 58
            ^"Skills" LIST OF STRING ["Artisan 2", "Martial 3", "Scholar 4", "Social 3", "Trade 1"]
            ^"Advantages" LIST OF STRING ["Sense for the Spirits (Void) [Martial; Spiritual]"]
            ^"Disadvantages" LIST OF STRING ["Close to the Edge (Void) [Social; Spiritual]"]
            ^"Favored Weapons" LIST OF STRING ["Katana: Range 1, Damage 4, Deadliness 5/7, Ceremonial, Razor-Edged"]
            ^"Gear" LIST OF STRING ["Sanctified robes (Physical 1, Supernatural 3, Ceremonial)", "Scrolls", "Supplies for rituals", "Wakizashi"]
        }

        ^"Penetrating Sight" DEF {
            ^"Description" STRING "As a descendant of the first Falcon daimyō, Hatsue can discern Otherworldly beings such as gaki and always recognize any such beings that attempt to disguise themselves as human or otherwise mundane. This does not, however, mean she always feels it is in the best interest of the Falcon or the being involved to reveal this to those around her."
        }

        RULES {
            #L5RSH39oP9qR1sT3uV5wX7yZ: toritaka_hatsue "The lineage of Yotogi remains strong for the clan, and his successors have made his name synonymous with clan daimyō. Like their founder, each Yotogi has a preternatural awareness of spirits. The current Yotogi, Toritaka Hatsue, has ruled the Falcon for a dozen years. She has successfully dealt with many hauntings in the Shinomen as well as performing a dangerous banishment in a nearby Lion castle. Lately, though, she is spending more and more time in meditation, and many worry that one day she will see something too powerful and terrible for her mind to bear."
        }
    }

    # source stat block (page 85)
    ^"Mazoku" DEF {
        EXTENDS #t4540de6f35155c46f41f0 ^"NPC"

        PROPERTIES {
            ^"Type" STRING "Adversary" FIXED
            ^"Combat Conflict Rank" INTEGER 7
            ^"Intrigue Conflict Rank" INTEGER 9
            ^"Rings" DEF {
                ^"Air" INTEGER 5
                ^"Earth" INTEGER 4
                ^"Fire" INTEGER 3
                ^"Water" INTEGER 4
                ^"Void" INTEGER 5
            }
            ^"Demeanor" STRING "Assertive"
            ^"Social Skill Check TN Modifiers" STRING "Earth +2, Air -2"
            ^"Endurance" INTEGER 14
            ^"Composure" INTEGER 16
            ^"Focus" INTEGER 9
            ^"Vigilance" INTEGER 5
            ^"Honor" INTEGER 60
            ^"Glory" INTEGER 7
            ^"Status" INTEGER 65
            ^"Skills" LIST OF STRING ["Artisan 3", "Martial 4", "Scholar 5", "Social 4", "Trade 0"]
            ^"Advantages" LIST OF STRING ["Gaki-do Knowledge (Earth) [Social; Interpersonal]"]
            ^"Disadvantages" LIST OF STRING ["Desperate for Aid (Fire) [Social; Interpersonal]"]
            ^"Favored Weapons" LIST OF STRING ["Unearthly Limbs: Range 0-2, Damage 7, Deadliness 4, Sacred, Snaring"]
            ^"Gear" LIST OF STRING ["Ghostly form (Physical 10, Supernatural 10)", "Numerous scrolls pertaining to Gaki-do law and individual gaki"]
        }

        ^"Magistrate of Gaki-do" DEF {
            ^"Description" STRING "A mazoku is an Otherworldly being, though it appears as a normal samurai. It doubles its vigilance when detecting Otherworldly or Tainted beings, mahō use, or kansen activity. When a mazoku unmasks, everyone who can see it suffers 6 strife as its form shifts into inhuman shapes before settling as it composes itself."
        }

        RULES {
            #L5RSH40aB0cD2eF4gH6iJ8kL: mazoku "Just as there are hierarchies and bureaucracies in the Mortal Realm of Ningen-dō, so there are ones in the Spirit Realms. The realm of Gaki-dō, where gaki and other hungry spirits are sent from Meido after being found wanting, is filled with administers and other officials who oversee the realm on the behalf of Emma-o, the Fortune of Death. Mazoku serve a vital role as magistrates and guards within Gaki-dō, but the sheer number of spirits there utterly overwhelms any attempt to properly keep them contained. Many gaki escape Gakidō to haunt Rokugan, especially in areas where the two realms draw near, such as where violent battles, terrible murders, and other blood-soaked horrors occurred. Hunting down and returning these troublesome spirits to Gaki-dō is nearly impossible for the mazoku, which is why they sometimes work with Phantom Hunters to jointly accomplish their common mission."
        }
    }

