            ^"Rings" DEF {
                ^"Air" INTEGER 3
                ^"Earth" INTEGER 1
                ^"Fire" INTEGER 2
                ^"Water" INTEGER 2
                ^"Void" INTEGER 1
            }
            ^"Demeanor" STRING "Shrewd"
            ^"Social Skill Check TN Modifiers" STRING "Air +2, Fire -2"
            ^"Endurance" INTEGER 16
            ^"Composure" INTEGER 10
            ^"Focus" INTEGER 9
            ^"Vigilance" INTEGER 3
            ^"Honor" INTEGER 0
            ^"Glory" INTEGER 5
            ^"Status" INTEGER 0
            ^"Skills" LIST OF STRING ["Artisan 2", "Martial 2", "Scholar 0", "Social 2", "Trade 1"]
            ^"Advantages" LIST OF STRING ["Expert in Disguise (Air) [Social; Interpersonal]"]
            ^"Disadvantages" LIST OF STRING ["Impatience (Earth) [Social; Mental]"]
            ^"Favored Weapons" LIST OF STRING ["Barbed Hair: Range 0-2, Damage 3, Deadliness 6, Snaring, Unholy"]
            ^"Gear" LIST OF STRING ["Variety of robes and other clothes suitable for posing as Rokugani citizens", "Small knife"]
        }

        ^"Entangling Tresses" DEF {
            ^"Description" STRING "A harionago is an Otherworldly, Tainted being. When a harionago deals damage to an Immobilized target, it ignores 2 points of the target's physical resistance (to a minimum of 0)."
        }

        RULES {
            #L5RSH02mN2oP4qR6sT8uV0wX: harionago "Harionago appear as beautiful women with long, flowing hair. Unfortunately, their hair is tipped with poisonous, barbed thorns that can quickly ensnare and kill a human, whom they then consume. Nevertheless, they would be relatively easy to avoid, if not for a cunning ability to disguise themselves as lost Crab scouts or other travelers. They then attempt to get close to an intended quarry, ideally isolating them from any companions before attacking. Occasionally, these beings infiltrate the Empire, making them a possible threat even far inside the Kaiu Wall."
        }
    }

    # source stat block (page 16)
    ^"Kyōrinrin" DEF {
        EXTENDS #t4540de6f35155c46f41f0 ^"NPC"

        PROPERTIES {
            ^"Type" STRING "Minion" FIXED
            ^"Combat Conflict Rank" INTEGER 3
            ^"Intrigue Conflict Rank" INTEGER 2
            ^"Rings" DEF { ^"Air" INTEGER 3 ^"Earth" INTEGER 2 ^"Fire" INTEGER 1 ^"Water" INTEGER 3 ^"Void" INTEGER 1 }
            ^"Demeanor" STRING "Shrewd"
            ^"Social Skill Check TN Modifiers" STRING "Air +2, Fire -2"
            ^"Endurance" INTEGER 6
            ^"Composure" INTEGER 10
            ^"Focus" INTEGER 4
            ^"Vigilance" INTEGER 3
            ^"Silhouette" INTEGER 3
            ^"Skills" LIST OF STRING ["Artisan 0", "Martial 3", "Scholar 0", "Social 1", "Trade 0"]
            ^"Advantages" LIST OF STRING ["Subtle Appearance (Air) [Martial; Physical]"]
            ^"Disadvantages" LIST OF STRING ["Fear of Fire (Fire) [Social; Mental]"]
            ^"Favored Weapons" LIST OF STRING ["Smothering Papers: Range 0-1, Damage 4, Deadliness 4, Snaring, Unholy"]
            ^"Gear" LIST OF STRING ["Shifting layers of paper (Physical 6, Supernatural 6, Unholy)"]
        }

        ^"Masses of Paper" DEF {
            ^"Description" STRING "A kyōrinrin is an Otherworldly, Tainted being of silhouette 3. When a kyōrinrin defends against fire damage (such as from a Fire invocation, kihō, or a flame), its resistance counts as 0. When a kyōrinrin makes a successful Attack action check, it may spend (op) (op) as follows: (op) (op)+: The target begins to suffocate (see page 269 of the core rulebook). After a character suffers strife and fatigue at the start of their turn from suffocating this way, the character may make a TN 3 Fitness check (Fire 2, Earth 5) to break free and breath normally."
        }

        RULES {
            #L5RSH03yZ3aB5cD7eF9gH1iJ: kyorinrin "Illustrative of the Taint's ability to corrupt nearly anything, a kyōrinrin is a being composed of scrolls, origami, or essentially anything else made of paper. Given their nature, they may not appear particularly dangerous. This is deceptive, however, as the power motivating kyōrinrin is a strong one, and they can bind, blind, or even smother their foes. The paper that composes them can be torn or burned, but they are tenacious and continue to attack, usually until they are completely destroyed."
        }
    }

    # source stat block (page 17)
    ^"Penanggalan (Shadowlands)" DEF {
        EXTENDS #t4540de6f35155c46f41f0 ^"NPC"

        PROPERTIES {
            ^"Type" STRING "Adversary" FIXED
            ^"Combat Conflict Rank" INTEGER 6
            ^"Intrigue Conflict Rank" INTEGER 3
            ^"Rings" DEF {
                ^"Air" INTEGER 4
                ^"Earth" INTEGER 3
                ^"Fire" INTEGER 5
                ^"Water" INTEGER 2
                ^"Void" INTEGER 2
            }
            ^"Demeanor" STRING "Shrewd"
            ^"Social Skill Check TN Modifiers" STRING "Air +2, Fire -2"
            ^"Endurance" INTEGER 16
            ^"Composure" INTEGER 10
            ^"Focus" INTEGER 9
            ^"Vigilance" INTEGER 3
            ^"Honor" INTEGER 0
            ^"Glory" INTEGER 8
            ^"Status" INTEGER 0
            ^"Skills" LIST OF STRING ["Artisan 0", "Martial 5", "Scholar 2", "Social 3", "Trade 0"]
            ^"Advantages" LIST OF STRING ["Flying Horror (Fire) [Martial; Physical]"]
            ^"Disadvantages" LIST OF STRING ["Vulnerable While Eating (Earth) [Martial; Physical]"]
            ^"Favored Weapons" LIST OF STRING ["Tentacle Entrails: Range 0-2, Damage 5, Deadliness 6, Snaring, Unholy"]
            ^"Gear" LIST OF STRING ["Body shell (Physical 3 while the body is worn)"]
        }

        ^"Feaster of Blood" DEF {
            ^"Description" STRING "A penanggalan is an Otherworldly, Tainted being. While bodiless, it is silhouette 0; while wearing a body, it is silhouette 2. When a penanggalan inflicts a critical strike on its target, it removes fatigue from itself equal to the severity (after the check to resist). Optionally, the GM may choose 0–2 mahō (see page 224 of the core rulebook and page 118 of this book) that a penanggalan can perform; add 1 to this character's combat rank for each mahō chosen this way."
        }

        RULES {
            #L5RSH04kL4mN6oP8qR0sT2uV: penanggalan "Penanggalan outwardly appear to be normal humans. Indeed, during the day, they go about their business in Rokugan as farmers, artisans, or even samurai. Patrols in the Shadowlands sometimes encounter them posing as lost merchants or scouts. At night, however, they reveal their true nature: their head and internal organs detach from their body and become capable of flying about. In this horrific form, they seek out their victims, usually individuals who are isolated or alone.\n\nWhen they attack, they do so swiftly, strangling their victims with their dangling viscera and then draining them of their blood. Because their entrails become engorged, they have difficulty squeezing themselves back into the shell of their body, so they spend several days digesting their meal, soaking themselves in vinegar to speed the process. They take great care to hide their bodies away until their food is completely consumed; many believe this is because if the penanggalan's body is destroyed in the meantime, the creature itself will weaken and die. Because penanggalan thrive on secrecy, one is unlikely to attack a party of samurai unless it can arrange for one of them to be alone and takes them by surprise. If confronted, penanggalan are likely to flee, but they are fierce fighters if cornered. Some are even capable of using mahō, making them truly dangerous opponents."
        }
    }

    # source stat block (page 17)
