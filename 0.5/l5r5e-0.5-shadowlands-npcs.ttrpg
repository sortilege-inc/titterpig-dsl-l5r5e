                ^"Water" INTEGER 2
                ^"Void" INTEGER 3
            }
            ^"Demeanor" STRING "Calculating"
            ^"Social Skill Check TN Modifiers" STRING "Fire +1, Earth -1"
            ^"Endurance" INTEGER 12
            ^"Composure" INTEGER 20
            ^"Focus" INTEGER 7
            ^"Vigilance" INTEGER 4
            ^"Honor" INTEGER 10
            ^"Glory" INTEGER 1
            ^"Status" INTEGER 0
            ^"Skills" LIST OF STRING ["Artisan 6", "Martial 3", "Scholar 6", "Social 5", "Trade 0"]
            ^"Advantages" LIST OF STRING ["Ancient Cunning (Air) [Scholar; Interpersonal]"]
            ^"Disadvantages" LIST OF STRING ["Long View (Fire) [Social; Mental]"]
            ^"Favored Weapons" LIST OF STRING ["Claws: Range 0-1, Damage 4, Deadliness 8, Razor-Edged, Unholy"]
            ^"Gear" LIST OF STRING ["Ethereal clothing (Physical 3, Supernatural 5)"]
        }

        ^"Through Tainted Glass" DEF {
            ^"Description" STRING "The Obsidian Flower is an Otherworldly, Tainted being. Each time PCs face the Obsidian Flower, choose two different Shadowlands Powers (see page 137) for her. Once per scene as an Attack and Scheme action, the Obsidian Flower may summon a dark reflection of each PC. This reflection uses the same profile as the character, cannot perform Attack or Scheme actions targeting any character other the PC it mirrors, and has the same Shadowlands Powers as the Obsidian Flower."
        }

        RULES {
            #L5RSH18wX8yZ0aB2cD4eF6gH: the_obsidian_flower "Called many names across the ages—the Obsidian Flower, the High Priest of Fu Leng, the Demon Bride—this ancient entity was once a human. Whispers say she was born to a powerful lineage in the third century of the Empire, and witnessed firsthand the callous turns of the court. Wretched cruelties befell people around her in service of nothing more than petty human ambition, and she grew to believe Rokugan's ruling caste was incurably corrupt—and that the founding Kami had forsaken their followers. Her desire became nothing less than to sweep the table clean. She stole a Black Scroll from the Yogo family and journeyed into the Shadowlands. There, she used the unspeakable knowledge within the scroll to become a twisted, demonic conduit. Now, within the Tomb, she waits and plans, whispering to Fu Leng as she slowly shifts pieces across the vast board of time. Over centuries, she has maneuvered humans into positions where their frailties might someday bring about the end of the Empire."
        }
    }

    # source stat block (page 32)
