                ^"Opportunities" STRING "(op)+: Each observer with vigilance equal to or less than one plus the amount of (op) you spend this way believes your attack was not meant to be lethal."
            }

            #Tat6M5d1RhR8Ngc0RSgrqR ^"Like a Ghost" DEF {
                ^"Type" STRING "Ninjutsu"
                ^"Rank" INTEGER 2
                ^"Activation" STRING "As a Movement and Scheme action"
                ^"Check" STRING "TN 2 Fitness (Air or Water)"
                ^"Effect" STRING "If you succeed, you may move one range band, plus one additional range band per two bonus successes. This movement ignores the effects of any terrain you pass through. You may also move up or down vertical surfaces or across gaps that could conceivably be jumped if your GM permits."
                ^"Opportunities" STRING "(op) (op): Your footfalls are so light as to be completely silent."
            }

            #atpHbMS15bB3yFq6dlKJin ^"Slicing Wind Kick" DEF {
                ^"Type" STRING "Ninjutsu"
                ^"Rank" INTEGER 3
                ^"Activation" STRING "As an Attack and Movement action using one readied polearm"
                ^"Check" STRING "you may make a TN 3 Martial Arts [Unarmed] (Air) check with your unarmed kick profile (see page 237 of the core rulebook) targeting one character at range 1–2."
                ^"Effect" STRING "If you succeed, the target suffers physical damage equal to your unarmed kick profile's base damage plus your bonus successes.\n\nIf you succeed, the target suffers the Disoriented condition."
                ^"Opportunities" STRING "Air (op): Before or after resolving success or failure, move 1 range band.\n\nAir (op) (op): One target suffers the Prone condition.\n\nAir (op) (op)+: Choose one additional target per (op) (op) spent this way."
            }

            #beaFsv6ZBWdTyzuu45IzUK ^"Silent Elimination" DEF {
                ^"Type" STRING "Ninjutsu"
                ^"Rank" INTEGER 3
                ^"Activation" STRING "As an Attack and Movement action using one readied melee or unarmed weapon with the Snaring quality"
                ^"Check" STRING "you may make a TN 3 Martial Arts [Melee or Unarmed] check targeting one living character of silhouette 0–2 in range of the weapon. If you successfully performed this action against the same target during the previous round, reduce the TN of the check by 2, to a minimum of 1."
                ^"Effect" STRING "If you succeed, the target suffers the Immobilized and Silenced condition, and is pulled to range 0 of you. If the target chooses to perform Attack actions, they are limited to making Martial Arts [Unarmed] checks targeting you, and they must increase the TN of these checks by 1."
                ^"Opportunities" STRING "(op): If you succeed and the target is a minion, they suffer the Unconscious condition.\n\n(op)+: If you succeed, the target suffers 2 fatigue and 2 strife per (op) spent in this way. If the target suffers fatigue exceeding their endurance as a result of this, they suffer the Unconscious condition in addition to the Incapacitated condition.\n\n(op) (op): If you succeed, you and your target move one range band, ending at range 0 of each other."
            }

            #rvgrWUBluGHHiHRuxIYcFV ^"Stillness of Death" DEF {
                ^"Type" STRING "Ninjutsu"
                ^"Rank" INTEGER 5
                ^"Activation" STRING "When you perform a check to use a Ninjutsu technique"
                ^"Opportunities" STRING "(op)+: Increase the TN of the next check a character makes to resist a critical strike you inflict by 1 per (op) spent this way. This effect persists until the end of your next turn."
            }

            #NcnhkwOSJ1b8G0ZBduS82u ^"To Float or Sink" DEF {
                ^"Type" STRING "Ninjutsu"
                ^"Rank" INTEGER 2
                ^"Activation" STRING "When you make a Martial skill (Water or Earth) check"
                ^"Opportunities" STRING "Water or Earth (op)+: Remove one existing Disoriented or Prone condition from yourself. Water or Earth (op): Do not suffer the Disoriented and Prone conditions if the check would cause you to suffer them."
            }

            #T7kCZ2WUDRhoBdYAN1mWFk ^"What's Yours Is Mine" DEF {
                ^"Type" STRING "Ninjutsu"
                ^"Rank" INTEGER 2
                ^"Activation" STRING "As an Attack and Movement action using one readied weapon without the Cumbersome quality"
                ^"Check" STRING "you may make a TN 3 Martial Arts [Melee] (Fire) check targeting one character at range 0–1."
                ^"Effect" STRING "If you succeed, your target suffers physical damage equal to your weapon's base damage.\n\nIf you succeed and your target is Dazed, you may steal one item that your target has on their person; the size and location of an object should be narratively reasonable and is subject to the GM's approval. If you choose to steal a readied weapon, the target may resist with a TN 3 Fitness check (Air 5, Water 2)."
                ^"Opportunities" STRING "Fire (op): The target suffers the Dazed condition.\n\nFire (op)+: Move 1 range band plus one additional band per (op) (op) beyond the first.\n\nFire (op) (op)+: If you succeed, you may steal one additional item per (op) (op) spent this way."
            }

            # --- RITUALS ---

            #Y1JKNOZDMYeKXGD1x2ccRa ^"Formal Tea Ceremony" DEF {
                ^"Type" STRING "Ritual"
                ^"Rank" INTEGER 5
                ^"Activation" STRING "Once per game session, as a downtime activity using a ceremonial tea set"
                ^"Check" STRING "you may make a TN 5 Performance (Void) check targeting yourself and a number of other characters up to your ranks in Culture, who are also participants. Up to one other participant may assist, providing the usual benefits (see Assistance on page 26 of the core rulebook)."
                ^"Effect" STRING "Each participant removes 6 strife plus additional strife equal to your bonus successes.\n\nIf you succeed, each participant also gains 1 Void point."
                ^"Opportunities" STRING "(op) (op): If you succeed, reduce the TN of each participant's next check by 2.\n\n(op)+: Each participant removes 2 fatigue, plus 1 fatigue per (op) spent this way.\n\n(op) (op): If you succeed, you gain 1 glory per participant of higher status than yourself."
            }

            #HqWk8bnWA0tB1rZgr0Ru1f ^"Treaty Signing" DEF {
                ^"Type" STRING "Ritual"
                ^"Rank" INTEGER 2
                ^"Activation" STRING "Once per game session as a downtime activity"
                ^"Check" STRING "you may make a TN 2 Composition (Fire) check to write an agreement. If you succeed, you may make a TN 3 Government (Air) check targeting yourself and a number of other characters, who are also participants. Up to three other participants may assist, providing the usual benefits (see Assistance on page 26 of the core rulebook)."
                ^"Effect" STRING "If you succeed, each participant is assured that there are no mistakes or objectionable loopholes to the agreement, and that the agreement is acceptable to all parties involved. Each participant stakes 10 honor on upholding the agreement. Anyone who later breaks the agreement loses the honor they staked, unless another participant broke the agreement first."
                ^"Opportunities" STRING "(op)+: If you succeed, all participates stake 1 additional honor, plus 1 additional honor per (op) spent this way.\n\n(op) (op) (op): If you succeed, you need only stake half the honor that the other participants stake."
            }

            #sTO3XJuwqOmYBA0lKUleJz ^"The Ties that Bind" DEF {
                ^"Type" STRING "Ritual"
                ^"Rank" INTEGER 4
                ^"Activation" STRING "As a downtime activity"
                ^"Check" STRING "you may make a TN 3 Sentiment (Void) check targeting one character."
                ^"Effect" STRING "If you succeed, you learn of a character who would be a particularly fortuitous match for your target (in potentially any sort of relationship, such as marriage, friendship, or a formal alliance). This does not provide the exact identity of said character, but should provide valuable clues about this person (where they live, what their social status is, what clan or family they belong to, etc). If you already have met this character, the clues should be enough to identify them.\n\nIf you are using the Bond rules found on page 136, after performing this ritual the target and identified character may decrease the cost of forming a Bond to 1 XP."
                ^"Opportunities" STRING "Void (op) (op)+: You learn of one likely future consequence of a relationship between your target and the identified character per (op) (op) spent in this way. These consequences may affect the target, their family and clan, or you and your clan.\n\nVoid (op) (op) (op) (op): You may learn of another character who would be a particularly inauspicious match for your target, and one likely future consequence of their relationship."
            }

            # --- AIR SHUJI ---

            #efgdT6Dqnxk8VoJdEoEhWQ ^"Assess Strengths" DEF {
                ^"Type" STRING "Shūji"
                ^"Subtype" STRING "Air Shūji"
                ^"Rank" INTEGER 1
                ^"Activation" STRING "As a Scheme action"
                ^"Check" STRING "you may make a Games (Air) check targeting one opponent in a game that you are playing. The TN of this check is equal to the target's vigilance."
                ^"Effect" STRING "If you succeed, you learn your target's ranks in Games, Tactics, or any one Martial Arts skill. Choose one additional skill to learn for each bonus success on the check."
                ^"Opportunities" STRING "Air (op) (op): You learn all your target's Mental advantages and disadvantages"
            }

            #ptNdPtiPE6nxbxWJzsFBAe ^"Hidden in Smoke" DEF {
                ^"Type" STRING "Shūji"
                ^"Subtype" STRING "Air Shūji"
                ^"Rank" INTEGER 4
                ^"Activation" STRING "Once per scene as a Scheme action"
                ^"Check" STRING "you may make a Social (Air) check targeting one other character. The TN of this check is equal to the target's vigilance."
                ^"Effect" STRING "If you succeed, you hide your true goal or objective from your opponent. Any action or ability that would reveal your true intentions or objective to the target instead reveals a false, narratively appropriate goal, subject to the GM's approval. This effect persists until the end of the scene.\n\nIf you succeed, during an intrigue scene, you gain 1 momentum point toward a relevant goal."
                ^"Opportunities" STRING "Air (op) (op)+: Choose one additional target with vigilance lower than the original target per (op) (op) spent this way.\n\nAir (op) (op)+: If you succeed, you gain 1 additional momentum point per (op) (op) spent this way."
            }

            # --- EARTH SHUJI ---

            #A3S7nE5RMe77V0PHKdGC1r ^"Unyielding Terms" DEF {
                ^"Type" STRING "Shūji"
                ^"Subtype" STRING "Earth Shūji"
                ^"Rank" INTEGER 2
                ^"Activation" STRING "Once per scene as a Scheme action"
                ^"Check" STRING "you may make a TN 4 Culture (Earth) check when you are determining the method of battle and stakes for victory in a duel (as a participant or adjudicator)."
                ^"Effect" STRING "You select either the method of battle, or the stakes for victory."
            }

            # --- FIRE SHUJI ---

            #UJvxL0bTkjNSVGU8eAmuXf ^"All Shall Fear Me" DEF {
                ^"Type" STRING "Shūji"
                ^"Subtype" STRING "Fire Shūji"
                ^"Rank" INTEGER 3
                ^"Activation" STRING "As a Scheme action"
                ^"Check" STRING "you may make a TN 4 Command or Performance (Fire) check targeting any number of characters in the scene."
                ^"Effect" STRING "If you succeed, each target receives 2 strife when they choose you as a target for a Social skill check. This effect persists until the end of the scene.\n\nIf you fail, you receive 4 strife."
                ^"Opportunities" STRING "Fire (op) (op)+: If you succeed, all characters targeted by you suffer 1 additional strife per (op) (op) spent this way whenever they target you with a Social skill check."
            }

            #T5sgNiyUnoOdc7tY06sFMk ^"Crackling Laughter" DEF {
                ^"Type" STRING "Shūji"
                ^"Subtype" STRING "Fire Shūji"
                ^"Rank" INTEGER 3
                ^"Activation" STRING "Once per game session, as a Scheme action"
                ^"Check" STRING "you may make a TN 3 Performance (Fire) check targeting a number of characters up to your Fire Ring."
                ^"Effect" STRING "If you succeed, each target receives 2 strife, and must make a TN 5 Meditation (Air 6, Water 3) check or receive additional strife equal to the shortfall.\n\nIf you fail, you receive 3 strife."
                ^"Opportunities" STRING "Fire (op)(op): For each character who suffers Compromised condition, gain 1 glory."
            }

            #AAHNrHOTQg53NOUUdk5ANV ^"Offend the Sensibilities" DEF {
                ^"Type" STRING "Shūji"
                ^"Subtype" STRING "Fire Shūji"
                ^"Rank" INTEGER 2
                ^"Activation" STRING "When you make an Artisan (Fire) check to craft an item"
                ^"Opportunities" STRING "Fire (op) (op): Choose one individual known to you. When that individual first sees the item you created, they receive 2 strife. If this causes them to suffer the Compromised condition, the target also suffers the Dazed, Enraged, or Silenced condition (your choice). Anyone else seeing the item knows it could be very offensive."
            }

            #nRnkwTsKTAeIetfUJQn2RP ^"Spiteful Loss" DEF {
                ^"Type" STRING "Shūji"
                ^"Subtype" STRING "Fire Shūji"
                ^"Rank" INTEGER 1
                ^"Activation" STRING "When you make a Games (Fire) check while playing a game"
                ^"Opportunities" STRING "Fire (op): If you fail, forfeit 1 glory. Then each participant receives strife equal to 1 plus the shortfall of the check on all participants in the game."
            }

            # --- WATER SHUJI ---

            #NHSvf55MvHC872WUw9laYv ^"Beware the Smallest Mouse" DEF {
                ^"Type" STRING "Shūji"
                ^"Subtype" STRING "Water Shūji"
                ^"Rank" INTEGER 1
                ^"Activation" STRING "When you make a Social skill (Water) check targeting one or more characters"
                ^"Opportunities" STRING "Water (op) (op)+: While interacting with you, the target treats their vigilance as 1 lower per (op) (op) spent this way and decreases the TN of their social checks targeting you by 1. This effect persists until the end of the scene."
            }

            #QpOJO4mD6GPhFwUiPqML7w ^"Fun and Games" DEF {
                ^"Type" STRING "Shūji"
                ^"Subtype" STRING "Water Shūji"
                ^"Rank" INTEGER 1
                ^"Activation" STRING "When you make a Games (Water) check"
                ^"Opportunities" STRING "Water (op)+: Choose one participant in the game or an observer. Remove 1 strife per opportunity spent from that participant.\n\nWater (op) (op) (op): Remove 1 strife from each participant and observer instead."
            }

            # --- VOID SHUJI ---

            #eYH247TMrCVewL7IBbB8xk ^"Foreseen Need" DEF {
                ^"Type" STRING "Shūji"
                ^"Subtype" STRING "Void Shūji"
                ^"Rank" INTEGER 4
                ^"Activation" STRING "As a Support action"
                ^"Check" STRING "TN 1 Artisan (Void)"
                ^"Effect" STRING "If you succeed, you recall that you had foreseen the need for an item with a rarity equal to 1 plus your bonus successes on the check. Spend one Void point to instantly reveal one item you could have crafted, as long as it is reasonable (e.g., you could be carrying it on your person or have it in your quarters, you had access to the resources to craft it over the past month)."
                ^"Opportunities" STRING "Void (op): Double the rarity of the target item, but the item must be of a perishable nature or one with only sentimental value."
            }
        }

    }

    # ===========================
    # SHINOBI WEAPONS
    # ===========================

    # source (pages 109-112)
    #knACwuREy6hna7Ba7D96WO ^"Courts of Stone Weapons" DEF {
        APPLIES TO [#L5R003xY4zA6bC8dE0fG2hI ^"Samurai"]

        ENTRIES {
            #UCdeVlAwoB7CBLVLba2HzI ^"Ninjato" DEF {
                ^"Category" STRING "Sword"
                ^"Skill" STRING "Martial Arts [Melee]"
                ^"Range" STRING "0-1"
                ^"Damage" INTEGER 4
                ^"Deadliness" INTEGER 4
                ^"Grips" STRING "1-hand: -; 2-hand: Deadliness +1"
                ^"Qualities" LIST OF STRING ["Concealable", "Forbidden", "Razor-Edged"]
                ^"Rarity" INTEGER 7
                ^"Cost" STRING "12 koku"
            }

            #GPtYBNxANRkDYNYi1VaMc1 ^"Shinobigatana" DEF {
                ^"Category" STRING "Sword"
                ^"Skill" STRING "Martial Arts [Melee]"
                ^"Range" STRING "0-1"
                ^"Damage" INTEGER 4
                ^"Deadliness" INTEGER 5
                ^"Grips" STRING "1-hand: -; 2-hand: Deadliness +1"
                ^"Qualities" LIST OF STRING ["Ceremonial", "Concealable", "Razor-Edged"]
                ^"Rarity" INTEGER 8
                ^"Cost" STRING "22 koku"
                ^"Special" STRING "A shinobigatana appears to be a katana until examined; a character examining it must either see it drawn or make a TN 4 Smithing check [Air 2, Water 5] to find the telltale details that betray the blade's duplicity. If its true function is discovered, it loses the Ceremonial quality and gains the Forbidden quality for anyone who knows its identity."
            }

            #H0ugFVFEFvRWU1MpuSymVV ^"Folding Half-Bow" DEF {
                ^"Category" STRING "Bow"
                ^"Skill" STRING "Martial Arts [Ranged]"
                ^"Range" STRING "2-3"
                ^"Damage" INTEGER 4
                ^"Deadliness" INTEGER 3
                ^"Grips" STRING "2-hand: -"
                ^"Rarity" INTEGER 5
                ^"Cost" STRING "3 koku"
                ^"Special" STRING "While in its case or otherwise folded, a folding half-bow has the Concealable quality and cannot be fired.\n\nAs a Support action, a character may prepare a folding half-bow for use."
            }

            #Emcmq5eAjA8M2sl3ERuWNM ^"Kamayari" DEF {
                ^"Category" STRING "Specialist"
                ^"Skill" STRING "Martial Arts [Melee]"
                ^"Range" STRING "2"
                ^"Damage" INTEGER 4
                ^"Deadliness" INTEGER 3
                ^"Grips" STRING "2-hand: -"
                ^"Qualities" LIST OF STRING ["Durable", "Snaring"]
                ^"Rarity" INTEGER 7
                ^"Cost" STRING "8 koku"
            }

            #CHBKbQmT0UwMNK9dt4l7VO ^"Kusarifundo" DEF {
                ^"Category" STRING "Specialist"
                ^"Skill" STRING "Martial Arts [Melee]"
                ^"Range" STRING "1"
                ^"Damage" INTEGER 2
                ^"Deadliness" INTEGER 2
                ^"Grips" STRING "1-hand: -; 2-hand: Snaring"
                ^"Qualities" LIST OF STRING ["Concealable"]
                ^"Rarity" INTEGER 5
                ^"Cost" STRING "4 bu"
            }

            #y4vEGhkDYipE2dVH44JvIR ^"Kyoketsu Shoge" DEF {
                ^"Category" STRING "Specialist"
                ^"Skill" STRING "Martial Arts [Ranged]"
                ^"Range" STRING "1-2"
                ^"Damage" INTEGER 2
                ^"Deadliness" INTEGER 3
                ^"Grips" STRING "2-hand: -"
                ^"Qualities" LIST OF STRING ["Concealable", "Forbidden", "Snaring"]
                ^"Rarity" INTEGER 6
                ^"Cost" STRING "3 bu"
            }

            #N7dQzhE8gQ2MbpgYP66flH ^"Shakuhachi" DEF {
                ^"Category" STRING "Specialist"
                ^"Skill" STRING "Martial Arts [Melee]"
                ^"Range" STRING "0"
                ^"Damage" INTEGER 3
                ^"Deadliness" INTEGER 2
                ^"Grips" STRING "1-hand: -; 2-hand: Damage +1"
                ^"Qualities" LIST OF STRING ["Durable", "Mundane", "Subtle"]
                ^"Rarity" INTEGER 4
                ^"Cost" STRING "3 bu"
            }

            #LxKpLqTBUgs7aLhav5FwCJ ^"Tekagi" DEF {
                ^"Category" STRING "Specialist"
                ^"Skill" STRING "Martial Arts [Unarmed]"
