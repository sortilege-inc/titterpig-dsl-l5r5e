    # source stat block (page 95)
    #b6FVKy0gmfJ1RJlUXpNQOZ ^"Shika Matchmaker" DEF {
        EXTENDS #L5R252wX4yZ6aB8cD0eF2g ^"School"
        APPLIES TO [#L5R003xY4zA6bC8dE0fG2hI ^"Samurai"]

        PROPERTIES {
            ^"School Name" STRING "Shika Matchmaker" FIXED
            ^"Clan" STRING "Deer"
            ^"Roles" LIST ["Courtier", "Shugenja"]
            ^"Ring Increase" DEF {
                ^"Air" INTEGER 1
                ^"Water" INTEGER 1
            }
            ^"Starting Skills" DEF { CHOOSE 3 [^"Composition", ^"Courtesy", ^"Culture", ^"Meditation", ^"Sentiment", ^"Theology"] INTEGER 1 }
            ^"Starting Honor" INTEGER DEFAULT 50
            ^"Techniques Available" LIST ["Air and Water Invocations", "Rituals", "Shūji"]
        }

        STARTING_TECHNIQUES {
            RITUAL ^"The Ties that Bind"
            INVOCATION ^"Yari of Air"
            INVOCATION CHOOSE 2 [^"Blessed Wind", ^"Path to Inner Peace", ^"Sympathetic Energies", ^"Tempest of Air"]
        }

        SCHOOL_ABILITY "Gift of Musubi-no-Kami" {
            "You may perform The Ties that Bind ritual as an action, instead of as a downtime activity. When you make a check to perform this ritual, you may add kept (ring) set to (op) results equal to your school rank."
        }

        MASTERY_ABILITY ^"Curse of Musubi-no-Kami" {
            "Once per scene, after successfully performing the Ties that Bind ritual, you may spend 1 Void point to catch a glimpse of all major future consequences of the relationship identified by the ritual. You also learn of one other relationship between your target and another character that will guarantee that the consequences you predict will not come to pass."
        }
        STARTING_OUTFIT [
            "traveling clothes", "ceremonial clothes",
            "wakizashi", "tea set"
        ]

        CURRICULUM {
            RANK 1 {
                SKILL_GROUP "Scholar Skills"
                SKILL "Courtesy"
                SKILL "Games"
                SKILL "Meditation"
                TECHNIQUE_GROUP "Rank 1 Air Invocations"
                ^"Ancestry Unearthed" [shuji]
