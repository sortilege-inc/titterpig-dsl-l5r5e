            }

            #CkZA2G0lp759qQRZiR9yyB ^"Bamboo Cane" DEF {
                ^"Category" STRING "Shinobi Item"
                ^"Cost" STRING "6 bu"
                ^"Rarity" INTEGER 6
                ^"Qualities" LIST OF STRING ["Concealable", "Mundane"]
                ^"Special" STRING "A bamboo cane can be wielded as a bokken (see page 231 of the core rulebook).\n\nIts interior can double as a blowgun. It can also conceal objects, messages, or a flexible weapon, perhaps a rope or chain with a hook to aid in climbing or to entangle an enemy."
            }

            #YNdd5RZ4eydjI0fqsDCF19 ^"Demon Mask" DEF {
                ^"Category" STRING "Shinobi Item"
                ^"Cost" STRING "1 koku"
                ^"Rarity" INTEGER 5
                ^"Qualities" LIST OF STRING ["Forbidden"]
                ^"Special" STRING "A demon mask grants the wearer the following additional unarmed profile: Horned head butt (Martial Arts [Unarmed], Range 0, Damage 3, Deadliness 2)."
            }

            #e5v9HjpJl7mwks7YeCk87Z ^"Disguise Kit" DEF {
