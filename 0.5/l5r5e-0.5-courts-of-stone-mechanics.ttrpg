EXTENSION "L5R5e_Courts_of_Stone" EXTENDS "L5R5e_Core_Character" {
    NAME "Legend of the Five Rings 5th Edition - Courts of Stone: New Player Options"
    VERSION "0.5.3"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-03-01"

    # Courts of Stone (Chapters 2 and 3): Deer Minor Clan, Shika family,
    # new schools, advantages, disadvantages, heritages, weapons, armor,
    # courtier/shinobi items, techniques (kata, ninjutsu, rituals, shūji),
    # titles, bonds system, and opportunity tables for intrigue games.

    # ===========================
    # DEER MINOR CLAN
    # ===========================

    # source stat block (page 88)
    #nDYqOJP7e7SCFgwVCwtvSO ^"Deer Minor Clan" DEF {
        EXTENDS #L5R250aB2cD4eF6gH8iJ0k ^"Clan"
        APPLIES TO [#L5R003xY4zA6bC8dE0fG2hI ^"Samurai"]

        PROPERTIES {
            ^"Clan Name" STRING "Deer" FIXED
            ^"Clan Type" STRING "Minor Clan"
            ^"Clan Ring Bonus" DEF { ^"Air" INTEGER 1 }
            ^"Clan Skill Bonus" DEF { ^"Sentiment" INTEGER 1 }
            ^"Clan Status" INTEGER DEFAULT 30
        }

        FAMILIES {
            ^"Shika"
        }

    }

    # ===========================
    # DEER FAMILIES
    # ===========================

    #L5RCS50wX4yZ6aB8cD0eF2g ^"Shika" DEF {
        EXTENDS #L5R251lM3nO5pQ7rS9tU1v ^"Family"
        APPLIES TO [#L5R003xY4zA6bC8dE0fG2hI ^"Samurai"]

        PROPERTIES {
            ^"Family Name"     STRING "Shika" FIXED
            ^"Clan"            STRING "Deer"
            ^"Ring Increase" DEF { CHOOSE 1 [^"Water", ^"Fire"] INTEGER 1 }
            ^"Skill Increases" DEF {
                ^"Courtesy" INTEGER 1
                ^"Culture" INTEGER 1
            }
            ^"Glory"           INTEGER 35
            ^"Wealth" DEF { ^"Count" INTEGER 5  ^"Type" STRING "koku"  ^"Starting" BOOLEAN true }
        }
    }

    # ===========================
    # NEW SCHOOLS
    # ===========================

    # source (page 89)
    #K8kbxx9aQJl3v9NWK2qBa2 ^"Bayushi Deathdealer" DEF {
        EXTENDS #L5R252wX4yZ6aB8cD0eF2g ^"School"
        APPLIES TO [#L5R003xY4zA6bC8dE0fG2hI ^"Samurai"]

        PROPERTIES {
            ^"School Name" STRING "Bayushi Deathdealer" FIXED
            ^"Clan" STRING "Scorpion"
            ^"Roles" LIST ["Bushi", "Shinobi"]
            ^"Ring Increase" DEF {
                ^"Air" INTEGER 1
                ^"Fire" INTEGER 1
            }
            ^"Starting Skills" DEF { CHOOSE 5 [^"Command", ^"Courtesy", ^"Fitness", ^"Martial Arts [Melee]", ^"Martial Arts [Ranged]", ^"Tactics", ^"Sentiment", ^"Skulduggery"] INTEGER 1 }
            ^"Starting Honor" INTEGER DEFAULT 40
            ^"Techniques Available" LIST ["Kata", "Rituals", "Shūji"]
        }

        STARTING_TECHNIQUES {
            KATA CHOOSE 1 [^"Striking as Air", ^"Striking as Fire"]
            SHUJI ^"Assess Strengths"
        }

        SCHOOL_ABILITY "Way of the Scorpion" {
            "When you exploit a target's disadvantage (see Turning Advantages and Disadvantages, page 100 of the core rulebook) as part of an Initiative check for a duel or an Attack action, you do not need to spend a Void point, and you may reroll additional dice up to your school rank."
        }

        MASTERY_ABILITY ^"Strike First, Strike Last" {
            "When you inflict a critical strike during a duel or skirmish, treat the deadliness of your weapon as increased by the difference between your initiative and your target's initiative (subtracting the lower of the two initiative values from the higher)."
        }
        STARTING_OUTFIT [
            "traveling clothes", "ashigaru armor",
            "daishō", "knife",
            "shinobigatana or folding half bow",
            "traveling pack"
        ]

        CURRICULUM {
            RANK 1 {
                SKILL_GROUP "Martial Skills"
                SKILL "Courtesy"
                SKILL "Games"
                SKILL "Skulduggery"
                TECHNIQUE_GROUP "Rank 1 General Kata"
                ^"Deceitful Strike" [ninjutsu]
                ^"Spiteful Loss" [shuji]
            }
            RANK 2 {
                SKILL_GROUP "Social Skills"
                SKILL "Martial Arts [Melee]"
                SKILL "Meditation"
                SKILL "Skulduggery"
                TECHNIQUE_GROUP "Rank 1-2 Air Shūji"
                ^"Deadly Sting" [ninjutsu]
                ^"Iaijutsu Cut: Rising Blade" [kata]
            }
            RANK 3 {
                SKILL_GROUP "Martial Skills"
                SKILL "Courtesy"
                SKILL "Smithing"
                SKILL "Survival"
                TECHNIQUE_GROUP "Rank 1-3 Close Combat Kata"
                ^"Cunning Distraction" [ninjutsu]
                ^"All Shall Fear Me" [shuji]
            }
            RANK 4 {
                SKILL_GROUP "Scholar Skills"
                SKILL "Command"
                SKILL "Games"
                SKILL "Tactics"
                TECHNIQUE_GROUP "Rank 1-4 Ranged Kata"
                ^"A Samurai's Fate" [shuji]
                ^"Rallying Cry" [shuji]
            }
            RANK 5 {
                SKILL_GROUP "Social Skills"
                SKILL "Martial Arts [Melee]"
                SKILL "Martial Arts [Ranged]"
                SKILL "Tactics"
                TECHNIQUE_GROUP "Rank 1-5 Kata"
                ^"Stillness of Death" [ninjutsu]
                ^"Hidden in Smoke" [shuji]
            }
            RANK 6 {
                ^"Strike First, Strike Last"
            }
        }

    }

    # source stat block (page 90)
    #yQ6ELn6VBPrfq32eVf0oNS ^"Daidoji Spymaster" DEF {
        EXTENDS #L5R252wX4yZ6aB8cD0eF2g ^"School"
        APPLIES TO [#L5R003xY4zA6bC8dE0fG2hI ^"Samurai"]

        PROPERTIES {
            ^"School Name" STRING "Daidoji Spymaster" FIXED
            ^"Clan" STRING "Crane"
            ^"Roles" LIST ["Courtier", "Shinobi"]
            ^"Ring Increase" DEF {
                ^"Air" INTEGER 1
                ^"Earth" INTEGER 1
            }
            ^"Starting Skills" DEF { CHOOSE 5 [^"Command", ^"Courtesy", ^"Culture", ^"Government", ^"Performance", ^"Sentiment", ^"Skulduggery"] INTEGER 1 }
            ^"Starting Honor" INTEGER DEFAULT 35
            ^"Techniques Available" LIST ["Kata", "Rituals", "Shūji"]
        }

        STARTING_TECHNIQUES {
            SHUJI ^"Ancestry Unearthed"
            NINJUTSU CHOOSE 1 [^"Like a Ghost", ^"Skulk"]
            KATA CHOOSE 1 [^"Striking as Air", ^"Striking as Earth"]
        }

        SCHOOL_ABILITY "Incisive Insight" {
            "Once per scene, when making a check for a Scheme action targeting another character, you may receive a number of strife up to your school rank to reduce the TN by that amount (to a minimum of 1)."
        }

        MASTERY_ABILITY ^"Spy Network" {
            "As a downtime activity in any place of human habitation, you may make a TN 4 Skulduggery check to find an agent of the Daidoji spy network. If you succeed, you find this individual among the inhabitants of the city and gain the Ally advantage for them (see page 101 of the core rulebook). If you succeed with 2 or more bonus successes, the individual may occupy a low-to-mid-level position in a household or organization of your choosing."
        }
        STARTING_OUTFIT [
            "traveling clothes", "ceremonial clothes",
            "wakizashi", "sokutoki",
            "disguise kit", "opening and closing kit"
        ]

        CURRICULUM {
            RANK 1 {
                SKILL_GROUP "Trade Skills"
                SKILL "Command"
                SKILL "Culture"
                SKILL "Government"
                TECHNIQUE_GROUP "Rank 1 Air Shūji"
                ^"Lady Doji's Decree" [shuji]
                ^"Weight of Duty" [shuji]
            }
            RANK 2 {
                SKILL_GROUP "Scholar Skills"
                SKILL "Courtesy"
                SKILL "Games"
                SKILL "Skulduggery"
                TECHNIQUE_GROUP "Rank 1-2 Earth Shūji"
                ^"What's Yours Is Mine" [ninjutsu]
                ^"Treaty Signing" [ritual]
            }
            RANK 3 {
                SKILL_GROUP "Social Skills"
                SKILL "Culture"
                SKILL "Sentiment"
                SKILL "Martial Arts [Unarmed]"
                TECHNIQUE_GROUP "Rank 1-3 Air Shūji"
                ^"Hidden in Smoke" [shuji]
                ^"Open-Hand Style" [kata]
            }
            RANK 4 {
                SKILL_GROUP "Trade Skills"
                SKILL "Command"
                SKILL "Government"
                SKILL "Tactics"
                TECHNIQUE_GROUP "Rank 1-4 Water Shūji"
                ^"Cunning Distraction" [ninjutsu]
                ^"Wolf's Proposal" [shuji]
            }
            RANK 5 {
                SKILL_GROUP "Scholar Skills"
                SKILL "Command"
                SKILL "Martial Arts [Melee]"
                SKILL "Tactics"
                TECHNIQUE_GROUP "Rank 1-5 Earth Shūji"
                ^"Noxious Cloud" [ninjutsu]
                ^"Bend with the Storm" [shuji]
            }
            RANK 6 {
                ^"Spy Network"
            }
        }

    }

    # source stat block (page 91)
    #lREWYYlbcyQHoyfqGudep2 ^"Doji Bureaucrat" DEF {
        EXTENDS #L5R252wX4yZ6aB8cD0eF2g ^"School"
        APPLIES TO [#L5R003xY4zA6bC8dE0fG2hI ^"Samurai"]

        PROPERTIES {
            ^"School Name" STRING "Doji Bureaucrat" FIXED
            ^"Clan" STRING "Crane"
            ^"Roles" LIST ["Courtier"]
            ^"Ring Increase" DEF {
                ^"Earth" INTEGER 1
                ^"Water" INTEGER 1
            }
            ^"Starting Skills" DEF { CHOOSE 5 [^"Command", ^"Composition", ^"Courtesy", ^"Culture", ^"Games", ^"Government", ^"Meditation"] INTEGER 1 }
            ^"Starting Honor" INTEGER DEFAULT 55
            ^"Techniques Available" LIST ["Rituals", "Shūji"]
        }

        STARTING_TECHNIQUES {
            SHUJI ^"Courtier's Resolve"
            SHUJI ^"Stonewall Tactics"
        }

        SCHOOL_ABILITY "Procedure and Protocol" {
            "When you cause a character to receive strife as a result of a check using a social approach, that character suffers additional strife equal to your school rank."
        }

        MASTERY_ABILITY ^"Post Facto" {
            "Once per game session as a Scheme and Support action, you may make a TN 3 Government (Earth) check. If you succeed, you reveal a huge legal loophole or arcane precedent that legally justifies the actions of you and your allies during the scene. Others can refuse to accept your logic, but must forfeit honor equal to your ranks in Government plus your bonus successes to do so."
        }
        STARTING_OUTFIT [
            "ceremonial clothing", "wakizashi",
            "legal primer", "blank forms",
            "calligraphy kit",
            "scroll designating the bearer as an individual of decidedly moderate authority"
        ]

        CURRICULUM {
            RANK 1 {
                SKILL_GROUP "Scholar Skills"
                SKILL "Commerce"
                SKILL "Composition"
                SKILL "Courtesy"
                TECHNIQUE_GROUP "Rank 1 Earth Shūji"
                ^"Treaty Signing" [ritual]
                ^"Beware the Smallest Mouse" [shuji]
            }
            RANK 2 {
                SKILL_GROUP "Trade Skills"
                SKILL "Courtesy"
                SKILL "Games"
                SKILL "Government"
                TECHNIQUE_GROUP "Rank 1-2 Water Shūji"
                ^"The Wind Blows Both Ways" [shuji]
                ^"Unyielding Terms" [shuji]
            }
            RANK 3 {
                SKILL_GROUP "Social Skills"
                SKILL "Commerce"
                SKILL "Culture"
                SKILL "Sentiment"
                TECHNIQUE_GROUP "Rank 1-3 Air Shūji"
                ^"Hidden in Smoke" [shuji]
                ^"All Shall Fear Me" [shuji]
            }
            RANK 4 {
                SKILL_GROUP "Scholar Skills"
                SKILL "Command"
                SKILL "Meditation"
                SKILL "Tactics"
                TECHNIQUE_GROUP "Rank 1-4 Rituals"
                ^"The Immovable Hand of Peace" [shuji]
                ^"Rallying Cry" [shuji]
            }
            RANK 5 {
                SKILL_GROUP "Trade Skills"
                SKILL "Command"
                SKILL "Performance"
                SKILL "Tactics"
                TECHNIQUE_GROUP "Rank 1-5 Void Shūji"
                ^"Bend with the Storm" [shuji]
                ^"Formal Tea Ceremony" [ritual]
            }
            RANK 6 {
                ^"Post Facto"
            }
        }

    }

    # source stat block (page 92)
    #dtO9ZoOeY6ML85y3iXwZUF ^"Ikoma Shadow" DEF {
        EXTENDS #L5R252wX4yZ6aB8cD0eF2g ^"School"
        APPLIES TO [#L5R003xY4zA6bC8dE0fG2hI ^"Samurai"]

        PROPERTIES {
            ^"School Name" STRING "Ikoma Shadow" FIXED
            ^"Clan" STRING "Lion"
            ^"Roles" LIST ["Courtier", "Shinobi"]
            ^"Ring Increase" DEF {
                ^"Air" INTEGER 1
                ^"Fire" INTEGER 1
            }
            ^"Starting Skills" DEF { CHOOSE 5 [^"Courtesy", ^"Culture", ^"Government", ^"Martial Arts [Melee]", ^"Martial Arts [Ranged]", ^"Skulduggery", ^"Survival"] INTEGER 1 }
            ^"Starting Honor" INTEGER DEFAULT 40
            ^"Techniques Available" LIST ["Kata", "Rituals", "Shūji"]
        }

        STARTING_TECHNIQUES {
            SHUJI ^"Whispers of Court"
            NINJUTSU ^"Skulk"
            KATA CHOOSE 1 [^"Hawk's Precision", ^"Warrior's Resolve"]
        }

        SCHOOL_ABILITY "Victory before Honor" {
            "Once per scene when performing a check, you may stake an amount of honor no greater than your school rank to re-roll a number of dice equal to twice the amount of honor staked. For each re-rolled die result that does not contain a (su) or (ex), you forfeit one staked honor."
        }

        MASTERY_ABILITY ^"Victory Is the Greatest Honor" {
            "Once per session after failing a Martial or Social check, you may stake up to 5 honor and immediately attempt the check again, adding (su) equal to the honor staked. If you fail, you forfeit all honor staked. If you succeed, you instead gain 1 honor and 1 glory."
        }
        STARTING_OUTFIT [
            "ashigaru armor or ceremonial clothes",
            "daishō or wakizashi and kamayari", "yumi",
            "any one musical instrument or book of poetry",
            "traveling pack"
        ]

        CURRICULUM {
            RANK 1 {
                SKILL_GROUP "Martial Skills"
                SKILL "Performance"
                SKILL "Skulduggery"
                SKILL "Survival"
                TECHNIQUE_GROUP "Rank 1 General Kata"
                ^"What's Yours Is Mine" [ninjutsu]
                ^"Rustling of Leaves" [shuji]
            }
            RANK 2 {
                SKILL_GROUP "Social Skills"
                SKILL "Martial Arts [Unarmed]"
                SKILL "Sentiment"
                SKILL "Skulduggery"
                TECHNIQUE_GROUP "Rank 1-2 Fire Shūji"
                ^"Crackling Laughter" [shuji]
                ^"The Wind Blows Both Ways" [shuji]
            }
            RANK 3 {
                SKILL_GROUP "Scholar Skills"
                SKILL "Commerce"
                SKILL "Labor"
                SKILL "Seafaring"
                TECHNIQUE_GROUP "Rank 1-3 Water Shūji"
                ^"Artful Alibi" [ninjutsu]
                ^"All Arts Are One" [shuji]
            }
            RANK 4 {
                SKILL_GROUP "Martial Skills"
                SKILL "Command"
                SKILL "Skulduggery"
                SKILL "Survival"
                TECHNIQUE_GROUP "Rank 1-4 Kata"
                ^"Deceitful Strike" [ninjutsu]
                ^"Bravado" [shuji]
            }
            RANK 5 {
                SKILL_GROUP "Social Skills"
                SKILL "Martial Arts [Ranged]"
                SKILL "Martial Arts [Unarmed]"
                SKILL "Tactics"
                TECHNIQUE_GROUP "Rank 1-5 Air Shūji"
                ^"Silent Elimination" [ninjutsu]
                ^"Pin the Fan" [kata]
            }
            RANK 6 {
                ^"Victory Is the Greatest Honor"
            }
        }

    }

