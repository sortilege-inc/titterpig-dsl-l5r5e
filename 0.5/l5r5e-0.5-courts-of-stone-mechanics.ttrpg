                ^"Subtype" STRING "Close Combat Kata"
                ^"Rank" INTEGER 1
                ^"Activation" STRING "As an Attack action using one readied polearm"
                ^"Check" STRING "you may make a TN 2 Martial Arts [Melee] check targeting one character at range 1–2."
                ^"Effect" STRING "If you succeed, your target suffers the Prone condition."
                ^"Opportunities" STRING "(op): If you succeed, the target receives 2 fatigue and 2 strife.\n\n(op)+: If your target's vigilance is lower than or equal to (op) spent this way, they suffer the Disoriented condition."
            }

            #cDbAMAQXK62rg7z9Ukui16 ^"Pole-Vault" DEF {
                ^"Type" STRING "Kata"
                ^"Subtype" STRING "Close Combat Kata"
                ^"Rank" INTEGER 3
                ^"Activation" STRING "As an Attack and Movement action using one readied polearm"
                ^"Check" STRING "you may make a TN 3 Martial Arts [Melee] (Air or Water) check targeting one character at range 3–4."
                ^"Effect" STRING "You move to range 2 of your target, ignoring the effects of any terrain you pass over. You may also pass over impassable terrain such as small ravines and low walls if your GM permits.\n\nIf you succeed, you deal physical damage to the target equal to the weapon's base damage plus your bonus successes.\n\nIf you fail with a shortfall of 2 or more, you suffer the Prone condition, and receives 2 fatigue and 2 strife."
            }

            # --- NINJUTSU ---

            #Es1g6AuSSFtjwtR31ip4WH ^"Artful Alibi" DEF {
                ^"Type" STRING "Ninjutsu"
                ^"Rank" INTEGER 3
                ^"Activation" STRING "When you make a Skulduggery check to surveil or engage in other clandestine activities during downtime"
                ^"Opportunities" STRING "Air or Water (op)+: If you succeed, you also count as having made a successful downtime Composition or Design check to refine (Air) or adapt (Water) an item, with one bonus success per (op) spent this way."
            }

            #Qn6sd7DhqXTEILS10BKK3v ^"Cunning Distraction" DEF {
                ^"Type" STRING "Ninjutsu"
                ^"Rank" INTEGER 2
                ^"Activation" STRING "As a Scheme action during a duel or clash"
                ^"Check" STRING "TN 2 Skulduggery check targeting one character engaged in the duel or clash"
                ^"Effect" STRING "Performing this action is cheating. Any character observing or engaging in the duel or clash with a vigilance of 2 or higher spots the cheating.\n\nIf you succeed, during the next round of the duel or clash, both characters engaged in the duel or clash swap their initiative order."
                ^"Opportunities" STRING "(op)+: The vigilance required to spot the cheating is increased by 1 per (op) spent this way."
            }

            #NXydbzeaKMEtboyvd8ZXGZ ^"Deceitful Strike" DEF {
