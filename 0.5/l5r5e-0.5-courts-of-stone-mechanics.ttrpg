    }

    # ===========================
    # OPTIONAL RULES: TRIFLING BREACHES & SMALL SACRIFICES
    # ===========================

    # source (page 134)
    #OKArwCdfylksh5Ok7IZw8y ^"Courtesy Honor Rules" DEF {
        APPLIES TO [#L5R003xY4zA6bC8dE0fG2hI ^"Samurai"]

        #cWkeBXJ5JwxhOaxJmqydOD ^"Trifling Breaches" DEF {

            RULES {
                #Lrin0E9afDhuxEJmU44oTt: trifling_breaches_of_courtesy "Trifling Breaches: When a character wishes to commit a breach of Courtesy that is judged to be less serious than a minor breach, they must first forfeit 1 honor.\n\nExamples of trifling breaches of Courtesy:\n\nCursing or using disrespectful language in the presence of someone of higher status.\n\nPublicly and explicitly discussing your finances or mercantile pursuits.\n\nForgetting the specifics of a minor societal ritual in the presence of someone of higher status (turning your teacup the wrong direction or using an improper form of address)."
            }
        }

        #R9YYAMCo7pZOcF1teGmhXG ^"Small Sacrifices" DEF {

            RULES {
                #dyECCKsmyFE7VPHKE0vGdh: small_sacrifices_of_courtesy "Small Sacrifices: When a character makes a sacrifice in the name of Courtesy, but it is judged to be less significant than a minor sacrifice, they are awarded 1 honor.\n\nExamples of small sacrifices of Courtesy:\n\nPaying an honest compliment to an enemy during battle.\n\nLetting a serious insult (one that requires you to forfeit 1 or more glory to ignore) to your person pass."
            }
        }

        RULES {
            #YLXM9XOdIZXCIYKJOj3LpX: trifling_breaches_and_small_sacrifices_of_courtesy "Trifling Breaches and Small Sacrifices: In the Legend of the Five Rings core rulebook, there are guidelines for gaining honor for virtuous deeds, as well as guidelines for forfeiting honor in order to act disgracefully. However, minor acts can affect one's honor as well. A samurai ideally adheres to Bushidō in all aspects of their life, and many small positive or negative demonstrations eventually add up.\n\nWhat follows are optional additions to Table 7–1: Honor and Glory Forfeits/Awards on page 300 of the core rulebook and to the examples related to Courtesy on pages 302 of the core rulebook."
        }
    }

    # ===========================
    # OPPORTUNITY TABLES FOR INTRIGUE GAMES
    # ===========================

    # source (page 132)
    #i3sS4U462ce71k9ya5S0JX ^"Intrigue Opportunity Tables" DEF {
        APPLIES TO [#L5R003xY4zA6bC8dE0fG2hI ^"Samurai"]

        #XZ5lLUpBII4QsrceYeK69j ^"Spending Opportunity in Negotiations" DEF {
            ENTRIES {
                #yNtsTA7DdBPIEzUNx2lWjp ^"Air (op)(op)+" DEF {
                    ^"Effect" STRING "Your careful verbal trap ensnares someone in a position in which they must either give up ground or give you a boon. They must offer you a minor concession unrelated to your current social objective unless they give up 1 momentum point per (op) (op) spent this way."
                }
                #hyh8MOgcA2gNpA8jwHo45R ^"Earth (op)(op)(op)" DEF {
                    ^"Effect" STRING "Your uncompromising dedication to your bottom line stalls the conversation. Choose a character in the scene: that character cannot gain momentum points toward any social objective until the end of your next turn."
                }
                #n03r0nt2NybZXMeljGCfvJ ^"Fire (op)(op)" DEF {
                    ^"Effect" STRING "You set someone else on the defense with fast-paced questions and demands. Choose a demand or statement another character in the scene has made. Their player (or the GM, for NPCs) must tell you any hidden motivations behind that demand or statement."
                }
                #Im4ITlhjnHOVhgG7XzcHuD ^"Water (op)(op)" DEF {
                    ^"Effect" STRING "You break the tension with a well-timed joke or clever comment. You may ask one personal question of a character in the scene with a different social objective. The question must be unrelated to the subject of the negotiations. If the character answers honestly, they gain 1 momentum point toward their current objective and may ask you a personal question in turn. If they do, you gain 1 momentum point toward your current objective."
                }
                #xU0aWPJC9FKXcfjN3SvElt ^"Void (op)(op)(op)" DEF {
                    ^"Effect" STRING "You briefly shake someone's conviction with a deep insight into their character or circumstances, causing them to speak without certainty. Until the end of your next turn, any momentum points they score are added to your current social objective instead of to their own."
                }
            }
        }

        #SyY847dWsq07Ru9ha3LCfX ^"Spending Opportunity in Romance" DEF {
            ENTRIES {
                #pAlXfRh3rKsc5l6BExE0uK ^"Air (op)(op)" DEF {
                    ^"Effect" STRING "The conversation turns to mutual friends or acquaintances. Name a character you and your intended both know. They must tell you what they think of that character, revealing one of that person's advantages or disadvantages."
                }
                #d24Am8O2oDh1Kjzl9uL3NL ^"Earth (op)(op)" DEF {
                    ^"Effect" STRING "An offhand comment reveals that you and your intended share some common ground: an odd hobby, a favorite actor, or a core belief. Make three suggestions to your intended's player; they must tell you which one it is. You and your intended may each remove 2 strife."
                }
                #Dcx7P8HzRlHCQtcAC9Wp3q ^"Fire (op)(op)" DEF {
                    ^"Effect" STRING "A detail of your appearance catches your intended's interest. Their player must tell you which of your physical attributes they find most captivating. You and your intended each receive 1 strife, and you each reduce the TN of your next Social skill check by 1."
                }
                #uV0hsUQ4yZ45Iy6BE5u07h ^"Water (op)(op)" DEF {
                    ^"Effect" STRING "Your interaction is pleasant enough that your intended, not you, suggests another meeting within the next day or two. They offer you several options for the next time you and they spend personal time together; choose whichever you like the best, and don't be late."
                }
                #M9iasbyRU2IDvC9a75HVnT ^"Void (op)(op)(op)" DEF {
                    ^"Effect" STRING "Due to circumstances beyond your control—a gust of wind or an earth tremor, perhaps—you and your intended find yourselves unexpectedly aware of one another! Your intended decides what kind of contact it was, from a fateful meeting of the eyes to a brush of your hands against one another as you both reach for a dropped scroll. They also decide how they react, although they will not blame you for anything untoward (after all, it wasn't your fault)."
                }
            }
        }

        #pdBh6RoqAhNsoEJp48MpE8 ^"Spending Opportunity in Espionage" DEF {
            ENTRIES {
                #9ZzV49Xaq2SRfnyEFLMxG8 ^"Air (op)+" DEF {
                    ^"Effect" STRING "Your subtlety allows you to step out of sight of people, whether by hiding in a crowd or within convenient terrain. Designate a number of Minion NPCs equal to (op) spent this way or a single Adversary NPC with vigilance lower than or equal to (op) spent this way. Those characters lose sight of you (and do not notice your absence unless actively looking for you)."
                }
                #SDztLdZSNlsuldFGeR3Xvu ^"Earth (op)+" DEF {
                    ^"Effect" STRING "You locate an excellent hiding place, either a place where no one questions your cover identity or a concealed location no one checks. While hiding in this location, you reduce the TN of your checks to avoid notice by (op) spent this way."
                }
                #MxrAfJvksOXAX463EIgpLO ^"Fire (op)(op)(op)" DEF {
                    ^"Effect" STRING "A stray motion of yours catches the attention of a person or creature—but unexpectedly, they are sympathetic or helpful to you when they notice you. Who are they, and how do they offer to help? Do they think you are someone you're not?"
                }
                #yV5rEVGC4DJUZ8JqtChtJ1 ^"Water (op)" DEF {
                    ^"Effect" STRING "You observe a clue or hint that indicates to you that information about your target or goal might also be found elsewhere. The GM reveals another viable avenue for espionage on the same subject, unrelated to your current operation."
                }
                #M2PfHcmVXyt4YuvL1H05f0 ^"Void (op)" DEF {
                    ^"Effect" STRING "Your understanding of stealth clues you in on the possibility that you are not the first spy to pass this way. The GM reveals whether another spy has traversed your location and, if so, what trace they unwittingly left behind."
                }
            }
        }

        RULES {
            #r3JBEwLSWfjCUqak2NgdMA: spending_opportunity_in_winter_court_games "Spending Opportunity in \"Winter Court\" Games: The following tables give players and GMs additional options for (op) expenditures. GMs running Winter Court games or other intrigue-oriented games may use these tables to allow players additional means of spending (op) in their games, or as inspiration for new options of their devising. The tables may also be useful in any type of game for intrigue scenes (see page 254 of the core rulebook) such as arguments, romantic circumstances, and investigative challenges. Options are included for negotiation, romance, and espionage.\n\nIf an effect calls for a player to do something but the character is an NPC, the GM does so instead."
        }
    }
}
