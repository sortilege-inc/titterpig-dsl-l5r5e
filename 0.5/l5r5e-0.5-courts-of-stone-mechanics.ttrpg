                ^"Grips" STRING "1-hand: -"
                ^"Qualities" LIST OF STRING ["Durable", "Forbidden"]
                ^"Rarity" INTEGER 6
                ^"Cost" STRING "4 bu"
                ^"Special" STRING "When performing an Attack action with a tekagi, a character may spend (op) as follows:\n\n(op)+: If the target's vigilance is lower than or equal to (op) spent this way, choose one Razor-Edged weapon the target has readied: it becomes Damaged."
            }

            #rDCBCAOq4qMnVzJXAPvHOz ^"Tekken" DEF {
                ^"Category" STRING "Specialist"
                ^"Skill" STRING "Martial Arts [Unarmed]"
                ^"Range" STRING "0"
                ^"Damage" INTEGER 2
                ^"Deadliness" INTEGER 3
                ^"Grips" STRING "1-hand: -"
                ^"Qualities" LIST OF STRING ["Concealable", "Durable"]
