    # ===========================
    # SHINOBI ARMOR
    # ===========================

    # source (page 112)
    #UIzg422Oj3yX72w9obinzK ^"Courts of Stone Armor" DEF {
        APPLIES TO [#L5R003xY4zA6bC8dE0fG2hI ^"Samurai"]

        ENTRIES {
            #mDPBX8LKxLuqpPlSu3yS7p ^"Firefighter's Coat" DEF {
                ^"Physical Resistance" INTEGER 2
                ^"Qualities" LIST OF STRING ["Cumbersome"]
                ^"Rarity" INTEGER 4
                ^"Cost" STRING "6 bu"
                ^"Special" STRING "While wearing a firefighter's coat, a character ignores the effects of Dangerous terrain created by fire and treats their resistance against flames (physical and supernatural) as 4."
            }

            #kYdNFF6JWlbdz6OWyjfWsn ^"Stealth Clothing" DEF {
                ^"Physical Resistance" INTEGER 2
                ^"Qualities" LIST OF STRING ["Forbidden", "Subtle"]
                ^"Rarity" INTEGER 7
                ^"Cost" STRING "4 bu"
                ^"Special" STRING "This apparel is reversible. One side is dyed a dark color to blend in with darkness and mask blood or other stains; it is commonly rust red, but almost any dark hue (other than black, which blends poorly with most shadows) will do. The other side is a brighter color that matches the daytime surroundings of the mission: blue when operating near water, brown or green for forests, white for snow, and so forth.\n\nWhile a character is wearing stealth clothing set to the appropriate side and in Obscuring terrain, they increase the TN of Attack checks targeting them by an additional 1 (for a total of +2)."
            }
        }

    }

    # ===========================
    # TITLES
    # ===========================

    # source (pages 128-131)
    #01WmfXNaXMSEFGNhuu1fLs ^"Courts of Stone Titles" DEF {
        APPLIES TO [#L5R003xY4zA6bC8dE0fG2hI ^"Samurai"]

        ENTRIES {
            #DawvxEXxNiCBGui2ksMDK1 ^"Castellan" DEF {
                ^"Assigned By" STRING "A daimyō after putting the character in charge of the day-to-day management of a castle. A castle can have a single castellan."
                ^"Status Award" STRING "+5 (to a maximum of 30)"
                ^"Glory Award" STRING "+10 (to a maximum of 60)"
                ^"XP to Completion" INTEGER 20
                ^"Title Ability" STRING "Every Stone Has its Place"
                ^"Title Ability Effect" STRING "When undertaking a downtime activity to prepare your castle for an important event (a wedding, a battle, or a Winter Court, for example), you may change all rolled blank results to (op) results."
                ^"Advancement" LIST OF STRING [
                    "Social Skills (Skill Group)",
                    "Culture (Skill)",
                    "Design (Skill)",
                    "Government (Skill)",
                    "Rallying Cry (shuji)",
                    "Slippery Maneuvers (shuji)",
                    "Touchstone of Courage (shuji)"
                ]
            }

            #CBDhjhaznK7lXRdzIcciJP ^"Covert Agent" DEF {
                ^"Assigned By" STRING "Any individual who gives the character a task that requires them to act against the interests of their sworn lord (or falsely enter the service of another lord)."
                ^"Honor Award" STRING "-10 (to a minimum of 25)"
                ^"XP to Completion" INTEGER 20
                ^"Immediate Effects" STRING "Gain the Dark Secret disadvantage"
                ^"Title Ability" STRING "Practiced Prevaricator"
                ^"Title Ability Effect" STRING "When you make a check to deceive or hide from someone, you may negate up to 2 (st) symbols."
                ^"Advancement" LIST OF STRING [
                    "Social Skills (Skill Group)",
                    "Meditation (Skill)",
                    "Artful Alibi (ninjutsu)",
                    "Cadence (shuji)",
                    "Cunning Distraction (ninjutsu)",
                    "To Float or Sink (ninjutsu)",
                    "What's Yours Is Mine (ninjutsu)"
                ]
            }

            #8sOSwOmuEMswK9LG6H3d9g ^"Dreaded Enforcer" DEF {
                ^"Assigned By" STRING "A lord after they assign the character to assassinate or otherwise remove someone of Status 60 or higher—and the character succeeds!"
                ^"Honor Award" STRING "-10 (to a minimum of 5)"
                ^"Glory Award" STRING "-20 (to a minimum of 15)"
                ^"XP to Completion" INTEGER 40
                ^"Immediate Effects" STRING "Gain the Whispers of Cruelty disadvantage"
                ^"Title Ability" STRING "Merciless Eyes"
                ^"Title Ability Effect" STRING "When making a check to plan an assassination or attack with lethal intent, you may negate up to 2 (st) symbols."
                ^"Advancement" LIST OF STRING [
                    "Martial Skills (Skill Group)",
                    "Medicine (Skill)",
                    "Skulduggery (Skill)",
                    "Deceitful Strike (ninjutsu)",
                    "Like a Ghost (ninjutsu)",
                    "Silent Elimination (ninjutsu)",
                    "The Stillness of Death (ninjutsu)"
                ]
            }

            #DDyXqicBB916vL8qoiBdWc ^"Esteemed Negotiator" DEF {
                ^"Assigned By" STRING "A daimyō or other individual of status 50 or higher who requests the character specifically as a mediator for a political problem (and the character's lord assents to this assignment)."
                ^"Glory Award" STRING "+10 (to a minimum of 65)"
                ^"XP to Completion" INTEGER 34
                ^"Title Ability" STRING "Calming Words"
                ^"Title Ability Effect" STRING "Once per scene, as a Scheme and Support action, you may reduce the strife of all characters in the scene by your ranks in Sentiment."
                ^"Advancement" LIST OF STRING [
                    "Social Skills (Skill Group)",
                    "Culture (Skill)",
                    "Government (Skill)",
                    "Sentiment (Skill)",
                    "Rank 1-3 Earth Shūji (shuji) (Tech Group)",
                    "The Ties that Bind (ritual)",
                    "Treaty Signing (ritual)"
                ]
            }

            #t3wbGE4jkSR9YWSCAjhyRk ^"Kenshinzen" DEF {
                ^"Assigned By" STRING "Two existing kenshinzen, after witnessing the character defeating a kenshinzen in a duel. The character must also have an honor attribute of 65 or higher."
                ^"Glory Award" STRING "+20 (to a maximum of 75)"
                ^"XP to Completion" INTEGER 24
                ^"Title Ability" STRING "A Single Moment"
                ^"Title Ability Effect" STRING "When you perform an Attack action that uses a sheathed Razor-Edged weapon, you may spend (op) as follows:\n\nVoid (op) (op): Your target cannot defend against the damage from this Attack action unless they spend a Void point.\n\nAny (op): After you perform this action, you may sheathe the weapon you used."
                ^"Advancement" LIST OF STRING [
                    "Martial Skills (Skill Group)",
                    "Social Skills (Skill Group)",
                    "Culture (Skill)",
                    "Sentiment (Skill)",
                    "Rank 1-5 Close Combat Kata (kata) (Tech Group)",
                    "Rank 1-5 Void Shūji (shuji) (Tech Group)",
                    "Tea Ceremony (ritual)"
                ]
            }

            #dQYSnpCr8xbSZ4JVeGPx9o ^"Kyuden Asako Shieldbearer" DEF {
                ^"Assigned By" STRING "The commander of the Kyūden Asako Shieldbearers when the character joins their ranks."
                ^"Glory Award" STRING "+5 (to a maximum of 55)"
                ^"XP to Completion" INTEGER 40
                ^"Title Ability" STRING "Time-Tested Defense"
                ^"Title Ability Effect" STRING "After an Attack action check targeting you fails, the attacker suffers strife equal to their shortfall."
                ^"Advancement" LIST OF STRING [
                    "Scholar Skills (Skill Group)",
                    "Martial Arts [Melee] (Skill)",
                    "Martial Arts [Ranged] (Skill)",
                    "Meditation (Skill)",
                    "Tactics (Skill)",
                    "Rank 1-3 Kata (kata) (Tech Group)",
                    "Cleansing Rite (ritual)"
                ]
                ^"Special Equipment" STRING "When a character is inducted into the ranks of the Shieldbearers, the GM can see that they are gifted with a small bronze shield. These have the following profile (Range 0, Damage 2, Deadliness 2, Cumbersome, Durable, Wargear). When a character has a readied small bronze shield, treat their physical resistance as 5. As a Movement and Support action, if a character has a shield readied, they may increase the TN of Attack action checks made targeting them by 1. This persists until the start of their next turn."
            }

            #vjy7ijED6zppsSOtQ77hAX ^"Master Artisan" DEF {
                ^"Assigned By" STRING "Someone of status 75 or higher after the character performs a great artistic feat"
                ^"Glory Award" STRING "+30 (to a maximum of 80)"
                ^"XP to Completion" INTEGER 60
                ^"Title Ability" STRING "Inspired Creations"
                ^"Title Ability Effect" STRING "When crafting an item, you may spend (op) as follows:\n\n(op) (op) (op): The item you create is a singular masterwork. You must give it a name befitting its status. Once per game session when making a check that uses the item, a character may add 1 (ring) set to any result of their choice."
                ^"Advancement" LIST OF STRING [
                    "Artisan Skills (Skill Group)",
                    "Courtesy (Skill)",
                    "Culture (Skill)",
                    "Medicine (Skill)",
                    "Meditation (Skill)",
                    "All Arts Are One (shuji)",
                    "Formal Tea Ceremony (ritual)"
                ]
            }

            #TOKFE9W2BTylk2hb5BnXGG ^"Winter Court Champion" DEF {
                ^"Assigned By" STRING "The Emperor or one of their chosen agents after a character wins one of the major contests at a Winter Court."
                ^"Glory Award" STRING "+20 (to a maximum of 75)"
                ^"XP to Completion" INTEGER 16
                ^"Title Ability" STRING "Accustomed to Attention"
                ^"Title Ability Effect" STRING "When making a check to boast or get people's attention, you may negate up to 2 (st) symbols."
                ^"Advancement" LIST OF STRING [
                    "Artisan Skills (Skill Group)",
                    "Social Skills (Skill Group)",
                    "Artisan's Appraisal (shuji)",
                    "Formal Tea Ceremony (ritual)",
                    "Fun and Games (shuji)",
                    "Offend the Sensibilities (shuji)",
                    "Spiteful Loss (shuji)"
                ]
            }

            #fJH7BSJaKZ5fLr9ck6g6lZ ^"Seven Fold Palace Acolyte" DEF {
                ^"Assigned By" STRING "One of the masters of the Seven Fold Palace after the character begins studying there"
                ^"Glory Award" STRING "+5 (to a maximum of 35)"
                ^"XP to Completion" INTEGER 36
                ^"Title Ability" STRING "First, Forge Yourself"
                ^"Title Ability Effect" STRING "When you make a check to craft an item, you may suffer a number of fatigue up to your ranks in Fitness. If you do, change that many results containing (su) to (op) results."
                ^"Advancement" LIST OF STRING [
                    "Trade Skills (Skill Group)",
                    "Aesthetics (Skill)",
                    "Design (Skill)",
                    "Fitness (Skill)",
                    "Meditation (Skill)",
                    "Smithing (Skill)",
                    "Artisan's Appraisal (shuji)"
                ]
            }
        }

    }

    # ===========================
    # BONDS SYSTEM
    # ===========================

    # source stat block (page 136)
    #cKZSi6vIj6WazMSDgB6UWI ^"Bonds" DEF {
        APPLIES TO [#L5R003xY4zA6bC8dE0fG2hI ^"Samurai"]

        #oK4b03307btpnKGBH5IAqP ^"Bond Ranks" DEF {
            #KgV28EwqbZziQ2ezCuwzKw ^"Rank 1" DEF {
                ^"XP Cost" INTEGER 3
                ^"Ability" STRING "Bond Ability (Varies by Bond): In addition to any narrative benefits of your bond, you call upon your relationship with one bonded character in a manner based on the type of bond (see the bond ability for the relevant bond type on page 136)."
            }
            #86bc7rOp4Hsxum2LSQmPRH ^"Rank 2" DEF {
                ^"XP Cost" INTEGER 4
                ^"Ability" STRING "Like you always say…: You count as having one bonded character's assistance on a check in which the bonded character is skilled."
            }
            #s60bDXkUVDiRYDGpz1xmeR ^"Rank 3" DEF {
                ^"XP Cost" INTEGER 6
                ^"Ability" STRING "A familiar presence draws near…: If the bonded character is an NPC, you may play that character instead of your own character for the next scene (or in an establishing flashback or other appropriate scene, if that character is unavailable or deceased). Remember to adhere to that character's giri and ninjō while playing them. Major decisions on the part of that character must be approved by the GM. If the bonded character is a PC, you and that PC's player may immediately play out an establishing flashback scene that occurred between your characters in the past."
            }
            #8Ec837SvJiZLGf7kOMhzEe ^"Rank 4" DEF {
                ^"XP Cost" INTEGER 8
                ^"Ability" STRING "You taught me this!: Use one bonded character's ring or skill ranks (or skill group ranks, if they are an NPC) for a check instead of your own."
            }
            #oh9dnDABvhws0Hrudx71QI ^"Rank 5" DEF {
                ^"XP Cost" INTEGER 10
                ^"Ability" STRING "We are bound by this fate we have made!: Transfer one of your Void points to the bonded character or gain 1 Void point after they spend a Void point."
            }
        }

        #pHTRjHYaRBMBOUqGLjZHAL ^"Bond Types" DEF {
            #9PP21MdWLqSF9tvp643qrF ^"Family Bond" DEF {
                ^"Bond Ability" STRING "Strong Roots Grow Deep: Once per scene, you may call upon your bond to treat your composure as increased by your bond rank until the end of the scene."
            }
            #pGmfk7Wq12xvwBDPCNS4Qx ^"Comrade Bond" DEF {
                ^"Bond Ability" STRING "Just Like Old Times: When you perform a check using a skill for which the bonded character has 1 or more skill ranks (or if they are an NPC, for which they have 1 or more ranks in the relevant skill group), you may call upon your bond to negate a number of (st) results up to your bond rank."
            }
            #CyrnYiMyZEIYWW6UWAi5LT ^"Lover Bond" DEF {
                ^"Bond Ability" STRING "With You, the Storm Subsides: At the end of a scene involving your lover or reminders of them, you may call upon your bond to remove additional strife equal to your bond rank."
            }
            #s3Bhe9EFP9q6w3CdJgQhax ^"Rival Bond" DEF {
                ^"Bond Ability" STRING "I Will Surpass You!: While making a check, you may call upon your bond. Receive strife equal to your bond rank; you may reroll up to that many dice."
            }
            #gfGIkdiwrUZkyK9c6dnqWj ^"Nemesis Bond" DEF {
                ^"Bond Ability" STRING "They Were Responsible!: You may call upon your bond to determine if your nemesis was involved in a new situation you encounter, a new challenge you face, or new problem that presents itself. You ask the GM, and they should provide you with a clear answer, along with the clue or signature style you can use to determine their involvement. If the GM confirms that your nemesis was behind it, reduce the TN of your next check to address the problem by your bond rank."
            }
        }

        RULES {
            #cJ9zlzyDQ4oInRVJiqUv7C: bonds_new_way_to_spend_experience "Bonds: Bonds are a new way to spend experience points, reflecting the deepening of the connection between two people as they invest energy and emotion in one another. This is commonly done by spending time together, but it can also happen via letter writing, or even during times of separation, as long as the two are deeply connected. Bonds can take many forms. Friends can obviously have bonds, and so can lovers, family, and colleagues. However, rivals and even enemies can also have bonds that define their relationships; many samurai stories are driven by a character's desire to vanquish a specific foe, or to surpass a fellow warrior whose strength inspires them to obsession."
            #VCQFBE5FeLiPccjYkHYqmE: forging_and_advancing_a_bond "Forging and Advancing a Bond: If the GM has chosen to include bonds in the campaign, a player may request to have their character forge or advance a bond with someone else by spending experience. The GM decides if the bond makes sense, and if they agree, the player may spend experience to form a bond or to advance an existing bond. If two or more PCs are forging or advancing a bond, each PC must individually spend the full amount of XP for the bond at the same time (as they all gain its benefits). Experience spent on bonds does not contribute toward a character's current school curriculum rank or to a title."
        }
    }

    # ===========================
    # NEW SAMURAI HERITAGES
    # ===========================

    # source (page 104)
    #KkQVD4XJCMDckrB2u4daNJ ^"Courts of Stone Heritages" DEF {
        APPLIES TO [#L5R003xY4zA6bC8dE0fG2hI ^"Samurai"]

        HERITAGE_TABLE {

            1 #v4pzleB1tNtdgU1XO9iCEx ^"Dishonorable Cheat" DEF {

                MODIFIERS {
                    ^"Glory" "-5"
                }

                EFFECT {
                    "Roll a ten-sided die to determine a skill to aid you in bringing your disgraced kin to justice (1–3: Martial Arts [Choose One], 4–6: Survival, 7–10: Government)."
                }

                SUB_TABLE "1d10" {
                    "1-3" "Gain +1 ^\"Martial Arts [Choose One]\""
                    "4-6" "Gain +1 ^\"Survival\""
                    "7-10" "Gain +1 ^\"Government\""
                }
            }

            2-3 #s0sUwIEvvlrRubJEwMn8PO ^"Triumph over the Lion" DEF {

                MODIFIERS {
                    ^"Honor" "+5"
                }

                EFFECT {
                    "Roll a ten-sided die and add the resulting family heirloom to your starting items (1–3: a weapon, 4–6: a game set of your choice, 7–8: some other item relevant to your ancestor's victory, 9: a horse or another animal, 10: the deed to a small piece of land on the border of Lion territory). You choose one quality and the GM chooses one quality from the list of item qualities, on page 240 of the core rulebook; these are applied to the item."
                }

                SUB_TABLE "1d10" {
                    "1-3" "A weapon"
                    "4-6" "A game set of your choice"
                    "7-8" "some other item relevant to your ancestor's victory"
                    "9" "A horse or another animal"
                    "10" "the deed to a small piece of land on the border of Lion territory"
                }
            }

            4-5 #f4DhOygATi36KX70HPMmnW ^"Unforgivable Performance" DEF {

                MODIFIERS {
                    ^"Status" "-3"
                }

                EFFECT {
                    "You gain the ^\"Benten's Curse (Air)\" disadvantage (see page 116 of the core rulebook). Roll a ten-sided die to determine a skill that will help redeem your family (1–3: Performance, 4–6: Culture, 7–9: Command, 10: Courtesy)."
                }

                SUB_TABLE "1d10" {
                    "1-3" "Gain +1 ^\"Performance\""
                    "4-6" "Gain +1 ^\"Culture\""
                    "7-9" "Gain +1 ^\"Command\""
                    "10" "Gain +1 ^\"Courtesy\""
                }
            }

            6-7 #IE4tFxWFofbGuImnBkFxlI ^"Triumph During Gempuku" DEF {

                MODIFIERS {
                    ^"Honor" "+3"
                    ^"Glory" "+3"
                }

                EFFECT {
                    "You gain the ^\"Support of the Kakita Dueling Academy\" distinction, where the Topaz Championship takes place."
                }
            }

            8-9 #vzCnLJmsIrSOsRx7N3erZs ^"A Little Too Close to Heaven" DEF {

                MODIFIERS {
                    ^"Status" "+5"
                    ^"Honor" "-5"
                }

                EFFECT {
                    "Roll a ten-sided die to determine a skill that can aid you in discovering the truth about your lineage (1–2: Government, 3–4: Commerce, 5–6: Sentiment, 7–8: Meditation, 9–10: Theology)."
                }

                SUB_TABLE "1d10" {
                    "1-2" "Gain +1 ^\"Government\""
                    "3-4" "Gain +1 ^\"Commerce\""
                    "5-6" "Gain +1 ^\"Sentiment\""
                    "7-8" "Gain +1 ^\"Meditation\""
                    "9-10" "Gain +1 ^\"Theology\""
                }
            }

            10 #GJzMXJAC0TdPMBdtGDaT4e ^"Elegant Craftsman" DEF {

                MODIFIERS {
                    ^"Glory" "+5"
                }

                EFFECT {
                    "Gain the ^\"Isolation\" anxiety (page 103)"
                    "Choose one of your character's rings; you may reduce the value of this ring by 1 to increase the value of your Fire or Air Ring by 1 (this still cannot raise it above 3)"
                }
            }
        }

        RULES {
            #Xi36GKxGlFOA5fQM1IShp4: new_samurai_heritages "New Samurai Heritages: A variety of unique heritages arise from having a bloodline derived—at least in part—from the Crane. This is true even for non-Crane characters, who may bear Crane blood because of the marriage of members of that clan into their family lineage. There are also more mysterious heritages that might apply, if the family has some involvement in the secretive lives of shinobi.\n\nTable 2—1: New Samurai Heritages represents these backgrounds when creating a new samurai PC who has ancestral connections with the Crane Clan or to the mysterious underworld of the shinobi. This table can be used instead of Table 2—1: Samurai Heritages on page 96 of the core rulebook, and is used in the same manner."
            #BKIgZsdU7pZPNEFf4uqKJX: dishonorable_cheat "Dishonorable Cheat: One of your kin was caught cheating in a high-profile duel. Instead of committing seppuku to purge their dishonor and redeem their family, they ran away and became a rōnin, disgracing their bloodline."
            #uCl4mwT4N8orr1bKtvBiYr: triumph_over_the_lion "Triumph over the Lion: In your family line one of your ancestors held a decisive victory over the Lion. It may have been a duel, a critical game of Go, a battle, or any number of things. The circumstances are irrelevant; the Lion were embarrassed, and your ancestor brought honor to your clan."
            #Q932mQGS63MovsT0SykcOv: unforgivable_performance "Unforgivable Performance: In the recent past one of your kin gave a truly horrible performance in the presence of the Imperial line. Through their embarrassing acting in a scene they caused the Emperor to leave the theatre and now rumors abound of your family being cursed by the Fortunes for such a failure."
            #rsbIhK3ZDFywoNe7JtOkdy: triumph_during_gempuku "Triumph During Gempuku: One of your parents was a Topaz Champion and brought honor to your clan and your family."
            #DPwLeeuMEcImlu9fXMT9vC: a_little_too_close_to_heaven "A Little Too Close to Heaven: One of your ancestors is rumored to have had an illegitimate child with an Emperor. While you may be able to link your heritage to the Imperial line, the disgrace of such an affair stains this joy."
            #LjhGJvLY2tQVqbhSO8Kas6: elegant_craftsman "Elegant Craftsman: Your ancestor was a truly gifted artisan and produced in their lifetime a masterwork that is still renowned today. You now live in the shadow of this ancestor, and your clan expects your complete focus in bringing glory to your line once again."
        }
    }

