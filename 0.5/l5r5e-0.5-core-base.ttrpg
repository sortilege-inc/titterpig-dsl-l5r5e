BASE "L5R5e_Core_Core" {
    NAME "Legend of the Five Rings 5th Edition - Core mechanics, ACTORs, and fundamental game rules"
    VERSION "0.5.4"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-03-01"

    # Core Rulebook: Legend of the Five Rings Roleplaying Game (FFG, 2018)
    # Roll-and-keep system using custom Ring dice (d6) and Skill dice (d12)

    #L5R001aB2cD4eF6gH8iJ0kL ACTOR "Entity" DEF {
        # The root of all actor types in L5R 5e
        # All ACTORs ultimately extend from Entity

        PROPERTIES {
            ^"Name" STRING REQUIRED
            ^"Description" STRING
            ^"Rings" DEF {
                ^"Air" INTEGER MIN 1 MAX 5 DEFAULT 1
                ^"Earth" INTEGER MIN 1 MAX 5 DEFAULT 1
                ^"Fire" INTEGER MIN 1 MAX 5 DEFAULT 1
                ^"Water" INTEGER MIN 1 MAX 5 DEFAULT 1
                ^"Void" INTEGER MIN 1 MAX 5 DEFAULT 1
            }
        }

        RULES {
            #L5R002mN3oP5qR7sT9uV1w: WHEN [^"Entity" CREATED] THEN REQUIRE ^"Name"
        }
    }

    #L5R003xY4zA6bC8dE0fG2hI ACTOR "Samurai" DEF {
        EXTENDS #L5R001aB2cD4eF6gH8iJ0kL ^"Entity"

        # Player characters and significant NPCs in Rokugan
        # Samurai are the primary character type: warriors, courtiers,
        # priests, and monks serving their lords and the Empire

        PROPERTIES {
            ^"Clan" STRING REQUIRED
            ^"Family" STRING REQUIRED
            ^"School" STRING REQUIRED
            ^"School Rank" INTEGER MIN 1 MAX 6 DEFAULT 1
            ^"Skills" LIST OF #L5R199uV8wX0yZ2aB4cD6e ^"Skill"
            ^"Techniques" LIST OF #L5R350fG9hI1jK3lM5nO7p ^"Technique"
            ^"Advantages" LIST OF #L5R263hI5jK7lM9nO1pQ3r ^"Advantage"
            ^"Disadvantages" LIST OF #L5R264sT6uV8wX0yZ2aB4c ^"Disadvantage"
            ^"Honor" INTEGER MIN 0 MAX 100
            ^"Glory" INTEGER MIN 0 MAX 100
            ^"Status" INTEGER MIN 0 MAX 100
            ^"Endurance" INTEGER MIN 0
            ^"Composure" INTEGER MIN 0
            ^"Focus" INTEGER MIN 0
            ^"Vigilance" INTEGER MIN 0
            ^"Fatigue" INTEGER MIN 0 DEFAULT 0
            ^"Strife" INTEGER MIN 0 DEFAULT 0
            ^"Void Points" INTEGER MIN 0
            ^"Ninjō" STRING  # Personal desire
            ^"Giri" STRING   # Sworn duty
            ^"Demeanor" STRING
            ^"Equipment" LIST OF STRING
            ^"Roles" LIST OF STRING       # School roles (Bushi, Courtier, Shugenja, Monk, Shinobi, etc.)
            ^"Titles" LIST OF #L5R463nO5pQ7rS9tU1vW3x ^"Title"    # Earned titles
            ^"Bonds" LIST OF #L5R262wX4yZ6aB8cD0eF2g ^"Bond"      # Per Courts of Stone bonds system
            ^"Bushido" DEF {
                ^"Paramount Tenet" STRING  # Most important tenet
                ^"Less Significant Tenet" STRING  # Least important tenet
            }
            ^"Experience" INTEGER MIN 0 DEFAULT 0  # XP earned/spent
        }

        RULES {
            #L5R004jK5lM7nO9pQ1rS3t: WHEN [^"Samurai" CREATED] THEN REQUIRE ^"Clan", ^"School"
            #L5R005uV6wX8yZ0aB2cD4e: WHEN [^"Strife" > ^"Composure"] THEN ^"Samurai" IS compromised
            #L5R006fG7hI9jK1lM3nO5p: WHEN [^"Fatigue" > ^"Endurance"] THEN ^"Samurai" IS incapacitated
        }
    }

    #L5R007qR8sT0uV2wX4yZ6a ACTOR "Peasant" DEF {
        EXTENDS #L5R001aB2cD4eF6gH8iJ0kL ^"Entity"

        # Non-samurai: farmers, merchants, craftspeople, entertainers
        # The vast majority of Rokugan's population

        PROPERTIES {
            ^"Rings" DEF {
                ^"Air" INTEGER MIN 1 MAX 5 DEFAULT 1
                ^"Earth" INTEGER MIN 1 MAX 5 DEFAULT 1
                ^"Fire" INTEGER MIN 1 MAX 5 DEFAULT 1
                ^"Water" INTEGER MIN 1 MAX 5 DEFAULT 1
                ^"Void" INTEGER MIN 1 MAX 5 DEFAULT 1
            }
            ^"Skills" LIST OF #L5R199uV8wX0yZ2aB4cD6e ^"Skill"
            ^"Endurance" INTEGER MIN 0
            ^"Composure" INTEGER MIN 0
        }

        RULES {
            #L5R008bC9dE1fG3hI5jK7l: WHEN [^"Peasant" INTERACTS with ^"Samurai"] THEN USE simplified mechanics
        }
    }

    #L5R009mN0oP2qR4sT6uV8w ACTOR "Adversary" DEF {
        EXTENDS #L5R001aB2cD4eF6gH8iJ0kL ^"Entity"

        # NPCs, creatures, and supernatural beings used by the GM
        # Adversary profiles include combat and intrigue conflict ranks

        PROPERTIES {
            ^"Combat Conflict Rank" INTEGER MIN 0 MAX 20
            ^"Intrigue Conflict Rank" INTEGER MIN 0 MAX 20
            ^"Rings" DEF {
                ^"Air" INTEGER MIN 1 MAX 5
                ^"Earth" INTEGER MIN 1 MAX 5
                ^"Fire" INTEGER MIN 1 MAX 5
                ^"Water" INTEGER MIN 1 MAX 5
                ^"Void" INTEGER MIN 1 MAX 5
            }
            ^"Skills" LIST OF #L5R199uV8wX0yZ2aB4cD6e ^"Skill"
            ^"Endurance" INTEGER MIN 0
            ^"Composure" INTEGER MIN 0
            ^"Focus" INTEGER MIN 0
            ^"Vigilance" INTEGER MIN 0
            ^"Advantages" LIST OF #L5R263hI5jK7lM9nO1pQ3r ^"Advantage"
            ^"Disadvantages" LIST OF #L5R264sT6uV8wX0yZ2aB4c ^"Disadvantage"
            ^"Techniques" LIST OF #L5R350fG9hI1jK3lM5nO7p ^"Technique"
            ^"Demeanor" STRING
            ^"Favored Weapons" LIST OF STRING
        }

        RULES {
            #L5R010xY1zA3bC5dE7fG9h: WHEN [^"Adversary" ENTERS conflict] THEN USE ^"Combat Conflict Rank" OR ^"Intrigue Conflict Rank"
        }
    }

    #t4540de6f35155c46f41f0 ^"NPC" DEF {
        # Metatype anchor for non-player character definitions
    }

    #t2513b5e05d845f4411465 ^"NPC Template" DEF {
        # Metatype anchor for NPC template overlay definitions
    }

    #L5R011iJ2kL4mN6oP8qR0s ACTOR "Minion" DEF {
        EXTENDS #L5R009mN0oP2qR4sT6uV8w ^"Adversary"

        RULES {
            #L5R012tU3vW5xY7zA9bC1d: minion_special_fatigue_handling "When a minion's fatigue exceeds its endurance, it is simply defeated. A defeated minion is slain if the source of damage that defeated it is 7 or higher; otherwise, it is non-lethally dispatched."
            #L5R012tU3vW5xY7zA9bC2e: minion_critical_strike_rules "If a minion would be dealt a critical strike, it receives fatigue equal to the severity instead."
            #L5R012tU3vW5xY7zA9bC3f: minion_opportunity_restrictions "The game runs most smoothly if minions only spend (op) on options listed in their abilities, but the GM may waive this at their discretion."
        }
    }

    #L5R013eF4gH6iJ8kL0mN2o ACTOR "Party" DEF {
        EXTENDS #L5R001aB2cD4eF6gH8iJ0kL ^"Entity"

        # A group of player characters traveling and adventuring together

        PROPERTIES {
            ^"Members" LIST OF #L5R003xY4zA6bC8dE0fG2hI ^"Samurai" REQUIRED
            ^"Shared Resources" LIST OF STRING
            ^"Current Location" STRING
        }

        RULES {
            #L5R014pQ5rS7tU9vW1xY3z: WHEN [^"Party" ESTABLISHED] THEN REQUIRE at least 2 ^"Members"
        }
    }

    # === DICE AND CHECK SYSTEM ===

    #sIJKm9Og6gaUSJUQptaUNZ ^"Ring Die" DEF {

        FACES {
            1 "Blank"
            2 "(op) (st)"
            3 "(op)"
            4 "(su) (st)"
            5 "(su)"
            6 "(ex) (st)"
        }

        RULES {
            #L5R015aB6cD8eF0gH2iJ4k: ring_die_pool_equals_ring_value "When making a check using a given ring, a player rolls a number of Ring dice ((ring)) equal to their value for that ring."
        }
    }

    #eoqgsYsNWTop3A1iMbyhQb ^"Skill Die" DEF {

        FACES {
            1 "Blank"
            2 "Blank"
            3 "(op)"
            4 "(op)"
            5 "(op)"
            6 "(su) (st)"
            7 "(su) (st)"
            8 "(su)"
            9 "(su)"
            10 "(su) (op)"
            11 "(ex) (st)"
            12 "(ex)"
        }

        RULES {
            #L5R017wX8yZ0aB2cD4eF6g: skill_die_pool_equals_skill_ranks "When making a check using a given skill, a player rolls a number of Skill dice ((skill)) equal to the number of ranks their character has in that skill."
        }
    }

    #t202588bb0b32758539464 ^"Dice Symbols" DEF {

        ENUM ["Success", "Explosive Success", "Opportunity", "Strife"]

        SYMBOL_DEFINITIONS {
            ^"Success (su)" "The success symbol ((su)) represents the sum total of the character's effort when they attempt to complete a task. More (su) symbols mean a higher chance of carrying out the task successfully."
            ^"Explosive Success (ex)" "The explosive success symbol ((ex)) represents a particularly effective part of the character's effort. In addition to counting as a (su) symbol, it gives the character a chance to roll an additional die and decide whether to add its result to the check—potentially letting them succeed at a task they normally couldn't overcome. See (ex) under Step 6: Resolve Symbols of Kept Dice, on page 24."
            ^"Opportunity (op)" "The opportunity symbol ((op)) does not contribute directly to success, but it lets the character resolve an opportunity—a chance to do or notice something useful that is unrelated to their goal at the outset, or expand on their success with an additional effect or story detail."
            ^"Strife (st)" "The strife symbol ((st)) represents an upwelling of emotion. Strife does not affect success or failure on the check but instead accumulates over time, potentially leading to outward displays of emotion that can alter the direction of the story for good or for ill. The more it accumulates, the harder it is to maintain the decorum expected of a samurai—a key struggle in the genre of samurai drama."
        }

        RESOLUTION_ORDER ["(ex)", "(st)", "(op)", "(su)"]

        RULES {
            #L5R019sT0uV2wX4yZ6aB8c: symbol_resolution_order "Step 6: Resolve Symbols on Kept Dice: After the dice pool has been reduced to only kept dice, the player resolves all symbols contained in the results of those dice. Symbols are resolved in the following order:"
            #L5R020dE1fG3hI5jK7lM9n: explosive_success_chain_rolling "(ex): For each (ex) symbol, the player rolls one additional die of the same type as the one containing the (ex) symbol. After rolling a die this way, the player chooses whether it will be kept (on top of their current results) or dropped. If the die is kept, the player resolves its result in addition to the results on the rest of the kept dice in the dice pool (including further (ex) symbols)."
            #L5R021oP2qR4sT6uV8wX0y: opportunity_narrative_effects "(op): The player may spend 1 or more (op) symbols to resolve opportunities. Opportunities are meant to prompt the player and the GM to invent and add extra effects, additional details, and narrative flourishes that occur independently of a check's success or failure (see Using Opportunity on page 28)."
            #L5R022zA3bC5dE7fG9hI1j: strife_accumulation_tracking "(st): For each (st) symbol, the character receives 1 strife. The character's player should record any strife their character receives on their character sheet. Strife has no immediate effect, but can have effects as it accumulates (see Using Strife on page 29)."
        }
    }

    #t7945706680f94a9e75d70 ^"Check" DEF {

        STEPS {
            1 "Declare Intention: When a character tries to accomplish something in the story, the GM may ask for a check. That character's player clearly explains what they want their character to accomplish."
            2 "Determine Details: Based on the description, the GM decides which skill and ring the player will roll, along with the target number of successes (TN) needed."
            3 "Assemble and Roll Dice Pool: First, the player picks up a number of Ring dice ((ring)) equal to their character's ring the GM chose. This can be found on the character sheet under Rings.\n\nNext, the player picks up a number of Skill dice ((skill)) equal to their character's ranks in the skill the GM chose.\n\nThen, the player rolls all of the dice together."
            4 "Modify Rolled Dice: The GM and player apply any effects that modify the dice, such as advantages and disadvantages that cause rerolls."
            5 "Choose Kept Dice: The player selects a number of dice up to their ring to keep."
            6 "Resolve Symbols on Kept Dice: The player resolves symbols from results of kept dice in the following order to determine the check's outcome:\n\nExplosive Success ((ex)): For each (ex), the player may roll 1 extra die of the type on which it appears and choose to keep or drop it.\n\nStrife ((st)): The character receives 1 strife per (st).\n\nOpportunity ((op)): Spend (op) to add story details.\n\nTotal Successes ((su) / (ex)): If total (su) and (ex) equal or exceed the TN, the character succeeds."
        }

        RULES {
            #L5R023kL4mN6oP8qR0sT2u: dice_pool_assembly "Step 3: Assemble and Roll Dice Pool: The player assembles the dice pool. The player picks up a number of Skill dice ((skill)) equal to the character's ranks in the selected skill and a number of Ring dice ((ring)) equal to the value of the character's ring that is associated with the selected approach. Then, the player rolls all of these dice. After they are rolled, the dice are called rolled dice."
            #L5R024vW5xY7zA9bC1dE3f: keep_limit_equals_ring_value "Step 5: Choose Kept Dice: After applying advantages and disadvantages, the player looks at the results and decides which of the rolled dice will become kept dice (those used in the resolution of the check) and which will become dropped dice (those that will be discarded with their results unused). The player must choose at least one die to keep, and can choose to keep a maximum up to the value of the ring the character used for the check. The player then removes all dropped dice.\n\nThen, any effects that modify kept dice are resolved."
            #L5R025gH6iJ8kL0mN2oP4q: success_threshold_comparison "(su): If the sum total of (su) and (ex) symbols equals or exceeds the target number of successes of the check, the character succeeds at the objective declared in Step 1: Declare Intention. If this total is less than the TN of the check, the character fails at the proposed feat instead."
            #L5R026rS7tU9vW1xY3zA5b: bonus_successes "Determining Bonus Successes: If a character succeeds on a check, their bonus successes are the number of (su) and (ex) symbols in excess of the target number of successes for the check."
            #L5R027cD8eF0gH2iJ4kL6m: shortfall_degree_of_failure "Determining Shortfall: If a character fails a check, their shortfall is the TN of the check minus the sum of their (su) and (ex) symbols."
        }
    }

    #t27f6687c632e46f015c24 ^"Target Number" DEF {

        INTEGER MIN 1 MAX 8

        DIFFICULTY_SCALE {
            1 "An easy task for most people, such as carrying half one's weight or finding a misplaced item."
            2 "An average task, such as jumping a ten-foot ditch or recognizing someone in disguise."
            3 "A difficult task, such as scaling a cliff without rope or finding a well-hidden object."
            4 "A very hard task, such as diving safely from the top of a waterfall or recalling someone's exact words years later."
            5 "An extremely hard task, such as stirring a demoralized army to action or hurling someone using only one hand."
            6 "An extraordinary task, such as discerning someone's whereabouts from the mud on their sandals or felling a tree with a single ax blow."
            7 "A heroic task, such as outwrestling a troll or naming all of one's ancestors in order."
            8 "A legendary task, such as shattering stone with one's bare hands or outwitting a Fortune."
        }

        RULES {
            #L5R028nO9pQ1rS3tU5vW7x: gm_sets_target_number "Determine Target Number of Successes: Finally, the GM selects a target number of successes (commonly referred to as a TN). It is the number of successes the character must achieve to succeed at the check. Except in special circumstances, the GM should announce the TN of the check to the player at this point (see When to Reveal or Conceal the TN, on page 297)."
        }
    }

    #ta2a3de96d67e6cfc017ed ^"Approach" DEF {

        ENUM ["Air", "Earth", "Fire", "Water", "Void"]

        RULES {
            #L5R030jK1lM3nO5pQ7rS9t: approach_determines_ring_used "Determine Approach: Next, the player provides a brief description of the methods their character employs to reach their goal. The GM selects the elemental approach (see page 142) that corresponds to reaching the original goal by the specific methods, or asks the player to pick a method. If multiple approaches are viable, the player should offer a rationale for the one they choose."
            #L5R031uV2wX4yZ6aB8cD0e: opportunity_themes_by_ring "(op) as a Narrative Tool: The other fundamental way to use (op) is to add a narrative detail that surfaces as the character undertakes the task—a new piece of information that their character notices which can create interesting new avenues for the story. The type of detail a character can add varies by ring along the following themes:\n\nAir (op): People's strengths and weaknesses, emotions, small details in objects\n\nEarth (op): The character's own memories, history of people and objects, defensive positions\n\nFire (op): People's motivations, flashes of insight, conspicuous absences\n\nWater (op): Environmental dangers, presence of useful terrain or objects, escape routes\n\nVoid (op): Supernatural presences, flashes of premonition, instinctive warnings"
        }
    }

    GUIDANCE {
        ENTRY ^"ring-approach-concepts" #L5RG06bC7dE8fG9hI0jK1l {
            CONCERNS [ #ta2a3de96d67e6cfc017ed ^"Approach" ]
            TOPICS [ "rings", "approaches" ]
            TEXT "Each ring corresponds with a set of methods that relate to the following concepts and are explored in more detail in Chapter 3: Skills (see page 140):\n\nAir: Grace, cunning, precision, subtlety\n\nEarth: Resilience, patience, memory, calm\n\nFire: Passion, invention, candor, ferocity\n\nWater: Flexibility, awareness, efficiency, charm\n\nVoid: Mysticism, intuition, instinct, wisdom"
        }
        ENTRY ^"checks-in-text" #L5RG07cD8eF9gH0iJ1kL2m {
            CONCERNS [ #t7945706680f94a9e75d70 ^"Check" ]
            TOPICS [ "reading the rules" ]
            TEXT "When a check appears in print, it often has a preset skill, ring, or TN, along with recommended modifiers that apply to certain situations. If it allows any ring, it will not list a ring; if it allows any skill within a group, it will list a group rather than a specific skill. If a check in print allows multiple rings, it will sometimes be followed by parentheses containing ring names and values, such as \"(Air 3, Water 1)\". These values are the TNs to use those rings."
        }
        ENTRY ^"matching-rings-with-skills" #L5RG08dE9fG0hI1jK2lM3n {
            CONCERNS [ #ta2a3de96d67e6cfc017ed ^"Approach" ]
            TOPICS [ "rings", "approaches" ]
            TEXT "The Five Rings are important philosophical concepts in Rokugan, and thus each ring says something important about a character. Rather than reflecting measurable mental or physical traits of a character, each ring represents an aspect of a character's personality, and their inclination toward certain ways of thinking, acting, and using the tools that their skills provide them. Thus, each ring can function alongside any skill, but each pairing reflects a different strategy and thus leads to a different outcome."
        }
        ENTRY ^"example-uses-of-opportunity" #L5RG09eF0gH1iJ2kL3mN4o {
            CONCERNS [ #t0be2b3f270d6247a9c35d ^"Opportunity" ]
            TOPICS [ "opportunity" ]
            TEXT "Beyond the narrative uses discussed here, an extensive list of example uses of (op) can be found in Table 8-1: Examples of (op) (see page 328). Players and GMs can use these directly, or as inspiration for their own new opportunities."
        }
        ENTRY ^"scaling-opportunity-effects" #L5RG10fG1hI2jK3lM4nO5p {
            CONCERNS [ #t0be2b3f270d6247a9c35d ^"Opportunity" ]
            TOPICS [ "opportunity", "scaling" ]
            TEXT "The opportunities described on this page can generally scale for effect, becoming more efficacious if additional (op) symbols are spent on them. For uses of (op) whose specific effects are spelled out in text, scaling is indicated with a \"+\" symbol, and opportunities in text without the \"+\" symbol do not scale. If the cost of an opportunity is \"(op)+,\" the character may spend 1 or more (op) when activating the effect. The effect then scales; the more (op) that was spent to activate it, the more impactful it becomes."
        }
        ENTRY ^"when-to-make-a-check" #L5RG13iJ4kL5mN6oP7qR8s {
            CONCERNS [ #t7945706680f94a9e75d70 ^"Check" ]
            TOPICS [ "when to make a check" ]
            TEXT "The GM gets to decide when it's worthwhile for a character to make a check. As a rule of thumb, the GM should consider the following questions: Could the character fail? Could the character possibly succeed? Are the consequences of success and failure interesting and meaningfully different? If the answer to any of these is \"no,\" the GM probably shouldn't ask for a check. The character can simply succeed at their action or fail at it, and the GM can work with the player to narrate the results in the story."
        }
        ENTRY ^"narrating-a-checks-results" #L5RG14jK5lM6nO7pQ8rS9t {
            CONCERNS [ #t7945706680f94a9e75d70 ^"Check" ]
            TOPICS [ "narration", "roleplaying" ]
            TEXT "A check is a mechanical activity, but it shouldn't be devoid of roleplaying, as it presents excellent opportunity to describe what your character is doing in the story. If the character succeeds on the check, their player gets to narrate the outcome of the success, within the confines of the intention described in Step 1: Declare Intention. For example, if a bushi (warrior) character succeeds at an Attack action their player declared and inflicts a lethal blow on their foe, the player can narrate how their character slashes upward with their katana, cutting through the robes of their adversary and into the soft flesh beneath. By contrast, if they fail, the player can still describe their strike, but instead give a description of why they failed. The GM might offer a reason as well—perhaps the foe's evasive footwork made them harder to hit than usual! The player can also think about the emotions that any strife they incurred represents, and may narrate this if they desire. Depending on the circumstances, the (st) they accumulated as part of the Attack action could represent their character's grief at being forced to cut down a loved one at their lord's order—or it might simply be the dull ache of killing yet another anonymous stranger in a world that does not seem to care how much blood is spilled. The narrative context of the check is key, and should define how players and GMs interpret a character's strife. Finally, the player gets the chance to interpret the (op) they spend as part of the check: they should indicate whether they want to spend it in a manner that steers the narrative in a direction interesting to them, in a way based on an example option appropriate to the ring used on the check, or in a manner provided by a special ability. Sometimes, the GM must approve or contribute to the interpretation of (op), such as if the character notices an important detail that might change the story or remember a relevant fact of the setting that their player does not know. Unspent (op) simply goes unused and has no effect. Table 8-1: Examples of (op), on page 328, provides a number of examples players can employ in a wide array of circumstances and use as guidelines for creating new ways to spend (op). The GM and players alike are encouraged to use these for inspiration, or when they simply want a quick option to keep play moving."
        }
        ENTRY ^"using-opportunity" #L5RG15kL6mN7oP8qR9sT0u {
            CONCERNS [ #t0be2b3f270d6247a9c35d ^"Opportunity" ]
            TOPICS [ "opportunity", "narration" ]
            TEXT "Opportunity ((op)) is a symbol that gives players and GMs a cue to add narrative flair and secondary effects to the tasks the characters attempt. It can be spent to add details that make the story more vivid or exciting. Like most improvisational tools, (op) can be extremely effective when used to build upon details that already exist in the scene. The only thing (op) cannot do is change a success to a failure, or vice-versa—though it can add to or mitigate the consequences of succeeding or failing, at the GM's discretion. In terms of procedure, the player should suggest the detail or addition they wish to include with the (op), then the GM should either approve it or pose an alternative option that fits within the story. A character can only resolve a given opportunity effect once per check, but many opportunities can scale with additional (op) symbols spent."
        }
        ENTRY ^"opportunity-descriptors" #L5RG16lM7nO8pQ9rS0tU1v {
            CONCERNS [ #t0be2b3f270d6247a9c35d ^"Opportunity" ]
            TOPICS [ "opportunity", "narration" ]
            TEXT "One way to use (op) is to add a descriptive adverb to the verb that describes one's activity in a check, based on the ring used for the check:\n\nAir (op): Act precisely, stealthily, or subtly\n\nEarth (op): Act cautiously, calmly, or thoroughly\n\nFire (op): Act creatively, fearsomely, or noticeably\n\nWater (op): Act efficiently, flexibly, or gregariously\n\nVoid (op): Act instinctively, inscrutably, or sagely\n\nAdding one of these descriptors can significantly change the way a character's activity (the check) actually occurs in the narrative. The GM should consider how the character's descriptor might change how their success or failure is received, what consequences it has, or what new narrative opportunities it might create."
        }
    }

    #t0be2b3f270d6247a9c35d ^"Opportunity" DEF {

        # -----------------------------------------------
        # GENERAL EXAMPLES OF (op)
        # Available on any check regardless of context.
        # -----------------------------------------------

        GENERAL_OPPORTUNITIES {
            ANY {
                "(op): If you failed, determine the easiest way to accomplish the task you were attempting (skill and approach)."
                "(op)+: Remove 1 strife you gained from this check per (op) spent this way."
                "(op) (op): Provide assistance (see page 26) to the next character to attempt a check to accomplish something similar."
            }
            AIR {
                "(op): Learn another character in the scene's demeanor (if an NPC) and current strife."
                "(op)+: Act subtly to attract minimal attention in your efforts. Extra (op) makes the attempt even subtler."
                "(op)(op): Notice an interesting detail about a character in the scene, such as an advantage or disadvantage. At the GM's discretion, you may establish a new detail for an NPC."
            }
            EARTH {
                "(op): Reassure another character in the scene with your presence, allowing them to remove 2 strife."
                "(op)+: Act carefully to minimize consequences of failure or other dangers that could arise from the task. Extra (op) makes the attempt even safer."
                "(op)(op): Suddenly recall an important piece of information not directly related to the task. At the GM's discretion, you may establish a small preparatory action you took earlier, such as bringing along a common useful item."
            }
            FIRE {
                "(op): Inflame another character in the scene with your presence, causing them to receive 2 strife."
                "(op)+: Perform the task in a flashy way, drawing attention to yourself. Extra (op) attracts even more notice."
                "(op)(op): Notice something missing or out of place in the vicinity that is not directly related to the task. At the GM's discretion, you may establish an absence, such as a lack of shoes outside indicating the occupant's absence."
            }
            WATER {
                "(op): Remove 2 strife from yourself."
                "(op)+: Perform the task efficiently, completing it more quickly or saving supplies. Extra (op) further reduces the time or materials expended."
                "(op) (op): Spot an interesting physical detail present in your environment not directly related to your check. At the GM's discretion, you may establish a piece of terrain (see page 267) or a mundane object nearby."
            }
            VOID {
                "(op): Choose a ring other than Void. Reduce the TN of your next check by 1 if it uses that ring."
                "(op)+: Feel a chill down your spine, notice a sudden silence, or detect another sign of the supernatural if there is a spiritual disturbance in the scene. Extra (op) gives an increasingly precise location for the supernatural occurrence."
                "(op)(op): Gain spiritual insight into the nature of the universe or your own heart. At the GM's discretion, you may establish a fact about your character that has not been previously revealed but relates to the situation."
            }
        }

        # -----------------------------------------------
        # CONFLICT AND MARTIAL SKILL EXAMPLES OF (op)
        # Available during conflict scenes on Martial skill checks.
        # -----------------------------------------------

        CONFLICT_OPPORTUNITIES {
            AIR {
                "(op): Add a kept (ring) set to an (op) result to your next Martial skill check."
                "(op)+: During a Movement action check, up to 1 range band of any distance you move per (op) spent this way may be along a vertical surface."
                "(op)(op): Increase the TN of the next Martial Arts [Ranged] check targeting you before the start of your next turn by 2."
            }
            EARTH {
                "(op): During a Movement action, ignore one terrain quality (see page 267) of your choice."
                "(op)+: Reduce the severity of the next critical strike you suffer before the start of your next turn by 1 per (op) spent this way."
                "(op)(op): Do not apply one of your disadvantages to checks until the end of your next turn."
            }
            FIRE {
                "(op): Choose another character in the scene; increase the TN of the next check they make before the end of their next turn by 1 if it does not include you as a target."
                "(op)+: During an Attack action check, increase the TN of the next check the target makes to resist a critical strike they suffer before the start of your next turn by 1 per (op) spent this way."
                "(op)(op): Other characters must receive 2 strife to choose you as the target of their Attack and Scheme actions until the start of your next turn."
            }
            WATER {
                "(op): Remove 1 fatigue."
                "(op)+: During an Attack action check, ignore 1 point of target's physical resistance per (op) spent this way."
                "(op)(op): Move 1 range band."
            }
            VOID {
                "(op): During the next Attack action check you make before the end of your next turn, ignore one terrain quality (see page 267) of your choice."
                "(op)+: During a Support action check, increase your Initiative value by 1 per (op) spent this way."
                "(op)(op): Ignore the effects of one condition you are suffering until the end of your next turn."
            }
        }

        # -----------------------------------------------
        # INITIATIVE CHECK EXAMPLES OF (op)
        # Available when making Initiative checks.
        # -----------------------------------------------

        INITIATIVE_OPPORTUNITIES {
            AIR {
                "(op): On an Initiative check, assess one foe's weakness. Learn one of their disadvantages of that foe's choice."
            }
            EARTH {
                "(op): On an Initiative check, choose another character's disadvantage you know. They do not apply that disadvantage to their checks this scene."
            }
            FIRE {
                "(op): On an Initiative check, use your focus instead of your vigilance for your initiative when surprised."
            }
            WATER {
                "(op): On an Initiative check, assess the qualities of all terrain in the scene (see page 267)."
            }
            VOID {
                "(op): On an Initiative check, sense if there is an Otherworldly being in the scene."
            }
        }

        # -----------------------------------------------
        # OTHER SKILL EXAMPLES OF (op)
        # Available on non-Martial skill checks by skill group.
        # -----------------------------------------------

        SKILL_OPPORTUNITIES {
            AIR {
                ARTISAN "(op): If you succeed, add the Resplendent or Subtle quality to an item that you are refining."
                SCHOLAR "(op): Learn a something about a character who created or used the item you are studying (such as one of their advantages or disadvantages of the GM's choice that affected their creation or use of the item)."
                SOCIAL "(op): Learn if the honor, glory, or status attribute of a character in the scene is higher, lower, or equal to yours."
                TRADE "(op): Convince a buyer to pay an additional 10% for an item you are selling."
            }
            EARTH {
                ARTISAN "(op): If you succeed, add the Durable quality to an item that you are restoring."
                SCHOLAR "(op): Remember a place where you can research or study the topic you were attempting to recall."
                SOCIAL "(op): Increase the TN of the next Social check another character makes before the end of the scene by 1."
                TRADE "(op): Reduce the TN of the next check another character makes with the same skill before the end of the scene by 1."
            }
            FIRE {
                ARTISAN "(op): If you succeed, make one additional copy of the item you are creating."
                SCHOLAR "(op): Extrapolate the motivations or desires of another character in the scene or wider situation."
                SOCIAL "(op): Reduce the TN of the next Social check another character makes before the end of the scene by 1."
                TRADE "(op): Unusual inspiration strikes; add a kept (ring) set to an (op) result to the next check you make with another skill."
            }
            WATER {
                ARTISAN "(op): Add a kept (ring) set to an (op) result to the next Artisan skill check you make before the end of the game session."
                SCHOLAR "(op): Spot a unique or identifying quality, aspect, or ability of something that you are identifying."
                SOCIAL "(op): Add a kept (ring) set to an (op) result to your next Social check before the end of the scene."
                TRADE "(op): Convince a seller to give you an additional 10% discount for an item you are buying."
            }
            VOID {
                ARTISAN "(op): Reduce the TN of the next check you make using the item you are attuning yourself to by 1."
                SCHOLAR "(op): Intuit whether you can learn anything of value from your current course of inquiry."
                SOCIAL "(op): Discern the objective of another character in the scene."
                TRADE "(op): Reduce any effect you have on your environment (and physical traces of your efforts) to a minimum."
            }
        }

        # -----------------------------------------------
        # DOWNTIME CHECK EXAMPLES OF (op)
        # Available during downtime scene checks.
        # -----------------------------------------------

        DOWNTIME_OPPORTUNITIES {
            AIR {
                "(op)+: Learn a detail about one person in your company (such as an advantage or disadvantage of their choice) per (op) spent this way. You can learn only one detail about each person this way in a single downtime scene."
                "(op)(op): Perform your downtime activity without letting one or more others of your choice know that you did."
            }
            EARTH {
                "(op)+: Another character in your company may remove 1 strife or fatigue per (op) spent this way."
                "(op) (op): Memorize a small but vital detail from to your activity; you can recall it later without a check."
            }
            FIRE {
                "(op)+: Assist one other character per (op) spent this way with their next downtime activity check this session."
                "(op)(op): Energize another character in your company with your efforts; they may perform 1 additional downtime action this downtime (to a maximum of 2)."
            }
            WATER {
                "(op)+: Remove 1 strife or fatigue per (op) spent this way."
                "(op)(op): Make a new friend while undertaking your downtime activity."
            }
            VOID {
                "(op)+: Reserve 1 dropped die from your check, to a maximum of your ranks in the skill you used. Add that die to your next check with the same skill as a kept die instead of rolling it."
                "(op)(op): Have a brief premonition of a possible future event while undertaking your downtime activity."
            }
        }

        RULES {
            #L5R032fG3hI5jK7lM9nO1p: opportunity_is_optional "Unspent (op) simply goes unused and has no effect."
            #L5R033qR4sT6uV8wX0yZ2a: interpreting_opportunity "Finally, the player gets the chance to interpret the (op) they spend as part of the check: they should indicate whether they want to spend it in a manner that steers the narrative in a direction interesting to them, in a way based on an example option appropriate to the ring used on the check, or in a manner provided by a special ability."
            #L5R034bC5dE7fG9hI1jK3l: opportunity_once_per_check_and_scaling "A character can only resolve a given opportunity effect once per check, but many opportunities can scale with additional (op) symbols spent."
        }
    }

    #t517e363091d571b19bd62 ^"Void Points" DEF {
        APPLIES TO [#L5R003xY4zA6bC8dE0fG2hI ^"Samurai"]

        INTEGER MIN 0

        STARTING_VALUE "Void ring value / 2 (rounded up)"
        MAXIMUM "Void ring value"

        USES {
            ^"Seize the Moment" "A samurai should know the right moment to act, but sometimes, even the hand of fate must be nudged by bold action. While making a check, during Step 3: Assemble and Roll Dice Pool, a character may spend 1 Void point to roll one additional Ring die ((ring)) and subsequently keep one additional die during Step 5: Choose Kept Dice."
            ^"Shattering Parry" "When faced with death, a samurai must sometimes accept terrible losses to survive. When trying to survive a critical strike, a character may spend 1 Void point to dramatically intercept the attack with their weapon to increase their chance of survival, potentially sacrificing the weapon in the process as described on page 270."
            ^"Techniques and Other Abilities" "Certain techniques and other character abilities require spending a Void point to activate."
        }

        RECOVERY {
            "After failing a check on which one of their adversities was resolved (see Resolving Advantages and Disadvantages, on page 24)."
            "Once per scene, after one of their anxieties caused their strife to rise (see Resolving Advantages and Disadvantages, on page 24)."
            "After choosing to be affected by a complication that the GM (or the controlling player) introduced into the scene (see page 39)."
            "After the GM conceals the TN of a check from the players (see When to Reveal or Conceal the TN, on page 297)."
        }

    }

    # === SCENE AND SESSION STRUCTURE ===

    #DZ64KqDU4Od0f9EHUV3ZnO ^"Turn" DEF {

        RULES {
            #L5R038tU9vW1xY3zA5bC7d: turn_defined "Turns: A turn is a character's chance to perform an action and accomplish other small goals, such as choosing a stance and moving (narratively, or as the conflict dictates)."
            #L5R039eF0gH2iJ4kL6mN8o: perform_action_and_move "Step 3: Perform Action: After setting their stance, a character may perform their allotted action for the turn. Each action is a distinct effort the character undertakes, described by their player or provided among the sample actions for the encounter or by the character's personal abilities. Most actions require a check.\n\nOnce per turn, before or after performing an action, a character can also move a short distance (narratively or in range bands, as described on page 265)."
        }
    }

    #t0310138a2b906b0e4af7c ^"Scene" DEF {

        ENUM ["Narrative", "Downtime", "Conflict"]

        PROPERTIES {
            ^"Scene Type" ENUM ["Narrative", "Downtime", "Conflict"]
            ^"Location" STRING
            ^"Participants" LIST OF #L5R001aB2cD4eF6gH8iJ0kL ^"Entity"
        }

        RULES {
            #L5R040pQ1rS3tU5vW7xY9z: strife_removal_between_scenes "Removing Strife: Characters naturally remove some strife as time passes. At the end of each scene (a self-contained event or events in an ongoing adventure) each character removes strife until it is equal to half their composure, rounded up (unless it is already lower)."
            #L5R041aB2cD4eF6gH8iJ0k: scene_transition_effects "Timing Scenes and Sessions: If you're the GM, then it's up to you to decide when one scene ends and a new one begins, based on both narrative-time and real-time considerations. Individual scenes should usually last from half an hour to three hours, though you can end a scene at any time you see fit or extend one as needed. Remember, PCs regain the use of certain abilities and remove strife and fatigue at the end of a scene.\n\nIf a scene is resolved extremely quickly, you should feel free to say that it does not count as the end of a scene for the purposes of effects that trigger at the end of a scene (such as removal of strife and fatigue). If a scene transitions to another type of scene it generally does not count as ending."
        }
    }

    #AUTPId6XR7LRlrloo73lGq ^"Session" DEF {

        RULES {
            #L5R042lM3nO5pQ7rS9tU1v: experience_spent_between_sessions "Over the course of play, characters gain experience points (XP), which their players can spend between sessions to make the characters more potent."
            #L5R043wX4yZ6aB8cD0eF2g: once_per_game_session "Similarly, some abilities can be used \"once per game session,\" and some effects apply \"until the end of the game session.\" Such abilities and effects are written assuming a session that lasts from two to four hours. As the GM, you might find yourself running much shorter or longer game sessions (assuming player attention and the supply of snacks hold out). If you do, you may want to consider refreshing such abilities more or less frequently. You should always feel free to use real-time hours to define a \"game session,\" as long as you communicate these divisions clearly to the players."
        }
    }

    #L5R072cD4eF6gH8iJ0kL2m ^"Conflict Type" DEF {

        ENUM ["Intrigue", "Duel", "Skirmish", "Mass Battle"]

        RULES {
            #L5R044hI5jK7lM9nO1pQ3r: intrigue_social_combat "Intrigues are social conflicts. Even the Emperor does not make decisions without first listening to the counsel of his highest retainers. The most impactful conflicts in all of Rokugan are often the words traded between high-ranking samurai—or at least they begin with those words. Petitions to great lords, treaties, political schemes, trade agreements, pacts, and marriages change the face of Rokugan every day, and exerting political influence is the primary duty of many samurai."
            #L5R045sT6uV8wX0yZ2aB4c: duel_formal_one_on_one "Duels are one-on-one battles of honor. When a matter cannot be resolved with will, wits, and rhetoric alone, honor sometimes demands that a samurai seek resolution by drawing steel. Duels are an important part of the political process in Rokugan, and the mere possibility of a formal challenge can be incredibly potent leverage."
            #L5R046dE7fG9hI1jK3lM5n: skirmish_tactical_combat "Skirmishes are small-scale battles. From pitched battles between rival factions to targeted raids against enemy clans, skirmishes tend to be chaotic, small-scale battles with a few combatants on each side."
            #L5R047oP8qR0sT2uV4wX6y: mass_battle_abstracted_warfare "Mass battles are battles between entire armies. Open warfare is relatively rare in Rokugan, but it is devastating in its impact. On the off chance that their daimyō asks it of them, any samurai must in theory be prepared to serve in war in some capacity, whether as a warrior, an advisor, a strategist, or a negotiator. Because they tend to be culminating story arc moments rather than everyday occurrences, mass battles are covered at the end of this chapter (see page 274)."
        }
    }

    #ynDEf5tmE2FXVJeDDg63yT ^"Stance" DEF {

        ENUM ["Air", "Earth", "Fire", "Water", "Void"]

        RULES {
            #L5R048zA9bC1dE3fG5hI7j: set_stance "Step 2: Set Stance: Next, the character sets their stance. This is a character's poise, footwork, tact, or some combination of the above depending on what the conflict entails. Each turn, a character can remain in the stance they were already in or switch to a new stance.\n\nAs part of setting a stance, a character may set the grip with which they are wielding a weapon (see page 230). A character may also drop any number of items on the ground. Readying a new weapon requires an action, however.\n\nAfter setting a stance, a character remains in that stance until the beginning of their next turn.\n\nIn addition to determining which ring a character uses for the action they perform during Step 3: Perform Action and for any other checks they make while in that stance, each stance confers a passive benefit during a conflict, described in Table 6–1: Stances."
            #L5R049kL0mN2oP4qR6sT8u: air_stance_raises_tn_of_attack_and_scheme_targeting_you "Air: Increase the TN of Attack and Scheme action checks targeting you by 1. If your school rank is 4 or higher, increase the TN by 2 instead."
            #L5R050vW1xY3zA5bC7dE9f: earth_stance_blocks_op_crits_and_conditions "Earth: When other characters make Attack action checks and Scheme action checks that target you, they cannot spend (op) to inflict critical strikes or conditions on you."
            #L5R051gH2iJ4kL6mN8oP0q: fire_stance_strife_results_become_bonus_successes "Fire: When you succeed on a check, you count as having one additional bonus success for each (st) symbol on your kept dice."
            #L5R052rS3tU5vW7xY9zA1b: water_stance_extra_action_without_a_check "Water: During your turn, you may perform one additional action that does not require a check. This action cannot share a type with another action you perform this turn."
            #L5R053cD4eF6gH8iJ0kL2m: void_stance_no_strife_from_strife_results "Void: You do not receive strife from (st) symbols on your kept dice. You can still receive strife from other sources."
        }
    }

    #tf2cd15e64454ec22b5c18 ^"Initiative" DEF {

        RULES {
            #L5R054nO5pQ7rS9tU1vW3x: initiative_checks "Initiative Checks: An Initiative check helps determine a character's initiative value for the scene. Each type of conflict uses a skill for its Initiative check, listed below:\n\nIntrigue: TN 1 Sentiment check.\n\nDuel: TN 1 Meditation check.\n\nSkirmish: TN 1 Tactics check.\n\nMass Battle: TN 1 Command check.\n\nA character can use any ring for this check. After a character resolves their Initiative check, that character enters the stance matching the ring they used.\n\nEach PC participating in a scene should make an Initiative check, as should each sufficiently important NPC (minion NPCs can generate initiative value without a check, using their focus or vigilance attribute)."
            #L5R055yZ6aB8cD0eF2gH4i: initiative_values "Determine Initiative Values: A character's initiative value is based on their state of preparedness when the conflict began.\n\nIf the character was ready for the conflict, their base initiative value is their focus attribute.\n\nIf the character was unprepared (such as when surprised), their base initiative value is their vigilance attribute.\n\nThen, if the character succeeded on their Initiative check, they add 1 to their base initiative value, plus an additional amount equal to their bonus successes."
            #L5R056jK7lM9nO1pQ3rS5t: initiative_order_ties_to_lowest_honor "Set Initiative Order: Organize the characters by their initiative value, highest to lowest, and record this initiative order along with the values. This is the sequence in which the characters act during Phase 2: Take Turns in many conflict types.\n\nIf two or more characters have the same initiative value, the one with the lowest honor attribute acts first, followed by the others in ascending order of honor."
        }
    }

    #a1Z7NV1VD4ScqFUT9hfUjE ^"Action" DEF {

        INTRIGUE_ACTIONS {
            ENUM ["Assist", "Calming Breath", "Persuade", "Unique Action"]
        }

        DUEL_ACTIONS {
            ENUM ["Calming Breath", "Center", "Predict", "Prepare Item", "Strike"]
        }

        SKIRMISH_ACTIONS {
            ENUM ["Assist", "Calming Breath", "Challenge", "Guard", "Maneuver", "Prepare Item", "Strike", "Unique Action", "Wait"]
        }

        MASS_BATTLE_ACTIONS {
            ENUM ["Assault", "Challenge", "Rally", "Reinforce"]
        }

        RULES {
            #L5R057uV8wX0yZ2aB4cD6e: actions_defined "Actions: Actions are discrete tasks characters undertake during a scene, often by making a check. In a skirmish, this might mean making a precise sword stroke or leaping heroically across a chasm, while in an intrigue scene, it could entails setting one's scheme into motion. There is no limit to what an action can be except the players' imagination and the GM's approval, but each conflict type provides its own list of sample actions to get players started."
            #L5R058fG9hI1jK3lM5nO7p: actions_in_conflict "Actions: Actions are the main way that characters interact with others and the environment during a conflict, and each represents a distinct effort, usually involving a check.\n\nMany things a player might want to accomplish fit into the listed actions for each conflict type. A player can also describe just their intention to the GM, who can propose a suitable listed action or decide upon the checks, requirements, and outcomes on a case-by-case basis."
        }
    }

    #t6a1d1f5c1365aca69c1e8 ^"Range Band" DEF {

        ENUM ["Range 0", "Range 1", "Range 2", "Range 3", "Range 4", "Range 5", "Range 6"]

        RULES {
            #L5R063iJ4kL6mN8oP0qR2s: maximum_and_minimum_range "Maximum and Minimum Range: When a distance or distances are specified for an effect or ability, the provided value(s) are both a maximum and a minimum. In other words, if an ability affects something at range 1–3, it cannot affect an object closer than range 1 any more than it can affect one farther than range 3."
            #L5R064tU5vW7xY9zA1bC3d: range_bands "Range Bands: Instead of measuring discrete units of space, Legend of the Five Rings handles the concept of distance between two people or objects abstractly, using range bands. Range bands are a set of numbered, approximate distances that can be used to define spatial relationships between two points when that information is needed. Range bands allow narrative scenes and conflicts—especially skirmishes—to move at a faster pace, glossing over some specifics. Using range bands also means that representations on a tactical map are not strictly necessary for conflicts, though they can still be useful for helping keep track of relative positions.\n\nNote that range bands increase in scale as they increase in number—the difference in the distance between range 0 and range 1 (from arm's reach to sword reach) and the distance between range 5 and range 6 (from a hundred or more yards to the edge of perceptible range) is substantial. This reflects the difficulty inherent in closing with or escaping a foe while allowing characters to reposition strategically when not being impeded."
            #kzoZnDyKzmvm3DNDmi2jC0: range_0_touch "Range 0 Touch (1–2 feet): At this range, two foes can grapple and use small weapons such as knives, but longer weapons are hard to wield effectively. Objects at range 0 might be at the person's feet, or even on their person, and a character can interact with them."
            #jJctOZYGlUtA0x38N26dp4: range_1_sword "Range 1 Sword (1–2 yards): The optimal range for fighting with a sword. A character can generally interact with people and objects at range 1. Most skills that have a manual aspect require the target or object to be at range 0–1."
            #DNPwTRdQVvNFwgOuv1cp4L: range_2_spear "Range 2 Spear (3–4 yards): The range at which polearms such as spears and naginata have the greatest advantage."
            #IQcmsYyrmCP2M8kWxEzclM: range_3_throw "Range 3 Throw (5–10 yards): The range at which thrown missile weapons are most effective."
            #sI59fl8B4HQVRg5BaTTbru: range_4_bow "Range 4 Bow (11–100 yards): The midrange for missile weapons like bows. Generally speaking, this range coincides with the edge of earshot for most characters."
            #NxoaYehxNHVcf5s6JwCkl9: range_5_volley "Range 5 Volley (100+ yards): The distance to the outer edge of the range at which missile weapons are accurate. This is the farthest most characters can see any details."
            #duSMIE0Ks00nDEzfw0IcL6: range_6_sight "Range 6 Sight (more than a few hundred yards): Range 6 represents the maximum distance at which one can interact with a human-sized target (albeit minimally). To travel beyond range 6 of their current location, a character must generally travel in narrative time or downtime."
        }
    }

    #Ul7Tn8ZKqj23ck5i3cnoUD ^"Silhouette" DEF {

        INTEGER MIN 0 MAX 5

        RULES {
            #L5R064aU5vW7xY9zA1bC3e: silhouette_determines_size_category "Silhouette: Objects in Legend of the Five Rings are classified into a number of different size categories called silhouettes. While these categories are abstract and are frequently more useful for description than for specific mechanics, they do have some important ramifications for certain techniques (see Chapter 4: Techniques, on page 171)."
            #U9VhN0cRWaOFjv4r8h5saJ: silhouette_0 "0: Handheld objects, cats, small dogs"
            #Nq1s6ew6rFgRH5vpMblEAK: silhouette_1 "1: Children, large dogs, goblins"
            #7PqNaFBWtrezZyIWJcuFCF: silhouette_2 "2: Adult humans, ningyo, tengu"
            #pTF0R95zluVSwXuVJld2dJ: silhouette_3 "3: Horses, naga, rakshasa, trolls"
            #tpZ1mB4d7l0EBVvWMlxXkF: silhouette_4 "4: Ogres, elephants"
            #2DBWbVlXf51bbKOoyuCV8C: silhouette_5 "5: Dragons"
        }
    }

    #t53e040a67ec04e3085911 ^"GM Role" DEF {

        BOOLEAN DEFAULT false

        RULES {
            #L5R065eF6gH8iJ0kL2mN4o: session_preparation "Preparations: Running a session often requires some preparation. A few weeks, days, or hours ahead of time, the GM prepares the needed components, including the adventure (see more on Creating Scenarios on page 288) and the settings and NPCs within it. This can take a few minutes to hours or even days of work, and depends entirely on the complexity of the scenario and whether the GM prefers to make things up as they go along, or run sessions with a lot of advance planning. New GMs should err on the side of planning more until they figure out how comfortable they are with improvisation."
            #L5R066pQ7rS9tU1vW3xY5z: gm_performs_npc_checks "Steps of a Check: The six steps in the following section provide a more technical breakdown that the GM can reference if they need to know when effects occur or how specific abilities interact. The GM performs all steps for non-player characters."
            #L5R067aB8cD0eF2gH4iJ6k: rules_adjudication "Rules Adjudication: While the GM and players are collaborating to tell a story, the GM is ultimately the arbiter of all rules matters. The GM should attempt to keep the pace moving during a game session and not get too bogged down in looking up details at the table—they can always reference the relevant sections later to clarify the correct way things should be resolved in the future.\n\nThe players should endeavor to support the GM rather than undermining them. Players should feel free to offer their interpretations of a rule when it becomes relevant, or if the GM asks, but they should let the ruling stand once the GM has made it. Discussing the rules after a session can be one way to untangle unclear issues or apparent contradictions."
            #L5R068lM9nO1pQ3rS5tU7v: sample_tns "Sample TNs: The target number of successes (TN) generally ranges from 1 to 8, but it can potentially be even higher. The GM chooses this number based on the innate difficulty of the task, the complexity of the objective the player described, and the appropriateness of the method the character is using."
        }
    }

    #tbbf26ea191f0bd2062fc4 ^"Player Character" DEF {

        # A player character (PC) — the character a player portrays within the
        # world of the game. A PC's numerical values live in ^"Rings" and the
        # skill DEFs; who plays, and how, is covered in the GUIDANCE block below.
    }

    # -----------------------------------------------------------------------
    # GUIDANCE (§22) — advisory prose about who plays and how (book pp.20-21).
    # -----------------------------------------------------------------------
    GUIDANCE {
        ENTRY ^"players-and-pcs" #L5RG03uV4wX5yZ6aB7cD8e {
            CONCERNS [ #tbbf26ea191f0bd2062fc4 ^"Player Character" ]
            TOPICS [ "players", "player characters" ]
            TEXT "Most of the participants in the game, termed players, portray a person within the world of the game. Each player controls one such character (called, intuitively enough, a player character, or PC). Players decide the history, beliefs, desires, and quirks of their player characters; make decisions for their characters during the game; and control and portray their characters when roleplaying. PCs also have numerical values, such as rings and skills, that reflect their aptitudes, training, and traits. These values help them undertake tasks within the story."
        }
        ENTRY ^"the-game-masters-role" #L5RG04fG5hI6jK7lM8nO9p {
            CONCERNS [ #t53e040a67ec04e3085911 ^"GM Role" ]
            TOPICS [ "game master" ]
            TEXT "To aid in the telling of the story, one participant serves as the game master (GM) instead of as a player. The game master is the group's guide, who invents the frame of the story and presents the PCs with challenges, decisions, and opportunities. The game master is not the sole architect of the story, but this person does have a particularly important role in helping the PCs to interact with the world. They portray the other inhabitants of Rokugan (non-player characters, or NPCs), describe each scene to the players, and act as an arbitrator in the infinite number of situations that can arise."
        }
        ENTRY ^"what-is-the-game-masters-role" #L5RG05qR6sT7uV8wX9yZ0a {
            CONCERNS [ #t53e040a67ec04e3085911 ^"GM Role" ]
            TOPICS [ "game master", "collaboration" ]
            TEXT "The game master is the group's access point to the world of Rokugan, and the final arbiter on many matters of story and rules. However, that doesn't mean that the players have no say over the story—balance and respect for one another are key. The players should listen to the GM, and the GM should listen to the players, too, and incorporate their ideas as appropriate. If this is your first time playing or running a roleplaying game, make sure to read Chapter 7: The Game Master (see page 281) for insight on how both the GM and the players can collaborate to make the game the best it can be!"
        }
    }

    #te8c28d9e740ccae9f502d ^"Experience Points" DEF {
        APPLIES TO [#L5R003xY4zA6bC8dE0fG2hI ^"Samurai"]

        INTEGER MIN 0 MAX 999999

        ADVANCEMENT_COSTS {
            ^"Ring Value +1" COST "3 XP × value purchased"
            ^"Skill Rank +1" COST "2 XP × rank purchased"
            ^"Technique" COST "3 XP, or other listed value"
        }

        RULES {
            #L5R069wX0yZ2aB4cD6eF8g: awarding_xp "Awarding XP: Character growth is an important theme of Legend of the Five Rings, as each character pursues mastery within their domain while expanding their knowledge of the wider world. The recommended rate of experience point gain is 1 XP per hour of play, with an additional 3–5 XP awarded to each character in the group at the GM's discretion whenever the party overcomes a significant milestone or obstacle. Increasing the base value to 2 XP per hour will make for a more heroic-feeling game, and is often a good idea to help keep tactically oriented groups engaged."
            #L5R070hI1jK3lM5nO7pQ9r: adjusting_xp_awards "GMs should feel free to adjust these numbers as they see fit. At their discretion, GMs can also give bonus XP for particularly strong moments of roleplaying among the group. Standardized XP across the group makes it easier for everyone to track and helps keep the characters at a roughly equivalent level of competency, but GMs should also feel free to award XP on a per-player basis if that is their group's preference."
            #L5R071sT2uV4wX6yZ8aB0c: advancement_spending_rules "Purchasing Advancements: The ways a character can improve themself by spending experience are collectively called advancements. These include ring ranks, skill ranks, and techniques.\n\nA character may purchase any advancement by paying its listed cost, so long as it fits within the listed restrictions. Table 2–2: Advancement Costs provides the costs and restrictions for each advancement type."
            #czKeXUMIZZ5NQl7xWip26v: restriction_ring_value "Ring value +1: Cannot increase a ring to a value greater than lowest ring + Void Ring. Maximum 5."
            #uGdTQhKaTYilgzhD7ymbrD: restriction_skill_rank "Skill rank +1: Maximum 5."
            #u4CBzNvyUQTS8wMz5wvxPz: restriction_technique "Technique: Category must be listed among available techniques or technique must appear on your curriculum (denoted by = symbol)."
        }
    }

    GUIDANCE {
        ENTRY ^"practical-experience-and-advancement" #L5RG56jK9lM0nO1pQ2rS3t {
            CONCERNS [ #te8c28d9e740ccae9f502d ^"Experience Points" ]
            TOPICS [ "advancement", "experience", "game master" ]
            TEXT "A little bit of practical experience can be as potent as years of training. Characters in any campaign should be allowed to spend their experience on skills and rings during play as they desire, as one can learn through practice no matter their circumstances. In the fiction of the setting, a character is usually taught school secrets, like techniques, by an instructor in their school or another individual who knows the technique. Advancing to the next school rank might be a more involved process, requiring the character to undertake tests or visit specific locations and meet with particular instructors of their tradition. In practice, many campaigns are not conducive to having characters return to their dōjō as frequently as they would like to spend experience or increase their school rank. As a result, the game's default assumption is that characters can learn techniques and increase school rank wherever they go, presumably receiving foundational methods to practice on their travels or scrolls containing deeper mysteries for them to decipher during their journeys. A character might need to return to their school to formally verify their newly elevated rank within their school from a thematic standpoint, but they can use its mechanical benefits as soon as they earn it. If you, as a GM, want to maintain the narrative element of learning techniques and advancing school ranks, you can do so by specifying that a character must use a downtime activity to visit their dōjō or search for an NPC who knows the technique. School ranks can only be increased after visiting the proper dōjō and passing the requisite test or training under an individual who has attained a higher rank in that school. If you decide to take this route for your game, be sure that you inform your players before the game begins and provide the PCs with sufficient opportunities to spend their hard-earned experience on techniques."
        }
        ENTRY ^"xp-award-guideline" #L5RG76mN2oP3qR4sT5uV6w {
            CONCERNS [ #te8c28d9e740ccae9f502d ^"Experience Points" ]
            TOPICS [ "experience", "advancement", "game master" ]
            TEXT "As a general guideline, GMs should award about 1 XP per hour of play. GMs can award additional XP at their discretion, as discussed in Chapter 7: The Game Master (see page 299)."
        }
    }
    GUIDANCE {
        ENTRY ^"reading-the-dice-symbols" #KKSwUCKWmoocoqkeI0U2Oi {
            CONCERNS [ #t202588bb0b32758539464 ^"Dice Symbols" ]
            TOPICS [ "dice", "symbols", "strife" ]
            TEXT "The strife symbol ((st)) represents an upwelling of emotion. Strife does not affect success or failure on the check but instead accumulates over time, potentially leading to outward displays of emotion that can alter the direction of the story for good or for ill. The more it accumulates, the harder it is to maintain the decorum expected of a samurai—a key struggle in the genre of samurai drama."
        }
    }
}
