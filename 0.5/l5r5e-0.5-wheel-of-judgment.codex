# .codex SECTION — Wheel of Judgment. Stand-off graph over
# l5r5e-0.5-wheel-of-judgment.lore (spec §25). Part of the L5R5e system graph;
# DEPENDS_ON the shared schema.
#
# The nine statblocks (l5r5e-0.5-wheel-of-judgment-cast.ttrpg) are DEFs, referenced
# via ^"..." never minted. Meido, Jigoku, Gaki-dō, Ningen-dō, Emma-Ō, Fu Leng,
# Ryoshun, and the maō Burakakin are already in the graph (Emerald Empire /
# Deathly Turns) — referenced. This section mints the new places of the adventure
# (the Palace of Emma-Ō, the Fortress of Fu Leng and its Archive and Repository of
# All Knowledge) and the lore-only figures (the mazoku Minroki and Rikakima, the
# murdered courtier Reju Tabito and his student Akio).

CODEX "L5R5e_WheelOfJudgment_Codex" {
    NAME "Wheel of Judgment — Lore Graph"
    VERSION "0.5.1"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-09-05"
    FOR EDITION "l5r5e"
    DEPENDS_ON "L5R5e_Codex_Schema" VERSION "0.5.9"

    # ---- Places of the underworld -----------------------------------------
    ENTITY #L5RcxWOJ01palaceemmao ^"Palace of Emma-Ō" {
        IS ^"Palace"
        SOURCE "l5r5e-0.5-wheel-of-judgment.lore" AT "the-landscape-of-meido"
        RELATIONSHIPS {
            ^"located-in" -> ^"Meido" FROM "The many-tiered palace of Emma-Ō is visible from everywhere in Meido." }
    }
    ENTITY #L5RcxWOJ02fortressfuleng ^"Fortress of Fu Leng" {
        IS ^"Castle"
        SOURCE "l5r5e-0.5-wheel-of-judgment.lore" AT "the-fortress"
        RELATIONSHIPS {
            ^"located-in" -> ^"Jigoku" FROM "The Fortress of Fu Leng is the spiritual—and therefore physical—center of Jigoku, and all oni are drawn to it." }
    }
    ENTITY #L5RcxWOJ03thearchive ^"The Archive (Fortress of Fu Leng)" {
        IS ^"Landmark"
        SOURCE "l5r5e-0.5-wheel-of-judgment.lore" AT "the-guide"
        RELATIONSHIPS {
            ^"located-in" -> ^"Fortress of Fu Leng" }
    }
    ENTITY #L5RcxWOJ04repository ^"Repository of All Knowledge" {
        IS ^"Landmark"
        SOURCE "l5r5e-0.5-wheel-of-judgment.lore" AT "part-two-jigoku-the-realm-of-evil"
        RELATIONSHIPS {
            ^"located-in" -> ^"Fortress of Fu Leng" }
    }

    # ---- The mazoku of Meido -----------------------------------------------
    ENTITY #L5RcxWOJ05minroki ^"Minroki" {
        IS ^"Person"
        SOURCE "l5r5e-0.5-wheel-of-judgment.lore" AT "minroki-mazoku-guard"
        RELATIONSHIPS {
            ^"companion-of" -> ^"Rikakima" FROM "Minroki has been partnered with Rikakima as long as he can remember, and he trusts her judgment" }
    }
    ENTITY #L5RcxWOJ06rikakima ^"Rikakima" {
        IS ^"Person"
        SOURCE "l5r5e-0.5-wheel-of-judgment.lore" AT "the-guard"
    }

    # ---- The murdered courtier and his student -----------------------------
    ENTITY #L5RcxWOJ07rejutabito ^"Reju Tabito" {
        IS ^"Person"
        SOURCE "l5r5e-0.5-wheel-of-judgment.lore" AT "is-this-the-end"
        RELATIONSHIPS {
            ^"teacher-of" -> ^"Akio" FROM "Reju Tabito (see page 5) might call out and ask them to promise to help Akio if they return to Ningen-dō." }
    }
    ENTITY #L5RcxWOJ08akioseppun ^"Akio" {
        IS ^"Person"
        SOURCE "l5r5e-0.5-wheel-of-judgment.lore" AT "the-queue"
    }
}
