    #MtvVCfoBfloculUA27PbXS ^"Sage Role" DEF {
        APPLIES TO [#t14626300ed0f58aa6f93a ^"Ronin", #L5R007qR8sT0uV2wX4yZ6a ^"Peasant", #t822273f0dfaf436b4dfe8 ^"Gaijin"]

        RULES {
            #L5RPW44fG1hI3jK5lM7nO9p: sage_role_non_rokugani_powers "Roles: Like shugenja, sages are individuals who wield special powers, but theirs are bestowed by other means, usually outside the bounds of what is considered appropriate in Rokugan."
        }
    }

