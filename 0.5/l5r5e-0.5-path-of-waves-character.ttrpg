EXTENSION "L5R5e_Path_of_Waves_Character" EXTENDS "L5R5e_Core_Character" {
    NAME "Legend of the Five Rings 5th Edition - Path of Waves: Character Creation"
    VERSION "0.5.3"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-03-01"

    # Path of Waves (Chapter 2): A revised Game of Twenty Questions
    # for ronin, peasant, and gaijin characters. Replaces clan/family
    # with region/upbringing. Replaces giri with "past". Introduces
    # new schools, advantages, disadvantages, and gaijin cultures.
    # This extension supplements and partially overrides the core
    # character creation system to support non-samurai PCs.

    # ===========================
    # REVISED TWENTY QUESTIONS
    # ===========================

    # The Path of Waves twenty questions replace the core
    # rulebook's twenty questions for ronin, peasant, and
    # gaijin characters. Key differences:
    # - Question 1 uses Region instead of Clan
    # - Question 2 uses Upbringing instead of Family
    # - Question 3 uses new school options
    # - Giri is replaced by Past (Question 5)
    # - Ninjō remains but is reframed around Past (Question 6)
    # - Question 7 has different flavor (positive deeds vs selfish actions)
    # - Question 8 has THREE options (Orthodox, Divergent, Ignorant) instead of two
    # - Question 14 is "Most prized possession" instead of "What do people notice first?"
    # - Question 17 is "Shared group history" instead of "Parent's opinion"
    # - Question 18 is "Who raised you? (+1 skill)" instead of heritage table
    # - Status starts lower (ronin 24, peasant 15, gaijin 0)
    # - Glory represents personal reputation, not Bushido adherence

    # ===========================
    # NEW ENTITY TYPES
    # ===========================

    #t14626300ed0f58aa6f93a ^"Ronin" DEF {
        EXTENDS #L5R003xY4zA6bC8dE0fG2hI ^"Samurai"
        # Masterless samurai who walk the Path of Waves.
        # Ronin retain samurai social standing but lack
        # a lord, clan, or formal family backing.
    }

    #t822273f0dfaf436b4dfe8 ^"Gaijin" DEF {
        EXTENDS #L5R001aB2cD4eF6gH8iJ0kL ^"Entity"
        # Foreigners from outside Rokugan: Ujik nomads,
        # Qamarist scholars, Ivory Kingdoms warriors, etc.

        RULES {
            #nGunOQZeNWQslvvsvGLCzk: gaijin_homeland_status "Gaijin Status: The second status value reflects the gaijin's status in their own homeland. This value will very rarely be used, as the Legend of the Five Rings Roleplaying Game is designed to help players and GMs tell stories that take place in Rokugan. There are only a limited number of circumstances in which a gaijin's homeland status might come into play. Perhaps, during their adventure, the group must briefly travel the Sand Road and encounter more Ujik, or the group encounters a gaijin NPC while traveling in Rokugan. In case such a circumstance arises, the player and GM should discuss the gaijin's standing in their culture during character creation. When they agree on a value (using the table on page 305 of the core rulebook as a guideline), the player should note this value on their character sheet. Unless a gaijin is interacting with someone from their culture, their cultural status value cannot change unless the GM determines it should. For more information on different ways to run games with gaijin, see Chapter 6: Untold Stories, starting on page 173."
        }
    }

    # ===========================
    # PATH OF WAVES CHARACTER CREATION
    # ===========================

    #rQR6SkrFdRUm8NHkdho2Od ^"Path of Waves Character Creation" DEF {
        APPLIES TO [#t14626300ed0f58aa6f93a ^"Ronin", #L5R007qR8sT0uV2wX4yZ6a ^"Peasant", #t822273f0dfaf436b4dfe8 ^"Gaijin"]

        RULES {
            #L5RPW01aB2cD4eF6gH8iJ0k: pow_rings_max_3_during_creation "Limits on Skills and Rings: All characters begin with 1 rank in each ring and 0 ranks in each skill. Rings and skills have a maximum rank of 3 during character creation. If a choice would result in a ring rising above rank 3 during character creation, then the player must choose a different ring to increase instead, as long as that ring would not be increased above 3."
            #L5RPW02lM3nO5pQ7rS9tU1v: pow_skills_max_3_during_creation "Limits on Skills and Rings: Similarly, if a choice would result in a skill rising above rank 3 during character creation, then the player must choose a different skill that is not already at rank 3 to increase instead."
            #L5RPW03wX4yZ6aB8cD0eF2g: pow_ronin_base_status_24 "Depending on what type of character you choose, you have a particular base status value that is modified by your upbringing.\n\nIf you are a rōnin (even one with a secret upbringing) your status begins at 24."
            #L5RPW04hI5jK7lM9nO1pQ3r: pow_peasant_base_status_15 "If you are a peasant (and are open about your upbringing) your status begins at 15."
            #L5RPW05sT6uV8wX0yZ2aB4c: pow_gaijin_base_status_0 "If you are a gaijin your status begins at 0. For more information on how gaijin status works, see Gaijin Status on page 38."
            #L5RPW06dE7fG9hI1jK3lM5n: pow_giri_substituted_with_past "To accomplish this for rōnin characters, giri is substituted with a \"past.\" The rōnin's past is a statement describing the circumstances surrounding how the rōnin came to be in their current position and presents something they must overcome, something to which they are constantly set against and compared. As the game proceeds, the rōnin must reconcile what they wish to do with what they've already done."
            #L5RPW07oP8qR0sT2uV4wX6y: pow_glory_represents_personal_reputation "Glory: For non-samurai, glory instead represents personal reputation and renown. Rōnin and other characters who exist outside of polite samurai society view glory as a measure of how people generally view them, including their honesty, good works, and history of paying their debts (both their promises and monetary obligations)."
        }
    }

    # ===========================
    # QUESTION 1: REGIONS
    # ===========================

    # source stat block (page 32)
    #K6AIJJPInzptOAsu7Qur56 ^"Urban Region" DEF {
        APPLIES TO [#t14626300ed0f58aa6f93a ^"Ronin", #L5R007qR8sT0uV2wX4yZ6a ^"Peasant"]

        PROPERTIES {
            ^"Region" STRING "Urban" FIXED
            ^"Ring Increase" DEF { ^"Air" INTEGER 1 }
            ^"Skill Increase" STRING "+1 Commerce"
            ^"Glory" INTEGER DEFAULT 29
        }

        RULES {
            #L5RPW08zA9bC1dE3fG5hI7j: urban_political_awareness "You have a general awareness of the political climate within your city of origin. You can name major families, prominent merchants, and other leaders in the city as well as their respective positions and allegiances."
            #L5RPW09kL0mN2oP4qR6sT8u: urban_cosmopolitan_connections "Due to the cosmopolitan culture of cities, you have made many connections during your time in your city. You personally have a family member, friend, or business associate who has traveled abroad or knows about political or business dealings in another land."
            #S3KL5HaJ8TEY12ObgMEuBY: urban_neighborhood_knowledge "You know the layout and local residents in the neighborhood where you grew up or where you live now, along with any unusual features, shortcuts, or hidden wonders in your chosen area of the city."
            #HAiiCNCv2S9UfkKCb4QVC3: urban_crime_poverty_unrest "You have knowledge of the impact of crime, poverty, or political unrest that you have experienced in your city during your lifetime."
            #bcYWL4wBS6oFx8zFyEgCNa: urban_crime_or_trade_knowledge "You have moderate knowledge of some form of crime or legitimate trade related to the industry or commerce of your city."
        }
    }

    # source stat block (page 33)
    #IR9JGxY6PBfrUZEPAUO8Ic ^"Rural Farmland Region" DEF {
        APPLIES TO [#t14626300ed0f58aa6f93a ^"Ronin", #L5R007qR8sT0uV2wX4yZ6a ^"Peasant"]

        PROPERTIES {
            ^"Region" STRING "Rural Farmland" FIXED
            ^"Ring Increase" DEF { ^"Earth" INTEGER 1 }
            ^"Skill Increase" STRING "+1 Fitness"
            ^"Glory" INTEGER DEFAULT 34
        }

        RULES {
            #L5RPW10vW1xY3zA5bC7dE9f: rural_oral_tradition "You have inherited a strong oral tradition and can sing or recite folk songs or stories passed down from your ancestors."
            #L5RPW11gH2iJ4kL6mN8oP0q: rural_agricultural_knowledge "You have a working knowledge of agricultural practices and how to make a living in your region."
            #uJfehpTHuGp1rbr4uXZBJh: rural_political_climate "You have general knowledge of the political climate within your region. You can name major families, prosperous local farmers, and important government officials to whom your family or local community reports."
            #WrpBhfSfy3qLIGbOUR9n40: rural_family_stories_of_upheaval "You grew up hearing stories from your parents, grandparents, and great-grandparents of major political upheavals or forces that moved through your region and can relate either detailed or exaggerated accounts of any notable events that may have taken place in your family members' lifetimes."
            #kiqX4fA6rd6H7GSwUcMQHv: rural_harvest_and_seasons "You are aware of past and predicted harvest times, the timing of the seasons, and any peculiar weather phenomena in your region. You are also keenly aware of the impact of any events (political or otherwise) that interfere with your community's livelihood: the harvest."
            #D38x10AeEegvooZSSJQeYx: rural_unaware_of_larger_politics "You are largely unaware of larger political movements and concerns, and your cultural awareness is mostly confined to your local community."
        }
    }

    # source stat block (page 34)
    #CszMrXwc6N710M5wLtXzps ^"Sea River or Lake Region" DEF {
        APPLIES TO [#t14626300ed0f58aa6f93a ^"Ronin", #L5R007qR8sT0uV2wX4yZ6a ^"Peasant"]

        PROPERTIES {
            ^"Region" STRING "Sea, River, or Lake" FIXED
            ^"Ring Increase" DEF { ^"Water" INTEGER 1 }
            ^"Skill Increase" STRING "+1 Seafaring"
            ^"Glory" INTEGER DEFAULT 32
        }

        RULES {
            #L5RPW12rS3tU5vW7xY9zA1b: sea_trade_route_awareness "You have a general awareness of the politics of cities and strongholds connected by the trade routes along your river or body of water. You can name major merchants, family heads, and significant leaders in these areas, and you know their respective positions and allegiances."
            #L5RPW13cD4eF6gH8iJ0kL2m: sea_water_survival_skills "Your life near the waves has taught you how to prepare for floods and hurricanes, and how to travel on the water, whether by swimming, piloting watercraft, or other means."
            #k8d3SMOBufN8eRwCvL7ycX: sea_power_of_water "You either have experience with, or have heard stories of, the extreme destructive power of water and the devastation wrought by storms, floods, and violent natural and unnatural phenomena that comes from living so close to water. Conversely, you are also aware of the advantages (both social and material) that come from harnessing the power of water."
            #uqWaW5yai7bt6P5i3Uy9yG: sea_local_heroes_and_antagonists "You know stories of heroes or antagonists who either prevailed over, or succumbed to, the local waters of your region, and their significance."
            #wYKPuMbgXuOFCBOObzblnT: sea_folk_songs_of_the_water "You are familiar with folk songs and tales passed down in your local community, particularly those that portray the spiritual and natural hazards of the water, and can recite at least one from memory."
            #FclgWmUOzqMBZWrr6wUZK6: sea_distant_customs "You have exposure to cultural customs from distant regions that trade with your people."
        }
    }

    # source stat block (page 35)
    #x4AHqOWtjjouFFxSSN6XYN ^"Forest Region" DEF {
        APPLIES TO [#t14626300ed0f58aa6f93a ^"Ronin", #L5R007qR8sT0uV2wX4yZ6a ^"Peasant"]

        PROPERTIES {
            ^"Region" STRING "Forest" FIXED
            ^"Ring Increase" DEF { ^"Earth" INTEGER 1 }
            ^"Skill Increase" STRING "+1 Survival"
            ^"Glory" INTEGER DEFAULT 30
        }

        RULES {
            #L5RPW14nO5pQ7rS9tU1vW3x: forest_navigation_instincts "Your experience navigating dense foliage and shrouded terrain has given you basic instincts that help you avoid getting lost and to find your way again in wilderness circumstances."
            #L5RPW15yZ6aB8cD0eF2gH4i: forest_foraging_hunting_knowledge "You are able to forage, and you possess basic knowledge of hunting techniques, which helps you survive in the forest. You know how to prepare what you find and hunt for consumption."
            #Vm178lLs8DCBcGqxsbjbP8: forest_politics_and_border_disputes "You have a general awareness of the politics and border disputes that affect your region. You know the names of major nobles, family heads, and other leaders, and you are aware of their respective positions and allegiances."
            #cuOlA3yqIBJkHYM6qgFJIy: forest_legends_and_spirits "You are aware of any legends and stories, of spirits or otherwise, that are popular or seem dangerous in your region."
            #D6kHgOxiKrVWK14vz6mRUF: forest_respect_for_the_undergrowth "You value the power and terror of the deep undergrowth and have a healthy respect for the dangers of your region due to either first- or secondhand experience of these hazards."
            #Y2KNBja2jfB9DPNFULcZ4s: forest_animal_behavior "You have working knowledge of animal behaviors and are familiar with the local wildlife of your region."
        }
    }

    # source stat block (page 36)
    #loTyJa9LzRL7rbRNkztPP2 ^"Mountain Region" DEF {
        APPLIES TO [#t14626300ed0f58aa6f93a ^"Ronin", #L5R007qR8sT0uV2wX4yZ6a ^"Peasant"]

        PROPERTIES {
            ^"Region" STRING "Mountain" FIXED
            ^"Ring Increase" DEF { ^"Void" INTEGER 1 }
            ^"Skill Increase" STRING "+1 Meditation"
            ^"Glory" INTEGER DEFAULT 33
        }

        RULES {
            #L5RPW16jK7lM9nO1pQ3rS5t: mountain_trail_pilgrimage_knowledge "Having lived in the mountains in your early life, you know major trails and pilgrimage routes, either from traveling them yourself or from hearing from others who take them. You also possess an understanding of the convictions and tenets of nearby monasteries from the pilgrims and adherents who travel along these routes."
            #L5RPW17uV8wX0yZ2aB4cD6e: mountain_extreme_survival "You have a unique understanding of the demands of living in such an extreme environment and have learned how to survive and secure food and water for yourself by foraging, hunting, or both. You have experience traversing your region and thus can handle similar terrain. You are also familiar with how to navigate steep slopes in extreme weather conditions."
            #k5EhlSOsMskUwkiPKsHgu3: mountain_regional_politics "You have a general awareness of the politics of your region. You can name major nobles, family heads, and other leaders, and you know their respective positions and allegiances."
            #wkmg0G7TtsGuGu7l350f4G: mountain_peaks_and_myths "You are able to identify the names of peaks and features of the mountains and valleys of your region, and you can recall associated myths, tales, or firsthand accounts relating to them."
        }
    }

    # source stat block (page 37)
    #Yz5DjO4tU0H5OTapwhFgR7 ^"Haunted Region" DEF {
        APPLIES TO [#t14626300ed0f58aa6f93a ^"Ronin", #L5R007qR8sT0uV2wX4yZ6a ^"Peasant"]

        PROPERTIES {
            ^"Region" STRING "Haunted" FIXED
            ^"Ring Increase" DEF { ^"Fire" INTEGER 1 }
            ^"Skill Increase" STRING "+1 Command"
            ^"Glory" INTEGER DEFAULT 28
        }

        RULES {
            #L5RPW18fG9hI1jK3lM5nO7p: haunted_taint_recognition "You are familiar with the signs of either the Taint or hauntings, and can identify such effects much earlier than others can."
            #L5RPW19qR0sT2uV4wX6yZ8a: haunted_pragmatism_against_supernatural "Your exposure to the everyday evils of the Taint or another haunted place has numbed you to the strange and the supernatural. Firsthand or secondhand experiences of loss and decay have given you a hard-bitten edge, or at the very least relentless pragmatism when faced with the evils from beyond the Wall."
            #wUxuI1c5aMEoNr0HFvkYVb: haunted_regional_politics "You have a general awareness of the politics of your region, and you can name major nobles, family heads, and other leaders in your area. You know their respective positions and allegiances."
            #PLQWO29ZWonjplBd9oS1AI: haunted_marketable_technique "You have a general knowledge of either farming, mining, or another marketable technique, based on where you were raised."
        }
    }

    # ===========================
    # GAIJIN REGIONAL OPTIONS
    # ===========================

    # source stat block (page 39)
    #IIO6G7RKeSbLZuxnShU2BL ^"Ujik of the Plains of Wind and Stone" DEF {
        APPLIES TO [#t822273f0dfaf436b4dfe8 ^"Gaijin"]

        PROPERTIES {
            ^"Region" STRING "Ujik (Plains of Wind and Stone)" FIXED
            ^"Culture" STRING "Gaijin - Ujik"
            ^"Ring Increase" DEF { ^"Water" INTEGER 1 }
            ^"Skill Increase" STRING "+1 Survival"
            ^"Glory" INTEGER DEFAULT 30
            ^"Starting Equipment Note" STRING "Ujik begin play with a Unicorn warhorse"
        }

        RULES {
            #L5RPW20bC1dE3fG5hI7jK9l: ujik_expert_horsemen "You are an expert in handling and riding horses, as well as in tending to herd animals such as sheep, goats, camels, and cattle. You are also well versed in eking out a living from a harsh and barren land, being skilled at navigating, tracking, hunting, and herbalism in such places."
            #DPZlIU5izygdUB81iNqlOD: ujik_tribes_and_dialects "You have a detailed knowledge of the tribes that make up the Ujik people. You know the various tribal leaders, the specific customs and beliefs of the tribes, and their respective rivalries and allegiances. You also have a reasonable understanding of the numerous dialects of the Ujik language used by the different tribes."
            #CTYWoEhVyW1NyaqOzvs9dq: ujik_mounted_combat_and_warhorse "You are skilled in mounted combat. Ujik begin play with a Unicorn warhouse; see the Unicorn Warhorses sidebar on page 327 of the core rulebook for more information."
        }
    }

    # source stat block (page 40)
    #cn4X0XmkBdCIoiqhTHH93m ^"Qamarists in the Cradle of the World" DEF {
        APPLIES TO [#t822273f0dfaf436b4dfe8 ^"Gaijin"]

        PROPERTIES {
            ^"Region" STRING "Qamarist (Cradle of the World)" FIXED
            ^"Culture" STRING "Gaijin - Qamarist"
            ^"Ring Increase" DEF { ^"Fire" INTEGER 1 }
            ^"Skill Increase" STRING "+1 Theology"
            ^"Glory" INTEGER DEFAULT 29
        }

        RULES {
            #L5RPW22xY3zA5bC7dE9fG1h: qamarist_caliphate_politics "You have detailed knowledge of the Caliphate, including both the secular and religious politics that affect it. You also know about the caliph as well as the important and influential people who surround the caliph."
            #jI8rnDTd0UJ0IqinVvrLgl: qamarist_ethnic_groups_and_languages "You have a good knowledge of the various ethnic groups that fall under the sway of the Caliphate. You know the various important figures and specific customs of each group and their respective rivalries and allegiances. You also speak the language of at least one such group—your own—fluently, and you are at least conversant with the languages of most of the others."
            #YrIXBrXAXMqBxTJeNznysD: qamarist_folklore "You are familiar with what, to the Rokugani, would be strange folklore, some of which supposedly arises from a time before mortals. This includes creatures such as the foul undead ghul; the powerful and dangerous spirits known as djinn; the massive eagle known as roc; and the shahmaran, or Queen of the Snakes, which may be a reference to the enigmatic creatures known in Rokugan as the naga."
        }
    }

    # source stat block (page 41)
    #84jbjpmd3w62CnioHDdtcu ^"Yodha of the Ghostlands" DEF {
        APPLIES TO [#t822273f0dfaf436b4dfe8 ^"Gaijin"]

        PROPERTIES {
            ^"Region" STRING "Yodha (Ghostlands)" FIXED
            ^"Culture" STRING "Gaijin - Ivory Kingdoms"
            ^"Ring Increase" DEF { ^"Earth" INTEGER 1 }
            ^"Skill Increase" STRING "+1 Theology"
            ^"Glory" INTEGER DEFAULT 29
        }

        RULES {
            #L5RPW24tU5vW7xY9zA1bC3d: yodha_shadowlands_threats "You have a detailed understanding of Shadowlands threats insofar as they apply to the Ivory Kingdoms. While the Shadowlands Taint functions the same as it does in Rokugan, many other Shadowlands aspects you know about are different, reflecting the different creatures in the Ghostlands and the ways your group has developed to combat them. For example, you know about the nature of rakshasa. The more traditionalist Yodhaviya, who dwell outside the Ghostlands, are particularly adept at recognizing these dangerous creatures irrespective of the form they assume. You also know that, with application of the correct rituals, gold and coral are powerful weapons against the Shadowlands and its minions."
            #d4yk9CTR4HqxVSEpQfBaUf: yodha_ivory_kingdoms_politics "You have a good knowledge of the many political entities that make up the Ivory Kingdoms and of the secular and religious tensions, rivalries, and alliances that exist among them. That said, there are gaps and flaws in that knowledge, as the numerous kingdoms and relationships among them are constantly changing. Yodha speak their own language and the common language spoken by most citizens of the Ivory Kingdoms, as well as the languages of those kingdoms and states close to the Ghostlands."
            #G11X2n8xpdGiLjzoeeExmf: yodha_nikta_and_pillars_of_purity "Yodhaniya—particularly those who wage war deep in the Ghostlands rainforest—know how to purify even the most fouled food and water using a ritual known as Nikta. You are also aware of the existence of the Pillars of Purity, ancient and mysterious stone columns that stand astride the Nadati River, removing the taint from its waters as they flow past."
            #J7kg2BdgWQEDCo3W1vKYBN: yodha_naga "The Yodha, like most citizens of the Ivory Kingdoms, not only know the naga are real but have come to know the naga well, including some aspects of their language and culture. Known in the Ivory Kingdoms as shahmaran, naga are common in the region."
        }
    }

    # source stat block (page 42)
    #hFvBVSM1v51DL0eAx8skBP ^"Sheelavaan of Bhavyatapura" DEF {
        APPLIES TO [#t822273f0dfaf436b4dfe8 ^"Gaijin"]

        PROPERTIES {
            ^"Region" STRING "Sheelavaan (Bhavyatapura)" FIXED
            ^"Culture" STRING "Gaijin - Ivory Kingdoms"
            ^"Ring Increase" DEF { ^"Air" INTEGER 1 }
            ^"Skill Increase" STRING "+1 Courtesy"
            ^"Glory" INTEGER DEFAULT 28
        }

        RULES {
            #L5RPW26pQ7rS9tU1vW3xY5z: sheelavaan_urban_sophistication "You are most at home in urban areas and have a great facility for quickly understanding not just the physical layout of a city, but also its key power structures, factions, and underlying tensions."
            #L5RPW27aB8cD0eF2gH4iJ6k: sheelavaan_trade_and_commerce "You have a good understanding of trade and commerce, being able to discern the value of most goods and items and to bargain for favorable prices or trades. More generally, you tend to be quite persuasive in any dealings you have with others—particularly those not familiar with the eloquence of the Sheelavaan."
            #p2Qf7x2s3y774SfcAX0IWE: sheelavaan_factions_and_languages "You have a general knowledge of the many factions that make up the Ivory Kingdoms, but they are particularly aware of those specific to Bhavyatapura. This includes the many rivalries and alliances that exist in this massive, rambling city. You speak your own language as well as the common language of the Ivory Kingdoms, and often one or more languages of the various factions in Bhavyatapura."
            #oDOua5MjITDaRM8womG1iC: sheelavaan_naga "Close proximity to the naga has given you an even better knowledge of the enigmatic serpent folk than most—at least, to the extent any human can understand this mysterious species. The Sheelavaan, like most citizens of the Ivory Kingdoms, not only know the naga are real but have come to know the naga well, including some aspects of their language and culture. Known in the Ivory Kingdoms as shahmaran, naga are common in the region."
        }
    }

    # ===========================
    # QUESTION 2: UPBRINGINGS
    # ===========================

    # source stat block (page 43)
    #B1DHcH14Afz1kdkvWRgmgI ^"Craftsperson Upbringing" DEF {
        APPLIES TO [#t14626300ed0f58aa6f93a ^"Ronin", #L5R007qR8sT0uV2wX4yZ6a ^"Peasant", #t822273f0dfaf436b4dfe8 ^"Gaijin"]

        PROPERTIES {
            ^"Upbringing" STRING "Craftsperson" FIXED
            ^"Ring Increase" DEF { CHOOSE 1 [^"Earth", ^"Void"] INTEGER 1 }
            ^"Skill Increases" DEF {
                ^"Culture" INTEGER 1
                ^"Design" INTEGER 1
            }
            ^"Status Modification" INTEGER -2
            ^"Wealth" DEF { ^"Count" INTEGER 1  ^"Type" STRING "koku"  ^"Starting" BOOLEAN true }
        }
    }

    # source stat block (page 43)
    #60FyeOVH5AeumSTQfQFL2v ^"Fallen Noble Upbringing" DEF {
        APPLIES TO [#t14626300ed0f58aa6f93a ^"Ronin", #L5R007qR8sT0uV2wX4yZ6a ^"Peasant", #t822273f0dfaf436b4dfe8 ^"Gaijin"]

        PROPERTIES {
            ^"Upbringing" STRING "Fallen Noble" FIXED
            ^"Ring Increase" DEF {
                FROM_CLAN ^"<Chosen Clan>"."Clan Ring Bonus" FALLBACK {
                    CHOOSE 1 [^"Air", ^"Earth", ^"Fire", ^"Water", ^"Void"] INTEGER 1
                }
            }
            ^"Skill Increases" DEF {
                FROM_CLAN ^"<Chosen Clan>"."Clan Skill Bonus" FALLBACK {
                    CHOOSE DISTINCT 2 [
                        ^"Aesthetics", ^"Command", ^"Commerce", ^"Composition",
                        ^"Courtesy", ^"Culture", ^"Design", ^"Fitness",
                        ^"Games", ^"Government", ^"Labor", ^"Martial Arts [Melee]",
                        ^"Martial Arts [Ranged]", ^"Martial Arts [Unarmed]", ^"Medicine", ^"Meditation",
                        ^"Performance", ^"Seafaring", ^"Sentiment", ^"Skulduggery",
                        ^"Smithing", ^"Survival", ^"Tactics", ^"Theology"
                    ] INTEGER 1
                }
            }
            ^"Status Modification" INTEGER 10
            ^"Item" DEF { ^"Count" INTEGER 1  ^"Description" STRING "An heirloom worth 3 koku"  ^"Starting" BOOLEAN true }
            ^"Item" DEF { ^"Count" INTEGER 1  ^"Description" STRING "wakizashi"  ^"Starting" BOOLEAN true }
        }
    }

