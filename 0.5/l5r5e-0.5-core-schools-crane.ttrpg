BASE "L5R5e_Core_Schools_Crane" {
    NAME "Legend of the Five Rings 5th Edition - Crane Clan Schools"
    VERSION "0.5.3"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-03-01"

    # Core Rulebook: Crane Clan Schools (pages 62-66)
    # The Crane Clan is concerned foremost with preserving Rokugani culture
    # and ensuring civility in the courts.

    # ===========================
    # ASAHINA ARTIFICER [Shugenja, Artisan]
    # ===========================

    #t9add0d08a192de50e8fd9 ^"Asahina Artificer" DEF {
        EXTENDS #L5R252wX4yZ6aB8cD0eF2g ^"School"
        APPLIES TO [#L5R003xY4zA6bC8dE0fG2hI ^"Samurai"]

        PROPERTIES {
            ^"School Name" STRING "Asahina Artificer" FIXED
            ^"Clan" STRING "Crane"
            ^"Roles" LIST ["Shugenja", "Artisan"]
            ^"Ring Increase" DEF {
                ^"Air" INTEGER 1
                ^"Fire" INTEGER 1
            }
            ^"Starting Skills" DEF { CHOOSE 3 [^"Aesthetics", ^"Courtesy", ^"Culture", ^"Design", ^"Games", ^"Theology"] INTEGER 1 }
            ^"Starting Honor" INTEGER DEFAULT 50
            ^"Techniques Available" LIST ["Invocations", "Rituals", "Shūji"]
        }

        STARTING_TECHNIQUES {
            INVOCATION CHOOSE 3 [^"Blessed Wind", ^"Armor of Radiance", ^"Inari's Blessing", ^"Reflections of P'an Ku", ^"Token of Memory"]
            RITUAL ^"Commune with the Spirits"
            RITUAL ^"Cleansing Rite"
        }

        SCHOOL_ABILITY "Spiritual Artisan" {
            "When making a check to mystically summon an illusion or to summon, augment, or awaken an object, you may add a number of kept (ring) set to (op) results equal to your school rank."
        }

        MASTERY_ABILITY ^"Stir the Slumbering Spirit" {
            "Once per game session as a downtime activity, you may make a TN 4 Artisan (Void) check to awaken an item's spirit. If you succeed, until the end of the game session, it becomes a nemuranai (see page 307) with a sealed invocation of your choice based on the item's history. The GM is the final arbiter of the appropriateness of any invocation selected this way."
        }

        STARTING_OUTFIT [
            "Sanctified robes",
            "wakizashi (short sword)", "knife",
            "yumi (bow)", "quiver of arrows",
            "scroll satchel", "traveling pack"
        ]

        CURRICULUM {
            RANK 1 {
                SKILL_GROUP "Artisan Skills"
                SKILL "Courtesy"
                SKILL "Culture"
                SKILL "Theology"
                TECHNIQUE_GROUP "Rank 1 Air Invocations"
                ^"Path to Inner Peace" [invocation]
                ^"Artisan's Appraisal" [shuji]
            }
            RANK 2 {
                SKILL_GROUP "Scholar Skills"
                SKILL "Aesthetics"
                SKILL "Design"
                SKILL "Performance"
                TECHNIQUE_GROUP "Rank 1-2 Water Invocations"
                ^"Grasp of the Air Dragon" [invocation]
                ^"Tea Ceremony" [ritual]
            }
            RANK 3 {
                SKILL_GROUP "Social Skills"
                SKILL "Aesthetics"
                SKILL "Design"
                SKILL "Theology"
                TECHNIQUE_GROUP "Rank 1-3 Fire Invocations"
                ^"Wings of the Phoenix" [invocation]
                ^"Vapor of Nightmare" [invocation]
            }
            RANK 4 {
                SKILL_GROUP "Artisan Skills"
                SKILL "Fitness"
                SKILL "Performance"
                SKILL "Theology"
                TECHNIQUE_GROUP "Rank 1-4 Water Invocations"
                ^"Bend with the Storm" [shuji]
                ^"Rise, Air" [invocation]
            }
            RANK 5 {
                SKILL_GROUP "Scholar Skills"
                SKILL "Aesthetics"
                SKILL "Design"
                SKILL "Performance"
                TECHNIQUE_GROUP "Rank 1-5 Air Invocations"
                ^"Ever-Changing Waves" [invocation]
                ^"Buoyant Arrival" [shuji]
            }
            RANK 6 {
                ^"Stir the Slumbering Spirit"
            }
        }

        RULES {
            #jjiOpoS2SBOwMjzjz2vX6u: school_description "Art and religion intertwine for the Asahina, for to them, faith, beauty, and peace are all aspects of the same truth. The Asahina take any opportunity to teach their philosophy and try to improve harmony in the Empire. Their focus on the creation of beautiful things is simply another aspect of their attempt to spread art and peace throughout Rokugan. Many a conflict has been defused by an Asahina religious ritual that presented a peaceful path forward. The Asahina do their utmost to live their pacifistic ideals in a world fraught with conflict. It is arduous, but they persevere, secure in their beliefs."
            #hyLYXYGeMW8uUzWhc43MYD: invocation_names "Asahina Invocations: The Asahina Artificer School teaches its students invocations by Elemental names, for they continue the traditions passed down from Isawa Asahina, their founder. (See Invocation Names and Traditions on page 190 in Chapter 4: Techniques)."
        }
    }

    # ===========================
    # DAIDOJI IRON WARRIOR [Bushi]
    # ===========================

    #nh0nyHUp0osfAy5DrG9pEv ^"Daidoji Iron Warrior" DEF {
        EXTENDS #L5R252wX4yZ6aB8cD0eF2g ^"School"
        APPLIES TO [#L5R003xY4zA6bC8dE0fG2hI ^"Samurai"]

        PROPERTIES {
            ^"School Name" STRING "Daidoji Iron Warrior" FIXED
            ^"Clan" STRING "Crane"
            ^"Roles" LIST ["Bushi"]
            ^"Ring Increase" DEF {
                ^"Earth" INTEGER 1
                ^"Water" INTEGER 1
            }
            ^"Starting Skills" DEF { CHOOSE 5 [^"Command", ^"Courtesy", ^"Culture", ^"Fitness", ^"Government", #Nz42rDSYYoVFWHst6Mu3QY ^"Martial Arts [Melee]", ^"Tactics"] INTEGER 1 }
            ^"Starting Honor" INTEGER DEFAULT 55
            ^"Techniques Available" LIST ["Kata", "Rituals", "Shūji"]
        }

        STARTING_TECHNIQUES {
            KATA ^"Iron Forest Style"
            KATA CHOOSE 1 [^"Striking as Earth", ^"Striking as Water"]
        }

        SCHOOL_ABILITY "Vigilance of Mind" {
            "Once per round, when another character within range of one of your readied melee weapons would suffer physical damage, you may intercept. If you do, you may suffer fatigue up to your school rank to reduce the damage the target suffers by twice that amount."
        }

        MASTERY_ABILITY ^"To Tread the Sword" {
            "When you use the Guard action, instead of guarding one character, you may choose to guard a number of other characters in range up to your ranks in Martial Arts [Melee]."
        }

        STARTING_OUTFIT [
            "Lacquered armor", "ceremonial clothes",
            "daishō (katana and wakizashi)",
            "yari (spear) or naginata (polearm)",
            "yumi (bow)", "quiver of arrows",
            "knife", "calligraphy set", "traveling pack"
        ]

        CURRICULUM {
            RANK 1 {
                SKILL_GROUP "Martial Skills"
                SKILL "Courtesy"
                SKILL "Government"
                SKILL "Sentiment"
                TECHNIQUE_GROUP "Rank 1 Kata"
                ^"Crescent Moon Style" [kata]
                ^"Stonewall Tactics" [shuji]
            }
            RANK 2 {
                SKILL_GROUP "Scholar Skills"
                SKILL "Courtesy"
                SKILL "Martial Arts [Melee]"
                SKILL "Tactics"
                TECHNIQUE_GROUP "Rank 1-2 Earth Shūji"
                ^"Flowing Water Strike" [kata]
                ^"Lady Doji's Decree" [shuji]
            }
            RANK 3 {
                SKILL_GROUP "Martial Skills"
                SKILL "Command"
                SKILL "Courtesy"
                SKILL "Sentiment"
                TECHNIQUE_GROUP "Rank 1-3 Kata"
                ^"Crashing Wave Style" [kata]
                ^"Ebb and Flow" [shuji]
            }
            RANK 4 {
                SKILL_GROUP "Social Skills"
                SKILL "Fitness"
                SKILL "Martial Arts [Melee]"
                SKILL "Tactics"
                TECHNIQUE_GROUP "Rank 1-4 Air Shūji"
                ^"Striking as Void" [kata]
                ^"A Samurai's Fate" [shuji]
            }
            RANK 5 {
                SKILL_GROUP "Martial Skills"
                SKILL "Aesthetics"
                SKILL "Culture"
                SKILL "Government"
                TECHNIQUE_GROUP "Rank 1-5 Kata"
                ^"The Immovable Hand of Peace" [shuji]
                ^"Rouse the Soul" [shuji]
            }
            RANK 6 {
                ^"To Tread the Sword"
            }
        }

        RULES {
            #XfSbShiWGNGyJrXzZ3Noqh: school_description "The warriors from the Daidoji dōjō form the core of their clan's small standing army. They are highly trained heavy infantry who can hold the line and delay the advance of any foe. Many enemies have broken on the unwavering spears and iron discipline of the Daidoji Iron Warriors. When there are no wars to fight, many are assigned as protectors of Crane castles or as yōjimbō (bodyguards) to traveling Crane courtiers. Their watchfulness and solidarity have prevented countless heated moments from getting out of hand, though it is said that most Daidoji prefer the honesty of the battlefield."
        }
    }

    # ===========================
    # DOJI DIPLOMAT [Courtier]
    # ===========================

    #bEN7T5Ojh0qHMYmAl9lkJW ^"Doji Diplomat" DEF {
        EXTENDS #L5R252wX4yZ6aB8cD0eF2g ^"School"
        APPLIES TO [#L5R003xY4zA6bC8dE0fG2hI ^"Samurai"]

        PROPERTIES {
            ^"School Name" STRING "Doji Diplomat" FIXED
            ^"Clan" STRING "Crane"
            ^"Roles" LIST ["Courtier"]
            ^"Ring Increase" DEF {
                ^"Air" INTEGER 1
                ^"Water" INTEGER 1
            }
            ^"Starting Skills" DEF { CHOOSE 5 [^"Aesthetics", ^"Composition", ^"Courtesy", ^"Culture", ^"Design", ^"Government", ^"Martial Arts [Ranged]"] INTEGER 1 }
            ^"Starting Honor" INTEGER DEFAULT 50
            ^"Techniques Available" LIST ["Kata", "Rituals", "Shūji"]
        }

        STARTING_TECHNIQUES {
            SHUJI CHOOSE 1 [^"Cadence", ^"Shallow Waters", ^"Whispers of Court"]
            SHUJI ^"Lady Doji's Decree"
        }

        SCHOOL_ABILITY "Speaking in Silence" {
            "Once per scene when making a check to persuade or influence someone, you may add a number of kept (ring) set to a (op) results equal to your school rank."
        }

        MASTERY_ABILITY ^"The Lady's Grace" {
            "Once per scene, you may spend 1 Void point to reduce your strife to 0. When you do, each friendly character in the scene may reduce their strife by your honor rank."
        }

        STARTING_OUTFIT [
            "Ceremonial clothes",
            "wakizashi (short sword)",
            "yumi (bow) or yari (spear)",
            "calligraphy set", "traveling pack",
            "an attendant or Rokugani pony"
        ]

        CURRICULUM {
            RANK 1 {
                SKILL_GROUP "Social Skills"
                SKILL "Aesthetics"
                SKILL "Culture"
                SKILL "Composition"
                TECHNIQUE_GROUP "Rank 1 Air Shūji"
                ^"Civility Foremost" [shuji]
                ^"Tea Ceremony" [ritual]
            }
            RANK 2 {
                SKILL_GROUP "Scholar Skills"
                SKILL "Command"
                SKILL "Courtesy"
                SKILL "Tactics"
                TECHNIQUE_GROUP "Rank 1-2 Water Shūji"
                ^"The Wind Blows Both Ways" [shuji]
                ^"Artisan's Appraisal" [shuji]
            }
            RANK 3 {
                SKILL_GROUP "Artisan Skills"
                SKILL "Courtesy"
                SKILL "Games"
                SKILL "Performance"
                TECHNIQUE_GROUP "Rank 1-3 Earth Shūji"
                ^"Regal Bearing" [shuji]
                ^"Ebb and Flow" [shuji]
            }
            RANK 4 {
                SKILL_GROUP "Social Skills"
                SKILL "Government"
                SKILL "Composition"
                SKILL "Tactics"
                TECHNIQUE_GROUP "Rank 1-4 Air Shūji"
                ^"Bend with the Storm" [shuji]
                ^"Pillar of Calm" [shuji]
            }
            RANK 5 {
                SKILL_GROUP "Scholar Skills"
                SKILL "Aesthetics"
                SKILL "Courtesy"
                SKILL "Command"
                TECHNIQUE_GROUP "Rank 1-5 Void Shūji"
                ^"Buoyant Arrival" [shuji]
                ^"The Immovable Hand of Peace" [shuji]
            }
            RANK 6 {
                ^"The Lady's Grace"
            }
        }

        RULES {
            #vu3gVJdMwonT2Ucz22srSw: school_description "No one plays the game of court better than the Crane—after all, their clan wrote the rules. The Doji Diplomats choreograph the courtly dance of favors exchanged, gifts given, and the right people invited to private gatherings. The Doji are always on the leading edge of fashion and culture, and Doji Diplomats need never use an unkind word: their silence speaks volumes, and a simple gesture says even more. Their networks of favors, gifts, and invitations allow them to weigh the ebb and flow of the social side of the Empire and adjust the scales to their benefit."
        }
    }

    # ===========================
    # KAKITA DUELIST [Bushi, Artisan]
    # ===========================

    #t2f4a03e3782b0a8fe51a9 ^"Kakita Duelist" DEF {
        EXTENDS #L5R252wX4yZ6aB8cD0eF2g ^"School"
        APPLIES TO [#L5R003xY4zA6bC8dE0fG2hI ^"Samurai"]

        PROPERTIES {
            ^"School Name" STRING "Kakita Duelist" FIXED
            ^"Clan" STRING "Crane"
            ^"Roles" LIST ["Bushi", "Artisan"]
            ^"Ring Increase" DEF {
                ^"Air" INTEGER 1
                ^"Earth" INTEGER 1
            }
            ^"Starting Skills" DEF { CHOOSE 5 [^"Courtesy", ^"Design", ^"Fitness", #Nz42rDSYYoVFWHst6Mu3QY ^"Martial Arts [Melee]", ^"Meditation", ^"Sentiment", ^"Smithing"] INTEGER 1 }
            ^"Starting Honor" INTEGER DEFAULT 50
            ^"Techniques Available" LIST ["Kata", "Rituals", "Shūji"]
        }

        STARTING_TECHNIQUES {
            KATA ^"Iaijutsu Cut: Rising Blade"
            SHUJI CHOOSE 1 [^"Shallow Waters", ^"Weight of Duty"]
        }

        SCHOOL_ABILITY "Way of the Crane" {
            "Once per round, you may increase or decrease the severity of a critical strike you inflict by an amount up to your school rank."
        }

        MASTERY_ABILITY ^"Strike with No Thought" {
            "Once per scene, as an Attack and Movement action, you may make a Martial Arts [Melee] (Void) check targeting one character at range 2-3 using a sheathed katana or wakizashi. The TN of this check is equal to your target's vigilance. You immediately move to range 1 of your target and draw the weapon you used. If you succeed, your target suffers a critical strike with severity equal to the deadliness of your weapon plus your bonus successes. (op)+: One character of your choice at range 0-2 of your target per (op) spent this way suffers the Dazed and Disoriented conditions. (op)(op)+: Treat the maximum range of this technique as 1 higher per (op)(op) spent this way."
        }

        STARTING_OUTFIT [
            "Traveling clothes", "ceremonial clothes",
            "daishō (katana and wakizashi)",
            "yari (spear) or yumi (bow)", "quiver of arrows",
            "traveling pack",
            "an attendant or Rokugani pony"
        ]

        CURRICULUM {
            RANK 1 {
                SKILL_GROUP "Martial Skills"
                SKILL "Aesthetics"
                SKILL "Courtesy"
                SKILL "Sentiment"
                TECHNIQUE_GROUP "Rank 1 Kata"
                ^"Iaijutsu Cut: Crossing Blade" [kata]
                ^"Cadence" [shuji]
            }
            RANK 2 {
                SKILL_GROUP "Scholar Skills"
                SKILL "Martial Arts [Melee]"
                SKILL "Martial Arts [Ranged]"
                SKILL "Smithing"
                TECHNIQUE_GROUP "Rank 1-2 Kata"
                ^"All Arts Are One" [shuji]
                ^"Thunderclap Strike" [kata]
            }
            RANK 3 {
                SKILL_GROUP "Artisan Skills"
                SKILL "Martial Arts [Melee]"
                SKILL "Meditation"
                SKILL "Survival"
                TECHNIQUE_GROUP "Rank 1-3 Air Shūji"
                ^"A Samurai's Fate" [shuji]
                ^"Heartpiercing Strike" [kata]
            }
            RANK 4 {
                SKILL_GROUP "Social Skills"
                SKILL "Fitness"
                SKILL "Tactics"
                SKILL "Martial Arts [Melee]"
                TECHNIQUE_GROUP "Rank 1-4 Kata"
                ^"Striking as Void" [kata]
                ^"Pillar of Calm" [shuji]
            }
            RANK 5 {
                SKILL_GROUP "Martial Skills"
                SKILL "Aesthetics"
                SKILL "Survival"
                SKILL "Theology"
                TECHNIQUE_GROUP "Rank 1-5 Fire Shūji"
                ^"Soul Sunder" [kata]
                ^"Rouse the Soul" [shuji]
            }
            RANK 6 {
                ^"Strike with No Thought"
            }
        }

        RULES {
            #LwEnhirQPWyhiQYBdwD5zs: school_description "The Kakita Duelist School emphasizes \"one strike, one kill,\" seeking for its students to master the one perfect strike performed in an iaijutsu duel. For the Kakita Duelists, such is the pinnacle of all martial skills. While other martial skills are not neglected, neither are they the focus of the Kakita Dueling Academy in Tsu ma. Although some might critique such single-mind ed dedication, the Kakita Duelists are the best in the Empire. Their skill with the katana in this arena complements the Doji mastery of court, and reinforces the Crane hold on the political flow of the Empire."
        }
    }
}
