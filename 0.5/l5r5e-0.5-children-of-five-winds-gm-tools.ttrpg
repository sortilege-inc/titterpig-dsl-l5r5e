        RULES {
            #L5RCW22b24d92e7184532bf2926: wild_desert_horse "Wild Desert Horse: Herds of untamed feral horses still roam the steppes and deserts beyond Rokugan's borders. Unlike those descended from domesticated stock, wild horses tend to be shorter and stockily built, and they have a striped or dotted shaggy coat that is shed in summer. Their fight-or-flight instincts are much greater than those of domesticated horses, and they are far more likely to elect \"fight.\""
        }
    }

    # ===========================
    # PEOPLES OF THE SAND ROAD NPCs
    # ===========================

    # source stat block (page 148)
    ^"Qamarist Philosopher" DEF {
        EXTENDS #t4540de6f35155c46f41f0 ^"NPC"

        PROPERTIES {
            ^"Type" STRING "Adversary" FIXED
            ^"Combat Conflict Rank" INTEGER 1
            ^"Intrigue Conflict Rank" INTEGER 4
            ^"Description" STRING "Scholar of Qamarist natural philosophy, dedicated to rigorous study of ethics, principles, and the natural world."
            ^"Rings" DEF {
                ^"Air" INTEGER 4
                ^"Earth" INTEGER 2
                ^"Fire" INTEGER 2
                ^"Water" INTEGER 3
                ^"Void" INTEGER 2
            }
            ^"Endurance" INTEGER 6
            ^"Composure" INTEGER 10
            ^"Focus" INTEGER 6
            ^"Vigilance" INTEGER 3
            ^"Honor" INTEGER 50
            ^"Glory" INTEGER 30
            ^"Status" INTEGER 45
            ^"Demeanor" STRING "Aloof"
            ^"Social Skill Check TN Modifiers" STRING "Air +2, Fire -2"
            ^"Skills" LIST OF STRING ["Artisan 2", "Martial 0", "Scholar 3", "Social 2", "Trade 1"]
            ^"Advantages" LIST OF STRING ["Flexible Mind (Air) [Scholar; Mental, Spiritual]"]
            ^"Disadvantages" LIST OF STRING ["Obsessive (Air) [Social; Interpersonal, Mental]"]
            ^"Gear" LIST OF STRING ["Passable clothes", "Abacus", "Sextant or astrolabe", "Calligraphy set", "Laboratory or small personal library"]
        }

        ^"Natural Philosophy" DEF {
            ^"Description" STRING "The Qamarist philosopher may make a Culture (Air) check, targeting one character in the scene. The TN is equal to the target's Air Ring. If the philosopher succeeds, they make a scientific or academic observation that lets them learn one fact about the target. :opp::opp:: The Qamarist philosopher learns one of the target's advantages or disadvantages of the target's choice."
        }

        RULES {
            #L5RCW2366057377012be04fef34: qamarist_philosopher "Qamarist Philosopher: A long-standing tradition of Qamarist study has developed into the broad area of inquiry known as philosophy. Philosophy refers not only to the study of ethics and morals but also to investigation into reality's basic principles, from how the mountains formed to how fire can be applied to water to produce steam and thus power. A philosopher can be anyone who has taken on a rigorous study of any subject matter, whether they are Qamarist, Rokugani, or from more distant lands, though they may have different titles in other locations."
        }
    }

    # source stat block (page 148)
    ^"Qamarist Pilgrim" DEF {
        EXTENDS #t4540de6f35155c46f41f0 ^"NPC"

        PROPERTIES {
            ^"Type" STRING "Minion" FIXED
            ^"Combat Conflict Rank" INTEGER 1
            ^"Intrigue Conflict Rank" INTEGER 2
            ^"Description" STRING "Traveler on a spiritual pilgrimage to holy sites, seeking enlightenment and visiting family."
            ^"Rings" DEF {
                ^"Air" INTEGER 4
                ^"Earth" INTEGER 2
                ^"Fire" INTEGER 2
                ^"Water" INTEGER 3
                ^"Void" INTEGER 2
            }
            ^"Endurance" INTEGER 7
            ^"Composure" INTEGER 6
            ^"Focus" INTEGER 2
            ^"Vigilance" INTEGER 2
            ^"Honor" INTEGER 35
            ^"Glory" INTEGER 20
            ^"Status" INTEGER 15
            ^"Demeanor" STRING "Meditative"
            ^"Social Skill Check TN Modifiers" STRING "Void +2, Fire -2"
            ^"Skills" LIST OF STRING ["Artisan 1", "Martial 0", "Scholar 1", "Social 2", "Trade 2"]
            ^"Advantages" LIST OF STRING ["Partial Enlightenment (Void) [Scholar; Spiritual]"]
            ^"Disadvantages" LIST OF STRING ["Deferential (Void) [Social; Interpersonal, Mental]"]
            ^"Favored Weapons" LIST OF STRING ["Improvised Weapon: Range 1, Damage 2, Deadliness 3/4"]
            ^"Gear" LIST OF STRING ["Traveling clothes (Physical 2, Durable, Mundane, Subtle)", "Offerings", "Camel or horse", "Gifts for family and friends"]
        }

        ^"Introspection" DEF {
            ^"Description" STRING "When a Qamarist pilgrim makes a check targeting a character with a higher glory rank, the pilgrim treats the target's vigilance as 1 lower."
        }

        RULES {
            #L5RCW2463ebd150173bb75ba23a: qamarist_pilgrim "Qamarist Pilgrim: On a journey superficially similar to musha shugyō, Qamarist pilgrims travel to holy sites for spiritual fulfillment and general travel, and to visit family and friends. Most Qamarists undertake pilgrimages at regular intervals, so this NPC profile does not reflect an occupation or permanent way of life. In fact, while it is designed with a Qamarist in mind, it can reflect a person of any religion or nationality; anyone can undertake a pilgrimage as long as they focus on spiritual understanding over trade or travel solely for travel's sake."
        }
    }

    # source stat block (page 149)
    ^"Ujik Guide" DEF {
        EXTENDS #t4540de6f35155c46f41f0 ^"NPC"

        PROPERTIES {
            ^"Type" STRING "Minion" FIXED
            ^"Combat Conflict Rank" INTEGER 2
            ^"Intrigue Conflict Rank" INTEGER 2
            ^"Description" STRING "Expert navigator of the Sand Road with unmatched knowledge of the paths between Rokugan and the Caliphate."
            ^"Rings" DEF {
                ^"Air" INTEGER 2
                ^"Earth" INTEGER 3
                ^"Fire" INTEGER 1
                ^"Water" INTEGER 2
                ^"Void" INTEGER 1
            }
            ^"Endurance" INTEGER 10
            ^"Composure" INTEGER 10
            ^"Focus" INTEGER 3
            ^"Vigilance" INTEGER 2
            ^"Honor" INTEGER 25
            ^"Glory" INTEGER 29
            ^"Status" INTEGER 9
            ^"Demeanor" STRING "Shrewd"
            ^"Social Skill Check TN Modifiers" STRING "Air +2, Fire -2"
            ^"Skills" LIST OF STRING ["Artisan 0", "Martial 1", "Scholar 0", "Social 2", "Trade 2"]
            ^"Advantages" LIST OF STRING ["Perfect Sense of Direction (Earth) [Trade; Mental]"]
            ^"Disadvantages" LIST OF STRING ["Too Talkative (Earth) [Social; Infamy]"]
            ^"Favored Weapons" LIST OF STRING ["Hunting Bow: Range 2-4, Damage 4, Deadliness 5", "Spear: Range 2, Damage 5, Deadliness 3"]
            ^"Gear" LIST OF STRING ["Traveling clothes (Physical 2, Durable, Mundane, Subtle)", "Quiver", "Horse or camel", "Recently hunted small game", "Collection of pelts"]
        }

        ^"Improvised Tools" DEF {
            ^"Description" STRING "When making a Trade skill (Fire) check, the Ujik guide may spend :opp: in the following way: :opp:: The Ujik guide can scavenge enough materials for the equivalent of a single-use kit (such as a bowyer's kit, divination kit, or medicine kit)."
        }

        RULES {
            #L5RCW251f9570cfad2f3fcad529: ujik_guide "Ujik Guide: No one knows the many paths of the Sand Road better than the Ujik people. Travelers often say you cannot go wrong hiring an Ujik guide. Yet anyone with knowledge of the Sand Road can be a guide, as it describes knowledge more than a profession. This profile can apply to anyone with personal knowledge of an area, be it in Rokugan, in the Caliphate, along the Sand Road, or in some other land."
        }
    }

    # source stat block (page 149)
    ^"Ujik Trader" DEF {
        EXTENDS #t4540de6f35155c46f41f0 ^"NPC"

        PROPERTIES {
            ^"Type" STRING "Minion" FIXED
            ^"Combat Conflict Rank" INTEGER 2
            ^"Intrigue Conflict Rank" INTEGER 3
            ^"Description" STRING "Bustling trader leveraging knowledge of Rokugani and Qamarist cultures to facilitate trade along the Sand Road."
            ^"Rings" DEF {
                ^"Air" INTEGER 2
                ^"Earth" INTEGER 2
                ^"Fire" INTEGER 1
                ^"Water" INTEGER 2
                ^"Void" INTEGER 1
            }
            ^"Endurance" INTEGER 6
            ^"Composure" INTEGER 8
            ^"Focus" INTEGER 3
            ^"Vigilance" INTEGER 2
            ^"Honor" INTEGER 20
            ^"Glory" INTEGER 29
            ^"Status" INTEGER 9
            ^"Demeanor" STRING "Gregarious"
            ^"Social Skill Check TN Modifiers" STRING "Fire +2, Earth -2"
            ^"Skills" LIST OF STRING ["Artisan 1", "Martial 1", "Scholar 0", "Social 2", "Trade 3"]
            ^"Advantages" LIST OF STRING ["Daikoku's Blessing (Water) [Social; Interpersonal, Spiritual]"]
            ^"Disadvantages" LIST OF STRING ["Quarrelsome (Void) [Social; Interpersonal]"]
            ^"Favored Weapons" LIST OF STRING ["Spear: Range 2, Damage 5, Deadliness 3"]
            ^"Gear" LIST OF STRING ["Traveling clothes (Physical 2, Durable, Mundane, Subtle)", "Abacus", "Handful of bu or equivalent currency", "Camel or horse", "Packs of goods"]
        }

        ^"The Right Prize, The Right Price" DEF {
            ^"Description" STRING "Once per scene as an action, the Ujik trader may make a Commerce (Water) check to determine whether an item they have is something another character wants. The TN is equal to the item's rarity minus 2, along with other modifiers per GM's discretion. :opp::opp:: The Ujik trader can increase the price of this item by one-quarter per :opp::opp: spent this way, and the item is not available anywhere else at this time."
        }

        RULES {
            #L5RCW264070ed594c80a3817234: ujik_trader "Ujik Trader: Bustling and vibrant trade occurs between Rokugan and the Caliphate along the Sand Road. Ujik traders take horse, camel, and cart to buy and sell wares, appealing to the differences and commonalities between all the peoples they encounter. Numerous Ujik traders accrue substantial wealth, serving as intermediaries between Qamarists and Rokugani, leveraging their understanding of both cultures and languages."
        }
    }

    # ===========================
    # SPIRITS AND STRANGE BEINGS NPCs
    # ===========================

    # source stat block (page 150)
    ^"Chained Djinni" DEF {
        EXTENDS #t4540de6f35155c46f41f0 ^"NPC"

        PROPERTIES {
            ^"Type" STRING "Adversary" FIXED
            ^"Category" STRING "Spirit"
            ^"Combat Conflict Rank" INTEGER 5
            ^"Intrigue Conflict Rank" INTEGER 4
            ^"Description" STRING "Primordial elemental being bound by ancient Rempet sorcery, enslaved to lamps, rings, or other objects."
            ^"Rings" DEF {
                ^"Air" INTEGER 4
                ^"Earth" INTEGER 1
                ^"Fire" INTEGER 3
                ^"Water" INTEGER 2
                ^"Void" INTEGER 1
            }
            ^"Endurance" INTEGER 10
            ^"Composure" INTEGER 6
            ^"Focus" INTEGER 7
            ^"Vigilance" INTEGER 3
            ^"Demeanor" STRING "Gruff"
            ^"Social Skill Check TN Modifiers" STRING "Water +2, Earth -2"
            ^"Skills" LIST OF STRING ["Artisan 2", "Martial 3", "Scholar 3", "Social 1", "Trade 1"]
            ^"Advantages" LIST OF STRING ["Ancient Wisdom (Earth) [Scholar; Mental]", "Body of Smokeless Fire (Fire) [Martial; Physical, Spiritual]"]
            ^"Disadvantages" LIST OF STRING ["Bound to Object (Earth) [Social; Physical, Spiritual]", "Forced into Servitude (Air) [Interpersonal; Mental, Physical, Spiritual]"]
            ^"Favored Weapons" LIST OF STRING ["Blazing Touch: Range 1-3, Damage 6, Deadliness 6, deals supernatural damage"]
            ^"Gear" LIST OF STRING ["Cloaked in Fire (Physical 3, Supernatural 1)"]
        }

        ^"Elemental Being" DEF {
            ^"Description" STRING "A chained djinni is an Otherworldly being. They can move vertically, and they ignore the negative effects of physical terrain. As a Support action, they may alter their silhouette to a number between 0 and X, where X is the rank of the ring corresponding to their current stance."
        }

        ^"Invisibility" DEF {
            ^"Description" STRING "As a Support action, a djinni may become invisible and impossible to see, or become visible as a body of rolling flames."
        }

        ^"Incredible Power" DEF {
            ^"Description" STRING "The djinni's enemies treat the area at range 0-1 of the djinni as Dangerous terrain. The area around the djinni at range 0-3 is Imbalanced (Water and Air), as the kami are fearful of djinn. Additionally, the djinni may attempt any Air or Fire invocation they want. The being to whom the djinni is bound is immune to this ability's effects."
        }

        RULES {
            #L5RCW274bb0c5312b9f14323fff: chained_djinni "Chained Djinni: Myriad beings dwell beyond the Empire's borders, some of them more unusual than others. Among the latter are the ephemeral djinn. Mistaken for spirits by those who misunderstand them, djinn are a primordial people with subtle bodies and immense elemental powers. Yet their supernatural nature allowed the ancient Rempet sorcerers to bind them by exploiting their true names. While the practice is banned throughout the Caliphate, many djinn remain enslaved, tied to lamps, rings, or other objects."
        }
    }

    # source stat block (page 151)
    ^"Empowered Ifrit" DEF {
        EXTENDS #t4540de6f35155c46f41f0 ^"NPC"

        PROPERTIES {
            ^"Type" STRING "Adversary" FIXED
            ^"Category" STRING "Spirit"
            ^"Combat Conflict Rank" INTEGER 7
            ^"Intrigue Conflict Rank" INTEGER 5
            ^"Description" STRING "Physical djinni with an imposing body and animalistic features, proud of great elemental powers."
            ^"Rings" DEF {
                ^"Air" INTEGER 6
                ^"Earth" INTEGER 2
                ^"Fire" INTEGER 4
                ^"Water" INTEGER 3
                ^"Void" INTEGER 2
            }
            ^"Endurance" INTEGER 12
            ^"Composure" INTEGER 10
            ^"Focus" INTEGER 10
            ^"Vigilance" INTEGER 5
            ^"Demeanor" STRING "Shrewd"
            ^"Social Skill Check TN Modifiers" STRING "Air +2, Fire -2"
            ^"Skills" LIST OF STRING ["Artisan 2", "Martial 4", "Scholar 4", "Social 3", "Trade 1"]
            ^"Advantages" LIST OF STRING ["Giant's Strength (Earth) [Martial; Physical, Spiritual]", "Impossible Feats (Void) [Martial; Physical, Spiritual]"]
            ^"Disadvantages" LIST OF STRING ["Flattery Gets You Everywhere (Air) [Social; Interpersonal, Mental]", "Short Fuse (Fire) [Social; Mental]"]
            ^"Favored Weapons" LIST OF STRING ["Blazing Touch: Range 1-3, Damage 6, Deadliness 6, deals supernatural damage"]
        }

        ^"Elemental Powers" DEF {
            ^"Description" STRING "An ifrit is an Otherworldly being of silhouette 3. They can move vertically, and they ignore the negative effects of physical terrain. Additionally, they have a natural physical resistance value equal to the ring of their current stance."
        }

        ^"Invisibility" DEF {
            ^"Description" STRING "As a Support action, an ifrit may become invisible and impossible to see, or they can become visible as a humanoid being with animal features."
        }

        RULES {
            #L5RCW282ec284346a43f2409176: empowered_ifrit "Empowered Ifrit: Unlike an ethereal djinni, an ifrit is a djinni with an imposing physical body and animalistic features, such as cattle horns, the face of a dog or jackal, or the eyes and fangs of a snake. Capable of verbal communication and proud of their great powers, an ifrit might reward a human they consider virtuous, but they more often punish those who attract their ire."
        }
    }

    # source stat block (page 151)
    ^"Fox Prince" DEF {
        EXTENDS #t4540de6f35155c46f41f0 ^"NPC"

        PROPERTIES {
            ^"Type" STRING "Adversary" FIXED
            ^"Category" STRING "Spirit"
            ^"Combat Conflict Rank" INTEGER 4
            ^"Intrigue Conflict Rank" INTEGER 5
            ^"Description" STRING "Noble kitsune spirit with three or more tails, entitled to rank within the courts of Senkyo. Can be benevolent guardian, trickster, or spirit of vengeance."
            ^"Rings" DEF {
                ^"Air" INTEGER 5
                ^"Earth" INTEGER 2
                ^"Fire" INTEGER 4
                ^"Water" INTEGER 3
                ^"Void" INTEGER 3
            }
            ^"Endurance" INTEGER 12
            ^"Composure" INTEGER 10
            ^"Focus" INTEGER 9
            ^"Vigilance" INTEGER 4
            ^"Honor" INTEGER 25
            ^"Glory" INTEGER 35
            ^"Status" INTEGER 35
            ^"Demeanor" STRING "Mischievous"
            ^"Social Skill Check TN Modifiers" STRING "Air +2, Earth -2"
            ^"Skills" LIST OF STRING ["Artisan 0", "Martial 3", "Scholar 3", "Social 3", "Trade 1"]
            ^"Advantages" LIST OF STRING ["Dangerous Allure (Fire) [Social; Interpersonal, Physical]", "Royalty of Senkyo (Void) [Social; Interpersonal]"]
            ^"Disadvantages" LIST OF STRING ["Short Temper (Fire) [Martial, Social; Mental]", "Vain (Void) [Social; Interpersonal, Mental]"]
            ^"Favored Weapons" LIST OF STRING ["Claws and Fangs: Range 0-1, Damage 3, Deadliness 4, Razor-Edged", "Kitsune-bi: Range 2-4, Damage 5, Deadliness 3, deals supernatural damage"]
        }

        ^"Nice Try" DEF {
            ^"Description" STRING "Once per scene, after the fox prince has been a target of a successful Attack action, they may choose for the attack to hit an illusion of themself instead. The illusion disappears, the fox prince takes no damage, and they appear within range 2 of their illusory double's former location."
        }

        ^"Shapeshifter" DEF {
            ^"Description" STRING "As a Support action, the fox prince can transform into human form (or back again). While in human form, they still cast a fox's shadow. When they become Compromised, their fox tails, ears, and paws appear. While in fox form, they are silhouette 1 and have at least three tails."
        }

        RULES {
            #L5RCW290957a9995b7668c658db: fox_prince "Fox Prince: Fox princes are kitsune spirits who have grown old enough to have three or more tails, entitling them to a noble rank within the strange courts of Senkyō. When they gain this rank, many choose to serve Inari, the Fortune of Rice, although others continue to seek their own amusement. Often dwelling near human settlements, fox princes can be benevolent guardians, mischievous tricksters, spirits of vengeance, or anything in between."
        }
    }

    # source stat block (page 152)
    ^"Golden Bird Lord" DEF {
        EXTENDS #t4540de6f35155c46f41f0 ^"NPC"

        PROPERTIES {
            ^"Type" STRING "Adversary" FIXED
            ^"Category" STRING "Spirit"
            ^"Combat Conflict Rank" INTEGER 8
            ^"Intrigue Conflict Rank" INTEGER 4
            ^"Description" STRING "Golden-winged king of the birds, associated with courage, honesty, and community. Guardian of the Ujik mountains and opponent of all serpents."
            ^"Rings" DEF {
                ^"Air" INTEGER 6
                ^"Earth" INTEGER 3
                ^"Fire" INTEGER 1
                ^"Water" INTEGER 3
                ^"Void" INTEGER 2
            }
            ^"Endurance" INTEGER 14
            ^"Composure" INTEGER 8
            ^"Focus" INTEGER 8
            ^"Vigilance" INTEGER 4
            ^"Silhouette" INTEGER 4
            ^"Demeanor" STRING "Stoic"
            ^"Social Skill Check TN Modifiers" STRING "Earth +2, Fire -2"
            ^"Skills" LIST OF STRING ["Artisan 1", "Martial 3", "Scholar 2", "Social 2", "Trade 2"]
            ^"Advantages" LIST OF STRING ["Cunning Tactician (Air) [Martial; Fame, Mental, Physical]", "Indomitable Will (Earth) [Martial, Social; Interpersonal, Mental]"]
            ^"Disadvantages" LIST OF STRING ["Sworn Enemy of Serpents (Void) [Social; Fame, Interpersonal, Mental]"]
            ^"Favored Weapons" LIST OF STRING ["Beak and Talons: Range 1-2, Damage 8, Deadliness 6, Razor-Edged"]
            ^"Gear" LIST OF STRING ["Golden feathers (Physical 3, Sacred, Supernatural 4)"]
        }

        ^"Mystical Guardian" DEF {
            ^"Description" STRING "A Golden Bird Lord is an Otherworldly being of silhouette 4 who can fly. They can move vertically, and they ignore the negative effects of terrain. Additionally, once per scene, they may perform any invocation other than Fire, Air, and Wrath of Kaze-no-Kami. The invocation counts as succeeding with three bonus successes and :opp::opp:."
        }

        ^"Swoop" DEF {
            ^"Description" STRING "When performing an Attack action check, a Golden Bird Lord may spend :opp: as follows: :opp:: Move 1 range band away from the target (or :opp: spent this way). If the target is human-sized (silhouette 2) or smaller, the Golden Bird Lord may carry it to its destination instead."
        }

        RULES {
            #L5RCW300a5557ff6a9006cd2cd3: golden_bird_lord "Golden Bird Lord: Golden Bird Lord is the golden-winged \"king of the birds.\" Often appearing as a gigantic kite bird with feathers made of gold, the Golden Bird Lord is associated with courage, honesty, intelligence, and community. Stories tell of an ancient Golden Bird Lord the size of whole nations. The Ujik consider the Golden Bird Lord to be a protector and a guardian of their mountains, a being who opposes all serpents and supposedly also naga."
        }
    }

    # source stat block (page 152)
    ^"Imposing Marid" DEF {
        EXTENDS #t4540de6f35155c46f41f0 ^"NPC"

        PROPERTIES {
            ^"Type" STRING "Adversary" FIXED
            ^"Category" STRING "Spirit"
            ^"Combat Conflict Rank" INTEGER 9
            ^"Intrigue Conflict Rank" INTEGER 7
            ^"Description" STRING "Greatest of the djinn, once worshipped as gods. Humanoid giants formed from the elements, capable of granting wishes."
            ^"Rings" DEF {
                ^"Air" INTEGER 6
                ^"Earth" INTEGER 4
                ^"Fire" INTEGER 4
                ^"Water" INTEGER 4
                ^"Void" INTEGER 3
            }
            ^"Endurance" INTEGER 16
            ^"Composure" INTEGER 16
            ^"Focus" INTEGER 10
            ^"Vigilance" INTEGER 5
            ^"Silhouette" INTEGER 4
            ^"Demeanor" STRING "Detached"
            ^"Social Skill Check TN Modifiers" STRING "Earth +1, Fire +1, Void -2"
            ^"Skills" LIST OF STRING ["Artisan 3", "Martial 4", "Scholar 4", "Social 3", "Trade 2"]
            ^"Advantages" LIST OF STRING ["Giant's Strength (Earth) [Martial; Physical, Spiritual]", "Impossible Feats (Air) [Martial; Physical, Spiritual]", "Massive Stature (Earth) [Martial; Physical]"]
            ^"Disadvantages" LIST OF STRING ["Prideful and Vengeful (Earth) [Social; Mental]"]
            ^"Favored Weapons" LIST OF STRING ["Massive Fists: Range 0-2, Damage 7, Deadliness 5"]
        }

        ^"Elemental Powers" DEF {
            ^"Description" STRING "A marid is an Otherworldly being of silhouette 4. They can move vertically, and they ignore the negative effects of physical terrain. Additionally, they have a natural physical resistance value equal to the ring of their current stance."
        }

        ^"Incredible Power" DEF {
            ^"Description" STRING "The marid's enemies treat the area within range 0-1 of the marid as Dangerous terrain. The area around the marid at range 0-3 is Imbalanced (Air and Water), the kami are fearful of djinn. Additionally, the marid may attempt any invocation they want. If the marid is bound to another being, that being is immune to this ability's effects."
        }

        ^"Invisibility" DEF {
            ^"Description" STRING "As a Support action, a marid may become invisible and impossible to see, or they may become visible as a giant humanoid made from the element of their current stance."
        }

        RULES {
            #L5RCW31aa524f1512e8e9abb198: imposing_marid "Imposing Marid: The greatest of the djinn, marids were once worshipped as gods. With all the elemental powers of djinn and the physical prowess of ifrits, marids appear as humanoid giants formed from the elements—when they wish to appear at all. So great is their power that they are able to grant wishes, but only the most foolhardy being would attempt to bind them."
        }
    }

    # source stat block (page 153)
    ^"Jorogumo" DEF {
        EXTENDS #t4540de6f35155c46f41f0 ^"NPC"

        PROPERTIES {
            ^"Type" STRING "Adversary" FIXED
            ^"Category" STRING "Spirit"
            ^"Combat Conflict Rank" INTEGER 3
            ^"Intrigue Conflict Rank" INTEGER 4
            ^"Description" STRING "Shapeshifting spider spirit capable of weaving complex sensory illusions. Ancestral enemy of kitsune, known for vengefulness and patience."
            ^"Rings" DEF {
                ^"Air" INTEGER 4
                ^"Earth" INTEGER 2
                ^"Fire" INTEGER 3
                ^"Water" INTEGER 3
                ^"Void" INTEGER 1
            }
            ^"Endurance" INTEGER 10
            ^"Composure" INTEGER 10
            ^"Focus" INTEGER 7
            ^"Vigilance" INTEGER 3
            ^"Demeanor" STRING "Shrewd"
            ^"Social Skill Check TN Modifiers" STRING "Air +2, Fire -2"
            ^"Skills" LIST OF STRING ["Artisan 3", "Martial 2", "Scholar 3", "Social 1", "Trade 1"]
            ^"Advantages" LIST OF STRING ["Dangerous Allure (Fire) [Social; Interpersonal, Physical]", "Incredible Patience (Air) [Social; Interpersonal]"]
            ^"Disadvantages" LIST OF STRING ["Physically Weak (Fire) [Martial; Physical]"]
            ^"Favored Weapons" LIST OF STRING ["Fangs: Range 0-1, Damage 2, Deadliness 7", "Poison Webs: Range 2-3, Damage 3, Deadliness 5, Concealable, deals supernatural damage"]
        }

        ^"Shapeshifter" DEF {
            ^"Description" STRING "As a Support action, a jorogumo can transform into human or spider form. While in spider form, they are silhouette 0. When they become Compromised in their human form, their long spider legs appear, or their spider fangs protrude from their mouth."
        }

        ^"Illusionary Webs" DEF {
            ^"Description" STRING "As a downtime activity, the jorogumo may weave an illusion out of webs. They may create any scenery they choose, including objects, within range 4 of themself. These illusions are visually and tangibly convincing, even when consumed as food or used as weaponry. They are, however, ultimately fake. Targets may suspect something is not what it seems even if they still believe what their senses tell them. The illusion lasts until it is willingly dropped, or until the jorogumo becomes Compromised. When dropped, the illusions become Entangling and Obscuring terrain. Additionally, the jorogumo knows the invocations False Realm of the Fox Spirits and Vapor of Nightmares."
        }

        RULES {
            #L5RCW322577817dd75a74e2f5cc: jorogumo "Jorōgumo: The ancestral enemies of any who call themselves kitsune, jorōgumo are shapeshifting spider spirits capable of adopting human form. In addition to webs made from fibers as strong as iron, jorōgumo can weave complex sensory illusions with their silk that are utterly convincing to the unwary. While they are not evil beings (and some may even become benevolent guardians of villages or shrines), they are extremely vengeful and cruel. Posing as silk weavers, shrine keepers, or lost travelers, they become close with their enemies, taking their time to weave a complex trap of illusions before striking with their poisonous webs."
        }
    }

    # source stat block (page 154)
    ^"Luusyn Khan" DEF {
        EXTENDS #t4540de6f35155c46f41f0 ^"NPC"

        PROPERTIES {
            ^"Type" STRING "Adversary" FIXED
            ^"Category" STRING "Spirit"
            ^"Combat Conflict Rank" INTEGER 8
            ^"Intrigue Conflict Rank" INTEGER 6
            ^"Description" STRING "Giant water spirit known as the king of serpents and dragon king, protector of freshwater purity. Resembles an enormous horned serpent with brilliant silver-blue scales."
            ^"Rings" DEF {
                ^"Air" INTEGER 5
                ^"Earth" INTEGER 1
                ^"Fire" INTEGER 1
                ^"Water" INTEGER 6
                ^"Void" INTEGER 4
            }
            ^"Endurance" INTEGER 16
            ^"Composure" INTEGER 12
            ^"Focus" INTEGER 6
            ^"Vigilance" INTEGER 4
            ^"Silhouette" INTEGER 5
            ^"Demeanor" STRING "Aloof"
            ^"Social Skill Check TN Modifiers" STRING "Air +2, Fire -2"
            ^"Skills" LIST OF STRING ["Artisan 2", "Martial 3", "Scholar 2", "Social 3", "Trade 2"]
            ^"Advantages" LIST OF STRING ["Ethereal Form (Air) [Martial, Trade; Physical]", "Terrifying Presence (Void) [Social, Trade; Fame, Mental, Spiritual]"]
            ^"Disadvantages" LIST OF STRING ["Proud (Air) [Social; Infamy, Interpersonal]"]
            ^"Favored Weapons" LIST OF STRING ["Lightning Strikes: Range 1-4, Damage 7, Deadliness 6, Sacred, deals physical or supernatural damage"]
            ^"Gear" LIST OF STRING ["Shrouded by storm clouds (Physical 4, Supernatural 5, Sacred)"]
        }

        ^"Electric Aura" DEF {
            ^"Description" STRING "After performing a successful Attack action check, the luusyn khan may spend :opp: as follows: :opp:: Characters within range 1 of the luusyn khan must make a TN 4 Fitness check (Earth 5, Void 5). If they fail, they gain the Disoriented condition."
        }

        ^"Spirit of Storm and Stream" DEF {
            ^"Description" STRING "A luusyn khan is an Otherworldly being of silhouette 5 that can fly. They can move vertically, and they ignore the negative effects of terrain. Additionally, once per scene, they may perform any Air or Water invocation other than Rise, Air; Even Changing Waves; and Rise, Water. The invocation counts as succeeding with three bonus successes and :opp::opp:."
        }

        RULES {
            #L5RCW337bc2b1a53e9c7547345e: luusyn_khan "Luusyn Khan: This giant water spirit known as the king of serpents, dragon king, or king of the water can be found near a body of fresh water or lazing in a thunderstorm, protecting the purity of lakes and rivers. Seeing the luusyn khan more as a force of nature than a being, most Ujik people steer clear of them. The Ujik endeavor to keep bodies of water unpolluted and as pure as possible to avoid the luusyn khan's wrath. As drinking water is especially precious along the Sand Road, these efforts pair well other tasks that help ensure basic survival.\n\nWith their brilliant silver-blue scales and fangs, the luusyn khan resembles an enormous serpent—but one with horns and tufts of blue-green hair around their head. They speak in a thunderous voice and can sometimes be seen illuminated by lightning in a storm cloud or bringing rainbows to the horizon."
        }
    }

    # source stat block (page 154)
    ^"Manticore" DEF {
        EXTENDS #t4540de6f35155c46f41f0 ^"NPC"

        PROPERTIES {
            ^"Type" STRING "Adversary" FIXED
            ^"Category" STRING "Spirit"
            ^"Combat Conflict Rank" INTEGER 4
            ^"Intrigue Conflict Rank" INTEGER 3
            ^"Description" STRING "Ageless shapeshifting being from Caliphate folklore. Sustains itself on human flesh while delighting in riddles and wordplay."
            ^"Rings" DEF {
                ^"Air" INTEGER 2
                ^"Earth" INTEGER 2
                ^"Fire" INTEGER 3
                ^"Water" INTEGER 3
                ^"Void" INTEGER 1
            }
            ^"Endurance" INTEGER 10
            ^"Composure" INTEGER 10
            ^"Focus" INTEGER 5
            ^"Vigilance" INTEGER 3
            ^"Demeanor" STRING "Ambitious"
            ^"Social Skill Check TN Modifiers" STRING "Fire +2, Water -2"
            ^"Skills" LIST OF STRING ["Artisan 0", "Martial 3", "Scholar 3", "Social 0", "Trade 2"]
            ^"Advantages" LIST OF STRING ["Expert Manipulator (Air) [Social; Interpersonal]", "Silent Stalker (Air) [Martial; Physical]"]
            ^"Disadvantages" LIST OF STRING ["Must Honor All Agreements (Earth) [Martial; Physical]", "Obsessed with Riddles (Air) [Social; Mental]"]
            ^"Favored Weapons" LIST OF STRING ["Claws and Fangs: Range 1, Damage 5, Deadliness 7, Razor-Edged", "Scorpion Sting: Range 0-3, Damage 2, Deadliness 9, Concealable"]
        }

        ^"Monstrous Shapeshifter" DEF {
            ^"Description" STRING "The manticore is an Otherworldly being. As a Support action, they can transform into the form of a human, a giant hunting cat, or a monstrous bird of prey. While in cat form, they have silhouette 3. While in bird form, they have silhouette 2 and can fly. They can use their scorpion tail in any form. When they become Compromised, the manticore is forced into either cat or bird form."
        }

        ^"Terrible Sorceries" DEF {
            ^"Description" STRING "Choose up to three mahō and up to three rituals that the manticore can perform. Add 1 to the manticore's combat conflict rank for each mahō chosen beyond the first."
        }

        RULES {
            #L5RCW34bcfdab33c48da0497444: manticore "Manticore: Ageless beings that carry a vendetta against all civilizations, manticores are obscure and powerful individuals known from the folklore of the Caliphate. Sustaining themselves on human flesh and delighting in secrets, riddles, and wordplay, they are said to resemble massive hunting cats or birds of prey, but with a human face and the tail of a massive scorpion. However, they can also adopt human form, sowing chaos wherever they go. They seek power and the enslavement of mortals, and they are eager to make pacts with shortsighted sorcerers."
        }
    }

    # source stat block (page 155)
    ^"Snow Lion" DEF {
        EXTENDS #t4540de6f35155c46f41f0 ^"NPC"

        PROPERTIES {
            ^"Type" STRING "Adversary" FIXED
            ^"Category" STRING "Spirit"
            ^"Combat Conflict Rank" INTEGER 6
            ^"Intrigue Conflict Rank" INTEGER 7
            ^"Description" STRING "Mountain spirit with white fur and turquoise mane, leaping from peak to peak. Associated with strength, joy, and playfulness by the Ujik."
            ^"Rings" DEF {
                ^"Air" INTEGER 4
                ^"Earth" INTEGER 6
                ^"Fire" INTEGER 1
                ^"Water" INTEGER 2
                ^"Void" INTEGER 5
            }
            ^"Endurance" INTEGER 8
            ^"Composure" INTEGER 14
            ^"Focus" INTEGER 2
            ^"Vigilance" INTEGER 3
            ^"Silhouette" INTEGER 3
            ^"Demeanor" STRING "Joyful"
            ^"Social Skill Check TN Modifiers" STRING "Water +2, Fire -2"
            ^"Skills" LIST OF STRING ["Artisan 1", "Martial 2", "Scholar 3", "Social 3", "Trade 2"]
            ^"Advantages" LIST OF STRING ["Playfulness (Air) [Social; Fame, Mental, Spiritual]", "Trickster (Air) [Martial, Social, Trade; Interpersonal, Mental]"]
            ^"Disadvantages" LIST OF STRING ["Easily Distracted (Air) [Social; Mental]"]
            ^"Favored Weapons" LIST OF STRING ["Powerful Jaws: Range 0-1, Damage 7, Deadliness 4, Sacred"]
            ^"Gear" LIST OF STRING ["Thick hide (Physical 3, Supernatural 2, Sacred)"]
