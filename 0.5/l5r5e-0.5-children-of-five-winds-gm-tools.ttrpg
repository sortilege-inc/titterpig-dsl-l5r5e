    # source stat block (page 173)
    ^"Asahina Nao" DEF {
        EXTENDS #t4540de6f35155c46f41f0 ^"NPC"

        PROPERTIES {
            ^"Type" STRING "Adversary" FIXED
            ^"Combat Conflict Rank" INTEGER 2
            ^"Intrigue Conflict Rank" INTEGER 2
            ^"Description" STRING "Crane shugenja visiting Daidoji Shin in the City of the Rich Frog. An old friend of the governor Miya Tetsua, called upon to assist with the situation involving Shinjo Higuchi."
            ^"Rings" DEF {
                ^"Air" INTEGER 2
                ^"Earth" INTEGER 2
                ^"Fire" INTEGER 3
                ^"Water" INTEGER 3
                ^"Void" INTEGER 3
            }
            ^"Endurance" INTEGER 8
            ^"Composure" INTEGER 10
            ^"Focus" INTEGER 5
            ^"Vigilance" INTEGER 2
            ^"Honor" INTEGER 50
            ^"Glory" INTEGER 40
            ^"Status" INTEGER 40
            ^"Demeanor" STRING "Dependable"
            ^"Social Skill Check TN Modifiers" STRING "Fire +1, Water +1, Earth -2"
            ^"Skills" LIST OF STRING ["Artisan 3", "Martial 0", "Scholar 3", "Social 2", "Trade 0"]
            ^"Advantages" LIST OF STRING ["Meishōdō Master (Void) [Scholar; Interpersonal, Mental]", "Shrewd (Air) [Social; Mental]"]
            ^"Disadvantages" LIST OF STRING ["Fondness for Gambling (Earth) [Social; Interpersonal, Mental]"]
            ^"Favored Weapons" LIST OF STRING ["Wakizashi: Range 0-1, Damage 3, Deadliness 5/7, Ceremonial, Razor-Edged"]
            ^"Gear" LIST OF STRING ["Sanctified robes (Physical 1, Supernatural 3, Ceremonial)", "Scroll satchel", "Personal chop"]
        }

        ^"The Fires from Within" DEF {
            ^"Description" STRING "Invocation. As an Attack action, Nao may make a TN 3 Theology (Fire) check targeting a number of characters up to her Fire Ring at range 1-3. If she succeeds, each target suffers 3 supernatural damage, plus 1 per bonus success. :opp:+: Choose 1 additional target per :opp: spent this way."
        }

        ^"Path to Inner Peace" DEF {
            ^"Description" STRING "Invocation. As a Support action, Nao may make a TN 2 Theology (Water) check targeting herself or another character at range 0-2. If she succeeds, the target removes 3 fatigue, plus 1 per bonus success. A target can only be affected by this invocation once per scene. Water :opp:: Choose one of the following conditions: Bleeding, Dazed, Disoriented, or Lightly Wounded. Remove that condition from each target. Water :opp:: Your target also removes strife equal to your bonus successes."
        }

        ^"Practiced Ritualist" DEF {
            ^"Description" STRING "Nao may perform the Cleansing Rite (core rulebook, page 212) and Commune with the Spirits (core rulebook, page 212) rituals."
        }

        RULES {
            #L5RCW46db7ead6ab657b12a9950: asahina_nao "Asahina Nao: [She/Her] Asahina Nao is a Crane shugenja visiting Daidoji Shin in the City of the Rich Frog. An old friend of the city's governor, Miya Tetsua, she has been called upon to assist with the situation involving Shinjo Higuchi."
        }
    }

    # source stat block (page 173)
    ^"Adventure Ifrit" DEF {
        EXTENDS #t4540de6f35155c46f41f0 ^"NPC"

        PROPERTIES {
            ^"Type" STRING "Adversary" FIXED
            ^"Category" STRING "Spirit"
            ^"Combat Conflict Rank" INTEGER 9
            ^"Intrigue Conflict Rank" INTEGER 2
            ^"Description" STRING "Fire spirit from the Burning Sands, long dormant within a magical talisman. Accidentally awoken by Higuchi, it has possessed her in its confusion. This profile represents the ifrit in its natural, unbound form."
            ^"Rings" DEF {
                ^"Air" INTEGER 2
                ^"Earth" INTEGER 2
                ^"Fire" INTEGER 6
                ^"Water" INTEGER 1
                ^"Void" INTEGER 1
            }
            ^"Endurance" INTEGER 12
            ^"Composure" INTEGER 3
            ^"Focus" INTEGER 4
            ^"Vigilance" INTEGER 1
            ^"Demeanor" STRING "Intense"
            ^"Social Skill Check TN Modifiers" STRING "Air +3, Water -2"
            ^"Skills" LIST OF STRING ["Artisan 0", "Martial 3", "Scholar 3", "Social 2", "Trade 3"]
            ^"Advantages" LIST OF STRING ["Primal Terror (Fire) [Martial, Social; Interpersonal]"]
            ^"Disadvantages" LIST OF STRING ["Endless Hunger (Water) [Artisan, Scholar; Mental]"]
            ^"Favored Weapons" LIST OF STRING ["Blazing Touch: Range 1-3, Damage 6, Deadliness 6, Razor-Edged, deals supernatural damage"]
            ^"Gear" LIST OF STRING ["Corona of flames (Physical 3)"]
        }

        ^"Living Fire Spirit" DEF {
            ^"Description" STRING "The ifrit is an Otherworldly being. Once per scene as an action of the appropriate types, the ifrit may perform any one Fire invocation (other than Rise, Fire). It counts as succeeding with 3 bonus successes and 2 :opp:."
        }

        ^"Mantle of Smoke and Ash" DEF {
            ^"Description" STRING "Other characters treat the area at range 0-1 of the ifrit as Dangerous and Obscuring terrain."
        }

        ^"Searing Caress" DEF {
            ^"Description" STRING "When performing an Attack action check, the ifrit may spend :opp: as follows: :opp:+: The target and up to one other character per :opp: spent this way at range 0-1 of the target suffer the Burning condition."
        }

        RULES {
            #L5RCW4717808c8d1e36833b8268: adventure_ifrit "Ifrit: A fire spirit originating from the Burning Sands, this ifrit has long lain dormant within a magical talisman. Accidentally awoken by Higuchi, it has possessed her in its confusion.\n\nThis profile represents the ifrit in its natural, unbound form. For the spirit's stats while it is still inhabiting Higuchi's body, see Shinjo Higuchi, Possessed (page 170)."
        }
    }

