    # source stat block (page 54)
    ^"Utaku Asagao" DEF {
        EXTENDS #t4540de6f35155c46f41f0 ^"NPC"

        PROPERTIES {
            ^"Type" STRING "Adversary" FIXED
            ^"Combat Conflict Rank" INTEGER 3
            ^"Intrigue Conflict Rank" INTEGER 2
            ^"Description" STRING "Shrine keeper of Utaku Seido with mysterious connection to the Blessed Herd."
            ^"Rings" DEF {
                ^"Air" INTEGER 1
                ^"Earth" INTEGER 3
                ^"Fire" INTEGER 2
                ^"Water" INTEGER 4
                ^"Void" INTEGER 2
            }
            ^"Endurance" INTEGER 10
            ^"Composure" INTEGER 14
            ^"Focus" INTEGER 3
            ^"Vigilance" INTEGER 2
            ^"Honor" INTEGER 66
            ^"Glory" INTEGER 35
            ^"Status" INTEGER 25
            ^"Demeanor" STRING "Detached"
            ^"Social Skill Check TN Modifiers" STRING "Earth +1, Fire +1, Void -2"
            ^"Skills" LIST OF STRING ["Artisan 2", "Martial 3", "Scholar 2", "Social 0", "Trade 0"]
            ^"Advantages" LIST OF STRING ["Affinity with Horses (Void) [Social; Interpersonal]", "Local Folklorist (Earth) [Scholar; Mental]"]
            ^"Disadvantages" LIST OF STRING ["Overprotective (Fire) [Martial; Mental]"]
            ^"Favored Weapons" LIST OF STRING ["Broom (improvised weapon): Treat as bo (staff)"]
            ^"Gear" LIST OF STRING ["Shrine keeper robes (Physical 1, Supernatural 3, Ceremonial)", "Offerings"]
            ^"Companions" LIST OF STRING ["Taiyo (see Utaku warhorse on page 143)"]
        }

        ^"Path to Inner Peace" DEF {
            ^"Description" STRING "Invocation. As a Support action, may make a TN 2 Theology (Water) check targeting a character at range 0-2. If Asagao succeeds, the target removes 3 fatigue, plus 1 per bonus success. A target can be affected by Path to Inner Peace only once per scene."
        }

        RULES {
            #L5RCW37485a96fa3412dc06722c: utaku_asagao "Utaku Asagao: Once known by a different name, the shrine keeper Asagao discovered who she truly was when, during an emergency, a horse of the Blessed Herd allowed her onto its back and delivered her to her lord's estate. Finally realizing a truth she had grappled with her entire life, Asagao made a pilgrimage to Utaku's Shrine, where she was accepted by the shrine keepers as their new sister. Now, a decade later, Asagao is completely devoted to the shrine's protection and prosperity, offering a sympathetic ear and a word of wisdom for anyone who feels lost on their path through life."
        }
    }

    # source stat block (page 62)
    ^"Iuchi Itsuki" DEF {
        EXTENDS #t4540de6f35155c46f41f0 ^"NPC"

        PROPERTIES {
            ^"Type" STRING "Adversary" FIXED
            ^"Combat Conflict Rank" INTEGER 5
            ^"Intrigue Conflict Rank" INTEGER 3
            ^"Description" STRING "Meishōdō Master maintaining Dreamer's Forest wards. Tempted by a fox spirit claiming innocence."
            ^"Rings" DEF {
                ^"Air" INTEGER 2
                ^"Earth" INTEGER 3
                ^"Fire" INTEGER 2
                ^"Water" INTEGER 4
                ^"Void" INTEGER 3
            }
            ^"Endurance" INTEGER 10
            ^"Composure" INTEGER 14
            ^"Focus" INTEGER 4
            ^"Vigilance" INTEGER 3
            ^"Honor" INTEGER 40
            ^"Glory" INTEGER 40
            ^"Status" INTEGER 30
            ^"Demeanor" STRING "Ambitious"
            ^"Social Skill Check TN Modifiers" STRING "Fire +2, Water -2"
            ^"Skills" LIST OF STRING ["Artisan 2", "Martial 1", "Scholar 2", "Social 4", "Trade 2"]
            ^"Advantages" LIST OF STRING ["Syncretic Philosophy (Water) [Social; Interpersonal]"]
            ^"Disadvantages" LIST OF STRING ["Vain (Void) [Social; Interpersonal, Mental]", "Haunted (Void) [Social; Interpersonal, Spiritual]"]
            ^"Favored Weapons" LIST OF STRING ["Kiseru (smoking pipe): Range 0, Damage 2, Deadliness 2, Concealable, Mundane"]
            ^"Gear" LIST OF STRING ["1 to 4 meishōdō talismans (see Abilities)", "Sanctified robes (Physical 1, Supernatural 3, Ceremonial)", "Divination kit", "Medicine kit", "Up to three omamori"]
            ^"Companions" LIST OF STRING ["Natsu (see Iuchi riding steed on page 141)"]
        }

        ^"Deft Negotiator" DEF {
            ^"Description" STRING "During an intrigue or other noncombat scene, when making a Scheme action check, Itsuki may add a kept (ring) set to an (op) result to the check. During otherworldly encounters (see page 125), Itsuki gains this bonus on all actions."
        }

        ^"Meishōdō Artist" DEF {
            ^"Description" STRING "Choose up to four invocations of rank 1-3 and one invocation of rank 4-5. Itsuki has meishōdō talismans with the chosen invocations bound to them and can activate those invocations using the talismans as described in Iuchi Meishōdō Master School in the core rulebook, page 83. You may also choose up to three rituals that Itsuki can perform."
        }

        RULES {
            #L5RCW38a20223c882a9ec1dd1a3: iuchi_itsuki "Iuchi Itsuki: One of a handful of Meishōdō Masters entrusted with this task, Iuchi Itsuki has the duty of maintaining the wards and statues that contain the Dreamer's Forest. Twice every season, guarded with protective talismans and accompanied by trusted companions, he patrols the outermost portions of the woods, checking to be sure the malicious forest is still bound. While Itsuki would never outwardly complain, to his trusted friends he has long bemoaned his station, for he has always felt that he was meant for something greater.\n\nDuring his most recent venture, one of the talismans spoke to him, claiming to be an innocent trapped fox spirit, not a malicious baku—a dream spirit—of Yume-dō. She pleaded to be released, promising to share some power if only Itsuki would free her from the prison of the charm. Itsuki knows better than to trust this voice in his head, and yet he cannot be fully sure that the spirit is lying. If she is telling the truth, then he would be complicit in an innocent spirit's unjust imprisonment. And ever since, he has seen the spirit in his dreams: a shackled fox maiden, begging to be freed. With each passing night of interrupted sleep, he feels his resolve slipping a little more."
        }
    }

    # source stat block (page 66)
    ^"Ide Yuto" DEF {
        EXTENDS #t4540de6f35155c46f41f0 ^"NPC"

        PROPERTIES {
            ^"Type" STRING "Adversary" FIXED
            ^"Combat Conflict Rank" INTEGER 1
            ^"Intrigue Conflict Rank" INTEGER 3
            ^"Description" STRING "Adventurous diplomat's son who claims an impossible underwater journey. Craves excitement."
            ^"Rings" DEF {
                ^"Air" INTEGER 2
                ^"Earth" INTEGER 2
                ^"Fire" INTEGER 3
                ^"Water" INTEGER 3
                ^"Void" INTEGER 2
            }
            ^"Endurance" INTEGER 10
            ^"Composure" INTEGER 10
            ^"Focus" INTEGER 5
            ^"Vigilance" INTEGER 2
            ^"Honor" INTEGER 40
            ^"Glory" INTEGER 44
            ^"Status" INTEGER 37
            ^"Demeanor" STRING "Ambitious"
            ^"Social Skill Check TN Modifiers" STRING "Fire +2, Water -2"
            ^"Skills" LIST OF STRING ["Artisan 1", "Martial 0", "Scholar 3", "Social 3", "Trade 2"]
            ^"Advantages" LIST OF STRING ["Tall Tales (Air) [Scholar; Interpersonal]", "Unfettered (Earth) [Social, Trade; Mental]"]
            ^"Disadvantages" LIST OF STRING ["Impetuous Risk-Taker (Fire) [Martial; Mental]"]
            ^"Gear" LIST OF STRING ["Traveling clothes (Physical 2, Durable, Mundane, Subtle)", "Traveling supplies", "Various trinkets", "String of koku"]
            ^"Companions" LIST OF STRING ["Riding pony Kushami (see Horse [Rokugani Pony] in the core rulebook, page 326)"]
        }

        ^"Quick Assessment" DEF {
            ^"Description" STRING "As a Support action, Yuto may target an NPC within range 0-3 who is currently engaged in conversation or combat. He discerns the target's demeanor, vigilance, and composure (and may reveal them to his allies)."
        }

        ^"Unassuming" DEF {
            ^"Description" STRING "When Yuto makes a check targeting a character with a higher status rank, he treats the target's vigilance as 1 lower."
        }

        RULES {
            #L5RCW39c06165867ce923b2ca60: ide_yuto "Ide Yūto: As the son of high-ranking diplomats, wayward slacker Ide Yūto had few obligations and could seek whatever path he wished. So it was to his family's great distress when, while staying at Far Traveler Castle, Yūto vanished without a trace. Months passed, and his family was prepared to accept his unexplained death when he suddenly arrived at Great Day Castle, road-worn and grinning ear to ear.\n\nHe claimed that he had seen a glimmer under the waters of Water Dragon Lake, and that after diving as far as he could go, he had surfaced in the territory of the Centipede Clan on the eastern coast of Rokugan. He had spent the last two seasons traveling back across the Empire, sending several messages that ultimately never reached his family. While unbelievable, his story was supported by the various trinkets and gifts he had brought back, including silks from Moshi looms.\n\nYūto has craved adventure since that day. He is often seen accosting travelers as they pass through the town near Kyūden Ide, hoping for a chance to return to a life of excitement."
        }
    }

    # source stat block (page 67)
    ^"Moto Syujiko" DEF {
        EXTENDS #t4540de6f35155c46f41f0 ^"NPC"

        PROPERTIES {
            ^"Type" STRING "Adversary" FIXED
            ^"Combat Conflict Rank" INTEGER 3
            ^"Intrigue Conflict Rank" INTEGER 1
            ^"Description" STRING "Traveling samurai, storyteller, and Ujik diviner. Reads fortunes through knuckle bone divination and channels the Lords of Death."
            ^"Rings" DEF {
                ^"Air" INTEGER 2
                ^"Earth" INTEGER 3
                ^"Fire" INTEGER 2
                ^"Water" INTEGER 3
                ^"Void" INTEGER 3
            }
            ^"Endurance" INTEGER 10
            ^"Composure" INTEGER 12
            ^"Focus" INTEGER 4
            ^"Vigilance" INTEGER 3
            ^"Honor" INTEGER 40
            ^"Glory" INTEGER 38
            ^"Status" INTEGER 30
            ^"Demeanor" STRING "Detached"
            ^"Social Skill Check TN Modifiers" STRING "Earth +1, Fire +1, Void -2"
            ^"Skills" LIST OF STRING ["Artisan 2", "Martial 2", "Scholar 3", "Social 0", "Trade 2"]
            ^"Advantages" LIST OF STRING ["Well-Read (Fire) [Scholar; Mental]", "Lords of Death Blessing (Void) [Scholar, Social; Spiritual]"]
            ^"Disadvantages" LIST OF STRING ["Thick-Headed (Air) [Scholar, Social; Mental]"]
            ^"Favored Weapons" LIST OF STRING ["Scimitar: Range 1, Damage 4, Deadliness 5, Durable, Razor-Edged", "Horsebow: Range 2-4, Damage 4, Deadliness 5, Wargear"]
            ^"Gear" LIST OF STRING ["Wakizashi (short sword)", "Traveling supplies", "Divination kit", "Various trinkets", "String of koku"]
            ^"Companions" LIST OF STRING ["Two camels (see Camel in Path of Waves, page 235)"]
        }

        ^"Death Lord Divination" DEF {
            ^"Description" STRING "As a downtime activity, Syujiko can tell someone's fortune. After she offers a vague prediction to a character, choose one skill type (Artisan, Martial, Scholar, Social, or Trade). During the same session, the next time that character makes a skill check using the chosen type, they may replace one kept die with a single die showing a (su) result."
        }

        ^"Death Lord Curse" DEF {
            ^"Description" STRING "As a Support action, choose a target at range 0-2 and name a specific action type (such as Attack, Support, Movement, Intrigue, or similar). Until Syujiko's next turn, the next time the target attempts an action of the chosen type, they immediately receive 3 strife."
        }

        RULES {
            #L5RCW40427df39abea19faceab6: moto_syujiko "Moto Syujiko: Adorned in fur-lined robes and jingling with trinkets from atop of one of her riding camels, Moto Syujiko is quite a sight to the typical Rokugani, looking more like a middle-aged mystic than a traveling Moto samurai. She knows hundreds of tales from beyond Rokugan's borders; children especially enjoy her performances, as they often incorporate the elaborate hand puppets she keeps in her traveling bags. Syujiko's greatest aspiration is to write famous romance stories, and she hopes to one day publish one of her pillow book manuscripts, of which she has many. Most consider her an oddity and give her no further notice.\n\nBut for those who recognize the symbology on her robes, certain flowers and animals that are not native to Rokugan, her true vocation becomes immediately apparent. Syujiko is a diviner of the Ujik tradition, born with the ability to consult the Lords of Death, reading fortunes or channeling their vengeance. Syujiko is careful not to advertise these specific services openly, lest she attract the superstitious and fearful. But for those who are willing to risk the Death Lords' attention, she will toss the knuckle bones. At the very least, she may learn something interesting that could go into one of her novels someday."
        }
    }

    # source stat block (page 48)
    ^"Shinjo Haruko" DEF {
        EXTENDS #t4540de6f35155c46f41f0 ^"NPC"

        PROPERTIES {
            ^"Type" STRING "Adversary" FIXED
            ^"Combat Conflict Rank" INTEGER 6
            ^"Intrigue Conflict Rank" INTEGER 5
            ^"Description" STRING "The Unicorn Champion's only biological daughter. One of the most talented horse archers of her generation, seeking a new purpose after Imperial censure shut all her former paths."
            ^"Rings" DEF {
                ^"Air" INTEGER 4
                ^"Earth" INTEGER 3
                ^"Fire" INTEGER 3
                ^"Water" INTEGER 4
                ^"Void" INTEGER 3
            }
            ^"Endurance" INTEGER 12
            ^"Composure" INTEGER 14
            ^"Focus" INTEGER 7
            ^"Vigilance" INTEGER 4
            ^"Honor" INTEGER 60
            ^"Glory" INTEGER 65
            ^"Status" INTEGER 39
            ^"Demeanor" STRING "Impetuous"
            ^"Social Skill Check TN Modifiers" STRING "Earth +2, Air -2"
            ^"Skills" LIST OF STRING ["Artisan 2", "Martial 3", "Scholar 2", "Social 3", "Trade 1"]
            ^"Advantages" LIST OF STRING ["Skilled Archer (Air) [Martial; Physical]", "Friends in High Places (Air) [Social; Interpersonal]"]
            ^"Disadvantages" LIST OF STRING ["Reckless (Fire) [Social; Mental]"]
            ^"Favored Weapons" LIST OF STRING ["Shinjo Horsebow: Range 2-4, Damage 4, Deadliness 5, Wargear"]
            ^"Gear" LIST OF STRING ["Lamellar armor (Physical 4, Wargear)", "Quiver", "20 razor-leaf arrows", "Scimitar", "Wakizashi (short sword)", "Fine clothes", "Traveling clothes", "Some worn-out pillow books"]
            ^"Companions" LIST OF STRING ["Yue (see Shinjo courser on page 143)"]
        }

        ^"Horse Girl" DEF {
            ^"Description" STRING "Any steed Haruko rides or has personally trained gives the rider an additional bonus success on any Movement action check they make."
        }

        ^"Wishes at Dawn" DEF {
            ^"Description" STRING "In addition to her martial pursuits, Haruko also has a great love for the theater. Her most recent play, Wishes at Dawn, debuted at a provincial Winter Court and was met with significant praise. It depicts two star-crossed lovers, a Kakita and a Matsu, who must cross swords on the battlefield despite their secret love. While popular, neither the Matsu nor the Kakita family is particularly amused."
        }

        RULES {
            #L5RCW42a7b3e1d9f2c8a45e6701: shinjo_haruko "Shinjo Haruko: The Unicorn Champion's only biological daughter spends most of her days on horseback, galloping along the shore of Water Dragon Lake. Only a few seasons ago, all paths seemed open to her: a likely appointment to the Imperial Guard, fame and recognition in the Bowman's Wager at the Imperial Winter Court, and the many adventures both would bring. However, in the wake of an Imperial censure and the falling out of the Shinjo and Ikoma families, all of those doors have abruptly shut. Shinjo Haruko spends her days riding her favorite horse, Yue, through the surrounding lands, but what she is seeking, a new purpose, cannot be found near Far Traveler Castle.\n\nHaruko is never content to remain in one place. She grew up in many courts, accompanying her mother, and she has friends among virtually all the Great Clans as a consequence. Although she is one of the most talented horse archers of her generation, Haruko has always tended to stir up trouble when bored. And she has become so bored as of late…"
        }
    }

    # source stat block (page 80)
    ^"Kitsune Ryosei" DEF {
        EXTENDS #t4540de6f35155c46f41f0 ^"NPC"

        PROPERTIES {
            ^"Type" STRING "Adversary" FIXED
            ^"Combat Conflict Rank" INTEGER 6
            ^"Intrigue Conflict Rank" INTEGER 3
            ^"Description" STRING "Young Fox Clan Champion. Recently made several Sakkaku pacts and underwent a sudden personality change. May have been replaced by a trickster spirit."
            ^"Rings" DEF {
                ^"Air" INTEGER 3
                ^"Earth" INTEGER 3
                ^"Fire" INTEGER 3
                ^"Water" INTEGER 2
                ^"Void" INTEGER 2
            }
            ^"Endurance" INTEGER 12
            ^"Composure" INTEGER 10
            ^"Focus" INTEGER 6
            ^"Vigilance" INTEGER 3
            ^"Honor" INTEGER 55
            ^"Glory" INTEGER 45
            ^"Status" INTEGER 64
            ^"Demeanor" STRING "Assertive"
            ^"Social Skill Check TN Modifiers" STRING "Earth +2, Air -2"
            ^"Skills" LIST OF STRING ["Artisan 1", "Martial 3", "Scholar 4", "Social 2", "Trade 2"]
            ^"Advantages" LIST OF STRING ["Blood of the Fox (Void) [Martial; Physical, Spiritual]", "Trickster Guardians (Air) [Martial, Social; Spiritual]"]
            ^"Disadvantages" LIST OF STRING ["Small Stature (Air) [Martial; Physical]", "Untested (Fire) [Martial, Social; Mental]", "Wandering Heart (Water) [Scholar; Mental]", "Short Attention Span (Water) [Scholar; Mental]"]
            ^"Favored Weapons" LIST OF STRING ["Trident: Range 2, Damage 4, Deadliness 4, Snaring, Wargear"]
            ^"Gear" LIST OF STRING ["Sanctified robes (Physical 1, Supernatural 3, Ceremonial)", "Wakizashi (short sword)", "Spiritual offerings", "Personal chop"]
        }

        ^"On Friendly Terms" DEF {
            ^"Description" STRING "Ryosei can talk to animals and understands their speech."
        }

        ^"Instinctive Pathfinding" DEF {
            ^"Description" STRING "While in dense or forested surroundings, Ryosei ignores the effects of Entangling and Obscuring terrain. Once per scene as a Support action, she may extend this ability to up to two targets at range 0-1. The effects of this ability last for as long as affected targets remain in these surroundings."
        }

        ^"Trickster Magic" DEF {
            ^"Description" STRING "When Ryosei performs an action to activate an invocation, she may spend (op) in the following way: (op): A target at range 0-1 suffers the Disoriented condition. Additionally, she knows the following invocations: Path of Beasts (Celestial Realms, page 109), Messenger of Chikusho-do (Celestial Realms, page 106), Nature's Touch (core rulebook, page 194), and Inari's Blessing (core rulebook, page 209)."
        }

        RULES {
            #L5RCW41da14a8a049a5855f53fd: kitsune_ryosei "Kitsune Ryōsei: Young and untested, Kitsune Ryōsei only recently began shadowing her father in preparation to take over for him as the Fox Clan Champion. The entire clan has watched Ryōsei grow into a gallant, witty, and fearless woman, but while many believe she will prove a capable daimyō, she has shown no desire to lead. Her teachers say she possesses \"the heart of a Shinjo,\" and time has only proven them right. Still, Ryōsei has set aside her wanderlust and struggles to remain engaged in her father's lessons, if only out of obligation.\n\nDue to her father's age, until recently, Ryōsei was gradually shouldering more and more of his duties. She regarded each task with boredom, relying heavily on advisors and delegation so as to return to her own interests as quickly as possible. Then, almost overnight, Ryōsei changed completely, embracing her authority, disregarding advisors, and handling everything herself. Furthermore, among other sudden policy changes, she began pushing for the Fox to become deeply involved in the Empire's affairs, alarming many of her elder samurai. While this sudden change in attitude took many by surprise, it is also well known that Ryōsei made several pacts with tricksters of Sakkaku. Some wonder if the young champion is heeding the advice of an otherworldly counselor—or perhaps has been replaced entirely."
            #B20kZXpcMlAHvSjYsl0yu8: real_ryosei_and_impersonator "This profile is for the real Kitsune Ryōsei, who may be wandering the Empire. She is incognito, but her green eyes, lack of worldliness, or keepsakes from home may give her away. She is running from her responsibilities, and the PCs may feel compelled to convince her to return home. Or perhaps they will be willing to accompany her on a few adventures. She is, after all, very persistent. To represent the trickster spirit that is impersonating her, use this same profile, but apply the Trickster Animal in Disguise template, page 140."
        }
    }

    # ===========================
    # ADVENTURE NPCs (CHAPTER 4)
