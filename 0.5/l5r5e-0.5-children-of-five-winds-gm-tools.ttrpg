                ^"Void" INTEGER 3
            }
            ^"Endurance" INTEGER 8
            ^"Composure" INTEGER 10
            ^"Focus" INTEGER 5
            ^"Vigilance" INTEGER 3
            ^"Honor" INTEGER 60
            ^"Glory" INTEGER 50
            ^"Status" INTEGER 39
            ^"Demeanor" STRING "Shrewd"
            ^"Social Skill Check TN Modifiers" STRING "Air +2, Fire -2"
            ^"Skills" LIST OF STRING ["Artisan 2", "Martial 0", "Scholar 2", "Social 3", "Trade 0"]
            ^"Advantages" LIST OF STRING ["Professional Poise (Air) [Social; Interpersonal]"]
            ^"Disadvantages" LIST OF STRING ["Utter Gossip (Fire) [Social; Interpersonal]"]
        }

        ^"Master of Ceremonies" DEF {
            ^"Description" STRING "As tea master, Kotone has the right to speak the first word. During intrigue conflict scenes, characters who act before Kotone in initiative must forfeit 3 honor before starting their turn. They may choose instead to delay their turn to the end of the current initiative order."
        }

        ^"Stir the Leaves" DEF {
            ^"Description" STRING "As a Scheme action, Kotone may require any number of characters in the scene to make a TN 3 Courtesy (Air) or Performance (Air) check. Each character who fails increases the TN of their next check targeting Kotone by 1."
        }

        RULES {
            #L5RCW43e32b12d7a59cc5235b66: ikoma_kotone "Ikoma Kotone: [She/Her] Ikoma Kotone is the tea master and owner of the Teahouse with No Name in the City of the Rich Frog's Lion district. While she is diligent and professional, she does have a weak spot for gossip, and she has a particular love for taboo romance stories."
        }
    }

