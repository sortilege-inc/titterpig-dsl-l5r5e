EXTENSION "L5R5e_Children_of_Five_Winds_GM" EXTENDS "L5R5e_Children_of_Five_Winds" {
    NAME "Legend of the Five Rings 5th Edition - Children of the Five Winds: GM Tools"
    VERSION "0.5.1"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-03-01"

    # Children of the Five Winds (Chapter 3): Otherworldly encounters system,
    # spirit pacts, NPC templates, horse templates, named NPCs, animals,
    # peoples of the Sand Road, spirits and strange beings, adventure NPCs.

    # ===========================
    # OTHERWORLDLY ENCOUNTERS SYSTEM
    # ===========================

    # source stat block (page 125)
    ^"Otherworldly Encounters" DEF {
        APPLIES TO [#t9446c0a7f578c8eaf296f ^"System"]

        ^"Mortal Social Objectives" DEF {
            ENTRIES {
                #auk1Gml1uPhxcgPvMg7XzP ^"Create a Pact" DEF {
                    ^"Momentum Required" STRING "Spirit's focus + higher of (intrigue rank or combat rank) + 2"
                    ^"Description" STRING "Accumulate momentum to establish a binding agreement between mortal and spirit."
                }
                #WYMBIiE8xFE54bCOx34L2Y ^"Dispel Possession" DEF {
                    ^"Momentum Required" STRING "Spirit's focus + intrigue conflict rank (plus spirit's vigilance if possessing one of the characters pursuing this objective)"
                    ^"Description" STRING "Drive out a spirit that has possessed a character."
                }
                #mFkH7FK4IAsz6C4WaYgwZP ^"Invoke for Aid" DEF {
                    ^"Momentum Required" STRING "Spirit's intrigue conflict rank + rank of invocation desired (or +6 for effects more potent than an invocation)"
                    ^"Description" STRING "Request a spirit perform an invocation or other supernatural feat."
                }
                #5Cqhwbt3YAyOsKwrC4ee7e ^"Placate" DEF {
                    ^"Momentum Required" STRING "Spirit's focus + combat conflict rank"
                    ^"Description" STRING "Calm an enraged spirit."
                }
                #joFPnbIVJXlZJezhNCROKL ^"Seal in an Object" DEF {
                    ^"Momentum Required" STRING "Spirit's focus + double its intrigue conflict rank"
                    ^"Description" STRING "Bind a spirit in a physical vessel. The object gains the Sacred or Unholy quality. Way of Names practitioners may create a meishōdō talisman."
                }
            }

            RULES {
                #L5RCW0287e22c4061dfe3a362ca: mortal_social_objectives "New Mortal Social Objectives: When dealing with a spirit, a mortal character can pursue additional social objectives beyond those beginning on page 254 of the core rulebook. The following are some examples of objectives mortals can pursue when dealing with spirits."
            }
        }

        ^"Spirit Social Objectives" DEF {
            ENTRIES {
                #FJkkIF0wpHN4e0UMd88zsJ ^"Curse" DEF {
                    ^"Momentum Required" STRING "Target's focus + Theology ranks"
                    ^"Description" STRING "Lay a curse on a character."
                }
                #03HJp28PruV1DJmH3aGE5K ^"Inspire Awe" DEF {
                    ^"Momentum Required" STRING "Target's vigilance + Meditation ranks"
                    ^"Description" STRING "Terrify mortals with supernatural dread."
                }
                #CPBFSKAPxYHehWnCzo7BCq ^"Possession" DEF {
                    ^"Momentum Required" STRING "2 x (target's focus + Command ranks)"
                    ^"Description" STRING "Take over a character's body."
                }
                #4JCB3OFMN1mj7q7yI0HwHP ^"Request an Offering" DEF {
                    ^"Minimum Momentum" INTEGER 1
                    ^"Description" STRING "Spirits request tribute from mortals."
                }
            }

            RULES {
                #L5RCW03c0397773f0cb957ced31: spirit_social_objectives "New Spirit Social Objectives: In addition to the standard social objectives starting on page 254 of the core rulebook, spirits can pursue social objectives unique to their supernatural abilities. The following are some examples of objectives spirits can pursue."
            }
        }

        ^"New Encounter Actions" DEF {
            ENTRIES {
                #6XBAvPXGSI2KwO6cYFRGkD ^"Compel" DEF {
                    ^"Description" STRING "Use a spirit's true name to force cooperation. Requires Way of Names training."
                }
                #Y7oucRys8raxIufqcmBry7 ^"Entice" DEF {
                    ^"Description" STRING "Win a spirit's favor with offerings. Provides momentum and bonus information opportunities."
                }
            }

            RULES {
                #L5RCW042aee1def69565a437b05: new_encounter_actions "New Actions: The following new actions can be used by both mortal characters and spirits during otherworldly encounters. Characters (both spirit and mortal) can also use the Persuade action (page 257 of the core rulebook) in otherworldly encounters, as well as any shūji or unique actions the GM deems appropriate."
            }
        }

        RULES {
            #L5RCW015eae964d4f09cf64a17b: otherworldly_encounters "Rules for Otherworldly Encounters: This section covers rules for intrigues with spirits, helping GMs create evocative scenes involving supernatural beings. It includes new options for player characters to facilitate their interactions with these beings, as well as new rules for GMs to help spirit NPCs pursue their own goals in narrative and conflict scenes with the player characters. These rules build upon the rules for intrigues found on page 254 of the core rulebook."
        }
    }

    # ===========================
    # SPIRIT PACTS SYSTEM
    # ===========================

    # source stat block (page 131)
    ^"Spirit Pacts" DEF {
        APPLIES TO [#t9446c0a7f578c8eaf296f ^"System"]

        ^"Pact Terms (Spirit-Set)" DEF {
            ENTRIES {
                #JOsafQkIwKGiWuuwExdtgj ^"Mutual Defense" DEF { ^"Description" STRING "Both parties agree to defend each other." }
                #oGZf402EfUQQMa2VujT80J ^"Periodic Offerings" DEF { ^"Description" STRING "Mortal provides regular tribute to the spirit." }
                #3REEytJ5rQoS7zASFNBoj6 ^"Taboos" DEF { ^"Description" STRING "Mortal agrees to observe certain prohibitions." }
                #LpHvR3JwinzX3645ak3qKz ^"Various Tasks" DEF { ^"Description" STRING "Spirit assigns tasks to the mortal from time to time." }
            }

            RULES {
                #L5RCW060e85691f2c6fd30fee58: pact_terms_spiritset "Set the Terms: The terms are the part of the pact that the mortals involved must heed in order to continue to receive the spirit's blessing. If the mortals violate the terms, either by failing to uphold them or by going against a taboo, the spirit may withdraw its blessing. In extreme cases, a spirit might even attempt punitive action against offending mortals who live in or near its domain, though this is unusual in Rokugan. Some example terms might include:\n\nMutual Defense: A spirit might have enemies of its own from which it needs protection, and it could thus ask mortals to maintain defenses for it. Abiding by these terms does not usually mean taking up arms in its defense; instead, doing so often takes the form of maintaining barriers against invasive spiritual presences. These barriers might need to be periodically replaced, and failure to do so could allow the spirit's enemies to attack its domain.\n\nPeriodic Offerings: A spirit might ask mortals to make periodic offerings to it based on the boon it provides. These are often symbolic, such as a cup of sake brewed from the rice the spirit helps to flourish or the first painting an artist makes every year inspired by the terrain of the spirit's domain.\n\nTaboos: A spirit might restrict the harvesting of resources in the region near its domain. This might mean making sure that a large stand of trees is always allowed to flourish near where the spirit makes its home, or that a certain type of animal for which it has an affinity is allowed to live without being hunted or disturbed by mortals.\n\nVarious Tasks: Some spirits have difficulty performing tasks for themselves in the Mortal Realm, and others would simply prefer to have mortals attend to such matters. Tasks of this nature might include maintaining a shrine or set of shrines across the domain, undertaking deeds that relate to the spirit's interests in the Mortal Realm, or even trying to live up to some ideal the spirit considers important."
            }
        }

        ^"Pact Boons - Narrative" DEF {
            ENTRIES {
                #CDzIFb5ERxkOzn8MY9EHBX ^"Fortunate Finding" DEF { ^"Description" STRING "Mortal finds useful items or resources at opportune times." }
                #PGG9DJ5yNbSZHqGRiIJio9 ^"Gentle Rains" DEF { ^"Description" STRING "Favorable weather in the pact domain." }
                #YW8frysS25nJ2f16pnCc3W ^"Good Health" DEF { ^"Description" STRING "Resistance to disease and illness." }
                #jJ0A87pcqvcNtGiGBrrpUq ^"Inspiration" DEF { ^"Description" STRING "Creative insights and artistic breakthroughs." }
                #eRBJ6Kot8yFDBFB7qplp3i ^"Plenty" DEF { ^"Description" STRING "Abundant harvests and resources." }
                #oNGtn0CdzYdgpsXGk3Pc6O ^"Quiet Stars" DEF { ^"Description" STRING "External conflicts are naturally directed away from the domain by sudden storms, flooding rivers, or other phenomena." }
                #ge9YI5hsM4VFwo41CETxNa ^"Safe Harbor" DEF { ^"Description" STRING "A protected refuge within the domain." }
            }

            RULES {
                #L5RCW07369b7b46026a20fd20b6: pact_boons_narrative "Example Narrative Boons: The following are a few examples of narrative boons that could apply within a spirit's domain:\n\nBoon of Fortunate Finding: When an item is lost within the domain, it tends to turn up later at the exact moment someone needs it.\n\nBoon of Gentle Rains: The weather in the domain is consistent, delivering enough moisture, sun, and shade for plants and animals to flourish there.\n\nBoon of Good Health: Diseases are suppressed within the domain, and both their symptoms and spread (if applicable) are substantially reduced.\n\nBoon of Inspiration: People find the natural terrain, flora, and fauna within the domain to be especially good for inspiring works of art.\n\nBoon of Plenty: Harvests within the domain always generate a small surplus.\n\nBoon of Quiet Stars: External conflicts tend to be naturally directed away from the domain by sudden storms, flooding rivers, or other phenomena.\n\nBoon of Safe Harbor: Hostile Otherworldly and Tainted beings are unable to find the domain if actively searching for it, and they can enter only if invited by another being."
            }
        }

        ^"Pact Boons - Mechanical" DEF {
            ENTRIES {
                #Qj4UqcFfGgEzmhTp1pYvsi ^"Clarity" DEF { ^"Description" STRING "Gain the Centered condition." }
                #x55Op7ZvrE4DowWLBPVLk6 ^"Courage" DEF { ^"Description" STRING "Gain the Emboldened condition." }
                #lldk1oUkpbgQHXgnGaCUMt ^"Energetic Recovery" DEF { ^"Description" STRING "Enhanced fatigue recovery." }
                #3j3aBkIMzzYWafnNDJQv9W ^"Permanence" DEF { ^"Description" STRING "When a character makes a check to resist an effect of an Otherworldly being, they can reroll a number of dice up to the spirit's Water Ring." }
                #VezMEQ73Ah125Cmz4GBDDH ^"Purity" DEF { ^"Description" STRING "Resistance to spiritual corruption." }
                #Aplr60547ViKXPDjCVqbN6 ^"Restoration" DEF { ^"Description" STRING "Accelerated healing." }
                #3RRUCm4dGMLXWWyjoZ77qG ^"Skillful Hands" DEF { ^"Description" STRING "Bonus to craft or trade checks." }
            }

            RULES {
                #L5RCW08307da0cbb1fd65ef5047: pact_boons_mechanical "Example Mechanical Boons: The following are a few examples of mechanical boons that could apply within a spirit's domain:\n\nBoon of Clarity: At the start of each scene, each character gains the Centered condition (see page 133).\n\nBoon of Courage: At the start of each scene, each character gains the Emboldened condition (see page 133).\n\nBoon of Energetic Recovery: At the end of each scene, after a character removes fatigue and strife, they remove additional fatigue and strife equal to the spirit's Fire Ring.\n\nBoon of Permanence: When a character makes a check to resist an effect of an Otherworldly being, they can reroll a number of dice up to the spirit's Water Ring.\n\nBoon of Purity: When a character makes a check to resist the effect of a Tainted being, they can reroll a number of dice up to the spirit's Earth Ring. The area around the spirit's main habitation or shrine also becomes Hallowed (Spirit's Main Element) terrain.\n\nBoon of Restoration: When a character makes a check to heal an injury, remove a condition, or remove fatigue, they can reroll a number of dice up to the spirit's Void Ring.\n\nBoon of Skillful Hands: When a character makes a check to Restore, Adapt, Invent, Refine, or Attune to an item, they can reroll a number of dice up to the spirit's Air Ring."
            }
        }

        RULES {
            #L5RCW05e44c18a12ccdd952e3f9: spirit_pacts "Spirit Pacts: Spirits and mortals can voluntarily enter into pacts, which provide benefits to both sides. The Kitsune family maintains many such pacts across the Emerald Empire, and when a pact is broken, their Naturalists and Mediators are often the ones to intercede with the spirits to restore it.\n\nAfter a character completes the Create a Pact social objective, the GM and players determine the specifics of three pact components: the terms, the boons, and the domain. Mortals must abide by the terms set forth in the pact; so long as they do, they receive the pact's boons while they are within the spirit's domain.\n\nIn accordance with the following guidelines, the GM determines the pact's terms (on the spirit's behalf) and then the players choose the pact's boons. The domain in which the pact applies is determined by the power and influence of the spirit. The GM is the final arbiter of what constitutes an appropriate boon."
            #fMQBE58yny9yo28RYqXy2U: pick_the_boons "Pick the Boons: Spirits often provide certain boons to mortals who inhabit their domain, with the expectation of veneration or respect for taboos in exchange. Boons might include benefits like good harvests, protection from sickness, or regular rains. When one or more PCs and a spirit make a spirit pact, choose one narrative boon and one mechanical boon, both of which take effect within the spirit's domain when the pact is finalized. GMs should feel free to create new narrative and mechanical boon options to reflect the unique abilities of spirits. These boons will be what PCs may select from when forming their spiritual pact."
            #v7SUsZKmDJeZGZXqRdtCsz: define_the_domain "Define the Domain: A spirit's domain is generally the region it inhabits. The GM determines a spirit's domain based on its narrative influence and power. For most spirits, this means a spirit pact affects the nearby area. A few sample domains could include:\n\nA large wood around the spirit's center of power.\n\nA village where the primary shrine to the spirit is maintained.\n\nThe course of a river the spirit inhabits.\n\nA cavern complex and mountain peak the spirit inhabits.\n\nThe site around an item of importance to the spirit (potentially its mortal form's resting place, if it was once mortal)."
        }
    }

    # ===========================
    # NPC TEMPLATES
    # ===========================

    # source stat block (page 140)
    ^"Fox Clan Samurai Template" DEF {
        APPLIES TO [#t2513b5e05d845f4411465 ^"NPC Template"]
        PROPERTIES {
            ^"Base Profile" STRING "Any clan samurai profile"
            ^"Combat Rank Modifier" STRING "+1"
            ^"Intrigue Rank Modifier" STRING "+1"
            ^"Ring Modifier" STRING "+1 Earth"
            ^"Skill Modifier" STRING "+1 Scholar and Trade skills"
            ^"Advantages (add/replace 0-2)" LIST OF STRING ["Affinity with (any one animal species) (Void) [Social; Interpersonal]", "Animal Bond (Earth) [Social; Interpersonal, Mental]", "Sixth Sense (Void) [Martial; Spiritual]", "Talented Herbalist (Earth) [Social; Mental]"]
            ^"Disadvantages (add/replace 0-2)" LIST OF STRING ["Disdain for Urban Sprawl (Earth) [Interpersonal; Mental]", "Deals with Spirits (Fire) [Social; Interpersonal]", "Slow to Trust (Earth) [Social; Interpersonal]"]
            ^"Techniques (add/replace 0-2)" LIST OF STRING ["Invocations", "Kata", "Rituals"]
            ^"Demeanor (replace 1)" LIST OF STRING ["Detached", "Gruff", "Shrewd"]
        }

        RULES {
            #L5RCW091d399cf7b3763bec66fa: fox_clan_samurai_template "Fox Clan Samurai: This template can be used with any clan samurai profile."
        }
    }

    # source stat block (page 140)
    ^"Trickster Animal in Disguise Template" DEF {
        APPLIES TO [#t2513b5e05d845f4411465 ^"NPC Template"]
        PROPERTIES {
            ^"Base Profile" STRING "Any human or animal profile"
            ^"Combat Rank Modifier" STRING "+1"
            ^"Intrigue Rank Modifier" STRING "+2"
            ^"Ring Modifier" STRING "+1 Air or +1 Fire"
            ^"Skill Modifier" STRING "+1 Scholar, Social, and Trade skills"
            ^"Composure Modifier" STRING "+2"
            ^"Advantages (add/replace 0-2)" LIST OF STRING ["Affinity with (same type of animal) (Void) [Social; Interpersonal]", "Dangerous Allure (Fire) [Social; Interpersonal, Physical]", "Shapeshifter's Guile (Air) [Social; Interpersonal]"]
            ^"Disadvantage (required)" STRING "Choose an animal or Otherworldly being feature, which is the flaw in this NPC's disguise"
            ^"Other Disadvantages (add/replace 0-2)" LIST OF STRING ["Materialistic (Air) [Social; Mental]", "Mysterious Taboo (Void) [Social; Spiritual]", "Paranoia (Water) [Social; Mental, Physical]"]
            ^"Techniques (add/replace 1-2)" LIST OF STRING ["Invocations", "Ninjutsu", "Shūji"]
            ^"Demeanor (replace 1)" LIST OF STRING ["Detached", "Playful (Earth +2, Water -2)", "Shrewd"]
        }

        RULES {
            #L5RCW109ffd9d0e867b0ab31c77: trickster_animal_in_disguise_template "Trickster Animal in Disguise: This template can be used with any profile for a human, as well as with any animal profile. It can be used to create trickster animals that are disguising themselves as human beings (when applied to a human profile), or it can be used to create \"more powerful\" supernatural animals (when applied to an animal profile)."
        }
    }

    # source stat block (page 141)
    ^"Unicorn Clan Samurai Template" DEF {
        APPLIES TO [#t2513b5e05d845f4411465 ^"NPC Template"]
        PROPERTIES {
            ^"Base Profile" STRING "Any clan samurai profile"
            ^"Combat Rank Modifier" STRING "+2"
            ^"Ring Modifier" STRING "+1 Water"
            ^"Skill Modifier" STRING "+1 Martial and Trade skills"
            ^"Advantages (add/replace 0-2)" LIST OF STRING ["Affinity with Horses (Void) [Social; Interpersonal]", "Syncretic Philosophy (Water) [Social; Interpersonal, Mental]", "Quick Reflexes (Fire) [Martial; Interpersonal, Physical]", "Worldly (Void) [Social; Interpersonal, Physical]"]
            ^"Disadvantages (add/replace 0-2)" LIST OF STRING ["Bluntness (Air) [Social; Interpersonal]", "Softhearted (Fire) [Martial, Social; Interpersonal, Mental]", "Unfair Reputation (Air) [Social; Interpersonal]", "Wanderlust (Water) [Social; Mental]"]
            ^"Techniques (add/replace 0-2)" LIST OF STRING ["Kata", "Rituals", "Shūji"]
            ^"Demeanor (replace 1)" LIST OF STRING ["Assertive", "Compassionate", "Gruff"]
        }

        RULES {
            #L5RCW1124063fc9cb6bfcf01244: unicorn_clan_samurai_template "Unicorn Clan Samurai: This template can be used with any clan samurai profile."
        }
    }

    # ===========================
    # UNICORN HORSE BREEDS
    # ===========================

    ^"Unicorn Horse Breeds" DEF {
        APPLIES TO [#L5R464yZ6aB8cD0eF2gH4i ^"Table"]
        ENTRIES {
            #wxmoJlp7hQleJfJDW5BezW ^"Ide Traveling Pony" DEF {
                ^"Description" STRING "Hardy breed with +2 Endurance, +4 Composure, Intrigue +1. Removes Skittish disadvantage, adds Even-Tempered advantage. Built for endurance over long journeys."
            }
            #vgWA6jMT36mCWycF52scTL ^"Iuchi Riding Steed" DEF {
                ^"Description" STRING "Intelligent breed trained by Iuchi shugenja to respond to verbal and hand-gesture commands."
                ^"Conflict Rank Modifier" STRING "Intrigue +1"
                ^"Advantages (add 1)" LIST OF STRING ["Smart as a Human (Air) [Social; Mental]"]
                ^"Disadvantages (remove)" LIST OF STRING ["Skittish"]
                ^"Demeanor" STRING "Detached"
            }
            #7Y6DEOtPOC61uzvqgWBRPE ^"Moto Charger" DEF {
                ^"Description" STRING "Hot-tempered breed known for strength, size, and explosive gallop. Carries heavily armored lancers into battle but lacks stamina for prolonged journeys."
                ^"Conflict Rank Modifier" STRING "Combat +1"
                ^"Advantages (remove)" LIST OF STRING ["Tireless Runner"]
                ^"Advantages (add 2)" LIST OF STRING ["Brute Strength (Fire) [Martial; Physical]", "Fearsome Presence (Fire) [Social; Interpersonal]", "Masterful Fighter (Earth) [Martial; Mental]"]
                ^"Disadvantages (replace 1)" LIST OF STRING ["Quick to Anger (Fire) [Social; Interpersonal]", "Willful (Earth) [Social; Interpersonal]"]
            }
            #lOih52tqteoqBWy8UrO2G2 ^"Shinjo Courser" DEF {
                ^"Description" STRING "Renowned for speed and stamina but high-spirited and flighty. Ideal for scouts, courtiers, and mounted archers, but ill-suited to traditional battle."
                ^"Conflict Rank Modifier" STRING "Combat +1"
                ^"Endurance Modifier" STRING "+2"
                ^"Advantages (add)" LIST OF STRING ["Fleet of Foot (Water) [Martial; Physical]"]
                ^"Demeanor" STRING "Cautious [Air +2, Earth -2]"
            }
            #oFqZgrfnnnZDT2QSRb4Anu ^"Utaku Warhorse" DEF {
                ^"Description" STRING "Ideal blend of power, speed, and stamina bred by Utaku Horse Lord Disciples. Combat +1, +4 Endurance, +4 Composure. Removes Skittish disadvantage, adds one of: Fearsome Presence, Masterful Fighter, or Veteran's Instincts."
            }
        }

        RULES {
            #L5RCW1282394e2b9dd1cba69603: unicorn_horse_breeds "Horse Templates: As the dedicated masters of steeds throughout the Empire, the Unicorn families maintain their own unique horse breeds both for trade and their own use. GMs can represent horses from these breeds by applying the following templates to the Horse (Rokugani Pony) NPC profile on page 326 of the core rulebook. Additionally, the Wild Desert Horse and Ujik War Pony can be found in this section.\n\nRules for standard mounts are contained in the Unicorn Warhorses sidebar, on page 326 of the core rulebook."
        }
    }

    # ===========================
    # ANIMAL NPCs
    # ===========================

    # source stat block (page 143)
    ^"Aurochs" DEF {
        EXTENDS #t4540de6f35155c46f41f0 ^"NPC"

        PROPERTIES {
            ^"Type" STRING "Adversary" FIXED
            ^"Category" STRING "Animal"
            ^"Combat Conflict Rank" INTEGER 8
            ^"Intrigue Conflict Rank" INTEGER 1
            ^"Description" STRING "Massive wild cattle with equally massive horns. They travel in herds of roughly thirty."
            ^"Rings" DEF {
                ^"Air" INTEGER 1
                ^"Earth" INTEGER 5
                ^"Fire" INTEGER 3
                ^"Water" INTEGER 2
                ^"Void" INTEGER 1
            }
            ^"Endurance" INTEGER 16
            ^"Composure" INTEGER 14
            ^"Focus" INTEGER 4
            ^"Vigilance" INTEGER 3
            ^"Silhouette" INTEGER 4
            ^"Demeanor" STRING "Laconic"
            ^"Social Skill Check TN Modifiers" STRING "Fire +2, Water -2"
            ^"Skills" LIST OF STRING ["Artisan 0", "Martial 2", "Scholar 0", "Social 0", "Trade 0"]
            ^"Advantages" LIST OF STRING ["Enormous Stature (Earth) [Martial; Physical]"]
            ^"Disadvantages" LIST OF STRING ["Bad Temper (Fire) [Martial; Mental]"]
            ^"Favored Weapons" LIST OF STRING ["Horns: Range 1, Damage 8, Deadliness 6, Durable"]
            ^"Gear" LIST OF STRING ["Thick hide (Physical 5)"]
        }

        ^"Trample" DEF {
            ^"Description" STRING "The aurochs is a silhouette 4 creature. When an aurochs inflicts a critical strike, the TN of the check to resist is 6, and if the target fails their check to resist, the target suffers the Dazed condition in addition to the other effects."
        }

        RULES {
            #L5RCW13409f4f4bb1aa3fe9ff72: aurochs "Aurochs: Aurochs are massive wild cattle with equally massive horns. They travel in herds of roughly thirty. Their legs are longer than those of domesticated cattle, and they have muscular necks and shoulders. Their coats are typically black or reddish brown, with some spots of color variation. The Ujik hunt them in groups for their hide and meat; it requires a party of skilled hunters to take down even one of these mighty and aggressive beasts."
        }
    }

    # source stat block (page 144)
    ^"Badger" DEF {
        EXTENDS #t4540de6f35155c46f41f0 ^"NPC"

        PROPERTIES {
            ^"Type" STRING "Adversary" FIXED
            ^"Category" STRING "Animal"
            ^"Combat Conflict Rank" INTEGER 2
            ^"Intrigue Conflict Rank" INTEGER 1
            ^"Description" STRING "Solitary burrowing creature, prized in some communities and considered bad luck in others. Ferociously defends itself and its young when threatened."
            ^"Rings" DEF {
                ^"Air" INTEGER 1
                ^"Earth" INTEGER 3
                ^"Fire" INTEGER 3
                ^"Water" INTEGER 1
                ^"Void" INTEGER 1
            }
            ^"Endurance" INTEGER 12
            ^"Composure" INTEGER 6
            ^"Focus" INTEGER 4
            ^"Vigilance" INTEGER 2
            ^"Silhouette" INTEGER 1
            ^"Demeanor" STRING "Stubborn"
            ^"Social Skill Check TN Modifiers" STRING "Water +2, Earth -2"
            ^"Skills" LIST OF STRING ["Artisan 0", "Martial 1", "Scholar 0", "Social 0", "Trade 0"]
            ^"Advantages" LIST OF STRING ["Fast Burrowing (Earth) [Martial; Physical]"]
            ^"Disadvantages" LIST OF STRING ["Nocturnal (Earth) [Trade; Physical]", "Hot-Tempered (Fire) [Martial; Mental]"]
            ^"Favored Weapons" LIST OF STRING ["Claws: Range 0-1, Damage 4, Deadliness 3, Razor-Edged"]
        }

        ^"Berserker Fury" DEF {
            ^"Description" STRING "The badger is a silhouette 1 burrowing creature. After it is cornered, or after suffering a critical strike, the badger suffers the Enraged condition. While Enraged, a badger cannot suffer the Unconscious condition and may perform Attack actions even while incapacitated."
        }

        RULES {
            #L5RCW14ee6a8fba3f0d43df0607: badger "Badger: Solitary and burrowing creatures, badgers can be found throughout Rokugan. Their pelts and meat are prized in some communities, while in others it is considered bad luck to kill one. Badgers tend to be shy, but when threatened, they are known to ferociously defend themselves and their young. As with foxes, it is believed that many badgers are actually shapeshifting tricksters, although legends say mujina are less likely to seek out human beings except when they are testing their skill with illusion."
        }
    }

    # source stat block (page 144)
    ^"Giant Bat" DEF {
        EXTENDS #t4540de6f35155c46f41f0 ^"NPC"

        PROPERTIES {
            ^"Type" STRING "Minion" FIXED
            ^"Category" STRING "Animal"
            ^"Combat Conflict Rank" INTEGER 1
            ^"Intrigue Conflict Rank" INTEGER 1
            ^"Description" STRING "Docile creatures with wingspans nearing five feet and foxlike features. Considered good luck in Rokugani culture. Orchard farmers regard them with unmitigated pleasure."
            ^"Rings" DEF {
                ^"Air" INTEGER 4
                ^"Earth" INTEGER 1
                ^"Fire" INTEGER 2
                ^"Water" INTEGER 2
                ^"Void" INTEGER 1
            }
            ^"Endurance" INTEGER 6
            ^"Composure" INTEGER 6
            ^"Focus" INTEGER 6
            ^"Vigilance" INTEGER 3
            ^"Silhouette" INTEGER 1
            ^"Demeanor" STRING "Gregarious"
            ^"Social Skill Check TN Modifiers" STRING "Fire +2, Earth -2"
            ^"Skills" LIST OF STRING ["Artisan 0", "Martial 1", "Scholar 0", "Social 0", "Trade 0"]
            ^"Advantages" LIST OF STRING ["Keen Senses (Water) [Martial; Mental, Physical]", "Pack Tactics (Water) [Martial, Social; Interpersonal]"]
            ^"Disadvantages" LIST OF STRING ["Nocturnal (Earth) [Trade; Physical]"]
            ^"Favored Weapons" LIST OF STRING ["Bite: Range 0, Damage 2, Deadliness 1, Razor-Edged"]
        }

        ^"Nimble Flyer" DEF {
            ^"Description" STRING "The giant bat is a silhouette 1 creature that can fly. It can move vertically and ignores the negative effects of terrain."
        }

        RULES {
            #L5RCW15f664ffccb73cec7a26c9: giant_bat "Giant Bat: While the giant bats of Rokugan are intimidating to behold, flying at night with wingspans nearing five feet and foxlike features (hence their colloquial name of \"flying foxes\"), in truth they are docile creatures that feed on fruits and nectar. Bats are considered good luck in Rokugani culture, especially since the Rokugan word for bat, komori, can be spelled in a way that reads \"abundance of happiness.\" However, orchard farmers rarely regard them with unmitigated pleasure, as they have been known to devastate certain fruit harvests."
        }
    }

    # source stat block (page 145)
    ^"Golden Eagle" DEF {
        EXTENDS #t4540de6f35155c46f41f0 ^"NPC"

