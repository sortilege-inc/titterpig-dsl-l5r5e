            ^"Combat Conflict Rank" INTEGER 9
            ^"Intrigue Conflict Rank" INTEGER 7
            ^"Description" STRING "Daidoji Shin's long-suffering friend and bodyguard, ever loyal and determined to keep him out of harm's way."
        }

        RULES {
            #L5RCW50f2a3be8cea0388a4bf24: hiramori_kasami "Hiramori Kasami: [She/Her] Daidoji Shin's long-suffering friend and bodyguard, Kasami often wonders what she did to deserve the misfortune of serving her profligate charge. Even so, she remains ever loyal and determined to keep him out of harm's way despite his habits."
        }
    }
