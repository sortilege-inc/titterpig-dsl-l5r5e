        }

        RULES {
            #L5RCW497d916e5e929b9bcd81af: daidoji_shin "Daidoji Shin: [He/Him] This louche layabout and wastrel has recently turned amateaur, gentleman detective. After coasting through his role as the Crane Clan's trade envoy in the City of the Rich Frog, Shin found himself swept up in the mysteries of the city and discovered a taste for investigation. He is rarely seen without his bodyguard—and reluctant friend—Kasami."
        }
    }

    # source stat block (page 175)
    ^"Hiramori Kasami" DEF {
        EXTENDS #t4540de6f35155c46f41f0 ^"NPC"
        # Full stat block in l5r5e-0.3-daidoji-shin-npcs.ttrpg

        PROPERTIES {
