# L5R 5E — Deathly Turns: Mechanics (new schools, title, and nemuranai)
# "Deathly Turns" (supplemental encounters for Wheel of Judgment, FFG) closes with
# an appendix of two new BUSHI traditions, suitable for characters created in the
# afterlife, plus a new title (Spirit Hunter) and a nemuranai katana (Mizutsumi)
# awarded within the third encounter. All are transcribed VERBATIM from the source
# pages: for the schools, rings, starting skills, honor, techniques
# available/starting, school ability, mastery ability, starting outfit, and the
# six-rank curriculum. Technique names are listed as the school grants them; the
# technique DEFinitions themselves live in the core rulebook and the Celestial
# Realms sourcebook.

EXTENSION "L5R5e_DeathlyTurns_Mechanics" EXTENDS "L5R5e_Core_Character" {
    NAME "Deathly Turns — New Schools"
    VERSION "0.5.3"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-09-03"
    DEPENDS_ON "L5R5e_Core_Character"

    # ═══════════════ MAZOKU'S ENFORCER TRADITION [Bushi, Sage] ═════════════
    #6Qdo6auAhoI6zTO0kNPqva ^"Mazoku's Enforcer" DEF {
        EXTENDS #L5R252wX4yZ6aB8cD0eF2g ^"School"
        APPLIES TO [#L5R003xY4zA6bC8dE0fG2hI ^"Samurai"]

        PROPERTIES {
            ^"School Name" STRING "Mazoku's Enforcer Tradition" FIXED
            ^"Roles" LIST ["Bushi", "Sage"]
            ^"Ring Increase" DEF { ^"Earth" INTEGER 1 ^"Void" INTEGER 1 }
            ^"Starting Skills" DEF { CHOOSE 5 [^"Command", ^"Fitness", ^"Martial Art [Melee]", ^"Martial Arts [Unarmed]", ^"Meditation", ^"Tactics", ^"Theology"] INTEGER 1 }
            ^"Starting Honor" INTEGER DEFAULT 45
            ^"Techniques Available" LIST ["Kata", "Rituals", "Shūji"]
            ^"Starting Advantage" STRING "Sixth Sense"
            ^"Starting Disadvantage" STRING "Haunting or Omen of Bad Luck (choose one)"
        }

        STARTING_TECHNIQUES {
            KATA ^"Open-Hand Style"
            RITUAL ^"Commune with Spirits"
        }

        SCHOOL_ABILITY "Mazoku's Authority" {
            "When you perform an Attack or Scheme action check targeting an Otherworldly being, if you succeed, add a number of bonus successes equal to your school rank."
        }

        MASTERY_ABILITY ^"Hunter of the Supernatural" {
            "When making a check targeting an Otherworldly being, you may seize one of its advantages (see page 101 of the core rulebook) by receiving 2 fatigue instead of spending 1 Void point. If you do, your target receives strife equal to your ranks in Command."
        }

        STARTING_OUTFIT [
            "Traveling clothes", "robes of judgment or sanctified robes",
            "daishō (katana and wakizashi)",
            "shakujo (ceremonial staff) or yumi (bow) and quiver of arrows",
            "scroll satchel", "journal", "traveling pack"
        ]

        CURRICULUM {
            RANK 1 {
                SKILL_GROUP "Martial Skills"
                SKILL "Command"
                SKILL "Sentiment"
                SKILL "Theology"
                TECHNIQUE_GROUP "Rank 1 Rituals"
                ^"Iaijutsu Cut: Crossing Blade" [kata]
                ^"Weight of Duty" [shuji]
            }
            RANK 2 {
                SKILL_GROUP "Social Skills"
                SKILL "Martial Arts [Melee]"
                SKILL "Meditation"
                SKILL "Theology"
                TECHNIQUE_GROUP "Rank 1-2 Earth Shūji"
                ^"Touchstone of Courage" [shuji]
                ^"Rite of the Wheel" [ritual]
            }
            RANK 3 {
                SKILL_GROUP "Martial Skills"
                SKILL "Performance"
                SKILL "Sentiment"
                SKILL "Theology"
                TECHNIQUE_GROUP "Rank 1-3 Kata"
                ^"Soul Sunder" [kata]
                ^"Rallying Cry" [shuji]
            }
            RANK 4 {
                SKILL_GROUP "Scholar Skills"
                SKILL "Courtesy"
                SKILL "Martial Arts [Ranged]"
                SKILL "Tactics"
                TECHNIQUE_GROUP "Rank 1-4 Rituals"
                ^"Striking as Void" [kata]
                ^"Prayer of Protection" [ritual]
            }
            RANK 5 {
                SKILL_GROUP "Martial Skills"
                SKILL "Courtesy"
                SKILL "Sentiment"
                SKILL "Theology"
                TECHNIQUE_GROUP "Rank 1-5 Kata"
                ^"Rouse the Soul" [shuji]
                ^"The Immovable Hand of Peace" [shuji]
            }
            RANK 6 {
                ^"Hunter of the Supernatural"
            }
        }

        RULES {
            #t7iSN7WZ3k1GXZ1rEEtlWk: mazokus_enforcer_tradition_description "Mazoku's Enforcer Tradition [Bushi, Sage]: Occasionally, overworked mazoku will \"recruit\" humans (living or dead) to serve as their swords, training them to adjudicate spiritual disputes and uphold the justice of Emma-Ō across all realms. Such was the case with the foundation of the Falcon Clan, and many of its warriors are trained in this tradition, but mazoku sometimes choose individuals of rare talent as well. While those trained in these arts are not shugenja, they are capable of seeing and interacting with spirits, allowing them to pursue wayward ghosts and bring peace to their souls no matter where they may appear. Some are even allowed to wear Emma-Ō's blessed robes of judgment to mark them as favored agents."
        }
    }

    # ═══════════════ CHAMPION OF DAYS GONE TRADITION [Bushi] ═══════════════
    #SqKLSsC0H9mWNq576FVRzG ^"Champion of Days Gone" DEF {
        EXTENDS #L5R252wX4yZ6aB8cD0eF2g ^"School"
        APPLIES TO [#L5R003xY4zA6bC8dE0fG2hI ^"Samurai"]

        PROPERTIES {
            ^"School Name" STRING "Champion of Days Gone Tradition" FIXED
            ^"Roles" LIST ["Bushi"]
            ^"Ring Increase" DEF { ^"Air" INTEGER 1 ^"Void" INTEGER 1 }
            ^"Starting Skills" DEF { CHOOSE 5 [^"Courtesy", ^"Composition", ^"Fitness", ^"Martial Art [Ranged]", ^"Martial Arts [Melee]", ^"Meditation", ^"Sentiment"] INTEGER 1 }
            ^"Starting Honor" INTEGER DEFAULT 50
            ^"Techniques Available" LIST ["Kata", "Rituals", "Shūji"]
        }

        STARTING_TECHNIQUES {
            KATA ^"Hawk's Precision"
            SHUJI ^"Courtier's Resolve"
        }

        SCHOOL_ABILITY "Effortless Aim" {
            "When making a check using a bow, add a number of kept (ring) set to an (op) result equal to your school rank."
        }

        MASTERY_ABILITY ^"An Arrow Loosed" {
            "Once per game session, before making a check with a bow, you may declare your confidence in a shot and stake up to 6 glory upon hitting your mark. Reduce the TN of the check by that amount. If you succeed, you recover your staked glory. If succeeding in the shot would cause you to receive a glory award (such as if you were competing with another skilled archer, or felled a dangerous beast on the hunt), you receive that amount of glory plus 3 instead. If you fail, you lose your staked glory."
        }

        STARTING_OUTFIT [
            "Resplendent traveling clothes", "chokutō", "knife",
            "Ceremonial yumi (bow) with quiver of arrows",
            "5 armor-piercing arrows", "5 fleshcutter arrows",
            "2 humming bulb arrows", "traveling pack"
        ]

        CURRICULUM {
            RANK 1 {
                SKILL_GROUP "Martial Skills"
                SKILL "Courtesy"
                SKILL "Culture"
                SKILL "Government"
                TECHNIQUE_GROUP "Rank 1 Air Shūji"
                ^"Pelting Hail Style" [kata]
                ^"Striking as Air" [kata]
            }
            RANK 2 {
                SKILL_GROUP "Social Skills"
                SKILL "Fitness"
                SKILL "Martial Arts [Ranged]"
                SKILL "Sentiment"
                TECHNIQUE_GROUP "Rank 1-2 Water Shūji"
                ^"All Arts are One" [shuji]
                ^"Tactical Assessment" [shuji]
            }
            RANK 3 {
                SKILL_GROUP "Scholar Skills"
                SKILL "Aesthetics"
                SKILL "Command"
                SKILL "Martial Arts [Ranged]"
                TECHNIQUE_GROUP "Rank 1-3 Fire Shūji"
                ^"A Samurai's Fate" [shuji]
                ^"Breath of Wind Style" [kata]
            }
            RANK 4 {
                SKILL_GROUP "Martial Skills"
                SKILL "Culture"
                SKILL "Design"
                SKILL "Government"
                TECHNIQUE_GROUP "Rank 1-4 Earth Shūji"
                ^"Pin the Fan" [kata]
                ^"Disappearing World Style" [kata]
            }
            RANK 5 {
                SKILL_GROUP "Social Skills"
                SKILL "Martial Arts [Ranged]"
                SKILL "Sentiment"
                SKILL "Tactics"
                TECHNIQUE_GROUP "Rank 1-5 Void Shūji"
                ^"Soul Sunder" [kata]
                ^"Striking as Void" [kata]
            }
            RANK 6 {
                ^"An Arrow Loosed"
            }
        }
    }

    # ═══════════════════════ NEW TITLE ═════════════════════════
    # source stat block (page 21). The Foundry
    # compendium files this title as "Spirits hunter" (a typo); the book prints
    # "Spirit Hunter" throughout.
    #GEVEN7JqslJOTjB7ZTQyFu ^"Spirit Hunter" DEF {
        APPLIES TO [#L5R003xY4zA6bC8dE0fG2hI ^"Samurai"]
        PROPERTIES {
            ^"Type" STRING "Title"
            ^"Assigned By" STRING "Lady Mazoku"
            ^"Status Modifier" INTEGER 5
            ^"Glory Modifier" INTEGER 0
            ^"XP Cost" INTEGER 12
            ^"Title Ability" STRING "Celestial Influence: Reduce the TN of your Attack and Scheme action checks targeting Otherworldly beings by 1 (to a minimum of 1)."
            ^"Advances" STRING "Martial Skills (skill group), Social Skills (skill group), Government (skill), Theology (skill), = Rank 1 Rituals (ritual, tech group)"
        }

        RULES {
            #MhyAXODam8Md1BFBUFYTFo: spirit_hunter_description "Spirit Hunter (Title): Lady Mazoku occasionally elevates mortals to assist her in work in the Mortal Realm, detecting and banishing spirits who seek to do harm. While some mortals dedicate their lives to serving her, for most, it is part-time work at best. A character who has completed this title is one of her trusted agents. The character has privileges in certain realms of the dead (Meido, Gaki-dō, or Tōshigoku) and abilities when dealing with their denizens, but lives most of their life in their normal station."
        }
    }

    # ═════════════════════ NEW NEMURANAI ═══════════════════════
    #HCacnAByZ6yBGLaTsHRqly ^"Mizutsumi" DEF {
        APPLIES TO [#te28b9de1d70883d12c080 ^"Item"]
        PROPERTIES {
            ^"Item Type" STRING "Nemuranai (katana)" FIXED
            ^"Weapon Type" STRING "Katana"
            ^"Profile" STRING "Range 1, Damage 4, Deadliness 5, Ceremonial, Razor-Edged, Sacred"
            ^"Quirk" STRING "Mizutsumi also causes a gentle rain or snow to fall for a few hours the first time it is drawn each season (it has not been drawn in some years)."
            ^"Special" STRING "More importantly, as the nemuranai possesses the Sacred item quality, Mizutsumi ignores Hagane's considerable physical resistance."
            ^"Sealed Invocation" STRING "Akifusa possesses Mizutsumi, a katana that is a nemuranai with the Heart of the Water Dragon invocation sealed within it (see pages 208 and 307 of the core rulebook). The wielder can perform the invocation once per game session using the Sentiment skill instead of Theology."
        }

        RULES {
            #RjQSHY2Rchh1rWLDMOMEOa: mizutsumi_awarded "If the PCs both save Akifusa and set Hagane to rest, Akifusa gives them his nemuranai, Mizutsumi, in thanks for helping him absolve himself. If the PCs set Hagane to rest, they can also take Hagane and Noroi, his daishō (katana and wakizashi). If Hagane's name has been cleared publicly, returning the daishō to the Mirumoto family is a massive sacrifice in the name of Compassion. Moreover, once Hagane has been put to rest and has returned to the afterlife, Lady Mazoku offers the PCs the Spirit Hunter title (see this page)."
        }
    }
}
