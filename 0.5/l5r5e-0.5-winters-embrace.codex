# .codex SECTION — Winter's Embrace (adventure). Stand-off graph over
# l5r5e-0.5-winters-embrace.lore (spec §25). Part of the L5R5e system graph;
# DEPENDS_ON the shared schema.
#
# The 11 cast NPCs (cast.ttrpg) are DEFs — referenced via ^"...", never minted;
# some (Kakita Ryoku, Miya Satoshi) also already have codex entities from other
# books, which the DEFs coexist with. Kyūden Doji, the Kolat, Ikoma Ujiaki,
# Bayushi Kachiko, Doji Hotaru, Kakita Yoshi, Gotei City, and the Islands of
# Spice and Silk are already in the graph (Kyūden Doji amended). The Ikoma,
# Bayushi, Doji, and Mantis Clan DEFs are referenced. This section mints the
# play, the Storm Fleet, the Ikoma Shadow School, and a few lore-only figures.

CODEX "L5R5e_WintersEmbrace_Codex" {
    NAME "Winter's Embrace — Lore Graph"
    VERSION "0.5.2"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-09-03"
    FOR EDITION "l5r5e"
    DEPENDS_ON "L5R5e_Codex_Schema" VERSION "0.5.9"

    # ---- The play & the institutions --------------------------------------
    ENTITY #L5RcxWin01fishermansdaughter ^"The Tale of the Fisherman's Daughter" {
        IS ^"Document"
        SOURCE "l5r5e-0.5-winters-embrace.lore" AT "adventure-overview"
        RELATIONSHIPS { ^"located-in" -> ^"Kyūden Doji" }
    }
    ENTITY #L5RcxWin02dojimioko ^"Doji Mioko" {
        IS ^"Person"
        SOURCE "l5r5e-0.5-winters-embrace.lore" AT "adventure-overview"
    }
    ENTITY #L5RcxWin03stormfleet ^"Storm Fleet" {
        IS ^"Organization"
        SOURCE "l5r5e-0.5-winters-embrace.lore" AT "the-crane-clan-hosts"
        RELATIONSHIPS {
            ^"operated-by" -> ^"Mantis Clan"   FROM "Trusted captain in the Mantis' Storm Fleet"
            ^"led-by"      -> ^"Lord Yoritomo"  FROM "Lord Yoritomo: Mantis Clan Champion and leader of the Storm Fleet, as well as Lady Magami’s uncle (page 31)." }
    }
    ENTITY #L5RcxWin04ikomashadowschool ^"Ikoma Shadow School" {
        IS ^"School"
        SOURCE "l5r5e-0.5-winters-embrace.lore" AT "ikoma-rumiko"
        RELATIONSHIPS { ^"operated-by" -> ^"Ikoma" FROM "a shinobi trained in the Lion's Ikoma Shadow School" }
    }

    # ---- Lore-only figures -------------------------------------------------
    ENTITY #L5RcxWin05bayushimikuru ^"Bayushi Mikuru" {
        IS ^"Person"
        SOURCE "l5r5e-0.5-winters-embrace.lore" AT "otomo-koryusai"
        RELATIONSHIPS {
            ^"member-of"  -> ^"Bayushi"        FROM "Since his wedding to Bayushi Mikuru, Koryusai has succumbed to cynicism and sorrow."
            ^"married-to" -> ^"Otomo Koryusai" FROM "Since his wedding to Bayushi Mikuru, Koryusai has succumbed to cynicism and sorrow" }
    }
    ENTITY #L5RcxWin06linmei ^"Linmei" {
        IS ^"Person"
        SOURCE "l5r5e-0.5-winters-embrace.lore" AT "yoritomo-lord-of-the-mantis-clan"
        RELATIONSHIPS { ^"married-to" -> ^"Lord Yoritomo" FROM "Married to Linmei of the kōmori people, he honors the roots of his people" }
    }
    ENTITY #L5RcxWin07masato ^"Masato" {
        IS ^"Person"
        SOURCE "l5r5e-0.5-winters-embrace.lore" AT "doji-shigerulady-shike"
        RELATIONSHIPS { ^"married-to" -> ^"Doji Shigeru" FROM "Shigeru lives with his husband, Masato, a former member of the Matsu family" }
    }

    # ---- Amendment ---------------------------------------------------------
    ENTITY #X1fPpv8iu809AUmSPko3dM ^"Kyūden Doji" {
        SOURCE "l5r5e-0.5-winters-embrace.lore" AT "the-imperial-families"
        RELATIONSHIPS { ^"held-by" -> ^"Doji" FROM "Winter's Embrace includes a fold-out map of Kyūden Doji and its surrounding holdings." }
    }
}
