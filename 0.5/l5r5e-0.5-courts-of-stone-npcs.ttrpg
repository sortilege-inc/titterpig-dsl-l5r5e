        }

        RULES {
            #L5RCS09sT9uV1wX3yZ5aB7cD: kyuden_doji_courtier_description "Kyūden Doji Courtier: Imagine the perfect courtier. Well dressed. Beautiful. Graceful. Well versed in the classics, trained in the fine arts, capable of speaking with wit and insight on any topic. This is someone raised in Kyūden Doji."
        }
    }

