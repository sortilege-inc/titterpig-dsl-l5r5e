        #H90Of5kg2vR5AOgJRXJvQW ^"Restless Spirits" DEF {
            ^"Description" STRING "While making a check, any character at range 0-5 of Ryūhei may spend (op) as follows:\n\n(op): Receive 4 strife to gain 1 Void point."
        }

    }

