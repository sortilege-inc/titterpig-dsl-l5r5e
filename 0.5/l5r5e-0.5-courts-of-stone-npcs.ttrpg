        }

        #zv0k9utLZ4Jp3XTx3D0h6b ^"Thin Doors" DEF {
            ^"Description" STRING "Activation: When a character makes a Scheme action check targeting a Hida Door Guard, the character may spend (op) in the following way:\n\n(op): The Hida Door Guard reveals the latest rumor related to the current topic of discussion.\n\n(op) (op): The Hida Door Guard unknowingly reveals one item of useful information not related to the current topic."
        }

        RULES {
            #L5RCS03yZ3aB5cD7eF9gH1iJ: hida_door_guard_description "Hida Door Guard: The guards who protect Kyūden Hida's many gates are stalwart warriors and dangerous foes. Traditionally, the Hida rotate warriors off the Wall and give them 'light duty' such as this to allow them a chance to recuperate from the horrors of the Shadowlands. This means Kyūden Hida is guarded by hardened veterans; but they're also gossipy, bored, and not good at keeping secrets."
        }
    }

