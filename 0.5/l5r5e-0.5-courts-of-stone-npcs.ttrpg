            }
            ^"Demeanor" STRING "Gruff"
            ^"Social Skill Check TN Modifiers" STRING "Water +2, Earth -2"
            ^"Endurance" INTEGER 13
            ^"Composure" INTEGER 10
            ^"Focus" INTEGER 5
            ^"Vigilance" INTEGER 3
            ^"Honor" INTEGER 49
            ^"Glory" INTEGER 43
            ^"Status" INTEGER 31
            ^"Skills" LIST OF STRING ["Artisan 1", "Martial 3", "Scholar 3", "Social 1", "Trade 3"]
            ^"Advantages" LIST OF STRING ["Famously Reliable (Earth) [Social; Interpersonal]"]
            ^"Disadvantages" LIST OF STRING ["Lost Leg (Air) [Martial; Physical]"]
            ^"Favored Weapons" LIST OF STRING ["Katana: Range 1, Damage 4, Deadliness 5/7, Ceremonial, Razor-Edged"]
            ^"Gear" LIST OF STRING ["Wakizashi", "Kimono", "Calligraphy set", "Lacquered armor (Physical 4, Ceremonial, Cumbersome, Wargear)"]
        }

        #aYdTc0qwglDjBI7ODq9yoF ^"War Stories" DEF {
            ^"Description" STRING "As a downtime activity, Chobo can share his stories of defending the Wall with any number of characters. A character who chooses to listen to the stories suffers 3 strife and adds one kept (ring) set to an (op) result to their next check that involves the terrain, lore, or denizens of the Shadowlands."
        }

        RULES {
            #L5RCS02mN2oP4qR6sT8uV0wX: chobo_storemaster_description "Hida Chobo, Storemaster: Once, Hida Chobo was a soldier at the Kaiu Wall, until a massive oni shattered a tower Chobo was defending; Chobo's leg was crushed in the rubble. The Crab Clan, always practical, took note of his keen mind and reassigned him to handling supplies and records at Kyūden Hida. There, Chobo has fulfilled his duties well. He's often willing to swap tales with outsiders, although they may tire of his endless war stories. Because Chobo manages the flow of supplies in and out of Kyūden Hida, he is in regular communication with officers and personal friends throughout the southern Crab lands."
        }
    }

