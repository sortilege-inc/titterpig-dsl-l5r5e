    # --- Shiro Kitsuki (Dragon) ---

    # source stat block (page 36)
    #Z2nQYWlcP5qEsQEM7uDslh ^"Kitsuki Ma'aya, Castellan" DEF {
        EXTENDS #t4540de6f35155c46f41f0 ^"NPC"

        PROPERTIES {
            ^"Type" STRING "Adversary" FIXED
            ^"Combat Conflict Rank" INTEGER 4
            ^"Intrigue Conflict Rank" INTEGER 5
            ^"Rings" DEF {
                ^"Air" INTEGER 4
                ^"Earth" INTEGER 3
                ^"Fire" INTEGER 2
                ^"Water" INTEGER 4
                ^"Void" INTEGER 3
            }
            ^"Demeanor" STRING "Vain"
            ^"Social Skill Check TN Modifiers" STRING "Earth +2, Air -2"
            ^"Endurance" INTEGER 12
            ^"Composure" INTEGER 14
            ^"Focus" INTEGER 6
            ^"Vigilance" INTEGER 4
            ^"Honor" INTEGER 50
            ^"Glory" INTEGER 40
            ^"Status" INTEGER 39
            ^"Skills" LIST OF STRING ["Artisan 1", "Martial 2", "Scholar 4", "Social 3", "Trade 4"]
            ^"Advantages" LIST OF STRING ["Keen Sight (Water) [Scholar; Mental, Physical]"]
            ^"Disadvantages" LIST OF STRING ["Vulnerable Students (Air) [Social; Interpersonal]"]
            ^"Favored Weapons" LIST OF STRING ["Wakizashi: Range 0-1, Damage 3, Deadliness 5/7, Ceremonial, Razor-Edged"]
            ^"Gear" LIST OF STRING ["Castellan robes (Physical 1, Ceremonial)", "Calligraphy set", "Law scrolls"]
        }

        #Uz881JHZDlakyNNYGPnILq ^"Boastful Investigator" DEF {
            ^"Description" STRING "When Ma'aya assists another character making a Skulduggery or Scholar check concerning a criminal matter, she allows the character to roll two additional (skill) instead of just one. If the character succeeds on the check, after resolving its effects, they receive 4 strife."
        }

        #T0cSquWgP5uBntHwzExvep ^"Skulk (Ma'aya)" DEF {
            ^"Description" STRING "Activation: When she performs an Initiative or Attack check using Air, Ma'aya may spend (op) as follows:\n\n(op): If Ma'aya is in Obscuring terrain, a crowd, or otherwise concealed from sight, one character with vigilance lower than or equal to 4 loses sight of her."
        }

        RULES {
            #L5RCS05wX5yZ7aB9cD1eF3gH: maaya_castellan_description "Kitsuki Ma'aya, Castellan: Over the course of a long and storied career, Kitsuki Ma'aya has solved crimes and mysteries on behalf of the Emperor, the clans, and the religious institutions of Rokugan. She has operated as an agent of the Dragon Clan, an Emerald Magistrate, and even a rōnin, sometimes working in disguise under an assumed identity. Her skill in the subtle arts stands in contrast to her own temperament: she revels in glory, attention, and public recognition for her successes and investigative genius.\n\nTen years ago, a string of narrowly foiled assassination attempts drove her into retirement. She found safety as Shiro Kitsuki's castellan, but she nevertheless chafes at the solitude and quiet that surround her. Now that her husband has passed away, Ma'aya's greatest joy—beyond her children's and grandchildren's occasional visits—comes from the classroom. She teaches several classes on logic, forensic methodology, and other investigative arts, frequently taking class time to tell the stories of her own exploits."
        }
    }

