# .codex SECTION — Cresting Waves (supplemental encounters). Stand-off graph over
# l5r5e-0.5-cresting-waves.lore (spec §25). Part of the L5R5e system graph;
# DEPENDS_ON the shared schema.
#
# The four adversaries (l5r5e-0.5-cresting-waves-cast.ttrpg) are DEFs — referenced
# via ^"...", never minted. Twin Blessings Village, Closed Shell Castle, Setsuo,
# Daizō, and Reo are already in the graph from Sins of Regret / Path of Waves —
# referenced, and Twin Blessings Village / Closed Shell Castle / Setsuo amended.
# This section mints Nestled Village and the encounters' lore-only villagers
# (Jimba, Nayaka, Miyoko, Kyou, Sora, Sayaka).

CODEX "L5R5e_CrestingWaves_Codex" {
    NAME "Cresting Waves — Lore Graph"
    VERSION "0.5.2"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-09-03"
    FOR EDITION "l5r5e"
    DEPENDS_ON "L5R5e_Codex_Schema" VERSION "0.5.9"

    # ---- Place ------------------------------------------------------------
    ENTITY #L5RcxCW07nestledvillage ^"Nestled Village" {
        IS ^"Village"
        SOURCE "l5r5e-0.5-cresting-waves.lore" AT "encounter-overview"
        RELATIONSHIPS { ^"located-near" -> ^"Twin Blessings Village" FROM "He was last seen going out to gather wood in the common-land forest between Twin Blessings Village and Nestled Village." }
    }

    # ---- Encounter 1 villagers (lore-only) --------------------------------
    ENTITY #L5RcxCW01jimbavictim ^"Jimba" {
        IS ^"Person"
        SOURCE "l5r5e-0.5-cresting-waves.lore" AT "encounter-overview"
        RELATIONSHIPS { ^"enemy-of" -> ^"Banji, Murderous Villager" }
    }
    ENTITY #L5RcxCW02nayakawife ^"Nayaka" {
        IS ^"Person"
        SOURCE "l5r5e-0.5-cresting-waves.lore" AT "npcs-in-the-encounter"
        RELATIONSHIPS {
            ^"married-to" -> ^"Banji, Murderous Villager"
            ^"sibling-of" -> ^"Miyoko"                    FROM "Nayaka: wife of Banji and Miyoko’s sister." }
    }
    ENTITY #L5RcxCW03miyokodoshin ^"Miyoko" {
        IS ^"Person"
        SOURCE "l5r5e-0.5-cresting-waves.lore" AT "encounter-overview"
    }

    # ---- Encounter 2 villagers (lore-only) --------------------------------
    ENTITY #L5RcxCW04kyouyouth ^"Kyou" {
        IS ^"Person"
        SOURCE "l5r5e-0.5-cresting-waves.lore" AT "encounter-overview"
        RELATIONSHIPS { ^"companion-of" -> ^"Sora" FROM "Kyou has found true love with Sora, an inhabitant of Nestled Village" }
    }
    ENTITY #L5RcxCW05soralover ^"Sora" {
        IS ^"Person"
        SOURCE "l5r5e-0.5-cresting-waves.lore" AT "encounter-overview"
        RELATIONSHIPS { ^"member-of" -> ^"Nestled Village" FROM "Sora, an inhabitant of Nestled Village" }
    }
    ENTITY #L5RcxCW06sayakaelder ^"Sayaka the Elder" {
        IS ^"Person"
        SOURCE "l5r5e-0.5-cresting-waves.lore" AT "prisoners"
        RELATIONSHIPS { ^"member-of" -> ^"Nestled Village" }
    }

    # ---- Amendments to existing graph nodes --------------------------------
    ENTITY #23oYT6gITMaaphu2MYExBu ^"Twin Blessings Village" {
        SOURCE "l5r5e-0.5-cresting-waves.lore" AT "the-encounters"
        RELATIONSHIPS { ^"haunted-by" -> ^"Onryō, Vengeful Ghost" }
    }
    ENTITY #OW8JJmwBXllxXailcVMIs7 ^"Closed Shell Castle" {
        SOURCE "l5r5e-0.5-cresting-waves.lore" AT "encounter-three-on-the-road"
        RELATIONSHIPS { ^"located-near" -> ^"Twin Blessings Village" FROM "the road between Twin Blessings Village and Closed Shell Castle" }
    }
    ENTITY #icDkwwPyNcpIuTa94ZE1ln ^"Setsuo" {
        SOURCE "l5r5e-0.5-cresting-waves.lore" AT "missing-youth"
        RELATIONSHIPS { ^"oversees" -> ^"Twin Blessings Village" FROM "Setsuo, the village leader" }
    }
    ENTITY #5kYR3OwDrah1jFEap9rWe5 ^"Daizō" {
        SOURCE "l5r5e-0.5-cresting-waves.lore" AT "npcs-in-the-encounter"
    }
    ENTITY #7wRXjYRw0qwAnrAhZTXQPR ^"Reo" {
        SOURCE "l5r5e-0.5-cresting-waves.lore" AT "defeating-the-ghost"
    }
}
