    ^"Blessing Source: Sahil, Guardian of Transition" DEF {
        APPLIES TO [#tac037e8b1df3edd35ce4b ^"Celestial Implement"]
        PROPERTIES {
            ^"Element" STRING "Void"
            ^"Counter Element" STRING "Void"
            ^"Restriction" STRING "Do not strike an unaware, Incapacitated, or Unconscious foe, or undermine someone's interests behind their back."
        }
    }

    # source stat block (page 101)
    ^"Blessing Source: Naga" DEF {
        APPLIES TO [#tac037e8b1df3edd35ce4b ^"Celestial Implement"]
        PROPERTIES {
            ^"Element" STRING "Water"
            ^"Counter Element" STRING "Fire"
            ^"Restriction" STRING "Pay due respect to naga and all their serpentine kin, and do not harm any snake."
        }
    }

    # --- IMPLEMENT FORMS ---

    ^"Implement Form: Projectile" DEF {
        APPLIES TO [#tac037e8b1df3edd35ce4b ^"Celestial Implement"]
        PROPERTIES {
            ^"Description" STRING "An arrow, crossbow bolt, or slingstone that modifies the profile of the weapon with which it is used is adjusted as follows: (Damage +4, Deadliness +4, Razor-Edged). Or a javelin with the following profile when thrown: (Range 2–4, Damage 4, Deadliness 6, Razor-Edged)."
            ^"Profile Modification" STRING "Arrow/bolt/stone: Damage +4, Deadliness +4, Razor-Edged. Javelin: Range 2-4, Damage 4, Deadliness 6, Razor-Edged."
        }
    }

    ^"Implement Form: Melee Weapon" DEF {
        APPLIES TO [#tac037e8b1df3edd35ce4b ^"Celestial Implement"]
        PROPERTIES {
            ^"Description" STRING "A melee weapon, with its standard profile, is granted the following benefits, though GMs may change the modifications based on the chosen weapon:"
            ^"Profile Modification" STRING "Damage +3, Deadliness +2, Razor-Edged or Wargear"
        }
    }

    ^"Implement Form: Armor" DEF {
        APPLIES TO [#tac037e8b1df3edd35ce4b ^"Celestial Implement"]
        PROPERTIES {
            ^"Description" STRING "A set of armor, with its standard profile, is granted the following benefits:"
            ^"Profile Modification" STRING "Physical resistance +2, supernatural resistance +2"
        }
    }

    ^"Implement Form: Utility Object" DEF {
        APPLIES TO [#tac037e8b1df3edd35ce4b ^"Celestial Implement"]
        PROPERTIES {
            ^"Description" STRING "The following boons maybe applied to non-weapon, non-armor items, such as incense holders, buckets, various kit components, and jewelry. The GM is the final arbiter of what constitutes a utility item."
            ^"Profile Modification" STRING "An item, with its standard effects and profile, maybe granted a wide range of benefits and such benefits are subject to GM approval."
        }
    }

    # --- IMPLEMENT BOONS ---

    ENTRIES {
        ^"General Boon: Aura of Power" STRING "When performing a Support action check using this implement, you may spend (op) to choose one additional target per (op) spent this way."
        ^"General Boon: Beguile the Senses" STRING "When you make an Attack or Scheme action check using this implement, you may spend (op)+ to cause each target with vigilance lower than or equal to (op) spent this way to suffer one of the following conditions, based on the implement's element: Fire (Dazed), Air (Disoriented), Earth (Immobilized), Water (Exhausted), Void (Unconscious). After the check is resolved, the implement is dispelled."
        ^"General Boon: Blessed Revitalization" STRING "When you make a Support action check using this implement, you may spend (op)(op) to have each target remove one of the following conditions, based the implement's element: Fire (Silenced), Air (Dying), Earth (Exhausted), Water (Enraged or Burning), Void (Afflicted or Dying). After the check is resolved, the implement is dispelled."
        ^"General Boon: Celestial Step" STRING "When you make a Movement action check using this item, you may spend (op)(op) to teleport the distance you would move as part of the action instead of moving conventionally. You ignore the effects of terrain and obstruction while teleporting, and you can reach locations you otherwise could not this way, but you still must be able to perceive your destination."
        ^"General Boon: Cosmic Devastation" STRING "When you make an Attack action check using this implement, you may spend (op)+ to cause each target with vigilance lower than or equal to (op) spent this way to suffer one of the following conditions, based on the implement's element: Fire (Burning), Air (Silenced), Earth (Lightly Wounded [One Ring of Target's Choice]), Water (Bleeding), Void (Dying [5 rounds]). After the check is resolved, the implement is dispelled."
        ^"General Boon: Defensive" STRING "When you make a check to resist an effect or to use the Countering Mantra technique, if this implement is readied, reduce the TN by 2."
        ^"General Boon: Earthshaker" STRING "When you make an Attack or Scheme action check using this implement, you may spend (op)(op) to add one terrain quality, remove one terrain quality, or both from the surrounding area, based on the implement's element: Fire (add Dangerous, remove Obscuring), Air (add Obscuring, remove Entangling), Earth (add Entangling, remove Imbalanced [One Element, chosen by you]), Water (add Imbalanced [One Element, chosen by you], remove Dangerous), Void (add or remove Hallowed [One Element, chosen by you]). After the check is resolved, the implement is dispelled."
        ^"General Boon: Flurry" STRING "When performing an Attack or Scheme action check with this implement, you may spend (op)+ to choose one additional target per (op) spent this way. This target's vigilance cannot be higher than the highest among the original targets."
        ^"General Boon: Overwhelming Force" STRING "When performing an Attack action check using this implement, you may spend (op)+. If you do, the next time your target would make a check to resist an effect, they automatically count as failing with a shortfall equal to (op) spent this way."
        ^"General Boon: Shifting Shape" STRING "When you summon this implement or make a check using it, you may spend (op) to change it to a different object of the same form (see Form, on page 101)."
        ^"General Boon: Transfiguration" STRING "When you summon this implement or make a check using it, you may spend (op)(op) to change it to a different object of a different form (see Form, on page 101)."
        ^"General Boon: Unassuming" STRING "When you summon this implement or make a check using it, you may spend (op) to cause it to lose the Resplendent quality and gain the Subtle quality."
        ^"Projectile Boon: Animal Transformation" STRING "Choose an animal profile (such as Elegant Pit Viper, on page 236). When you make a Martial Arts [Ranged] check using this implement, you may spend (op)+. After resolving success or failure, the implement is dispelled as it transforms into a number of the chosen animals with total less than or equal to (op) spent this way times two. These animals are hostile to any targets of the check, and they persist until the end of the scene, or until they are slain."
        ^"Projectile Boon: Binding" STRING "When you perform an Attack action check using this implement, you may spend (op)(op) to cause the target to suffer the Immobilized condition. Each time the target would remove this condition, they must make a TN 5 Theology check; if they fail, they do not remove the condition, instead."
        ^"Projectile Boon: Deadly Venom" STRING "When you make an Attack action check using this implement, you may spend (op)(op); if you do and you succeed at the check, you cause the target to suffer the Dying (3 rounds) condition. Then, this implement is dispelled."
        ^"Projectile Boon: Detonation" STRING "When you make a Martial Arts [Ranged] check using this implement, you may spend (op)+. In a skirmish, each character within a number of range bands equal to (op) spent this way suffers supernatural damage equal to the weapon's base damage plus (op) spent this way and is hurled one range band away from the point of impact. In a mass battle, the target cohort leader suffers the damage, and the enemy army suffers attrition and panic equal to (op) spent this way. After the check is resolved, the implement is dispelled."
        ^"Projectile Boon: Duplication" STRING "When you make a check to summon this implement, you may spend (op)+ to summon that many additional copies of it. When you perform an Attack action check with this implement, you may spend (op) up to the number of copies at range 0–1 of the target to increase any damage you inflict by 1 per (op) spent this way."
        ^"Projectile Boon: Fortress Breaker" STRING "When you perform an Attack action check using this implement, you may spend (op)(op). If you do during a skirmish, your target's armor receives the Destroyed condition. If you do during a mass battle, each fortification occupied by a target is annihilated and no longer provides any benefit. The enemy army suffers attrition equal to your bonus successes, and each leader in the fortification suffers a critical strike with severity equal to your bonus successes. After the check is resolved, the implement is dispelled, and you suffer the Exhausted condition."
        ^"Projectile Boon: Obliteration" STRING "When you perform an Attack action check using this implement, you may spend (op)(op). If you do and the check inflicts a critical strike, if the target fails their check to resist the critical strike, they are slain outright unless they spend 1 Void point. After the check is resolved, the implement is dispelled, and you suffer the Exhausted condition."
        ^"Projectile Boon: Returning" STRING "When you perform a Martial Arts [Ranged] check using this implement, you may spend (op)+; if you spend (op) equal to the number of range bands between you and your target, the projectile returns to your hand unless it was dispelled."
        ^"Projectile Boon: Unerring" STRING "When performing an Attack action check using this implement, you may spend (op). If you do, the target cannot defend against damage caused by the action unless they spend 1 Void point."
        ^"Melee Boon: Independence" STRING "This implement moves and fights even when you are not holding it in your hand. As long as this implement is at range 0–4 of you, you may treat it as readied and wield it. As a Support action, you may make it move a number of range bands equal to your ranks in Meditation. Once per round when you perform an Attack action check using a different weapon, you may spend (op)+. Choose a character in range of this celestial implement with vigilance lower than (op) spent this way; that character suffers physical damage equal to the celestial implement's base damage."
        ^"Melee Boon: Inexorable" STRING "When you perform an Attack action check using this implement, you may spend (op)(op) to ignore your target's resistances."
        ^"Melee Boon: Resounding Arrival" STRING "When you make a check to summon this implement, you may spend (op)+. If you do so during a skirmish, each character at range 1–3 of you suffers supernatural damage equal to (op) spent this way and receives that much strife. If you do so in a mass battle, the enemy army suffers that much attrition and panic."
        ^"Melee Boon: Rising Power" STRING "When you make an Attack action check using this implement, you may spend (op)+. If you fail the check, you may reserve a number of dropped dice equal to (op) spent this way. On your next Martial Arts [Melee] check using the implement, add those dice as kept dice. This effect persists until the reserved dice are used or until the end of the scene."
        ^"Melee Boon: Unleashed Fury" STRING "When you make an Attack action check using this implement, you may spend (op)+ to choose one additional target per (op) spent this way at range 0–2 of another target (even if they are not within the weapon's range). This target's vigilance cannot be higher than the highest among the original targets."
        ^"Armor Boon: Agility of Legend" STRING "When you make a check to resist a critical strike while wearing this armor, you may spend (op)+. If you do, a number of characters up to (op) spent this way, of your choice, may immediately move up to 2 range bands."
        ^"Armor Boon: Burst of Force" STRING "When you make a check to resist a critical strike while wearing this armor, you may spend (op)(op). If you do so during a skirmish, each character at range 1–3 of you suffers supernatural damage equal to your bonus successes on the check and is pushed one range band away from you. If you do so during a mass battle, the enemy army suffers attrition and panic equal to your bonus successes. After the check is resolved, the implement is dispelled."
        ^"Armor Boon: Harm Returned" STRING "When you make a check to resist an effect or critical strike while wearing this armor, you may spend (op)(op)(op). If you do, the attacker suffers a critical strike with the same severity as the one you suffered (before reductions) or the same effect."
        ^"Armor Boon: Inviolable" STRING "When you make a check to resist a critical strike while wearing this armor, you may spend (op)+. If you succeed at the check to resist, and the critical strike would otherwise be reduced to a severity of (op) spent or lower, you do not suffer it instead."
        ^"Armor Boon: Overwhelming Radiance" STRING "When you make a check to resist an effect while wearing this armor, you may spend (op)+. If you do, each character at range 0–3 of you receives 1 strife, plus 1 strife for each (op) spent in excess of their vigilance."
        ^"Utility Boon: Grand Inspiration" STRING "When you make a Support action check using this implement, you may spend (op)+. If you do so in a skirmish, increase each target's composure by 1 per (op) spent this way until the end of the scene. If you do so in a mass battle, increase your army's discipline by 1 per (op) spent this way."
        ^"Utility Boon: Illusions Shattered" STRING "When you make a Support action check using this implement, you may spend (op)+ to remove up to one ongoing supernatural effect (such as a persistent effect of a kihō, mahō, invocation, mantra, or celestial implement) from a target of your check per (op) spent this way."
        ^"Utility Boon: Mark of Doom" STRING "When you make a Scheme action check using this implement, you may spend (op)+ to reduce the TN of the next Attack action check targeting one of your targets by 1 per (op) spent this way."
        ^"Utility Boon: Resounding Rhetoric" STRING "When you make a Support action check using this implement, you may spend (op)+. If you do so in a skirmish, you may choose any number of other characters at range 0–1 to remove fatigue and strife equal to (op) spent this way. If you do so in a mass battle, you may remove attrition and panic from your army equal to (op) spent this way. After the check is resolved, the implement is dispelled and you suffer the Exhausted condition."
        ^"Utility Boon: Root of Language" STRING "If you have this implement readied and are using or holding it, then when you make a check to read, understand, or interact with a piece of text or spoken language, you may spend (op) to gain an understanding of that language until your implement is dispelled."
        ^"Utility Boon: Subterranean Secrets" STRING "When you make a Movement action check using this implement, you may spend (op)+ to create a tunnel through the ground to a location within a number of range bands equal to (op) spent this way. If you use this during a mass battle, you may create a fortification (see page 276 of the core rulebook) that reduces attrition by your ranks in Theology and has a difficulty value equal to (op) spent this way."
        ^"Utility Boon: Soothing Words" STRING "When you make a Scheme or Support action check using this item, you may spend (op)+ to remove 1 strife from your target per (op) spent this way. Reduce the TN of your next Scheme or Support action check targeting them by 1 per strife removed this way. After the check is resolved, the implement is dispelled."
        ^"Utility Boon: Unlimited Negation" STRING "When you make a check to use the Countering Mantra technique, you may spend (op) to use it to counter any supernatural effect (such as an effect of a kihō, mahō, or invocation) instead of only the effect of a celestial implement."
        ^"Utility Boon: Vitality" STRING "When you make a Support action check targeting another character, you may spend (op)+ to reduce the TN of their checks to resist effects by 1 per (op) spent this way. This effect persists until the end of that character's next turn."
    }

    # --- SAMPLE CELESTIAL IMPLEMENTS ---

    # source stat block (page 106)
    ^"Banhi's Thunderous Astra" DEF {
        APPLIES TO [#tac037e8b1df3edd35ce4b ^"Celestial Implement"]
        PROPERTIES {
            ^"Blessing Source" STRING "Banhi, Purifier of the Soil"
            ^"Element" STRING "Fire and Air"
            ^"Counter Element" STRING "Water"
            ^"Restriction" STRING "Do not let any Tainted foe escape destruction at your hands."
            ^"Form" STRING "Javelin (Range 2-4, Damage 4, Deadliness 6, Razor-Edged)"
            ^"Boons" LIST OF STRING ["Detonation", "Obliteration", "Unerring"]
        }
    }

    # source stat block (page 106)
    ^"Kajri's Mantle of Wind" DEF {
        APPLIES TO [#tac037e8b1df3edd35ce4b ^"Celestial Implement"]
        PROPERTIES {
            ^"Blessing Source" STRING "Kajri, Builder of Heaven's Clouds"
            ^"Element" STRING "Air"
            ^"Counter Element" STRING "Fire"
            ^"Restriction" STRING "You must always hear out those who are in need, and you must always be willing to put your hands to work for the good of the innocent."
            ^"Form" STRING "Modified traveling clothes (Physical 2, Supernatural 2, Resplendent, Sacred)"
            ^"Boons" LIST OF STRING ["Celestial Step", "Inviolable", "Unassuming"]
        }
    }

    # source stat block (page 107)
    ^"River Stone of Flowing Water" DEF {
        APPLIES TO [#tac037e8b1df3edd35ce4b ^"Celestial Implement"]
        PROPERTIES {
            ^"Blessing Source" STRING "Neha, The Grieving Deity"
            ^"Element" STRING "Water"
            ^"Counter Element" STRING "Fire"
            ^"Restriction" STRING "Treat all those who walk beside you as comrades as your siblings, and cherish your time with them."
            ^"Form" STRING "Flat smooth stone (Resplendent, Sacred)"
            ^"Boons" LIST OF STRING ["Aura of Power", "Illusions Shattered", "Subterranean Secrets"]
        }
    }

    # School Building System rules are in l5r5e-0.5-path-of-waves-systems.ttrpg
}
