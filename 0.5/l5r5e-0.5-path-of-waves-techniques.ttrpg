EXTENSION "L5R5e_Path_of_Waves_Techniques" EXTENDS "L5R5e_Core_Techniques" {
    NAME "Legend of the Five Rings 5th Edition - Path of Waves: New Techniques"
    VERSION "0.5.2"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-03-01"

    # Path of Waves (Chapter 3): New techniques for ronin, peasants,
    # and gaijin characters. Includes kata (general, close combat, ranged),
    # shūji (earth, air, water, fire, void), rituals (Qamarist, Ivory Kingdoms,
    # ronin), and the celestial implements (astras/mantras) system.

    # ===========================
    # NEW KATA
    # ===========================

    # --- GENERAL KATA ---

    # source stat block (page 86)
    ^"Chaotic Scattering" DEF {
        APPLIES TO [#L5R350fG9hI1jK3lM5nO7p ^"Technique"]
        PROPERTIES {
            ^"Type" STRING "Kata"
            ^"Subtype" STRING "General"
            ^"Rank" INTEGER 2
            ^"Activation" STRING "As a Movement and Scheme action using a readied improvised weapon, you may make a TN 2 Survival (Air) check targeting one position at range 1–2."
            ^"Effect" STRING "You throw the improvised weapon to the chosen position.\n\nIf you succeed, choose one of the following terrain qualities: Dangerous, Entangling, or Obscuring. The weapon lands at the target position. All terrain within 1 range band of the targeted position gains that terrain quality. This effect persists for one round, plus one additional round for every two bonus successes.\n\nIf you fail, the weapon lands at the target position."
        }
        RULES {
            #L5RPW01qZ7xW5gJ2kY8dH7pP3tT: chaotic_scattering_opportunity "(op)(op): Choose one additional terrain quality (Dangerous, Entangling, or Obscuring) to apply to the terrain."
        }
    }

    # source stat block (page 86)
    ^"Iron Shell Style" DEF {
        APPLIES TO [#L5R350fG9hI1jK3lM5nO7p ^"Technique"]
        PROPERTIES {
            ^"Type" STRING "Kata"
            ^"Subtype" STRING "General"
            ^"Rank" INTEGER 3
            ^"Activation" STRING "When you perform a Guard action, if you have not moved any range bands this turn, you may spend (op) in the following way:"
            ^"Effect" STRING "Earth or Void (op)(op)+: Choose one character you can perceive per (op)(op) spent this way. The next time you defend against physical damage from that character, your fatigue cannot be increased to a value greater than your endurance. This effect persists until the end of your next turn."
        }
    }

    # source stat block (page 86)
    ^"Mind's Edge" DEF {
        APPLIES TO [#L5R350fG9hI1jK3lM5nO7p ^"Technique"]
        PROPERTIES {
            ^"Type" STRING "Kata"
            ^"Subtype" STRING "General"
            ^"Rank" INTEGER 1
            ^"Activation" STRING "Once per scene, after you perform an action that does not require a check while in a Void stance, you may make a TN 1 Meditation (Void) check."
            ^"Effect" STRING "If you succeed, the next time you would receive strife, reduce the amount you receive by 3, plus 1 per two bonus successes. This effect persists until the start of your next turn."
        }
        RULES {
            #L5RPW01mE4zI6pV4dT5aN8sE1fZ: minds_edge_void_op "Void (op): This effect applies each time you would receive strife before the start of your next turn instead."
            #L5RPW01hM0eL6gF9gK5vO2qB1bX: minds_edge_void_op2 "Void (op)(op): You may use this technique one additional time this scene."
        }
    }

    # source stat block (page 87)
    ^"Rider's Haste" DEF {
        APPLIES TO [#L5R350fG9hI1jK3lM5nO7p ^"Technique"]
        PROPERTIES {
            ^"Type" STRING "Kata"
            ^"Subtype" STRING "General"
            ^"Rank" INTEGER 2
            ^"Activation" STRING "As a Movement and Support action, if you are riding a mount, you may spur it to move more quickly."
            ^"Effect" STRING "Your mount receives an amount of fatigue up to your ranks in Survival, then carries you that many range bands plus one, to a maximum of 6."
        }
    }

    # source stat block (page 87)
    ^"Thunderous Hooves Style" DEF {
        APPLIES TO [#L5R350fG9hI1jK3lM5nO7p ^"Technique"]
        PROPERTIES {
            ^"Type" STRING "Kata"
            ^"Subtype" STRING "General"
            ^"Rank" INTEGER 4
            ^"Activation" STRING "When you make a Fitness check as part of a Movement action while mounted, you may spend (op) in the following way:"
            ^"Effect" STRING "(op)+: One character at range 0 of your ending position per (op) spent this way suffers fatigue and strife equal to your mount's silhouette unless they choose to immediately move 1 range band away from you.\n\n(op)(op)(op): Your mount may perform a Strike action with your assistance, targeting one character at range 0 (see Assistance, on page 26 of the core rulebook)."
        }
    }

    # source stat block (page 87)
    ^"Void Embrace Style" DEF {
        APPLIES TO [#L5R350fG9hI1jK3lM5nO7p ^"Technique"]
        PROPERTIES {
            ^"Type" STRING "Kata"
            ^"Subtype" STRING "General"
            ^"Rank" INTEGER 5
            ^"Activation" STRING "When you make a Meditation (Void) check during a duel or skirmish, you may spend (op) in the following way:"
            ^"Effect" STRING "(op)(op): Choose one character you can perceive, then secretly select a number. The next time you are dealt damage by that character or suffer a critical strike inflicted by that character, reveal the number you chose. If the number is higher than the damage or the severity of the critical strike (before any reductions), you suffer it as normal and this effect ends. If the number is lower than or equal to the damage or the severity of the critical strike, reduce it by that amount, to a minimum of 0. If you reduce it to 0, the character you chose suffers 5 strife. If you reduce the severity of a critical strike to 0 this way, you do not suffer it. This effect persists until the end of your next turn."
        }
    }

    # --- CLOSE COMBAT KATA ---

    # source stat block (page 87)
    ^"Improvised Assault" DEF {
        APPLIES TO [#L5R350fG9hI1jK3lM5nO7p ^"Technique"]
        PROPERTIES {
            ^"Type" STRING "Kata"
            ^"Subtype" STRING "Close Combat"
            ^"Rank" INTEGER 3
            ^"Activation" STRING "As a Movement and Support action, you may make a TN 2 Tactics (Water) or Smithing (Water) check using a readied improvised weapon."
            ^"Effect" STRING "If you succeed, you may choose a Martial Arts [Melee] weapon profile for a weapon similar in shape to the improvised weapon (the GM has discretion over whether the substitution is appropriate). Treat the improvised weapon as having that profile, with its damage and deadliness reduced by 1. This effect persists until the end of the scene, at which point the improvised weapon gains the Destroyed quality."
        }
        RULES {
            #L5RPW02eL9iO0bV4pQ1fA1uC7hF: improvised_assault_water_op "Water (op)(op): You may immediately perform a Strike action using the readied weapon."
            #L5RPW02oG0xT6pE7eK6cF2jF7lL: improvised_assault_water_op2 "Water (op)(op)(op): If you succeed, choose one of the following item qualities: Cumbersome, Razor-Edged, or Snaring. The weapon is treated as having that quality."
        }
    }

    # source stat block (page 87)
    ^"Boar's Wrath Style" DEF {
        APPLIES TO [#L5R350fG9hI1jK3lM5nO7p ^"Technique"]
        PROPERTIES {
            ^"Type" STRING "Kata"
            ^"Subtype" STRING "Close Combat"
            ^"Rank" INTEGER 3
            ^"Activation" STRING "When you make a check to resist a critical strike during a skirmish, if you are Enraged and not Incapacitated, you may spend (op) in the following way:"
            ^"Effect" STRING "Fire or Void (op)+: Choose one of your unarmed profiles or a readied improvised weapon. Each other character at range 0–1 with vigilance lower than or equal to (op) spent this way suffers physical damage equal to the base damage of your unarmed profile plus 1 for each (op) spent in excess of their vigilance."
        }
    }

    # source stat block (page 88)
    ^"Bonebreaker Style" DEF {
        APPLIES TO [#L5R350fG9hI1jK3lM5nO7p ^"Technique"]
        PROPERTIES {
            ^"Type" STRING "Kata"
            ^"Subtype" STRING "Close Combat"
            ^"Rank" INTEGER 5
            ^"Activation" STRING "When you make an Attack action check with a Cumbersome weapon, you may spend (op) in the following way:"
            ^"Effect" STRING "(op)(op): If your target would suffer a critical strike as a result of this check, instead of making a check to resist, they suffer the severity 5–6: Debilitating Gash result (see Table 6–6: Results of Critical Strikes by Severity, on page 270 of the core rulebook)."
        }
    }

    # source stat block (page 88)
    ^"Daring Swing" DEF {
        APPLIES TO [#L5R350fG9hI1jK3lM5nO7p ^"Technique"]
        PROPERTIES {
            ^"Type" STRING "Kata"
            ^"Subtype" STRING "Close Combat"
            ^"Rank" INTEGER 3
            ^"Activation" STRING "As an Attack and Movement action using a readied Snaring weapon, you may make a TN 3 Martial Arts [Melee] (Water) check targeting one position within range of your weapon that you could not normally reach. The GM is the final arbiter of whether it is reasonable that you could swing to this position."
            ^"Effect" STRING "If you succeed, you snag your weapon on that position (or another nearby feature of the terrain, such as a beam or tree branch) and then swing to the position."
        }
        RULES {
            #L5RPW02kZ7mZ2rJ2rG2fF1mZ3vF: daring_swing_water_op "Water (op)+: Choose a character at range 0 of your final position with vigilance lower than or equal to the (op) you spent this way. That character suffers physical damage equal to the number of range bands you traveled this round plus your bonus successes."
        }
    }

    # source stat block (page 88)
    ^"Deflective Defense" DEF {
        APPLIES TO [#L5R350fG9hI1jK3lM5nO7p ^"Technique"]
        PROPERTIES {
            ^"Type" STRING "Kata"
            ^"Subtype" STRING "Close Combat"
            ^"Rank" INTEGER 3
            ^"Activation" STRING "As a Movement and Support action using a readied Cumbersome weapon, you may make a TN 2 Martial Arts [Melee] (Earth) check."
            ^"Effect" STRING "If you succeed, treat your physical resistance against attacks made by characters at range 2–6 as increased by your ranks in Fitness."
        }
        RULES {
            #L5RPW02jI5dA5oD2sG8sT7eR3yP: deflective_defense_earth_op "Earth (op)(op): After you defend against physical damage from an attack made by a character at range 2–6, that character suffers 2 strife."
        }
    }

    # source stat block (page 88)
    ^"Flashing Steel Strike" DEF {
        APPLIES TO [#L5R350fG9hI1jK3lM5nO7p ^"Technique"]
        PROPERTIES {
            ^"Type" STRING "Kata"
            ^"Subtype" STRING "Close Combat"
            ^"Rank" INTEGER 2
            ^"Activation" STRING "As an Attack and Scheme action using a readied weapon, you may make a Martial Arts [Melee] (Air or Fire) check targeting one character in your weapon's range. The TN of this check is equal to your target's vigilance."
            ^"Effect" STRING "If you succeed, your target must choose one of the following:\n\nReceive strife equal to your ranks in Performance and the Dazed condition.\n\nSuffer a critical strike with severity equal to your weapon's deadliness."
        }
        RULES {
            #L5RPW02xH4iD5oD1sQ2pJ0fA5dK: flashing_steel_cumbersome "(op)(op)+: If your weapon is Cumbersome, choose one additional target with vigilance lower than or equal to your original target's vigilance per (op)(op) spent this way."
        }
    }

    # source stat block (page 89)
    ^"Iaijutsu Cut: Reverse Draw" DEF {
        APPLIES TO [#L5R350fG9hI1jK3lM5nO7p ^"Technique"]
        PROPERTIES {
            ^"Type" STRING "Kata"
            ^"Subtype" STRING "Close Combat"
            ^"Rank" INTEGER 4
            ^"Activation" STRING "As an Attack, Movement, and Scheme action using a sheathed Razor-Edged weapon, you may make a Martial Arts [Melee] check targeting one character at range 1. The TN of this check is equal to your target's vigilance."
            ^"Effect" STRING "You draw and ready the sheathed weapon in a one-handed grip. You suffer the Disoriented condition. If you succeed, your target suffers physical damage equal to your weapon's deadliness plus 1 for every two bonus successes."
        }
        RULES {
            #L5RPW02dA2rD9nT6pA1iC5aK0oM: reverse_draw_crit "(op)(op): If this damage causes your target to become Incapacitated, they suffer a critical strike with severity equal to the weapon's deadliness plus your bonus successes."
        }
    }

    # source stat block (page 89)
    ^"Iaijutsu Cut: Sword and Sheath" DEF {
        APPLIES TO [#L5R350fG9hI1jK3lM5nO7p ^"Technique"]
        PROPERTIES {
            ^"Type" STRING "Kata"
            ^"Subtype" STRING "Close Combat"
            ^"Rank" INTEGER 2
            ^"Activation" STRING "As an Attack and Movement action using a sheathed Razor-Edged weapon, you may make a TN 2 Martial Arts [Melee] check targeting one character at range 0–1."
            ^"Effect" STRING "If you succeed, your target suffers 5 physical damage with deadliness 2, plus additional damage equal to your bonus successes.\n\nYou draw and ready the sheathed weapon in a one-handed grip in one hand and its sheath (see page 112) in a one-handed grip in the other hand."
        }
        RULES {
            #L5RPW02kZ3rB5iD5cN6qO2rZ4lW: sword_and_sheath_dazed "(op)(op): If you succeed, your target suffers the Dazed condition."
        }
    }

    # source stat block (page 89)
    ^"Landslide Strike" DEF {
        APPLIES TO [#L5R350fG9hI1jK3lM5nO7p ^"Technique"]
        PROPERTIES {
            ^"Type" STRING "Kata"
            ^"Subtype" STRING "Close Combat"
            ^"Rank" INTEGER 2
            ^"Activation" STRING "As an Attack and Scheme action, you may make a Martial Arts [Melee] (Earth or Water) check targeting one character in your weapon's range. The TN is equal to the target's vigilance. If your target is in Dangerous, Entangling, or Obscuring terrain, the TN is 1 instead."
            ^"Effect" STRING "If you succeed, your target must choose one of the following:\n\nReceive fatigue equal to your ranks in Fitness and the Prone condition.\n\nSwitch to a different stance of their choice and suffer the Immobilized condition."
        }
        RULES {
            #L5RPW02aO7yZ1jF4fX5dY1vV7uF: landslide_cumbersome "(op)(op)+: If your weapon has the Cumbersome quality, choose one additional target with vigilance lower than or equal to your original target's vigilance per (op)(op) spent this way."
        }
    }

    # source stat block (page 89)
    ^"Laughing Fox Style" DEF {
        APPLIES TO [#L5R350fG9hI1jK3lM5nO7p ^"Technique"]
        PROPERTIES {
            ^"Type" STRING "Kata"
            ^"Subtype" STRING "Close Combat"
            ^"Rank" INTEGER 4
            ^"Activation" STRING "When you are targeted by an Attack action, if you have an empty hand, you may spend 1 Void point to immediately make a Martial Arts [Unarmed] (Air) check targeting another character at range 0–1 other than the attacker. The TN is equal to the new target's vigilance."
            ^"Effect" STRING "If you succeed, you cease being the target of the Attack action, and your target becomes the target of that action instead."
        }
        RULES {
            #L5RPW02oK2mB2kI9fG8zW9uM6rR: laughing_fox_move "(op): If you succeed, move 1 range band away from the attacker."
            #L5RPW02hM5sU9oC9pL7dA1aB5lI: laughing_fox_damage "(op)(op): If you succeed, the new target also suffers physical damage equal to your ranks in Skulduggery."
            #L5RPW02wV0lN0dQ5aR0gN1oB1zW: laughing_fox_prone "(op)(op): If you succeed, both the attacker and the new target suffer the Prone condition."
        }
    }

    # source stat block (page 90)
    ^"Piercing Bolt Style" DEF {
        APPLIES TO [#L5R350fG9hI1jK3lM5nO7p ^"Technique"]
        PROPERTIES {
            ^"Type" STRING "Kata"
            ^"Subtype" STRING "Close Combat"
            ^"Rank" INTEGER 3
            ^"Activation" STRING "When you make an Attack action check using an ax or polearm, you may spend (op) in the following way:"
            ^"Effect" STRING "(op): Treat the deadliness of your weapon as increased by the number of range bands you have traveled this round, and if you threw it, add the number of range bands it has traveled this round."
        }
    }

    # source stat block (page 90)
    ^"Reckless Lunge" DEF {
        APPLIES TO [#L5R350fG9hI1jK3lM5nO7p ^"Technique"]
        PROPERTIES {
            ^"Type" STRING "Kata"
            ^"Subtype" STRING "Close Combat"
            ^"Rank" INTEGER 2
            ^"Activation" STRING "As an Attack and Movement action using your unarmed punch or kick profile, you may make a TN 3 Martial Arts [Unarmed] (Fire) check to launch yourself at a target at range 2–3."
            ^"Effect" STRING "You move to range 0 of your target and suffer the Prone condition. Reduce the TN of your target's next Attack action check targeting you by 1. If you succeed, your target suffers damage equal to the base damage of your unarmed punch or kick profile plus your ranks in Fitness and must make a TN 3 Fitness check (Water 2, Air 5) or suffer the Prone condition."
        }
        RULES {
            #L5RPW02uV4kG0mU5jP0fP1hC3kW: reckless_lunge_strife "(op): If you succeed, your target receives strife equal to your bonus successes."
            #L5RPW02iJ8gU0dK5cN6tT2aZ2qX: reckless_lunge_no_prone "(op)(op): You do not suffer the Prone condition."
        }
    }

    # source stat block (page 90)
    ^"Rushing Ox Style" DEF {
        APPLIES TO [#L5R350fG9hI1jK3lM5nO7p ^"Technique"]
        PROPERTIES {
            ^"Type" STRING "Kata"
            ^"Subtype" STRING "Close Combat"
            ^"Rank" INTEGER 3
            ^"Activation" STRING "When you perform a Maneuver action during your turn, you may spend (op) in the following way:"
            ^"Effect" STRING "Fire or Water (op)(op): After you move, you may perform a Strike action using a readied Martial Arts [Melee] weapon or Martial Arts [Unarmed] profile targeting one character. The target must be in range of the readied weapon or unarmed profile, and the TN for the Strike action is equal to your target's vigilance. You can only target a character you moved toward this way."
        }
    }

    # source stat block (page 90)
    ^"Snapping Branch Strike" DEF {
        APPLIES TO [#L5R350fG9hI1jK3lM5nO7p ^"Technique"]
        PROPERTIES {
            ^"Type" STRING "Kata"
            ^"Subtype" STRING "Close Combat"
            ^"Rank" INTEGER 1
            ^"Activation" STRING "As an Attack and Support action using a readied blunt weapon or polearm, you may make a TN 3 Fitness (Earth) check targeting one character at range 0–1."
            ^"Effect" STRING "If you succeed, your target suffers physical damage equal to 5 plus your bonus successes with deadliness 2."
        }
        RULES {
            #L5RPW02hM4oJ1wA4qX9pL7iT0wH: snapping_branch_push "(op)(op)+: Your target must resist with a TN 4 Fitness check (Air 2, Water 5) or be pushed 1 range band away from you per (op)(op) spent this way."
        }
    }

    # source stat block (page 90)
    ^"Swirling Tempest Style" DEF {
        APPLIES TO [#L5R350fG9hI1jK3lM5nO7p ^"Technique"]
        PROPERTIES {
            ^"Type" STRING "Kata"
            ^"Subtype" STRING "Close Combat"
            ^"Rank" INTEGER 5
            ^"Activation" STRING "When you make a Martial Arts [Melee] check with a blunt weapon or polearm, you may spend (op) in the following way:"
            ^"Effect" STRING "(op)+: Choose one character in range of your weapon other than your target with vigilance lower than or equal to (op) spent this way. That character suffers physical damage equal to your weapon's base damage. You may activate this (op) multiple times, choosing a different character each time."
        }
    }

    # source stat block (page 90)
    ^"Thunderous Blows Style" DEF {
        APPLIES TO [#L5R350fG9hI1jK3lM5nO7p ^"Technique"]
        PROPERTIES {
            ^"Type" STRING "Kata"
            ^"Subtype" STRING "Close Combat"
            ^"Rank" INTEGER 2
            ^"Activation" STRING "When you make an Attack action check with a blunt weapon, you may spend (op) in the following way:"
            ^"Effect" STRING "Fire (op)(op)+: One character at range 0–1 of your target per (op)(op) spent this way receives 1 fatigue, or 3 fatigue if they are suffering the Dazed condition."
        }
    }

    # source stat block (page 91)
    ^"Twin Streams Style" DEF {
        APPLIES TO [#L5R350fG9hI1jK3lM5nO7p ^"Technique"]
        PROPERTIES {
            ^"Type" STRING "Kata"
            ^"Subtype" STRING "Close Combat"
            ^"Rank" INTEGER 3
            ^"Activation" STRING "When you perform an Attack action check using a sword or ax, if you have another readied weapon of the same category, you may spend (op) in the following way:"
            ^"Effect" STRING "(op)(op): If your target suffers a critical strike as a result of this check, increase its severity by the deadliness of your other readied weapon."
        }
    }

    # source stat block (page 91)
    ^"Wheeling Sweep" DEF {
        APPLIES TO [#L5R350fG9hI1jK3lM5nO7p ^"Technique"]
        PROPERTIES {
            ^"Type" STRING "Kata"
            ^"Subtype" STRING "Close Combat"
            ^"Rank" INTEGER 3
            ^"Activation" STRING "As an Attack and Movement action targeting a character with silhouette 2 or lower using your unarmed punch profile, you may make a Martial Arts [Unarmed] (Water) check targeting one character at range 0. The TN of this check is equal to your target's vigilance."
            ^"Effect" STRING "If you succeed, you hurl your target 1 range band in the direction of your choice, plus 1 range band for every two bonus successes. Your target suffers the effects of falling the distance they were moved (see page 269 of the core rulebook)."
        }
        RULES {
            #L5RPW02gC9gN1oE0hK7vV3iT0iL: wheeling_sweep_hurl "(op): Choose one character within a number of range bands equal to the distance you threw the target. Instead of hurling your original target into the ground, you hurl the target at that character, who must resist with a TN 4 Fitness check (Earth 3, Fire 6) or suffer the same amount of damage the original target suffers from falling and the Prone condition."
            #L5RPW02sG3kA8cK5bX1bF8kG5iR: wheeling_sweep_reduce "(op)+: Reduce the physical damage your target suffers from falling this way by 2 per (op) spent this way."
        }
    }

    # --- RANGED COMBAT KATA ---

    # source stat block (page 91)
    ^"Eyeless Sight Shot" DEF {
        APPLIES TO [#L5R350fG9hI1jK3lM5nO7p ^"Technique"]
        PROPERTIES {
            ^"Type" STRING "Kata"
            ^"Subtype" STRING "Ranged Combat"
            ^"Rank" INTEGER 4
            ^"Activation" STRING "As an Attack and Movement action using a readied ranged weapon, you may make a Martial Arts [Ranged] (Void) check targeting one character within your weapon's range to whom you do not have direct line of sight. The TN of the check is equal to the target's vigilance."
            ^"Effect" STRING "If you succeed, your target suffers physical damage equal to your weapon's base damage and receives strife equal to your bonus successes."
        }
    }

    # source stat block (page 91)
    ^"Falling Heavens Shot" DEF {
        APPLIES TO [#L5R350fG9hI1jK3lM5nO7p ^"Technique"]
        PROPERTIES {
            ^"Type" STRING "Kata"
            ^"Subtype" STRING "Ranged Combat"
            ^"Rank" INTEGER 5
            ^"Activation" STRING "Once per scene as an Attack and Movement action using a readied ranged weapon, you may make a Martial Arts [Ranged] (Void) check targeting one character within your weapon's range. The TN of this check is equal to your target's vigilance."
            ^"Effect" STRING "If you succeed, at the start of your target's next turn, they suffer a critical strike with severity equal to your weapon's deadliness."
        }
        RULES {
            #L5RPW03kF7oF7aT0uO6vD6wP8vM: falling_heavens_delay "(op)+: You may delay this effect for one additional round per (op) spent this way. For each round you delay this way, you increase the deadliness of the critical strike by 2."
        }
    }

    # source stat block (page 91)
    ^"Staggering Shot" DEF {
        APPLIES TO [#L5R350fG9hI1jK3lM5nO7p ^"Technique"]
        PROPERTIES {
            ^"Type" STRING "Kata"
            ^"Subtype" STRING "Ranged Combat"
            ^"Rank" INTEGER 2
            ^"Activation" STRING "When you perform a Martial Arts [Ranged] check, you may spend (op) in the following way:"
            ^"Effect" STRING "Earth or Fire (op)(op): Your target treats all terrain as having the Dangerous quality. This effect persists until the end of your next turn.\n\nAir or Water (op)(op): Your target treats all terrain as having the Entangling quality. This effect persists until the end of your next turn."
        }
    }

    # source stat block (page 92)
    ^"Swirling Viper Style" DEF {
        APPLIES TO [#L5R350fG9hI1jK3lM5nO7p ^"Technique"]
        PROPERTIES {
            ^"Type" STRING "Kata"
            ^"Subtype" STRING "Ranged Combat"
            ^"Rank" INTEGER 3
            ^"Activation" STRING "When you perform a Maneuver action during your turn, you may spend (op) in the following way:"
            ^"Effect" STRING "Air or Water (op)(op): After you move, you may perform a Strike action using a readied Martial Arts [Ranged] weapon targeting one character in range, treating the TN as equal to your target's vigilance. You can only target a character you moved away from this way."
        }
    }

    # source stat block (page 92)
    ^"Wasp's Spite Style" DEF {
        APPLIES TO [#L5R350fG9hI1jK3lM5nO7p ^"Technique"]
        PROPERTIES {
            ^"Type" STRING "Kata"
            ^"Subtype" STRING "Ranged Combat"
            ^"Rank" INTEGER 4
