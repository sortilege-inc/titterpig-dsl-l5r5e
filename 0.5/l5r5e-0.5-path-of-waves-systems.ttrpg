            ^"Vigilance" INTEGER 2
            ^"Silhouette" INTEGER 0
            ^"Demeanor" STRING "Detached"
            ^"Social Skill Check TN Modifiers" STRING "Earth +1, Fire +1, Void -2"
            ^"Skills" LIST OF STRING ["Artisan 0", "Martial 1", "Scholar 0", "Social 0", "Trade 0"]
            ^"Advantages" LIST OF STRING ["Incorporeal (Earth) [Martial; Physical, Spiritual]"]
            ^"Disadvantages" LIST OF STRING ["Sadness (Void) [Social; Mental]"]
            ^"Gear" LIST OF STRING ["Ghostly energy (Physical 10)"]
        }

        #VfYy96IBRO4gVkevaPj19Z ^"Ghostly Body" DEF {
            ^"Description" STRING "The furiribi is an Otherworldly creature of silhouette 0 that can pass through solid objects."
        }

        #Hyi6OHG55lWDIAPqmsfNuK ^"Burns the Soul" DEF {
            ^"Description" STRING "When a creature touches a furiribi they must make a TN 4 Fitness check (Earth 5, Fire 5, Void 2) to resist the furiribi's spiritual flame. If a creature fails, they take 5 Supernatural damage and become Exhausted. If the target is already Exhausted, they become Incapacitated."
        }

    }

