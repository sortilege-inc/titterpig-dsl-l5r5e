    # ===========================
    # NPC STAT BLOCKS - CITY AND VILLAGE DWELLERS
    # ===========================

    # source stat block (page 229)
    #mAUVxd6oy7X4EDSLXP8CEv ^"Annoyed Tax Collector" DEF {
        EXTENDS #t4540de6f35155c46f41f0 ^"NPC"
        PROPERTIES {
            ^"Type" STRING "Adversary" FIXED
            ^"Combat Conflict Rank" INTEGER 2
            ^"Intrigue Conflict Rank" INTEGER 3
            ^"Description" STRING "Imperial tax collectors are often drafted from yoriki and dōshin, but occasionally tax collection is delegated to an Emerald Magistrate as a veiled demotion. In practice, samurai tax collectors simply receive gathered taxes from the village elder and escort tax caravans to their destination, but occasionally they must deal with villages that are unwilling (or unable) to pay. Due to the tax collectors' general unpopularity, and also because they are frequent targets of desperate bandits, individuals of some martial prowess are preferred for the task, and rōnin are often hired as bodyguards."
            ^"Rings" DEF {
                ^"Air" INTEGER 2
                ^"Earth" INTEGER 2
                ^"Fire" INTEGER 3
                ^"Water" INTEGER 1
                ^"Void" INTEGER 1
            }
            ^"Honor" INTEGER 55
            ^"Glory" INTEGER 43
            ^"Status" INTEGER 39
            ^"Endurance" INTEGER 8
            ^"Composure" INTEGER 8
            ^"Focus" INTEGER 4
            ^"Vigilance" INTEGER 2
            ^"Demeanor" STRING "Assertive"
            ^"Skills" LIST OF STRING ["Artisan 0", "Martial 2", "Scholar 2", "Social 2", "Trade 1"]
            ^"Advantages" LIST OF STRING ["Vaguely Threatening: Martial; Interpersonal, Physical", "Imperial Authority: Social; Interpersonal"]
            ^"Disadvantages" LIST OF STRING ["Unpopular: Social; Interpersonal"]
            ^"Favored Weapons" LIST OF STRING ["Katana: Range 1, Damage 4, Deadliness 5/7, Ceremonial, Razor-Edged"]
            ^"Gear" LIST OF STRING ["Lacquered armor (Physical 4, Ceremonial, Cumbersome, Wargear)", "wakizashi", "jitte", "knife", "riding pony", "traveling outfit", "as many ronin minions as possible"]
        }
        RULES {
            #L5RPW70tH7rU5xH7eM0nU2eU7qI: tax_collector_aura_of_dread "Aura of Dread: At the start of a scene where an annoyed tax collector is present, or when an annoyed tax collector arrives in a scene for the first time, all other characters with a status of 65 or less recieves 3 strife."
        }
    }

    # source stat block (page 230)
    #qOPzdznoCyZ8UZ6gBIo4He ^"Bandit Lord" DEF {
        EXTENDS #t4540de6f35155c46f41f0 ^"NPC"
        PROPERTIES {
            ^"Type" STRING "Adversary" FIXED
            ^"Combat Conflict Rank" INTEGER 4
            ^"Intrigue Conflict Rank" INTEGER 3
            ^"Description" STRING "Few bandits live long enough to accumulate adequate numbers, wealth, and influence to rival those of local lords, but bandits who do are destabilizing powers in their region. These so-called \"bandit lords\" have enough local power to illegally claim their own \"domains,\" embarrassing the legitimate lords by rebuffing attempts to bring them to heel. Sometimes their names even spread to other lands. Occasionally, a bandit lord who has proven a better and more popular guardian than the local lord is granted that lord's lands and a family name, becoming legitimate by Imperial decree. For this reason, popular bandits are considered extremely threatening, and whenever they are caught, a public example is always made."
            ^"Rings" DEF {
                ^"Air" INTEGER 1
                ^"Earth" INTEGER 3
                ^"Fire" INTEGER 4
                ^"Water" INTEGER 2
                ^"Void" INTEGER 1
            }
            ^"Honor" INTEGER 10
            ^"Glory" INTEGER 19
            ^"Status" INTEGER 7
            ^"Endurance" INTEGER 13
            ^"Composure" INTEGER 8
            ^"Focus" INTEGER 5
            ^"Vigilance" INTEGER 4
            ^"Demeanor" STRING "Ambitious"
            ^"Skills" LIST OF STRING ["Artisan 0", "Martial 3", "Scholar 0", "Social 2", "Trade 1"]
            ^"Advantages" LIST OF STRING ["Age and Cunning: Martial, Social; Interpersonal, Physical", "Killer Instinct: Martial; Mental"]
            ^"Disadvantages" LIST OF STRING ["Fool's Avarice: Social; Mental", "Overconfident: Social; Mental"]
            ^"Favored Weapons" LIST OF STRING ["Katana: Range 1, Damage 4, Deadliness 5/7, Ceremonial, Razor-Edged", "Kusari-Gama: Range 0/2-3, Damage 3, Deadliness 3, Concealable, Snaring, Wargear"]
            ^"Gear" LIST OF STRING ["Lacquered armor (Physical 4, Ceremonial, Cumbersome, Wargear)", "simple clothes", "assortment of knives", "sake jug", "handful of koku"]
        }
        RULES {
            #L5RPW70tX9jO3kD9yP2fY5dC9sQ: bandit_lord_get_them "Get Them...: As an action, a bandit lord may have up to two bandits or experienced bandits immediately move 1 range band and perform a Strike action. They count as having skilled assistance (see page 26 of the core rulebook) on this check."
            #L5RPW70hT8nN7bM8rD4yA3qS2vK: bandit_lord_cunning_tactics "Cunning Tactics: When performing an Attack action check, a bandit lord may spend (op) in the following way:\n\n(op): One character at range 0–2 suffers the Disoriented or Dazed condition."
        }
    }

    # source stat block (page 230)
    #m7nRw1NtWSLkF9ctW0pwmF ^"Clever Innkeeper" DEF {
        EXTENDS #t4540de6f35155c46f41f0 ^"NPC"
        PROPERTIES {
            ^"Type" STRING "Minion" FIXED
            ^"Combat Conflict Rank" INTEGER 1
            ^"Intrigue Conflict Rank" INTEGER 2
            ^"Description" STRING "Any respectable town can boast at least one inn, which is run by the innkeeper. Samurai are simply given room and board (and anything else they request), and the bill is forwarded to their lord, so honorable retainers never need sully their speech by haggling or inquiring about cost. Clever innkeepers work this custom to their advantage, freely offering their best rooms and finest foods to unassuming samurai guests, knowing that it will be accepted as proper tribute––and paid for by wealthy lords."
            ^"Rings" DEF {
                ^"Air" INTEGER 2
                ^"Earth" INTEGER 2
                ^"Fire" INTEGER 1
                ^"Water" INTEGER 2
                ^"Void" INTEGER 1
            }
            ^"Honor" INTEGER 20
            ^"Glory" INTEGER 23
            ^"Status" INTEGER 9
            ^"Endurance" INTEGER 6
            ^"Composure" INTEGER 7
            ^"Focus" INTEGER 3
            ^"Vigilance" INTEGER 2
            ^"Demeanor" STRING "Shrewd"
            ^"Skills" LIST OF STRING ["Artisan 0", "Martial 0", "Scholar 1", "Social 2", "Trade 3"]
            ^"Advantages" LIST OF STRING ["Daikoku's Blessing: Trade; Interpersonal, Spiritual"]
            ^"Disadvantages" LIST OF STRING ["Fool's Avarice: Social; Mental"]
            ^"Gear" LIST OF STRING ["Passable clothes", "handful of bu"]
        }
        RULES {
            #L5RPW70tF1rT4dD4zJ8uO0uP9oA: innkeeper_overlooked "Overlooked: When the clever innkeeper makes a check targeting a character with a higher status rank, the innkeeper treats the target's vigilance as 1 lower."
        }
    }

    # source stat block (page 231)
    #nluUPUNZMv0rhGxskjq0yc ^"Discerning Merchant" DEF {
        EXTENDS #t4540de6f35155c46f41f0 ^"NPC"
        PROPERTIES {
            ^"Type" STRING "Minion" FIXED
            ^"Combat Conflict Rank" INTEGER 1
            ^"Intrigue Conflict Rank" INTEGER 2
            ^"Description" STRING "Although they are looked down upon by nobility and rank lower than farmers in the Celestial Order, merchants nonetheless wield considerable power and influence for one simple reason: they have the money to do so. Discerning merchants make a living by selling finer wares almost exclusively to samurai nobility. It is dishonorable to haggle or even ask for a price, and many samurai are not educated in commerce and remain ignorant of what things cost, so the discerning merchant stands to make a significant profit if they maintain a trustworthy reputation."
            ^"Rings" DEF {
                ^"Air" INTEGER 2
                ^"Earth" INTEGER 1
                ^"Fire" INTEGER 1
                ^"Water" INTEGER 2
                ^"Void" INTEGER 1
            }
            ^"Honor" INTEGER 25
            ^"Glory" INTEGER 29
            ^"Status" INTEGER 9
            ^"Endurance" INTEGER 6
            ^"Composure" INTEGER 6
            ^"Focus" INTEGER 3
            ^"Vigilance" INTEGER 2
            ^"Demeanor" STRING "Shrewd"
            ^"Skills" LIST OF STRING ["Artisan 0", "Martial 0", "Scholar 1", "Social 2", "Trade 2"]
            ^"Advantages" LIST OF STRING ["Daikoku's Blessing: Social; Interpersonal, Spiritual"]
            ^"Disadvantages" LIST OF STRING ["Deferential: Social; Interpersonal, Mental"]
            ^"Gear" LIST OF STRING ["Passable clothes", "abacus", "handful of bu"]
        }
        RULES {
            #L5RPW70eA3zX4gV8aR8lD1rV5kN: merchant_overlooked "Overlooked: When this merchant makes a check targeting a character with a higher status rank, the merchant treats the target's vigilance as 1 lower."
            #L5RPW70iK0lN8jN8eU1dY0zT7nU: merchant_equal_exchange "An Equal Exchange: Once per scene, as a Scheme action, a discerning merchant may offer one character a gift in exchange for a small favor. The target must make a TN 3 Courtesy (Air 5, Fire 1) check to resist. If the character fails, they receive 3 strife plus their shortfall."
        }
    }

    # source stat block (page 231)
    #U6U2bFCm7cOrZQ50xpzEqE ^"Hired Enforcer" DEF {
        EXTENDS #t4540de6f35155c46f41f0 ^"NPC"
        PROPERTIES {
            ^"Type" STRING "Minion" FIXED
            ^"Combat Conflict Rank" INTEGER 2
            ^"Intrigue Conflict Rank" INTEGER 1
            ^"Description" STRING "Little more than brutes and thumb breakers, enforcers are hired muscle employed to intimidate those who refuse to take their employer's threats seriously. Hired enforcers do not care who their employer is—a merchant who was shorted by someone who thought they were clever, a crime lord displeased with a law enforcement official, or simply someone who wishes to assert their authority—they just care that the coin is good."
            ^"Rings" DEF {
                ^"Air" INTEGER 2
                ^"Earth" INTEGER 2
                ^"Fire" INTEGER 2
                ^"Water" INTEGER 2
                ^"Void" INTEGER 1
            }
            ^"Honor" INTEGER 16
            ^"Glory" INTEGER 20
            ^"Status" INTEGER 9
            ^"Endurance" INTEGER 7
            ^"Composure" INTEGER 6
            ^"Focus" INTEGER 4
            ^"Vigilance" INTEGER 2
            ^"Demeanor" STRING "Shrewd"
            ^"Skills" LIST OF STRING ["Artisan 0", "Martial 1", "Scholar 0", "Social 0", "Trade 1"]
            ^"Advantages" LIST OF STRING ["Imposing: Martial, Social; Interpersonal, Physical"]
            ^"Disadvantages" LIST OF STRING ["Fool's Avarice: Social; Mental"]
            ^"Favored Weapons" LIST OF STRING ["Club: Range 0-1, Damage 5/6, Deadliness 2, Mundane"]
            ^"Gear" LIST OF STRING ["Passable clothes", "handful of bu"]
        }
        RULES {
            #L5RPW70iY5nA7zK6tT3oS9tQ4gU: enforcer_sucker_punch "Sucker Punch: When performing an Attack action check, this enforcer may spend (op) in the following way:\n\n(op): One target gains the Disoriented condition."
        }
    }

    # source stat block (page 232)
    #pJEEDatvdySJE5bFY8KFmf ^"Indiscriminate Cutpurse" DEF {
        EXTENDS #t4540de6f35155c46f41f0 ^"NPC"
        PROPERTIES {
            ^"Type" STRING "Minion" FIXED
            ^"Combat Conflict Rank" INTEGER 2
            ^"Intrigue Conflict Rank" INTEGER 2
            ^"Description" STRING "Although folktales venerate those who steal from the samurai class and live, the life of a cutpurse is anything but glamorous. Thieves live desperate, hand-to-mouth lives, always hoping that their next filched coin will finally pull them out of crushing poverty and into an honest living. Some have come to terms with their lot in life, either because they've grown accustomed to it, have come to enjoy the constant threat of discovery and brutal punishment, or have simply lost hope for anything better."
            ^"Rings" DEF {
                ^"Air" INTEGER 3
                ^"Earth" INTEGER 1
                ^"Fire" INTEGER 2
                ^"Water" INTEGER 3
                ^"Void" INTEGER 1
            }
            ^"Honor" INTEGER 5
            ^"Glory" INTEGER 20
            ^"Status" INTEGER 1
            ^"Endurance" INTEGER 6
            ^"Composure" INTEGER 8
            ^"Focus" INTEGER 5
            ^"Vigilance" INTEGER 3
            ^"Demeanor" STRING "Shrewd"
            ^"Skills" LIST OF STRING ["Artisan 0", "Martial 1", "Scholar 0", "Social 1", "Trade 3"]
            ^"Advantages" LIST OF STRING ["Nimble and Silent: Trade; Physical"]
            ^"Disadvantages" LIST OF STRING ["Wanted: Social; Interpersonal"]
            ^"Favored Weapons" LIST OF STRING ["Knife: Range 0, Damage 2, Deadliness 4/6, Concealable, Mundane, Razor-Edged"]
        }
        RULES {
            #L5RPW70cT2fM8nZ0iF0jQ1bZ1tT: cutpurse_quick_fingers "Quick Fingers: When this cutpurse makes a check targeting a Disoriented character, the cutpurse treats the target's vigilance as 2 lower, to a minimum of 1."
        }
    }

    # source stat block (page 233)
    #Uv2bXGuQjuTcmEeccGaxxQ ^"Traveling Tradesperson" DEF {
        EXTENDS #t4540de6f35155c46f41f0 ^"NPC"
        PROPERTIES {
            ^"Type" STRING "Minion" FIXED
            ^"Combat Conflict Rank" INTEGER 1
            ^"Intrigue Conflict Rank" INTEGER 3
            ^"Description" STRING "Few peasants ever travel farther than the nearest village, and some never even leave the place of their birth. In contrast, merchants travel throughout the Empire, and some are considered more worldly than samurai! When a traveling merchant enters a village, they are often bombarded with questions about the outside world. Sometimes they are even treated as honored guests, although never quite as well as a visiting samurai."
            ^"Rings" DEF {
                ^"Air" INTEGER 3
                ^"Earth" INTEGER 1
                ^"Fire" INTEGER 2
                ^"Water" INTEGER 2
                ^"Void" INTEGER 1
            }
            ^"Honor" INTEGER 25
            ^"Glory" INTEGER 25
            ^"Status" INTEGER 9
            ^"Endurance" INTEGER 6
            ^"Composure" INTEGER 8
            ^"Focus" INTEGER 4
            ^"Vigilance" INTEGER 3
            ^"Demeanor" STRING "Shrewd"
            ^"Skills" LIST OF STRING ["Artisan 0", "Martial 0", "Scholar 2", "Social 2", "Trade 3"]
            ^"Advantages" LIST OF STRING ["Daikoku's Blessing: Social; Interpersonal, Spiritual", "Worldly Wanderer: Scholar, Trade; Mental"]
            ^"Disadvantages" LIST OF STRING ["Deferential: Social; Interpersonal, Mental"]
            ^"Gear" LIST OF STRING ["Traveling clothes", "abacus", "handful of bu"]
        }
        RULES {
            #L5RPW70rJ7cH4mF0gL5aE3jW2aM: tradesperson_fix "I Can Fix That: A traveling tradesperson can remove the Damaged condition from most non-supernatural items, including weapons and armor, of rarity 6 or lower. The GM is the final arbiter of what items can be repaired, the cost, and how long the repair takes."
        }
    }

    # source stat block (page 233)
    #LZ9joqCCOzvmwpYvpj2Sr6 ^"Wandering Duelist" DEF {
        EXTENDS #t4540de6f35155c46f41f0 ^"NPC"
        PROPERTIES {
            ^"Type" STRING "Adversary" FIXED
            ^"Combat Conflict Rank" INTEGER 6
            ^"Intrigue Conflict Rank" INTEGER 3
            ^"Description" STRING "A common trope in Rokugani folktales is that of the wandering swordmaster, a rōnin whose devotion to mastery of the blade outweighs their sense of family obligation and duty. These rōnin not only cast themselves against hardship, but embrace the wild life of the lordless, for this, they believe, is the only way to hone their skill with the sword. Such rōnin easily find work as bodyguards and duelists, sometimes even with a Great Clan."
            ^"Rings" DEF {
                ^"Air" INTEGER 4
                ^"Earth" INTEGER 2
                ^"Fire" INTEGER 4
                ^"Water" INTEGER 3
                ^"Void" INTEGER 2
            }
            ^"Honor" INTEGER 45
            ^"Glory" INTEGER 30
            ^"Status" INTEGER 20
            ^"Endurance" INTEGER 13
            ^"Composure" INTEGER 10
            ^"Focus" INTEGER 6
            ^"Vigilance" INTEGER 3
            ^"Demeanor" STRING "Gruff"
            ^"Skills" LIST OF STRING ["Artisan 1", "Martial 3", "Scholar 1", "Social 2", "Trade 1"]
            ^"Advantages" LIST OF STRING ["Killer Instinct: Martial; Mental", "Worldly Wanderer: Scholar, Trade; Mental"]
            ^"Disadvantages" LIST OF STRING ["Careless: Social; Interpersonal"]
            ^"Favored Weapons" LIST OF STRING ["Katana: Range 1, Damage 4, Deadliness 5/7, Ceremonial, Razor-Edged"]
            ^"Gear" LIST OF STRING ["Worn traveler's clothes (Physical 2, Mundane)", "straw hat", "knife", "handful of zeni"]
        }
        RULES {
            #L5RPW70zW2uQ6bD7jT3vY0iT4gS: duelist_iaijutsu "Iaijutsu Cut: Crossing Blade: As an Attack and Movement action using one sheathed Razor-Edged weapon, the swordmaster may make a TN 2 Martial Arts [Melee] check targeting one character at range 1–2. The swordmaster draws and readies the sheathed weapon in a one-handed grip. If the swordmaster succeeds, they deal physical damage to the target equal to the weapon's deadliness plus their bonus successes."
            #L5RPW70gD2rE9tK4fG2zW6iK7kM: duelist_striking_fire "Striking as Fire: When performing an Attack action (Fire) check, the swordmaster may spend (op) as follows:\n\nFire (op)+: Increase the severity of any critical strike dealt as part of this attack by 2 per (op) spent in this way."
        }
    }

    # source stat block (page 234)
    #IYYomRI5lfdA4JJtOgNxG2 ^"Vigilante Shinobi" DEF {
        EXTENDS #t4540de6f35155c46f41f0 ^"NPC"
        PROPERTIES {
            ^"Type" STRING "Adversary" FIXED
            ^"Combat Conflict Rank" INTEGER 4
            ^"Intrigue Conflict Rank" INTEGER 2
            ^"Description" STRING "Shinobi exist in secret, training in secret, defying the laws of the Emperor and accepting Great Clan gold in exchange for carrying out clandestine deeds. But some shinobi train for a different purpose entirely: to protect the peasants from their own cruel samurai lords. Samurai who wrong the helpless peasantry are visited in the night by an avenging shadow, and those who attempt to subjugate a village simply vanish without a trace."
            ^"Rings" DEF {
                ^"Air" INTEGER 2
                ^"Earth" INTEGER 2
                ^"Fire" INTEGER 3
                ^"Water" INTEGER 3
                ^"Void" INTEGER 2
            }
            ^"Honor" INTEGER 0
            ^"Glory" INTEGER 20
            ^"Status" INTEGER 8
            ^"Endurance" INTEGER 10
            ^"Composure" INTEGER 12
            ^"Focus" INTEGER 6
            ^"Vigilance" INTEGER 3
            ^"Demeanor" STRING "Intimidating"
            ^"Skills" LIST OF STRING ["Artisan 0", "Martial 3", "Scholar 1", "Social 0", "Trade 1"]
            ^"Advantages" LIST OF STRING ["Killer Instinct: Martial; Mental", "Deadly Silent: Martial; Mental, Physical"]
            ^"Disadvantages" LIST OF STRING ["Ruthless: Social; Physical, Spiritual"]
            ^"Favored Weapons" LIST OF STRING ["Kusari-Gama: Range 0/2-3, Damage 3, Deadliness 3, Concealable, Snaring, Wargear", "Shuriken: Range 0, Damage 2, Deadliness 4, Range 1–3, Concealable"]
            ^"Gear" LIST OF STRING ["Worn traveler's clothes (Physical 2, Mundane)", "straw hat", "assorted knives", "caltrops", "vials", "handful of zeni", "infiltration clothes", "climbing equipment", "makeup and disguises"]
        }
        RULES {
            #L5RPW70mB7fC7kF9aF1gU5fN9zU: shinobi_skulk "Skulk: Activation: When a vigilante shinobi performs an Initiative or Attack action check using Air, they may spend (op) as follows:\n\nAir (op): If the vigilante shinobi is in obscuring terrain, a crowd, or otherwise concealed from sight, one character with vigilance lower than or equal to the shinobi's ranks in Skulduggery loses sight of the shinobi."
            #L5RPW70rA4xM5wR7oG7bQ3pT5tN: shinobi_wasps_spite "Wasp's Spite Style: Activation: When a vigilante shinobi performs a Martial Arts [Ranged] check, they may spend (op) in the following way:\n\nAir or Void (op) (op): If they did not succeed, they choose another target at range 0–2 of their target with vigilance lower than or equal to their target's. The new target suffers physical damage equal to the shinobi's weapon's base damage."
        }
    }

    # ===========================
    # NPC STAT BLOCKS - NAMED VILLAGERS
    # ===========================

    #rHVPxwdfE4UIhk0gbtF2uS ^"Reo, the Doshin" DEF {
        EXTENDS #t4540de6f35155c46f41f0 ^"NPC"

        # Path of Waves p. 130 (sample village, Optional Encounter:
        # Stolen Rice). Printed vigilance is 9; see the 2020 errata
        # overlay, which corrects it to 2.

        PROPERTIES {
            ^"Name" STRING "Reo, the Dōshin"
            ^"Type" STRING "Adversary" FIXED
            ^"Combat Conflict Rank" INTEGER 3
            ^"Intrigue Conflict Rank" INTEGER 1
            ^"Description" STRING "Reo is a young woman, and until her appointment was as close as a sister to Ichiro. However, when Setsuo recommended her to the magistrate and she received her post, she was honored, and vowed to take the role seriously—sometimes too much so. She guards the kura carefully, and when she is working alongside other villagers at any task, she considers it her role to correct or chide them as necessary. This habit has not won her any friends, and it has soured her relationship with Ichiro to the point of turning these once-close friends into enemies. Reo is lean and muscular but clumsy. As she has nothing to mark her rank, she ensures that everyone remembers her position by mentioning it often. She wears a club at her side and rests her hand on it as though it were a sword. She seems to take pleasure from criticizing Ichiro in particular. She likes Kaiya more than she'll admit, but she is afraid of her father, Hitoro. When the priest is not around, Reo is Michi's next favorite victim for teasing, and the monk reminds Reo often of her youth and inexperience. However, Reo tries her best to do a good job and genuinely cares for the fate of the village more than her own."
            ^"Rings" DEF {
                ^"Air" INTEGER 1
                ^"Earth" INTEGER 2
                ^"Fire" INTEGER 2
                ^"Water" INTEGER 2
                ^"Void" INTEGER 1
            }
            ^"Honor" INTEGER 65
            ^"Glory" INTEGER 45
            ^"Status" INTEGER 17
            ^"Endurance" INTEGER 6
            ^"Composure" INTEGER 5
            ^"Focus" INTEGER 5
            ^"Vigilance" INTEGER 9
            ^"Demeanor" STRING "Ambitious"
            ^"Skills" LIST OF STRING ["Artisan 0", "Martial 2", "Scholar 0", "Social 1", "Trade 1"]
            ^"Advantages" LIST OF STRING ["Salt of the Earth: Social; Interpersonal"]
            ^"Disadvantages" LIST OF STRING ["Clumsiness: Martial; Physical"]
            ^"Favored Weapons" LIST OF STRING ["Club: Range 0–1, Damage 5/6, Deadliness 2, Mundane"]
            ^"Gear" LIST OF STRING ["Common clothes (Physical 1)"]
        }
        RULES {
            #ZDmox5vA02ceAjFcrjEnae: reo_burst_of_courage "Burst of Courage: When Reo performs an Attack action, she may choose one additional target within range of her weapon."
        }
    }

