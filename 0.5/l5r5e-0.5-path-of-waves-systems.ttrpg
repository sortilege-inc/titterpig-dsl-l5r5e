            ^"Skill Modifier" STRING "+1 Martial and Social skills"
            ^"Replace Advantages" STRING "0-2: Blackmail on [Name] (Fire) [Interpersonal], Daredevil (Fire) [Mental, Physical], Fights Dirty (Fire) [Mental, Physical], Indomitable Will (Earth) [Interpersonal, Mental]"
            ^"Replace Disadvantages" STRING "0-2: Disdain for Honor (Void) [Flaw, Mental], Easily Provoked (Earth) [Flaw, Mental], Fear of Death (Earth) [Mental, Physical], Incurable Illness (Earth) [Physical], Paranoia (Water) [Mental, Physical]"
            ^"Add Techniques" STRING "0-2: Kata, Ninjutsu, Shūji"
            ^"Replace Demeanor" STRING "1: Assertive, Shrewd"
        }
    }

