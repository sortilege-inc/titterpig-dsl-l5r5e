                TECHNIQUE "Roar of Encouragement"
                TECHNIQUE "Rallying Cry"
            }
        }
    }

    # source stat block (page 186)
    #FVmA3Kdj0PaSGQf3ZemEkT ^"Ghostlands Warrior" DEF {
