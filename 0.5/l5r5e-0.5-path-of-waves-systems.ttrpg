    # ===========================

    # source stat block (page 235)
    #fajtaKDMg0Pnjb0j4Mq5zM ^"Blue Shark" DEF {
        EXTENDS #t4540de6f35155c46f41f0 ^"NPC"
        PROPERTIES {
            ^"Type" STRING "Adversary" FIXED
            ^"Category" STRING "Animal"
            ^"Combat Conflict Rank" INTEGER 6
            ^"Intrigue Conflict Rank" INTEGER 0
            ^"Description" STRING "Sharks are common to Rokugan's waters, although most species are small and harmless to humans. Rokugani blue sharks, however, are an exception. At six to nine feet long, blue sharks are known for their berserker fury and their attraction to blood. They rarely attack humans but become especially dangerous when they smell blood in the waters. They are venerated by some members of the Hiruma family, who admire their speed and silence and have adopted the symbol of the shark in the emblem of their scouting units."
            ^"Rings" DEF {
                ^"Air" INTEGER 1
                ^"Earth" INTEGER 3
                ^"Fire" INTEGER 4
                ^"Water" INTEGER 4
                ^"Void" INTEGER 1
            }
            ^"Endurance" INTEGER 15
            ^"Composure" INTEGER 4
            ^"Focus" INTEGER 3
            ^"Vigilance" INTEGER 2
            ^"Silhouette" INTEGER 3
            ^"Demeanor" STRING "Opportunistic"
            ^"Skills" LIST OF STRING ["Artisan 0", "Martial 2", "Scholar 0", "Social 0", "Trade 2"]
            ^"Advantages" LIST OF STRING ["Swift and Silent: Martial; Physical", "Keen Sense of Smell: Trade; Physical"]
            ^"Disadvantages" LIST OF STRING ["Hot-Tempered: Martial; Mental", "Weak Spot (Nose): Martial; Physical"]
            ^"Favored Weapons" LIST OF STRING ["Razor Teeth: Range 0, Damage 7, Deadliness 7, Razor-Edged"]
            ^"Gear" LIST OF STRING ["Thick hide (Physical 2)"]
        }
        RULES {
            #L5RPW71gR9bS1cR4eY8yI8sK3dE: shark_sea_creature "Sea Creature: A blue shark is a silhouette 3 aquatic animal. Increase the deadliness of its bite against a Bleeding target by 4."
            #L5RPW71qY5rG9gW8rM1mY2pY5vC: shark_blood_water "Blood in the Water: As an Attack and Movement action, a blue shark may make a TN 2 Fitness (Water) check to slam a target at range 0–1. If it succeeds, the target suffers the Dazed condition, and must resist with a TN 3 Fitness check (Earth 2, Fire 5) or suffer the Bleeding condition."
        }
    }

    # source stat block (page 235)
    #Vbs4GUhhZnSs63ORhMgrcm ^"Camel" DEF {
        EXTENDS #t4540de6f35155c46f41f0 ^"NPC"
        PROPERTIES {
            ^"Type" STRING "Minion" FIXED
            ^"Category" STRING "Animal"
            ^"Combat Conflict Rank" INTEGER 2
            ^"Intrigue Conflict Rank" INTEGER 1
            ^"Description" STRING "Camels were imported into the Empire by the Unicorn Clan when they returned from their eight-hundred-year exploration of the lands beyond Rokugan. Able to withstand extreme temperatures, sustain themselves by eating tough shrubs, and survive long periods without water, camels were useful work animals to the Unicorn Clan while they explored the Burning Sands and were swiftly domesticated. Camels are hardy and can be trained, but they are more stubborn and intelligent than horses and ponies, and require great patience to handle. The Unicorn still use camels for their woolly fur (which can be spun into textiles) and milk, for carrying goods and other burdens, and sometimes for mounts or even cavalry, as they handle rough terrain better than warhorses. In fact, camels tend to frighten Rokugani ponies and horses, making them effective counters to enemy cavalry (when the camels feel like cooperating). In spite of this, they are generally not used by any other Great Clan, as they are considered distasteful and dirty creatures."
            ^"Rings" DEF {
                ^"Air" INTEGER 1
                ^"Earth" INTEGER 4
                ^"Fire" INTEGER 2
                ^"Water" INTEGER 3
                ^"Void" INTEGER 1
            }
            ^"Endurance" INTEGER 12
            ^"Composure" INTEGER 6
            ^"Focus" INTEGER 4
            ^"Vigilance" INTEGER 2
            ^"Silhouette" INTEGER 2
            ^"Demeanor" STRING "Stubborn"
            ^"Skills" LIST OF STRING ["Artisan 0", "Martial 1", "Scholar 0", "Social 1", "Trade 0"]
            ^"Advantages" LIST OF STRING ["Survivalist: Martial; Physical", "Temperature Resistant: Martial; Physical"]
            ^"Disadvantages" LIST OF STRING ["Skittish: Martial; Mental"]
            ^"Gear" LIST OF STRING ["Woolly hide (Physical 3)"]
        }
        RULES {
            #L5RPW71uU2oS2kO5cH1sH3mR1kO: camel_lumbering "Lumbering: The camel is a silhouette 2 creature. It can be ridden by a human-sized rider."
        }
    }

    # source stat block (page 236)
    #rx2H58sjrcSVovQzGKPb0Z ^"Elegant Pit Viper" DEF {
        EXTENDS #t4540de6f35155c46f41f0 ^"NPC"
        PROPERTIES {
            ^"Type" STRING "Adversary" FIXED
            ^"Category" STRING "Animal"
            ^"Combat Conflict Rank" INTEGER 2
            ^"Intrigue Conflict Rank" INTEGER 1
            ^"Description" STRING "Pit vipers are relatively uncommon, although they grow steadily more common as one proceeds west toward the Shinomen Forest. Pit viper venom rots flesh and sours the blood, making these vipers' bites extremely dangerous to humans. They must be provoked to attack; the typical pit viper bite results from accidentally stepping on one. Generally, pit vipers are small, but a unique breed that can reportedly grow up to eight feet in length thrives on the Islands of Spice and Silk."
            ^"Rings" DEF {
                ^"Air" INTEGER 3
                ^"Earth" INTEGER 1
                ^"Fire" INTEGER 2
                ^"Water" INTEGER 3
                ^"Void" INTEGER 1
            }
            ^"Endurance" INTEGER 2
            ^"Composure" INTEGER 5
            ^"Focus" INTEGER 5
            ^"Vigilance" INTEGER 3
            ^"Silhouette" INTEGER 0
            ^"Demeanor" STRING "Cautious"
            ^"Skills" LIST OF STRING ["Artisan 0", "Martial 1", "Scholar 0", "Social 0", "Trade 0"]
            ^"Advantages" LIST OF STRING ["Swift and Silent: Martial; Physical", "Easily Overlooked: Martial; Physical"]
            ^"Disadvantages" LIST OF STRING ["Short Temper: Martial; Mental"]
            ^"Favored Weapons" LIST OF STRING ["Fangs: Range 0, Damage 1, Deadliness 3, Concealable, Razor-Edged"]
        }
        RULES {
            #L5RPW71pJ8jP3fH2dM9rY7kR0lA: viper_venomous "Venomous Bite: An elegant pit viper is a silhouette 0 creature. When performing an Attack action check, it may spend (op)+ to increase the TN of any check by a target to resist a critical strike inflicted by that action; if the target fails the check to resist that critical strike, they suffer the Dying (4 rounds) condition in addition to any other effects."
        }
    }

    # source stat block (page 236)
    #y1lBTSVWJrZJ9RxrsAM1tc ^"Elephant" DEF {
        EXTENDS #t4540de6f35155c46f41f0 ^"NPC"
        PROPERTIES {
            ^"Type" STRING "Adversary" FIXED
            ^"Category" STRING "Animal"
            ^"Combat Conflict Rank" INTEGER 8
            ^"Intrigue Conflict Rank" INTEGER 1
            ^"Description" STRING "Elephants are not native to Rokugan, and most Rokugani have never seen one. But a pair are known to be owned by the Ide family daimyō and kept in Khanbulak as a token of prestige, and the Bayushi menagerie keeps one healthy elephant as a curiosity. Generally timid and surprisingly smart, elephants are dangerous only when agitated or when their young are threatened. In the distant Mweneta Empire and the Ivory Kingdoms, the elephant is a valuable working animal and a formidable war animal, and it is venerated as a symbol of intelligence, compassion, and patience."
            ^"Rings" DEF {
                ^"Air" INTEGER 1
                ^"Earth" INTEGER 5
                ^"Fire" INTEGER 2
                ^"Water" INTEGER 3
                ^"Void" INTEGER 1
            }
            ^"Endurance" INTEGER 20
            ^"Composure" INTEGER 12
            ^"Focus" INTEGER 4
            ^"Vigilance" INTEGER 2
            ^"Silhouette" INTEGER 4
            ^"Demeanor" STRING "Flighty"
            ^"Skills" LIST OF STRING ["Artisan 0", "Martial 3", "Scholar 0", "Social 2", "Trade 2"]
            ^"Advantages" LIST OF STRING ["Enormous Stature: Martial; Physical", "Prehensile Trunk: Trade; Physical"]
            ^"Disadvantages" LIST OF STRING ["Skittish: Martial; Mental"]
            ^"Favored Weapons" LIST OF STRING ["Tusks: Range 1, Damage 8, Deadliness 8, Razor-Edged"]
            ^"Gear" LIST OF STRING ["Thick hide (Physical 5)"]
        }
        RULES {
            #L5RPW71kG5jA9aY3jC9nO6nI9aQ: elephant_trample "Trample: The elephant is a silhouette 4 creature. When an elephant inflicts a critical strike, the TN of the check to resist is 6, and if the target fails, they suffer the Dazed condition in addition to the other effects."
        }
    }

    # source stat block (page 237)
    #lPfiFj9p7jtiYm0U0X2o4U ^"Fox" DEF {
        EXTENDS #t4540de6f35155c46f41f0 ^"NPC"
        PROPERTIES {
            ^"Type" STRING "Minion" FIXED
            ^"Category" STRING "Animal"
            ^"Combat Conflict Rank" INTEGER 1
            ^"Intrigue Conflict Rank" INTEGER 1
            ^"Description" STRING "There are several varieties of fox that are native to Rokugan, including the dusty white snow fox, the more common red, black, and white fox, and the rare silver fox. These creatures are considered intelligent and for many conjure up images of the trickster-spirits known as kitsune."
            ^"Rings" DEF {
                ^"Air" INTEGER 3
                ^"Earth" INTEGER 1
                ^"Fire" INTEGER 1
                ^"Water" INTEGER 2
                ^"Void" INTEGER 1
            }
            ^"Endurance" INTEGER 5
            ^"Composure" INTEGER 4
            ^"Focus" INTEGER 4
            ^"Vigilance" INTEGER 3
            ^"Silhouette" INTEGER 0
            ^"Demeanor" STRING "Calculating"
            ^"Skills" LIST OF STRING ["Artisan 0", "Martial 1", "Scholar 0", "Social 0", "Trade 0"]
            ^"Advantages" LIST OF STRING ["Curious Nature: Social; Interpersonal"]
            ^"Disadvantages" LIST OF STRING ["Easily Spooked: Social; Mental"]
            ^"Favored Weapons" LIST OF STRING ["Teeth: Range 0, Damage 1, Deadliness 2, Razor-Edged"]
        }
        RULES {
            #L5RPW71yR6eK7qN7kB7zX7vK0sI: fox_tracker "Excellent Tracker: A fox is a creature of silhouette 0. It also reduces the TN of all checks to track prey by 2, to a minimum of 1."
        }
    }

    # source stat block (page 237)
    #tXRk9FdAVAOYXIQFT4ypbf ^"Giant Salamander" DEF {
        EXTENDS #t4540de6f35155c46f41f0 ^"NPC"
        PROPERTIES {
            ^"Type" STRING "Adversary" FIXED
            ^"Category" STRING "Animal"
            ^"Combat Conflict Rank" INTEGER 3
            ^"Intrigue Conflict Rank" INTEGER 1
            ^"Description" STRING "Giant salamanders are common in the marshes and rivers of southern Rokugan, although one must seek them out to find them, as they are nocturnal and aquatic, and they dislike living near human settlements. These massive amphibians can grow as large as nine feet long from head to tail, although they typically grow no larger than four. They are peaceful and only attack to retaliate, and when threatened they exude a thick peppery musk that stings the target's eyes."
            ^"Rings" DEF {
                ^"Air" INTEGER 2
                ^"Earth" INTEGER 3
                ^"Fire" INTEGER 1
                ^"Water" INTEGER 3
                ^"Void" INTEGER 1
            }
            ^"Endurance" INTEGER 10
            ^"Composure" INTEGER 8
            ^"Focus" INTEGER 3
            ^"Vigilance" INTEGER 2
            ^"Silhouette" INTEGER 2
            ^"Demeanor" STRING "Unenthused"
            ^"Skills" LIST OF STRING ["Artisan 0", "Martial 1", "Scholar 0", "Social 0", "Trade 2"]
            ^"Advantages" LIST OF STRING ["Enormous Stature: Martial; Physical"]
            ^"Disadvantages" LIST OF STRING ["Virtually Blind: Martial; Physical"]
            ^"Favored Weapons" LIST OF STRING ["Needle Bite: Range 0, Damage 2, Deadliness 5, Razor-Edged"]
            ^"Gear" LIST OF STRING ["Blubbery hide (Physical 2)"]
        }
        RULES {
            #L5RPW71nG8iK6oT7dI5kP4iJ4eD: salamander_huge "Huge and Slippery: TN of any check to pick up a giant salamander is increased by 2."
            #L5RPW71lZ9yB1pG2xZ5iI9mK1gE: salamander_musk "Pepper Musk: After a giant salamander defends against damage, each character at range 0–2 of the salamander suffers the Dazed condition and must resist with a TN 2 Fitness check (Air 4, Fire 1) or suffer the Disoriented condition as well."
        }
    }

    # source stat block (page 238)
    #q9H6Kc9wLyFdK4EZm2MsQA ^"Giant Hornet Swarm" DEF {
        EXTENDS #t4540de6f35155c46f41f0 ^"NPC"
        PROPERTIES {
            ^"Type" STRING "Minion" FIXED
            ^"Category" STRING "Animal"
            ^"Combat Conflict Rank" INTEGER 2
            ^"Intrigue Conflict Rank" INTEGER 0
            ^"Description" STRING "Giant hornets are the largest hornet species in Rokugan, growing up to two inches long. Most commonly encountered in Scorpion and Lion lands, giant hornets are feared despite their size due to the potency of their toxic sting, which can incapacitate even a grown adult. Giant hornet swarms are considered especially dangerous, although giant hornets are usually encountered alone. Colloquially known as \"sparrow bees,\" giant hornets are considered a delicacy in rural areas but must be fried in order to neutralize their toxin."
            ^"Rings" DEF {
                ^"Air" INTEGER 1
                ^"Earth" INTEGER 1
                ^"Fire" INTEGER 3
                ^"Water" INTEGER 1
                ^"Void" INTEGER 1
            }
            ^"Endurance" INTEGER 6
            ^"Composure" INTEGER 3
            ^"Focus" INTEGER 3
            ^"Vigilance" INTEGER 1
            ^"Silhouette" INTEGER 1
            ^"Demeanor" STRING "Aggressive"
            ^"Skills" LIST OF STRING ["Artisan 0", "Martial 1", "Scholar 0", "Social 0", "Trade 0"]
            ^"Advantages" LIST OF STRING ["Lightning Reflexes: Martial; Physical"]
            ^"Disadvantages" LIST OF STRING ["Quick to Anger: Social; Interpersonal"]
            ^"Favored Weapons" LIST OF STRING ["Stinger: Range 0, Damage 1, Deadliness 7"]
            ^"Gear" LIST OF STRING ["Hardened Exoskeleton (Physical 1)"]
        }
        RULES {
            #L5RPW71pW3rR2aM7xH5mD3rI4vJ: hornet_nimble "Nimble Flyer: The giant hornet swarm is a silhouette 1 creature that can fly. It can move vertically and ignores the negative effects of terrain."
            #L5RPW71jD7bU3eV6qM1sN0mR6cK: hornet_toxic "Toxic Sting: When performing an Attack action check, the giant hornet swarm may spend (op) as follows:\n\n(op)+: The target suffers one of the following conditions: Dazed, Disoriented, or Exhausted.\n\n(op) (op): The target suffers the Immobilized condition."
        }
    }

    # source stat block (page 238)
    #Wi5co2Aue6IGBdWRAQmGgN ^"Saltwater Crocodile" DEF {
        EXTENDS #t4540de6f35155c46f41f0 ^"NPC"
        PROPERTIES {
            ^"Type" STRING "Adversary" FIXED
            ^"Category" STRING "Animal"
            ^"Combat Conflict Rank" INTEGER 5
            ^"Intrigue Conflict Rank" INTEGER 1
            ^"Description" STRING "Crocodiles are relatively common aquatic reptiles in both the coastal rivers and swamps of northern Rokugan and the marshlands of the Crane. Given enough to eat, Rokugani crocodiles have been known to grow up to twenty feet long and nearly 2,500 pounds. They hunt by floating still, appearing to be a log or other flotsam, and then snapping at unwary prey and dragging them into the water, spinning and thrashing into what is colloquially known as a \"death roll.\" Hunting crocodiles requires multiple samurai; facing one alone in marshy environments is unwise."
            ^"Rings" DEF {
                ^"Air" INTEGER 1
                ^"Earth" INTEGER 4
                ^"Fire" INTEGER 3
                ^"Water" INTEGER 5
                ^"Void" INTEGER 1
            }
            ^"Endurance" INTEGER 16
            ^"Composure" INTEGER 10
            ^"Focus" INTEGER 4
            ^"Vigilance" INTEGER 2
            ^"Silhouette" INTEGER 3
            ^"Demeanor" STRING "Opportunistic"
            ^"Skills" LIST OF STRING ["Artisan 0", "Martial 3", "Scholar 0", "Social 0", "Trade 1"]
            ^"Advantages" LIST OF STRING ["Enormous Stature: Martial; Physical"]
            ^"Disadvantages" LIST OF STRING ["Clumsy on Land: Martial; Physical"]
            ^"Favored Weapons" LIST OF STRING ["Teeth: Range 0, Damage 5, Deadliness 4, Razor-Edged, Snaring"]
            ^"Gear" LIST OF STRING ["Thick hide (Physical 4)"]
        }
        RULES {
            #L5RPW71eF1mI0cA9mU2bC5wC8cY: croc_aquatic "Giant Aquatic Reptile: A saltwater crocodile is a silhouette 3 creature and can move through the water without requiring checks."
            #L5RPW71nK3cI0vZ5bC4iT4kR6xB: croc_death_roll "Death Roll: When a crocodile succeeds on an Attack action check against a target, that target suffers the Prone and Disoriented conditions.\n\nIf the crocodile and its target are in the water, the target must make a TN 3 Fitness check; if they fail, the target begins drowning (see Suffocation, on page 269 of the core rulebook)."
        }
    }

    #0S772yPtJAwIMq6PRmrLXS ^"Serow" DEF {
        EXTENDS #t4540de6f35155c46f41f0 ^"NPC"
        PROPERTIES {
            ^"Type" STRING "Minion" FIXED
            ^"Category" STRING "Animal"
            ^"Combat Conflict Rank" INTEGER 1
            ^"Intrigue Conflict Rank" INTEGER 1
            ^"Description" STRING "Roaming forests and meadows in small herds, the serow (or \"forest-deer\" as they are colloquially known) is a bovid grazer approximately the size of a large goat. Appearing as a shaggy cross between a goat and a deer, the serow has a long face, thick soft fur, backward-facing horns, and cloven hooves. As herd animals, they tend to flee when threatened. Serow are able to scale mountain cliffs with surprising ease. They exclusively eat plant matter and possess excellent hearing and sight. Their seemingly supernatural senses, combined with their natural wall-scaling agility, earns them reverence from shinobi groups, and they sometimes appear on the emblems of secretive shinobi dōjō."
            ^"Rings" DEF {
                ^"Air" INTEGER 1
                ^"Earth" INTEGER 3
                ^"Fire" INTEGER 1
                ^"Water" INTEGER 3
                ^"Void" INTEGER 1
            }
            ^"Endurance" INTEGER 6
            ^"Composure" INTEGER 6
            ^"Focus" INTEGER 4
            ^"Vigilance" INTEGER 4
            ^"Silhouette" INTEGER 2
            ^"Demeanor" STRING "Flighty"
            ^"Skills" LIST OF STRING ["Artisan 0", "Martial 1", "Scholar 0", "Social 1", "Trade 1"]
            ^"Advantages" LIST OF STRING ["Excellent Senses: Martial; Mental, Physical", "Lightning Reflexes: Martial; Mental, Physical"]
            ^"Disadvantages" LIST OF STRING ["Meek: Martial; Mental"]
            ^"Favored Weapons" LIST OF STRING ["Hooves: Range 1, Damage 4, Deadliness 3"]
        }
        RULES {
            #L5RPW71mF7fM7eO2uS7mA6tU0rF: serow_forest_deer "Forest-Deer: Serow are creatures of silhouette 2. They can clamber up rocky cliffs and exceptionally steep surfaces without issue."
        }
    }

    # source stat block (page 240)
    #KjjcOubUNT4yFugyDOxDQZ ^"Emperor Serow" DEF {
        EXTENDS #t4540de6f35155c46f41f0 ^"NPC"
        PROPERTIES {
            ^"Type" STRING "Adversary" FIXED
            ^"Category" STRING "Animal"
            ^"Combat Conflict Rank" INTEGER 2
            ^"Intrigue Conflict Rank" INTEGER 1
            ^"Description" STRING "Serow herds are much smaller than herds of deer and oxen, rarely exceeding six individuals. More often, they roam in mated pairs. However, sometimes a wily serow reaches the age of twenty-five and sprouts a pair of branched antlers and a shaggy mane from their collarbone. This is the so-called emperor serow, a strong animal that attracts other serow into larger herds with its mournful keen. An emperor serow is accompanied by anywhere between four and twenty mated serow pairs and possesses a gleam of intelligence. Their fur is prized for winter wear, but they are difficult game to catch."
            ^"Rings" DEF {
                ^"Air" INTEGER 2
                ^"Earth" INTEGER 3
                ^"Fire" INTEGER 1
                ^"Water" INTEGER 4
                ^"Void" INTEGER 1
            }
            ^"Endurance" INTEGER 8
            ^"Composure" INTEGER 10
            ^"Focus" INTEGER 5
            ^"Vigilance" INTEGER 4
            ^"Silhouette" INTEGER 2
            ^"Demeanor" STRING "Flighty"
            ^"Skills" LIST OF STRING ["Artisan 0", "Martial 2", "Scholar 0", "Social 1", "Trade 1"]
            ^"Advantages" LIST OF STRING ["Excellent Senses: Martial; Mental, Physical", "Lightning Reflexes: Martial; Mental, Physical"]
            ^"Disadvantages" LIST OF STRING ["Meek: Martial; Mental"]
            ^"Favored Weapons" LIST OF STRING ["Hooves: Range 1-2, Damage 5, Deadliness 4"]
            ^"Gear" LIST OF STRING ["Shaggy hide (Physical 2)"]
        }
        RULES {
            #L5RPW71nS9dI4uP8tJ8kV2vW3yC: emperor_serow_forest "Forest-Deer: Serow are creatures of silhouette 2. They can clamber up rocky cliffs and exceptionally steep surfaces without issue."
            #L5RPW71tS0cZ9mP6xB8uU7uF4yZ: emperor_serow_protect "Protect the Herd: As an action, the emperor serow may have up to two serow who have not yet acted this round immediately move 1 range band and perform a Strike action with skilled assistance (see page 26 of the core rulebook)."
        }
    }

    # source stat block (page 240)
    #jWPoVBUNpwZR2AjOTK9jXW ^"Macaque" DEF {
        EXTENDS #t4540de6f35155c46f41f0 ^"NPC"
        PROPERTIES {
            ^"Type" STRING "Minion" FIXED
            ^"Category" STRING "Animal"
            ^"Combat Conflict Rank" INTEGER 2
            ^"Intrigue Conflict Rank" INTEGER 1
            ^"Description" STRING "Also known as \"snow monkeys,\" red-faced macaques are normally confined to the forested Seikitsu Mountains and the Islands of Spice and Silk. However, because they are popular pets of samurai lords, and because they are a sacred animal to Brotherhood monks, macaques are commonly captured and disseminated throughout the Empire. For this reason, they can be encountered virtually anywhere. While they pose little physical threat to an armed and armored samurai, they are curious tricksters, stealing unsecured items and leaping away before much can be done about it.\n\nWhile they are considered mere nuisances, one shouldn't underestimate the trouble these monkeys can cause. Famously, the skilled ninth-century duelist Matsu Sugeki was publicly embarrassed when, just before a duel with his rival, a macaque stole his sword right out of its sheath and scrambled up a tree with it! Unable to force the animal back down despite hours of trying, Sugeki was forced to use an ally's sword and, unaccustomed to its balance, subsequently lost."
            ^"Rings" DEF {
                ^"Air" INTEGER 3
                ^"Earth" INTEGER 1
                ^"Fire" INTEGER 3
                ^"Water" INTEGER 4
                ^"Void" INTEGER 1
            }
            ^"Endurance" INTEGER 6
            ^"Composure" INTEGER 6
            ^"Focus" INTEGER 5
            ^"Vigilance" INTEGER 4
            ^"Silhouette" INTEGER 0
            ^"Demeanor" STRING "Mischievous"
            ^"Skills" LIST OF STRING ["Artisan 0", "Martial 1", "Scholar 0", "Social 2", "Trade 3"]
            ^"Advantages" LIST OF STRING ["Lightning Reflexes: Martial; Mental, Physical"]
            ^"Disadvantages" LIST OF STRING ["Curious: Social; Mental"]
            ^"Favored Weapons" LIST OF STRING ["Bite: Range 0, Damage 1, Deadliness 2"]
            ^"Gear" LIST OF STRING ["Something the last person the macaque pickpocketed thinks is still in their bag"]
        }
        RULES {
            #L5RPW71rF5nK3nJ5hK6zB0fW4nQ: macaque_tricksters "Natural Tricksters: When making an Attack action check, the macaque can spend (op) in the following way:\n\n(op): Steal an unsecured item within reach.\n\n(op)+: Steal an item from a target with vigilance lower than or equal to the (op) spent this way."
            #L5RPW71kZ1oX7pP9nJ4tK3yE1dY: macaque_humiliating "Humiliating: When an Attack action check targeting the macaque fails, the attacker receives 2 strife. When the macaque steals an item from a character, that character receives 3 strife."
        }
    }

    # ===========================
    # SPIRITS AND STRANGE BEINGS
    # ===========================

    # source stat block (page 241)
    #Q7w91s4kEzN75tLx9nO0QB ^"Monstrous Octopus" DEF {
        EXTENDS #t4540de6f35155c46f41f0 ^"NPC"
        PROPERTIES {
            ^"Type" STRING "Adversary" FIXED
            ^"Category" STRING "Animal"
            ^"Combat Conflict Rank" INTEGER 4
            ^"Intrigue Conflict Rank" INTEGER 1
            ^"Description" STRING "Octopuses are aquatic mollusks with eight legs and soft bodies that thrive along Rokugan's coasts. Dozens of octopus species live in Rokugan's seas. Most octopuses are small and harmless, and they play an important part in Rokugani cuisine. However, the monstrous octopus is an exceptionally large version, between twenty and thirty feet in size and able to amble on land for brief periods. Octopuses are generally shy and prefer to flee rather than fight, releasing an ink cloud to hide their retreat. Still, if they are forced to fight, they are skilled grapplers; many a Rokugani sailor has drowned in one's tentacled grasp."
            ^"Rings" DEF {
                ^"Air" INTEGER 3
                ^"Earth" INTEGER 2
                ^"Fire" INTEGER 3
                ^"Water" INTEGER 4
                ^"Void" INTEGER 1
            }
            ^"Endurance" INTEGER 10
            ^"Composure" INTEGER 14
            ^"Focus" INTEGER 4
            ^"Vigilance" INTEGER 3
            ^"Silhouette" INTEGER 4
            ^"Demeanor" STRING "Cautious"
            ^"Skills" LIST OF STRING ["Artisan 0", "Martial 2", "Scholar 0", "Social 1", "Trade 1"]
            ^"Advantages" LIST OF STRING ["Camouflage Skin: Artisan; Physical", "Eight Strong Arms: Martial; Physical"]
            ^"Disadvantages" LIST OF STRING ["Clumsy: Martial; Mental, Physical"]
            ^"Favored Weapons" LIST OF STRING ["Tentacle Arms: Range 0-2, Damage 5, Deadliness 3, Snaring"]
            ^"Gear" LIST OF STRING ["Rubbery hide (Physical 2)"]
        }
        RULES {
            #L5RPW71wP7vV5wP6hT9wS8gT6xJ: octopus_aquatic "Aquatic Giant: The monstrous octopus is a silhouette 4 creature that moves through the water without requiring checks."
            #L5RPW71oW8qD1uZ4iG5bR9wB3zR: octopus_disguise "Master of Disguise: When performing a check, an octopus may spend (op) as follows:\n\n(op)+: The octopus disguises itself in its environment, causing each character with vigilance lower than or equal to the (op) spent this way to lose sight of it."
        }
    }

    # source stat block (page 243)
    #t94d8eaee1f03a4f4d9ec5 ^"Rhinoceros" DEF {
        EXTENDS #t4540de6f35155c46f41f0 ^"NPC"
        PROPERTIES {
            ^"Type" STRING "Adversary" FIXED
            ^"Category" STRING "Animal"
            ^"Combat Conflict Rank" INTEGER 9
            ^"Intrigue Conflict Rank" INTEGER 1
            ^"Description" STRING "Very few in Rokugan are be able to conjure an image of what a rhinoceros looks like, though those who hail from the Ivory Kingdoms are all-too familiar with these massive, aggressive, plant-eating behemoths. Weighing between 3,500 and 4,500 pounds, these single-horned creatures are sometimes referred to as the unicorns of the Ivory Kingdoms."
            ^"Rings" DEF {
                ^"Air" INTEGER 1
                ^"Earth" INTEGER 5
                ^"Fire" INTEGER 3
                ^"Water" INTEGER 2
                ^"Void" INTEGER 1
            }
            ^"Endurance" INTEGER 22
            ^"Composure" INTEGER 10
            ^"Focus" INTEGER 5
            ^"Vigilance" INTEGER 3
            ^"Silhouette" INTEGER 4
            ^"Demeanor" STRING "Intimidating"
            ^"Skills" LIST OF STRING ["Artisan 0", "Martial 4", "Scholar 0", "Social 1", "Trade 0"]
            ^"Advantages" LIST OF STRING ["Huge Creature: Martial; Physical"]
            ^"Disadvantages" LIST OF STRING ["Territorial: Social; Mental"]
            ^"Favored Weapons" LIST OF STRING ["Horn: Range 1, Damage 8, Deadliness 8, Durable, Razor-Edged"]
            ^"Gear" LIST OF STRING ["Coarse Hide (Physical 4)"]
        }
        RULES {
            #L5RPW71oN4gU7xY4lR3tT0dX4gO: rhino_charge "Furious Charge: A rhinoceros is a creature of silhouette 4. As an Attack action, a rhinoceros may target a location within range 3–5. The rhinoceros charges at the targeted location, and any creatures within range 0–1 of the location must make a TN 4 Fitness check (Fire 6, Air 2) to resist. If they fail, they suffer a critical injury of severity 8 and become Incapacitated."
        }
    }

    # source stat block (page 244)
    #ADWERa9ulS8l6Irh4zFXTo ^"Akkorokamui" DEF {
        EXTENDS #t4540de6f35155c46f41f0 ^"NPC"
        PROPERTIES {
            ^"Type" STRING "Adversary" FIXED
            ^"Category" STRING "Spirit"
            ^"Combat Conflict Rank" INTEGER 7
            ^"Intrigue Conflict Rank" INTEGER 3
            ^"Description" STRING "When an octopus reaches a certain age and consumes a piece of jade, it is said to become a massive creature known as the akkorokamui. This gigantic octopus reaches over 400 feet in size and can regenerate lost limbs within mere minutes. It is said that eating the flesh of an akkorokamui temporarily bestows the properties of jade, making one immune to the Shadowlands Taint. But there is no official confirmation of this rumor, and obtaining such a meal is risky indeed."
            ^"Rings" DEF {
                ^"Air" INTEGER 3
                ^"Earth" INTEGER 4
                ^"Fire" INTEGER 3
                ^"Water" INTEGER 6
                ^"Void" INTEGER 1
            }
            ^"Endurance" INTEGER 14
            ^"Composure" INTEGER 20
            ^"Focus" INTEGER 6
            ^"Vigilance" INTEGER 5
            ^"Silhouette" INTEGER 5
            ^"Demeanor" STRING "Fickle"
            ^"Skills" LIST OF STRING ["Artisan 1", "Martial 3", "Scholar 1", "Social 2", "Trade 0"]
            ^"Advantages" LIST OF STRING ["Camouflage Skin: Artisan; Physical", "Eight Strong Arms: Martial; Physical"]
            ^"Disadvantages" LIST OF STRING ["Clumsy: Martial; Mental, Physical"]
            ^"Favored Weapons" LIST OF STRING ["Tentacle Arms: Range 0-5, Damage 8, Deadliness 6"]
            ^"Gear" LIST OF STRING ["Supernatural hide (Physical 3, Supernatural 3)"]
        }
        RULES {
            #L5RPW71cS8bX4jF3tD7lA6gU9dW: akkorokamui_aquatic "Aquatic Giant: The akkorokamui is a silhouette 5 creature that moves through the water without requiring checks."
            #L5RPW71xM6vF1rM5jN6pP0qJ5mQ: akkorokamui_regen "Fast Regenerate: This octopus can regenerate its lost limbs and injuries in a few minutes. The severity of critical strikes against this enemy is reduced by 3, to a minimum of 1. Burning attacks are not affected by this ability."
        }
    }

    # source stat block (page 248)
    #RrBCRYa5czfbsdxP9CiIR0 ^"Rakshasa" DEF {
        EXTENDS #t4540de6f35155c46f41f0 ^"NPC"
        PROPERTIES {
            ^"Type" STRING "Adversary" FIXED
            ^"Category" STRING "Spirit"
            ^"Combat Conflict Rank" INTEGER 5
            ^"Intrigue Conflict Rank" INTEGER 6
            ^"Description" STRING "The Shadowlands stands as an imposing force of wickedness and spiritual decay that borders the Crab lands, but this vile land stretches further than most of Rokugan realizes. Even further southwest the Shadowlands warps from long expanses of twisting hills and unforgiving winds to the lush and foreboding Ghostlands forests. Here live the rakshasa, shapeshifting beings who, like oni, feel for humanity. These creatures are bipedal and range from human-sized to over eight feet tall, and possess illusionary magic that can change their appearance to any who view them. Most love to capture and eat human flesh, though some have other nerfarious plots."
            ^"Rings" DEF {
                ^"Air" INTEGER 4
                ^"Earth" INTEGER 3
                ^"Fire" INTEGER 3
                ^"Water" INTEGER 4
                ^"Void" INTEGER 2
            }
            ^"Endurance" INTEGER 10
            ^"Composure" INTEGER 14
            ^"Focus" INTEGER 6
            ^"Vigilance" INTEGER 4
            ^"Silhouette" INTEGER 3
            ^"Demeanor" STRING "Scheming"
            ^"Skills" LIST OF STRING ["Artisan 1", "Martial 2", "Scholar 2", "Social 2", "Trade 1"]
            ^"Advantages" LIST OF STRING ["Shifting Form: Social, Martial; Interpersonal, Physical"]
            ^"Disadvantages" LIST OF STRING ["Hungry for Flesh: Social; Mental"]
            ^"Favored Weapons" LIST OF STRING ["Deadly Claws (in natural form): Range 0–1, Damage 5, Deadliness 4, Razor-Edged, Unholy", "Urumi (whip-sword): Range 1-2, Damage 4, Deadliness 5, Cumbersome, Razor-Edged, Snaring"]
            ^"Gear" LIST OF STRING ["Unholy Hide (Physical 3, Spiritual 2, Unholy)"]
        }
        RULES {
            #L5RPW71uS5vY7yT1tV9fF6gK3xD: rakshasa_illusion "Illusory Hunter: A rakshasa is a being of silhouette 3 that can change their form to appear as a creature of silhouette 2–4. At the start of a scene characters must make a TN 4 Survival or Theology check (Air 6, Void 2) to attempt to see through the rakshasa's illusory form. If they fail, they receive 2 strife and cannot see through the illusion."
            #L5RPW71zV5jH4zK9kK5sW2mK0qX: rakshasa_desire "Overwhelming Desire: When a rakshasa makes a successful Attack action check they may spend (op) in the following ways:\n\n(op): The target suffers the Bleeding condition.\n\n(op) (op): If the target is Bleeding, the rakshasa may heal 3 fatigue."
        }
    }

    # source stat block (page 248)
    #s4Mp6evnsMsRFlHtHkFCQk ^"Captivating Rakshasa" DEF {
        EXTENDS #t4540de6f35155c46f41f0 ^"NPC"
        PROPERTIES {
            ^"Type" STRING "Adversary" FIXED
            ^"Category" STRING "Spirit"
            ^"Combat Conflict Rank" INTEGER 9
            ^"Intrigue Conflict Rank" INTEGER 10
            ^"Description" STRING "While rakshasa are often thought of as devious, horned and fanged creatures that are ever plotting for their next human meal, some are more perspicacious. Most rakshasa are intelligent, and not all are driven by insatiable bloodlust. When a rakshasa overcomes their urge to feed, they can spend more time refining their illusory and magical arts, making them much more potent and deadly. These older, wiser rakshasa are capable of both good and bad acts, but are often driven to wicked deeds in response to being hunted by humans who view them as no more than monsters."
            ^"Rings" DEF {
                ^"Air" INTEGER 5
                ^"Earth" INTEGER 4
                ^"Fire" INTEGER 4
                ^"Water" INTEGER 5
                ^"Void" INTEGER 3
            }
            ^"Endurance" INTEGER 16
            ^"Composure" INTEGER 18
            ^"Focus" INTEGER 8
            ^"Vigilance" INTEGER 5
            ^"Silhouette" INTEGER 3
            ^"Demeanor" STRING "Beguiling"
            ^"Skills" LIST OF STRING ["Artisan 2", "Martial 3", "Scholar 2", "Social 4", "Trade 1"]
            ^"Advantages" LIST OF STRING ["Shifting Form: Social, Martial; Interpersonal, Physical"]
            ^"Disadvantages" LIST OF STRING ["Bitter: Social; Interpersonal, Mental"]
            ^"Favored Weapons" LIST OF STRING ["Deadly Claws (in natural form): Range 0–1, Damage 5, Deadliness 4, Razor-Edged, Unholy", "Urumi (whip-sword): Range 1-2, Damage 4, Deadliness 5, Cumbersome, Razor-Edged, Snaring"]
            ^"Gear" LIST OF STRING ["Unholy Hide (Physical 3, Spiritual 2, Unholy)", "morbid trophies"]
        }
        RULES {
            #L5RPW71jQ0cK5hS8oU6gZ2eK6xZ: cap_rakshasa_illusion "Illusory Hunter: A captivating rakshasa is a being of silhouette 3 that can change their form to appear as a creature of silhouette 2–4. At the start of a scene characters must make a TN 5 Survival or Theology check (Air 7, Void 3) to attempt to see through the rakshasa's illusionary form. If they fail, they receive 2 strife and cannot see through the illusion."
            #L5RPW71uG0sY9nX7vG6iR0lW8oJ: cap_rakshasa_charm "Captivating Charm: As an Attack action check, a captivating rakshasa may choose a target. The target must resist with a TN 5 Meditation or Theology check (Fire 7, Earth 3). If they fail, the target must immediately move one range band toward another target of the rakshasa's choice and perform the Strike action against them. If no targets are in range, the original target instead suffers 4 strife."
        }
    }

    # source stat block (page 171)
    #e48jcAhRJBKi8MsVXRVunB ^"Penanggalan (Path of Waves)" DEF {
        EXTENDS #t4540de6f35155c46f41f0 ^"NPC"
        PROPERTIES {
            ^"Type" STRING "Adversary" FIXED
            ^"Category" STRING "Spirit"
            ^"Combat Conflict Rank" INTEGER 8
            ^"Intrigue Conflict Rank" INTEGER 6
            ^"Description" STRING "The penanggalan is a bizarre and horrifying creature that can detach its head and viscera from its body. The latter remains hidden away, while the former fly about through the night, stalking victims. When it strikes, the penanggalan strangles its quarry with its own dangling entrails and then drinks its quarry's blood. Returning to its lair, it must soak its bloated viscera in vinegar in order to fit them back into its body.\n\nPenanggalan thrive by remaining undetected. They are formidable in battle but generally avoid open combat, heavily armed and armored victims, and the like. They flee if seriously threatened."
            ^"Rings" DEF {
                ^"Air" INTEGER 4
                ^"Earth" INTEGER 4
                ^"Fire" INTEGER 2
                ^"Water" INTEGER 3
                ^"Void" INTEGER 1
            }
            ^"Endurance" INTEGER 12
            ^"Composure" INTEGER 14
            ^"Focus" INTEGER 6
            ^"Vigilance" INTEGER 4
            ^"Silhouette" INTEGER 2
            ^"Demeanor" STRING "Wary"
            ^"Skills" LIST OF STRING ["Artisan 0", "Martial 3", "Scholar 1", "Social 2", "Trade 1"]
            ^"Advantages" LIST OF STRING ["Horrific Form: Social; Interpersonal, Mental, Spiritual"]
            ^"Disadvantages" LIST OF STRING ["Endless Hunger: Social; Interpersonal, Mental"]
            ^"Favored Weapons" LIST OF STRING ["Choking Entrails: Range 1, Damage 4, Deadliness 5, Snaring, Unholy"]
            ^"Gear" LIST OF STRING ["Disconcerting viscera (Physical 3, Supernatural 5, Unholy)"]
        }
        RULES {
            #L5RPW71rH8pZ1gR4yC1pM0rA7wE: penanggalan_flying "Flying Horror: Watchful, in its penanggalan form, is a silhouette 2 creature that can fly. It can move vertically and ignores the negative effects of terrain. When performing a Movement action in a skirmish, it may move up to 2 additional range bands, or it may make a TN 3 Fitness check to move 3 range bands."
            #L5RPW71wZ8sJ7aY8pF7pE0iM7xP: penanggalan_profane "Profane Nature: Watchful is an Otherworldly, Tainted being. If its body is destroyed by burning while the head is absent, Watchful dies at the next sunrise."
            #L5RPW71iA0qS9lD7rY0hI8pG0dW: penanggalan_immobilize "Immobilizing Tendrils: Characters at range 0–2 do not remove the Immobilized condition inflicted by Watchful at the start of their turn as normal unless they choose to receive 3 fatigue."
            #L5RPW71nO2oQ1lJ4yJ5qS1eU4cG: penanggalan_ensnare "Ensnaring Viscera: As an Attack action, Watchful may attempt to squeeze the life out of anyone who it has ensnared. Each Immobilized character at range 0–2 must resist with a TN 5 Fitness (Earth 4, Air 7) check or receive fatigue equal to their shortfall."
        }
    }

    # source stat block (page 172)
    #E9mtPeRA7IAnPahqXmobJs ^"Possessed Puppets" DEF {
        EXTENDS #t4540de6f35155c46f41f0 ^"NPC"
        PROPERTIES {
            ^"Type" STRING "Minion" FIXED
            ^"Category" STRING "Spirit"
            ^"Combat Conflict Rank" INTEGER 1
            ^"Intrigue Conflict Rank" INTEGER 1
            ^"Description" STRING "The possessed puppets come in a variety of shapes, including firefighters, a toy duck, and a trio of children. The spirits that possess the dolls can move of their own accord, and can also use minor illusions to make their expressions change from soft smiles to twisted grins with sharp teeth. The dolls can move very quickly, and the sounds of their skittering across the floor is particularly unsettling."
            ^"Rings" DEF {
                ^"Air" INTEGER 3
                ^"Earth" INTEGER 1
                ^"Fire" INTEGER 3
                ^"Water" INTEGER 2
                ^"Void" INTEGER 1
            }
            ^"Endurance" INTEGER 2
            ^"Composure" INTEGER 5
