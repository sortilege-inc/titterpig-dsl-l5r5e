            ^"Disadvantages" LIST OF STRING ["Easily Distracted: Social; Interpersonal, Mental"]
            ^"Favored Weapons" LIST OF STRING ["Sharpened Wooden Appendages: Range 0, Damage 1, Deadliness 2"]
            ^"Gear" LIST OF STRING ["Guise of illusions (Supernatural 3)"]
        }
        RULES {
            #L5RPW71pV3vB7hN5bA8tL5hM8zE: puppet_mischief "Mischief Maker: As a Support action, a possessed puppet may target one position at range 0–2. An area at range 0–1 of that position gains one of the following terrain qualities: Dangerous, Entangling, Obscuring."
        }
    }

    # --- ADDITIONAL SPIRITS AND KAMI ---

    # source stat block (page 244)
    #grm3G3XSdwULg1aCl58PBw ^"Amikiri" DEF {
        EXTENDS #t4540de6f35155c46f41f0 ^"NPC"
        PROPERTIES {
            ^"Type" STRING "Minion" FIXED
            ^"Category" STRING "Spirit"
            ^"Combat Conflict Rank" INTEGER 4
            ^"Intrigue Conflict Rank" INTEGER 2
            ^"Description" STRING "An amikiri is the transformation of a scorpion that has reached one hundred years of age, growing in size and gaining the ability to camouflage itself. These creatures hide in ceiling corners, blending into their surroundings, and use their claws to sever mosquito nets, lamp ropes, and other such fixtures. While they are usually relatively harmless, they are deadly adversaries when confronted.\n\nSome scholars believe that the scorpion is not native to Rokugan, but was discovered and brought to Rokugan by Shosuro during her travels as a service to her clan."
            ^"Rings" DEF {
                ^"Air" INTEGER 2
                ^"Earth" INTEGER 2
                ^"Fire" INTEGER 3
                ^"Water" INTEGER 3
                ^"Void" INTEGER 1
            }
            ^"Endurance" INTEGER 6
            ^"Composure" INTEGER 7
            ^"Focus" INTEGER 5
            ^"Vigilance" INTEGER 3
            ^"Silhouette" INTEGER 1
            ^"Demeanor" STRING "Aggressive"
            ^"Skills" LIST OF STRING ["Artisan 0", "Martial 1", "Scholar 1", "Social 0", "Trade 2"]
            ^"Advantages" LIST OF STRING ["Camouflage Carapace: Trade; Physical", "Cling to Walls: Martial; Physical"]
            ^"Disadvantages" LIST OF STRING ["Compulsive: Social; Mental"]
            ^"Favored Weapons" LIST OF STRING ["Scorpion Claws: Range 0, Damage 4, Deadliness 3", "Tail Stinger: Range 0-1, Damage 3, Deadliness 6"]
            ^"Gear" LIST OF STRING ["Chitinous hide (Physical 3)"]
        }
        RULES {
            #L5RPW71bH0vJ6bA6zV3zB3bB9iW: amikiri_scorpion "Giant Scorpion: Otherworldly silhouette 1 creature."
            #L5RPW71hI2bU9yP6wY4aL4tT3fK: amikiri_toxic "Toxic Sting: Once per scene when succeeding on an Attack action check, the amikiri may spend (op) as follows:\n\n(op): The target suffers a critical strike with severity 8."
        }
    }

    # source stat block (page 245)
    #U71Llhrq57h1Dv1D5ssDE5 ^"Basan" DEF {
        EXTENDS #t4540de6f35155c46f41f0 ^"NPC"
        PROPERTIES {
            ^"Type" STRING "Adversary" FIXED
            ^"Category" STRING "Spirit"
            ^"Combat Conflict Rank" INTEGER 3
            ^"Intrigue Conflict Rank" INTEGER 1
            ^"Description" STRING "Also known as the mountain rooster, or \"basa-basa\" after its distinct call, the basan is a native of Chikushōdō, the Realm of Animals. It sometimes wanders into the Realm of Mortals. Resembling an oversized rooster with vibrant plumage that darkens into a charcoal color when it is threatened, the basan is able to breathe plumes of blue flame, although these flames do not burn unless the basan is angered or frightened. As it is a nocturnal creature, its keening call and brightly exhaled displays make it a nuisance to rural villages, often keeping everyone awake. However, a basan that wanders into a settlement can be more than just a nuisance, especially when the startled creature sets nearby homes ablaze!"
            ^"Rings" DEF {
                ^"Air" INTEGER 2
                ^"Earth" INTEGER 2
                ^"Fire" INTEGER 4
                ^"Water" INTEGER 2
                ^"Void" INTEGER 2
            }
            ^"Endurance" INTEGER 10
            ^"Composure" INTEGER 8
            ^"Focus" INTEGER 4
            ^"Vigilance" INTEGER 3
            ^"Silhouette" INTEGER 0
            ^"Demeanor" STRING "Flighty"
            ^"Skills" LIST OF STRING ["Artisan 1", "Martial 2", "Scholar 0", "Social 0", "Trade 1"]
            ^"Advantages" LIST OF STRING ["Camouflaging Feathers: Artisan; Physical"]
            ^"Disadvantages" LIST OF STRING ["Easily Frightened: Martial; Mental"]
            ^"Favored Weapons" LIST OF STRING ["Clawed talon: Range 0-1, Damage 3, Deadliness 5, Razor-Edged"]
        }
        RULES {
            #L5RPW71gL9mA5mF7fO5zT8fX6pC: basan_otherworldly "Chikushōdō Native: Basan are silhouette 0 Otherworldly creatures."
            #L5RPW71lO9pI2mA5yW7cD5aE3qC: basan_breathes_flame "Breathes Flame: When making a successful Attack action check, the basan may spend (op) in the following way:\n\n(op): The target suffers the Burning condition."
        }
    }

    # source stat block (page 247)
    #pAmpNItjIg7Mc92MLVskS7 ^"Isonade" DEF {
        EXTENDS #t4540de6f35155c46f41f0 ^"NPC"
        PROPERTIES {
            ^"Type" STRING "Adversary" FIXED
            ^"Category" STRING "Spirit"
            ^"Combat Conflict Rank" INTEGER 8
            ^"Intrigue Conflict Rank" INTEGER 1
            ^"Description" STRING "The isonade is a feared creature throughout the Islands of Spice and Silk, often blamed for the loss of fishing boats. Isonade are monstrous sharks with barbed tails and hooked catfish whiskers. When they travel near the surface of the ocean, they cause stormy winds to appear, and they are said to capsize boats with their powerful tails."
            ^"Rings" DEF {
                ^"Air" INTEGER 1
                ^"Earth" INTEGER 4
                ^"Fire" INTEGER 5
                ^"Water" INTEGER 6
                ^"Void" INTEGER 1
            }
            ^"Endurance" INTEGER 18
            ^"Composure" INTEGER 14
            ^"Focus" INTEGER 3
            ^"Vigilance" INTEGER 2
            ^"Silhouette" INTEGER 5
            ^"Demeanor" STRING "Aggressive"
            ^"Skills" LIST OF STRING ["Artisan 0", "Martial 4", "Scholar 0", "Social 0", "Trade 0"]
            ^"Advantages" LIST OF STRING ["Accompanied by Storms: Martial; Physical", "Keen Sense of Smell: Trade; Physical", "Terrible Strength: Martial; Physical"]
            ^"Disadvantages" LIST OF STRING ["Hot-Tempered: Martial; Mental", "Weak Spot (Nose): Martial; Physical"]
            ^"Favored Weapons" LIST OF STRING ["Razor Teeth: Range 0, Damage 7, Deadliness 9, Razor-Edged", "Barbed Tail: Range 2, Damage 10, Deadliness 5, Razor-Edged"]
            ^"Gear" LIST OF STRING ["Thick hide (Physical 4)"]
        }
        RULES {
            #L5RPW71cP1rM8uH5yL6hV2tP2uN: isonade_aquatic "Aquatic Monster: The isonade is an Otherworldly creature of silhouette 5 that can move through the water without requiring checks."
            #L5RPW71rA5fI6cW7hI7pP7kE0sT: isonade_blood "Blood Frenzy: When a wound bleeds into nearby waters, the isonade becomes Enraged. While Enraged, it cannot suffer the Unconscious condition, and may perform Attack actions even while Incapacitated."
        }
    }

    # source stat block (page 247)
    #BuHeNamx2kHUw95sd5rffQ ^"Mischievous Kappa" DEF {
        EXTENDS #t4540de6f35155c46f41f0 ^"NPC"
        PROPERTIES {
            ^"Type" STRING "Adversary" FIXED
            ^"Category" STRING "Spirit"
            ^"Combat Conflict Rank" INTEGER 2
            ^"Intrigue Conflict Rank" INTEGER 3
            ^"Description" STRING "Hailing from Sakkaku, the Realm of Trickster Spirits, the kappa resembles a child-sized turtle with a smooth shell, webbed hands and feet, and a small bowl-shaped indentation on the top of its head, in which water is always contained. Kappa live in lakes and ponds and sustain themselves with blood, often attempting to trick wanderers into drowning so they can feast. The water in the bowl-shaped indentation of the kappa's head contains its life energy, so if it is spilled, the kappa becomes weak and desperate. Some say that you can trick a kappa by bowing to it, in hopes that its good manners may take over and it will bow back!"
            ^"Rings" DEF {
                ^"Air" INTEGER 4
                ^"Earth" INTEGER 2
                ^"Fire" INTEGER 2
                ^"Water" INTEGER 3
                ^"Void" INTEGER 1
            }
            ^"Endurance" INTEGER 8
            ^"Composure" INTEGER 10
            ^"Focus" INTEGER 4
            ^"Vigilance" INTEGER 3
            ^"Silhouette" INTEGER 1
            ^"Demeanor" STRING "Shrewd"
            ^"Skills" LIST OF STRING ["Artisan 0", "Martial 1", "Scholar 0", "Social 3", "Trade 2"]
            ^"Advantages" LIST OF STRING ["Excellent Swimmer: Martial; Physical", "Lightning Reflexes: Martial; Physical"]
            ^"Disadvantages" LIST OF STRING ["Deferential: Social; Interpersonal, Mental", "Weak Spot (Water in Head): Martial; Physical"]
            ^"Favored Weapons" LIST OF STRING ["Razor Claws: Range 0, Damage 4, Deadliness 6, Razor-Edged"]
            ^"Gear" LIST OF STRING ["Turtle shell (Physical 4)"]
        }
        RULES {
            #L5RPW71cO2iN1nW5hN4pO0kC5tG: kappa_aquatic "Aquatic Spirit: The kappa is an Otherworldly creature of silhouette 1 that can move through the water without requiring checks."
            #L5RPW71fZ3jY7kR9yA4dL0gH6rY: kappa_games "Lover of Games: A character may make a TN 4 Games check (Air 5, Fire 2) to challenge the kappa to a game of riddles. If a character succeeds, the kappa offers that character a small favor (such as distracting an enemy or giving the character an item the kappa has). If the character fails, they suffer 3 strife."
        }
    }

    # source stat block (page 249)
    #uajbxXMaGxnBDMG5ARgzds ^"Tiny Manifest Air Kami" DEF {
        EXTENDS #t4540de6f35155c46f41f0 ^"NPC"
        PROPERTIES {
            ^"Type" STRING "Adversary" FIXED
            ^"Category" STRING "Kami"
            ^"Combat Conflict Rank" INTEGER 5
            ^"Intrigue Conflict Rank" INTEGER 3
            ^"Description" STRING "Often found in areas known for gentle zephyrs, tiny air kami usually manifest themselves as small whirlwinds, lashing out at any who get too close. These spirits are often angered by smoke and other pollutants filling the air, and can be a painful surprise to any who disrespect them."
            ^"Rings" DEF {
                ^"Air" INTEGER 5
                ^"Earth" INTEGER 1
                ^"Fire" INTEGER 1
                ^"Water" INTEGER 2
                ^"Void" INTEGER 1
            }
            ^"Endurance" INTEGER 7
            ^"Composure" INTEGER 4
            ^"Focus" INTEGER 2
            ^"Vigilance" INTEGER 2
            ^"Demeanor" STRING "Flighty"
            ^"Skills" LIST OF STRING ["Artisan 2", "Martial 2", "Scholar 0", "Social 2", "Trade 2"]
            ^"Advantages" LIST OF STRING ["Ethereal Form: Martial, Trade; Physical"]
            ^"Disadvantages" LIST OF STRING ["Easily Distracted: Scholar, Social; Mental"]
            ^"Favored Weapons" LIST OF STRING ["Slicing Winds: Range 0–2, Damage 3, Deadliness 7, deals supernatural damage"]
            ^"Gear" LIST OF STRING ["Cloak of Air (Physical 3, Supernatural 2)"]
        }
        RULES {
            #L5RPW71wG3bF9iP1eQ3vU8lB2oB: air_kami_flight "Flight: A tiny manifest air kami can move vertically and ignores the negative effects of terrain."
            #L5RPW71iF2cX9zH1mG3hY9lX5rQ: air_kami_spirit "Tiny Living Air Spirit: A tiny manifest air kami is an Otherworldly being of silhouette 0, 1, or 2, and may change its size as an action. Additionally, whenever a character deals damage to the kami, that character suffers half as much strife (rounded down)."
            #L5RPW71vK7gO5tS5rZ9pL8jU0qO: air_kami_gale "Buffeting Gale: When performing an Attack action check, a tiny manifest air kami may spend (op) as follows:\n\n(op): The target must resist a TN 4 Fitness check (Air 6, Fire 2) or suffer the Prone condition.\n\n(op)+: The tiny manifest air kami may move 1 range band per (op) spent this way."
        }
    }

    # source stat block (page 250)
    #bdf4H6TXevNXgi6tHxM3jP ^"Tiny Manifest Earth Kami" DEF {
        EXTENDS #t4540de6f35155c46f41f0 ^"NPC"
        PROPERTIES {
            ^"Type" STRING "Adversary" FIXED
            ^"Category" STRING "Kami"
            ^"Combat Conflict Rank" INTEGER 5
            ^"Intrigue Conflict Rank" INTEGER 1
            ^"Description" STRING "Generally, tiny manifest earth kami make their homes in particularly notable rocks, in fertile patches of earth, or on the banks of rivers or the sea. The are drawn to action when people mistreat nature or disturb the resting place of old earth."
            ^"Rings" DEF {
                ^"Air" INTEGER 2
                ^"Earth" INTEGER 5
                ^"Fire" INTEGER 1
                ^"Water" INTEGER 2
                ^"Void" INTEGER 1
            }
            ^"Endurance" INTEGER 10
            ^"Composure" INTEGER 6
            ^"Focus" INTEGER 2
            ^"Vigilance" INTEGER 1
            ^"Silhouette" INTEGER 1
