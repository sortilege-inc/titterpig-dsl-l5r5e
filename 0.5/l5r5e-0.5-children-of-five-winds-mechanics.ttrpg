        }

        SCHOOL_ABILITY "Methodical Observation" {
            "Once per scene when you make a Scholar skill check, you may reserve a number of dropped dice up to your school rank. Until the end of the scene, when you make a non-Scholar skill check, after choosing dice, you may add up to one of these reserved dice as a kept die."
        }

        MASTERY_ABILITY ^"Logical Conclusion" {
            "Once per game session when making a non-Scholar skill check, instead of rolling a number of skill dice equal to your ranks in the skill used on the check, you may roll a number of skill dice equal to one of your Scholar skills of your choice."
        }
        STARTING_OUTFIT [
            "traveling clothes", "ceremonial clothes",
            "one weapon of rarity 6 or lower", "knife",
            "calligraphy set", "traveling pack", "numerous books"
        ]

        CURRICULUM {
            RANK 1 {
                SKILL_GROUP "Scholar Skills"
