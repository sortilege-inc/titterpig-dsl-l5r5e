            }
            ^"Starting Skills" DEF { CHOOSE 5 [^"Command", ^"Courtesy", ^"Martial Arts [Ranged]", ^"Medicine", ^"Meditation", ^"Performance", ^"Survival"] INTEGER 1 }
            ^"Starting Honor" INTEGER DEFAULT 40
            ^"Techniques Available" LIST ["Kata", "Rituals", "Shūji"]
        }

        STARTING_TECHNIQUES {
            RITUAL ^"Commune with the Spirits"
            SHUJI CHOOSE 1 [#9GbhR8jUu9LFAswOnG7qm1 ^"Appreciate the Scenery", ^"Shallow Waters"]
        }

        SCHOOL_ABILITY "Calm Counsel" {
            "After a friendly character at range 0–4 receives strife, you may impose the Centered condition on that character (see page 133). You can use this school ability a number of times per scene up to your school rank."
        }

        MASTERY_ABILITY ^"Cool Heads Prevail" {
            "Friendly Centered characters at range 0-4 from you treat their composure and endurance as increased by your ranks in Courtesy."
        }
        STARTING_OUTFIT [
            "sanctified robes", "wakizashi (short sword)",
            "knife", "yumi (bow)", "quiver of arrows",
            "calligraphy set", "scroll satchel",
            "traveling pack", "bottle of sake",
            "sweets (four servings)"
        ]

        CURRICULUM {
            RANK 1 {
                SKILL_GROUP "Social Skills"
                SKILL "Aesthetics"
                SKILL "Survival"
                SKILL "Theology"
                TECHNIQUE_GROUP "Rank 1 Water Shūji"
                ^"Spiritual Survey" [ritual]
                ^"Threshold Barrier" [ritual]
            }
            RANK 2 {
                SKILL_GROUP "Scholar Skills"
                SKILL "Courtesy"
                SKILL "Fitness"
                SKILL "Meditation"
                TECHNIQUE_GROUP "Rank 1-2 Rituals"
                ^"Complementary Experience" [shuji]
                #yAc4vdUfB5o54gWHBJUqFZ ^"Solidify Gratitude" [shuji]
            }
            RANK 3 {
                SKILL_GROUP "Social Skills"
                SKILL "Culture"
                SKILL "Government"
                SKILL "Sentiment"
                TECHNIQUE_GROUP "Rank 1-3 Earth Shūji"
                ^"Pillar of Calm" [shuji]
                #OnIk5kQH4WLN5QibiTeri2 ^"Swaying Grass Evasion" [kata]
            }
            RANK 4 {
                SKILL_GROUP "Scholar Skills"
                SKILL "Command"
                SKILL "Fitness"
                SKILL "Tactics"
                TECHNIQUE_GROUP "Rank 1-4 Rituals"
                ^"Nature's Touch" [invocation]
                ^"A Samurai's Fate" [shuji]
            }
            RANK 5 {
                SKILL_GROUP "Social Skills"
                SKILL "Aesthetics"
                SKILL "Survival"
                SKILL "Theology"
                TECHNIQUE_GROUP "Rank 1-5 Void Shūji"
                ^"By the Light of the Lord Moon" [invocation]
                ^"Bend with the Storm" [shuji]
            }
            RANK 6 {
                ^"Cool Heads Prevail"
            }
        }

        RULES {
            #cJq3BL78rUX6WJbeEdvAcT: kitsune_mediator_school "Kitsune Mediator School: The Fox Clan's lands are highly spiritually active; as a result, many of its members deal with spirits and supernatural beings far more often than the average samurai does. While the clan has a shugenja tradition, when one lives deep within a primordial forest, one must sometimes parley with spirits and other strange creatures just to survive. Having learned about such negotiations for generations, some members of the Fox Clan made it their personal mission to mediate in spiritual conflicts both within the Kitsune Forest and across Rokugan at large. Eventually, those efforts became more formalized with the foundation of the Kitsune Mediator School.\n\nThe Kitsune Mediators are often sent to places in Rokugan experiencing supernatural strife. While their assignments from the Fox Clan Champion are often to mediate between aggrieved human parties, their true goal is to determine if the problem is spiritual in nature and, if so, to help the human and supernatural inhabitants of the region reach a new accord that accommodates both. Though they are not fully initiated into the mysteries of the Fox Clan's shugenja tradition, Kitsune Mediators frequently work alongside them, helping to ease tensions on the human side and even undertaking rituals to appease angered spirits more directly when necessary. In recent days, however, the Kitsune Mediators have found themselves overwhelmed with disharmonies to pursue across Rokugan…"
        }
    }

