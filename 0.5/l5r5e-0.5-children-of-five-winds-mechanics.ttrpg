EXTENSION "L5R5e_Children_of_Five_Winds" EXTENDS "L5R5e_Core_Character" {
    NAME "Legend of the Five Rings 5th Edition - Children of the Five Winds: New Player Options"
    VERSION "0.5.3"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-03-01"

    # Children of the Five Winds (Chapters 2 and 3): Fox Minor Clan, Kitsune family,
    # new schools, advantages, disadvantages, heritages, weapons, armor,
    # personal effects, blessed treasures, meishōdō talismans, item patterns,
    # techniques (kata, rituals, shūji, invocation), titles, conditions, demeanor.

    # ===========================
    # FOX MINOR CLAN
    # ===========================

    # source stat block (page 82)
    #A5BCLpxm7QKQoXee3Drj27 ^"Fox Minor Clan" DEF {
        EXTENDS #L5R250aB2cD4eF6gH8iJ0k ^"Clan"
        APPLIES TO [#L5R003xY4zA6bC8dE0fG2hI ^"Samurai"]

        PROPERTIES {
            ^"Clan Name" STRING "Fox" FIXED
            ^"Clan Type" STRING "Minor Clan"
            ^"Clan Ring Bonus" DEF { ^"Earth" INTEGER 1 }
            ^"Clan Skill Bonus" DEF { ^"Survival" INTEGER 1 }
            ^"Clan Status" INTEGER DEFAULT 30
        }

        FAMILIES {
            ^"Kitsune"
        }

        RULES {
            #L5RCW01aB2cD4eF6gH8iJ0: fox_minor_clan "The Fox Minor Clan: The Fox consider themselves to be representatives of nature and advocates for Senkyō. With literal fox spirits in their bloodline, the Fox commune with nature and bargain with forest spirits to maintain harmony between humans and animals. For most of their history, the Fox have remained distant observers of the Empire's affairs from their keep in the Kitsune Forest. But after centuries of isolation, they are now considering becoming more involved in the Empire's politics, if only to protect what remains of that forest's natural beauty."
        }
    }

    # ===========================
    # FOX FAMILIES
    # ===========================

    #L5RCW40lM3nO5pQ7rS9tU1v ^"Kitsune" DEF {
        EXTENDS #L5R251lM3nO5pQ7rS9tU1v ^"Family"
        APPLIES TO [#L5R003xY4zA6bC8dE0fG2hI ^"Samurai"]

        PROPERTIES {
            ^"Family Name"     STRING "Kitsune" FIXED
            ^"Clan"            STRING "Fox"
            ^"Ring Increase" DEF { CHOOSE 1 [^"Air", ^"Water"] INTEGER 1 }
            ^"Skill Increases" DEF {
                ^"Fitness" INTEGER 1
                ^"Theology" INTEGER 1
            }
            ^"Glory"           INTEGER 40
            ^"Wealth" DEF { ^"Count" INTEGER 2  ^"Type" STRING "koku"  ^"Starting" BOOLEAN true }
        }
    }

    # ===========================
    # NEW SCHOOLS
    # ===========================

    # source stat block (page 83)
    #2ioTt8IaqyLnVjZhBuehQ9 ^"Ganzu Guardian Tradition" DEF {
        EXTENDS #L5R252wX4yZ6aB8cD0eF2g ^"School"
        APPLIES TO [#L5R003xY4zA6bC8dE0fG2hI ^"Samurai"]

        PROPERTIES {
            ^"School Name" STRING "Ganzu Guardian Tradition" FIXED
            ^"Roles" LIST ["Bushi"]
            ^"Ring Increase" DEF {
                ^"Earth" INTEGER 1
                ^"Water" INTEGER 1
            }
            ^"Starting Skills" DEF { CHOOSE 5 [^"Command", ^"Fitness", ^"Labor", ^"Martial Arts [Melee]", ^"Medicine", ^"Sentiment", ^"Tactics"] INTEGER 1 }
            ^"Starting Honor" INTEGER DEFAULT 45
            ^"Techniques Available" LIST ["Kata", "Rituals", "Shūji"]
        }

        STARTING_TECHNIQUES {
            KATA #0rlsYqqzYRaFjQFPLbnasp ^"Slashing Sandstorm Style"
            SHUJI CHOOSE 1 [^"Honest Assessment", ^"Shallow Waters"]
        }

        SCHOOL_ABILITY "Moment of Certainty" {
            "Once per scene after you defend against damage, you may roll a number of skill dice equal to the fatigue you received this way. Choose a number of those dice up to your school rank and reserve them. Until the end of the scene, when you perform an Attack action check, after choosing kept dice, you may add one of the dice you reserved this way as an additional kept die."
        }

        MASTERY_ABILITY ^"Measured Force" {
            "When you use your school ability to add kept dice to a check, you may add a number of your reserved dice up to your ranks in Fitness (instead of only one)."
        }
        STARTING_OUTFIT [
            "traveling clothes", "concealed armor",
            "Ganzu ring ax", "two knives",
            "traveling rations (eight days)"
        ]

        CURRICULUM {
            RANK 1 {
                SKILL_GROUP "Martial Skills"
                SKILL "Command"
                SKILL "Survival"
                SKILL "Theology"
                TECHNIQUE_GROUP "Rank 1 Water Shūji"
                ^"Distracting Flurry Style" [kata]
                ^"Soaring Slice" [kata]
            }
            RANK 2 {
                SKILL_GROUP "Social Skills"
                SKILL "Fitness"
                SKILL "Martial Arts [Melee]"
                SKILL "Theology"
                TECHNIQUE_GROUP "Rank 1-2 Kata"
                ^"Scouring Wind Style" [kata]
                ^"Feigned Opening" [shuji]
            }
            RANK 3 {
                SKILL_GROUP "Trade Skills"
                SKILL "Fitness"
                SKILL "Martial Arts [Melee]"
                SKILL "Tactics"
                TECHNIQUE_GROUP "Rank 1-3 Earth Shūji"
                ^"Thunderbolt Style" [kata]
                #lu8CfRSeV4kwwp4747R1sd ^"Center the World" [ritual]
            }
            RANK 4 {
                SKILL_GROUP "Martial Skills"
                SKILL "Command"
                SKILL "Survival"
                SKILL "Theology"
                TECHNIQUE_GROUP "Rank 1-4 Kata"
                ^"Rouse the Soul" [shuji]
                ^"Regal Bearing" [shuji]
            }
            RANK 5 {
                SKILL_GROUP "Scholar Skills"
                SKILL "Command"
                SKILL "Martial Arts [Melee]"
                SKILL "Survival"
                TECHNIQUE_GROUP "Rank 1-5 Water Shūji"
                ^"The Immovable Hand of Peace" [shuji]
                ^"Striking as Void" [kata]
            }
            RANK 6 {
                ^"Measured Force"
            }
        }

        RULES {
            #GqjaLqv44ttbDiExheEHPl: ganzu_guardian_tradition "Ganzu Guardian Tradition: The Ganzu people who reside in the Hidden Valley are in some ways the sixth great family of the Unicorn Clan, despite being little known within Rokugan's bounds. Their lands occupy a key oasis along the Sand Road, making the Ganzu a crucial vassal of the Unicorn, and their warriors often serve as part of Unicorn cohorts, especially outside of Rokugan. Given the value of their oasis, they have long had to protect it from outside powers. Their battle traditions are suited to the terrain where they most often fight: the searing deserts near their homeland, where the heat can be more lethal than the enemy, and a lack of preparation deadlier than a sword. As such, the Ganzu teach their warriors to fight with precision, wasting little effort and letting the foe exhaust themself before striking the decisive blow. Their martial styles favor a variety of weapons, but many Ganzu warriors specialize in the ax or the sword."
        }
    }

    # source stat block (page 84)
    #6qaCd0KLgdLpsUMc50YILW ^"Ide Emissary" DEF {
        EXTENDS #L5R252wX4yZ6aB8cD0eF2g ^"School"
        APPLIES TO [#L5R003xY4zA6bC8dE0fG2hI ^"Samurai"]

        PROPERTIES {
            ^"School Name" STRING "Ide Emissary" FIXED
            ^"Clan" STRING "Unicorn"
            ^"Roles" LIST ["Courtier", "Bushi"]
            ^"Ring Increase" DEF {
                ^"Fire" INTEGER 1
                ^"Water" INTEGER 1
            }
            ^"Starting Skills" DEF { CHOOSE 5 [^"Courtesy", ^"Culture", ^"Games", ^"Government", ^"Martial Arts [Unarmed]", ^"Sentiment", ^"Survival"] INTEGER 1 }
            ^"Starting Honor" INTEGER DEFAULT 50
            ^"Techniques Available" LIST ["Kata", "Rituals", "Shūji"]
        }

        STARTING_TECHNIQUES {
            SHUJI #0r8GIosRzsUAzWwWgwKv9P ^"Glorious Entrance"
            SHUJI CHOOSE 1 [^"Stirring the Embers", ^"Well of Desire"]
        }

        SCHOOL_ABILITY "Disarming Demeanor" {
            "When you perform a Support action check, you may spend (op) as follows:\n\n(op)+: Choose one character in the scene with vigilance lower than your school ranks plus (op) spent this way. You treat that character's focus and vigilance each as 1 lower until the end of the scene."
        }

        MASTERY_ABILITY ^"Student of Many Courts" {
            "One per scene as a Support action, you may make a TN 3 Culture (Fire or Water) check targeting any number of other characters in the scene. If you succeed and you chose Fire, each character gains the Emboldened condition (see page 133). If you succeed and you chose Water, each character removes 3 strife."
        }
        STARTING_OUTFIT [
            "ceremonial clothes", "traveling clothes",
            "wakizashi (short sword) or scimitar", "knife",
            "journal", "calligraphy set",
            "Ide traveling pony"
        ]

        CURRICULUM {
            RANK 1 {
                SKILL_GROUP "Social Skills"
                SKILL "Culture"
                SKILL "Sentiment"
                SKILL "Survival"
                TECHNIQUE_GROUP "Rank 1 Earth Shūji"
                ^"Open-Hand Style" [kata]
                #AWfbgJPwJnfqejeLi6EWT9 ^"Cultural Exchange" [ritual]
            }
            RANK 2 {
                SKILL_GROUP "Social Skills"
                SKILL "Fitness"
                SKILL "Government"
                SKILL "Martial Arts [Unarmed]"
                TECHNIQUE_GROUP "Rank 1-2 Fire Shūji"
                ^"Entice with Offerings" [shuji]
                #yAc4vdUfB5o54gWHBJUqFZ ^"Solidify Gratitude" [shuji]
            }
            RANK 3 {
                SKILL_GROUP "Trade Skills"
                SKILL "Command"
                SKILL "Meditation"
                SKILL "Tactics"
                TECHNIQUE_GROUP "Rank 1-3 Water Shūji"
                ^"Everyone Has a Price" [shuji]
                #Gx7UqC11aieXBQu6Prr3Af ^"Incite Wrath" [shuji]
            }
            RANK 4 {
                SKILL_GROUP "Social Skills"
                SKILL "Aesthetics"
                SKILL "Design"
                SKILL "Composition"
                TECHNIQUE_GROUP "Rank 1-4 Fire Shūji"
                ^"Sear the Wound" [shuji]
                ^"Crashing Wave Style" [kata]
            }
            RANK 5 {
                SKILL_GROUP "Trade Skills"
                SKILL "Command"
                SKILL "Games"
                SKILL "Tactics"
                TECHNIQUE_GROUP "Rank 1-5 Earth Shūji"
                ^"Rouse the Soul" [shuji]
                ^"Striking as Void" [kata]
            }
            RANK 6 {
                ^"Student of Many Courts"
            }
        }

        RULES {
            #nKr66inH8JDc8kVhmPQfM8: ide_emissary_school "Ide Emissary School: The Ide family of the Unicorn Clan specializes in retaining relationships through trade and good will. And while the family's traders amass fortunes in foreign markets, the family's emissaries use that wealth to further the interests of the Unicorn Clan. Ide Emissaries are expected to learn the customs, protocols, and styles of any court they visit, whether in the castle of a Rokugani lord, in the ordu of an influential Ujik leader, or in one of the spires of academia in the Qamarist Caliphate. Not only must they find common ground with people of widely different cultures, but they must insinuate themselves into courts where power dynamics and alliances have existed for centuries or millennia, and each group looks at any new player as both a risk and an opportunity. This requires a great deal of education; most Ide Emissaries study alongside mentors who have served in far-flung lands for years before being chosen for a major assignment."
        }
    }

    # source stat block (page 85)
    #7fNtJE0SKUinF8sPhRzL6y ^"Iuchi Horse Lord Disciple" DEF {
        EXTENDS #L5R252wX4yZ6aB8cD0eF2g ^"School"
        APPLIES TO [#L5R003xY4zA6bC8dE0fG2hI ^"Samurai"]

        PROPERTIES {
            ^"School Name" STRING "Iuchi Horse Lord Disciple" FIXED
            ^"Clan" STRING "Unicorn"
            ^"Roles" LIST ["Shugenja", "Artisan"]
            ^"Ring Increase" DEF {
                ^"Air" INTEGER 1
                ^"Water" INTEGER 1
            }
            ^"Starting Skills" DEF { CHOOSE 3 [^"Commerce", ^"Design", ^"Medicine", ^"Sentiment", ^"Survival", ^"Theology"] INTEGER 1 }
            ^"Starting Honor" INTEGER DEFAULT 40
            ^"Techniques Available" LIST ["Invocations", "Rituals", "Shūji"]
        }

        STARTING_TECHNIQUES {
            INVOCATION CHOOSE 1 [#B9pfUnHT2rh8zLrTumaGKp ^"Jurojin's Balm", ^"Nature's Touch", ^"Path to Inner Peace"]
            RITUAL ^"Commune with the Spirits"
            RITUAL #8guERejPqFVqW8CzwWbiWT ^"Protection of the Flock"
            SHUJI CHOOSE 1 [#FI4nQQ3pXWkloDjbYP6e6w ^"Call to Ride", ^"Shallow Waters"]
        }

        SCHOOL_ABILITY "The Horse Lord's Favor" {
            "When you make a check to craft, improve, or maintain an item, you may imprint it with the Horse Lord's Favor, giving it one of your advantages or disadvantages. If the item is a meishōdō talisman, you may instead give the item an advantage or disadvantage from its sealed spirit. While an item with your Horse Lord's Favor adorns a horse or a creature with the Loyal Steed ability, the horse or creature is Otherworldly and possesses the chosen advantage or disadvantage. If the item is a meishōdō talisman, the horse or creature may perform any techniques it contains. You can sustain a number of items with your Horse Lord's Favor up to your school rank. Additionally, when you perform a Medicine check to remove fatigue or a condition from a horse or other equine creature, add bonus successes equal to your school rank."
        }

        MASTERY_ABILITY ^"The Noble Heart Shines Through" {
            "Once per scene, you may spend 1 Void point to target any non-Shadowlands creature of silhouette 3 or greater, giving the target the Loyal Steed ability—it can be ridden by a human-sized (silhouette 2 or lower) rider—until the end of the scene. When you do, you may make a Courtesy (Water) or Theology (Void) check with a TN equal to the target's vigilance. If you succeed on the check, the target is favorable toward you and willing to be ridden. Horses of the Blessed Herd—the Utaku steeds—are immune to this mastery ability."
        }
        STARTING_OUTFIT [
            "sanctified robes", "traveling clothes",
            "yumi (bow)", "quiver of arrows",
            "wakizashi (short sword)",
            "two meishōdō talismans each containing a Rank 1 invocation",
            "traveling pack", "Iuchi riding steed"
        ]

        CURRICULUM {
            RANK 1 {
                SKILL_GROUP "Scholar Skills"
                SKILL "Courtesy"
                SKILL "Design"
                SKILL "Survival"
                TECHNIQUE_GROUP "Rank 1 Water Invocations"
                ^"Divination" [ritual]
                ^"Sympathetic Energies" [invocation]
            }
            RANK 2 {
                SKILL_GROUP "Artisan Skills"
                SKILL "Commerce"
                SKILL "Medicine"
                SKILL "Theology"
                TECHNIQUE_GROUP "Rank 1-2 Rituals"
                ^"Artisan's Appraisal" [shuji]
                ^"Call Upon the Wind" [invocation]
            }
            RANK 3 {
                SKILL_GROUP "Martial Skills"
                SKILL "Design"
                SKILL "Medicine"
                SKILL "Theology"
                TECHNIQUE_GROUP "Rank 1-3 Air Invocations"
                ^"Horse Whisperer" [shuji]
                #rpxI0yV728lhVlPfVAuEcQ ^"Shadow of Days" [ritual]
            }
            RANK 4 {
                SKILL_GROUP "Social Skills"
                SKILL "Medicine"
                SKILL "Survival"
                SKILL "Theology"
                TECHNIQUE_GROUP "Rank 1-4 Earth Invocations"
                ^"Regal Bearing" [shuji]
                ^"Ride the Water Dragon" [kiho]
            }
            RANK 5 {
                SKILL_GROUP "Artisan Skills"
                SKILL "Command"
                SKILL "Survival"
                SKILL "Theology"
                TECHNIQUE_GROUP "Rank 1-5 Water Invocations"
                ^"Buoyant Arrival" [shuji]
                ^"Rouse the Soul" [shuji]
            }
            RANK 6 {
                ^"The Noble Heart Shines Through"
            }
        }

        RULES {
            #UCvKhD440n98DALOoR0JxN: iuchi_horse_lord_disciple "Iuchi Horse Lord Disciple: The Iuchi's Horse Lord Disciples are followers of an ancient tradition, one established by the eldest child of Iuchi himself. As they are Rokugan's foremost experts in equine medicine, their services are highly sought throughout the Empire. Yet few know that they are specialized Meishōdō Masters, invoking equestrian spirits like ki-rin and the Fortune of Horses. Their unique meishōdō talismans are meant to adorn not samurai but their mounts, empowering horses with special abilities and spiritual power."
        }
    }

    #6r0QKpvr1rssdJAzNf44Cb ^"Kitsune Mediator" DEF {
