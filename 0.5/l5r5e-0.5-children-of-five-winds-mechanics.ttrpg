                SKILL "Government"
                SKILL "Medicine"
                SKILL "Theology"
                TECHNIQUE_GROUP "Rank 1-4 Air and Water Shūji"
                ^"Sear the Wound" [shuji]
                ^"Pillar of Calm" [shuji]
            }
            RANK 5 {
                SKILL_GROUP "Scholar Skills"
                SKILL "Aesthetics"
                SKILL "Command"
                SKILL "Composition"
                TECHNIQUE_GROUP "Rank 1-5 Rituals"
                TECHNIQUE_GROUP "Rank 1-5 Void Shūji"
                ^"Buoyant Arrival" [shuji]
            }
            RANK 6 {
                ^"Logical Conclusion"
            }
        }

        RULES {
            #gcOZ8b7c4k5yAqYijJQyNz: scholar_of_al_zawira_tradition "Scholar of al-Zawira Tradition: In the city of al-Zawira, at the heart of the Cradle of the World, the Qamarist Caliphate's scholars push the bounds of knowledge in new and fascinating directions. Academics here ensconce themselves in deep studies of many fields, from human anatomy to philosophy, mathematics to alchemy, and theology to astronomy. Additionally, the massive scope of the Caliphate gives scholars access to knowledge from all corners of a vast domain. Between the libraries of the caliph and the archives of individual scholars, there is a near unparalleled amount of knowledge in al-Zawira, at least within the Mortal Realm. This makes the scholars of the so-called City of Books especially sought after as researchers, advisors, and counselors in many courts, from the Ivory Kingdoms to the lands beyond the Great Northern Mountains."
        }
    }

    # source stat block (page 90)
    #BnUtFOKLFjw5R3IFD1adjP ^"Shinjo Mounted Archer" DEF {
