        PROPERTIES {
            ^"School Name" STRING "Sand Road Wayfinder Tradition" FIXED
            ^"Roles" LIST ["Bushi", "Shinobi"]
            ^"Ring Increase" DEF {
                ^"Earth" INTEGER 1
                CHOOSE 1 [^"Air", ^"Fire", ^"Water", ^"Void"] INTEGER 1
            }
            ^"Starting Skills" DEF { CHOOSE 5 [^"Command", ^"Commerce", ^"Labor", ^"Fitness", ^"Martial Arts [Melee]", ^"Martial Arts [Ranged]", ^"Survival"] INTEGER 1 }
            ^"Starting Honor" INTEGER DEFAULT 35
            ^"Techniques Available" LIST ["Kata", "Rituals", "Shūji"]
        }

        STARTING_TECHNIQUES {
            KATA CHOOSE 1 [^"Striking as Air", ^"Striking as Earth", ^"Striking as Fire", ^"Striking as Water"]
            RITUAL CHOOSE 1 [#WZ8xKYctQhHBGSb08Sejh5 ^"Traveler's Experience", #viIXOBa8oCx1CTcZ6kqI4p ^"Wayfinder's Instincts"]
        }

        SCHOOL_ABILITY "Dunestrider" {
            "At the start of each scene, choose one of the following terrain qualities: Dangerous, Entangling, Imbalanced, or Obscuring. Each friendly character within a number of range bands equal to your school rank ignores the negative effects of that terrain quality."
        }

        MASTERY_ABILITY ^"Lay of the Land" {
            "Once per game session as a Support action or during a narrative scene, you may change which terrain quality your school ability affects. While you are in terrain with the quality chosen for your school ability, you may add up to two bonus successes to each check you make."
        }
        STARTING_OUTFIT [
            "traveling clothes", "one weapon of rarity 7 or lower",
            "two knives", "traveling rations (eight days)",
            "traveling pack", "tent (small)"
        ]

        CURRICULUM {
            RANK 1 {
                SKILL_GROUP "Trade Skills"
                SKILL "Command"
                SKILL "Martial Arts [Melee]"
                SKILL "Martial Arts [Ranged]"
                TECHNIQUE_GROUP "Rank 1 Kata"
                ^"Distracting Flurry Style" [kata]
                #AWfbgJPwJnfqejeLi6EWT9 ^"Cultural Exchange" [ritual]
            }
            RANK 2 {
                SKILL_GROUP "Martial Skills"
                SKILL "Command"
                SKILL "Medicine"
                SKILL "Survival"
                TECHNIQUE_GROUP "Rank 1-2 Kata"
                ^"Center the World" [ritual]
                ^"Touchstone of Courage" [shuji]
            }
            RANK 3 {
                SKILL_GROUP "Social Skills"
                SKILL "Skulduggery"
                SKILL "Survival"
                SKILL "Tactics"
                TECHNIQUE_GROUP "Rank 1-3 Earth Shūji"
                ^"Iron in the Mountains Style" [kata]
                ^"Skulk" [ninjutsu]
            }
            RANK 4 {
                SKILL_GROUP "Scholar Skills"
                SKILL "Meditation"
                SKILL "Medicine"
                SKILL "Survival"
                TECHNIQUE_GROUP "Rank 1-4 Kata"
                ^"Noxious Cloud" [ninjutsu]
                ^"Breath of Wind Style" [kata]
            }
            RANK 5 {
                SKILL_GROUP "Trade Skills"
                SKILL "Command"
                SKILL "Martial Arts [Melee]"
                SKILL "Martial Arts [Ranged]"
                TECHNIQUE_GROUP "Rank 1-5 Kata"
                ^"Silencing Stroke" [ninjutsu]
                ^"Rouse the Soul" [shuji]
            }
            RANK 6 {
                ^"Lay of the Land"
            }
        }

        RULES {
            #Bo49JgcydBbtAIyRpfdor4: sand_road_wayfinder_tradition "Sand Road Wayfinder Tradition: The Sand Road is a dangerous place that spans a vast distance, sweeping across numerous regions and biomes. From the foothills of the Pillar of the Sky mountains to the sands around the Hidden Valley, each region has unique threats based on its terrain. As such, while the Unicorn Clan has worked hard to build trade routes across these areas, any trip can still have its perils, and there is no substitute for a regional guide. Most of the Sand Road's guides are locals who live along it, as they know best the perils of its terrain, its supernatural threats, and the humans who might be hostile to travelers. These guides use a variety of survival techniques, many of which depend on a guide's region and culture. This school can be used to represent a specialist from any of a number of regions that border the Sand Road."
        }
    }

