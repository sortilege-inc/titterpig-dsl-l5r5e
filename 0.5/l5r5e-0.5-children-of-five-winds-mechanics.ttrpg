                SKILL "Martial Arts [Ranged]"
                SKILL "Performance"
                SKILL "Theology"
                TECHNIQUE_GROUP "Rank 1-2 Rituals"
                ^"Horse Whisperer" [shuji]
                #hQmJwXOpbHE6x5G3iVzBHW ^"Sudden Downpour Style" [kata]
            }
            RANK 3 {
                SKILL_GROUP "Martial Skills"
                SKILL "Performance"
                SKILL "Smithing"
                SKILL "Survival"
                TECHNIQUE_GROUP "Rank 1-3 Kata"
                ^"Dazzling Performance" [shuji]
                ^"Rallying Cry" [shuji]
            }
            RANK 4 {
                SKILL_GROUP "Scholar Skills"
                SKILL "Martial Arts [Ranged]"
                SKILL "Meditation"
                SKILL "Survival"
                TECHNIQUE_GROUP "Rank 1-4 Fire Shūji"
                ^"Pin the Fan" [kata]
                ^"Wolf's Proposal" [shuji]
            }
            RANK 5 {
                SKILL_GROUP "Martial Skills"
                SKILL "Culture"
                SKILL "Performance"
                SKILL "Survival"
                TECHNIQUE_GROUP "Rank 1-5 Kata"
                ^"Rouse the Soul" [shuji]
                ^"Silencing Stroke" [ninjutsu]
