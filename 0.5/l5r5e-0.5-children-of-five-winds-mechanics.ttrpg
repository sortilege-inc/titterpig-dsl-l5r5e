            ^"Clan" STRING "Unicorn"
            ^"Roles" LIST ["Bushi", "Artisan"]
            ^"Ring Increase" DEF {
                ^"Air" INTEGER 1
                ^"Fire" INTEGER 1
            }
            ^"Starting Skills" DEF { CHOOSE 5 [^"Culture", ^"Fitness", ^"Martial Arts [Ranged]", ^"Meditation", ^"Performance", ^"Smithing", ^"Tactics"] INTEGER 1 }
            ^"Starting Honor" INTEGER DEFAULT 40
            ^"Techniques Available" LIST ["Kata", "Rituals", "Shūji"]
        }

        STARTING_TECHNIQUES {
            KATA ^"Pelting Hail Style"
            KATA CHOOSE 1 [^"Hawk's Precision", ^"Striking as Fire"]
        }

        SCHOOL_ABILITY "Unity of Horse and Rider" {
            "When you spend a Void to seize the moment during a check using a bow, you may negate (st) symbols up to your school rank. If you succeed, gain bonus successes equal to the number of (st) symbols you negated. Additionally, while you are riding your steed, all of your Martial Arts [Ranged] and Performance skill checks have unskilled assistance."
        }

        MASTERY_ABILITY ^"Spirit of the Sacred Horse" {
            "Any steed you ride gains +4 endurance, +2 composure, +1 vigilance, and the Resplendent item quality. When you spend 1 or more Void points during a Martial Arts [Ranged] or Performance check, an item you have equipped gains the Sacred and Hewing item qualities, and you add kept dice set to (op) results equal to your Void ring."
        }
        STARTING_OUTFIT [
            "lacquered armor", "ceremonial clothes",
            "daishō (katana or scimitar, wakizashi)", "Shinjo horsebow",
            "quiver of arrows with three special arrows (one armor-piercing, one flesh-cutter, and one humming bulb; see page 236 of the core rulebook)",
            "knife", "traveling pack", "bowyer's kit",
            "Shinjo courser or Unicorn warhorse"
        ]

        CURRICULUM {
            RANK 1 {
                SKILL_GROUP "Martial Skills"
                SKILL "Courtesy"
                SKILL "Smithing"
                SKILL "Survival"
                TECHNIQUE_GROUP "Rank 1 Kata"
